<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{.Title}}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script defer src="/js/modules/update-checker.js"></script>
  <script defer src="/js/modules/plugin-update-checker.js"></script>
  <script defer src="/js/modules/plugin-pages.js"></script>
  <script>
    // Apply theme immediately from localStorage to prevent flash (FOUC)
    (function() {
      const savedTheme = localStorage.getItem('ori-theme');
      const isDark = savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
    })();
  </script>
  <script>
    window.oriFeatures = window.oriFeatures || {};
    window.oriFeatures.web3Enabled = {{if index .Extra "Web3Enabled"}}true{{else}}false{{end}};
    window.oriFeatures.evolutionEnabled = {{if index .Extra "EvolutionEnabled"}}true{{else}}false{{end}};
  </script>
  <!-- External CSS Libraries -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Theme Variables (must load first) -->
  <link href="/css/variables.css" rel="stylesheet">
  <!-- Layout and Components -->
  <link href="/css/layout.css" rel="stylesheet">
  <link href="/css/components.css" rel="stylesheet">
  <!-- Feature-specific styles -->
  <link href="/styles.css" rel="stylesheet">
  <link href="/css/common.css" rel="stylesheet">
  <link href="/css/sessions.css" rel="stylesheet">
  <link href="/css/file-manager.css" rel="stylesheet">
  <link href="/css/workspace-hub.css" rel="stylesheet">
  <link href="/css/settings.css" rel="stylesheet">
</head>
