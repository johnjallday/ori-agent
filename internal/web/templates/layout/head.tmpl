<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0d0d0d" media="(prefers-color-scheme: dark)" />
  <title>{{.Title}}</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
  <!-- Deferred scripts execute in document order, and this head precedes every
       page's own scripts, so AgentAvatar and CharacterCatalog are installed
       before any consumer (agents-roster.js, workspace-detail.js, sessions.js)
       runs. CharacterCatalog does not self-fetch; each surface calls load(). -->
  <script defer src="/js/modules/agent-avatar.js"></script>
  <!-- Name-only stick figures shared by Workspace Map and Workspace Details.
       This does not register an Agent Appearance mode or touch persisted
       appearance; consumers opt into it only for their local generated default. -->
  <script defer src="/js/modules/workspace-agent-portrait.js"></script>
  <script defer src="/js/modules/character-catalog.js"></script>
  <!-- The Appearance editor reads AgentAvatar for its preview, so it must load
       after it. Registering it here rather than per page is deliberate: an
       editable agent surface can appear on several pages, and a per-page
       registration is how one of them silently ends up without it.

       The character picker is loaded for the same reason and must be here too:
       the editor's "Choose character" opens it, and it previously lived only on
       the Agents roster page — so on the detail page, the create page, and the
       session Edit Agent modal that button did nothing at all. The picker
       creates its own mount point, so no page needs to provide one. -->
  <script defer src="/js/modules/agent-appearance.js"></script>
  <script defer src="/js/modules/character-picker.js"></script>
  <script defer src="/js/modules/update-checker.js"></script>
  <script defer src="/js/modules/vault-modal.js"></script>
  <script defer src="/js/modules/keyboard-navigation.js"></script>
  <script>
    // Apply visual preferences immediately from localStorage to prevent flash (FOUC)
    (function() {
      let savedTheme = null;
      let savedDensity = null;

      try {
        savedTheme = localStorage.getItem('ori-theme');
        savedDensity = localStorage.getItem('ori-ui-density');
      } catch (error) {
        // Ignore storage access failures and fall back to defaults
      }

      const isDark = savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches);
      const root = document.documentElement;
      root.setAttribute('data-bs-theme', isDark ? 'dark' : 'light');
      root.style.colorScheme = isDark ? 'dark' : 'light';

      if (savedDensity === 'compact' || savedDensity === 'roomy') {
        root.setAttribute('data-ui-density', savedDensity);
      } else {
        root.removeAttribute('data-ui-density');
      }
    })();
  </script>
  <script>
    window.oriFeatures = window.oriFeatures || {};
    window.oriFeatures.web3Enabled = {{if index .Extra "Web3Enabled"}}true{{else}}false{{end}};
    window.oriFeatures.evolutionEnabled = {{if index .Extra "EvolutionEnabled"}}true{{else}}false{{end}};
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,600;9..144,700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
  <!-- External CSS Libraries -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <!-- Theme Variables (must load first) -->
  <link href="/css/variables.css" rel="stylesheet">
  <!-- Layout and Components -->
  <link href="/css/layout.css" rel="stylesheet">
  <link href="/css/components.css" rel="stylesheet">
  <!-- Feature-specific styles -->
  <link href="/styles.css" rel="stylesheet">
  <link href="/css/common.css" rel="stylesheet">
  <link href="/css/setup-journey.css" rel="stylesheet">
  <link href="/css/sessions.css" rel="stylesheet">
  <!-- Shared context-menu surface (sessions, folders, notes, and the Workspace
       Map). Loaded right after sessions.css, where it used to live. -->
  <link href="/css/context-menu.css" rel="stylesheet">
  <link href="/css/file-manager.css" rel="stylesheet">
  <link href="/css/workspace-hub.css" rel="stylesheet">
  <link href="/css/workspace-map.css" rel="stylesheet">
  <link href="/css/group-builder.css" rel="stylesheet">
  <link href="/css/workspace-command.css" rel="stylesheet">
  <link href="/css/workspace-construct.css" rel="stylesheet">
  <!-- Agent identity is rendered on pages across the app (the Agents roster, a
       workspace's agent cards, and the Create Workspace team roster), so the one
       renderer and its stylesheet live in the shared head rather than being
       re-declared per page — a second <script defer> of the same module would
       execute it twice. -->
  <link href="/css/agent-avatar.css" rel="stylesheet">
  <link href="/css/agent-appearance.css" rel="stylesheet">
  <!-- The picker's stylesheet travels with its script for the same reason: it
       was registered only on the Agents roster, so on every other host the
       picker opened as an unstyled block in the top-left of the page instead of
       a centred dialog. -->
  <link href="/css/character-picker.css" rel="stylesheet">
  <link href="/css/file-janitor.css" rel="stylesheet">
  <link href="/css/setup-wizard.css" rel="stylesheet">
  {{if index .Extra "HomeCommandBridge"}}<link href="/css/home-command.css" rel="stylesheet">
  <link href="/css/home-workspace-cockpit.css" rel="stylesheet">{{end}}
  <link href="/css/settings.css" rel="stylesheet">
  <link href="/css/ui-refresh.css" rel="stylesheet">
  <link href="/css/tag-input.css" rel="stylesheet">
  <link href="/css/keyboard-navigation.css" rel="stylesheet">
  <link href="/css/claude-sync.css" rel="stylesheet">
  <!--
    Shared cozy tokens. Loaded before every sheet that consumes them, and before
    the theme sheets so a page can still override. It only defines custom
    properties, so pages outside the V1 surface list are unaffected (FR-2).
  -->
  <link href="/css/cozy-character.css" rel="stylesheet">
  <link href="/css/ori-guide.css" rel="stylesheet">
  <!--
    Ori Guide scripts load from the shared head so every page that renders the
    navbar also gets the controller. Coachmarks load first: the controller
    consults that registry when validating an action, so the allowlist has to be
    installed before it runs. Both are deferred, so they execute in order just
    before DOMContentLoaded.
  -->
  <script defer src="/js/modules/ori-guide-coachmarks.js"></script>
  <script defer src="/js/modules/ori-guide.js"></script>
  <script type="module" src="/js/modules/personal-assistant-panel.js"></script>
  {{if eq .CurrentPage "templates"}}<link href="/css/templates.css" rel="stylesheet">{{end}}
  {{if eq .CurrentPage "vault"}}<link href="/css/vault-page.css" rel="stylesheet">{{end}}
  <!-- Shared tag input widget (deferred ES module; exposes window.OriTagInput) -->
  <script type="module" src="/js/modules/tag-input.js"></script>
  <!-- Shared tag filter bar (deferred ES module; exposes window.OriTagFilterBar) -->
  <script type="module" src="/js/modules/tag-filter-bar.js"></script>
  <!-- Create-workspace modal tags card (no-op on pages without the modal) -->
  <script type="module" src="/js/modules/workspace-tags-card.js"></script>
</head>
