<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light{{if index .Extra "HomeCommandBridge"}} home-command-page{{end}}">
  <!-- Skip link for keyboard users (styled in common.css) -->
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <!-- Toast Notification Container -->
  <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{if not (index .Extra "HideSidebar")}}{{template "sidebar.tmpl" .}}{{end}}

    <!-- Main Content -->
    <main id="main-content" class="main-content{{if index .Extra "HomeCommandBridge"}} home-command-main{{end}}" role="main" aria-label="Dashboard">
      {{template "dashboard.tmpl" .}}
    </main>
  </div>

  {{template "session-modals.tmpl" .}}
  {{template "search-palette.tmpl" .}}
  {{template "chat-area.tmpl" .}}

  <!-- Edit Agent Modal -->
  <div class="modal fade" id="editAgentModal" tabindex="-1" aria-labelledby="editAgentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" id="editAgentModalLabel" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
            </svg>
            Edit Agent
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
        </div>
        <div class="modal-body">
          <div id="editAgentModalLoading" class="text-center py-4 d-none">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-2" style="color: var(--text-secondary);">Loading agent...</p>
          </div>
          <div id="editAgentModalContent">
            <div id="editAgentError" class="alert alert-danger d-none" role="alert"></div>
            <div id="editAgentSuccess" class="alert alert-success d-none" role="alert">Agent updated successfully.</div>
            <form id="editAgentForm">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label" for="editAgentNameInput" style="color: var(--text-primary);">Name</label>
                  <input type="text" id="editAgentNameInput" class="modern-input w-100" placeholder="Agent name" minlength="2" maxlength="50">
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label" for="editAgentTypeSelect" style="color: var(--text-primary);">Type</label>
                  <select id="editAgentTypeSelect" class="modern-input w-100">
                    <option value="tool-calling">Tool Calling</option>
                    <option value="general">General Purpose</option>
                    <option value="orchestration">Orchestration</option>
                    <option value="research">Research</option>
                  </select>
                </div>
              </div>
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label" for="editAgentRoleSelect" style="color: var(--text-primary);">Role</label>
                  <select id="editAgentRoleSelect" class="modern-input w-100">
                    <option value="general">General</option>
                    <option value="orchestrator">Orchestrator</option>
                    <option value="researcher">Researcher</option>
                    <option value="analyzer">Analyzer</option>
                    <option value="synthesizer">Synthesizer</option>
                    <option value="validator">Validator</option>
                    <option value="specialist">Specialist</option>
                  </select>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label" for="editAgentModelSelect" style="color: var(--text-primary);">Model</label>
                  <select id="editAgentModelSelect" class="modern-input w-100">
                    <option value="">Select a model...</option>
                  </select>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label" for="editAgentDescription" style="color: var(--text-primary);">Description</label>
                <textarea id="editAgentDescription" class="form-control" rows="4"
                          style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); resize: vertical;"
                          placeholder="Describe the agent's purpose or behavior"></textarea>
              </div>
              <div class="row">
                <!-- The shared Appearance editor replaces the colour-only
                     control that used to sit here. This modal edits the same
                     shared agent definition the Agents page does, so it must
                     offer the same three sources rather than the one it
                     happened to implement first (FR-26/FR-90). -->
                <div class="col-md-6 mb-3">
                  <div id="editAgentAppearanceHost"></div>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Favorite</label>
                  <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="editAgentFavoriteToggle">
                    <label class="form-check-label" for="editAgentFavoriteToggle" style="color: var(--text-primary);">Mark as favorite</label>
                  </div>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label" for="editAgentTagsInput" style="color: var(--text-primary);">Tags</label>
                <div id="editAgentTagsContainer" class="agent-edit-tags-container">
                  <input type="text" id="editAgentTagsInput" class="agent-edit-tags-input" placeholder="Add tags...">
                </div>
                <small class="text-muted">Press Enter to add tags.</small>
              </div>
              <div class="mb-2">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <label class="form-label mb-0" style="color: var(--text-primary);">MCP Connectors</label>
                  <a href="/mcp" style="color: var(--primary-color); text-decoration: none; font-size: 12px;">Manage MCP</a>
                </div>
                <div id="editAgentMCPList" class="agent-edit-mcp-list" aria-live="polite">
                  <span class="agent-edit-mcp-empty">MCP is now bound from workspaces.</span>
                </div>
                <small class="text-muted">Read-only legacy view. Configure live MCP access from the target workspace.</small>
              </div>
            </form>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="editAgentSaveBtn" class="modern-btn modern-btn-primary">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Update Available Modal -->
  <div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" id="updateModalLabel" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
            </svg>
            Update Available
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
        </div>
        <div class="modal-body" id="updateModalBody">
          <div class="text-center py-4">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Later</button>
          <a id="downloadUpdateBtn" href="#" class="modern-btn modern-btn-primary" target="_blank" style="display:none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
            </svg>
            Download Update
          </a>
        </div>
      </div>
    </div>
  </div>

  {{template "modals.tmpl" .}}

  <!-- Personal HQ modals. Must be included wherever personal-hq-onboarding.js
       loads (see the script tag below) — the script binds by id, so a missing
       modal makes every Build My HQ entry point a silent no-op (#322). -->
  {{template "personal-hq-modals.tmpl" .}}

  <!-- File Manager Modals -->
  {{template "file_preview_dialog"}}
  {{template "file_delete_dialog"}}
  {{template "file_relink_dialog"}}

  <!-- Scripts -->
  <!--
    All classic scripts use `defer`: they download in parallel with HTML parsing
    and execute in document order just before DOMContentLoaded. Module scripts
    (type="module") defer by default. Ordering between the two is preserved, so
    "load before X" dependencies below still hold. The inline theme-init script
    stays a parse-time script (defer is ignored on inline scripts) but only
    references themeManager inside its DOMContentLoaded callback, by which point
    the deferred themeManager.js has run.
  -->
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script defer src="/js/vendor/marked-14.1.4.min.js" integrity="sha384-lqPzN0kmFw9t2syAMwVPM4VbAyqsz/lPyYWbb2Xt6nSPM0WPNrpSWCUBgdcAdgnC"></script>
  <script defer src="/js/vendor/dompurify-3.1.6.min.js" integrity="sha384-+VfUPEb0PdtChMwmBcBmykRMDd+v6D/oFmB3rZM/puCMDYcIvF968OimRh4KQY9a"></script>
  <script defer src="https://cdn.jsdelivr.net/npm/ethers@6/dist/ethers.umd.min.js"></script>
  <!-- Theme Manager - must load before other modules -->
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "theme-init.tmpl" .}}
  {{template "scripts-dx-utils.tmpl" .}}
  <!-- Sidebar modules - loaded before main app -->
  <script defer src="/js/modules/resizer.js"></script>
  <script defer src="/js/modules/settings.js"></script>
  <script defer src="/js/modules/agents.js"></script>
  <script defer src="/js/modules/apikey.js"></script>
  <script defer src="/js/modules/sidebar.js"></script>
  <script defer src="/js/modules/file-upload.js"></script>
  <script defer src="/js/modules/location.js"></script>
  <script defer src="/js/modules/task-modal-controller.js"></script>
  <script defer src="/js/modules/workspace-bootstrap-review.js"></script>
  <script type="module" src="/js/modules/note-editor.js"></script>
  <script type="module" src="/js/modules/note-toc.js"></script>
  <script type="module" src="/js/modules/note-staging.js"></script>
  <script type="module" src="/js/modules/note-wikilinks.js"></script>
  <script type="module" src="/js/modules/note-backlinks.js"></script>
  <script type="module" src="/js/modules/note-presence.js"></script>
  <script type="module" src="/js/modules/note-rail-notes.js"></script>
  <script type="module" src="/js/modules/note-ai-assist.js"></script>
  <script type="module" src="/js/modules/search-palette.js"></script>
  <!-- Must precede sessions.js: it reads window.CreateWorkspaceTeamDraft while
       binding the Create Workspace wizard. Deferred scripts run in document
       order, so this tag's position is the dependency contract. -->
  <script defer src="/js/modules/create-workspace-team-draft.js"></script>
  <!--
    Also must precede sessions.js: Create Workspace renders its parent-group
    picker through workspace-group-options.js. That helper used to load only on
    the /workspaces launcher; now that `?create=1` lands on Home the modal is
    reachable here too, and its absence threw "Cannot read properties of
    undefined (reading 'collectWorkspaceGroupOptions')".
  -->
  <script defer src="/js/modules/workspace-group-options.js"></script>
  <script defer src="/js/modules/sessions.js"></script>
  <script defer src="/js/modules/plugin-lifecycle.js"></script>
  <script defer src="/js/modules/blueprint-readiness.js"></script>
  <script defer src="/js/modules/workspace-building-art.js"></script>
  <script defer src="/js/modules/project-templates-manage.js"></script>
  <script defer src="/js/modules/toast.js"></script>
  <script defer src="/js/modules/voice-input.js"></script>
  <script defer src="/js/modules/form-validation.js"></script>
  <script defer src="/js/file-manager.js"></script>
  <script defer src="/js/app.js?v=1694538177"></script>
  <script defer src="/js/modules/workspace-realtime.js"></script>
  <script defer src="/js/modules/dashboard.js"></script>
  <script type="module" src="/js/modules/relative-time.js"></script>
  <script defer src="/js/modules/home-dashboard.js"></script>
  <!--
    Home cockpit. workspace-map.js is a classic deferred script and MUST run
    before the coordinator that calls OriWorkspaceMap.mount(...) (PRD FR123).
    Deferred classic scripts execute before non-async module scripts, so the
    ordering below satisfies that requirement.
  -->
  <script defer src="/js/modules/workspace-map.js"></script>
  <script defer src="/js/modules/plugin-update-notifications.js"></script>
  <script type="module" src="/js/modules/home-workspace-cockpit.js"></script>
  <script type="module" src="/js/modules/home-plugin-updates.js"></script>
  <script type="module" src="/js/modules/home-daily-brief.js"></script>
  <script type="module" src="/js/modules/personal-assistant-home.js"></script>
  <script type="module" src="/js/modules/setup-journey.js"></script>
  <script type="module" src="/js/modules/personal-assistant-continuity.js"></script>
  <script type="module" src="/js/modules/home-calendar-ops-portal.js"></script>
  <script type="module" src="/js/modules/progression-widget.js"></script>
  <script type="module" src="/js/modules/personal-hq-onboarding.js"></script>
  <!--
    Ori's Personal HQ walkthrough. Loaded last on purpose: it reads
    window.OriHomeCockpit and window.OriGuide, and listens to events the Map and
    the Personal HQ controller above emit.

    type="module", NOT defer: every deferred classic script runs BEFORE the first
    module, so a deferred walkthrough would initialize while OriHomeCockpit was
    still undefined and would silently fail to open Map view. Modules run in
    document order, so being last here means being last overall.

    It is purely additive — removing this one line leaves the Map and Build My HQ
    fully functional.
  -->
  <script type="module" src="/js/modules/personal-hq-quest.js"></script>
</body>
</html>
