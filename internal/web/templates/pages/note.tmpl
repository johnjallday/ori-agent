{{define "note-page"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <a href="#noteMainContent" class="skip-link">Skip to note content</a>
  <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

  {{template "navbar.tmpl" .}}

  <main id="noteMainContent" class="note-page" role="main" aria-label="Note editor" data-workspace-id="{{.Extra.WorkspaceID}}" data-note-id="{{.Extra.NoteID}}" data-page-mode="{{.Extra.NotePageMode}}">
    <!-- Top bar: breadcrumb, editable title, status -->
    <header class="note-page-top-bar">
      <nav aria-label="breadcrumb" class="note-page-breadcrumb">
        <a href="/workspaces" class="breadcrumb-link">Workspaces</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a id="notePageWorkspaceLink" class="breadcrumb-link" href="#">Workspace</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">Note</span>
      </nav>

      <div class="note-page-title-row">
        <div class="note-page-title-main">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);" aria-hidden="true">
            <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,9V3.5L18.5,9H13M12,12H7V10H12V12M17,16H7V14H17V16M17,20H7V18H17V20Z"/>
          </svg>
          <input type="text" id="noteNameInput" class="note-title-input" placeholder="Note title" aria-label="Note title" autocomplete="off">
        </div>

        <div class="note-page-title-actions">
          <span id="noteSaveStatus" class="note-page-status" aria-live="polite">
            <span class="note-status-saved text-success" style="display: none;">✓ Saved</span>
            <span class="note-status-saving text-muted" style="display: none;">
              <span class="spinner-border spinner-border-sm me-1" style="width: 12px; height: 12px;"></span>Saving…
            </span>
            <span class="note-status-unsaved text-warning" style="display: none;">● Unsaved</span>
            <span class="note-status-error text-danger" style="display: none;">⚠ Save failed</span>
          </span>

        </div>
      </div>

      <div class="note-page-tags-row" id="notePageTagsRow" style="margin: 2px 0 8px;" hidden>
        <div id="notePageTagsMount"></div>
      </div>

      <!-- Toolbar (reused IDs match the modal so NoteEditor wires them automatically) -->
      <div class="note-editor-toolbar">
        <button type="button" id="noteTocToggle" class="note-toolbar-btn" title="Toggle Notes &amp; Outline sidebar" aria-pressed="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3,5H21V19H3V5M5,7V17H10V7H5M12,7V9H19V7H12M12,11V13H19V11H12M12,15V17H19V15H12Z"/></svg>
          Sidebar
        </button>
        <button type="button" id="noteGenerateAIToggle" class="note-toolbar-btn" title="Ask AI (⌘J)" aria-controls="noteAIGeneratePanel" aria-expanded="false">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12,2L15.09,8.26L22,9.27L17,14.14L18.18,21.02L12,17.77L5.82,21.02L7,14.14L2,9.27L8.91,8.26L12,2Z"/></svg>
          Ask AI
        </button>
        <div class="note-toolbar-spacer"></div>
        <button type="button" id="noteAssistToggle" class="note-toolbar-btn" title="Toggle AI assist" aria-pressed="false" hidden>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12,3A9,9 0 0,0 3,12H0L4,16L8,12H5A7,7 0 0,1 12,5A7,7 0 0,1 19,12A7,7 0 0,1 12,19C10.5,19 9.09,18.5 7.94,17.7L6.5,19.14C8.04,20.3 9.94,21 12,21A9,9 0 0,0 21,12A9,9 0 0,0 12,3M11,7V13L15.25,15.5L16,14.25L12.5,12.25V7H11Z"/></svg>
          Assist
        </button>
      </div>
    </header>

    <!-- Editor grid (same structure as the modal's body) -->
    <div class="note-editor-grid note-page-editor-grid" id="noteEditorGrid">
      <aside class="note-toc-rail" id="noteTocRail" aria-label="Notes &amp; outline">
        <div class="note-rail-tab-strip" role="tablist" aria-label="Rail mode">
          <button type="button" id="noteRailTabNotes" class="note-rail-tab is-active" data-tab="notes" role="tab" aria-selected="true" aria-controls="noteRailPaneNotes">Notes</button>
          <button type="button" id="noteRailTabOutline" class="note-rail-tab" data-tab="outline" role="tab" aria-selected="false" aria-controls="noteRailPaneOutline">Outline</button>
        </div>
        <div id="noteRailPaneNotes" class="note-rail-tab-pane note-rail-pane-notes" data-pane="notes" role="tabpanel" aria-labelledby="noteRailTabNotes">
          <div class="note-rail-notes-search">
            <input type="search" id="noteRailNotesSearch" class="modern-input" placeholder="Search by title or tag…" aria-label="Filter notes">
          </div>
          <div id="noteRailNotesList" class="note-rail-notes-list" role="list"></div>
          <button type="button" id="noteRailNewNoteBtn" class="note-rail-new-note">+ New Note</button>
        </div>
        <div id="noteRailPaneOutline" class="note-rail-tab-pane note-rail-pane-outline" data-pane="outline" role="tabpanel" aria-labelledby="noteRailTabOutline" hidden>
          <div class="note-rail-empty" data-role="empty">Add a heading to build an outline</div>
          <div class="note-rail-content" data-role="content"></div>
        </div>
      </aside>

      <div class="note-editor-center">
        <div class="note-page-pane-grid" id="notePagePaneGrid">
          <div class="note-editor-container note-page-pane note-page-pane-primary" id="notePagePrimaryPane">
            <nav class="note-tab-strip note-pane-tab-strip" id="notePageTabStrip" aria-label="Primary pane open notes" hidden>
              <ul class="note-tab-list" id="notePageTabList" role="tablist"></ul>
              <div class="note-tab-strip-actions">
                <button type="button" id="notePageNewTabBtn" class="note-tab-strip-action" title="Create new note" aria-label="Create new note">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/></svg>
                </button>
                <button type="button" id="notePageSplitRightBtn" class="note-tab-strip-action" title="Split right" aria-label="Split right" hidden>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M3,3H21V21H3V3M5,5V19H11V5H5M13,5V19H19V5H13Z"/></svg>
                </button>
                <button type="button" id="notePageUnsplitBtn" class="note-tab-strip-action" title="Close split" aria-label="Close split" hidden>
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z"/></svg>
                </button>
              </div>
            </nav>
            <!-- Source-of-truth textarea, hidden on the page (the preview is the
                 only visible editor; click a rendered line to edit inline). -->
            <textarea id="noteContentInput" class="note-content-input" placeholder="e.g. # Project Notes…" style="display: none;" aria-hidden="true" tabindex="-1"></textarea>
            <div id="notePreviewContent" class="note-preview-content note-live-editor" role="textbox" aria-label="Markdown live preview editor" aria-multiline="true" tabindex="0">
              <div class="note-page-loading">Loading note…</div>
            </div>
          </div>
          <!-- Secondary pane shown when split mode is active. It hosts its
               own live-preview editor and autosave lifecycle. -->
          <aside class="note-page-pane note-page-pane-secondary" id="notePageSecondaryPane" hidden aria-label="Secondary pane">
            <div class="note-page-secondary-header note-pane-tab-strip">
              <nav class="note-page-secondary-tabs" id="notePageSecondaryTabs" role="tablist" aria-label="Secondary pane tabs"></nav>
              <span id="notePageSecondaryStatus" class="note-page-secondary-status" aria-live="polite"></span>
              <button type="button" id="notePagePromoteBtn" class="note-tab-strip-action" title="Edit this note (swap panes)" aria-label="Edit this note">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z"/></svg>
              </button>
            </div>
            <div class="note-page-secondary-body">
              <div id="notePageSecondaryBanner" class="note-page-secondary-banner" hidden>
                Already open in the primary pane. Open a different note, or use Edit to swap.
              </div>
              <textarea id="notePageSecondaryEditor" class="note-page-secondary-editor note-page-secondary-source" placeholder="e.g. # Heading…" spellcheck="false" style="display: none;" aria-hidden="true" tabindex="-1" hidden></textarea>
              <div id="notePageSecondaryPreview" class="note-preview-content note-live-editor note-page-secondary-rendered" role="textbox" aria-label="Secondary Markdown live preview editor" aria-multiline="true" tabindex="0" hidden></div>
              <div id="notePageSecondaryEmpty" class="note-page-secondary-empty">No note selected.</div>
            </div>
          </aside>
        </div>
      </div>

      <aside class="note-assist-rail" id="noteAssistRail" hidden aria-label="AI assist">
        <section id="noteAIGeneratePanel" class="note-ai-panel note-rail-ai-panel" aria-label="Ask AI" hidden>
          <div class="note-ai-panel-header">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-primary" aria-hidden="true"><path d="M12,2L15.09,8.26L22,9.27L17,14.14L18.18,21.02L12,17.77L5.82,21.02L7,14.14L2,9.27L8.91,8.26L12,2Z"/></svg>
            <span>Ask AI</span>
          </div>
          <div class="note-ai-panel-body">
            <div id="noteAIPanelSelection" class="note-ai-panel-selection" data-role="panel-selection" hidden></div>
            <label for="noteAIAgentSelect" class="note-ai-field">
              <span>Agent</span>
              <select id="noteAIAgentSelect" class="modern-input w-100">
                <option value="">Use workspace agent</option>
              </select>
            </label>
            <label for="noteAIPromptInput" class="note-ai-field note-ai-field-prompt">
              <span>Prompt</span>
              <textarea id="noteAIPromptInput" class="modern-input w-100" rows="3" placeholder="Ask AI…" spellcheck="false"></textarea>
            </label>
            <div id="noteAIError" class="note-ai-message note-ai-message-error" role="alert" aria-live="assertive" hidden></div>
            <div id="noteAIStatus" class="note-ai-message" aria-live="polite" aria-atomic="true" hidden></div>
            <div id="noteAIGenerating" class="note-ai-generating" aria-live="polite" hidden>
              <span class="spinner-border spinner-border-sm text-primary" aria-hidden="true"></span>
              <span>Generating draft…</span>
            </div>
            <div id="noteAIDraftPanel" class="note-ai-draft" hidden>
              <div id="noteAIDraftTitle" class="note-ai-draft-title"></div>
              <pre id="noteAIDraftContent" class="note-ai-draft-content" aria-label="Generated note draft" tabindex="0"></pre>
            </div>
          </div>
          <div class="note-ai-panel-footer">
            <button type="button" id="noteAICancelBtn" class="modern-btn modern-btn-secondary btn-sm">Close</button>
            <div id="noteAIDraftActions" class="note-ai-draft-actions" hidden>
              <button type="button" id="noteAIInsertBtn" class="modern-btn modern-btn-secondary btn-sm">Insert</button>
              <button type="button" id="noteAIAppendBtn" class="modern-btn modern-btn-secondary btn-sm">Append</button>
              <button type="button" id="noteAIReplaceBtn" class="modern-btn modern-btn-primary btn-sm">Replace</button>
            </div>
            <button type="button" id="noteAIGenerateBtn" class="modern-btn modern-btn-primary btn-sm">Ask</button>
          </div>
        </section>
        <div class="note-rail-empty" data-role="empty">Use the prompt above, or highlight text and pick an inline action.</div>
        <div class="note-rail-content" data-role="content"></div>
        <section id="noteBacklinksSection" class="note-backlinks-section" hidden aria-label="Backlinks">
          <div class="note-backlinks-header">
            <span class="note-backlinks-title">Backlinks</span>
            <span id="noteBacklinksCount" class="note-backlinks-count"></span>
          </div>
          <div id="noteBacklinksList" class="note-backlinks-list"></div>
        </section>
      </aside>
    </div>

    <!-- Floating AI selection action bar (positioned via JS) -->
    <div id="noteAIActionBar" class="note-ai-action-bar" role="toolbar" aria-label="AI selection actions"></div>

    <div id="notePageDetachZone" class="note-page-detach-zone" hidden>
      <span>Drop here to split right</span>
    </div>
  </main>

  <!-- Shared scripts (head loads bootstrap, marked, dompurify, etc.) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/vendor/marked-14.1.4.min.js"></script>
  <script src="/js/vendor/dompurify-3.1.6.min.js"></script>
  <script src="/js/modules/themeManager.js"></script>
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/utils/dom-utils.js"></script>
  <script src="/js/modules/toast.js"></script>
  <script type="module" src="/js/modules/note-editor.js"></script>
  <script type="module" src="/js/modules/note-toc.js"></script>
  <script type="module" src="/js/modules/note-staging.js"></script>
  <script type="module" src="/js/modules/note-wikilinks.js"></script>
  <script type="module" src="/js/modules/note-backlinks.js"></script>
  <script type="module" src="/js/modules/note-presence.js"></script>
  <script type="module" src="/js/modules/note-rail-notes.js"></script>
  <script type="module" src="/js/modules/note-tabs.js"></script>
  <script type="module" src="/js/modules/note-ai-assist.js"></script>
  <script type="module" src="/js/modules/search-palette.js"></script>
  <script type="module" src="/js/modules/note-page.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>
</body>
</html>
{{end}}
