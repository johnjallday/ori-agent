{{define "agents-detail"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="detail-container" style="max-width: 1400px; margin: 0 auto; padding: 20px;">
        <!-- Loading State -->
        <div id="loadingState" class="loading" style="display: flex; justify-content: center; align-items: center; min-height: 400px;">
          <div class="text-center">
            <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3" style="color: var(--text-secondary);">Loading agent details...</p>
          </div>
        </div>

        <!-- Content (hidden until loaded) -->
        <div id="content" style="display: none;">
          <!-- Agent Header -->
          <div class="agent-header modern-card p-4 mb-4">
            <div class="d-flex align-items-center gap-3">
              <div class="agent-avatar-large" style="width: 80px; height: 80px; border-radius: 16px; background: linear-gradient(135deg, var(--primary-color), var(--primary-light)); display: flex; align-items: center; justify-content: center;">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="white">
                  <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                </svg>
              </div>
              <div class="flex-grow-1">
                <h1 id="agentName" style="font-size: 28px; margin: 0 0 8px 0; color: var(--text-primary);">Loading...</h1>
                <p id="agentDescription" class="agent-description-large" style="color: var(--text-secondary); margin: 0;">Loading description...</p>
              </div>
              <div class="d-flex gap-2">
                <a id="editButton" href="#" class="modern-btn modern-btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                  </svg>
                  Edit Agent
                </a>
                <button id="deleteButton" class="modern-btn modern-btn-secondary" style="background: rgba(239, 68, 68, 0.1); color: var(--danger-color); border-color: rgba(239, 68, 68, 0.2);">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                  </svg>
                  Delete
                </button>
              </div>
            </div>
          </div>

          <!-- Details Grid -->
          <div class="row g-4">
            <!-- Configuration Section -->
            <div class="col-lg-6">
              <div class="section-card modern-card p-4">
                <h3 class="section-title" style="font-size: 18px; font-weight: 600; margin-bottom: 16px; color: var(--text-primary);">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                    <path d="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
                  </svg>
                  Configuration
                </h3>
                <div class="space-y-3">
                  <div class="info-item" style="padding: 12px 0; border-bottom: 1px solid var(--border-color);">
                    <div class="info-item-label" style="font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 4px;">Model</div>
                    <div id="agentModel" class="info-item-value" style="color: var(--text-primary);">Loading...</div>
                  </div>
                  <div class="info-item" style="padding: 12px 0; border-bottom: 1px solid var(--border-color);">
                    <div class="info-item-label" style="font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 4px;">Provider</div>
                    <div id="agentProvider" class="info-item-value" style="color: var(--text-primary);">Loading...</div>
                  </div>
                  <div class="info-item" style="padding: 12px 0; border-bottom: 1px solid var(--border-color);">
                    <div class="info-item-label" style="font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 4px;">Temperature</div>
                    <div id="agentTemperature" class="info-item-value" style="color: var(--text-primary);">Loading...</div>
                  </div>
                  <div class="info-item" style="padding: 12px 0;">
                    <div class="info-item-label" style="font-size: 13px; font-weight: 500; color: var(--text-secondary); margin-bottom: 4px;">Max Tokens</div>
                    <div id="agentMaxTokens" class="info-item-value" style="color: var(--text-primary);">Loading...</div>
                  </div>
                </div>
              </div>
            </div>

            <!-- System Prompt Section -->
            <div class="col-lg-6">
              <div class="section-card modern-card p-4">
                <h3 class="section-title" style="font-size: 18px; font-weight: 600; margin-bottom: 16px; color: var(--text-primary);">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                    <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                  </svg>
                  System Prompt
                </h3>
                <div id="agentSystemPrompt" style="padding: 16px; background: var(--bg-secondary); border-radius: 8px; font-family: 'SF Mono', monospace; font-size: 13px; line-height: 1.6; color: var(--text-primary); white-space: pre-wrap; word-break: break-word;">Loading...</div>
              </div>
            </div>

            <!-- Enabled Plugins Section -->
            <div class="col-12">
              <div class="section-card modern-card p-4">
                <h3 class="section-title" style="font-size: 18px; font-weight: 600; margin-bottom: 16px; color: var(--text-primary);">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                    <path d="M20.5,11H19V7C19,5.89 18.1,5 17,5H13V3.5A2.5,2.5 0 0,0 10.5,1A2.5,2.5 0 0,0 8,3.5V5H4C2.89,5 2,5.89 2,7V10.8H3.5C5,10.8 6.2,12 6.2,13.5C6.2,15 5,16.2 3.5,16.2H2V20C2,21.11 2.89,22 4,22H7.8V20.5C7.8,19 9,17.8 10.5,17.8C12,17.8 13.2,19 13.2,20.5V22H17C18.11,22 19,21.11 19,20V16H20.5A2.5,2.5 0 0,0 23,13.5A2.5,2.5 0 0,0 20.5,11Z"/>
                  </svg>
                  Enabled Plugins
                  <span id="pluginCount" class="modern-badge badge-secondary ms-2" style="font-size: 12px;">0</span>
                </h3>
                <div id="pluginsList" class="plugins-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 16px;">
                  <div class="text-center py-4" style="color: var(--text-secondary);">Loading plugins...</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--danger-color);">
              <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
            </svg>
            Confirm Delete
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p style="color: var(--text-primary);">Are you sure you want to delete this agent?</p>
          <p style="color: var(--text-secondary); font-size: 14px;">This action cannot be undone.</p>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="confirmDeleteBtn" class="modern-btn" style="background: var(--danger-color); color: white;">Delete Agent</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/modules/themeManager.js"></script>
  <script src="/js/modules/resizer.js"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/agents-detail.js"></script>
  <script>
    // Initialize theme
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>
</body>
</html>
{{end}}
