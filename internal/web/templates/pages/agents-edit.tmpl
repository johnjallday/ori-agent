{{define "agents-edit"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="edit-container" style="max-width: 960px; margin: 0 auto; padding: 20px;">
        <a id="backLink" class="back-button" href="/agents">← Back</a>

        <div class="page-header" style="margin-bottom: 24px;">
          <h1 style="font-size: 28px; margin-bottom: 8px;">Edit Agent</h1>
          <p style="color: var(--text-muted); font-size: 14px; margin: 0;">Update core settings and metadata for this agent.</p>
        </div>

        <div id="errorMessage" class="alert alert-danger" style="display: none;"></div>
        <div id="successMessage" class="alert alert-success" style="display: none;">Agent updated successfully.</div>

        <div class="form-card modern-card" style="padding: 24px; margin-bottom: 20px;">
          <h2 class="form-section-title" style="font-size: 18px; font-weight: 600; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">Agent Overview</h2>
          <div class="form-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
            <div class="form-group" style="margin-bottom: 18px;">
              <label class="form-label" for="agentNameInput" style="display: block; font-weight: 500; margin-bottom: 8px; color: var(--text-primary);">Name</label>
              <input type="text" id="agentNameInput" class="form-input" placeholder="Agent name" style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 14px; background: var(--bg-primary); color: var(--text-primary);">
            </div>
            <div class="form-group" style="margin-bottom: 18px;">
              <label class="form-label" for="agentType" style="display: block; font-weight: 500; margin-bottom: 8px; color: var(--text-primary);">Type</label>
              <select id="agentType" class="form-select" style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 14px; background: var(--bg-primary); color: var(--text-primary);">
                <option value="tool-calling">Tool Calling</option>
                <option value="conversational">Conversational</option>
                <option value="task-oriented">Task Oriented</option>
              </select>
            </div>
            <div class="form-group" style="margin-bottom: 18px;">
              <label class="form-label" for="agentRole" style="display: block; font-weight: 500; margin-bottom: 8px; color: var(--text-primary);">Role</label>
              <select id="agentRole" class="form-select" style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 14px; background: var(--bg-primary); color: var(--text-primary);">
                <option value="general">General</option>
                <option value="coding">Coding</option>
                <option value="research">Research</option>
                <option value="creative">Creative</option>
                <option value="analysis">Analysis</option>
              </select>
            </div>
            <div class="form-group" style="margin-bottom: 18px;">
              <label class="form-label" for="agentModel" style="display: block; font-weight: 500; margin-bottom: 8px; color: var(--text-primary);">Model</label>
              <input type="text" id="agentModel" class="form-input" placeholder="e.g., gpt-4o" list="modelOptionsList" style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 14px; background: var(--bg-primary); color: var(--text-primary);">
              <datalist id="modelOptionsList"></datalist>
            </div>
          </div>
        </div>

        <div class="form-card modern-card" style="padding: 24px; margin-bottom: 20px;">
          <h2 class="form-section-title" style="font-size: 18px; font-weight: 600; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--border-color);">Metadata</h2>
          <div class="form-group" style="margin-bottom: 18px;">
            <label class="form-label" for="agentDescription" style="display: block; font-weight: 500; margin-bottom: 8px; color: var(--text-primary);">Description</label>
            <textarea id="agentDescription" class="form-textarea" placeholder="Describe the agent's purpose or behavior" style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 14px; background: var(--bg-primary); color: var(--text-primary); resize: vertical; min-height: 120px;"></textarea>
          </div>

          <!-- Avatar Image Upload Section -->
          <div class="form-group" style="margin-bottom: 18px;">
            <label class="form-label" style="display: block; font-weight: 500; margin-bottom: 8px; color: var(--text-primary);">Avatar Image</label>
            <div id="avatarUploadArea" class="avatar-upload-area" style="display: flex; gap: 16px; align-items: flex-start;">
              <div id="avatarPreviewContainer" style="flex-shrink: 0;">
                <div id="avatarImagePreview" class="avatar-preview" style="width: 80px; height: 80px; border-radius: 12px; border: 2px dashed var(--border-color); display: flex; align-items: center; justify-content: center; overflow: hidden; background: var(--bg-secondary);">
                  <span id="avatarPlaceholder" style="color: var(--text-muted); font-size: 12px; text-align: center; padding: 8px;">No image</span>
                  <img id="avatarImg" src="" alt="Avatar" style="width: 100%; height: 100%; object-fit: cover; display: none;">
                </div>
              </div>
              <div style="flex: 1;">
                <div id="avatarDropZone" class="avatar-drop-zone" style="border: 2px dashed var(--border-color); border-radius: 8px; padding: 16px; text-align: center; cursor: pointer; transition: all 0.2s; background: var(--bg-secondary);">
                  <div style="color: var(--text-secondary); font-size: 13px;">
                    <div style="margin-bottom: 8px;">Drag and drop an image here, or</div>
                    <label for="avatarFileInput" class="btn btn-secondary modern-btn modern-btn-secondary" style="padding: 6px 12px; font-size: 13px; cursor: pointer;">Choose File</label>
                    <input type="file" id="avatarFileInput" accept="image/png,image/jpeg,image/gif,image/webp" style="display: none;">
                  </div>
                </div>
                <div id="avatarActions" style="margin-top: 8px; display: none;">
                  <button type="button" id="removeAvatarBtn" class="btn btn-secondary modern-btn modern-btn-secondary" style="padding: 6px 12px; font-size: 13px; color: var(--danger-color);">Remove Image</button>
                </div>
                <div class="form-help" style="color: var(--text-muted); font-size: 13px; margin-top: 8px;">Supported formats: PNG, JPG, GIF, WebP. Max size: 5MB.</div>
                <div id="avatarUploadStatus" style="margin-top: 8px; font-size: 13px;"></div>
              </div>
            </div>
          </div>

          <div class="form-row" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
            <div class="form-group" style="margin-bottom: 18px;">
              <label class="form-label" style="display: block; font-weight: 500; margin-bottom: 8px; color: var(--text-primary);">Avatar Color (Fallback)</label>
              <div class="color-picker-group" style="display: flex; gap: 12px; align-items: center;">
                <div id="colorPreview" class="color-preview" style="width: 40px; height: 40px; border-radius: 8px; border: 2px solid var(--border-color); background: #4f46e5;"></div>
                <input type="color" id="avatarColor" class="form-input" value="#4f46e5" onchange="updateColorPreview(this.value)" style="width: 100%; padding: 10px 14px; border: 1px solid var(--border-color); border-radius: 6px; font-size: 14px; background: var(--bg-primary); color: var(--text-primary);">
              </div>
              <div class="form-help" style="color: var(--text-muted); font-size: 13px; margin-top: 4px;">Used when no image is uploaded.</div>
            </div>
            <div class="form-group" style="margin-bottom: 18px;">
              <label class="form-label" style="display: block; font-weight: 500; margin-bottom: 8px; color: var(--text-primary);">Favorite</label>
              <div class="toggle-switch" style="display: inline-flex; align-items: center; gap: 10px;">
                <input type="checkbox" id="favoriteToggle" class="favorite-checkbox" style="width: 20px; height: 20px; cursor: pointer;">
                <span>Mark as favorite</span>
              </div>
            </div>
          </div>

          <div class="form-group" style="margin-bottom: 18px;">
            <label class="form-label" for="tagsInput" style="display: block; font-weight: 500; margin-bottom: 8px; color: var(--text-primary);">Tags</label>
            <div id="tagsContainer" class="tags-input-container" onclick="document.getElementById('tagsInput').focus()" style="display: flex; flex-wrap: wrap; gap: 8px; padding: 8px; border: 1px solid var(--border-color); border-radius: 6px; min-height: 44px; cursor: text;">
              <input type="text" id="tagsInput" class="tag-input" placeholder="Add tags..." style="border: none; outline: none; background: transparent; min-width: 120px; font-size: 14px; color: var(--text-primary);">
            </div>
            <div class="form-help" style="color: var(--text-muted); font-size: 13px; margin-top: 4px;">Press Enter to add tags (e.g., "coding", "creative", "research").</div>
          </div>
        </div>

        <div class="form-card modern-card" style="padding: 24px; margin-bottom: 20px;">
          <div class="form-actions" style="display: flex; justify-content: flex-end; gap: 12px; align-items: center;">
            <button type="button" class="btn btn-secondary modern-btn modern-btn-secondary" id="cancelBtn">Cancel</button>
            <button type="button" class="btn btn-primary modern-btn modern-btn-primary" id="saveBtn">Save Changes</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div id="loadingOverlay" class="loading-overlay" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.4); display: none; align-items: center; justify-content: center; z-index: 1000;">
    <div class="loading-spinner" style="background: white; padding: 24px 28px; border-radius: 12px; box-shadow: 0 8px 30px rgba(0, 0, 0, 0.2); text-align: center;">
      <p>Updating agent...</p>
    </div>
  </div>

  <!-- Shared Modals (Add Agent, Marketplace, etc.) -->
  {{template "modals.tmpl" .}}

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Theme Manager - must load before other modules -->
  <script src="/js/modules/themeManager.js"></script>
  <!-- DX Utilities - must load before modules that use them -->
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/utils/dom-utils.js"></script>
  <script src="/js/modules/toast.js"></script>
  <script src="/js/modules/resizer.js"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/agents-edit.js"></script>
  <script>
    // Initialize theme
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>
</body>
</html>
{{end}}
