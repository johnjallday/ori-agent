{{define "agents-claude-detail"}}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
{{template "head.tmpl" .}}
<body class="ui-page">
  {{template "navbar.tmpl" .}}
  <a class="skip-link" href="#claude-detail-main">Skip to Main Content</a>
  <div class="main-content-wrapper">
    <main class="main-content" id="claude-detail-main" role="main" aria-labelledby="claudeDetailTitle">
      <div class="cli-detail-container">
        <a href="/agents" class="claude-detail-back cli-detail-back modern-btn modern-btn-secondary">← Back to Agents</a>
        <header class="ui-page-header">
          <div>
            <h1 id="claudeDetailTitle">Claude Code</h1>
            <p>Synced from <code>~/.claude</code> · Status-line mirroring is opt-in</p>
          </div>
          <span class="modern-badge">CLI · Read-only</span>
        </header>
        <section class="ui-section p-3" aria-label="Claude Code synced settings">
          <div id="claudeDetailMissing" role="status" aria-live="polite" hidden>Loading…</div>
          <div id="claudeSyncContent"></div>
        </section>
      </div>
    </main>
  </div>
  {{template "modals.tmpl" .}}
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/modules/toast.js"></script>
  <script type="module" src="/js/modules/provider-limits.js"></script>
  <script defer src="/js/modules/claude-sync.js"></script>
  <script defer src="/js/agents-claude-detail.js"></script>
  {{template "theme-init.tmpl" .}}
</body>
</html>
{{end}}
