{{define "templates"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper" id="templatesPage" data-current-agent="{{index .Extra "DefaultAgentName"}}">
    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">
        <!-- Header -->
        <header class="ui-page-header">
          <div>
            <h1>Templates</h1>
            <p>Folder skeletons for new workspace projects. Create a template here or import a folder.</p>
          </div>
          <div class="ui-actions" aria-label="Template library actions">
            <button id="tplCreateBtn" class="modern-btn modern-btn-primary">New Template</button>
            <button id="tplImportBtn" class="modern-btn modern-btn-secondary">Import Folder…</button>
            <button id="tplRefreshBtn" class="modern-btn modern-btn-secondary">Refresh</button>
          </div>
        </header>
        <details class="tpl-provenance mb-4">
          <summary class="ui-disclosure-title">Library location</summary>
          <code id="tplRootPath"></code>
          <div class="ui-actions mt-2">
            <a href="/settings#templates" class="modern-btn modern-btn-secondary btn-sm">Change location…</a>
            <button id="tplOpenLibraryBtn" class="modern-btn modern-btn-secondary btn-sm">Open Library</button>
          </div>
        </details>

        <div id="tplError" class="alert alert-danger d-none" role="alert"></div>

        <!-- Master / detail -->
        <div class="row g-3">
          <!-- Master list -->
          <div class="col-12 col-lg-4">
            <div class="tpl-library">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="tpl-section-title">Library</h2>
                <span id="tplCount" class="badge badge-secondary" aria-label="Matching templates">0</span>
              </div>
              <input id="tplSearch" type="text" class="modern-input w-100 mb-2" placeholder="Search templates…" aria-label="Search templates">
              <div id="tplTagFilter" class="mb-2"></div>
              <div id="tplEmpty" class="tpl-section-copy py-4" hidden>
                No templates yet. Create one above, import a folder, or drop a folder into the library.
              </div>
              <div id="tplList" class="d-flex flex-column gap-2" role="list" aria-label="Project templates">
                <div class="text-center py-3" style="color: var(--text-secondary);">Loading templates…</div>
              </div>
            </div>
          </div>

          <!-- Detail -->
          <div id="tplDetailColumn" class="col-12 col-lg-8">
            <div class="ui-section p-3">
              <!-- Empty detail -->
              <div id="tplDetailEmpty" class="text-center py-5" style="color: var(--text-secondary);">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="currentColor" style="opacity: 0.4;"><path d="M15,7H20.5L15,1.5V7M8,0H16L22,6V18A2,2 0 0,1 20,20H8C6.89,20 6,19.1 6,18V2A2,2 0 0,1 8,0M4,4V22H20V24H4A2,2 0 0,1 2,22V4H4Z"/></svg>
                <div class="mt-2">Select a template to view and edit it.</div>
              </div>

              <!-- Detail body -->
              <div id="tplDetail" hidden>
                <button id="tplBackToLibrary" type="button" class="modern-btn modern-btn-secondary btn-sm mb-3 d-lg-none">Back to library</button>
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3 flex-wrap">
                  <div style="min-width: 0;">
                    <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                      <h2 id="tplDetailName" class="tpl-detail-title mb-0" tabindex="-1">Template</h2>
                      <span id="tplDetailBuiltinBadge" hidden class="badge badge-secondary">Built-in · read-only</span>
                    </div>
                    <code id="tplDetailId" class="tpl-metadata"></code>
                  </div>
                  <div class="d-flex gap-2 flex-wrap">
                    <button id="tplDuplicateBtn" class="modern-btn modern-btn-secondary btn-sm">Duplicate</button>
                    <button id="tplRevealBtn" class="modern-btn modern-btn-secondary btn-sm">Reveal</button>
                    <button id="tplDeleteBtn" class="modern-btn modern-btn-danger btn-sm">Delete</button>
                  </div>
                </div>

                <section id="tplSetupQuest" class="tpl-setup-section mb-3" hidden aria-labelledby="tplQuestHeading">
                  <div class="d-flex align-items-start justify-content-between flex-wrap gap-3">
                    <div style="min-width: 0;">
                      <div class="tpl-section-kicker">Guided setup</div>
                      <h5 id="tplQuestHeading" class="tpl-section-title">Setup quest</h5>
                    </div>
                    <a id="tplQuestOpen" class="modern-btn modern-btn-primary btn-sm" hidden>Open Guided Setup</a>
                  </div>
                  <p id="tplQuestDescription" class="tpl-section-copy mt-2 mb-2"></p>
                  <p id="tplQuestOwnership" class="small text-muted mb-2" hidden></p>
                  <p id="tplQuestStatus" class="small mb-0" role="status" aria-live="polite"></p>
                  <button id="tplQuestRetry" type="button" class="modern-btn modern-btn-secondary btn-sm mt-2" hidden>Check again</button>
                </section>

                <ul class="nav nav-tabs mb-3" role="tablist">
                  <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="tplTabOverview" data-bs-toggle="tab" data-bs-target="#tplOverviewPane" type="button" role="tab" aria-controls="tplOverviewPane" aria-selected="true">Overview</button>
                  </li>
                  <li id="tplSetupQuestTabItem" class="nav-item" role="presentation" hidden>
                    <button class="nav-link" id="tplTabSetupQuest" data-bs-toggle="tab" data-bs-target="#tplSetupQuestPane" type="button" role="tab" aria-controls="tplSetupQuestPane" aria-selected="false">Setup quest</button>
                  </li>
                  <li id="tplFilesTabItem" class="nav-item" role="presentation">
                    <button class="nav-link" id="tplTabFiles" data-bs-toggle="tab" data-bs-target="#tplFilesPane" type="button" role="tab" aria-controls="tplFilesPane" aria-selected="false">Files</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tplTabTools" data-bs-toggle="tab" data-bs-target="#tplToolsPane" type="button" role="tab" aria-controls="tplToolsPane" aria-selected="false">Tools</button>
                  </li>
                  <li class="nav-item" role="presentation">
                    <button class="nav-link" id="tplTabAgents" data-bs-toggle="tab" data-bs-target="#tplAgentsPane" type="button" role="tab" aria-controls="tplAgentsPane" aria-selected="false">Agents</button>
                  </li>
                </ul>

                <div class="tab-content">
                  <!-- Overview / metadata -->
                  <div class="tab-pane fade show active" id="tplOverviewPane" role="tabpanel" aria-labelledby="tplTabOverview">
                    <div id="tplReadOnlyNotice" hidden class="tpl-readonly mb-3">
                      <span id="tplReadOnlyText">This is a built-in template and is read-only.</span>
                      <button id="tplDuplicateToCustomizeBtn" class="modern-btn modern-btn-primary btn-sm ms-2">Customize as a variant</button>
                    </div>
                    <div class="mb-3">
                      <label for="tplEditName" class="form-label">Display name</label>
                      <input id="tplEditName" type="text" class="modern-input w-100" maxlength="120" placeholder="Defaults to the folder id">
                    </div>
                    <div class="mb-3">
                      <label for="tplEditDescription" class="form-label">Description</label>
                      <textarea id="tplEditDescription" class="form-control" rows="3" placeholder="What is this template for?"></textarea>
                    </div>
                    <div class="mb-3">
                      <label for="tplEditGoal" class="form-label">Default goal</label>
                      <textarea id="tplEditGoal" class="modern-input w-100" rows="3" style="resize: vertical;" placeholder="No default goal" aria-describedby="tplEditGoalHelp"></textarea>
                      <p id="tplEditGoalHelp" class="small text-muted mt-1 mb-0">An outcome for future workspaces, not permission to act. Keep it concise. Leave blank to remove this default; existing workspace goals stay unchanged.</p>
                    </div>
                    <div class="row g-3 mb-3">
                      <div class="col-12 col-sm-4">
                        <label for="tplEditIcon" class="form-label">Icon</label>
                        <input id="tplEditIcon" type="text" class="modern-input w-100" maxlength="8" placeholder="✈" autocomplete="off">
                      </div>
                      <div class="col-12 col-sm-8">
                        <label for="tplEditBehavior" class="form-label">Agent behavior</label>
                        <select id="tplEditBehavior" class="modern-input w-100">
                          <option value="general">General</option>
                          <option value="research">Research</option>
                          <option value="software_project">Software Project</option>
                        </select>
                      </div>
                    </div>
                    <div class="mb-3">
                      <label for="tplEditProjectEntryPath" class="form-label">Project entry file</label>
                      <input id="tplEditProjectEntryPath" type="text" class="modern-input w-100" placeholder="{{`{{name}}`}}.project" autocomplete="off" aria-describedby="tplEditProjectEntryHelp">
                      <div id="tplEditProjectEntryHelp" class="form-helper mt-2">
                        Relative to the generated project folder. It must name a scaffolded file and may use only
                        <code>{{`{{name}}`}}</code> or <code>{{`{{date}}`}}</code> in file names. Leave blank to remove it.
                      </div>
                      <label class="d-flex align-items-center gap-2 mt-2 mb-0" style="font-size: 12px; color: var(--text-secondary); cursor: pointer;">
                        <input id="tplEditProjectEntryDefault" type="checkbox" class="form-check-input mt-0">
                        <span>Open project after creation by default</span>
                      </label>
                    </div>
                    <div class="mb-3">
                      <div id="tplEditTagsLabel" class="form-label">Tags</div>
                      <div id="tplEditTags" role="group" aria-labelledby="tplEditTagsLabel"></div>
                    </div>
                    <section id="tplGroupRequirements" class="tpl-group-requirements mb-3" aria-labelledby="tplGroupHeading">
                      <div class="d-flex align-items-start justify-content-between gap-2 flex-wrap">
                        <div>
                          <div class="tpl-section-kicker">Placement contract</div>
                          <h5 id="tplGroupHeading" class="tpl-section-title">Group requirements</h5>
                        </div>
                        <span id="tplGroupSourceBadge" class="tpl-group-source-badge">User template</span>
                      </div>
                      <p class="tpl-section-copy mt-1 mb-3">
                        Choose whether projects stay standalone or join the exact Assistant Program Home from this template's trusted source. Ordinary grouping never grants program membership or permissions.
                      </p>
                      <div id="tplGroupSource" class="tpl-group-source" hidden></div>
                      <div class="row g-3">
                        <div class="col-12 col-md-6">
                          <label for="tplGroupPolicy" class="form-label tpl-section-kicker">Policy</label>
                          <select id="tplGroupPolicy" class="modern-input w-100">
                            <option value="none">None · standalone</option>
                            <option value="recommended">Recommended · choose during creation</option>
                            <option value="required">Required · always use the Home</option>
                          </select>
                        </div>
                        <div id="tplGroupMissingWrap" class="col-12 col-md-6">
                          <label for="tplGroupMissing" class="form-label tpl-section-kicker">When the Home is missing</label>
                          <select id="tplGroupMissing" class="modern-input w-100">
                            <option value="offer_create">Offer a reviewed Home creation</option>
                            <option value="existing_only">Require an existing Home</option>
                          </select>
                        </div>
                        <div id="tplGroupNameWrap" class="col-12">
                          <label for="tplGroupHomeName" class="form-label tpl-section-kicker">Default Home display name</label>
                          <input id="tplGroupHomeName" class="modern-input w-100" maxlength="120" autocomplete="off" aria-describedby="tplGroupHomeHelp">
                          <div id="tplGroupHomeHelp" class="tpl-group-help">Used only after an explicit create review. Home identity does not depend on this name.</div>
                        </div>
                      </div>
                      <div id="tplGroupComposition" class="tpl-group-composition mt-3" role="status" aria-live="polite"></div>
                      <div id="tplGroupPreview" class="tpl-group-preview mt-3" hidden></div>
                      <div class="d-flex gap-2 align-items-center flex-wrap mt-3">
                        <button id="tplGroupPreviewBtn" type="button" class="modern-btn modern-btn-secondary btn-sm">Preview consequences</button>
                        <button id="tplGroupCustomizeBtn" type="button" class="modern-btn modern-btn-primary btn-sm" hidden>Customize as a variant</button>
                        <span id="tplGroupDirty" class="small ui-status-warning" hidden>● Unsaved placement changes</span>
                      </div>
                    </section>
                    <div class="mb-3">
                      <div class="form-label">Starter tickets</div>
                      <div id="tplStarterTasksList" class="d-flex flex-column gap-2 mb-2"></div>
                      <button id="tplStarterTaskAddBtn" type="button" class="modern-btn modern-btn-secondary btn-sm">Add ticket</button>
                      <div style="margin-top: 6px; font-size: 11px; color: var(--text-secondary);">
                        Seeded into the workspace (assigned to the Commander) on creation. Mark at most one ticket as the
                        <strong>setup ticket</strong> — it auto-starts once, when the workspace is first opened, and should
                        offer to adjust the defaults your files already scaffold. Suggested details headings:
                        <code>Created defaults</code>, <code>Questions to ask</code>, <code>Validation</code>, <code>How to apply changes</code>.
                      </div>
                    </div>
                    <div class="d-flex gap-2">
                      <button id="tplSaveBtn" class="modern-btn modern-btn-primary btn-sm">Save changes</button>
                      <button id="tplResetBtn" class="modern-btn modern-btn-secondary btn-sm">Reset</button>
                    </div>
                  </div>

                  <!-- User-owned setup quest authoring -->
                  <div class="tab-pane fade" id="tplSetupQuestPane" role="tabpanel" aria-labelledby="tplTabSetupQuest">
                    <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap mb-3">
                      <div>
                        <div class="tpl-section-kicker">User template</div>
                        <h5 class="tpl-section-title mb-1">Setup quest</h5>
                        <p class="tpl-section-copy mb-0">Guide a person through connecting a project, creating its workspace, choosing File-only or optional live setup, and reviewing Home and project staffing.</p>
                      </div>
                      <span class="badge" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-secondary);">Source · User template</span>
                    </div>
                    <div id="tplUserQuestStatus" class="alert alert-secondary py-2" role="status" aria-live="polite">Loading authoring details…</div>
                    <div id="tplUserQuestEligibility" class="mb-3" hidden></div>
                    <button id="tplUserQuestCreate" type="button" class="modern-btn modern-btn-primary btn-sm mb-3" hidden>Create setup quest</button>

                    <div id="tplUserQuestForm" hidden>
                      <div class="alert alert-light py-2" style="font-size: 12px; border: 1px solid var(--border-color);">
                        Preview and save edit inert guidance only. They do not install software, create a workspace, launch an app, staff agents, or start setup progress.
                      </div>
                      <div class="row g-3 mb-3">
                        <div class="col-12 col-md-7">
                          <label for="tplUserQuestTitle" class="form-label tpl-section-kicker">Quest title</label>
                          <input id="tplUserQuestTitle" class="modern-input w-100" maxlength="120" autocomplete="off">
                        </div>
                        <div class="col-12 col-md-5">
                          <label for="tplUserQuestIntegration" class="form-label tpl-section-kicker">Reviewed integration</label>
                          <select id="tplUserQuestIntegration" class="modern-input w-100"></select>
                        </div>
                        <div class="col-12">
                          <label for="tplUserQuestDescription" class="form-label tpl-section-kicker">Description</label>
                          <textarea id="tplUserQuestDescription" class="form-control" rows="2" maxlength="500" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);"></textarea>
                        </div>
                      </div>

                      <div class="mb-3">
                        <div class="tpl-section-kicker">Fixed journey</div>
                        <p class="small text-muted mb-2">All setup quests use these four steps once and in this order. Installing the reviewed integration comes first, outside the quest. You can edit their titles and descriptions, not their behavior.</p>
                        <div id="tplUserQuestSteps" class="d-flex flex-column gap-2"></div>
                      </div>

                      <details class="mb-3">
                        <summary style="cursor: pointer; color: var(--text-primary); font-weight: 600;">Workspace copy</summary>
                        <div class="row g-2 mt-1">
                          <div class="col-12 col-md-6"><label for="tplUserQuestGroupTitle" class="form-label small text-muted">Home step title</label><input id="tplUserQuestGroupTitle" class="modern-input w-100" maxlength="120"></div>
                          <div class="col-12 col-md-6"><label for="tplUserQuestGroupName" class="form-label small text-muted">Default Home name</label><input id="tplUserQuestGroupName" class="modern-input w-100" maxlength="120"></div>
                        </div>
                      </details>

                      <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button id="tplUserQuestPreviewBtn" type="button" class="modern-btn modern-btn-secondary btn-sm">Preview</button>
                        <button id="tplUserQuestSaveBtn" type="button" class="modern-btn modern-btn-primary btn-sm">Save setup quest</button>
                        <button id="tplUserQuestCancelBtn" type="button" class="modern-btn modern-btn-secondary btn-sm">Cancel edits</button>
                        <button id="tplUserQuestRemoveBtn" type="button" class="modern-btn modern-btn-danger btn-sm" hidden>Remove…</button>
                        <span id="tplUserQuestDirty" class="small ui-status-warning" hidden>● Unsaved changes</span>
                      </div>
                    </div>

                    <div id="tplUserQuestPreview" class="mt-3 p-3 rounded-3" style="border: 1px solid var(--border-color); background: var(--bg-tertiary);" hidden>
                      <div class="tpl-section-kicker">Preview — no setup started</div>
                      <h6 id="tplUserQuestPreviewTitle" class="mt-1 mb-1"></h6>
                      <p id="tplUserQuestPreviewDescription" class="small text-muted"></p>
                      <ol id="tplUserQuestPreviewSteps" class="mb-0 ps-3"></ol>
                    </div>
                  </div>

                  <!-- Files: in-app tree + editor -->
                  <div class="tab-pane fade" id="tplFilesPane" role="tabpanel" aria-labelledby="tplTabFiles">
                    <div class="d-flex gap-2 mb-2 flex-wrap align-items-center">
                      <button id="tplFileNewBtn" class="modern-btn modern-btn-secondary btn-sm">New File</button>
                      <button id="tplFolderNewBtn" class="modern-btn modern-btn-secondary btn-sm">New Folder</button>
                      <button id="tplFilesRefreshBtn" class="modern-btn modern-btn-secondary btn-sm">Refresh</button>
                      <span class="ms-auto" style="font-size: 11px; color: var(--text-secondary);">
                        <code>{{`{{name}}`}}</code> / <code>{{`{{date}}`}}</code> in names are filled in when a project is created.
                      </span>
                    </div>
                    <div class="row g-2">
                      <div class="col-12 col-md-5">
                        <div id="tplFileTree" class="d-flex flex-column gap-1" style="max-height: 440px; overflow: auto;" role="tree" aria-label="Template files">
                          <div class="text-center py-3" style="color: var(--text-secondary); font-size: 13px;">Loading files…</div>
                        </div>
                      </div>
                      <div class="col-12 col-md-7">
                        <div id="tplEditorEmpty" class="text-center py-4" style="color: var(--text-secondary); font-size: 13px;">
                          Select a file to view or edit it.
                        </div>
                        <div id="tplEditor" hidden>
                          <div class="d-flex justify-content-between align-items-center mb-1 gap-2 flex-wrap">
                            <code id="tplEditorPath" style="font-size: 12px; color: var(--text-primary); word-break: break-all;"></code>
                            <div class="d-flex gap-2">
                              <button id="tplFileRenameBtn" class="modern-btn modern-btn-secondary btn-sm">Rename</button>
                              <button id="tplFileDeleteBtn" class="modern-btn modern-btn-danger btn-sm">Delete</button>
                            </div>
                          </div>
                          <div id="tplEditorNotice" class="alert alert-secondary py-2 mb-2" style="font-size: 12px;" hidden></div>
                          <textarea id="tplEditorTextarea" class="form-control tpl-file-editor" aria-label="File content" spellcheck="false" wrap="off"></textarea>
                          <div class="d-flex gap-2 mt-2 align-items-center">
                            <button id="tplEditorSaveBtn" class="modern-btn modern-btn-primary btn-sm">Save</button>
                            <span id="tplEditorDirty" class="small ui-status-warning" hidden>● Unsaved changes</span>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>

                  <!-- Tools: default skills / MCP servers / plugins bound on workspace creation -->
                  <div class="tab-pane fade" id="tplToolsPane" role="tabpanel" aria-labelledby="tplTabTools">
                    <div style="font-size: 12px; color: var(--text-secondary);" class="mb-2">
                      Tools checked here are bound to a workspace when it's created from this template —
                      applied if present on the machine (missing ones are skipped with a note at creation).
                    </div>
                    <h6 class="mb-1" style="color: var(--text-primary);">Skills</h6>
                    <div id="tplToolsSkills" class="d-flex flex-column gap-1 mb-3"></div>
                    <h6 class="mb-1" style="color: var(--text-primary);">MCP Servers</h6>
                    <div id="tplToolsMcp" class="d-flex flex-column gap-1 mb-3"></div>
                    <h6 class="mb-1" style="color: var(--text-primary);">Plugins</h6>
                    <div id="tplToolsPlugins" class="d-flex flex-column gap-1 mb-3"></div>
                    <button id="tplToolsSaveBtn" class="modern-btn modern-btn-primary btn-sm">Save tools</button>
                  </div>

                  <!-- Agents: roster seeded when a workspace is created from this template -->
                  <div class="tab-pane fade" id="tplAgentsPane" role="tabpanel" aria-labelledby="tplTabAgents">
                    <div id="tplAgentsReadOnlyNotice" hidden class="tpl-agents-readonly mb-3">
                      <span id="tplAgentsReadOnlyText">This is a built-in template and is read-only.</span>
                      <button id="tplAgentsDuplicateBtn" class="modern-btn modern-btn-primary btn-sm">Duplicate to customize</button>
                    </div>
                    <div class="tpl-agents-head">
                      <div>
                        <div class="tpl-section-kicker">Seeded roster</div>
                        <h5 class="tpl-section-title">Agents</h5>
                        <p class="tpl-section-copy">
                          Agents are created when a workspace is made from this template. The first card becomes the Commander; the rest seed specialist sub-agents.
                          Every template needs at least one agent — the Commander owns the template's starter tickets.
                        </p>
                      </div>
                      <div class="tpl-agents-actions">
                        <button id="tplAgentsAddBtn" class="modern-btn modern-btn-secondary btn-sm">Add agent</button>
                        <button id="tplAgentsSaveBtn" class="modern-btn modern-btn-primary btn-sm">Save agents</button>
                      </div>
                    </div>
                    <div id="tplAgentsEmpty" class="tpl-agents-empty" hidden>
                      <div class="tpl-agents-empty-title">No seeded agents</div>
                      <div>Add at least one agent — until then, workspaces created from this template get an auto-created "&lt;Name&gt; Manager" as their Commander.</div>
                    </div>
                    <div id="tplAgentsList" class="tpl-agents-grid mb-3"></div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Shared modals (add agent, etc.) -->
  {{template "modals.tmpl" .}}

  <!-- Name modal: reused for Create and Duplicate -->
  <div class="modal fade" id="tplNameModal" tabindex="-1" aria-labelledby="tplNameModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" id="tplNameModalTitle" style="color: var(--text-primary);">New Template</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="color: var(--text-primary);">
          <label for="tplNameModalInput" id="tplNameModalLabel" class="form-label">Template name</label>
          <input id="tplNameModalInput" type="text" class="modern-input w-100" maxlength="120" placeholder="e.g. Media Project">
          <small class="form-helper">The folder id is derived from the name (lowercase, hyphenated).</small>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="tplNameModalConfirm" class="modern-btn modern-btn-primary">Create</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Dirty-editor guard: shown when switching away with unsaved file edits -->
  <div class="modal fade" id="tplDirtyModal" tabindex="-1" aria-labelledby="tplDirtyModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" id="tplDirtyModalTitle">Unsaved changes</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="color: var(--text-primary);">
          You have unsaved changes to <code id="tplDirtyFile"></code>. What would you like to do?
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" id="tplDirtyCancel" class="modern-btn modern-btn-secondary">Keep editing</button>
          <button type="button" id="tplDirtyDiscard" class="modern-btn modern-btn-secondary">Discard</button>
          <button type="button" id="tplDirtySave" class="modern-btn modern-btn-primary">Save</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/modules/toast.js"></script>
  <script defer src="/js/modules/agents.js"></script>
  <script defer src="/js/modules/templates-page.js"></script>
  {{template "theme-init.tmpl" .}}
</body>
</html>
{{end}}
