{{define "plugins"}}
<!DOCTYPE html>
<html lang="en">
{{template "head.tmpl" .}}

<style>
.plugins-page .plugins-container {
    max-width: 1560px;
    margin: 0 auto;
}

.plugins-page .page-header {
    margin-bottom: 1rem;
    padding: 1.4rem;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1.25rem;
}

.plugins-page .page-header.modern-card:hover {
    transform: none;
}

.plugins-page .page-title-block {
    min-width: 260px;
}

.plugins-page .page-title {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--text-primary);
    font-size: 1.65rem;
    letter-spacing: 0.01em;
}

.plugins-page .page-subtitle {
    margin: 0.45rem 0 0.7rem;
    color: var(--text-secondary);
    font-size: 0.93rem;
}

.plugins-page .current-agent-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgba(180, 126, 87, 0.35);
    background: rgba(255, 249, 239, 0.72);
    color: var(--text-secondary);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.02em;
}

[data-bs-theme="dark"] .plugins-page .current-agent-chip {
    background: rgba(36, 45, 62, 0.72);
    border-color: rgba(221, 162, 121, 0.3);
}

.plugins-page .current-agent-chip strong {
    color: var(--text-primary);
    font-weight: 700;
}

.plugins-page .header-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: flex-end;
}

.plugins-page .notification-badge {
    position: relative;
    padding-right: 1.9rem;
}

.plugins-page .notification-count {
    position: absolute;
    top: -6px;
    right: -4px;
    min-width: 18px;
    height: 18px;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--danger-color);
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.68rem;
    font-weight: 700;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.24);
}

/* Override legacy ui-refresh plugin styles that force light controls in dark mode */
[data-bs-theme="dark"] body.plugins-page .notification-badge,
.dark-mode body.plugins-page .notification-badge {
    background: rgba(32, 39, 55, 0.86);
    border-color: rgba(209, 171, 130, 0.3);
    color: var(--text-primary);
}

[data-bs-theme="dark"] body.plugins-page .notification-badge:hover,
.dark-mode body.plugins-page .notification-badge:hover {
    background: rgba(40, 50, 70, 0.92);
    border-color: rgba(221, 181, 138, 0.4);
}

[data-bs-theme="dark"] body.plugins-page .search-input,
[data-bs-theme="dark"] body.plugins-page .filter-select,
[data-bs-theme="dark"] body.plugins-page .page-size-select,
[data-bs-theme="dark"] body.plugins-page .pagination-btn,
[data-bs-theme="dark"] body.plugins-page .btn-action,
.dark-mode body.plugins-page .search-input,
.dark-mode body.plugins-page .filter-select,
.dark-mode body.plugins-page .page-size-select,
.dark-mode body.plugins-page .pagination-btn,
.dark-mode body.plugins-page .btn-action {
    background: rgba(27, 35, 49, 0.88);
    border-color: rgba(203, 166, 124, 0.28);
    color: var(--text-primary);
}

[data-bs-theme="dark"] body.plugins-page .search-input::placeholder,
.dark-mode body.plugins-page .search-input::placeholder {
    color: rgba(213, 199, 176, 0.72);
}

[data-bs-theme="dark"] body.plugins-page .filter-label,
.dark-mode body.plugins-page .filter-label {
    color: var(--text-secondary);
}

[data-bs-theme="dark"] body.plugins-page .filter-select option,
[data-bs-theme="dark"] body.plugins-page .page-size-select option,
.dark-mode body.plugins-page .filter-select option,
.dark-mode body.plugins-page .page-size-select option {
    background: #1f2738;
    color: #f5ede0;
}

.plugins-page .filter-bar {
    margin-bottom: 1rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--surface-solid);
    box-shadow: var(--shadow-sm);
}

.plugins-page .filter-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.9rem;
}

.plugins-page .search-box {
    position: relative;
    flex: 1 1 280px;
    min-width: 240px;
}

.plugins-page .search-input {
    width: 100%;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: 0.6rem 0.9rem 0.6rem 2.35rem;
    font-size: 0.9rem;
}

.plugins-page .search-input:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px var(--primary-color-light);
}

.plugins-page .search-icon {
    position: absolute;
    left: 0.75rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
}

.plugins-page .filter-group {
    display: flex;
    align-items: center;
    gap: 0.45rem;
}

.plugins-page .filter-label {
    color: var(--text-secondary);
    font-size: 0.84rem;
    font-weight: 600;
    margin: 0;
}

.plugins-page .filter-select {
    min-width: 140px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: 0.52rem 0.78rem;
    font-size: 0.85rem;
}

.plugins-page .filter-select:focus {
    outline: none;
    border-color: var(--primary-color);
    box-shadow: 0 0 0 3px var(--primary-color-light);
}

.plugins-page .bulk-actions-bar {
    display: none;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
    padding: 0.7rem 0.95rem;
    border: 1px solid rgba(199, 90, 52, 0.35);
    border-radius: var(--radius-md);
    background: rgba(255, 244, 230, 0.75);
}

[data-bs-theme="dark"] .plugins-page .bulk-actions-bar {
    background: rgba(36, 45, 62, 0.74);
}

.plugins-page .bulk-actions-bar.active {
    display: flex;
}

.plugins-page .bulk-actions-count {
    border-right: 1px solid var(--border-color);
    padding-right: 0.8rem;
    color: var(--text-primary);
    font-weight: 600;
    font-size: 0.9rem;
}

.plugins-page .bulk-actions-buttons {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.plugins-page .plugins-table-container {
    overflow: hidden;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--surface-solid);
    box-shadow: var(--shadow-md);
}

.plugins-page .plugins-table {
    width: 100%;
    border-collapse: collapse;
}

.plugins-page .plugins-table thead {
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
}

.plugins-page .plugins-table th {
    padding: 0.92rem 0.85rem;
    text-align: left;
    color: var(--text-secondary);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 700;
}

.plugins-page .plugins-table td {
    padding: 0.95rem 0.85rem;
    color: var(--text-primary);
    border-bottom: 1px solid var(--border-light);
    vertical-align: top;
}

.plugins-page .plugins-table tbody tr:last-child td {
    border-bottom: none;
}

.plugins-page .plugins-table tbody tr:hover {
    background: rgba(226, 200, 166, 0.18);
}

[data-bs-theme="dark"] .plugins-page .plugins-table tbody tr:hover {
    background: rgba(62, 76, 102, 0.22);
}

.plugins-page .sortable {
    cursor: pointer;
    user-select: none;
}

.plugins-page .sortable:hover,
.plugins-page .sortable.active {
    color: var(--primary-color);
}

.plugins-page .sort-indicator {
    display: inline-block;
    margin-left: 0.35rem;
    opacity: 0.45;
    transition: opacity 0.2s ease, transform 0.2s ease;
}

.plugins-page .sortable.active .sort-indicator {
    opacity: 1;
}

.plugins-page .sortable.desc .sort-indicator {
    transform: rotate(180deg);
}

.plugins-page .plugin-name {
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 700;
}

.plugins-page .plugin-description {
    margin-top: 0.15rem;
    color: var(--text-muted);
    font-size: 0.82rem;
}

.plugins-page .plugin-tags {
    margin-top: 0.45rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.32rem;
}

.plugins-page .tag-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.18rem 0.5rem;
    border: 1px solid var(--border-color);
    border-radius: 999px;
    color: var(--text-secondary);
    background: var(--bg-secondary);
    font-size: 0.7rem;
    font-weight: 600;
}

.plugins-page .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.36rem;
    padding: 0.26rem 0.62rem;
    border-radius: 999px;
    font-size: 0.73rem;
    font-weight: 700;
    letter-spacing: 0.02em;
}

.plugins-page .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
}

.plugins-page .status-active {
    background: rgba(47, 153, 105, 0.16);
    color: var(--success-color);
}

.plugins-page .status-active .status-dot {
    background: var(--success-color);
}

.plugins-page .status-inactive {
    background: rgba(96, 111, 133, 0.18);
    color: var(--text-secondary);
}

.plugins-page .status-inactive .status-dot {
    background: var(--text-secondary);
}

.plugins-page .status-error {
    background: rgba(204, 78, 63, 0.16);
    color: var(--danger-color);
}

.plugins-page .status-error .status-dot {
    background: var(--danger-color);
}

.plugins-page .status-update {
    background: rgba(204, 138, 44, 0.16);
    color: var(--warning-color);
}

.plugins-page .status-update .status-dot {
    background: var(--warning-color);
}

.plugins-page .category-badge {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.24rem 0.56rem;
    background: rgba(82, 101, 136, 0.16);
    color: var(--text-secondary);
    font-size: 0.72rem;
    font-weight: 600;
}

.plugins-page .agent-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.33rem;
}

.plugins-page .agent-tag {
    display: inline-flex;
    align-items: center;
    border-radius: 999px;
    padding: 0.2rem 0.52rem;
    background: rgba(196, 170, 138, 0.25);
    color: var(--text-secondary);
    font-size: 0.72rem;
    font-weight: 600;
}

.plugins-page .action-buttons {
    display: flex;
    flex-direction: column;
    gap: 0.34rem;
}

.plugins-page .btn-action {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: rgba(255, 255, 255, 0.45);
    color: var(--text-secondary);
    padding: 0.34rem 0.55rem;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s ease;
}

[data-bs-theme="dark"] .plugins-page .btn-action {
    background: rgba(20, 25, 36, 0.6);
}

.plugins-page .btn-action:hover {
    color: var(--text-primary);
    border-color: rgba(180, 126, 87, 0.5);
    background: rgba(255, 249, 239, 0.84);
}

.plugins-page .btn-action:disabled {
    opacity: 0.55;
    cursor: not-allowed;
}

.plugins-page .btn-action.btn-danger:hover {
    background: var(--danger-color);
    border-color: var(--danger-color);
    color: #fff;
}

.plugins-page .pagination-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0.95rem;
    border-top: 1px solid var(--border-color);
    background: rgba(231, 216, 194, 0.3);
}

[data-bs-theme="dark"] .plugins-page .pagination-container {
    background: rgba(38, 47, 66, 0.34);
}

.plugins-page .pagination-info {
    color: var(--text-secondary);
    font-size: 0.84rem;
}

.plugins-page .pagination-controls {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
}

.plugins-page .pagination-btn {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    color: var(--text-secondary);
    padding: 0.34rem 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
}

.plugins-page .pagination-btn:hover:not(:disabled),
.plugins-page .pagination-btn.active {
    border-color: rgba(180, 126, 87, 0.55);
    color: var(--primary-color);
    background: rgba(255, 249, 239, 0.88);
}

.plugins-page .pagination-btn:disabled {
    opacity: 0.45;
}

.plugins-page .page-size-select {
    margin-left: 0.45rem;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-sm);
    background: var(--bg-primary);
    color: var(--text-primary);
    padding: 0.32rem 0.5rem;
    font-size: 0.78rem;
}

.plugins-page .empty-state {
    display: none;
    margin-top: 0.7rem;
    border: 1px dashed rgba(180, 126, 87, 0.4);
    border-radius: var(--radius-lg);
    background: rgba(255, 249, 239, 0.64);
    text-align: center;
    padding: 3.2rem 1.5rem;
    color: var(--text-secondary);
}

[data-bs-theme="dark"] .plugins-page .empty-state {
    background: rgba(32, 40, 56, 0.66);
}

.plugins-page .empty-state-icon {
    opacity: 0.55;
    margin-bottom: 0.65rem;
}

.plugins-page .empty-state-text {
    color: var(--text-primary);
    font-size: 1.18rem;
    font-weight: 700;
}

.plugins-page .empty-state-subtext {
    margin-top: 0.45rem;
    margin-bottom: 1.2rem;
    font-size: 0.9rem;
}

.plugins-page .empty-state-actions {
    display: flex;
    justify-content: center;
    gap: 0.65rem;
    flex-wrap: wrap;
}

.plugins-page .loading {
    display: none;
    justify-content: center;
    align-items: center;
    padding: 2.2rem;
}

.plugins-page .spinner {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 3px solid var(--border-color);
    border-top-color: var(--primary-color);
    animation: pluginsSpin 0.9s linear infinite;
}

@keyframes pluginsSpin {
    to { transform: rotate(360deg); }
}

.plugins-page .plugins-cards-container {
    display: none;
}

.plugins-page .plugin-card {
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--surface-solid);
    box-shadow: var(--shadow-sm);
    padding: 1rem;
}

.plugins-page .plugin-card + .plugin-card {
    margin-top: 0.75rem;
}

.plugins-page .plugin-card-header {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    margin-bottom: 0.65rem;
}

.plugins-page .plugin-card-name {
    color: var(--text-primary);
    font-size: 0.95rem;
    font-weight: 700;
}

.plugins-page .plugin-card-description {
    color: var(--text-muted);
    margin-top: 0.15rem;
    font-size: 0.82rem;
}

.plugins-page .plugin-card-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 0.6rem;
}

.plugins-page .plugin-card-actions {
    margin-top: 0.65rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--border-light);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.4rem;
}

.plugins-page .notification-drawer {
    position: fixed;
    top: 0;
    right: -420px;
    width: min(420px, 100vw);
    height: 100vh;
    z-index: 1040;
    border-left: 1px solid var(--border-color);
    background: var(--surface-solid);
    backdrop-filter: blur(16px);
    box-shadow: var(--shadow-xl);
    transition: right 0.24s ease;
    overflow-y: auto;
}

.plugins-page .notification-drawer.active {
    right: 0;
}

.plugins-page .drawer-header {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.7rem;
    padding: 1rem 1.15rem;
    border-bottom: 1px solid var(--border-color);
    background: inherit;
}

.plugins-page .drawer-title {
    color: var(--text-primary);
    font-size: 1.05rem;
    font-weight: 700;
}

.plugins-page .notification-item {
    padding: 0.9rem 1.15rem;
    border-bottom: 1px solid var(--border-light);
}

.plugins-page .notification-item.unread {
    background: rgba(199, 90, 52, 0.08);
}

.plugins-page .notification-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.4rem;
}

.plugins-page .notification-type {
    color: var(--text-primary);
    font-size: 0.86rem;
    font-weight: 700;
}

.plugins-page .notification-time {
    color: var(--text-muted);
    font-size: 0.76rem;
}

.plugins-page .notification-message {
    color: var(--text-secondary);
    font-size: 0.84rem;
}

.plugins-page .notification-actions {
    margin-top: 0.55rem;
}

.plugins-page .modal-overlay {
    position: fixed;
    inset: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 1rem;
    background: rgba(13, 16, 23, 0.58);
    backdrop-filter: blur(8px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.24s ease;
    z-index: 1060;
}

.plugins-page .modal-overlay.active {
    opacity: 1;
    visibility: visible;
}

.plugins-page .modal-overlay .modal-content {
    width: min(92vw, 640px);
    max-height: 90vh;
    overflow-y: auto;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border-color);
    background: var(--surface-solid);
    box-shadow: var(--shadow-xl);
    transform: translateY(8px) scale(0.98);
    transition: transform 0.24s ease;
}

.plugins-page .modal-overlay.active .modal-content {
    transform: translateY(0) scale(1);
}

.plugins-page .modal-overlay .modal-header,
.plugins-page .modal-overlay .modal-footer {
    padding: 1rem 1.15rem;
    border-color: var(--border-color);
}

.plugins-page .modal-overlay .modal-header {
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem;
}

.plugins-page .modal-overlay .modal-title {
    margin: 0;
    color: var(--text-primary);
    font-size: 1.08rem;
    font-weight: 700;
}

.plugins-page .modal-overlay .modal-body {
    padding: 1.15rem;
}

.plugins-page .modal-overlay .modal-footer {
    border-top: 1px solid var(--border-color);
    display: flex;
    justify-content: flex-end;
    gap: 0.55rem;
}

.plugins-page .modal-close {
    border: none;
    background: transparent;
    color: var(--text-secondary);
    width: 28px;
    height: 28px;
    border-radius: var(--radius-sm);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 1.3rem;
}

.plugins-page .modal-close:hover {
    background: rgba(199, 90, 52, 0.14);
    color: var(--text-primary);
}

.plugins-page #toastContainer {
    position: fixed;
    top: 84px;
    right: 16px;
    z-index: 1080;
}

.plugins-page #toastContainer .toast {
    min-width: 260px;
    max-width: 360px;
    margin-bottom: 0.45rem;
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--border-color);
    border-left-width: 4px;
    border-radius: var(--radius-md);
    background: var(--surface-solid);
    color: var(--text-primary);
    box-shadow: var(--shadow-md);
    display: flex;
    align-items: center;
    gap: 0.55rem;
    animation: pluginsToastIn 0.18s ease;
}

.plugins-page #toastContainer .toast.success { border-left-color: var(--success-color); }
.plugins-page #toastContainer .toast.error { border-left-color: var(--danger-color); }
.plugins-page #toastContainer .toast.warning { border-left-color: var(--warning-color); }
.plugins-page #toastContainer .toast.info { border-left-color: var(--info-color); }

@keyframes pluginsToastIn {
    from {
        transform: translateX(10px);
        opacity: 0;
    }
    to {
        transform: translateX(0);
        opacity: 1;
    }
}

@media (max-width: 992px) {
    .plugins-page .page-header {
        padding: 1.15rem;
        flex-direction: column;
    }

    .plugins-page .header-actions {
        width: 100%;
        justify-content: flex-start;
    }

    .plugins-page .filter-group {
        flex: 1 1 210px;
    }

    .plugins-page .filter-select {
        width: 100%;
    }

    .plugins-page .bulk-actions-bar {
        flex-direction: column;
        align-items: stretch;
    }

    .plugins-page .bulk-actions-count {
        border-right: none;
        border-bottom: 1px solid var(--border-color);
        padding-right: 0;
        padding-bottom: 0.5rem;
    }

    .plugins-page .plugins-table-container {
        display: none;
    }

    .plugins-page .plugins-cards-container {
        display: block;
    }

    .plugins-page .pagination-container {
        flex-direction: column;
        align-items: flex-start;
    }
}

@media (max-width: 576px) {
    .plugins-page #toastContainer {
        right: 8px;
        left: 8px;
    }

    .plugins-page #toastContainer .toast {
        max-width: none;
        width: 100%;
    }

    .plugins-page .plugin-card-actions {
        grid-template-columns: 1fr;
    }
}
</style>

<body class="bg-light plugins-page">
    {{template "navbar.tmpl" .}}

    <div class="main-content-wrapper">
        {{template "sidebar.tmpl" .}}

        <div class="main-content">
            <div class="container-fluid py-4">
                <div class="plugins-container">
                    <!-- Page Header -->
                    <div class="page-header modern-card">
                        <div class="page-title-block">
                            <h2 class="page-title">
                                <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M16,6V4H8V6H3V8L5,12V20H19V12L21,8V6H16M11,18H7V12H11V18M17,18H13V12H17V18M5.67,8H18.33L17.33,10H6.67L5.67,8Z"/>
                                </svg>
                                Plugin Management
                            </h2>
                            <p class="page-subtitle">Manage installed plugins, health, and updates from one place.</p>
                            <div class="current-agent-chip">
                                Current Agent:
                                <strong id="currentAgentNameDisplay">{{.CurrentAgent}}</strong>
                            </div>
                        </div>
                        <div class="header-actions">
                            <button class="modern-btn modern-btn-secondary notification-badge" id="notificationBadge" type="button" aria-label="Open plugin notifications">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M21,19V20H3V19L5,17V11C5,7.9 7.03,5.17 10,4.29C10,4.19 10,4.1 10,4A2,2 0 0,1 12,2A2,2 0 0,1 14,4C14,4.1 14,4.19 14,4.29C16.97,5.17 19,7.9 19,11V17L21,19M14,21A2,2 0 0,1 12,23A2,2 0 0,1 10,21"/>
                                </svg>
                                Notifications
                                <span class="notification-count" id="notificationCount" style="display: none;">0</span>
                            </button>
                            <a class="modern-btn modern-btn-secondary" href="/marketplace" style="text-decoration: none;">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M16 6V4H8V6H3V8L5 12V20H19V12L21 8V6H16M11 18H7V12H11V18M17 18H13V12H17V18M5.67 8H18.33L17.33 10H6.67L5.67 8Z"/>
                                </svg>
                                Plugin Marketplace
                            </a>
                            <button class="modern-btn modern-btn-primary" id="uploadBtn" type="button">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                    <path d="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"/>
                                </svg>
                                Upload Plugin
                            </button>
                        </div>
                    </div>

                    <!-- Filter Bar -->
                    <div class="filter-bar">
                        <div class="filter-row">
                            <div class="search-box">
                                <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                                    <path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
                                </svg>
                                <input type="text" class="search-input" id="searchInput" placeholder="Search plugins...">
                            </div>
                            <div class="filter-group">
                                <label class="filter-label" for="statusFilter">Status</label>
                                <select class="filter-select" id="statusFilter">
                                    <option value="">All</option>
                                    <option value="healthy">Healthy</option>
                                    <option value="error">Error</option>
                                    <option value="update">Needs Update</option>
                                </select>
                            </div>
                            <div class="filter-group">
                                <label class="filter-label" for="categoryFilter">Category</label>
                                <select class="filter-select" id="categoryFilter">
                                    <option value="">All Categories</option>
                                    <option value="System Tools">System Tools</option>
                                    <option value="AI/ML">AI/ML</option>
                                    <option value="Data Processing">Data Processing</option>
                                    <option value="Utilities">Utilities</option>
                                    <option value="Automation">Automation</option>
                                    <option value="Communication">Communication</option>
                                    <option value="Development">Development</option>
                                    <option value="Security">Security</option>
                                    <option value="Custom">Custom</option>
                                </select>
                            </div>
                        </div>
                    </div>

                <!-- Bulk Actions Bar -->
                <div class="bulk-actions-bar" id="bulkActionsBar">
                    <span class="bulk-actions-count"><span id="selectedCount">0</span> selected</span>
                    <div class="bulk-actions-buttons">
                        <button class="btn-action" type="button" onclick="bulkUpdatePlugins()">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; margin-right: 4px;">
                                <path d="M21,10.12H14.22L16.96,7.3C14.23,4.6 9.81,4.5 7.08,7.2C4.35,9.91 4.35,14.28 7.08,17C9.81,19.7 14.23,19.7 16.96,17C18.32,15.65 19,14.08 19,12.1H21C21,14.08 20.12,16.65 18.36,18.39C14.85,21.87 9.15,21.87 5.64,18.39C2.14,14.92 2.11,9.28 5.62,5.81C9.13,2.34 14.76,2.34 18.27,5.81L21,3V10.12Z"/>
                            </svg>
                            Update Selected
                        </button>
                        <button class="btn-action btn-danger" type="button" onclick="bulkDeletePlugins()">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: middle; margin-right: 4px;">
                                <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                            </svg>
                            Delete Selected
                        </button>
                    </div>
                </div>

                <!-- Plugins Table -->
                <div class="plugins-table-container">
                    <table class="plugins-table">
                        <thead>
                            <tr>
                                <th style="width: 5%;">
                                    <input type="checkbox" id="selectAll" aria-label="Select all plugins">
                                </th>
                                <th style="width: 35%;" class="sortable" data-sort="name">
                                    Plugin
                                    <span class="sort-indicator">▲</span>
                                </th>
                                <th style="width: 10%;" class="sortable" data-sort="version">
                                    Version
                                    <span class="sort-indicator">▲</span>
                                </th>
                                <th style="width: 15%;">Agents</th>
                                <th style="width: 15%;" class="sortable" data-sort="status">
                                    Status
                                    <span class="sort-indicator">▲</span>
                                </th>
                                <th style="width: 10%;" class="sortable" data-sort="category">
                                    Category
                                    <span class="sort-indicator">▲</span>
                                </th>
                                <th style="width: 10%;">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="pluginsTableBody">
                            <!-- Populated dynamically -->
                        </tbody>
                    </table>
                    <!-- Pagination -->
                    <div class="pagination-container" id="paginationContainer">
                        <div class="pagination-info">
                            Showing <span id="paginationStart">0</span>-<span id="paginationEnd">0</span> of <span id="paginationTotal">0</span> plugins
                        </div>
                        <div class="pagination-controls">
                            <button class="pagination-btn" id="prevPage" onclick="changePage(-1)" disabled>← Previous</button>
                            <div id="pageNumbers"></div>
                            <button class="pagination-btn" id="nextPage" onclick="changePage(1)">Next →</button>
                            <select class="page-size-select" id="pageSizeSelect" onchange="changePageSize(this.value)" aria-label="Items per page">
                                <option value="10">10 / page</option>
                                <option value="25" selected>25 / page</option>
                                <option value="50">50 / page</option>
                                <option value="100">100 / page</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Mobile Card View -->
                <div class="plugins-cards-container" id="pluginsCardsContainer">
                    <!-- Populated dynamically -->
                </div>

                <!-- Empty State (shown when no plugins) -->
                <div class="empty-state" id="emptyState" style="display: none;">
                    <div class="empty-state-icon">
                        <svg width="64" height="64" viewBox="0 0 24 24" fill="currentColor" style="opacity: 0.4;">
                            <path d="M20.5,11H19V7C19,5.89 18.1,5 17,5H13V3.5A2.5,2.5 0 0,0 10.5,1A2.5,2.5 0 0,0 8,3.5V5H4C2.89,5 2,5.89 2,7V10.8H3.5C5,10.8 6.2,12 6.2,13.5C6.2,15 5,16.2 3.5,16.2H2V20C2,21.11 2.89,22 4,22H7.8V20.5C7.8,19 9,17.8 10.5,17.8C12,17.8 13.2,19 13.2,20.5V22H17C18.11,22 19,21.11 19,20V16H20.5A2.5,2.5 0 0,0 23,13.5A2.5,2.5 0 0,0 20.5,11Z"/>
                        </svg>
                    </div>
                    <div class="empty-state-text">No plugins installed yet</div>
                    <div class="empty-state-subtext">Extend your agent's capabilities by adding plugins from the marketplace or uploading your own.</div>
                    <div class="empty-state-actions">
                        <a href="/marketplace" class="modern-btn modern-btn-primary" style="text-decoration: none;">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M16 6V4H8V6H3V8L5 12V20H19V12L21 8V6H16M11 18H7V12H11V18M17 18H13V12H17V18M5.67 8H18.33L17.33 10H6.67L5.67 8Z"/>
                            </svg>
                            Browse Marketplace
                        </a>
                        <button class="modern-btn modern-btn-secondary" type="button" onclick="document.getElementById('uploadBtn').click()">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"/>
                            </svg>
                            Upload Plugin
                        </button>
                    </div>
                </div>

                <!-- Loading State -->
                <div class="loading" id="loadingState" style="display: none;">
                    <div class="spinner"></div>
                </div>
            </div>
        </div>
    </div>

    </div>

    <!-- Notification Drawer -->
    <div class="notification-drawer" id="notificationDrawer">
        <div class="drawer-header">
            <div class="drawer-title">Notifications</div>
            <button class="modal-close" id="closeDrawer" type="button" aria-label="Close notifications panel">&times;</button>
        </div>
        <div id="notificationsList">
            <!-- Populated dynamically -->
        </div>
    </div>

    <!-- Plugin Upload Modal (shared design) -->
    <div class="modal fade" id="pluginUploadModal" tabindex="-1" aria-labelledby="pluginUploadModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                    <h5 class="modal-title" id="pluginUploadModalLabel" style="color: var(--text-primary);">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                            <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                        </svg>
                        Upload Plugin
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <p style="color: var(--text-secondary);">Upload a plugin binary by dragging and dropping it below or clicking to browse.</p>
                    </div>

                    <!-- Drag and Drop Area -->
                    <div id="uploadDropZone" class="upload-drop-zone mb-3" style="border: 2px dashed var(--border-color); border-radius: 8px; background: var(--bg-secondary); cursor: pointer; transition: all 0.3s ease;">
                        <div class="text-center py-5">
                            <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" class="mb-3" style="color: var(--text-secondary);">
                                <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                            </svg>
                            <h6 style="color: var(--text-primary);">Drag & Drop Plugin File</h6>
                            <p class="text-muted mb-3">Or click to browse for files</p>
                            <button type="button" class="modern-btn modern-btn-secondary" onclick="event.stopPropagation(); document.getElementById('pluginFileInput').click()">
                                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                                    <path d="M16,13H15V18H13V13H8L12,9L16,13M15,4H9V6H15V4Z"/>
                                </svg>
                                Browse Files
                            </button>
                        </div>
                    </div>

                    <!-- Hidden File Input -->
                    <input type="file" id="pluginFileInput" style="display: none;">

                    <!-- Upload Progress -->
                    <div id="uploadProgress" class="d-none mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span style="color: var(--text-primary);">Uploading...</span>
                            <span id="uploadPercent" style="color: var(--text-secondary);">0%</span>
                        </div>
                        <div class="progress">
                            <div id="uploadProgressBar" class="progress-bar" role="progressbar" style="width: 0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                    </div>

                    <!-- Upload Result -->
                    <div id="uploadResult" class="d-none"></div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                    <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast Container -->
    <div id="toastContainer"></div>

    <!-- Shared Modals (Add Agent, Marketplace, etc.) -->
    {{template "modals.tmpl" .}}

    <!-- Include app.js for sidebar toggle functionality -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DX Utilities -->
    <script src="/js/utils/logger.js"></script>
    <script src="/js/utils/event-bus.js"></script>
    <script src="/js/utils/api-client.js"></script>
    <script src="/js/utils/dom-utils.js"></script>
    <script src="/js/app.js?v=1694538177"></script>
    <!-- Load page-specific plugins.js first -->
    <script src="/js/plugins.js?v={{.Version}}"></script>
    <!-- Then load modules for sidebar functionality (will override loadPlugins for sidebar) -->
    <script src="/js/modules/plugin-config.js"></script>
    <script src="/js/modules/agents.js"></script>
    <script src="/js/modules/plugins.js?v={{.Version}}"></script>
    <script src="/js/modules/sidebar.js"></script>
    <script src="/js/modules/themeManager.js"></script>
    <script>
        // Initialize theme toggle so the icon/text match the active theme
        document.addEventListener('DOMContentLoaded', function() {
            themeManager.initialize();
        });
    </script>
</body>
</html>
{{end}}
