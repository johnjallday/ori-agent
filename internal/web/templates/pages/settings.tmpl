              <label class="settings-label" for="openaiApiKeyInput">OpenAI API Key</label>
              <div class="input-group">
                <input type="password"
                       id="openaiApiKeyInput"
                       class="form-control settings-input"
                       placeholder="sk-proj-..."
                       aria-describedby="openaiKeyHelp">
                <button class="btn btn-outline-secondary" type="button" id="toggleOpenaiKey" aria-label="Toggle password visibility">
