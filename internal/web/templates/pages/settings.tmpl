            </p>

            <!-- Marketplace Alerts Container -->
            <div id="marketplaceAlerts"></div>

            <!-- Marketplaces List -->
            <div id="marketplacesList" class="mb-3">
              <div class="text-center py-4" style="color: var(--text-secondary);">
                <div class="spinner-border spinner-border-sm me-2" role="status" aria-label="Loading"></div>
                Loading marketplaces...
              </div>
            </div>

            <!-- Add Marketplace Button -->
            <div class="d-grid">
              <button id="addMarketplaceBtn" class="modern-btn modern-btn-primary" style="justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                  <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                </svg>
                Add Marketplace
              </button>
            </div>
          </section>

          <!-- Location Zones Section -->
          <section id="location-zones" class="settings-section modern-card p-4">
            <div class="settings-section-header">
              <span class="settings-section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
              </span>
              <h2 class="settings-section-title">Location Zones</h2>
              <span class="settings-section-subtitle">(Location-Based Automation)</span>
            </div>

            <p class="settings-section-description">
              Configure location zones based on WiFi networks. Zones enable location-aware workflows and automation.
            </p>

            <!-- Alerts Container -->
            <div id="locationSettingsAlerts"></div>

            <!-- Zones List -->
            <div id="locationZonesList" class="mb-3">
              <div class="text-center py-4" style="color: var(--text-secondary);">
                <div class="spinner-border spinner-border-sm me-2" role="status" aria-label="Loading"></div>
                Loading location zones...
              </div>
            </div>

            <!-- Add Zone Button -->
            <div class="d-grid">
              <button id="addLocationZoneBtn" class="modern-btn modern-btn-primary" style="justify-content: center;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                  <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                </svg>
                Add Zone
              </button>
            </div>
          </section>

          <!-- ==================== DATA & STORAGE SECTION ==================== -->

          <!-- Session Management Section -->
          <section id="session-management" class="settings-section modern-card p-4">
            <div class="settings-section-header">
              <span class="settings-section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,8A2,2 0 0,1 14,10A2,2 0 0,1 12,12A2,2 0 0,1 10,10A2,2 0 0,1 12,8M12,14C14.67,14 20,15.34 20,18V20H4V18C4,15.34 9.33,14 12,14M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                </svg>
              </span>
              <h2 class="settings-section-title">Session Management</h2>
            </div>

            <div class="settings-field">
              <div class="form-check form-switch mb-3">
                <input class="form-check-input" type="checkbox" id="sessionCleanupEnabled" checked style="width: 2.5rem; height: 1.25rem;">
                <label class="form-check-label settings-label" for="sessionCleanupEnabled" style="margin-bottom: 0;">
                  Enable automatic session cleanup
                </label>
              </div>
              <span class="settings-help">Automatically delete inactive chat sessions to save storage space.</span>
            </div>

            <div class="settings-grid">
              <div class="settings-field">
                <label class="settings-label" for="sessionCleanupDays">Cleanup after inactive days</label>
                <div class="input-group" style="max-width: 200px;">
                  <input type="number"
                         id="sessionCleanupDays"
                         class="form-control settings-input"
                         value="30"
                         min="1"
                         max="365"
                         aria-describedby="cleanupDaysHelp">
                  <span class="input-group-text">days</span>
                </div>
                <span id="cleanupDaysHelp" class="settings-help">Sessions inactive for this many days will be deleted.</span>
              </div>

              <div class="settings-field">
                <label class="settings-label" for="sessionMaxCount">Maximum sessions to keep</label>
                <div class="input-group" style="max-width: 200px;">
                  <input type="number"
                         id="sessionMaxCount"
                         class="form-control settings-input"
                         value="1000"
                         min="10"
                         max="10000"
                         aria-describedby="maxCountHelp">
                  <span class="input-group-text">sessions</span>
                </div>
                <span id="maxCountHelp" class="settings-help">When exceeded, oldest sessions are automatically deleted.</span>
              </div>
            </div>

            <!-- Storage Stats -->
            <div class="settings-info-box mt-4">
              <div class="settings-info-row">
                <span class="settings-info-label">Total Sessions</span>
                <span id="sessionTotalCount" class="settings-info-value">-</span>
              </div>
              <div class="settings-info-row">
                <span class="settings-info-label">Inactive (30+ days)</span>
                <span id="sessionInactiveCount" class="settings-info-value">-</span>
              </div>
              <div class="settings-info-row">
                <span class="settings-info-label">Database Size</span>
                <span id="sessionDbSize" class="settings-info-value">-</span>
              </div>
            </div>

            <div class="settings-actions">
              <button id="saveSessionSettingsBtn" class="modern-btn modern-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                  <path d="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
                </svg>
                Save Settings
              </button>
              <button id="runSessionCleanupBtn" class="modern-btn modern-btn-secondary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                  <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                </svg>
                Run Cleanup Now
              </button>
            </div>
          </section>

          <!-- Device Capabilities Section -->
          <section id="device-capabilities" class="settings-section modern-card p-4">
            <div class="settings-section-header">
              <span class="settings-section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17,17H7V7H17M21,11V9H19V7C19,5.89 18.1,5 17,5H15V3H13V5H11V3H9V5H7C5.89,5 5,5.89 5,7V9H3V11H5V13H3V15H5V17A2,2 0 0,0 7,19H9V21H11V19H13V21H15V19H17A2,2 0 0,0 19,17V15H21V13H19V11M13,13H11V11H13M15,9H9V15H15V9Z"/>
                </svg>
              </span>
              <h2 class="settings-section-title">Device Capabilities</h2>
              <span class="settings-section-subtitle">(For Local AI Models)</span>
            </div>

            <div id="deviceCapabilitiesContent">
              <div class="text-center py-4" style="color: var(--text-secondary);">
                <div class="spinner-border spinner-border-sm me-2" role="status" aria-label="Loading"></div>
                Detecting hardware...
              </div>
            </div>

            <!-- Device Capabilities Display (hidden by default) -->
            <div id="deviceCapabilitiesDisplay" class="d-none">
              <!-- Machine Info Section (shown only when available) -->
              <div id="deviceMachineInfoSection" class="settings-card-highlight d-none mb-4">
                <div class="d-flex align-items-center gap-3">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" style="color: var(--primary-color);">
                    <path d="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z"/>
                  </svg>
                  <div class="flex-grow-1">
                    <div id="deviceMachineName" style="color: var(--text-primary); font-weight: 600; font-size: 1.25rem;">-</div>
                    <div id="deviceChipType" style="color: var(--primary-color); font-size: 0.95rem; font-weight: 500;">-</div>
                  </div>
                </div>
              </div>

              <!-- Hardware Info Row -->
              <div class="settings-grid mb-4">
                <!-- GPU Card -->
                <div class="settings-info-box">
                  <div class="d-flex align-items-center mb-2">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--primary-color);">
                      <path d="M4,6H2V20A2,2 0 0,0 4,22H18V20H4V6M20,2H8A2,2 0 0,0 6,4V16A2,2 0 0,0 8,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M20,16H8V4H20V16Z"/>
                    </svg>
                    <span style="color: var(--text-secondary); font-size: 0.85rem;">GPU</span>
                  </div>
                  <div id="deviceGPUName" style="color: var(--text-primary); font-weight: 500; font-size: 1.1rem;">-</div>
                  <div id="deviceGPUVendor" style="color: var(--text-secondary); font-size: 0.85rem;">-</div>
                </div>

                <!-- RAM Card -->
                <div class="settings-info-box">
                  <div class="d-flex align-items-center mb-2">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--primary-color);">
                      <path d="M2,7V17H22V7H2M20,15H4V9H20V15M10,10H8V14H10V10M13,10H11V14H13V10M16,10H14V14H16V10M7,10H5V14H7V10M19,10H17V14H19V10Z"/>
                    </svg>
                    <span style="color: var(--text-secondary); font-size: 0.85rem;">System Memory</span>
                  </div>
                  <div id="deviceRAM" style="color: var(--text-primary); font-weight: 500; font-size: 1.1rem;">-</div>
                  <div id="deviceRAMDetails" style="color: var(--text-secondary); font-size: 0.85rem;">-</div>
                </div>
              </div>

              <!-- Model Capacity Section -->
              <div class="settings-info-box mb-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                  <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                      <span id="deviceMaxParams" class="badge" style="background: var(--primary-color); font-size: 1rem; padding: 0.5rem 1rem;">-</span>
                      <span id="deviceTierBadge" class="badge" style="background: var(--bg-tertiary); color: var(--text-primary); font-size: 0.85rem;">-</span>
                    </div>
                    <div style="color: var(--text-secondary); font-size: 0.9rem;">Maximum recommended model size</div>
                  </div>
                </div>
                <div id="deviceTierDescription" style="color: var(--text-secondary); font-size: 0.85rem;">-</div>
              </div>

              <!-- Recommended Models -->
              <div class="settings-field">
                <label class="settings-label" style="font-size: 0.85rem;">Recommended Ollama Models</label>
                <div id="deviceRecommendedModels" class="d-flex flex-wrap gap-2"></div>
              </div>

              <!-- Ollama Link -->
              <div class="settings-card-highlight mb-4">
                <div class="d-flex align-items-center">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="me-3" style="color: var(--primary-color);">
                    <path d="M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83C6.22,11.88 6.22,7.12 9.17,4.17C12.12,1.22 16.88,1.22 19.83,4.17C22.78,7.12 22.78,11.88 19.83,14.83C19.44,15.22 18.8,15.22 18.41,14.83C18,14.44 18,13.8 18.41,13.41C20.58,11.24 20.58,7.76 18.41,5.59C16.24,3.42 12.76,3.42 10.59,5.59C8.42,7.76 8.42,11.24 10.59,13.41M13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17C17.78,12.12 17.78,16.88 14.83,19.83C11.88,22.78 7.12,22.78 4.17,19.83C1.22,16.88 1.22,12.12 4.17,9.17C4.56,8.78 5.2,8.78 5.59,9.17C6,9.56 6,10.2 5.59,10.59C3.42,12.76 3.42,16.24 5.59,18.41C7.76,20.58 11.24,20.58 13.41,18.41C15.58,16.24 15.58,12.76 13.41,10.59C13,10.2 13,9.56 13.41,9.17Z"/>
                  </svg>
                  <div>
                    <div style="color: var(--text-primary); font-weight: 500;">Browse All Models</div>
                    <a id="deviceOllamaLink" href="https://ollama.com/library" target="_blank" rel="noopener noreferrer" style="color: var(--primary-color); font-size: 0.9rem;">
                      ollama.com/library
                    </a>
                  </div>
                </div>
              </div>

              <!-- Actions -->
              <div class="settings-actions">
                <button id="redetectHardwareBtn" class="modern-btn modern-btn-secondary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                    <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                  </svg>
                  Re-detect Hardware
                </button>
              </div>
            </div>
          </section>

          <!-- ==================== SYSTEM SECTION ==================== -->

          <!-- System Information -->
          <section id="system-info" class="settings-section modern-card p-4">
            <div class="settings-section-header">
              <span class="settings-section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M15,18V16H6V18H15M18,14V12H6V14H18Z"/>
                </svg>
              </span>
              <h2 class="settings-section-title">System Information</h2>
            </div>

            <div class="settings-grid">
              <div class="settings-info-box">
                <div class="settings-info-row">
                  <span class="settings-info-label">Version</span>
                  <span class="badge" style="background: var(--primary-color);">{{.Version}}</span>
                </div>
              </div>

              <div class="settings-info-box">
                <div class="settings-info-row">
                  <span class="settings-info-label">Status</span>
                  <span class="badge badge-success">Online</span>
                </div>
              </div>

              <div class="settings-info-box">
                <div class="settings-info-row">
                  <span class="settings-info-label">Current Agent</span>
                  <span class="settings-info-value">{{.CurrentAgent}}</span>
                </div>
              </div>

              {{if .Extra}}
              <div class="settings-info-box">
                <div class="settings-info-row">
                  <span class="settings-info-label" title="Current platform for plugin compatibility">Platform</span>
                  <span class="settings-info-value">{{index .Extra "CurrentPlatformDisplay"}}</span>
                </div>
              </div>

              <div class="settings-info-box">
                <div class="settings-info-row">
                  <span class="settings-info-label" title="Platform string used for compatibility checks">Platform ID</span>
                  <code style="color: var(--text-primary); font-size: 0.85rem;">{{index .Extra "CurrentPlatform"}}</code>
                </div>
              </div>
              {{end}}
            </div>
          </section>

          <!-- Diagnostics Section -->
          <section id="diagnostics" class="settings-section modern-card p-4">
            <div class="settings-section-header">
              <span class="settings-section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11L19.5,12L19.43,13L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10Z"/>
                </svg>
              </span>
              <h2 class="settings-section-title">Diagnostics</h2>
            </div>

            <div class="d-grid">
              <button id="systemDiagnosticsBtn" class="modern-btn modern-btn-secondary" style="justify-content: flex-start;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                  <path d="M11,9H13V7H11M12,20C7.59,20 4,16.41 4,12C4,7.59 7.59,4 12,4C16.41,4 20,7.59 20,12C20,16.41 16.41,20 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M11,17H13V11H11V17Z"/>
                </svg>
                Run System Diagnostics
              </button>
            </div>
          </section>

          <!-- Reset Application Section -->
          <section id="reset-application" class="settings-section danger-zone modern-card p-4">
            <div class="settings-section-header">
              <span class="settings-section-icon" style="color: var(--danger-color);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,4C14.1,4 16.1,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 10.9,19.9L11.4,17.9C13.1,18.1 14.9,17.5 16.2,16.2C18.5,13.9 18.5,10.1 16.2,7.7C15.1,6.6 13.5,6 12,6V10.6L7,5.6L12,0.6V4M6.3,17.6C3.7,15 3.3,11 5.1,7.9L6.6,9.4C5.5,11.6 5.9,14.4 7.8,16.2C8.3,16.7 8.9,17.1 9.6,17.4L9,19.4C8,19 7.1,18.4 6.3,17.6Z"/>
                </svg>
              </span>
              <h2 class="settings-section-title" style="color: var(--danger-color);">Reset Application</h2>
            </div>

            <p class="settings-section-description">
              Reset parts of the application to start fresh. Select what you want to reset below.
              <strong style="color: var(--danger-color);">This action cannot be undone.</strong>
            </p>

            <!-- Reset Options -->
            <div class="settings-field">
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="resetSettings">
                <label class="form-check-label" for="resetSettings" style="color: var(--text-primary);">
                  <strong>Settings & API Keys</strong>
                  <small class="d-block" style="color: var(--text-secondary);">Remove API keys and global configuration</small>
                </label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="resetAgents">
                <label class="form-check-label" for="resetAgents" style="color: var(--text-primary);">
                  <strong>Agents</strong>
                  <small class="d-block" style="color: var(--text-secondary);">Delete all agents and their configurations</small>
                </label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="resetSessions">
                <label class="form-check-label" for="resetSessions" style="color: var(--text-primary);">
                  <strong>Chat Sessions</strong>
                  <small class="d-block" style="color: var(--text-secondary);">Delete all chat history and sessions</small>
                </label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="resetPlugins">
                <label class="form-check-label" for="resetPlugins" style="color: var(--text-primary);">
                  <strong>Plugins</strong>
                  <small class="d-block" style="color: var(--text-secondary);">Remove all uploaded plugins and plugin registry</small>
                </label>
              </div>
              <div class="form-check mb-2">
                <input class="form-check-input" type="checkbox" id="resetOnboarding">
                <label class="form-check-label" for="resetOnboarding" style="color: var(--text-primary);">
                  <strong>Onboarding State</strong>
                  <small class="d-block" style="color: var(--text-secondary);">Reset app preferences and show onboarding again</small>
                </label>
              </div>
            </div>

            <!-- Quick Select -->
            <div class="mb-4 d-flex gap-2">
              <button id="selectAllResetBtn" class="btn btn-sm btn-outline-secondary">Select All</button>
              <button id="clearAllResetBtn" class="btn btn-sm btn-outline-secondary">Clear All</button>
            </div>

            <!-- Reset Button -->
            <div class="d-grid">
              <button id="resetAppBtn" class="btn btn-danger" disabled>
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                  <path d="M12,4C14.1,4 16.1,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 10.9,19.9L11.4,17.9C13.1,18.1 14.9,17.5 16.2,16.2C18.5,13.9 18.5,10.1 16.2,7.7C15.1,6.6 13.5,6 12,6V10.6L7,5.6L12,0.6V4M6.3,17.6C3.7,15 3.3,11 5.1,7.9L6.6,9.4C5.5,11.6 5.9,14.4 7.8,16.2C8.3,16.7 8.9,17.1 9.6,17.4L9,19.4C8,19 7.1,18.4 6.3,17.6Z"/>
                </svg>
                Reset Selected Items
              </button>
            </div>
          </section>

        </div><!-- /.settings-content -->
      </div><!-- /.settings-layout -->
    </div><!-- /.main-content -->
  </div><!-- /.main-content-wrapper -->

  <!-- Reset Confirmation Modal -->
  <div class="modal fade" id="resetConfirmModal" tabindex="-1" data-bs-backdrop="static" aria-labelledby="resetConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header" style="border-bottom-color: var(--danger-color);">
          <h5 class="modal-title" id="resetConfirmModalLabel" style="color: var(--danger-color);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
            </svg>
            Confirm Reset
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-danger mb-3">
            <strong>Warning:</strong> You are about to permanently delete the following:
          </div>
          <ul id="resetItemsList" class="mb-3" style="color: var(--text-primary);"></ul>
          <p style="color: var(--text-secondary);">
            To confirm, type <strong>RESET</strong> in the box below:
          </p>
          <input type="text"
                 id="resetConfirmInput"
                 class="form-control settings-input"
                 placeholder="Type RESET to confirm"
                 autocomplete="off"
                 aria-describedby="resetConfirmError">
          <div id="resetConfirmError" class="text-danger mt-2" style="display: none;">
            Please type RESET exactly to confirm
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="confirmResetBtn" class="btn btn-danger" disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M12,4C14.1,4 16.1,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 10.9,19.9L11.4,17.9C13.1,18.1 14.9,17.5 16.2,16.2C18.5,13.9 18.5,10.1 16.2,7.7C15.1,6.6 13.5,6 12,6V10.6L7,5.6L12,0.6V4M6.3,17.6C3.7,15 3.3,11 5.1,7.9L6.6,9.4C5.5,11.6 5.9,14.4 7.8,16.2C8.3,16.7 8.9,17.1 9.6,17.4L9,19.4C8,19 7.1,18.4 6.3,17.6Z"/>
            </svg>
            Reset Now
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Location Zone Modal -->
  <div class="modal fade" id="locationZoneModal" tabindex="-1" aria-labelledby="locationZoneModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="locationZoneModalLabel">Add Location Zone</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="locationZoneForm">
            <div class="settings-field">
              <label class="settings-label" for="zoneNameInput">Zone Name</label>
              <input type="text" class="form-control settings-input" id="zoneNameInput" required placeholder="e.g., Home, Office, Coffee Shop" aria-describedby="zoneNameHelp">
              <span id="zoneNameHelp" class="settings-help">A descriptive name for this location</span>
            </div>
            <div class="settings-field">
              <label class="settings-label" for="zoneDescriptionInput">Description</label>
              <input type="text" class="form-control settings-input" id="zoneDescriptionInput" placeholder="e.g., My home network" aria-describedby="zoneDescHelp">
              <span id="zoneDescHelp" class="settings-help">Optional description of this zone</span>
            </div>
            <div class="settings-field">
              <label class="settings-label" for="zoneSSIDInput">WiFi SSID</label>
              <div class="input-group">
                <input type="text" class="form-control settings-input" id="zoneSSIDInput" required placeholder="e.g., HomeNetwork or Network*" aria-describedby="ssidHelp">
                <button class="btn btn-outline-primary" type="button" id="detectWiFiBtn" title="Detect Current Network">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M12,21L15.6,16.2C14.6,15.45 13.35,15 12,15C10.65,15 9.4,15.45 8.4,16.2L12,21M12,3C7.95,3 4.21,4.34 1.2,6.6L3,9C5.5,7.12 8.62,6 12,6C15.38,6 18.5,7.12 21,9L22.8,6.6C19.79,4.34 16.05,3 12,3M12,9C9.3,9 6.81,9.89 4.8,11.4L6.6,13.8C8.1,12.67 9.97,12 12,12C14.03,12 15.9,12.67 17.4,13.8L19.2,11.4C17.19,9.89 14.7,9 12,9Z"/>
                  </svg>
                  <span class="d-none d-md-inline">Detect</span>
                </button>
              </div>
              <span id="ssidHelp" class="settings-help">WiFi network name. Use * as wildcard (e.g., "Home*" matches "HomeWiFi", "Home5G")</span>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="saveLocationZoneBtn" class="btn btn-primary">
            Save Zone
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Shared Modals -->
  {{template "modals.tmpl" .}}

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- DX Utilities -->
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/utils/dom-utils.js"></script>
  <script src="/js/app.js?v=1694538177"></script>
  <script src="/js/modules/agents.js"></script>
  <script src="/js/modules/plugins.js"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/modules/themeManager.js"></script>
  <script src="/js/modules/toast.js"></script>
  <script>
    // Initialize theme on page load
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>
  <script>
    // External Agents Settings
    (function() {
      const claudeToggle = document.getElementById('claudeAgentsToggle');
      const codexToggle = document.getElementById('codexAgentsToggle');
      const status = document.getElementById('externalAgentsStatus');

      function updateStatusVisibility() {
        const anyEnabled = claudeToggle.checked || codexToggle.checked;
        status.classList.toggle('d-none', !anyEnabled);
      }

      // Load current settings
      async function loadExternalAgentsSettings() {
        try {
          const response = await fetch('/api/settings/external-agents');
          if (response.ok) {
            const data = await response.json();
            claudeToggle.checked = data.claude_enabled;
            codexToggle.checked = data.codex_enabled;
            updateStatusVisibility();
          }
        } catch (error) {
          console.error('Failed to load external agents settings:', error);
        }
      }

      // Save Claude setting on toggle change
      claudeToggle.addEventListener('change', async function() {
        try {
          const response = await fetch('/api/settings/external-agents', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ claude_enabled: claudeToggle.checked })
          });
          if (response.ok) {
            updateStatusVisibility();
            if (window.Toast) {
              Toast.success('Claude Code integration ' + (claudeToggle.checked ? 'enabled' : 'disabled'));
            }
          } else {
            claudeToggle.checked = !claudeToggle.checked;
            if (window.Toast) {
              Toast.error('Failed to save setting');
            }
          }
        } catch (error) {
          console.error('Failed to save Claude setting:', error);
          claudeToggle.checked = !claudeToggle.checked;
        }
      });

      // Save Codex setting on toggle change
      codexToggle.addEventListener('change', async function() {
        try {
          const response = await fetch('/api/settings/external-agents', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ codex_enabled: codexToggle.checked })
          });
          if (response.ok) {
            updateStatusVisibility();
            if (window.Toast) {
              Toast.success('Codex CLI integration ' + (codexToggle.checked ? 'enabled' : 'disabled'));
            }
          } else {
            codexToggle.checked = !codexToggle.checked;
            if (window.Toast) {
              Toast.error('Failed to save setting');
            }
          }
        } catch (error) {
          console.error('Failed to save Codex setting:', error);
          codexToggle.checked = !codexToggle.checked;
        }
      });

      // Initialize on page load
      document.addEventListener('DOMContentLoaded', loadExternalAgentsSettings);
    })();
  </script>
  <script src="/js/modules/settings-controller.js"></script>
  <script src="/js/modules/settings-navigation.js"></script>
  <script src="/js/modules/settings-page.js"></script>
  <script src="/js/modules/location-settings.js"></script>
  <script src="/js/modules/marketplace-settings.js"></script>
  <script src="/js/modules/user-profile.js"></script>
  <script src="/js/modules/device-capabilities.js"></script>
  <script src="/js/modules/web3-settings.js"></script>
</body>
</html>
{{end}}
