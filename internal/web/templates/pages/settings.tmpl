{{define "settings"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content - Settings Layout -->
    <div class="main-content" style="padding: 0;">
      <div class="settings-layout">
        <!-- Settings Sidebar Navigation -->
        <nav class="settings-sidebar" aria-label="Settings navigation">
          <!-- Search -->
          <div class="settings-nav-search">
            <svg class="settings-nav-search-icon" width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
              <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
            </svg>
            <input type="text" id="settingsSearch" placeholder="Search settings..." aria-label="Search settings">
          </div>

          <!-- Account Category -->
          <div class="settings-nav-group" data-category="account">
            <h3 class="settings-nav-group-title">Account</h3>
            <a href="#api-keys" class="settings-nav-item" data-section="api-keys">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">API Keys</span>
            </a>
            <a href="#user-profile" class="settings-nav-item" data-section="user-profile">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">User Profile</span>
            </a>
            <a href="#web3-wallet" class="settings-nav-item" data-section="web3-wallet">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M21,18V19A2,2 0 0,1 19,21H5C3.89,21 3,20.1 3,19V5A2,2 0 0,1 5,3H19A2,2 0 0,1 21,5V6H12C10.89,6 10,6.9 10,8V16A2,2 0 0,0 12,18M12,16H22V8H12M16,13.5A1.5,1.5 0 0,1 14.5,12A1.5,1.5 0 0,1 16,10.5A1.5,1.5 0 0,1 17.5,12A1.5,1.5 0 0,1 16,13.5Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">Web3 Wallet</span>
            </a>
          </div>

          <!-- AI Configuration Category -->
          <div class="settings-nav-group" data-category="ai-config">
            <h3 class="settings-nav-group-title">AI Configuration</h3>
            <a href="#system-model" class="settings-nav-item" data-section="system-model">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">System Model</span>
            </a>
            <a href="#voice-language" class="settings-nav-item" data-section="voice-language">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14M17,11A1,1 0 0,0 15,11A3,3 0 0,1 9,11A1,1 0 0,0 7,11A5,5 0 0,0 11,15.9V19H9A1,1 0 0,0 9,21H15A1,1 0 0,0 15,19H13V15.9A5,5 0 0,0 17,11Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">Voice & Language</span>
            </a>
          </div>

          <!-- Integrations Category -->
          <div class="settings-nav-group" data-category="integrations">
            <h3 class="settings-nav-group-title">Integrations</h3>
            <a href="#external-agents" class="settings-nav-item" data-section="external-agents">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">External Agents</span>
            </a>
            <a href="#mcp-servers" class="settings-nav-item" data-section="mcp-servers">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M15,18V16H6V18H15M18,14V12H6V14H18Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">MCP Servers</span>
            </a>
            <a href="#plugin-marketplaces" class="settings-nav-item" data-section="plugin-marketplaces">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M4,6H2V20A2,2 0 0,0 4,22H18V20H4V6M20,2H8A2,2 0 0,0 6,4V16A2,2 0 0,0 8,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M20,16H8V4H20V16M13,11H15V13H13V11M13,5H15V9H13V5Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">Plugin Marketplaces</span>
            </a>
            <a href="#location-zones" class="settings-nav-item" data-section="location-zones">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">Location Zones</span>
            </a>
          </div>

          <!-- Data & Storage Category -->
          <div class="settings-nav-group" data-category="data-storage">
            <h3 class="settings-nav-group-title">Data & Storage</h3>
            <a href="#session-management" class="settings-nav-item" data-section="session-management">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,8A2,2 0 0,1 14,10A2,2 0 0,1 12,12A2,2 0 0,1 10,10A2,2 0 0,1 12,8M12,14C14.67,14 20,15.34 20,18V20H4V18C4,15.34 9.33,14 12,14M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">Session Management</span>
            </a>
            <a href="#device-capabilities" class="settings-nav-item" data-section="device-capabilities">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17,17H7V7H17M21,11V9H19V7C19,5.89 18.1,5 17,5H15V3H13V5H11V3H9V5H7C5.89,5 5,5.89 5,7V9H3V11H5V13H3V15H5V17A2,2 0 0,0 7,19H9V21H11V19H13V21H15V19H17A2,2 0 0,0 19,17V15H21V13H19V11M13,13H11V11H13M15,9H9V15H15V9Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">Device Capabilities</span>
            </a>
          </div>

          <!-- System Category -->
          <div class="settings-nav-group" data-category="system">
            <h3 class="settings-nav-group-title">System</h3>
            <a href="#system-info" class="settings-nav-item" data-section="system-info">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M15,18V16H6V18H15M18,14V12H6V14H18Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">System Information</span>
            </a>
            <a href="#diagnostics" class="settings-nav-item" data-section="diagnostics">
              <span class="settings-nav-item-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8M12,10A2,2 0 0,0 10,12A2,2 0 0,0 12,14A2,2 0 0,0 14,12A2,2 0 0,0 12,10M10,22C9.75,22 9.54,21.82 9.5,21.58L9.13,18.93C8.5,18.68 7.96,18.34 7.44,17.94L4.95,18.95C4.73,19.03 4.46,18.95 4.34,18.73L2.34,15.27C2.21,15.05 2.27,14.78 2.46,14.63L4.57,12.97L4.5,12L4.57,11L2.46,9.37C2.27,9.22 2.21,8.95 2.34,8.73L4.34,5.27C4.46,5.05 4.73,4.96 4.95,5.05L7.44,6.05C7.96,5.66 8.5,5.32 9.13,5.07L9.5,2.42C9.54,2.18 9.75,2 10,2H14C14.25,2 14.46,2.18 14.5,2.42L14.87,5.07C15.5,5.32 16.04,5.66 16.56,6.05L19.05,5.05C19.27,4.96 19.54,5.05 19.66,5.27L21.66,8.73C21.79,8.95 21.73,9.22 21.54,9.37L19.43,11L19.5,12L19.43,13L21.54,14.63C21.73,14.78 21.79,15.05 21.66,15.27L19.66,18.73C19.54,18.95 19.27,19.04 19.05,18.95L16.56,17.95C16.04,18.34 15.5,18.68 14.87,18.93L14.5,21.58C14.46,21.82 14.25,22 14,22H10Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text">Diagnostics</span>
            </a>
            <a href="#reset-application" class="settings-nav-item" data-section="reset-application">
              <span class="settings-nav-item-icon" style="color: var(--danger-color);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,4C14.1,4 16.1,4.8 17.6,6.3C20.7,9.4 20.7,14.5 17.6,17.6C15.8,19.5 13.3,20.2 10.9,19.9L11.4,17.9C13.1,18.1 14.9,17.5 16.2,16.2C18.5,13.9 18.5,10.1 16.2,7.7C15.1,6.6 13.5,6 12,6V10.6L7,5.6L12,0.6V4M6.3,17.6C3.7,15 3.3,11 5.1,7.9L6.6,9.4C5.5,11.6 5.9,14.4 7.8,16.2C8.3,16.7 8.9,17.1 9.6,17.4L9,19.4C8,19 7.1,18.4 6.3,17.6Z"/>
                </svg>
              </span>
              <span class="settings-nav-item-text" style="color: var(--danger-color);">Reset Application</span>
            </a>
          </div>

          <!-- No results message -->
          <div class="settings-nav-no-results" id="settingsNoResults">
            No settings found matching your search.
          </div>
        </nav>

        <!-- Settings Content -->
        <div class="settings-content">

          <!-- ==================== ACCOUNT SECTION ==================== -->

          <!-- API Keys Section -->
          <section id="api-keys" class="settings-section modern-card p-4">
            <div class="settings-section-header">
              <span class="settings-section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M7,14A2,2 0 0,1 5,12A2,2 0 0,1 7,10A2,2 0 0,1 9,12A2,2 0 0,1 7,14M12.65,10C11.83,7.67 9.61,6 7,6A6,6 0 0,0 1,12A6,6 0 0,0 7,18C9.61,18 11.83,16.33 12.65,14H17V18H21V14H23V10H12.65Z"/>
                </svg>
              </span>
              <h2 class="settings-section-title">API Keys</h2>
            </div>

            <!-- OpenAI API Key -->
            <div class="settings-field">
              <label class="settings-label" for="openaiApiKeyInput">OpenAI API Key</label>
              <div class="input-group">
                <input type="password"
                       id="openaiApiKeyInput"
                       class="form-control settings-input"
                       placeholder="sk-proj-..."
                       aria-describedby="openaiKeyHelp">
                <button class="btn btn-outline-secondary" type="button" id="toggleOpenaiKey" aria-label="Toggle password visibility">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/>
                  </svg>
                </button>
                <button class="btn btn-primary modern-btn-primary" type="button" id="saveOpenaiKey">Save</button>
              </div>
              <span id="openaiKeyHelp" class="settings-help">Used for GPT models. Your API key starts with "sk-proj-" or "sk-".</span>
            </div>

            <!-- Anthropic API Key -->
            <div class="settings-field">
              <label class="settings-label" for="anthropicApiKeyInput">Anthropic API Key</label>
              <div class="input-group">
                <input type="password"
                       id="anthropicApiKeyInput"
                       class="form-control settings-input"
                       placeholder="sk-ant-..."
                       aria-describedby="anthropicKeyHelp">
                <button class="btn btn-outline-secondary" type="button" id="toggleAnthropicKey" aria-label="Toggle password visibility">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/>
                  </svg>
                </button>
                <button class="btn btn-primary modern-btn-primary" type="button" id="saveAnthropicKey">Save</button>
              </div>
              <span id="anthropicKeyHelp" class="settings-help">Used for Claude models. Your API key starts with "sk-ant-".</span>
            </div>

            <!-- Gemini API Key -->
            <div class="settings-field">
              <label class="settings-label" for="geminiApiKeyInput">Gemini API Key</label>
              <div class="input-group">
                <input type="password"
                       id="geminiApiKeyInput"
                       class="form-control settings-input"
                       placeholder="Google AI Studio API key"
                       aria-describedby="geminiKeyHelp">
                <button class="btn btn-outline-secondary" type="button" id="toggleGeminiKey" aria-label="Toggle password visibility">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/>
                  </svg>
                </button>
                <button class="btn btn-primary modern-btn-primary" type="button" id="saveGeminiKey">Save</button>
              </div>
              <span id="geminiKeyHelp" class="settings-help">Used for Gemini models. Generate a key in Google AI Studio.</span>
            </div>
          </section>

          <!-- User Profile Section -->
          <section id="user-profile" class="settings-section modern-card p-4">
            <div class="settings-section-header">
              <span class="settings-section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                </svg>
              </span>
              <h2 class="settings-section-title">Your Profile</h2>
            </div>

            <div id="userProfileContent">
              <div class="text-center py-4" style="color: var(--text-secondary);">
                <div class="spinner-border spinner-border-sm me-2" role="status" aria-label="Loading"></div>
                Loading profile...
              </div>
            </div>

            <!-- Profile Not Set State (hidden by default) -->
            <div id="userProfileEmpty" class="d-none">
              <div class="empty-state">
                <svg class="empty-state-icon" width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                </svg>
                <h3 class="empty-state-title">No profile set yet</h3>
                <p class="empty-state-description">Complete the onboarding to set up your profile, or click below to detect your profile now.</p>
                <button id="detectProfileBtn" class="modern-btn modern-btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                    <path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
                  </svg>
                  Detect My Profile
                </button>
              </div>
            </div>

            <!-- Profile Display (hidden by default) -->
            <div id="userProfileDisplay" class="d-none">
              <!-- Category Badge -->
              <div class="mb-4">
                <div class="d-flex align-items-center gap-3">
                  <div id="profileCategoryBadge" class="px-3 py-2" style="background: var(--primary-color); color: white; border-radius: var(--radius-md); font-weight: 600;">
                    Developer
                  </div>
                  <div id="profileConfidenceBadge" class="px-2 py-1" style="background: var(--bg-secondary); border-radius: var(--radius-sm); font-size: 0.85rem;">
                    <span style="color: var(--text-secondary);">Confidence:</span>
                    <span id="profileConfidenceValue" style="color: var(--text-primary); font-weight: 500;">85%</span>
                  </div>
                </div>
              </div>

              <!-- Summary -->
              <div class="settings-field">
                <label class="settings-label" style="font-size: 0.85rem;">Summary</label>
                <p id="profileSummaryText" style="color: var(--text-primary); margin-bottom: 0;"></p>
              </div>

              <!-- Specializations -->
              <div class="settings-field" id="profileSpecializationsSection">
                <label class="settings-label" style="font-size: 0.85rem;">Specializations</label>
                <div id="profileSpecializationsList" class="d-flex flex-wrap gap-2"></div>
              </div>

              <!-- Detected Apps -->
              <div class="settings-field" id="profileAppsSection">
                <label class="settings-label" style="font-size: 0.85rem;">Based on detected apps</label>
                <div id="profileAppsList" class="d-flex flex-wrap gap-1"></div>
              </div>

              <!-- Inferred Date -->
              <div class="settings-field">
                <small id="profileInferredAt" style="color: var(--text-secondary);"></small>
              </div>

              <!-- Actions -->
              <div class="settings-actions">
                <button id="refreshProfileBtn" class="modern-btn modern-btn-secondary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
