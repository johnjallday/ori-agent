{{define "agents-create"}}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light" data-sidebar-default="visible">
  <style>
    body {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      overflow-x: hidden;
      background:
        radial-gradient(circle at 15% -10%, rgba(29, 78, 216, 0.15), transparent 42%),
        radial-gradient(circle at 100% 20%, rgba(56, 189, 248, 0.12), transparent 36%),
        var(--bg-primary);
    }

    .skip-link {
      position: absolute;
      left: 20px;
      top: 18px;
      z-index: 1100;
      padding: 10px 14px;
      border-radius: 999px;
      background: var(--bg-primary);
      color: var(--text-primary);
      border: 1px solid color-mix(in srgb, var(--border-color) 76%, var(--primary-color) 24%);
      box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
      text-decoration: none;
      transform: translateY(-180%);
      transition: transform 0.2s ease;
    }

    .skip-link:focus-visible {
      transform: translateY(0);
    }

    .create-container {
      max-width: 980px;
      margin: 0 auto;
      padding: 24px 20px 36px;
    }

    .page-header {
      margin-bottom: 18px;
      padding: 22px 24px;
      border-radius: var(--radius-lg);
      background: linear-gradient(145deg, color-mix(in srgb, var(--bg-primary) 86%, var(--primary-color) 14%), var(--bg-primary));
      border: 1px solid color-mix(in srgb, var(--border-color) 78%, var(--primary-color) 22%);
      box-shadow: 0 14px 30px rgba(0, 0, 0, 0.12);
      position: relative;
      overflow: hidden;
    }

    .page-header::after {
      content: "";
      position: absolute;
      width: 220px;
      height: 220px;
      border-radius: 50%;
      right: -80px;
      top: -120px;
      background: radial-gradient(circle, color-mix(in srgb, var(--primary-color) 34%, transparent) 0%, transparent 72%);
      pointer-events: none;
    }

    .page-header h1 {
      font-size: clamp(26px, 4vw, 32px);
      margin-bottom: 6px;
      color: var(--text-primary);
      text-wrap: balance;
      position: relative;
      z-index: 1;
    }

    .page-header p {
      color: var(--text-secondary);
      font-size: 14px;
      margin: 0;
      position: relative;
      z-index: 1;
    }

    .form-card {
      border: 1px solid color-mix(in srgb, var(--border-color) 86%, var(--primary-color) 14%);
      border-radius: 16px;
      padding: 22px 24px;
      margin-bottom: 16px;
      box-shadow: 0 8px 26px rgba(0, 0, 0, 0.08);
    }

    .form-card.modern-card:hover {
      transform: none;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.1);
    }

    .form-section-title {
      font-size: 18px;
      font-weight: 650;
      margin-bottom: 16px;
      padding-bottom: 11px;
      border-bottom: 1px solid color-mix(in srgb, var(--border-color) 84%, var(--primary-color) 16%);
      color: var(--text-primary);
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-label {
      display: block;
      font-weight: 520;
      margin-bottom: 7px;
      color: var(--text-primary);
      letter-spacing: 0.1px;
    }

    .form-label.required::after {
      content: " *";
      color: var(--danger-color);
    }

    .form-input,
    .form-select,
    .form-textarea {
      width: 100%;
      padding: 10px 13px;
      border: 1px solid color-mix(in srgb, var(--border-color) 86%, var(--primary-color) 14%);
      border-radius: 10px;
      font-size: 14px;
      font-family: inherit;
      background: var(--bg-secondary);
      color: var(--text-primary);
      transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }

    .form-input:focus-visible,
    .form-select:focus-visible,
    .form-textarea:focus-visible {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 20%, transparent);
      background: var(--bg-primary);
    }

    .form-textarea {
      resize: vertical;
      min-height: 110px;
      line-height: 1.45;
    }

    input[type="range"].form-input {
      padding: 0;
      height: 6px;
      border: none;
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg-tertiary) 75%, var(--primary-color) 25%);
      appearance: none;
      -webkit-appearance: none;
    }

    input[type="range"].form-input::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--primary-color);
      border: 2px solid var(--bg-primary);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      cursor: pointer;
    }

    input[type="range"].form-input::-moz-range-thumb {
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--primary-color);
      border: 2px solid var(--bg-primary);
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
      cursor: pointer;
    }

    .form-help {
      font-size: 12px;
      color: var(--text-secondary);
      margin-top: 5px;
      line-height: 1.4;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .color-picker-group {
      display: flex;
      gap: 12px;
      align-items: center;
      flex-wrap: wrap;
    }

    .color-preview {
      width: 40px;
      height: 40px;
      border-radius: 10px;
      border: 2px solid color-mix(in srgb, var(--border-color) 78%, var(--primary-color) 22%);
      box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.22);
    }

    .color-input {
      width: 130px;
    }

    .tags-input-container {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      padding: 8px;
      border: 1px solid color-mix(in srgb, var(--border-color) 86%, var(--primary-color) 14%);
      border-radius: 10px;
      min-height: 46px;
      cursor: text;
      background: var(--bg-secondary);
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .tags-input-container:focus-within {
      border-color: var(--primary-color);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 20%, transparent);
      background: var(--bg-primary);
    }

    .tag-item {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 4px 10px;
      background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
      color: white;
      border-radius: 999px;
      font-size: 12px;
      box-shadow: 0 3px 10px rgba(0, 0, 0, 0.14);
    }

    .tag-remove {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      border: none;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.16);
      color: inherit;
      cursor: pointer;
      font-weight: 700;
      opacity: 0.9;
      line-height: 1;
      padding: 0;
      transition: background 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
    }

    .tag-remove:hover {
      opacity: 1;
      background: rgba(255, 255, 255, 0.24);
      transform: scale(1.05);
    }

    .tag-input {
      border: none;
      padding: 4px;
      flex: 1;
      min-width: 120px;
      font-size: 14px;
      background: transparent;
      color: var(--text-primary);
    }

    .tag-input:focus-visible {
      outline: none;
    }

    .plugin-list {
      max-height: 320px;
      overflow-y: auto;
      border: 1px solid color-mix(in srgb, var(--border-color) 86%, var(--primary-color) 14%);
      border-radius: 10px;
      padding: 8px;
      background: var(--bg-secondary);
    }

    .plugin-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 10px;
      border-radius: 8px;
      margin-bottom: 5px;
      transition: background 0.2s ease, border-color 0.2s ease;
      border: 1px solid transparent;
    }

    .plugin-item:hover {
      background: color-mix(in srgb, var(--bg-tertiary) 80%, var(--primary-color) 20%);
      border-color: color-mix(in srgb, var(--border-color) 72%, var(--primary-color) 28%);
    }

    .plugin-checkbox {
      width: 18px;
      height: 18px;
      cursor: pointer;
      accent-color: var(--primary-color);
    }

    .plugin-info {
      flex: 1;
    }

    .plugin-name {
      font-weight: 600;
      margin-bottom: 2px;
      color: var(--text-primary);
    }

    .plugin-description {
      font-size: 12px;
      color: var(--text-secondary);
    }

    .mcp-meta {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 5px;
      flex-wrap: wrap;
    }

    .mcp-status-badge {
      display: inline-flex;
      align-items: center;
      padding: 2px 8px;
      border-radius: 999px;
      font-size: 11px;
      font-weight: 600;
      border: 1px solid transparent;
      text-transform: uppercase;
      letter-spacing: 0.2px;
    }

    .mcp-status-badge.ready {
      color: var(--success-color);
      background: color-mix(in srgb, var(--success-color) 16%, transparent);
      border-color: color-mix(in srgb, var(--success-color) 30%, transparent);
    }

    .mcp-status-badge.warming {
      color: var(--warning-color);
      background: color-mix(in srgb, var(--warning-color) 16%, transparent);
      border-color: color-mix(in srgb, var(--warning-color) 30%, transparent);
    }

    .mcp-status-badge.stopped {
      color: var(--danger-color);
      background: color-mix(in srgb, var(--danger-color) 16%, transparent);
      border-color: color-mix(in srgb, var(--danger-color) 30%, transparent);
    }

    .mcp-command {
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
      font-size: 11px;
      color: var(--text-secondary);
      background: color-mix(in srgb, var(--bg-tertiary) 85%, var(--primary-color) 15%);
      border: 1px solid color-mix(in srgb, var(--border-color) 82%, var(--primary-color) 18%);
      border-radius: 6px;
      padding: 3px 6px;
    }

    .form-actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      align-items: center;
    }

    .modern-btn:disabled,
    .btn:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none !important;
    }

    #createGenerateAutoConfigBtn {
      margin-top: 2px;
    }

    .modern-btn,
    .btn-group .btn,
    .tag-remove {
      touch-action: manipulation;
    }

    .btn-group .btn {
      border-radius: 10px;
      border: 1px solid color-mix(in srgb, var(--border-color) 78%, var(--primary-color) 22%);
      color: var(--text-primary);
      background: var(--bg-secondary);
      font-size: 13px;
      font-weight: 550;
      padding: 7px 13px;
    }

    .btn-check:checked + .btn {
      background: color-mix(in srgb, var(--primary-color) 20%, var(--bg-secondary));
      border-color: var(--primary-color);
      color: var(--text-primary);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--primary-color) 18%, transparent);
    }

    .modern-btn:focus-visible,
    .btn-check:focus-visible + .btn,
    .plugin-checkbox:focus-visible,
    .form-check-input:focus-visible,
    .tag-remove:focus-visible {
      outline: none;
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 24%, transparent);
    }

    .error-message {
      padding: 12px 14px;
      background: rgba(239, 68, 68, 0.12);
      color: #dc2626;
      border: 1px solid rgba(239, 68, 68, 0.25);
      border-radius: 10px;
      margin-bottom: 16px;
      display: block;
      font-size: 13px;
    }

    .error-message[hidden] {
      display: none !important;
    }

    .field-error {
      margin-top: 6px;
      color: var(--danger-color);
      font-size: 12px;
      line-height: 1.4;
      display: none;
    }

    .field-error.is-visible {
      display: block;
    }

    .form-input.is-invalid,
    .form-select.is-invalid,
    .form-textarea.is-invalid {
      border-color: var(--danger-color);
      box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger-color) 16%, transparent);
      background: color-mix(in srgb, var(--bg-secondary) 92%, var(--danger-color) 8%);
    }

    [data-bs-theme="dark"] .error-message {
      background: rgba(239, 68, 68, 0.17);
      color: #fca5a5;
      border-color: rgba(239, 68, 68, 0.35);
    }

    .loading-overlay {
      position: fixed;
      inset: 0;
      background: rgba(2, 6, 23, 0.5);
      backdrop-filter: blur(6px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1000;
    }

    .loading-spinner {
      background: var(--bg-primary);
      padding: 24px 30px;
      border-radius: 14px;
      text-align: center;
      border: 1px solid var(--border-color);
      color: var(--text-primary);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.25);
    }

    @media (max-width: 900px) {
      .create-container {
        padding: 18px 14px 28px;
      }
    }

    @media (max-width: 768px) {
      .form-row {
        grid-template-columns: 1fr;
      }

      .form-card {
        padding: 18px 16px;
      }

      .form-actions {
        justify-content: stretch;
        flex-wrap: wrap;
      }

      .form-actions .modern-btn {
        flex: 1 1 100%;
        justify-content: center;
      }
    }
  </style>

  {{template "navbar.tmpl" .}}

  <a class="skip-link" href="#create-agent-main">Skip to Main Content</a>

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <main class="main-content" id="create-agent-main" role="main" aria-labelledby="create-agent-title">
      <div class="create-container">
        <div class="page-header">
          <h1 id="create-agent-title">Create New Agent</h1>
          <p>Configure and customize your AI agent</p>
        </div>

        <form id="createAgentForm" novalidate>
        <div id="errorMessage" class="error-message" role="alert" aria-live="polite" hidden tabindex="-1"></div>

        <div class="form-card modern-card">
          <h2 class="form-section-title">Configuration Mode</h2>
          <div class="form-group">
            <div class="d-flex align-items-center gap-3 mb-2">
              <div class="btn-group" role="group" aria-label="Configuration mode toggle">
                <input type="radio" class="btn-check" name="createConfigMode" id="createConfigModeManual" value="manual" checked>
                <label class="btn btn-outline-secondary" for="createConfigModeManual">Manual</label>
                <input type="radio" class="btn-check" name="createConfigMode" id="createConfigModeAuto" value="auto">
                <label class="btn btn-outline-secondary" for="createConfigModeAuto">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true" focusable="false">
                    <path d="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"/>
                  </svg>
                  Auto Configure
                </label>
              </div>
              <span id="createAutoConfigStatus" class="badge bg-secondary d-none" style="font-size: 0.75rem;" role="status" aria-live="polite"></span>
            </div>
            <div class="form-help">Choose Manual to set all options yourself, or Auto to generate configuration from a description.</div>
          </div>

          <div id="createAutoConfigSection" class="d-none">
            <div class="form-group">
              <label class="form-label" for="createAutoConfigDescription">Describe Your Agent</label>
              <textarea id="createAutoConfigDescription" class="form-textarea" rows="3" name="auto_config_description" autocomplete="off" aria-describedby="createAutoConfigDescriptionError"
                placeholder="Example: An agent that helps with code reviews, understands multiple programming languages, and can suggest improvements…"></textarea>
              <div class="form-help">Be specific about what tasks this agent should handle and what tools it needs.</div>
              <div id="createAutoConfigDescriptionError" class="field-error" aria-live="polite"></div>
            </div>
            <button type="button" id="createGenerateAutoConfigBtn" class="modern-btn modern-btn-primary mb-3">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true" focusable="false">
                <path d="M12,3L2,12H5V20H19V12H22L12,3M12,8.75A2.25,2.25 0 0,1 14.25,11A2.25,2.25 0 0,1 12,13.25A2.25,2.25 0 0,1 9.75,11A2.25,2.25 0 0,1 12,8.75Z"/>
              </svg>
              Generate Configuration
            </button>
          </div>

          <div id="createLlmNotAvailableWarning" class="alert alert-warning d-none" style="font-size: 0.875rem;" role="status" aria-live="polite">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;" aria-hidden="true" focusable="false">
              <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
            </svg>
            <span id="createLlmWarningMessage">Auto-config requires an LLM provider. Please set up an API key or install Ollama in Settings.</span>
            <a href="/settings" class="alert-link ms-1" id="createLlmWarningSettingsLink">Go to Settings</a>
          </div>

          <div id="createAutoSelectedIndicator" class="alert alert-info d-none" style="font-size: 0.875rem;" role="status" aria-live="polite">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;" aria-hidden="true" focusable="false">
              <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
            </svg>
            <strong id="createAutoSelectedTitle">Auto-configured!</strong>
            <span id="createAutoSelectedMessage">Settings below were generated from your description. You can still adjust them manually.</span>
          </div>
        </div>

        <div class="form-card modern-card">
          <h2 class="form-section-title">Basic Information</h2>

          <div class="form-group">
            <label class="form-label required" for="agentName">Agent Name</label>
            <input type="text" id="agentName" class="form-input" name="agent_name" autocomplete="off" aria-describedby="agentNameError" placeholder="e.g., Code Assistant" required>
            <div class="form-help">Choose a unique, descriptive name for your agent</div>
            <div id="agentNameError" class="field-error" aria-live="polite"></div>
          </div>

          <div class="form-group">
            <label class="form-label" for="agentDescription">Description</label>
            <textarea id="agentDescription" class="form-textarea" name="agent_description" autocomplete="off" placeholder="Describe what this agent does…"></textarea>
            <div class="form-help">Optional: Help others understand the agent's purpose</div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label required" for="agentType">Agent Type</label>
              <select id="agentType" class="form-select" name="agent_type" aria-describedby="agentTypeError" required onchange="updateModelOptions()">
                <option value="tool-calling">Tool Calling</option>
                <option value="general">General Purpose</option>
                <option value="research">Research</option>
                <option value="orchestration">Orchestration</option>
              </select>
              <div class="form-help">Defines the agent's interaction style and available models</div>
              <div id="agentTypeError" class="field-error" aria-live="polite"></div>
            </div>

            <div class="form-group">
              <label class="form-label required" for="agentRole">Role</label>
              <select id="agentRole" class="form-select" name="agent_role" aria-describedby="agentRoleError" required>
                <option value="general">General</option>
                <option value="coding">Coding</option>
                <option value="research">Research</option>
                <option value="creative">Creative</option>
                <option value="analysis">Analysis</option>
              </select>
              <div class="form-help">The agent's primary role or specialty</div>
              <div id="agentRoleError" class="field-error" aria-live="polite"></div>
            </div>
          </div>
        </div>

        <div class="form-card modern-card">
          <h2 class="form-section-title">LLM Configuration</h2>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="llmProvider">Provider Filter</label>
              <select id="llmProvider" class="form-select" name="llm_provider_filter" onchange="updateModelOptions()">
                <option value="">All Providers</option>
                <option value="openai">OpenAI</option>
                <option value="codex">OpenAI Codex (CLI)</option>
                <option value="claude_code">Claude Code (CLI)</option>
                <option value="claude">Anthropic Claude</option>
                <option value="gemini">Google Gemini</option>
                <option value="ollama">Ollama (Local)</option>
                <option value="lmstudio">LM Studio (Local)</option>
                <option value="mlx_lm">MLX-LM (Local)</option>
              </select>
              <div class="form-help">Filter models by provider (optional)</div>
            </div>

            <div class="form-group">
              <label class="form-label required" for="llmModel">Model</label>
              <select id="llmModel" class="form-select" name="llm_model" aria-describedby="llmModelError" required>
                <option value="">Loading models…</option>
              </select>
              <div id="llmModelError" class="field-error" aria-live="polite"></div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="temperature">Temperature: <span id="tempValue">1.0</span></label>
            <input type="range" id="temperature" class="form-input" name="temperature" min="0" max="2" step="0.1" value="1.0"
              oninput="document.getElementById('tempValue').textContent = this.value">
            <div class="form-help">Controls randomness: 0 = focused, 2 = creative</div>
          </div>

          <div class="form-group">
            <label class="form-label" for="systemPrompt">System Prompt</label>
            <textarea id="systemPrompt" class="form-textarea" name="system_prompt" autocomplete="off" placeholder="You are a helpful assistant…"></textarea>
            <div class="form-help">Optional: Custom instructions for the agent's behavior</div>
          </div>

          <div class="form-group">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="allowWebSearch" name="allow_web_search" checked>
              <label class="form-label mb-0" for="allowWebSearch">Allow Web Tools</label>
            </div>
            <div class="form-help">If enabled, this agent can use `web_search`, `web_fetch`, and `browser` utility tools.</div>
          </div>
        </div>

        <div class="form-card modern-card">
          <h2 class="form-section-title">Appearance</h2>

          <div class="form-group">
            <label class="form-label" for="avatarColor">Avatar Color</label>
            <div class="color-picker-group">
              <div id="colorPreview" class="color-preview" style="background: #1d4ed8;"></div>
              <input type="color" id="avatarColor" class="form-input color-input" name="avatar_color" autocomplete="off" value="#1d4ed8"
                onchange="document.getElementById('colorPreview').style.background = this.value">
              <span class="form-help">Choose a color for the agent's avatar</span>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="tagsInput">Tags</label>
            <div id="tagsContainer" class="tags-input-container" onclick="document.getElementById('tagsInput').focus()">
              <input type="text" id="tagsInput" class="tag-input" name="tags_input" autocomplete="off" placeholder="Add tags…">
            </div>
            <div class="form-help">Press Enter to add tags (e.g., "coding", "creative", "research")</div>
          </div>
        </div>

        <div class="form-card modern-card">
          <h2 class="form-section-title">Plugins</h2>
          <div class="form-help" style="margin-bottom: 12px;">Select which plugins this agent can use</div>

          <div id="pluginsList" class="plugin-list">
            <!-- Populated by JavaScript -->
          </div>
        </div>

        <div class="form-card modern-card">
          <div class="form-actions">
            <a href="/agents" class="modern-btn modern-btn-secondary">Cancel</a>
            <button type="submit" class="modern-btn modern-btn-primary" id="createBtn">Create Agent</button>
          </div>
        </div>
        </form>
      </div>
    </main>
  </div>

  <div id="loadingOverlay" class="loading-overlay">
    <div class="loading-spinner">
      <p>Creating Agent…</p>
    </div>
  </div>

  {{template "modals.tmpl" .}}

  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/modules/toast.js"></script>
  <script defer src="/js/modules/resizer.js"></script>
  <script defer src="/js/modules/sidebar.js"></script>
  <script defer src="/js/agents-create.js"></script>
  {{template "theme-init.tmpl" .}}
</body>
</html>
{{end}}
