{{define "agents-create"}}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
{{template "head.tmpl" .}}
<body class="ui-page">
  <style>
    .create-container {
      max-width: 980px;
      margin: 0 auto;
      padding: 24px 20px calc(24px + var(--ori-launcher-clearance-y, 88px));
    }

    .page-header { margin-bottom: var(--space-6); }

    .form-card {
      margin-bottom: var(--space-6);
      padding: var(--space-4);
    }

    .form-section-title {
      font-size: 18px;
      font-weight: 650;
      margin-bottom: 16px;
      padding-bottom: 11px;
      border-bottom: 1px solid var(--border-color);
      color: var(--text-primary);
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
    }

    .plugin-list {
      max-height: 320px;
      overflow-y: auto;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      padding: 8px;
      background: var(--bg-secondary);
    }

    .plugin-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 10px;
      border-radius: 8px;
      margin-bottom: 5px;
      transition: background 0.2s ease, border-color 0.2s ease;
      border: 1px solid transparent;
    }

    .plugin-item:hover { background: var(--bg-tertiary); }

    .plugin-checkbox {
      width: 18px;
      height: 18px;
      cursor: pointer;
      accent-color: var(--primary-color);
    }

    .plugin-info {
      flex: 1;
    }

    .plugin-name {
      font-weight: 600;
      margin-bottom: 2px;
      color: var(--text-primary);
    }

    .plugin-description {
      font-size: 12px;
      color: var(--text-secondary);
    }

    .form-actions {
      display: flex;
      gap: 12px;
      justify-content: flex-end;
      align-items: center;
    }

    /* ---------- Personal assistant pointer (Mission 01) ---------- */
    .assistant-pointer {
      margin: 0 0 12px;
      font-size: 14px;
      color: var(--text-secondary, #4b5563);
    }

    /* The Hire / Advanced tabs and the role cards are styled by
       /css/agent-hire.css, shared with the Agents roster's modal. */

    .field-error { display: none; }
    .field-error.is-visible { display: block; }

    .loading-overlay { display: none; }
    .loading-spinner { padding: var(--space-6); text-align: center; }

    @media (max-width: 900px) {
      .create-container {
        padding: 18px 14px calc(18px + var(--ori-launcher-clearance-y, 88px));
      }
    }

    @media (max-width: 768px) {
      .form-row {
        grid-template-columns: 1fr;
      }

      .form-card {
        padding: 18px 16px;
      }

      .form-actions {
        justify-content: stretch;
        flex-wrap: wrap;
      }

      .form-actions .modern-btn {
        flex: 1 1 100%;
        justify-content: center;
      }
    }
  </style>

  {{template "navbar.tmpl" .}}

  <a class="skip-link" href="#create-agent-main">Skip to Main Content</a>

  <div class="main-content-wrapper">
    <main class="main-content" id="create-agent-main" role="main" aria-labelledby="create-agent-title">
      <div class="create-container">
        <header class="page-header ui-page-header">
          <div>
            <h1 id="create-agent-title">Hire an agent</h1>
            <p>Say what it should do, or configure every setting under Advanced</p>
          </div>
        </header>

        <!-- Shown only while the personal assistant is unhired: Mission 01 hires
             it from the Agents page, not from here (agents-catalog.js). -->
        <p class="assistant-pointer" id="assistantPointer" hidden>
          Looking for your personal assistant?
          <a id="assistantPointerLink">Meet them on the Agents page.</a>
        </p>

        <!-- Hire (the same card as the Agents roster's modal, agent-hire-card.js)
             and Advanced. Hire is offered once a personal assistant is hired;
             until then the page is Advanced alone (agents-catalog.js). -->
        <div class="agent-create-tabs nav-tabs" role="tablist" aria-label="How to add an agent">
          <button type="button" class="agent-create-tab nav-link is-active active" id="catalogTabBtn" role="tab"
            aria-selected="true" aria-controls="catalogTabPanel" tabindex="0">Hire</button>
          <button type="button" class="agent-create-tab nav-link" id="customTabBtn" role="tab"
            aria-selected="false" aria-controls="customTabPanel" tabindex="-1">Advanced</button>
        </div>

        <section id="catalogTabPanel" class="agent-create-tabpanel" role="tabpanel" aria-labelledby="catalogTabBtn" tabindex="0">
          <div class="form-card ui-section">
            <h2 class="form-section-title">Hire an agent</h2>
            <div id="hireCardHost">
              <p class="form-helper" role="status">Loading roles…</p>
            </div>
            <div class="form-actions">
              <a href="/agents" class="modern-btn modern-btn-secondary">Cancel</a>
              <button type="button" id="hireStartBtn" class="modern-btn modern-btn-primary" disabled>Hire and start</button>
            </div>
          </div>
        </section>

        <section id="customTabPanel" class="agent-create-tabpanel" role="tabpanel" aria-labelledby="customTabBtn" tabindex="0" hidden>
        <form id="createAgentForm" class="ui-section" novalidate>
        <div id="errorMessage" class="error-message alert alert-danger" role="alert" aria-live="polite" hidden tabindex="-1"></div>

        <div class="form-card ui-section ui-section--quiet">
          <h2 class="form-section-title">Configuration Mode</h2>
          <div class="form-group">
            <div class="d-flex align-items-center gap-3 mb-2">
              <div class="btn-group" role="group" aria-label="Configuration mode toggle">
                <input type="radio" class="btn-check" name="createConfigMode" id="createConfigModeManual" value="manual" checked>
                <label class="btn btn-outline-secondary btn-sm" for="createConfigModeManual">Manual</label>
                <input type="radio" class="btn-check" name="createConfigMode" id="createConfigModeAuto" value="auto">
                <label class="btn btn-outline-secondary btn-sm" for="createConfigModeAuto">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true" focusable="false">
                    <path d="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"/>
                  </svg>
                  Auto
                </label>
              </div>
              <span id="createAutoConfigStatus" class="badge bg-secondary d-none" style="font-size: 0.75rem;" role="status" aria-live="polite"></span>
            </div>
            <div class="form-helper">Choose Manual to set all options yourself, or Auto to generate configuration from a description.</div>
          </div>

          <div id="createAutoConfigSection" class="d-none">
            <div class="form-group">
              <label class="form-label" for="createAutoConfigDescription">Describe Your Agent</label>
              <textarea id="createAutoConfigDescription" class="modern-input" rows="3" name="auto_config_description" autocomplete="off" aria-describedby="createAutoConfigDescriptionError"
                placeholder="Example: An agent that helps with code reviews, understands multiple programming languages, and can suggest improvements…"></textarea>
              <div class="form-helper">Be specific about what tickets this agent should handle and what tools it needs.</div>
              <div id="createAutoConfigDescriptionError" class="field-error ui-field-error" aria-live="polite"></div>
            </div>
            <button type="button" id="createGenerateAutoConfigBtn" class="modern-btn modern-btn-primary mb-3">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true" focusable="false">
                <path d="M12,3L2,12H5V20H19V12H22L12,3M12,8.75A2.25,2.25 0 0,1 14.25,11A2.25,2.25 0 0,1 12,13.25A2.25,2.25 0 0,1 9.75,11A2.25,2.25 0 0,1 12,8.75Z"/>
              </svg>
              Generate Configuration
            </button>
          </div>

          <div id="createLlmNotAvailableWarning" class="alert alert-warning d-none" style="font-size: 0.875rem;" role="status" aria-live="polite">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;" aria-hidden="true" focusable="false">
              <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
            </svg>
            <span id="createLlmWarningMessage">Auto-config requires an LLM provider. Please set up an API key or install Ollama in Settings.</span>
            <a href="/settings#system-model" class="alert-link ms-1" id="createLlmWarningSettingsLink">Go to Settings</a>
          </div>

          <div id="createAutoSelectedIndicator" class="alert alert-info d-none" style="font-size: 0.875rem;" role="status" aria-live="polite">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;" aria-hidden="true" focusable="false">
              <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
            </svg>
            <strong id="createAutoSelectedTitle">Auto-configured!</strong>
            <span id="createAutoSelectedMessage">Settings below were generated from your description. You can still adjust them manually.</span>
          </div>
        </div>

        <div class="form-card ui-section ui-section--quiet">
          <h2 class="form-section-title">Basic Information</h2>

          <div class="form-group">
            <label class="form-label required" for="agentName">Agent Name</label>
            <input type="text" id="agentName" class="form-input" name="agent_name" autocomplete="off" aria-describedby="agentNameError" placeholder="e.g., Code Assistant" required>
            <div class="form-helper">Choose a unique, descriptive name for your agent</div>
            <div id="agentNameError" class="field-error ui-field-error" aria-live="polite"></div>
          </div>

          <div class="form-group">
            <label class="form-label" for="agentDescription">Description</label>
            <textarea id="agentDescription" class="modern-input" name="agent_description" autocomplete="off" placeholder="Describe what this agent does…"></textarea>
            <div class="form-helper">Optional: Help others understand the agent's purpose</div>
          </div>

          <div class="form-group">
            <label class="form-label required" for="agentRole">Role</label>
            <select id="agentRole" class="form-select" name="agent_role" aria-describedby="agentRoleError" required>
              <option value="general">General</option>
              <option value="coding">Coding</option>
              <option value="research">Research</option>
              <option value="creative">Creative</option>
              <option value="analysis">Analysis</option>
            </select>
            <div class="form-helper">The agent's primary role or specialty</div>
            <div id="agentRoleError" class="field-error ui-field-error" aria-live="polite"></div>
          </div>
        </div>

        <div class="form-card ui-section ui-section--quiet">
          <h2 class="form-section-title">LLM Configuration</h2>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label" for="llmProvider">Provider Filter</label>
              <select id="llmProvider" class="form-select" name="llm_provider_filter" onchange="updateModelOptions()">
                <option value="">All Providers</option>
                <option value="openai">OpenAI</option>
                <option value="codex">OpenAI Codex (CLI)</option>
                <option value="claude_code">Claude Code (CLI)</option>
                <option value="claude">Anthropic Claude</option>
                <option value="gemini">Google Gemini</option>
                <option value="ollama">Ollama (Local)</option>
                <option value="lmstudio">LM Studio (Local)</option>
                <option value="mlx_lm">MLX-LM (Local)</option>
              </select>
              <div class="form-helper">Filter models by provider (optional)</div>
            </div>

            <div class="form-group">
              <label class="form-label required" for="llmModel">Model</label>
              <select id="llmModel" class="form-select" name="llm_model" aria-describedby="llmModelError" required>
                <option value="">Loading models…</option>
              </select>
              <div id="llmModelError" class="field-error ui-field-error" aria-live="polite"></div>
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="temperature">Temperature: <span id="tempValue">1.0</span></label>
            <input type="range" id="temperature" class="form-range" name="temperature" min="0" max="2" step="0.1" value="1.0"
              oninput="document.getElementById('tempValue').textContent = this.value">
            <div class="form-helper">Controls randomness: 0 = focused, 2 = creative</div>
          </div>

          <div class="form-group">
            <label class="form-label" for="systemPrompt">System Prompt</label>
            <textarea id="systemPrompt" class="modern-input" name="system_prompt" autocomplete="off" placeholder="You are a helpful assistant…"></textarea>
            <div class="form-helper">Optional: Custom instructions for the agent's behavior</div>
          </div>

          <div class="form-group">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="allowWebSearch" name="allow_web_search">
              <label class="form-check-label mb-0" for="allowWebSearch">Allow Web Tools</label>
            </div>
            <div class="form-helper">If enabled, this agent can use `web_search`, `web_fetch`, and `browser` utility tools.</div>
          </div>
        </div>

        <div class="form-card ui-section ui-section--quiet">
          <!-- The card already said "Appearance" while offering only a colour.
               The shared editor makes that true: all three sources, one
               preview, and the same staged-upload handling every other create
               flow uses (FR-45/FR-87). -->
          <div class="form-group">
            <div id="createAppearanceHost"></div>
          </div>

          <div class="form-group">
            <label class="form-label" for="tagsInput">Tags</label>
            <div id="tagsContainer" class="tags-input-container tag-input-chips" onclick="document.getElementById('tagsInput').focus()">
              <input type="text" id="tagsInput" class="tag-input-field" name="tags_input" autocomplete="off" placeholder="Add tags…">
            </div>
            <div class="form-helper">Press Enter to add tags (e.g., "coding", "creative", "research")</div>
          </div>
        </div>

        <div class="form-card ui-section ui-section--quiet">
          <h2 class="form-section-title">Plugins</h2>
          <div class="form-helper mb-3">Select which plugins this agent can use</div>

          <div id="pluginsList" class="plugin-list">
            <!-- Populated by JavaScript -->
          </div>
        </div>

        <div class="form-card ui-section ui-section--quiet">
          <div class="form-actions">
            <a href="/agents" class="modern-btn modern-btn-secondary">Cancel</a>
            <button type="submit" class="modern-btn modern-btn-primary" id="createBtn">Create Agent</button>
          </div>
        </div>
        </form>
        </section>
      </div>
    </main>
  </div>

  <div id="loadingOverlay" class="loading-overlay">
    <div class="loading-spinner ui-section">
      <p>Creating Agent…</p>
    </div>
  </div>

  {{template "modals.tmpl" .}}

  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/modules/toast.js"></script>
  <script defer src="/js/agents-create.js"></script>
  <script defer src="/js/modules/folder-plan-lines.js"></script>
  <script defer src="/js/modules/agent-hire-card.js"></script>
  <script defer src="/js/modules/agents-catalog.js"></script>
  <!-- Mission 01's route and state view, read by agents-catalog.js at use time. -->
  <script type="module" src="/js/modules/personal-assistant-hire.js"></script>
  {{template "theme-init.tmpl" .}}
</body>
</html>
{{end}}
