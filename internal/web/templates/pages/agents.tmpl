<!DOCTYPE html>
<html lang="en">
{{template "head.tmpl" .}}

<style>
    body {
        margin: 0;
        padding: 0;
    }

    .skip-link {
        position: absolute;
        left: 20px;
        top: 18px;
        z-index: 1100;
        padding: 10px 14px;
        border-radius: 999px;
        background: var(--bg-primary);
        color: var(--text-primary);
        border: 1px solid color-mix(in srgb, var(--border-color) 76%, var(--primary-color) 24%);
        box-shadow: 0 10px 22px rgba(0, 0, 0, 0.18);
        text-decoration: none;
        transform: translateY(-180%);
        transition: transform 0.2s ease;
    }

    .skip-link:focus-visible {
        transform: translateY(0);
    }

    .agents-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
    }

    .page-title h1 {
        font-size: 28px;
        margin-bottom: 5px;
        margin-top: 0;
    }

    .page-title p {
        color: var(--text-secondary);
        font-size: 14px;
        margin: 0;
    }

    [data-bs-theme="dark"] .page-title p {
        color: rgba(255, 255, 255, 0.7);
    }

    [data-bs-theme="light"] .page-title p {
        color: var(--text-secondary);
    }

    .header-actions {
        display: flex;
        gap: 12px;
    }

    .header-actions .btn {
        padding: 10px 20px;
        border: none;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        cursor: pointer;
        transition: background-color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
    }

    .header-actions .btn:focus-visible {
        outline: 2px solid color-mix(in srgb, var(--primary-color) 68%, white 32%);
        outline-offset: 2px;
    }

    .header-actions .btn-primary {
        background: var(--primary-color, #007bff);
        color: white;
    }

    .header-actions .btn-primary:hover {
        opacity: 0.9;
    }

    .header-actions .btn-secondary {
        background: var(--bg-secondary);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
    }

    .header-actions .btn-secondary:hover {
        background: var(--bg-tertiary);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px;
    }

    .stat-label {
        color: rgba(0, 0, 0, 0.6);
        font-size: 13px;
        margin-bottom: 8px;
        font-weight: 500;
    }

    [data-bs-theme="dark"] .stat-label {
        color: var(--text-muted);
    }

    .stat-value {
        font-size: 28px;
        font-weight: 600;
        margin-bottom: 4px;
        color: rgba(0, 0, 0, 0.9);
    }

    [data-bs-theme="dark"] .stat-value {
        color: var(--text-primary);
    }

    .stat-change {
        font-size: 12px;
        color: var(--success-color);
    }

    .controls-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 16px;
        flex-wrap: wrap;
    }

    .search-box {
        flex: 1;
        min-width: 250px;
        position: relative;
    }

    .search-box input {
        width: 100%;
        padding: 10px 40px 10px 16px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-size: 14px;
        background: var(--bg-primary);
        color: var(--text-primary);
    }

    .search-icon {
        position: absolute;
        right: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
    }

    .filters {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .filter-select {
        padding: 10px 16px;
        border: 1px solid var(--border-color);
        border-radius: 6px;
        font-size: 14px;
        background: var(--bg-primary);
        color: var(--text-primary);
        cursor: pointer;
    }

    .view-toggle {
        display: flex;
        gap: 8px;
    }

    .view-btn {
        padding: 8px 12px;
        border: 1px solid var(--border-color);
        background: var(--bg-primary);
        color: var(--text-primary);
        border-radius: 6px;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .view-btn.active {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }

    .view-btn:hover:not(.active) {
        background: var(--bg-secondary);
    }

    /* Ensure white text in dark mode */
    [data-bs-theme="dark"] .view-btn {
        color: white;
    }

    /* Table View */
    .agents-table-container {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        overflow: hidden;
    }

    .agents-table {
        width: 100%;
        border-collapse: collapse;
    }

    .agents-table th {
        background: var(--bg-secondary);
        padding: 16px;
        text-align: left;
        font-weight: 600;
        font-size: 13px;
        color: rgba(0, 0, 0, 0.65);
        border-bottom: 1px solid var(--border-color);
        cursor: pointer;
        user-select: none;
    }

    [data-bs-theme="dark"] .agents-table th {
        color: var(--text-muted);
    }

    .agents-table th:hover {
        background: var(--bg-tertiary);
    }

    .agents-table td {
        padding: 16px;
        border-bottom: 1px solid var(--border-color);
    }

    .agents-table tr:last-child td {
        border-bottom: none;
    }

    .agents-table tbody tr:hover {
        background: var(--bg-secondary);
    }

    .agent-name-cell {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .agent-avatar {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: white;
        flex-shrink: 0;
    }

    .agent-info {
        flex: 1;
    }

    .agent-name {
        font-weight: 600;
        margin-bottom: 2px;
    }

    .agent-description {
        font-size: 12px;
        color: var(--text-muted);
    }

    .description-cell {
        max-width: 300px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 13px;
        color: var(--text-secondary);
    }

    [data-bs-theme="dark"] .description-cell {
        color: rgba(255, 255, 255, 0.7);
    }

    .actions-cell {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        padding: 6px 12px;
        border: 1px solid var(--border-color);
        background: transparent;
        border-radius: 4px;
        cursor: pointer;
        font-size: 12px;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
        color: var(--text-primary);
    }

    .action-btn:hover {
        background: var(--bg-secondary);
    }

    .action-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* Card View */
    .agents-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 20px;
    }

    .agent-card {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 20px;
        transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
        cursor: pointer;
    }

    .agent-card:hover {
        border-color: var(--primary-color);
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.1);
        transform: translateY(-2px);
    }

    .agent-card-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 16px;
    }

    .agent-card-avatar {
        width: 50px;
        height: 50px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: 20px;
        color: white;
        flex-shrink: 0;
    }

    .agent-card-info {
        flex: 1;
    }

    .agent-card-name {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .agent-card-meta {
        display: flex;
        gap: 12px;
        margin-bottom: 16px;
        font-size: 13px;
        color: var(--text-muted);
    }

    .agent-card-stats {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        padding-top: 16px;
        border-top: 1px solid var(--border-color);
    }

    .card-stat {
        text-align: center;
    }

    .card-stat-value {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 4px;
    }

    .card-stat-label {
        font-size: 11px;
        color: var(--text-muted);
        text-transform: uppercase;
    }

    .agent-card-actions {
        padding-top: 12px;
        margin-top: 12px;
        border-top: 1px solid var(--border-color);
        display: flex;
        justify-content: center;
    }

    .hidden {
        display: none;
    }

    .loading {
        text-align: center;
        padding: 40px;
        color: var(--text-muted);
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

    .empty-state h3 {
        margin-bottom: 12px;
        color: var(--text-primary);
    }

    .empty-state p {
        color: var(--text-muted);
        margin-bottom: 24px;
    }

    .sort-icon {
        margin-left: 8px;
        font-size: 10px;
    }

    /* Source Filter Tabs */
    .source-filter-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 16px;
        align-items: center;
        flex-wrap: wrap;
    }

    .source-filter-btn {
        padding: 8px 16px;
        border: 1px solid var(--border-color);
        background: var(--bg-primary);
        color: var(--text-primary);
        border-radius: 20px;
        cursor: pointer;
        font-size: 14px;
        transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
    }

    .source-filter-btn:hover {
        background: var(--bg-secondary);
    }

    .source-filter-btn.active {
        background: var(--primary-color);
        color: white;
        border-color: var(--primary-color);
    }

    .filter-count {
        background: rgba(255,255,255,0.2);
        padding: 2px 6px;
        border-radius: 10px;
        font-size: 11px;
        margin-left: 4px;
    }

    .source-filter-btn:not(.active) .filter-count {
        background: var(--bg-tertiary);
    }

    /* External Agents Disabled Banner */
    .external-agents-banner {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 20px;
    }

    .external-agents-banner .banner-content {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--text-secondary);
        font-size: 14px;
    }

    .external-agents-banner svg {
        color: var(--text-secondary);
        flex-shrink: 0;
    }

    .external-agents-banner .banner-link {
        color: var(--accent-color, #007bff);
        text-decoration: none;
        font-weight: 500;
        margin-left: auto;
    }

    .external-agents-banner .banner-link:hover {
        text-decoration: underline;
    }

    /* Source Badges */
    .badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 2px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 500;
        margin-left: 8px;
        vertical-align: middle;
    }

    .badge-ori {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .badge-claude {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: white;
    }

    .badge-codex {
        background: linear-gradient(135deg, #10a37f 0%, #059669 100%);
        color: white;
    }

    .source-icon {
        width: 12px;
        height: 12px;
    }

    /* Read Only Label */
    .read-only-label {
        display: inline-block;
        padding: 4px 8px;
        background: var(--bg-tertiary);
        color: var(--text-muted);
        border-radius: 4px;
        font-size: 11px;
        font-weight: 500;
    }

    /* External Agent Styling */
    .external-agent-row {
        background: var(--bg-secondary);
    }

    .external-agent-card {
        border-left: 3px solid #6366f1;
    }

    .codex-config-row {
        background: var(--bg-secondary);
    }

    /* Claude Settings Card */
    .claude-settings-card {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-left: 3px solid #6366f1;
        border-radius: 12px;
        padding: 20px;
        grid-column: 1 / -1;
    }

    .claude-settings-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .claude-settings-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .claude-settings-title h4 {
        margin: 0;
        font-size: 16px;
    }

    .claude-settings-body {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .settings-section {
        padding: 12px;
        background: var(--bg-secondary);
        border-radius: 8px;
    }

    .settings-section h6 {
        margin: 0 0 12px 0;
        color: var(--text-muted);
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .permissions-summary {
        display: flex;
        gap: 24px;
        flex-wrap: wrap;
    }

    .permission-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .permission-count, .permission-mode {
        font-size: 20px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .permission-label {
        font-size: 11px;
        color: var(--text-muted);
        text-transform: uppercase;
    }

    .badge-user {
        background: #dbeafe;
        color: #1e40af;
    }

    .badge-local {
        background: #fef3c7;
        color: #92400e;
    }

    [data-bs-theme="dark"] .badge-user {
        background: #1e3a5f;
        color: #93c5fd;
    }

    [data-bs-theme="dark"] .badge-local {
        background: #78350f;
        color: #fcd34d;
    }

    .claude-settings-footer {
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border-color);
        text-align: center;
    }

    /* Codex Config Card */
    .codex-config-card {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-left: 3px solid #10a37f;
        border-radius: 12px;
        padding: 20px;
    }

    .codex-config-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 16px;
    }

    .codex-config-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .codex-config-title h4 {
        margin: 0;
        font-size: 16px;
    }

    .codex-config-body {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .config-item {
        display: flex;
        justify-content: space-between;
        padding: 8px 0;
        border-bottom: 1px solid var(--border-color);
    }

    .config-item:last-child {
        border-bottom: none;
    }

    .config-label {
        color: var(--text-muted);
        font-size: 13px;
    }

    .config-value {
        font-weight: 500;
    }

    .codex-config-footer {
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--border-color);
        text-align: center;
    }

    /* Claude Agent Detail Modal */
    .claude-agent-detail {
        padding: 16px;
    }

    .agent-detail-header {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
    }

    .agent-avatar-large {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        font-weight: 600;
        color: white;
    }

    .agent-detail-info h4 {
        margin: 0 0 4px 0;
    }

    .agent-detail-section {
        margin-bottom: 20px;
    }

    .agent-detail-section h6 {
        color: var(--text-muted);
        margin-bottom: 8px;
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .config-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
    }

    .color-swatch {
        display: inline-block;
        width: 16px;
        height: 16px;
        border-radius: 4px;
        vertical-align: middle;
        margin-right: 4px;
    }

    .system-prompt-display {
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        padding: 16px;
        max-height: 300px;
        overflow-y: auto;
        font-size: 13px;
        white-space: pre-wrap;
        word-wrap: break-word;
    }

    .ops-shell {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .ops-toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: linear-gradient(120deg,
            color-mix(in srgb, var(--bg-primary) 92%, #C9CCD1 8%),
            color-mix(in srgb, var(--bg-primary) 92%, var(--primary-color) 8%));
    }

    .ops-search-wrap {
        flex: 1;
    }

    .ops-search-help {
        margin: 8px 0 0;
        font-size: 12px;
        color: var(--text-muted);
    }

    .ops-search {
        width: 100%;
        border-radius: 10px;
        border: 1px solid color-mix(in srgb, var(--border-color) 84%, var(--primary-color) 16%);
        background: color-mix(in srgb, var(--bg-primary) 88%, transparent);
        color: var(--text-primary);
        padding: 10px 14px;
        font-size: 14px;
    }

    .ops-search:focus-visible {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary-color) 20%, transparent);
    }

    .ops-mode {
        display: inline-flex;
        border: 1px solid var(--border-color);
        border-radius: 10px;
        overflow: hidden;
        background: var(--bg-primary);
    }

    .ops-mode-btn {
        border: none;
        background: transparent;
        color: var(--text-secondary);
        padding: 8px 14px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.2s ease, color 0.2s ease;
    }

    .ops-mode-btn.active {
        background: var(--primary-color);
        color: #fff;
    }

    .ops-mode-btn:focus-visible,
    .ops-action-btn:focus-visible,
    .ops-icon-btn:focus-visible,
    .ops-enable-toggle:focus-within,
    .ops-drawer-tab:focus-visible,
    .ops-drawer-close:focus-visible,
    .empty-state-clear-btn:focus-visible {
        outline: 2px solid var(--primary-color);
        outline-offset: 2px;
    }

    .ops-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
    }

    .ops-summary-chip {
        border-radius: 10px;
        border: 1px solid var(--border-color);
        background: var(--bg-primary);
        padding: 10px 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ops-summary-label {
        font-size: 12px;
        color: var(--text-secondary);
        text-transform: uppercase;
        letter-spacing: 0.4px;
        font-weight: 600;
    }

    .ops-summary-value {
        font-size: 20px;
        font-weight: 700;
        color: var(--text-primary);
        font-variant-numeric: tabular-nums;
    }

    .ops-health-message {
        border-radius: 10px;
        border: 1px solid color-mix(in srgb, #16a34a 32%, transparent);
        background: color-mix(in srgb, #16a34a 12%, var(--bg-primary));
        color: color-mix(in srgb, #16a34a 72%, var(--text-primary));
        padding: 10px 14px;
        font-size: 13px;
        font-weight: 600;
    }

    .ops-health-message.warn {
        border-color: color-mix(in srgb, var(--primary-color) 40%, transparent);
        background: color-mix(in srgb, var(--primary-color) 14%, var(--bg-primary));
        color: color-mix(in srgb, var(--primary-color) 76%, var(--text-primary));
    }

    .ops-board {
        display: grid;
        grid-template-columns: minmax(280px, 0.72fr) minmax(0, 1.28fr);
        gap: 14px;
    }

    .ops-column {
        border: 1px solid var(--border-color);
        border-radius: 14px;
        background: var(--bg-primary);
        min-height: 320px;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .ops-column-header {
        padding: 12px 14px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .ops-column-header h3 {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: 0.2px;
        text-transform: uppercase;
    }

    .ops-column-count {
        min-width: 24px;
        height: 24px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        background: var(--bg-tertiary);
        color: var(--text-secondary);
        font-variant-numeric: tabular-nums;
    }

    .ops-column-alert .ops-column-header {
        background: color-mix(in srgb, #ef4444 10%, var(--bg-primary));
    }

    .ops-column-ready .ops-column-header {
        background: color-mix(in srgb, #16a34a 10%, var(--bg-primary));
    }

    .ops-list {
        padding: 10px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        flex: 1;
        overflow-y: auto;
    }

    .ops-empty-column {
        border: 1px dashed var(--border-color);
        border-radius: 10px;
        color: var(--text-muted);
        font-size: 12px;
        text-align: center;
        padding: 14px 12px;
    }

    .ops-agent-card {
        border: 1px solid var(--border-color);
        border-radius: 12px;
        background: var(--bg-secondary);
        padding: 12px;
        display: flex;
        flex-direction: column;
        gap: 10px;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .ops-agent-card:hover {
        border-color: color-mix(in srgb, var(--primary-color) 45%, var(--border-color));
        transform: translateY(-1px);
        box-shadow: 0 18px 38px rgba(10, 10, 10, 0.12);
    }

    .ops-agent-card:focus-within {
        outline: 2px solid var(--primary-color);
        outline-offset: 2px;
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(31, 107, 78, 0.18);
    }

    .ops-card-top {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        min-width: 0;
    }

    .ops-card-controls {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        flex-shrink: 0;
    }

    .ops-agent-avatar {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 13px;
        font-weight: 700;
    }

    .ops-agent-main {
        min-width: 0;
        flex: 1;
    }

    .ops-agent-name-row {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .ops-agent-name {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
        color: var(--text-primary);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .ops-health-pill {
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        flex-shrink: 0;
    }

    .ops-health-pill.healthy {
        color: #166534;
        background: #dcfce7;
    }

    .ops-health-pill.idle {
        color: #1e3a8a;
        background: #dbeafe;
    }

    .ops-health-pill.disabled {
        color: #334155;
        background: #e2e8f0;
    }

    .ops-health-pill.needs-setup {
        color: #92400e;
        background: #fef3c7;
    }

    .ops-health-pill.error {
        color: #991b1b;
        background: #fee2e2;
    }

    [data-bs-theme="dark"] .ops-health-pill.healthy {
        color: #86efac;
        background: rgba(34, 197, 94, 0.2);
    }

    [data-bs-theme="dark"] .ops-health-pill.idle {
        color: #93c5fd;
        background: rgba(59, 130, 246, 0.2);
    }

    [data-bs-theme="dark"] .ops-health-pill.disabled {
        color: #cbd5e1;
        background: rgba(138, 138, 138, 0.25);
    }

    [data-bs-theme="dark"] .ops-health-pill.needs-setup {
        color: #fcd34d;
        background: rgba(245, 158, 11, 0.2);
    }

    [data-bs-theme="dark"] .ops-health-pill.error {
        color: #fca5a5;
        background: rgba(239, 68, 68, 0.2);
    }

    .ops-system-pill {
        padding: 2px 8px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.2px;
        flex-shrink: 0;
        color: #5b21b6;
        background: #ede9fe;
        border: 1px solid rgba(124, 58, 237, 0.25);
    }

    [data-bs-theme="dark"] .ops-system-pill {
        color: #c4b5fd;
        background: rgba(139, 92, 246, 0.18);
        border-color: rgba(139, 92, 246, 0.35);
    }

    .ops-agent-purpose {
        margin: 4px 0 0;
        color: var(--text-secondary);
        font-size: 12px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .ops-agent-time {
        font-size: 11px;
        color: var(--text-muted);
    }

    .ops-card-actions {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .ops-action-btn {
        border-radius: 8px;
        border: 1px solid var(--border-color);
        background: var(--bg-primary);
        color: var(--text-primary);
        padding: 6px 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-align: center;
    }

    .ops-action-btn.primary {
        background: color-mix(in srgb, var(--primary-color) 18%, var(--bg-primary));
        border-color: color-mix(in srgb, var(--primary-color) 45%, var(--border-color));
    }

    .ops-action-btn.danger {
        background: color-mix(in srgb, #ef4444 12%, var(--bg-primary));
        border-color: color-mix(in srgb, #ef4444 38%, var(--border-color));
    }

    .ops-action-btn:hover {
        background: var(--bg-tertiary);
    }

    .ops-action-btn.danger:hover {
        background: color-mix(in srgb, #ef4444 20%, var(--bg-primary));
    }

    .ops-action-btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .ops-icon-btn {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        border: 1px solid var(--border-color);
        background: var(--bg-primary);
        color: var(--text-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        cursor: pointer;
        flex-shrink: 0;
        transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
    }

    .ops-icon-btn.danger {
        color: #dc2626;
        background: color-mix(in srgb, #ef4444 10%, var(--bg-primary));
        border-color: color-mix(in srgb, #ef4444 34%, var(--border-color));
    }

    .ops-icon-btn:hover {
        background: var(--bg-tertiary);
    }

    .ops-icon-btn.danger:hover {
        color: #b91c1c;
        background: color-mix(in srgb, #ef4444 18%, var(--bg-primary));
    }

    .ops-icon-btn:disabled {
        opacity: 0.58;
        cursor: not-allowed;
    }

    .ops-enable-toggle {
        border-radius: 8px;
        border: 1px solid var(--border-color);
        background: var(--bg-primary);
        color: var(--text-primary);
        padding: 6px 8px;
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
        flex-shrink: 0;
    }

    .ops-enable-toggle input {
        position: absolute;
        opacity: 0;
        pointer-events: none;
    }

    .ops-enable-switch {
        width: 34px;
        height: 20px;
        border-radius: 999px;
        background: color-mix(in srgb, var(--text-muted) 34%, var(--bg-tertiary));
        border: 1px solid color-mix(in srgb, var(--border-color) 76%, transparent);
        position: relative;
        flex-shrink: 0;
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .ops-enable-switch::after {
        content: "";
        position: absolute;
        width: 14px;
        height: 14px;
        border-radius: 999px;
        left: 2px;
        top: 2px;
        background: var(--bg-primary);
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.22);
        transition: transform 0.2s ease;
    }

    .ops-enable-toggle input:checked + .ops-enable-switch {
        background: color-mix(in srgb, var(--primary-color) 78%, #16a34a);
        border-color: color-mix(in srgb, var(--primary-color) 70%, var(--border-color));
    }

    .ops-enable-toggle input:checked + .ops-enable-switch::after {
        transform: translateX(14px);
    }

    .ops-enable-toggle:has(input:disabled) {
        opacity: 0.58;
        cursor: not-allowed;
    }

    .config-only {
        display: none;
        margin-top: 2px;
        padding-top: 8px;
        border-top: 1px dashed var(--border-color);
        font-size: 11px;
        color: var(--text-muted);
        line-height: 1.5;
    }

    .ops-shell.config-mode .config-only {
        display: block;
    }

    .ops-drawer-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.48);
        backdrop-filter: blur(6px);
        z-index: 10040;
    }

    .ops-drawer {
        position: fixed;
        left: 50%;
        top: 50%;
        width: min(720px, calc(100vw - 2rem));
        max-height: min(760px, calc(100vh - 2rem));
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 20px;
        box-shadow: 0 30px 80px rgba(0, 0, 0, 0.3);
        z-index: 10050;
        display: flex;
        flex-direction: column;
        min-height: min(560px, calc(100vh - 2rem));
        overflow: hidden;
        opacity: 0;
        pointer-events: none;
        transform: translate(-50%, calc(-50% + 18px)) scale(0.98);
        transition: transform 0.22s ease, opacity 0.22s ease;
    }

    .ops-drawer.open {
        opacity: 1;
        pointer-events: auto;
        transform: translate(-50%, -50%) scale(1);
    }

    .ops-drawer-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        padding: 18px 20px 16px;
        border-bottom: 1px solid var(--border-color);
    }

    .ops-drawer-kicker {
        margin: 0;
        font-size: 11px;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: var(--text-muted);
        font-weight: 700;
    }

    .ops-drawer-header h2 {
        margin: 4px 0 0;
        font-size: 20px;
        line-height: 1.2;
        color: var(--text-primary);
    }

    .ops-drawer-close {
        border: none;
        background: transparent;
        color: var(--text-secondary);
        font-size: 26px;
        line-height: 1;
        cursor: pointer;
        padding: 0 4px;
    }

    .ops-drawer-tabs {
        display: flex;
        gap: 6px;
        padding: 10px 20px;
        border-bottom: 1px solid var(--border-color);
        flex-wrap: wrap;
    }

    .ops-drawer-tab {
        border: 1px solid var(--border-color);
        background: var(--bg-secondary);
        color: var(--text-secondary);
        border-radius: 999px;
        padding: 6px 10px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
    }

    .ops-drawer-tab.active {
        background: var(--primary-color);
        border-color: var(--primary-color);
        color: #fff;
    }

    .ops-drawer-body {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        padding: 18px 20px;
        overscroll-behavior: contain;
    }

    .ops-drawer-panel {
        display: none;
    }

    .ops-drawer-panel[hidden] {
        display: none;
    }

    .ops-drawer-panel.active {
        display: block;
    }

    .ops-drawer-content {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .ops-data-card {
        border: 1px solid var(--border-color);
        border-radius: 10px;
        background: var(--bg-secondary);
        padding: 12px;
    }

    .ops-data-label {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        color: var(--text-muted);
        margin-bottom: 4px;
        font-weight: 700;
    }

    .ops-data-value {
        color: var(--text-primary);
        font-size: 13px;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .ops-drawer-footer {
        border-top: 1px solid var(--border-color);
        padding: 14px 20px 18px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
    }

    body.ops-modal-open {
        overflow: hidden;
    }

    .empty-state-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .empty-state-clear-btn {
        border: 1px solid var(--border-color);
        background: var(--bg-secondary);
        color: var(--text-primary);
    }

    @media (max-width: 1100px) {
        .ops-board {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 768px) {
        .ops-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .ops-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ops-drawer {
            width: calc(100vw - 1rem);
            max-height: calc(100vh - 1rem);
            min-height: min(520px, calc(100vh - 1rem));
            border-radius: 16px;
        }

        .ops-drawer-header,
        .ops-drawer-tabs,
        .ops-drawer-body,
        .ops-drawer-footer {
            padding-left: 16px;
            padding-right: 16px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .skip-link,
        .header-actions .btn,
        .view-btn,
        .action-btn,
        .agent-card,
        .source-filter-btn,
        .ops-mode-btn,
        .ops-icon-btn,
        .ops-enable-switch,
        .ops-enable-switch::after,
        .ops-agent-card,
        .ops-drawer {
            transition: none !important;
        }

        .ops-agent-card:hover,
        .agent-card:hover {
            transform: none;
        }
    }
</style>

<body class="bg-light agents-page">
    <a class="skip-link" href="#agents-main">Skip to Main Content</a>
    <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

    <!-- Navigation -->
    {{template "navbar.tmpl" .}}

    <div class="main-content-wrapper">
        {{template "sidebar.tmpl" .}}

        <main class="main-content" id="agents-main" role="main" aria-labelledby="agents-title">
    <div class="agents-container">
        <div class="page-header">
            <div class="page-title">
                <h1 id="agents-title">Agents Dashboard</h1>
                <p>Monitor health, start chats, and fix configuration issues.</p>
            </div>
            <div class="header-actions">
                <a class="btn btn-primary" href="/agents/create">
                    <span>+</span> New Agent
                </a>
            </div>
        </div>

        <div class="ops-shell">
            <div class="ops-toolbar modern-card">
                <div class="ops-search-wrap">
                    <label for="searchInput" class="visually-hidden">Search agents</label>
                    <input type="search" id="searchInput" name="agent_search" class="ops-search" placeholder="Search by name or purpose…" autocomplete="off" spellcheck="false" aria-describedby="searchInputHelp">
                    <p id="searchInputHelp" class="ops-search-help">Filter by agent name or stated purpose.</p>
                </div>
                <div class="ops-mode" role="group" aria-label="View mode">
                    <button id="modeOperationsBtn" class="ops-mode-btn active" type="button">Operations</button>
                    <button id="modeConfigBtn" class="ops-mode-btn" type="button">Config</button>
                </div>
            </div>

            <div class="ops-summary">
                <div class="ops-summary-chip">
                    <span class="ops-summary-label">Needs Attention</span>
                    <span id="countNeedsAttention" class="ops-summary-value">0</span>
                </div>
                <div class="ops-summary-chip">
                    <span class="ops-summary-label">Ready</span>
                    <span id="countReady" class="ops-summary-value">0</span>
                </div>
                <div class="ops-summary-chip">
                    <span class="ops-summary-label">Disabled</span>
                    <span id="countDisabled" class="ops-summary-value">0</span>
                </div>
                <div class="ops-summary-chip">
                    <span class="ops-summary-label">Total</span>
                    <span id="countTotal" class="ops-summary-value">0</span>
                </div>
            </div>

            <div id="healthMessage" class="ops-health-message hidden" role="status" aria-live="polite"></div>

            <div id="loadingState" class="loading" role="status" aria-live="polite">
                <p>Loading agents…</p>
            </div>

            <div id="opsBoard" class="ops-board hidden">
                <section class="ops-column ops-column-alert">
                    <header class="ops-column-header">
                        <h3>Needs Attention</h3>
                        <span id="bucketNeedsAttentionCount" class="ops-column-count">0</span>
                    </header>
                    <div id="bucketNeedsAttention" class="ops-list"></div>
                </section>

                <section class="ops-column ops-column-ready">
                    <header class="ops-column-header">
                        <h3>Agents</h3>
                        <span id="bucketReadyCount" class="ops-column-count">0</span>
                    </header>
                    <div id="bucketReady" class="ops-list"></div>
                </section>
            </div>

            <div id="emptyState" class="empty-state hidden">
                <h3 id="emptyStateTitle">No agents found</h3>
                <p id="emptyStateMessage">Create your first agent to get started.</p>
                <div class="empty-state-actions">
                    <button id="emptyStateClearBtn" type="button" class="btn empty-state-clear-btn hidden">Clear Search</button>
                    <a id="emptyStateCreateLink" class="btn btn-primary" href="/agents/create">Create Agent</a>
                </div>
            </div>
        </div>
    </div>
        </main>
    </div>

    <div id="agentDrawerBackdrop" class="ops-drawer-backdrop hidden" aria-hidden="true"></div>
    <section id="agentDrawer" class="ops-drawer" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="drawerAgentName" tabindex="-1">
        <div class="ops-drawer-header">
            <div>
                <p class="ops-drawer-kicker">Agent Details</p>
                <h2 id="drawerAgentName">Select an agent</h2>
            </div>
            <button id="closeDrawerBtn" class="ops-drawer-close" type="button" aria-label="Close details modal">×</button>
        </div>
        <div class="ops-drawer-tabs" role="tablist" aria-label="Agent detail sections">
            <button id="drawerOverviewTabBtn" class="ops-drawer-tab active" type="button" role="tab" aria-selected="true" aria-controls="drawerOverviewTab" data-tab="overview">Overview</button>
            <button id="drawerToolsTabBtn" class="ops-drawer-tab" type="button" role="tab" aria-selected="false" aria-controls="drawerToolsTab" data-tab="tools" tabindex="-1">Tools</button>
            <button id="drawerAdvancedTabBtn" class="ops-drawer-tab" type="button" role="tab" aria-selected="false" aria-controls="drawerAdvancedTab" data-tab="advanced" tabindex="-1">Advanced</button>
        </div>
        <div class="ops-drawer-body">
            <section id="drawerOverviewTab" class="ops-drawer-panel active" role="tabpanel" aria-labelledby="drawerOverviewTabBtn" tabindex="0">
                <div id="drawerOverviewContent" class="ops-drawer-content"></div>
            </section>
            <section id="drawerToolsTab" class="ops-drawer-panel" role="tabpanel" aria-labelledby="drawerToolsTabBtn" tabindex="0" hidden>
                <div id="drawerToolsContent" class="ops-drawer-content"></div>
            </section>
            <section id="drawerAdvancedTab" class="ops-drawer-panel" role="tabpanel" aria-labelledby="drawerAdvancedTabBtn" tabindex="0" hidden>
                <div id="drawerAdvancedContent" class="ops-drawer-content"></div>
            </section>
        </div>
        <div class="ops-drawer-footer">
            <a id="drawerEditLink" class="modern-btn modern-btn-primary" href="/agents">Open Agent Page</a>
        </div>
    </section>

    <!-- Shared Modals (Add Agent, Marketplace, etc.) -->
    {{template "modals.tmpl" .}}
    {{template "session-modals.tmpl" .}}
    {{template "chat-area.tmpl" .}}

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <!-- DX Utilities -->
    <script src="/js/utils/logger.js"></script>
    <script src="/js/utils/event-bus.js"></script>
    <script src="/js/utils/api-client.js"></script>
    <script src="/js/utils/dom-utils.js"></script>
    <script src="/js/modules/toast.js"></script>
    <script src="/js/modules/workspace-bootstrap-review.js"></script>
    <script src="/js/modules/workspace-group-options.js"></script>
    <script src="/js/modules/sessions.js"></script>
    <script src="/js/app.js"></script>
    <script src="/js/modules/agents.js"></script>
    <script src="/js/modules/sidebar.js"></script>
    <script src="/js/modules/themeManager.js"></script>
    <script src="/js/modules/external-agents.js"></script>
    <script>
        // Initialize theme on page load
        document.addEventListener('DOMContentLoaded', function() {
            themeManager.initialize();
        });
    </script>
    <script src="/js/agents-dashboard.js"></script>
</body>
</html>
