{{define "action-center"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}
<body class="bg-light action-center-page">
  {{template "navbar.tmpl" .}}
  <div class="main-content-wrapper">
    <main class="main-content">
      <div class="container-fluid py-4">
        <header class="ui-page-header">
          <div><h1>Action Center</h1><p>Review workspace findings, then open, snooze, resolve or dismiss.</p></div>
          <div class="ui-page-actions"><button id="action-center-refresh" class="modern-btn modern-btn-secondary" type="button" title="Refresh findings" aria-label="Refresh findings">Refresh</button></div>
        </header>
        <div class="ui-toolbar action-center-toolbar" aria-label="Finding filters">
          <div><label for="action-center-status-filter" class="form-label">Status</label><select id="action-center-status-filter" aria-label="Finding status" class="form-select">
            <option value="">Active (ready for triage)</option><option value="new">New only</option><option value="snoozed">Snoozed only</option><option value="resolved">Resolved</option><option value="dismissed">Dismissed</option><option value="planned">Planned</option><option value="all">All</option>
          </select></div>
          <div><label for="action-center-sort" class="form-label">Sort</label><select id="action-center-sort" aria-label="Sort findings" class="form-select"><option value="priority">Sort: priority</option><option value="recency">Sort: recency</option></select></div>
        </div>
        <div id="action-center-filter-banner" style="display: none;" role="status"></div>
        <section id="action-center-library" class="action-center-library" aria-labelledby="action-center-library-title" hidden>
          <h2 id="action-center-library-title" class="action-center-library-title">Home libraries</h2>
          <p class="action-center-library-intro">A scan found projects ready for setup review, or a Manager left suggestions. Review them on the Home’s own shelf; nothing here changes a library.</p>
          <div id="action-center-library-cards" class="action-center-library-cards"></div>
        </section>
        <div id="action-center-status" tabindex="-1" aria-live="polite">Loading findings…</div>
        <section id="action-center-results" aria-label="Findings" aria-busy="true">
          <div id="action-center-error" class="ui-section p-3 mb-3" hidden>
            <h2>Unable to load findings</h2><p>Your findings have not been cleared. Check your connection and try again.</p><button id="action-center-retry" type="button" class="modern-btn modern-btn-secondary">Retry</button>
          </div>
          <p id="action-center-retained" hidden></p>
          <div id="action-center-empty" class="ui-section text-center p-4" hidden></div>
          <div id="action-center-list" hidden></div>
        </section>
      </div>
    </main>
  </div>
  <div class="modal fade" id="action-center-dismiss-modal" tabindex="-1" aria-labelledby="action-center-dismiss-title" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title" id="action-center-dismiss-title">Dismiss finding</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body">
        <p>Why are you dismissing this finding? You can still find it in the Dismissed view.</p>
        <div class="form-check"><input class="form-check-input" type="radio" name="action-center-dismiss-reason" id="dismiss-not-useful" value="not_useful" checked><label class="form-check-label" for="dismiss-not-useful">Not useful</label></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="action-center-dismiss-reason" id="dismiss-duplicate" value="duplicate"><label class="form-check-label" for="dismiss-duplicate">Duplicate of something I've seen</label></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="action-center-dismiss-reason" id="dismiss-out-of-scope" value="out_of_scope"><label class="form-check-label" for="dismiss-out-of-scope">Out of scope</label></div>
        <div class="form-check"><input class="form-check-input" type="radio" name="action-center-dismiss-reason" id="dismiss-other" value="other"><label class="form-check-label" for="dismiss-other">Other</label></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-danger" id="action-center-dismiss-confirm">Dismiss</button></div>
    </div></div>
  </div>
  <div class="modal fade" id="action-center-snooze-modal" tabindex="-1" aria-labelledby="action-center-snooze-title" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title" id="action-center-snooze-title">Snooze finding</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body">
        <p>When should this come back?</p>
        <div class="d-grid gap-2"><button type="button" class="btn btn-secondary" data-snooze-preset="tomorrow">Tomorrow at 9am</button><button type="button" class="btn btn-secondary" data-snooze-preset="next_week">Next week</button><button type="button" class="btn btn-secondary" data-snooze-preset="next_month">Next month</button></div>
        <hr><label for="action-center-snooze-custom" class="form-label">Custom date</label><input type="datetime-local" class="form-control" id="action-center-snooze-custom" aria-describedby="action-center-snooze-error"><div id="action-center-snooze-error" class="ui-field-error" role="alert" hidden></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="action-center-snooze-custom-go">Snooze until selected time</button></div>
    </div></div>
  </div>
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/app.js?v=1694538177"></script>
  <script defer src="/js/modules/agents.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "theme-init.tmpl" .}}
  <script defer src="/js/modules/action-center.js"></script>
</body>
</html>
{{end}}
