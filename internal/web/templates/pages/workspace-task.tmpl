      padding-left: 1.1rem;
    }

    .workspace-task-review-warning {
      border: 1px solid color-mix(in srgb, #f59e0b 36%, var(--border-color));
      border-radius: 8px;
      background: color-mix(in srgb, #f59e0b 10%, var(--bg-primary));
      color: var(--text-primary);
      font-size: 0.86rem;
      line-height: 1.4;
      padding: 0.65rem 0.75rem;
    }

    .workspace-task-review-editor {
      display: grid;
      gap: 0.35rem;
      color: var(--text-secondary);
      font-size: 0.82rem;
      font-weight: 700;
    }

    .workspace-task-review-editor textarea {
      width: 100%;
      min-height: 9rem;
      border: 1px solid var(--border-color);
      border-radius: 12px;
      background: var(--bg-primary);
      color: var(--text-primary);
      padding: 0.75rem;
      font: 0.86rem/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      resize: vertical;
