    .workspace-task-page-agent-picker.is-unavailable {
      border-color: rgba(248, 113, 113, 0.45);
      background: rgba(248, 113, 113, 0.08);
    }

    .workspace-task-page-tabs {
      display: inline-flex;
      gap: 0.35rem;
      padding: 0.35rem;
      border-radius: 14px;
      background: color-mix(in srgb, var(--bg-secondary) 88%, transparent);
      border: 1px solid var(--border-color);
      width: fit-content;
    }

    .workspace-task-page-tab {
      appearance: none;
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-secondary);
      font-size: 0.85rem;
      font-weight: 600;
      padding: 0.5rem 1rem;
      border-radius: 10px;
      cursor: pointer;
      transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    }

    .workspace-task-page-tab:hover {
      color: var(--text-primary);
    }

    .workspace-task-page-tab.is-active {
      background: var(--bg-primary);
      border-color: var(--border-color);
      color: var(--text-primary);
      box-shadow: 0 1px 2px rgba(0, 0, 0, 0.06);
    }

    .workspace-task-page-tab-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 1.3rem;
      padding: 0 0.35rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--text-secondary) 18%, transparent);
      color: var(--text-secondary);
      font-size: 0.68rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .workspace-task-page-tab.is-active .workspace-task-page-tab-count {
      background: color-mix(in srgb, var(--primary-color) 22%, transparent);
      color: var(--primary-color);
    }

    .workspace-task-tab-pane {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .workspace-task-tab-pane[hidden] {
      display: none !important;
    }

    .workspace-task-tab-empty {
      padding: 1.5rem;
      text-align: center;
      color: var(--text-secondary);
    }

    .workspace-task-tab-empty-copy {
      margin: 0;
      font-size: 0.9rem;
    }

    .workspace-task-page-card {
      position: relative;
      padding: 1.3rem 1.35rem;
      border-radius: 28px;
      border: 1px solid color-mix(in srgb, var(--border-color) 86%, transparent);
      background:
        linear-gradient(180deg, color-mix(in srgb, var(--bg-secondary) 82%, transparent), color-mix(in srgb, var(--bg-primary) 94%, transparent));
      box-shadow: 0 18px 38px rgba(10, 10, 10, 0.08);
      overflow: hidden;
    }

    .workspace-task-page-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(120deg, color-mix(in srgb, var(--primary-color) 8%, transparent), transparent 45%);
      pointer-events: none;
      opacity: 0.9;
    }

    .workspace-task-page-card > * {
      position: relative;
      z-index: 1;
    }

    .workspace-task-page-card-compact {
      padding-bottom: 1rem;
    }

    .workspace-task-page-card-header {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .workspace-task-page-card-header.is-output-menu-open {
      z-index: 1080;
    }

    .workspace-task-page-card-header h2 {
      margin: 0.28rem 0 0;
      font-family: "Fraunces", serif;
      font-size: 1.35rem;
      color: var(--text-primary);
    }

    .workspace-task-output-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.5rem;
      flex-wrap: wrap;
    }

    .workspace-task-output-action-btn {
      min-height: 2.35rem;
      gap: 0.42rem;
      white-space: nowrap;
    }

    .workspace-task-output-action-btn.is-saved {
      border-color: color-mix(in srgb, #16a34a 34%, var(--border-color));
      background: color-mix(in srgb, #16a34a 12%, var(--bg-primary));
      color: color-mix(in srgb, #16a34a 82%, var(--text-primary));
    }

    /* Overflow popover for the demoted Result actions (Copy, Create Skill,
       Create Workflow Task). Positions relative to the toggle, anchored to
       the right edge so it doesn't run off-screen on narrow viewports. */
    .workspace-task-output-overflow {
      position: relative;
      display: inline-flex;
    }

    .workspace-task-output-overflow-toggle {
      min-width: 2.35rem;
      padding-inline: 0.7rem;
      justify-content: center;
    }

    .workspace-task-output-overflow-toggle i {
      font-size: 1.05rem;
      line-height: 1;
    }

    /* position: fixed lifts the popover out of the parent card's
       overflow: hidden clipping context (the card sets that so its ::before
       gradient stays within the rounded corners). JS sets top/left from the
       toggle's bounding rect on open, and closes the menu on scroll/resize
       so the position can't drift. */
    .workspace-task-output-overflow-menu {
      position: fixed;
      z-index: 1080;
      min-width: 14rem;
      display: flex;
      flex-direction: column;
      padding: 0.35rem;
      border-radius: 14px;
      border: 1px solid var(--border-color);
      background: var(--bg-primary);
      box-shadow: 0 18px 38px rgba(10, 10, 10, 0.18);
    }

    .workspace-task-output-overflow-item {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.7rem;
      border: 0;
      border-radius: 10px;
      background: transparent;
      color: var(--text-primary);
      font-size: 0.88rem;
      font-weight: 600;
      text-align: left;
      cursor: pointer;
      transition: background 0.14s ease, color 0.14s ease;
    }

    .workspace-task-output-overflow-item i {
      flex: 0 0 1.1rem;
      color: var(--text-secondary);
    }

    .workspace-task-output-overflow-item:hover,
    .workspace-task-output-overflow-item:focus-visible {
      background: color-mix(in srgb, var(--primary-color) 10%, var(--bg-primary));
      color: var(--primary-color);
      outline: none;
    }

    .workspace-task-output-overflow-item:hover i,
    .workspace-task-output-overflow-item:focus-visible i {
      color: var(--primary-color);
    }

    .workspace-task-output-overflow-item:disabled {
      opacity: 0.5;
      pointer-events: none;
    }

    .workspace-task-output-note-status {
      margin: -0.15rem 0 0.95rem;
      padding: 0.72rem 0.85rem;
      border: 1px solid color-mix(in srgb, #16a34a 26%, var(--border-color));
      border-radius: 16px;
      background: color-mix(in srgb, #16a34a 8%, var(--bg-primary));
      color: var(--text-primary);
    }

    .workspace-task-output-note-status-inner {
      display: flex;
      align-items: center;
