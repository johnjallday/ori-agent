      padding: 0.85rem 1rem;
      border-radius: 16px;
      border: 1px solid color-mix(in srgb, var(--primary-color) 28%, var(--border-color));
      background: color-mix(in srgb, var(--bg-secondary) 86%, transparent);
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
