    .workspace-task-related-link-title {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }

    /*
     * Status dot: a small filled circle on each related-task link, colored
     * by the same lifecycle palette as the hub status pills. Lets a user
     * read the completion state of every adjacent node in the dependency
     * graph at a glance without scanning the meta line.
     */
    .workspace-task-related-link-dot {
      flex: 0 0 auto;
      width: 0.55rem;
      height: 0.55rem;
      border-radius: 999px;
      background: var(--text-muted);
      box-shadow: 0 0 0 2px color-mix(in srgb, var(--bg-primary) 70%, transparent);
    }
    .workspace-task-related-link-dot[data-state="completed"] { background: #16a34a; }
    .workspace-task-related-link-dot[data-state="in_progress"],
    .workspace-task-related-link-dot[data-state="assigned"] { background: #2563eb; }
    .workspace-task-related-link-dot[data-state="failed"] { background: #dc2626; }
    .workspace-task-related-link-dot[data-state="pending"] { background: #ca8a04; }
    .workspace-task-related-link-dot[data-state="blocked"],
    .workspace-task-related-link-dot[data-state="waiting_for_choice"] { background: #d97706; }
    .workspace-task-related-link-dot[data-state="cancelled"],
    .workspace-task-related-link-dot[data-state="skipped"] { background: #94a3b8; }
    .workspace-task-related-link-dot[data-state="timeout"] { background: #b91c1c; }

    [data-bs-theme="dark"] .workspace-task-related-link-dot[data-state="completed"] { background: #4ade80; }
    [data-bs-theme="dark"] .workspace-task-related-link-dot[data-state="in_progress"],
    [data-bs-theme="dark"] .workspace-task-related-link-dot[data-state="assigned"] { background: #93c5fd; }
