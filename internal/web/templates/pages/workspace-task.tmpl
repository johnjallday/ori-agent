    .workspace-task-page-status[data-state="completed"] {
      color: #157347;
      border-color: rgba(21, 115, 71, 0.25);
      background: rgba(21, 115, 71, 0.12);
    }
    .workspace-task-page-status[data-state="completed"]::before { content: "✓"; }

    .workspace-task-page-status[data-state="in_progress"] {
      color: #0c63e7;
      border-color: rgba(12, 99, 231, 0.24);
      background: rgba(12, 99, 231, 0.12);
    }
    .workspace-task-page-status[data-state="in_progress"]::before { content: "▶"; }

    .workspace-task-page-status[data-state="blocked"] {
      color: #b26f00;
      border-color: rgba(178, 111, 0, 0.28);
      background: rgba(178, 111, 0, 0.14);
    }
    .workspace-task-page-status[data-state="blocked"]::before { content: "⚠"; }

    .workspace-task-page-status[data-state="failed"] {
      color: #c23b3b;
      border-color: rgba(194, 59, 59, 0.26);
      background: rgba(194, 59, 59, 0.12);
    }
    .workspace-task-page-status[data-state="failed"]::before { content: "✕"; }

    .workspace-task-page-status[data-state="cancelled"],
    .workspace-task-page-status[data-state="skipped"] {
      color: #64748b;
      border-color: rgba(100, 116, 139, 0.24);
      background: rgba(138, 138, 138, 0.12);
    }
    .workspace-task-page-status[data-state="cancelled"]::before { content: "⊘"; }
    .workspace-task-page-status[data-state="skipped"]::before { content: "⤳"; }

    .workspace-task-page-status[data-state="timeout"] {
      color: #7f1d1d;
      border-color: rgba(127, 29, 29, 0.32);
      background: rgba(220, 38, 38, 0.14);
    }
    .workspace-task-page-status[data-state="timeout"]::before { content: "⏱"; }

    /*
     * Dark-theme overrides for the hero status pill. The base rules above use
     * deep saturated text (e.g. #157347) tuned for the light --bg-primary; on
     * the dark canvas the same hex collapses to ~1.4:1 against the tinted
     * pill background. The tints are kept (so the pill still reads as a
     * green/blue/orange chip) and the text is lifted to a Tailwind-300/400
     * shade that lands ≥4.5:1 against the composited surface.
     */
    [data-bs-theme="dark"] .workspace-task-page-status[data-state="completed"] {
      color: #4ade80;
      border-color: rgba(74, 222, 128, 0.45);
      background: rgba(34, 197, 94, 0.22);
    }
    [data-bs-theme="dark"] .workspace-task-page-status[data-state="in_progress"] {
      color: #93c5fd;
      border-color: rgba(147, 197, 253, 0.45);
      background: rgba(59, 130, 246, 0.22);
    }
    [data-bs-theme="dark"] .workspace-task-page-status[data-state="blocked"] {
      color: #fcd34d;
      border-color: rgba(252, 211, 77, 0.45);
      background: rgba(245, 158, 11, 0.22);
    }
    [data-bs-theme="dark"] .workspace-task-page-status[data-state="failed"] {
      color: #fca5a5;
      border-color: rgba(252, 165, 165, 0.45);
      background: rgba(239, 68, 68, 0.22);
    }
    [data-bs-theme="dark"] .workspace-task-page-status[data-state="cancelled"],
    [data-bs-theme="dark"] .workspace-task-page-status[data-state="skipped"] {
      color: #cbd5e1;
      border-color: rgba(201, 204, 209, 0.4);
      background: rgba(138, 138, 138, 0.22);
