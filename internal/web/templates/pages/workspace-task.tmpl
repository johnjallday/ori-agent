          <div id="workspace-task-schedule-error" class="workspace-task-schedule-alert" hidden></div>
          <div class="workspace-task-schedule-form">
            <div class="workspace-task-schedule-enable-row">
              <div class="workspace-task-schedule-enable-copy">
                <div class="workspace-task-schedule-enable-title">Enable recurring runs</div>
                <div class="workspace-task-schedule-enable-subtitle">Pause keeps the schedule saved but prevents future runs.</div>
              </div>
              <input type="checkbox" id="workspace-task-schedule-enabled" class="form-check-input workspace-task-schedule-switch" role="switch" checked aria-label="Enable scheduled runs">
            </div>

            <div class="workspace-task-schedule-field">
              <label for="workspace-task-schedule-name" class="form-label">Schedule name</label>
              <input type="text" id="workspace-task-schedule-name" class="form-control" autocomplete="off" placeholder="Daily report">
            </div>

            <div class="workspace-task-schedule-field-grid">
              <div class="workspace-task-schedule-field">
                <label for="workspace-task-schedule-type" class="form-label">Repeat</label>
                <select id="workspace-task-schedule-type" class="form-select">
                  <option value="daily">Daily</option>
                  <option value="weekdays">Weekdays</option>
                  <option value="weekly">Weekly</option>
                  <option value="interval">Every interval</option>
                  <option value="once">Once</option>
                  <option value="cron">Advanced cron</option>
                </select>
              </div>

              <div id="workspace-task-schedule-time-field" class="workspace-task-schedule-field">
                <label for="workspace-task-schedule-time" id="workspace-task-schedule-time-label" class="form-label">Time of day</label>
                <input type="time" id="workspace-task-schedule-time" class="form-control" value="09:00">
              </div>

              <div id="workspace-task-schedule-day-field" class="workspace-task-schedule-field" hidden>
                <label for="workspace-task-schedule-day" class="form-label">Day</label>
                <select id="workspace-task-schedule-day" class="form-select">
                  <option value="0">Sunday</option>
                  <option value="1">Monday</option>
                  <option value="2">Tuesday</option>
                  <option value="3">Wednesday</option>
                  <option value="4">Thursday</option>
                  <option value="5">Friday</option>
                  <option value="6">Saturday</option>
                </select>
              </div>

              <div id="workspace-task-schedule-interval-field" class="workspace-task-schedule-field" hidden>
                <label class="form-label" for="workspace-task-schedule-interval-value">Interval</label>
                <div class="workspace-task-schedule-inline">
                  <input type="number" id="workspace-task-schedule-interval-value" class="form-control" min="1" value="1" inputmode="numeric">
                  <select id="workspace-task-schedule-interval-unit" class="form-select">
                    <option value="minutes">Minutes</option>
                    <option value="hours" selected>Hours</option>
                    <option value="days">Days</option>
                  </select>
                </div>
              </div>

              <div id="workspace-task-schedule-once-field" class="workspace-task-schedule-field" hidden>
                <label for="workspace-task-schedule-once" class="form-label">Run at</label>
                <input type="datetime-local" id="workspace-task-schedule-once" class="form-control">
              </div>

              <div id="workspace-task-schedule-cron-field" class="workspace-task-schedule-field" hidden>
                <label for="workspace-task-schedule-cron" class="form-label">Cron expression</label>
                <input type="text" id="workspace-task-schedule-cron" class="form-control" autocomplete="off" placeholder="0 9 * * *">
              </div>
            </div>

            <div class="workspace-task-schedule-subsection">
              <div class="workspace-task-schedule-subsection-title">Sleep Handling</div>
              <div class="workspace-task-schedule-field">
                <label for="workspace-task-schedule-sleep-policy" class="form-label">When Ori was asleep</label>
                <select id="workspace-task-schedule-sleep-policy" class="form-select">
                  <option value="run_once_on_wake">Run once when Ori wakes</option>
                  <option value="skip">Skip missed runs</option>
                </select>
              </div>

              <div class="workspace-task-schedule-enable-row">
                <div class="workspace-task-schedule-enable-copy">
                  <div class="workspace-task-schedule-enable-title">Wake this Mac before the task runs</div>
                  <div class="workspace-task-schedule-enable-subtitle">Ori programs the next macOS wake event for the earliest wake-enabled task.</div>
                </div>
                <input type="checkbox" id="workspace-task-schedule-wake-mac" class="form-check-input workspace-task-schedule-switch" role="switch" aria-label="Wake this Mac before scheduled runs">
              </div>

              <div id="workspace-task-schedule-wake-fields" class="workspace-task-schedule-field-grid">
                <div class="workspace-task-schedule-field">
                  <label for="workspace-task-schedule-wake-lead" class="form-label">Wake before run</label>
                  <div class="workspace-task-schedule-inline">
                    <input type="number" id="workspace-task-schedule-wake-lead" class="form-control" min="1" max="120" value="5" inputmode="numeric">
                    <span class="workspace-task-schedule-permission-note">minutes</span>
                  </div>
                </div>
                <div class="workspace-task-schedule-field">
                  <label for="workspace-task-schedule-wake-fallback" class="form-label">If wake fails</label>
                  <select id="workspace-task-schedule-wake-fallback" class="form-select">
                    <option value="run_on_next_wake">Run once when Ori wakes later</option>
                    <option value="skip">Skip the missed run</option>
                  </select>
                </div>
              </div>
              <div id="workspace-task-schedule-wake-permission" class="workspace-task-schedule-permission-note"></div>
            </div>

            <div id="workspace-task-schedule-preview" class="workspace-task-schedule-preview"></div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" id="workspace-task-schedule-remove" class="btn btn-outline-danger me-auto">Remove Schedule</button>
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="workspace-task-schedule-submit" class="btn btn-primary d-inline-flex align-items-center gap-2">
            <i class="bi bi-calendar-check" aria-hidden="true"></i>
            <span>Save Schedule</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="workspace-task-result-promote-modal" tabindex="-1" aria-labelledby="workspace-task-result-promote-heading" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h5 class="modal-title" id="workspace-task-result-promote-heading">Create Workflow Task</h5>
            <div id="workspace-task-result-promote-meta" class="workspace-task-result-promote-meta"></div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="workspace-task-result-promote-field">
            <label for="workspace-task-result-promote-title" class="form-label">Parent Task</label>
            <input type="text" class="form-control" id="workspace-task-result-promote-title" autocomplete="off">
          </div>
          <div class="workspace-task-result-promote-subtasks-label">Subtasks</div>
          <div id="workspace-task-result-promote-groups" class="workspace-task-result-promote-groups"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="workspace-task-result-promote-submit">Create</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="workspace-task-skill-modal" tabindex="-1" aria-labelledby="workspace-task-skill-heading" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h5 class="modal-title" id="workspace-task-skill-heading">Create Skill From Task</h5>
            <div id="workspace-task-skill-meta" class="workspace-task-skill-meta"></div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="workspace-task-skill-error" class="workspace-task-skill-alert" hidden></div>
          <div class="workspace-task-skill-form">
            <div class="workspace-task-skill-grid">
              <div class="workspace-task-skill-field">
                <label for="workspace-task-skill-agent" class="form-label">Agent</label>
                <input type="text" class="form-control" id="workspace-task-skill-agent" readonly>
              </div>
              <div class="workspace-task-skill-field">
                <label for="workspace-task-skill-name" class="form-label">Skill name</label>
                <input type="text" class="form-control" id="workspace-task-skill-name" autocomplete="off" maxlength="64" placeholder="check-pollen-count">
              </div>
            </div>

            <div class="workspace-task-skill-field">
              <label for="workspace-task-skill-description" class="form-label">Description</label>
              <input type="text" class="form-control" id="workspace-task-skill-description" autocomplete="off" maxlength="1024">
            </div>

            <div class="workspace-task-skill-field">
              <div class="workspace-task-skill-prompt-row">
                <label for="workspace-task-skill-prompt" class="form-label">Generated prompt</label>
                <button type="button" id="workspace-task-skill-generate" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-2">
                  <i class="bi bi-stars" aria-hidden="true"></i>
                  <span>Regenerate With AI</span>
                </button>
              </div>
              <textarea class="form-control" id="workspace-task-skill-prompt" rows="14" spellcheck="false"></textarea>
              <p class="workspace-task-skill-help">Review the prompt before saving. The new skill is enabled for this agent immediately.</p>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" id="workspace-task-skill-submit">
            <i class="bi bi-magic" aria-hidden="true"></i>
            <span>Create Skill</span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="workspace-task-result-research-modal" tabindex="-1" aria-labelledby="workspace-task-result-research-heading" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <div>
            <h5 class="modal-title" id="workspace-task-result-research-heading">Research Follow-up</h5>
            <div id="workspace-task-result-research-section-meta" class="workspace-task-result-research-meta"></div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="workspace-task-result-research-grid">
            <div class="workspace-task-result-research-main">
              <div class="workspace-task-result-research-field">
                <label for="workspace-task-result-research-title" class="form-label">Task title</label>
                <input type="text" class="form-control" id="workspace-task-result-research-title" autocomplete="off">
              </div>
              <div class="workspace-task-result-research-field">
                <label for="workspace-task-result-research-agent" class="form-label">Agent</label>
                <select id="workspace-task-result-research-agent" class="form-select"></select>
              </div>
              <div class="workspace-task-result-research-field">
                <label for="workspace-task-result-research-details" class="form-label">Instructions</label>
                <textarea class="form-control" id="workspace-task-result-research-details" rows="11"></textarea>
              </div>
            </div>
            <aside class="workspace-task-result-research-side">
              <div class="workspace-task-result-research-switches">
                <label class="workspace-task-result-research-check" for="workspace-task-result-research-link-source">
                  <input type="checkbox" id="workspace-task-result-research-link-source" checked>
                  <span>Link original result as input context</span>
                </label>
                <label class="workspace-task-result-research-check" for="workspace-task-result-research-run-now">
                  <input type="checkbox" id="workspace-task-result-research-run-now" checked>
                  <span>Run immediately</span>
                </label>
                <label class="workspace-task-result-research-check" for="workspace-task-result-research-open-after-create">
                  <input type="checkbox" id="workspace-task-result-research-open-after-create" checked>
                  <span>Open follow-up task after creation</span>
                </label>
              </div>
              <div class="workspace-task-result-research-field">
                <label for="workspace-task-result-research-section-text" class="form-label">Selected section</label>
                <textarea class="form-control workspace-task-result-research-section-preview" id="workspace-task-result-research-section-text" rows="16"></textarea>
              </div>
            </aside>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2" id="workspace-task-result-research-submit">
            <i class="bi bi-send" aria-hidden="true"></i>
            <span>Create & Run</span>
          </button>
        </div>
      </div>
    </div>
  </div>

