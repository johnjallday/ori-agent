      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.55;
      margin-top: 0.22rem;
    }

    .workspace-task-assist-review-list {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .workspace-task-assist-review-item {
      padding: 0.85rem 0.95rem;
      border-radius: 18px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 96%, transparent);
    }

    .workspace-task-assist-review-item.is-answered {
      border-color: color-mix(in srgb, #157347 24%, var(--border-color));
      background: color-mix(in srgb, #157347 4%, var(--bg-primary));
    }

    .workspace-task-assist-review-item-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .workspace-task-assist-review-item-title {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 0.55rem;
      color: var(--text-primary);
      font-size: 0.9rem;
      font-weight: 700;
      line-height: 1.45;
    }

    .workspace-task-assist-review-item-number {
      width: 1.7rem;
      height: 1.7rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent-gold, #d3a94f) 18%, transparent);
      color: color-mix(in srgb, var(--accent-gold, #d3a94f) 88%, var(--text-primary));
      font-size: 0.72rem;
      font-weight: 800;
      flex-shrink: 0;
    }

    .workspace-task-assist-review-edit {
      border: none;
      background: none;
      color: var(--primary-color);
      font-size: 0.82rem;
      font-weight: 800;
      padding: 0;
      white-space: nowrap;
    }

    .workspace-task-assist-review-edit:hover {
      text-decoration: underline;
    }

    .workspace-task-assist-review-answer {
      margin-top: 0.5rem;
      color: var(--text-primary);
      font-size: 0.88rem;
      line-height: 1.6;
      padding-left: 2.25rem;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .workspace-task-assist-review-answer.is-empty {
      color: var(--text-secondary);
      font-style: italic;
    }

    .workspace-task-assist-field {
      padding: 0.95rem 1rem;
      border-radius: 20px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    }

    .workspace-task-assist-field.is-active {
      border-color: color-mix(in srgb, var(--primary-color) 36%, var(--border-color));
      box-shadow: 0 14px 30px rgba(15, 23, 42, 0.07);
    }

    .workspace-task-assist-field-question {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.7rem;
      align-items: start;
      margin-bottom: 0.75rem;
    }

    .workspace-task-assist-field-number {
      width: 1.9rem;
      height: 1.9rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--primary-color) 16%, transparent);
      color: var(--primary-color);
      font-size: 0.76rem;
      font-weight: 800;
    }

    .workspace-task-assist-field-prompt {
      color: var(--text-primary);
      font-weight: 700;
      line-height: 1.5;
    }

    .workspace-task-assist-field-hint,
    .workspace-task-assist-field-evidence {
      margin-top: 0.25rem;
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .workspace-task-assist-field-evidence {
      color: color-mix(in srgb, var(--primary-color) 74%, var(--text-secondary));
    }

    .workspace-task-assist-option-group {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .workspace-task-assist-option {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      background: none;
      text-align: left;
      cursor: pointer;
    }

    .workspace-task-assist-option-input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .workspace-task-assist-option-card {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.7rem;
      align-items: start;
      padding: 0.8rem 0.9rem;
      border-radius: 18px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 96%, transparent);
      transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
    }

    .workspace-task-assist-option:hover .workspace-task-assist-option-card {
      transform: translateY(-1px);
      border-color: color-mix(in srgb, var(--primary-color) 34%, var(--border-color));
    }

    .workspace-task-assist-option.is-selected .workspace-task-assist-option-card,
    .workspace-task-assist-option-input:checked + .workspace-task-assist-option-card {
      border-color: color-mix(in srgb, var(--primary-color) 46%, var(--border-color));
      box-shadow: 0 10px 20px rgba(15, 23, 42, 0.08);
      background: color-mix(in srgb, var(--primary-color) 8%, var(--bg-primary));
    }

    .workspace-task-assist-option-key {
      width: 1.8rem;
      height: 1.8rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent-gold, #d3a94f) 18%, transparent);
      color: color-mix(in srgb, var(--accent-gold, #d3a94f) 88%, var(--text-primary));
      font-size: 0.76rem;
      font-weight: 800;
    }

    .workspace-task-assist-option-label {
      display: block;
      color: var(--text-primary);
      font-weight: 700;
      line-height: 1.45;
    }

    .workspace-task-assist-option-description {
      display: block;
      margin-top: 0.2rem;
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .workspace-task-assist-custom-input {
      margin-top: 0.8rem;
      padding-top: 0.85rem;
      border-top: 1px solid color-mix(in srgb, var(--border-color) 88%, transparent);
    }

    .workspace-task-assist-actions-primary {
      margin-top: 1.15rem;
    }

    .workspace-task-assist-continue-btn {
      width: 100%;
      justify-content: center;
      padding: 0.7rem 1.2rem;
      font-size: 0.95rem;
    }

    .workspace-task-assist-more-actions {
      margin-top: 0.85rem;
    }

    .workspace-task-assist-more-toggle {
      color: var(--text-secondary);
      font-size: 0.84rem;
      font-weight: 700;
      cursor: pointer;
      list-style: none;
      user-select: none;
    }

    .workspace-task-assist-more-toggle::-webkit-details-marker {
      display: none;
    }

    .workspace-task-assist-more-toggle::before {
      content: "\25B6";
      display: inline-block;
      margin-right: 0.4rem;
      font-size: 0.65rem;
      transition: transform 0.16s ease;
    }

    .workspace-task-assist-more-actions[open] > .workspace-task-assist-more-toggle::before {
      transform: rotate(90deg);
    }

    .workspace-task-assist-more-content {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      margin-top: 0.75rem;
      padding: 0.95rem 1rem;
      border-radius: 20px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    }

    .workspace-task-assist-switch-row {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .workspace-task-assist-switch-row .form-select {
      flex: 1;
    }

    .workspace-task-assist-secondary-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .workspace-task-assist-fail {
      color: #c23b3b;
      font-size: 0.84rem;
    }

    .workspace-task-assist-fail:hover {
      text-decoration: underline;
    }

    .workspace-task-page-loading-layout {
      display: grid;
      grid-template-columns: minmax(0, 1.18fr) minmax(320px, 0.82fr);
      gap: 1.25rem;
      align-items: start;
    }

    .workspace-task-page-loading-main,
    .workspace-task-page-loading-aside {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .workspace-task-page-loading-card {
      border-radius: 28px;
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--bg-secondary) 84%, transparent), color-mix(in srgb, var(--bg-primary) 94%, transparent), color-mix(in srgb, var(--bg-secondary) 84%, transparent));
      background-size: 220% 100%;
      animation: workspace-task-page-pulse 1.6s linear infinite;
      border: 1px solid color-mix(in srgb, var(--border-color) 90%, transparent);
    }

    .workspace-task-page-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
      padding: 4rem 1.5rem;
      border-radius: 28px;
      border: 1px solid color-mix(in srgb, var(--border-color) 90%, transparent);
      background: linear-gradient(180deg, color-mix(in srgb, var(--bg-secondary) 82%, transparent), color-mix(in srgb, var(--bg-primary) 94%, transparent));
      text-align: center;
    }

    .workspace-task-page-empty-icon {
      width: 3rem;
      height: 3rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: rgba(194, 59, 59, 0.12);
      color: #c23b3b;
      font-weight: 800;
    }

    .workspace-task-schedule-content {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .workspace-task-schedule-stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: 0.65rem;
    }

    .workspace-task-schedule-stat {
      padding: 0.7rem 0.85rem;
      border-radius: 16px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    }

    .workspace-task-schedule-stat-label {
      color: var(--text-secondary);
      font-size: 0.72rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .workspace-task-schedule-stat-value {
      color: var(--text-primary);
      font-size: 1.1rem;
      font-weight: 800;
      margin-top: 0.15rem;
    }

    .workspace-task-schedule-history {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .workspace-task-schedule-run {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 0.8rem;
      padding: 0.6rem 0.85rem;
      border-radius: 14px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
      font-size: 0.88rem;
    }

    .workspace-task-schedule-run-status {
      font-weight: 700;
    }

    .workspace-task-schedule-run-status[data-state="completed"] {
      color: #157347;
    }

    .workspace-task-schedule-run-status[data-state="failed"] {
      color: #c23b3b;
    }

    .workspace-task-collapsible {
      border-radius: 16px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 94%, transparent);
    }

    .workspace-task-collapsible-toggle {
      padding: 0.6rem 0.85rem;
      font-size: 0.82rem;
      font-weight: 700;
      color: var(--text-secondary);
      cursor: pointer;
      list-style: none;
    }

    .workspace-task-collapsible-toggle::-webkit-details-marker {
      display: none;
    }

    .workspace-task-collapsible-toggle::before {
      content: "\25B6";
      display: inline-block;
      margin-right: 0.4rem;
      font-size: 0.6rem;
      transition: transform 0.16s ease;
    }

    .workspace-task-collapsible[open] > .workspace-task-collapsible-toggle::before {
      transform: rotate(90deg);
    }

    .workspace-task-collapsible .workspace-task-page-code-block {
      border-top: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      border-radius: 0 0 16px 16px;
      border-left: none;
      border-right: none;
      border-bottom: none;
    }

    .workspace-task-context-disclosure {
      cursor: default;
    }

    .workspace-task-context-toggle {
      cursor: pointer;
      list-style: none;
    }

    .workspace-task-context-toggle::-webkit-details-marker {
      display: none;
    }

    .workspace-task-context-chevron::after {
      content: "\25B6";
      display: inline-block;
      font-size: 0.7rem;
      color: var(--text-secondary);
      transition: transform 0.16s ease;
    }

    .workspace-task-context-disclosure[open] > .workspace-task-context-toggle .workspace-task-context-chevron::after {
      transform: rotate(90deg);
    }

    @keyframes workspace-task-page-pulse {
      0% { background-position: 0% 0; }
      100% { background-position: 200% 0; }
    }

    @keyframes workspace-task-assist-panel-enter {
      0% {
        opacity: 0;
        transform: translateX(10px);
      }
      100% {
        opacity: 1;
        transform: translateX(0);
      }
    }

    @media (max-width: 1100px) {
      .workspace-task-page-hero,
      .workspace-task-page-layout,
      .workspace-task-page-loading-layout {
        grid-template-columns: 1fr;
      }

      .workspace-task-page-hero-meta {
        align-items: flex-start;
      }

      .workspace-task-page-sidebar {
        position: static;
      }

      .workspace-task-assist-deck {
        grid-template-columns: 1fr;
      }

      .workspace-task-assist-deck-rail {
        flex-direction: row;
        overflow-x: auto;
        padding-bottom: 0.2rem;
      }

      .workspace-task-assist-deck-tab {
        min-width: 240px;
      }
    }

    @media (max-width: 720px) {
      .workspace-task-page-shell {
        padding: 1rem;
      }

      .workspace-task-page-hero,
      .workspace-task-page-card {
        padding: 1.05rem;
        border-radius: 24px;
      }

      .workspace-task-overview-grid {
        grid-template-columns: 1fr;
      }

      .workspace-task-related-link {
        min-width: 100%;
      }

      .workspace-task-assist-deck-tab {
        min-width: 220px;
      }

      .workspace-task-assist-deck-panel {
        padding: 0.9rem;
      }

      .workspace-task-assist-deck-nav {
        flex-direction: column;
      }

      .workspace-task-assist-deck-nav .modern-btn {
        width: 100%;
      }

      .workspace-task-assist-deck-nav-note {
        width: 100%;
        text-align: left;
        margin-left: 0;
      }

      .workspace-task-assist-review-item-top {
        align-items: flex-start;
      }

      .workspace-task-assist-review-answer {
        padding-left: 0;
      }
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="/js/modules/themeManager.js"></script>
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/utils/dom-utils.js"></script>
  <script src="/js/modules/resizer.js"></script>
  <script src="/js/modules/settings.js"></script>
  <script src="/js/modules/agents.js"></script>
  <script src="/js/modules/apikey.js"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/modules/file-upload.js"></script>
  <script src="/js/modules/location.js"></script>
  <script src="/js/modules/task-modal-controller.js"></script>
  <script src="/js/modules/workspace-bootstrap-review.js"></script>
  <script src="/js/modules/sessions.js"></script>
  <script src="/js/modules/dashboard.js"></script>
  <script src="/js/modules/toast.js"></script>
  <script src="/js/modules/voice-input.js"></script>
  <script src="/js/modules/form-validation.js"></script>
  <script src="/js/file-manager.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/modules/workspace-realtime.js"></script>
  <script>
    if (typeof themeManager !== 'undefined' && themeManager && typeof themeManager.initialize === 'function') {
      themeManager.initialize();
    }
  </script>

  <script type="module">
    import { WorkspaceTaskPage } from '/js/modules/workspace-task.js';

    document.addEventListener('DOMContentLoaded', () => {
      const root = document.getElementById('workspaceTaskPageRoot');
      const workspaceId = root?.dataset?.workspaceId || '';
      const taskId = root?.dataset?.taskId || '';

      if (!workspaceId || !taskId) {
        console.error('Missing workspace or task identifier for task page');
        window.location.href = workspaceId ? `/workspaces/${encodeURIComponent(workspaceId)}` : '/workspaces';
        return;
      }

      window.currentWorkspaceId = workspaceId;
      const taskPage = new WorkspaceTaskPage(workspaceId, taskId);
      window.workspaceTaskPage = taskPage;
      taskPage.init();
    });
  </script>
</body>
</html>
