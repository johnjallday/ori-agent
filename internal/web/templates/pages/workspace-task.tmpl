      line-height: 1.4;
    }

    .workspace-task-review-card {
      display: grid;
      gap: 0.85rem;
      margin-bottom: 1rem;
      padding: 1rem;
      border: 1px solid color-mix(in srgb, #f59e0b 34%, var(--border-color));
      border-radius: 16px;
      background: color-mix(in srgb, #f59e0b 9%, var(--bg-primary));
