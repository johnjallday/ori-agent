{{define "workspace-task"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <div class="main-content">
      <div
        id="workspaceTaskPageRoot"
        class="workspace-task-page-shell"
        data-workspace-id="{{.Extra.WorkspaceID}}"
        data-task-id="{{.Extra.TaskID}}">

        <section class="workspace-task-page-hero">
          <div class="workspace-task-page-hero-copy">
            <a href="/workspaces/{{.Extra.WorkspaceID}}" class="workspace-task-page-backlink">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
              </svg>
              Back To Workspace
            </a>
            <div class="workspace-task-page-breadcrumbs">
              <a href="/workspaces/{{.Extra.WorkspaceID}}" id="workspace-task-workspace-name" class="workspace-task-page-breadcrumb-link">Workspace</a>
              <span aria-hidden="true">/</span>
              <span id="workspace-task-breadcrumb-title">Task</span>
            </div>
            <div class="workspace-task-page-title-row">
              <h1
                id="workspace-task-title"
                class="workspace-task-page-title"
                tabindex="0"
                role="button"
                aria-label="Edit task title">Loading task...</h1>
              <div class="workspace-task-page-title-actions">
                <button
                  type="button"
                  id="workspace-task-copy-id"
                  class="workspace-task-page-icon-btn"
                  aria-label="Copy task ID"
                  title="Copy task ID">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"/>
                  </svg>
                </button>
                <button
                  type="button"
                  id="workspace-task-copy-link"
                  class="workspace-task-page-icon-btn"
                  aria-label="Copy link to task"
                  title="Copy link to task">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83C7.22,12.88 7.22,9.71 9.17,7.76L12.71,4.22C14.66,2.27 17.83,2.27 19.78,4.22C21.73,6.17 21.73,9.34 19.78,11.29L18.29,12.78C18.3,11.96 18.17,11.14 17.89,10.36L18.36,9.88C19.54,8.71 19.54,6.81 18.36,5.64C17.19,4.46 15.29,4.46 14.12,5.64L10.59,9.17C9.41,10.34 9.41,12.24 10.59,13.41M13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17C16.78,11.12 16.78,14.29 14.83,16.24L11.29,19.78C9.34,21.73 6.17,21.73 4.22,19.78C2.27,17.83 2.27,14.66 4.22,12.71L5.71,11.22C5.7,12.04 5.83,12.86 6.11,13.64L5.64,14.12C4.46,15.29 4.46,17.19 5.64,18.36C6.81,19.54 8.71,19.54 9.88,18.36L13.41,14.83C14.59,13.66 14.59,11.76 13.41,10.59C13,10.2 13,9.56 13.41,9.17Z"/>
                  </svg>
                </button>
                <button
                  type="button"
                  id="workspace-task-delete"
                  class="workspace-task-page-icon-btn workspace-task-page-icon-btn-danger"
                  aria-label="Delete task"
                  title="Delete task">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                  </svg>
                </button>
              </div>
            </div>
            <div class="workspace-task-page-subtitle-row">
              <p id="workspace-task-subtitle" class="workspace-task-page-subtitle">Pulling task context, agent assignment, and response state.</p>
              <button
                type="button"
                id="workspace-task-details-edit"
                class="workspace-task-page-subtitle-edit"
                aria-label="Edit additional task details"
                title="Edit additional task details">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                </svg>
              </button>
            </div>
          </div>
          <div class="workspace-task-page-hero-meta">
            <span id="workspace-task-status" class="workspace-task-page-status" data-state="pending" aria-live="polite">Pending</span>
            <label class="workspace-task-page-agent-picker" id="workspace-task-hero-agent-wrap" hidden>
              <span class="workspace-task-page-agent-picker-label">Agent</span>
              <select id="workspace-task-hero-agent" class="workspace-task-page-agent-picker-select" aria-label="Reassign task agent"></select>
            </label>
            <div id="workspace-task-hero-actions" class="workspace-task-page-hero-actions"></div>
          </div>
        </section>

        <!-- Full-width Action Required banner. Previously this lived inside
             the hero's narrow right column where the CTA buttons collided
             with the status badge and agent picker. Promoted to a sibling
             of the hero so the "you need to do something" state takes the
             page's full width and reads as the primary call to action. -->
        <aside
          id="workspace-task-hero-priority"
          class="workspace-task-hero-priority"
          role="region"
          aria-label="Action required"
          hidden>
          <div class="workspace-task-hero-priority-body">
            <div class="workspace-task-hero-priority-kicker">Action Required</div>
            <div id="workspace-task-hero-priority-copy" class="workspace-task-hero-priority-copy"></div>
            <div id="workspace-task-hero-priority-reason" class="workspace-task-hero-priority-reason" hidden>
              <span class="workspace-task-hero-priority-reason-label">Reason</span>
              <span id="workspace-task-hero-priority-reason-text" class="workspace-task-hero-priority-reason-text"></span>
            </div>
          </div>
          <div id="workspace-task-hero-priority-actions" class="workspace-task-hero-priority-actions"></div>
        </aside>

        <div id="workspace-task-page-alert" class="workspace-task-page-alert d-none" role="alert"></div>

        <!-- Skeleton mirrors the single-column main layout (no aside). The
             card heights roughly match the Task Brief and the Result/Schedule
             stacks that the live page renders. -->
        <div id="workspace-task-page-loading" class="workspace-task-page-loading">
          <div class="workspace-task-page-loading-layout">
            <div class="workspace-task-page-loading-card" style="min-height: 220px;"></div>
            <div class="workspace-task-page-loading-card" style="min-height: 180px;"></div>
            <div class="workspace-task-page-loading-card" style="min-height: 140px;"></div>
          </div>
        </div>

        <div id="workspace-task-page-empty" class="workspace-task-page-empty" hidden>
          <div class="workspace-task-page-empty-icon">!</div>
          <h2>Task not found</h2>
          <p>This task could not be loaded from the workspace.</p>
          <a href="/workspaces/{{.Extra.WorkspaceID}}" class="modern-btn modern-btn-secondary">Return To Workspace</a>
        </div>

        <div id="workspace-task-page-content" class="workspace-task-page-layout" hidden>
          <main class="workspace-task-page-main">
            <div class="workspace-task-page-tabs" role="tablist" aria-label="Task sections">
              <button type="button" class="workspace-task-page-tab is-active" data-task-tab="overview" role="tab" aria-selected="true" aria-controls="workspace-task-tab-overview" id="workspace-task-tab-button-overview">Overview</button>
              <button type="button" class="workspace-task-page-tab" data-task-tab="activity" role="tab" aria-selected="false" aria-controls="workspace-task-tab-activity" id="workspace-task-tab-button-activity">
                <span>Activity</span>
                <span id="workspace-task-tab-activity-count" class="workspace-task-page-tab-count" hidden aria-hidden="true"></span>
              </button>
              <button type="button" class="workspace-task-page-tab" data-task-tab="developer" role="tab" aria-selected="false" aria-controls="workspace-task-tab-developer" id="workspace-task-tab-button-developer">Developer</button>
            </div>

            <div id="workspace-task-tab-overview" class="workspace-task-tab-pane is-active" role="tabpanel" aria-labelledby="workspace-task-tab-button-overview">
              <section class="workspace-task-page-card">
                <div class="workspace-task-page-card-header">
                  <div>
                    <div class="workspace-task-page-card-kicker">Task Brief</div>
                    <h2>Current scope</h2>
                  </div>
                </div>
                <div id="workspace-task-overview" class="workspace-task-overview-grid"></div>
              </section>

              <section id="workspace-task-blocked-context-card" class="workspace-task-page-card" hidden>
                <div class="workspace-task-page-card-header">
                  <div>
                    <div class="workspace-task-page-card-kicker">Blocked Context</div>
                    <h2>Why the task paused</h2>
                  </div>
                </div>
                <div class="workspace-task-blocked-reason">
                  <div class="workspace-task-page-mini-label">Pause reason</div>
                  <div id="workspace-task-blocked-reason" class="workspace-task-page-copy-block"></div>
                </div>
                <div id="workspace-task-blocked-request-wrap" class="workspace-task-blocked-request-wrap d-none">
                  <div class="workspace-task-page-mini-label">Agent request</div>
                  <div id="workspace-task-blocked-request-preview" class="workspace-task-page-copy-block"></div>
                  <button type="button" id="workspace-task-blocked-request-toggle" class="workspace-task-page-text-button d-none" aria-expanded="false">View full request</button>
                  <pre id="workspace-task-blocked-request" class="workspace-task-page-code-block d-none"></pre>
                </div>
              </section>

              <section id="workspace-task-output-card" class="workspace-task-page-card" hidden>
                <div class="workspace-task-page-card-header">
                  <div>
                    <div class="workspace-task-page-card-kicker">Result</div>
                    <h2>Latest output</h2>
                  </div>
                  <!--
                    Three competing primaries (Save as Note, Create Skill,
                    Create Workflow Task) collapsed into one primary
                    (Save as Note) + one secondary (Follow-up) + an overflow
                    menu for Copy and the templatize actions. Element IDs
                    and label <span>s are preserved so updateResultActionButtons
                    and the click handlers in bindEvents continue to drive
                    them unchanged.
                  -->
                  <div class="workspace-task-output-actions" aria-label="Result actions">
                    <button type="button" id="workspace-task-output-save-note" class="modern-btn modern-btn-primary workspace-task-output-action-btn">
                      <i class="bi bi-journal-plus" aria-hidden="true"></i>
                      <span>Save as Note</span>
                    </button>
                    <button type="button" id="workspace-task-output-followup" class="modern-btn modern-btn-secondary workspace-task-output-action-btn">
                      <i class="bi bi-arrow-down-right-circle" aria-hidden="true"></i>
                      <span>Follow-up task</span>
                    </button>
                    <div class="workspace-task-output-overflow" data-open="false">
                      <button
                        type="button"
                        id="workspace-task-output-overflow-toggle"
                        class="modern-btn modern-btn-secondary workspace-task-output-action-btn workspace-task-output-overflow-toggle"
                        aria-haspopup="menu"
                        aria-expanded="false"
                        aria-controls="workspace-task-output-overflow-menu"
                        aria-label="More result actions"
                        title="More actions">
                        <i class="bi bi-three-dots" aria-hidden="true"></i>
                      </button>
                      <div id="workspace-task-output-overflow-menu" class="workspace-task-output-overflow-menu" role="menu" hidden>
                        <button type="button" id="workspace-task-output-copy" class="workspace-task-output-overflow-item" role="menuitem">
                          <i class="bi bi-copy" aria-hidden="true"></i>
                          <span>Copy</span>
                        </button>
                        <button type="button" id="workspace-task-output-create-skill" class="workspace-task-output-overflow-item" role="menuitem" hidden>
                          <i class="bi bi-magic" aria-hidden="true"></i>
                          <span>Create Skill</span>
                        </button>
                        <button type="button" id="workspace-task-output-promote" class="workspace-task-output-overflow-item" role="menuitem" hidden>
                          <i class="bi bi-diagram-3" aria-hidden="true"></i>
                          <span>Create Workflow Task</span>
                        </button>
                      </div>
                    </div>
                  </div>
                </div>
                <div id="workspace-task-output-note-status" class="workspace-task-output-note-status" hidden></div>
                <div id="workspace-task-output"></div>
                <div id="workspace-task-followup-panel" class="workspace-task-followup-panel" hidden>
                  <div class="workspace-task-followup-kicker">New follow-up task</div>
                  <p class="workspace-task-followup-copy">Creates a new task that receives this task's result as input. The downstream agent reads it via runtime inputs at execution time.</p>
                  <label class="workspace-task-followup-field">
                    <span>What should the follow-up do?</span>
                    <input type="text" id="workspace-task-followup-description" maxlength="500" placeholder="e.g. Draft a calendar reminder from this allergy report" />
                  </label>
                  <label class="workspace-task-followup-field">
                    <span>Assign to</span>
                    <select id="workspace-task-followup-agent"></select>
                  </label>
                  <!-- "Details" was a peer field in the form; most follow-ups
                       don't need it. Demoted behind a disclosure so the
                       default form is two fields. Submission logic still
                       reads .value off the textarea unchanged. -->
                  <div class="workspace-task-followup-collapsible" data-open="false">
                    <button
                      type="button"
                      id="workspace-task-followup-details-toggle"
                      class="workspace-task-followup-disclosure"
                      aria-expanded="false"
                      aria-controls="workspace-task-followup-details-field">
                      <span class="workspace-task-followup-disclosure-icon" aria-hidden="true">+</span>
                      Add constraints
                    </button>
                    <label
                      id="workspace-task-followup-details-field"
                      class="workspace-task-followup-field workspace-task-followup-field-collapsible"
                      hidden>
                      <span>Constraints, format, or extra context</span>
                      <textarea id="workspace-task-followup-details" rows="3" placeholder="Anything the downstream agent should know."></textarea>
                    </label>
                  </div>
                  <div id="workspace-task-followup-error" class="workspace-task-followup-error" hidden></div>
                  <div class="workspace-task-followup-actions">
                    <button type="button" id="workspace-task-followup-cancel" class="modern-btn modern-btn-secondary">Cancel</button>
                    <button type="button" id="workspace-task-followup-submit" class="modern-btn modern-btn-primary">
                      <span>Create follow-up</span>
                    </button>
                  </div>
                </div>
              </section>

              <section id="workspace-task-schedule-card" class="workspace-task-page-card" hidden>
                <div class="workspace-task-page-card-header">
                  <div>
                    <div class="workspace-task-page-card-kicker">Schedule</div>
                    <h2>Execution history</h2>
                  </div>
                  <button type="button" id="workspace-task-schedule-card-edit" class="modern-btn modern-btn-secondary workspace-task-schedule-edit-btn">
                    <i class="bi bi-calendar2-week" aria-hidden="true"></i>
                    <span>Edit</span>
                  </button>
                </div>
                <div id="workspace-task-schedule" class="workspace-task-schedule-content"></div>
              </section>
            </div>

            <div id="workspace-task-tab-activity" class="workspace-task-tab-pane" role="tabpanel" aria-labelledby="workspace-task-tab-button-activity" hidden>
              <section id="workspace-task-workspace-runs-card" class="workspace-task-page-card" hidden>
                <div class="workspace-task-page-card-header">
                  <div>
                    <div class="workspace-task-page-card-kicker">Harness</div>
                    <h2>Workspace Runs</h2>
                  </div>
                </div>
                <div id="workspace-task-workspace-runs" class="workspace-task-workspace-runs-list"></div>
              </section>

              <section id="workspace-task-relationships-card" class="workspace-task-page-card" hidden>
                <div class="workspace-task-page-card-header">
                  <div>
                    <div class="workspace-task-page-card-kicker">Task Graph</div>
                    <h2>Dependencies and parents</h2>
                  </div>
                </div>
                <div id="workspace-task-relationships" class="workspace-task-relationship-groups"></div>
              </section>

              <section id="workspace-task-workflow-card" class="workspace-task-page-card" hidden>
                <div class="workspace-task-page-card-header">
                  <div>
                    <div class="workspace-task-page-card-kicker">Workflow</div>
                    <h2>Steps</h2>
                  </div>
                  <div id="workspace-task-workflow-actions" class="workspace-task-workflow-actions" hidden>
                    <button type="button" id="workspace-task-workflow-add-step" class="modern-btn modern-btn-secondary workspace-task-workflow-header-btn" title="Add a new step">+ Add step</button>
                    <button type="button" id="workspace-task-workflow-run-all" class="modern-btn modern-btn-primary workspace-task-workflow-header-btn" title="Run all steps in sequence">▶ Run all</button>
                  </div>
                </div>
                <div id="workspace-task-workflow-empty" class="workspace-task-workflow-empty" hidden>
                  <div class="workspace-task-workflow-empty-copy">No steps yet. Break this task's result into a runnable list of steps.</div>
                  <button type="button" id="workspace-task-workflow-generate" class="modern-btn modern-btn-primary workspace-task-workflow-empty-btn">Break this into steps</button>
                </div>
                <div id="workspace-task-workflow-steps" class="workspace-task-workflow-list"></div>
              </section>

              <section id="workspace-task-runs-card" class="workspace-task-page-card" hidden>
                <div class="workspace-task-page-card-header">
                  <div>
                    <div class="workspace-task-page-card-kicker">Run history</div>
                    <h2>Runs and tool calls</h2>
                  </div>
                </div>
                <div id="workspace-task-tool-summary" class="workspace-task-tool-summary" hidden></div>
                <div class="workspace-task-runs-tabs" role="tablist" aria-label="Run history view">
                  <button type="button" class="workspace-task-runs-tab is-active" data-runs-tab="runs" role="tab" aria-selected="true" aria-controls="workspace-task-trace" id="workspace-task-runs-tab-runs">
                    <span>Runs</span>
                    <span class="workspace-task-runs-tab-count" id="workspace-task-runs-tab-runs-count" hidden></span>
                  </button>
                  <button type="button" class="workspace-task-runs-tab" data-runs-tab="trace" role="tab" aria-selected="false" aria-controls="workspace-task-execution-trace" id="workspace-task-runs-tab-trace">
                    <span>Trace</span>
                    <span class="workspace-task-runs-tab-count" id="workspace-task-runs-tab-trace-count" hidden></span>
                  </button>
                </div>
                <div id="workspace-task-execution-trace-controls" class="workspace-task-trace-controls" hidden>
                  <div id="workspace-task-execution-trace-filters" class="workspace-task-trace-filters" role="group" aria-label="Filter trace entries"></div>
                  <div id="workspace-task-execution-trace-count" class="workspace-task-trace-count" aria-live="polite"></div>
                </div>
                <div id="workspace-task-trace" class="workspace-task-breakdown-list" role="tabpanel" aria-labelledby="workspace-task-runs-tab-runs"></div>
                <div id="workspace-task-execution-trace" class="workspace-task-trace-list" role="tabpanel" aria-labelledby="workspace-task-runs-tab-trace" hidden></div>
              </section>

              <div id="workspace-task-activity-empty" class="workspace-task-page-card workspace-task-tab-empty" hidden>
                <p class="workspace-task-tab-empty-copy">Run history and execution trace will appear here once this task runs.</p>
              </div>
            </div>

            <div id="workspace-task-tab-developer" class="workspace-task-tab-pane" role="tabpanel" aria-labelledby="workspace-task-tab-button-developer" hidden>
              <section id="workspace-task-context-card" class="workspace-task-page-card" hidden>
                <div class="workspace-task-page-card-header">
                  <div>
                    <div class="workspace-task-page-card-kicker">Developer</div>
                    <h2>Raw task context</h2>
                  </div>
                </div>
                <div id="workspace-task-context"></div>
              </section>

              <div id="workspace-task-developer-empty" class="workspace-task-page-card workspace-task-tab-empty" hidden>
                <p class="workspace-task-tab-empty-copy">No developer context available for this task yet.</p>
              </div>
            </div>
          </main>
        </div>

        <!-- Slide-out assist panel (opened from the Action Required banner CTA) -->
        <div id="workspace-task-assist-panel" class="workspace-task-assist-panel" hidden>
          <div id="workspace-task-assist-backdrop" class="workspace-task-assist-backdrop"></div>
          <div class="workspace-task-assist-panel-content" id="workspace-task-assist-card">
            <div class="workspace-task-assist-panel-header">
              <div>
                <div class="workspace-task-page-card-kicker">Need Your Input</div>
                <h2>Unblock this task</h2>
              </div>
              <button type="button" id="workspace-task-assist-close" class="workspace-task-assist-panel-close" aria-label="Close panel">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/></svg>
              </button>
            </div>

            <div class="workspace-task-assist-panel-body">
              <div class="workspace-task-assist-summary-grid">
                <article class="workspace-task-assist-summary-card">
                  <div class="workspace-task-assist-summary-title">What It Knows</div>
                  <div id="workspace-task-assist-known" class="workspace-task-assist-summary-copy"></div>
                </article>
                <article class="workspace-task-assist-summary-card">
                  <div class="workspace-task-assist-summary-title">What It Needs</div>
                  <div id="workspace-task-assist-needs" class="workspace-task-assist-summary-copy"></div>
                </article>
                <article class="workspace-task-assist-summary-card">
                  <div class="workspace-task-assist-summary-title">What Happens Next</div>
                  <div id="workspace-task-assist-next" class="workspace-task-assist-summary-copy"></div>
                </article>
              </div>

              <div id="workspace-task-assist-question-wrap" class="workspace-task-assist-question-wrap d-none">
                <div class="workspace-task-page-mini-label">Question</div>
                <div id="workspace-task-assist-question" class="workspace-task-page-copy-block"></div>
              </div>

              <div id="workspace-task-assist-form-wrap" class="workspace-task-assist-form-wrap d-none">
                <div class="workspace-task-page-mini-label">Requested details</div>
                <div id="workspace-task-assist-form-fields" class="workspace-task-assist-form-fields"></div>
              </div>

              <div class="workspace-task-assist-extra">
                <label class="form-label" for="workspace-task-assist-message">Extra guidance for the agent</label>
