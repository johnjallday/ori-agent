{{define "workspace-task"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <div class="main-content">
      <div
        id="workspaceTaskPageRoot"
        class="workspace-task-page-shell"
        data-workspace-id="{{.Extra.WorkspaceID}}"
        data-task-id="{{.Extra.TaskID}}">

        <section class="workspace-task-page-hero">
          <div class="workspace-task-page-hero-copy">
            <a href="/workspaces/{{.Extra.WorkspaceID}}" class="workspace-task-page-backlink">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
              </svg>
              Back To Workspace
            </a>
            <div class="workspace-task-page-breadcrumbs">
              <a href="/workspaces/{{.Extra.WorkspaceID}}" id="workspace-task-workspace-name" class="workspace-task-page-breadcrumb-link">Workspace</a>
              <span aria-hidden="true">/</span>
              <span id="workspace-task-breadcrumb-title">Task</span>
            </div>
            <div class="workspace-task-page-title-row">
              <h1 id="workspace-task-title" class="workspace-task-page-title">Loading task...</h1>
              <div class="workspace-task-page-title-actions">
                <button
                  type="button"
                  id="workspace-task-title-edit"
                  class="workspace-task-page-icon-btn"
                  aria-label="Edit task title"
                  title="Edit task title">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                  </svg>
                </button>
                <button
                  type="button"
                  id="workspace-task-copy-id"
                  class="workspace-task-page-icon-btn"
                  aria-label="Copy task ID"
                  title="Copy task ID">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"/>
                  </svg>
                </button>
                <button
                  type="button"
                  id="workspace-task-copy-link"
                  class="workspace-task-page-icon-btn"
                  aria-label="Copy link to task"
                  title="Copy link to task">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M10.59,13.41C11,13.8 11,14.44 10.59,14.83C10.2,15.22 9.56,15.22 9.17,14.83C7.22,12.88 7.22,9.71 9.17,7.76L12.71,4.22C14.66,2.27 17.83,2.27 19.78,4.22C21.73,6.17 21.73,9.34 19.78,11.29L18.29,12.78C18.3,11.96 18.17,11.14 17.89,10.36L18.36,9.88C19.54,8.71 19.54,6.81 18.36,5.64C17.19,4.46 15.29,4.46 14.12,5.64L10.59,9.17C9.41,10.34 9.41,12.24 10.59,13.41M13.41,9.17C13.8,8.78 14.44,8.78 14.83,9.17C16.78,11.12 16.78,14.29 14.83,16.24L11.29,19.78C9.34,21.73 6.17,21.73 4.22,19.78C2.27,17.83 2.27,14.66 4.22,12.71L5.71,11.22C5.7,12.04 5.83,12.86 6.11,13.64L5.64,14.12C4.46,15.29 4.46,17.19 5.64,18.36C6.81,19.54 8.71,19.54 9.88,18.36L13.41,14.83C14.59,13.66 14.59,11.76 13.41,10.59C13,10.2 13,9.56 13.41,9.17Z"/>
                  </svg>
                </button>
                <button
                  type="button"
                  id="workspace-task-delete"
                  class="workspace-task-page-icon-btn workspace-task-page-icon-btn-danger"
                  aria-label="Delete task"
                  title="Delete task">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                  </svg>
                </button>
              </div>
            </div>
            <p id="workspace-task-subtitle" class="workspace-task-page-subtitle">Pulling task context, agent assignment, and response state.</p>
          </div>
          <div class="workspace-task-page-hero-meta">
            <span id="workspace-task-status" class="workspace-task-page-status" data-state="pending">Pending</span>
            <span id="workspace-task-live-badge" class="workspace-task-page-live-badge" hidden>
              <span class="workspace-task-page-live-dot"></span>Live
            </span>
            <div id="workspace-task-hero-actions" class="workspace-task-page-hero-actions"></div>
            <div id="workspace-task-hero-priority" class="workspace-task-hero-priority" hidden>
              <div class="workspace-task-hero-priority-kicker">Action Required</div>
              <div id="workspace-task-hero-priority-copy" class="workspace-task-hero-priority-copy"></div>
              <div id="workspace-task-hero-priority-actions" class="workspace-task-hero-priority-actions"></div>
            </div>
          </div>
        </section>

        <div id="workspace-task-page-alert" class="workspace-task-page-alert d-none" role="alert"></div>

        <div id="workspace-task-page-loading" class="workspace-task-page-loading">
          <div class="workspace-task-page-loading-layout">
            <div class="workspace-task-page-loading-main">
              <div class="workspace-task-page-loading-card" style="min-height: 200px;"></div>
              <div class="workspace-task-page-loading-card" style="min-height: 160px;"></div>
            </div>
            <div class="workspace-task-page-loading-aside">
              <div class="workspace-task-page-loading-card" style="min-height: 240px;"></div>
            </div>
          </div>
        </div>

        <div id="workspace-task-page-empty" class="workspace-task-page-empty" hidden>
          <div class="workspace-task-page-empty-icon">!</div>
          <h2>Task not found</h2>
          <p>This task could not be loaded from the workspace.</p>
          <a href="/workspaces/{{.Extra.WorkspaceID}}" class="modern-btn modern-btn-secondary">Return To Workspace</a>
        </div>

        <div id="workspace-task-page-content" class="workspace-task-page-layout" hidden>
          <main class="workspace-task-page-main">
            <section class="workspace-task-page-card">
              <div class="workspace-task-page-card-header">
                <div>
                  <div class="workspace-task-page-card-kicker">Task Brief</div>
                  <h2>Current scope</h2>
                </div>
              </div>
              <div id="workspace-task-overview" class="workspace-task-overview-grid"></div>
            </section>

            <section id="workspace-task-blocked-context-card" class="workspace-task-page-card" hidden>
              <div class="workspace-task-page-card-header">
                <div>
                  <div class="workspace-task-page-card-kicker">Blocked Context</div>
                  <h2>Why the task paused</h2>
                </div>
              </div>
              <div class="workspace-task-blocked-reason">
                <div class="workspace-task-page-mini-label">Pause reason</div>
                <div id="workspace-task-blocked-reason" class="workspace-task-page-copy-block"></div>
              </div>
              <div id="workspace-task-blocked-request-wrap" class="workspace-task-blocked-request-wrap d-none">
                <div class="workspace-task-page-mini-label">Agent request</div>
                <div id="workspace-task-blocked-request-preview" class="workspace-task-page-copy-block"></div>
                <button type="button" id="workspace-task-blocked-request-toggle" class="workspace-task-page-text-button d-none" aria-expanded="false">View full request</button>
                <pre id="workspace-task-blocked-request" class="workspace-task-page-code-block d-none"></pre>
              </div>
            </section>

            <section id="workspace-task-assist-card" class="workspace-task-page-card workspace-task-assist-card" hidden>
              <div class="workspace-task-page-card-header">
                <div>
                  <div class="workspace-task-page-card-kicker">Need Your Input</div>
                  <h2>Unblock this task</h2>
                </div>
              </div>

              <div class="workspace-task-assist-summary-grid">
                <article class="workspace-task-assist-summary-card">
                  <div class="workspace-task-assist-summary-title">What It Knows</div>
                  <div id="workspace-task-assist-known" class="workspace-task-assist-summary-copy"></div>
                </article>
                <article class="workspace-task-assist-summary-card">
                  <div class="workspace-task-assist-summary-title">What It Needs</div>
                  <div id="workspace-task-assist-needs" class="workspace-task-assist-summary-copy"></div>
                </article>
                <article class="workspace-task-assist-summary-card">
                  <div class="workspace-task-assist-summary-title">What Happens Next</div>
                  <div id="workspace-task-assist-next" class="workspace-task-assist-summary-copy"></div>
                </article>
              </div>

              <div id="workspace-task-assist-question-wrap" class="workspace-task-assist-question-wrap d-none">
                <div class="workspace-task-page-mini-label">Question</div>
                <div id="workspace-task-assist-question" class="workspace-task-page-copy-block"></div>
              </div>

              <div id="workspace-task-assist-form-wrap" class="workspace-task-assist-form-wrap d-none">
                <div class="workspace-task-page-mini-label">Requested details</div>
                <div id="workspace-task-assist-form-fields" class="workspace-task-assist-form-fields"></div>
              </div>

              <div class="workspace-task-assist-extra">
                <label class="form-label" for="workspace-task-assist-message">Extra guidance for the agent</label>
                <textarea id="workspace-task-assist-message" class="form-control" rows="3" placeholder="Add clarification, constraints, or context before continuing..."></textarea>
              </div>

              <div class="workspace-task-assist-actions-primary">
                <button type="button" id="workspace-task-assist-continue" class="modern-btn modern-btn-primary workspace-task-assist-continue-btn">Continue</button>
              </div>

              <details class="workspace-task-assist-more-actions">
                <summary class="workspace-task-assist-more-toggle">More actions</summary>
                <div class="workspace-task-assist-more-content">
                  <div class="workspace-task-assist-switch">
                    <label class="form-label" for="workspace-task-assist-agent">Reassign agent</label>
                    <div class="workspace-task-assist-switch-row">
                      <select id="workspace-task-assist-agent" class="form-select">
                        <option value="">Keep current assignment</option>
                      </select>
                      <button type="button" id="workspace-task-assist-switch" class="modern-btn modern-btn-secondary">Switch + Retry</button>
                    </div>
                  </div>
                  <div class="workspace-task-assist-secondary-actions">
                    <button type="button" id="workspace-task-assist-retry" class="modern-btn modern-btn-secondary">Retry Task</button>
                    <button type="button" id="workspace-task-assist-fail" class="workspace-task-page-text-button workspace-task-assist-fail">Mark as Failed</button>
                  </div>
                </div>
              </details>
            </section>

            <section id="workspace-task-relationships-card" class="workspace-task-page-card" hidden>
              <div class="workspace-task-page-card-header">
                <div>
                  <div class="workspace-task-page-card-kicker">Task Graph</div>
                  <h2>Dependencies and children</h2>
                </div>
              </div>
              <div id="workspace-task-relationships" class="workspace-task-relationship-groups"></div>
            </section>

            <section id="workspace-task-output-card" class="workspace-task-page-card" hidden>
              <div class="workspace-task-page-card-header">
                <div>
                  <div class="workspace-task-page-card-kicker">Result</div>
                  <h2>Latest output</h2>
                </div>
              </div>
              <div id="workspace-task-output"></div>
            </section>

            <section id="workspace-task-schedule-card" class="workspace-task-page-card" hidden>
              <div class="workspace-task-page-card-header">
                <div>
                  <div class="workspace-task-page-card-kicker">Schedule</div>
                  <h2>Execution history</h2>
                </div>
              </div>
              <div id="workspace-task-schedule" class="workspace-task-schedule-content"></div>
            </section>

            <section id="workspace-task-steps-card" class="workspace-task-page-card" hidden>
              <div class="workspace-task-page-card-header">
                <div>
                  <div class="workspace-task-page-card-kicker">Execution</div>
                  <h2>Internal steps</h2>
                </div>
              </div>
              <div id="workspace-task-steps" class="workspace-task-step-list"></div>
            </section>

            <details id="workspace-task-context-card" class="workspace-task-page-card workspace-task-context-disclosure" hidden>
              <summary class="workspace-task-page-card-header workspace-task-context-toggle">
                <div>
                  <div class="workspace-task-page-card-kicker">Developer</div>
                  <h2>Raw task context</h2>
                </div>
                <span class="workspace-task-context-chevron" aria-hidden="true"></span>
              </summary>
              <div id="workspace-task-context"></div>
            </details>
          </main>

          <aside class="workspace-task-page-sidebar">
            <section class="workspace-task-page-card workspace-task-page-card-compact">
              <div class="workspace-task-page-card-header">
                <div>
                  <div class="workspace-task-page-card-kicker">Snapshot</div>
                  <h2>Task state</h2>
                </div>
              </div>
              <div id="workspace-task-snapshot" class="workspace-task-snapshot-list"></div>
            </section>
          </aside>
        </div>
      </div>
    </div>
  </div>

  <style>
    .workspace-task-page-shell {
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      min-height: calc(100vh - 72px);
    }

    .workspace-task-page-hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(260px, 0.65fr);
      gap: 1.5rem;
      padding: 1.6rem 1.75rem;
      border-radius: 30px;
      border: 1px solid color-mix(in srgb, var(--primary-color) 18%, var(--border-color));
      background:
        radial-gradient(circle at top right, color-mix(in srgb, var(--primary-color) 16%, transparent), transparent 42%),
        linear-gradient(135deg, color-mix(in srgb, var(--bg-secondary) 84%, transparent), var(--bg-primary));
      box-shadow: 0 28px 60px rgba(15, 23, 42, 0.14);
      overflow: hidden;
    }

    .workspace-task-page-hero::after {
      content: "";
      position: absolute;
      inset: auto -8% -40% auto;
      width: 280px;
      height: 280px;
      border-radius: 50%;
      background: radial-gradient(circle, color-mix(in srgb, var(--primary-color) 18%, transparent), transparent 68%);
      pointer-events: none;
    }

    .workspace-task-page-hero-copy,
    .workspace-task-page-hero-meta {
      position: relative;
      z-index: 1;
    }

    .workspace-task-page-backlink {
      width: fit-content;
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.55rem 0.95rem;
      margin-bottom: 1rem;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      background: color-mix(in srgb, var(--bg-primary) 82%, transparent);
      color: var(--text-primary);
      text-decoration: none;
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.02em;
    }

    .workspace-task-page-backlink:hover {
      border-color: color-mix(in srgb, var(--primary-color) 48%, var(--border-color));
      color: var(--primary-color);
    }

    .workspace-task-page-card-kicker,
    .workspace-task-page-mini-label {
      color: var(--accent-gold, #d3a94f);
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.74rem;
      font-weight: 800;
    }

    .workspace-task-page-breadcrumbs {
      display: flex;
      align-items: center;
      gap: 0.55rem;
      margin-bottom: 0.8rem;
      color: var(--text-secondary);
      font-size: 0.95rem;
      font-weight: 600;
    }

    .workspace-task-page-title {
      margin: 0;
      font-family: "Fraunces", serif;
      font-size: clamp(2rem, 4vw, 3.1rem);
      line-height: 1.02;
      color: var(--text-primary);
      max-width: 14ch;
    }

    .workspace-task-page-title-row {
      display: flex;
      align-items: flex-start;
      gap: 0.85rem;
      margin-top: 0.25rem;
    }

    .workspace-task-page-title-actions {
      display: flex;
      align-items: center;
      gap: 0.35rem;
      margin-top: 0.45rem;
      flex-shrink: 0;
    }

    .workspace-task-page-icon-btn {
      flex: 0 0 auto;
      width: 2.2rem;
      height: 2.2rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid color-mix(in srgb, var(--border-color) 90%, transparent);
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg-primary) 84%, transparent);
      color: var(--text-secondary);
      cursor: pointer;
      transition: color 0.16s ease, border-color 0.16s ease, transform 0.16s ease, background 0.16s ease;
    }

    .workspace-task-page-icon-btn:hover {
      color: var(--primary-color);
      border-color: color-mix(in srgb, var(--primary-color) 38%, var(--border-color));
      background: color-mix(in srgb, var(--primary-color) 10%, var(--bg-primary));
      transform: translateY(-1px);
    }

    .workspace-task-page-icon-btn:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--primary-color) 54%, transparent);
      outline-offset: 2px;
    }

    .workspace-task-page-icon-btn-danger:hover {
      color: #c23b3b;
      border-color: rgba(194, 59, 59, 0.38);
      background: rgba(194, 59, 59, 0.1);
    }

    .workspace-task-page-breadcrumb-link {
      color: var(--text-secondary);
      text-decoration: none;
    }

    .workspace-task-page-breadcrumb-link:hover {
      color: var(--primary-color);
      text-decoration: underline;
    }

    .workspace-task-page-title-edit-actions {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.45rem;
    }

    .workspace-task-page-edit-save,
    .workspace-task-page-edit-cancel {
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      font-size: 0.82rem;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.14s ease, border-color 0.14s ease;
    }

    .workspace-task-page-edit-save {
      background: var(--primary-color);
      border-color: var(--primary-color);
      color: #fff;
    }

    .workspace-task-page-edit-save:hover {
      opacity: 0.9;
    }

    .workspace-task-page-edit-cancel {
      background: color-mix(in srgb, var(--bg-primary) 84%, transparent);
      color: var(--text-secondary);
    }

    .workspace-task-page-edit-cancel:hover {
      border-color: color-mix(in srgb, var(--primary-color) 38%, var(--border-color));
    }

    .workspace-task-page-edit-hint {
      color: var(--text-secondary);
      font-size: 0.74rem;
      opacity: 0.7;
    }

    .workspace-task-page-title-input {
      width: min(100%, 14ch);
      min-height: 4.4rem;
      padding: 0.2rem 0 0.35rem;
      border: none;
      border-bottom: 2px solid color-mix(in srgb, var(--primary-color) 58%, transparent);
      background: transparent;
      color: var(--text-primary);
      font-family: "Fraunces", serif;
      font-size: clamp(2rem, 4vw, 3.1rem);
      font-weight: 700;
      line-height: 1.02;
      resize: none;
      overflow: hidden;
      box-shadow: none;
    }

    .workspace-task-page-title-input:focus {
      outline: none;
      border-bottom-color: color-mix(in srgb, var(--primary-color) 88%, transparent);
    }

    .workspace-task-page-subtitle {
      max-width: 68ch;
      margin: 0.9rem 0 0;
      color: var(--text-secondary);
      font-size: 1rem;
      line-height: 1.65;
    }

    .workspace-task-page-hero-meta {
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 0.85rem;
    }

    .workspace-task-page-status {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: fit-content;
      padding: 0.55rem 0.95rem;
      border-radius: 999px;
      border: 1px solid color-mix(in srgb, var(--border-color) 76%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 82%, transparent);
      color: var(--text-primary);
      font-size: 0.88rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .workspace-task-page-status[data-state="completed"] {
      color: #157347;
      border-color: rgba(21, 115, 71, 0.25);
      background: rgba(21, 115, 71, 0.12);
    }

    .workspace-task-page-status[data-state="in_progress"] {
      color: #0c63e7;
      border-color: rgba(12, 99, 231, 0.24);
      background: rgba(12, 99, 231, 0.12);
    }

    .workspace-task-page-status[data-state="blocked"] {
      color: #b26f00;
      border-color: rgba(178, 111, 0, 0.28);
      background: rgba(178, 111, 0, 0.14);
    }

    .workspace-task-page-status[data-state="failed"] {
      color: #c23b3b;
      border-color: rgba(194, 59, 59, 0.26);
      background: rgba(194, 59, 59, 0.12);
    }


    .workspace-task-page-live-badge {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.35rem 0.7rem;
      border-radius: 999px;
      background: rgba(16, 185, 129, 0.12);
      color: #10b981;
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .workspace-task-page-live-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
      animation: workspace-task-live-pulse 1.5s ease-in-out infinite;
    }

    @keyframes workspace-task-live-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.4; transform: scale(0.75); }
    }

    .workspace-task-page-flash {
      animation: workspace-task-flash 0.4s ease-out;
    }

    @keyframes workspace-task-flash {
