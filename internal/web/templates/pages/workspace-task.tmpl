      font-size: 0.68rem;
      font-weight: 700;
    }

    .workspace-task-review-table-wrap input {
      width: 100%;
      min-width: 8rem;
      border: 1px solid var(--border-color);
      border-radius: 6px;
      background: var(--bg-secondary);
