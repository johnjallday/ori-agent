    [data-bs-theme="dark"] .workspace-task-page-status[data-state="timeout"] {
      color: #fca5a5;
      border-color: rgba(252, 165, 165, 0.45);
      background: rgba(248, 113, 113, 0.22);
    }

    /* Live in_progress: replace the static ▶ icon with a pulsing dot child and
       shift the pill tint from blue to the streaming-green that used to be on
       the separate live badge. Motion + color together signal "streaming now"
       inside the one status pill. */
    .workspace-task-page-status[data-live="true"]::before {
      content: none;
    }
    .workspace-task-page-status[data-state="in_progress"][data-live="true"] {
      color: #0f7a5a;
      border-color: rgba(16, 185, 129, 0.32);
