      border-color: color-mix(in srgb, #157347 24%, var(--border-color));
      background: color-mix(in srgb, #157347 5%, var(--bg-primary));
    }

    .workspace-task-assist-deck-tab-number {
      width: 1.9rem;
      height: 1.9rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent-gold, #d3a94f) 18%, transparent);
      color: color-mix(in srgb, var(--accent-gold, #d3a94f) 88%, var(--text-primary));
      font-size: 0.76rem;
      font-weight: 800;
      flex-shrink: 0;
    }

    .workspace-task-assist-deck-tab-copy {
      min-width: 0;
      display: flex;
      flex-direction: column;
      gap: 0.22rem;
    }

    .workspace-task-assist-deck-tab-title {
      color: var(--text-primary);
      font-size: 0.92rem;
      font-weight: 700;
      line-height: 1.45;
    }

    .workspace-task-assist-deck-tab-meta {
      color: var(--text-secondary);
      font-size: 0.78rem;
      line-height: 1.4;
    }

    .workspace-task-assist-deck-tab-state {
      color: var(--text-secondary);
      font-size: 0.72rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }

    .workspace-task-assist-deck-tab.is-answered .workspace-task-assist-deck-tab-state {
      color: #157347;
    }

    .workspace-task-assist-deck-panel {
      padding: 0.95rem 1rem 1rem;
      border-radius: 22px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background:
        radial-gradient(circle at top right, color-mix(in srgb, var(--primary-color) 10%, transparent), transparent 42%),
        color-mix(in srgb, var(--bg-primary) 96%, transparent);
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
    }

    .workspace-task-assist-deck-progress-row {
      display: grid;
      gap: 0.7rem;
      margin-bottom: 0.9rem;
    }

    .workspace-task-assist-deck-kicker {
      color: var(--text-secondary);
      font-size: 0.76rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .workspace-task-assist-deck-progress-copy {
      color: var(--text-primary);
      font-size: 0.94rem;
      font-weight: 700;
      margin-top: 0.12rem;
    }

    .workspace-task-assist-deck-progress-bar {
      position: relative;
      height: 0.5rem;
      border-radius: 999px;
      overflow: hidden;
      background: color-mix(in srgb, var(--bg-secondary) 86%, transparent);
    }

    .workspace-task-assist-deck-progress-bar span {
      display: block;
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, color-mix(in srgb, var(--accent-gold, #d3a94f) 90%, transparent), color-mix(in srgb, var(--primary-color) 74%, transparent));
      transition: width 0.18s ease;
    }

    .workspace-task-assist-deck-stage .workspace-task-assist-field {
      min-height: 100%;
      animation: workspace-task-assist-panel-enter 0.2s ease;
    }

    .workspace-task-assist-deck-nav {
      display: flex;
      justify-content: space-between;
      gap: 0.65rem;
      margin-top: 0.85rem;
    }

    .workspace-task-assist-deck-nav .modern-btn {
      min-width: 140px;
      justify-content: center;
    }

    .workspace-task-assist-deck-nav-note {
      color: var(--text-secondary);
      font-size: 0.84rem;
      line-height: 1.5;
      margin-left: auto;
      text-align: right;
    }

    .workspace-task-assist-review {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
      animation: workspace-task-assist-panel-enter 0.2s ease;
    }

    .workspace-task-assist-review-banner {
      padding: 0.85rem 0.95rem;
      border-radius: 18px;
      border: 1px solid color-mix(in srgb, var(--primary-color) 18%, var(--border-color));
      background: color-mix(in srgb, var(--primary-color) 7%, var(--bg-primary));
    }

    .workspace-task-assist-review-title {
      color: var(--text-primary);
      font-size: 0.95rem;
      font-weight: 800;
      line-height: 1.45;
    }

    .workspace-task-assist-review-copy {
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.55;
      margin-top: 0.22rem;
    }

    .workspace-task-assist-review-list {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .workspace-task-assist-review-item {
      padding: 0.85rem 0.95rem;
      border-radius: 18px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 96%, transparent);
    }

    .workspace-task-assist-review-item.is-answered {
      border-color: color-mix(in srgb, #157347 24%, var(--border-color));
      background: color-mix(in srgb, #157347 4%, var(--bg-primary));
    }

    .workspace-task-assist-review-item-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
    }

    .workspace-task-assist-review-item-title {
      min-width: 0;
      display: flex;
      align-items: center;
      gap: 0.55rem;
      color: var(--text-primary);
      font-size: 0.9rem;
      font-weight: 700;
      line-height: 1.45;
    }

    .workspace-task-assist-review-item-number {
      width: 1.7rem;
      height: 1.7rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent-gold, #d3a94f) 18%, transparent);
      color: color-mix(in srgb, var(--accent-gold, #d3a94f) 88%, var(--text-primary));
      font-size: 0.72rem;
      font-weight: 800;
      flex-shrink: 0;
    }

    .workspace-task-assist-review-edit {
      border: none;
      background: none;
      color: var(--primary-color);
      font-size: 0.82rem;
      font-weight: 800;
      padding: 0;
      white-space: nowrap;
    }

    .workspace-task-assist-review-edit:hover {
      text-decoration: underline;
    }

    .workspace-task-assist-review-answer {
      margin-top: 0.5rem;
      color: var(--text-primary);
      font-size: 0.88rem;
      line-height: 1.6;
      padding-left: 2.25rem;
      white-space: pre-wrap;
      word-break: break-word;
    }

    .workspace-task-assist-review-answer.is-empty {
      color: var(--text-secondary);
      font-style: italic;
    }

    .workspace-task-assist-field {
      padding: 0.95rem 1rem;
      border-radius: 20px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    }

    .workspace-task-assist-field.is-active {
      border-color: color-mix(in srgb, var(--primary-color) 36%, var(--border-color));
      box-shadow: 0 14px 30px rgba(10, 10, 10, 0.07);
    }

    .workspace-task-assist-field-question {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.7rem;
      align-items: start;
      margin-bottom: 0.75rem;
    }

    .workspace-task-assist-field-number {
      width: 1.9rem;
      height: 1.9rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--primary-color) 16%, transparent);
      color: var(--primary-color);
      font-size: 0.76rem;
      font-weight: 800;
    }

    .workspace-task-assist-field-prompt {
      color: var(--text-primary);
      font-weight: 700;
      line-height: 1.5;
    }

    .workspace-task-assist-field-hint,
    .workspace-task-assist-field-evidence {
      margin-top: 0.25rem;
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .workspace-task-assist-field-evidence {
      color: color-mix(in srgb, var(--primary-color) 74%, var(--text-secondary));
    }

    .workspace-task-assist-option-group {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
    }

    .workspace-task-assist-option {
      display: block;
      width: 100%;
      padding: 0;
      border: 0;
      background: none;
      text-align: left;
      cursor: pointer;
    }

    .workspace-task-assist-option-input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .workspace-task-assist-option-card {
      display: grid;
      grid-template-columns: auto 1fr;
      gap: 0.7rem;
      align-items: start;
      padding: 0.8rem 0.9rem;
      border-radius: 18px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 96%, transparent);
      transition: transform 0.16s ease, border-color 0.16s ease, box-shadow 0.16s ease;
    }

    .workspace-task-assist-option:hover .workspace-task-assist-option-card {
      transform: translateY(-1px);
      border-color: color-mix(in srgb, var(--primary-color) 34%, var(--border-color));
    }

    .workspace-task-assist-option.is-selected .workspace-task-assist-option-card,
    .workspace-task-assist-option-input:checked + .workspace-task-assist-option-card {
      border-color: color-mix(in srgb, var(--primary-color) 46%, var(--border-color));
      box-shadow: 0 10px 20px rgba(10, 10, 10, 0.08);
      background: color-mix(in srgb, var(--primary-color) 8%, var(--bg-primary));
    }

    .workspace-task-assist-option-key {
      width: 1.8rem;
      height: 1.8rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent-gold, #d3a94f) 18%, transparent);
      color: color-mix(in srgb, var(--accent-gold, #d3a94f) 88%, var(--text-primary));
      font-size: 0.76rem;
      font-weight: 800;
    }

    .workspace-task-assist-option-label {
      display: block;
      color: var(--text-primary);
      font-weight: 700;
      line-height: 1.45;
    }

    .workspace-task-assist-option-badge {
      display: inline-flex;
      align-items: center;
      width: fit-content;
      margin-top: 0.22rem;
      padding: 0.12rem 0.42rem;
      border-radius: 999px;
      border: 1px solid color-mix(in srgb, var(--accent-gold, #d3a94f) 42%, transparent);
      background: color-mix(in srgb, var(--accent-gold, #d3a94f) 14%, transparent);
      color: color-mix(in srgb, var(--accent-gold, #d3a94f) 86%, var(--text-primary));
      font-size: 0.66rem;
      font-weight: 800;
      letter-spacing: 0.04em;
      text-transform: uppercase;
    }

    .workspace-task-assist-option-description {
      display: block;
      margin-top: 0.2rem;
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .workspace-task-assist-custom-input {
      margin-top: 0.8rem;
      padding-top: 0.85rem;
      border-top: 1px solid color-mix(in srgb, var(--border-color) 88%, transparent);
    }

    .workspace-task-assist-actions-primary {
      margin-top: 1.15rem;
    }

    .workspace-task-assist-continue-btn {
      width: 100%;
      justify-content: center;
      padding: 0.7rem 1.2rem;
      font-size: 0.95rem;
    }

    .workspace-task-assist-more-actions {
      margin-top: 0.85rem;
    }

    .workspace-task-assist-more-actions[hidden] {
      display: none;
    }

    .workspace-task-assist-more-content {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
      padding: 0.95rem 1rem;
      border-radius: 20px;
      border: 1px solid color-mix(in srgb, var(--border-color) 92%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    }

    .workspace-task-assist-switch-row {
      display: flex;
      gap: 0.5rem;
      align-items: center;
    }

    .workspace-task-assist-switch-row .form-select {
      flex: 1;
    }

    .workspace-task-assist-secondary-actions {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .workspace-task-assist-fail {
      color: #c23b3b;
      font-size: 0.84rem;
    }

    .workspace-task-assist-fail:hover {
      text-decoration: underline;
    }

    /* Slide-out assist panel */
    .workspace-task-assist-panel {
      position: fixed;
      inset: 0;
      z-index: 1050;
      display: flex;
      justify-content: flex-end;
    }

    .workspace-task-assist-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(10, 10, 10, 0.4);
      opacity: 0;
      transition: opacity 0.25s ease;
    }

    .workspace-task-assist-panel.is-open .workspace-task-assist-backdrop {
      opacity: 1;
    }

    .workspace-task-assist-panel-content {
      position: relative;
      width: min(480px, 92vw);
      height: 100%;
      display: flex;
      flex-direction: column;
      background: var(--bg-primary);
      border-left: 1px solid var(--border-color);
      box-shadow: -12px 0 40px rgba(10, 10, 10, 0.14);
      transform: translateX(100%);
      transition: transform 0.3s cubic-bezier(0.32, 0.72, 0, 1);
    }

    .workspace-task-assist-panel.is-open .workspace-task-assist-panel-content {
      transform: translateX(0);
    }

    .workspace-task-assist-panel-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.25rem 1.35rem;
      border-bottom: 1px solid var(--border-color);
      flex-shrink: 0;
    }

    .workspace-task-assist-panel-header h2 {
      margin: 0.28rem 0 0;
      font-family: "Fraunces", serif;
      font-size: 1.25rem;
      color: var(--text-primary);
    }

    .workspace-task-assist-panel-close {
      flex: 0 0 auto;
      width: 2.2rem;
      height: 2.2rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--border-color);
      border-radius: 999px;
      background: transparent;
      color: var(--text-secondary);
      cursor: pointer;
      transition: color 0.14s ease, border-color 0.14s ease;
    }

    .workspace-task-assist-panel-close:hover {
      color: var(--text-primary);
      border-color: color-mix(in srgb, var(--primary-color) 38%, var(--border-color));
    }

    .workspace-task-assist-panel-body {
      flex: 1;
      overflow-y: auto;
      padding: 1.25rem 1.35rem;
    }

    .workspace-task-page-loading-layout {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }

    .workspace-task-page-loading-card {
      border-radius: 28px;
      background:
        linear-gradient(90deg, color-mix(in srgb, var(--bg-secondary) 84%, transparent), color-mix(in srgb, var(--bg-primary) 94%, transparent), color-mix(in srgb, var(--bg-secondary) 84%, transparent));
      background-size: 220% 100%;
      animation: workspace-task-page-pulse 1.6s linear infinite;
      border: 1px solid color-mix(in srgb, var(--border-color) 90%, transparent);
    }

    .workspace-task-page-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 0.8rem;
      padding: 4rem 1.5rem;
      border-radius: 28px;
      border: 1px solid color-mix(in srgb, var(--border-color) 90%, transparent);
      background: linear-gradient(180deg, color-mix(in srgb, var(--bg-secondary) 82%, transparent), color-mix(in srgb, var(--bg-primary) 94%, transparent));
      text-align: center;
    }

    .workspace-task-page-empty-icon {
      width: 3rem;
      height: 3rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: rgba(194, 59, 59, 0.12);
      color: #c23b3b;
      font-weight: 800;
    }

    .workspace-task-schedule-content {
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .workspace-task-schedule-edit-btn {
      min-height: 2.15rem;
      padding: 0.42rem 0.78rem;
      font-size: 0.8rem;
      gap: 0.38rem;
      white-space: nowrap;
    }

    .workspace-task-schedule-banner {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      gap: 0.75rem;
      align-items: flex-start;
      padding: 0.85rem 0.95rem;
      border-radius: 18px;
      border: 1px solid color-mix(in srgb, #0c63e7 24%, var(--border-color));
      background: color-mix(in srgb, #0c63e7 8%, var(--bg-primary));
    }

    .workspace-task-schedule-banner[data-state="paused"] {
      border-color: color-mix(in srgb, #b26f00 28%, var(--border-color));
      background: color-mix(in srgb, #b26f00 9%, var(--bg-primary));
    }

    .workspace-task-schedule-banner-icon {
      width: 2rem;
      height: 2rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      background: color-mix(in srgb, var(--bg-primary) 90%, transparent);
      color: var(--primary-color);
      flex: 0 0 auto;
    }

    .workspace-task-schedule-banner-title {
      color: var(--text-primary);
      font-weight: 800;
      line-height: 1.35;
    }

    .workspace-task-schedule-banner-copy {
      margin-top: 0.18rem;
      color: var(--text-secondary);
      font-size: 0.88rem;
      line-height: 1.55;
    }

    .workspace-task-trace-list {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
    }

    .workspace-task-runs-tabs {
      display: inline-flex;
      gap: 0.25rem;
      padding: 0.25rem;
      border-radius: 999px;
      border: 1px solid color-mix(in srgb, var(--border-color) 88%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 84%, transparent);
      width: fit-content;
      margin-bottom: 0.85rem;
    }

    .workspace-task-runs-tab {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding: 0.42rem 0.95rem;
      border-radius: 999px;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-size: 0.82rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: background 0.16s ease, color 0.16s ease;
    }

    .workspace-task-runs-tab:hover {
      color: var(--text-primary);
    }

    .workspace-task-runs-tab.is-active {
      background: var(--bg-primary);
      color: var(--primary-color);
      box-shadow: 0 1px 6px rgba(10, 10, 10, 0.08);
    }

    .workspace-task-runs-tab:focus-visible {
      outline: 2px solid color-mix(in srgb, var(--primary-color) 54%, transparent);
      outline-offset: 2px;
    }

    .workspace-task-runs-tab[hidden] {
      display: none;
    }

    .workspace-task-runs-tab-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 1.4rem;
      padding: 0 0.4rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--text-secondary) 18%, transparent);
      color: var(--text-secondary);
      font-size: 0.7rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }

    .workspace-task-runs-tab.is-active .workspace-task-runs-tab-count {
      background: color-mix(in srgb, var(--primary-color) 22%, transparent);
      color: var(--primary-color);
    }

    .workspace-task-tool-summary {
      display: grid;
      gap: 0.65rem;
      margin-bottom: 0.85rem;
      padding: 0.75rem 0.85rem;
      border-radius: 14px;
      border: 1px solid color-mix(in srgb, var(--border-color) 88%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    }

    .workspace-task-tool-summary[hidden] {
      display: none;
    }

    .workspace-task-workspace-runs-list {
      display: grid;
      gap: 0.75rem;
    }

    .workspace-task-workspace-run {
      display: grid;
      gap: 0.55rem;
      padding: 0.85rem 0.9rem;
      border-radius: 14px;
      border: 1px solid color-mix(in srgb, var(--border-color) 88%, transparent);
      background: color-mix(in srgb, var(--bg-primary) 92%, transparent);
    }

    .workspace-task-workspace-run-head {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.8rem;
    }

    .workspace-task-workspace-run-title {
      display: grid;
      gap: 0.2rem;
      min-width: 0;
    }

    .workspace-task-workspace-run-title strong {
      color: var(--text-primary);
      font-size: 0.95rem;
      line-height: 1.35;
    }

    .workspace-task-workspace-run-link {
      color: inherit;
      text-decoration: none;
    }

    .workspace-task-workspace-run-link:hover {
      color: var(--primary-color);
    }

    .workspace-task-workspace-run-meta,
    .workspace-task-workspace-run-summary,
    .workspace-task-workspace-run-id {
      color: var(--text-secondary);
      font-size: 0.84rem;
      line-height: 1.5;
    }

    .workspace-task-workspace-run-id {
      font-family: var(--font-mono, ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", "Courier New", monospace);
      word-break: break-all;
    }

    .workspace-task-workspace-run-status {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      min-width: 5.25rem;
      padding: 0.28rem 0.55rem;
      border-radius: 999px;
      background: color-mix(in srgb, var(--text-secondary) 14%, transparent);
      color: var(--text-secondary);
      font-size: 0.74rem;
      font-weight: 700;
      text-transform: uppercase;
