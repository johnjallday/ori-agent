{{define "models"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">
  <!-- Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h1 class="h3 mb-1">Available Models</h1>
      <p class="text-muted mb-0">Browse all AI models available across different providers</p>
    </div>
    <div class="d-flex gap-2">
      <button id="manageCategoriesBtn" class="btn btn-outline-secondary">
        <i class="bi bi-tags me-2"></i>Manage Categories
      </button>
      <button id="refreshModelsBtn" class="btn btn-outline-primary">
        <i class="bi bi-arrow-clockwise me-2"></i>Refresh
      </button>
    </div>
  </div>

  <!-- Loading State -->
  <div id="loadingState" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
      <span class="visually-hidden">Loading models...</span>
    </div>
    <p class="text-muted mt-3">Loading available models...</p>
  </div>

  <!-- Error State -->
  <div id="errorState" class="alert alert-danger d-none" role="alert">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <span id="errorMessage">Failed to load models. Please try again.</span>
  </div>

  <!-- Models Content -->
  <div id="modelsContent" class="d-none">
    <!-- Filter Bar -->
    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-3 align-items-end">
          <div class="col-md-3">
            <label for="providerFilter" class="form-label" style="color: var(--text-secondary); font-weight: 500;">Provider</label>
            <select id="providerFilter" class="form-select">
              <option value="all">All Providers</option>
            </select>
          </div>
          <div class="col-md-3">
            <label for="categoryFilter" class="form-label" style="color: var(--text-secondary); font-weight: 500;">Category</label>
            <select id="categoryFilter" class="form-select">
              <option value="all">All Categories</option>
            </select>
          </div>
          <div class="col-md-3">
            <label for="searchFilter" class="form-label" style="color: var(--text-secondary); font-weight: 500;">Search</label>
            <input type="text" id="searchFilter" class="form-control" placeholder="Search models..." style="color: var(--text-color);">
          </div>
          <div class="col-md-3">
            <label class="form-label" style="color: var(--text-secondary); font-weight: 500;">View</label>
            <div class="btn-group w-100" role="group">
              <input type="radio" class="btn-check" name="viewToggle" id="viewProvider" value="provider" checked>
              <label class="btn btn-outline-primary" for="viewProvider">By Provider</label>
              <input type="radio" class="btn-check" name="viewToggle" id="viewCategory" value="category">
              <label class="btn btn-outline-primary" for="viewCategory">By Category</label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Provider/Category Sections -->
    <div id="providersContainer">
      <!-- Dynamically populated -->
    </div>

    <!-- No Results -->
    <div id="noResults" class="text-center py-5 d-none">
      <i class="bi bi-search" style="font-size: 3rem; color: var(--muted-text);"></i>
      <p class="text-muted mt-3">No models found matching your filters</p>
    </div>
  </div>
</div>

<!-- Category Management Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Manage Categories</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <span class="text-muted" id="categoryCount">0 / 20 custom categories</span>
          <button id="addCategoryBtn" class="btn btn-primary btn-sm">
            <i class="bi bi-plus me-1"></i>Add Category
          </button>
        </div>
        <div id="categoriesList" class="categories-list">
          <!-- Dynamically populated -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Category Editor Modal -->
<div class="modal fade" id="categoryEditorModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categoryEditorTitle">Add Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="mb-3">
          <label class="form-label">Name</label>
          <input type="text" class="form-control" id="categoryName" placeholder="Enter category name">
          <div class="invalid-feedback" id="categoryNameError"></div>
        </div>
        <div class="mb-3">
          <label class="form-label">Color</label>
          <div class="color-picker-grid" id="colorPicker">
            <!-- Populated by JS -->
          </div>
          <div class="mt-2">
            <label class="form-label small">Custom Color</label>
            <input type="color" class="form-control form-control-color" id="customColor" value="#3b82f6">
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Icon</label>
          <div class="icon-picker-grid" id="iconPicker">
            <!-- Populated by JS -->
          </div>
        </div>
        <div class="mb-3">
          <label class="form-label">Preview</label>
          <div class="category-preview">
            <span class="category-badge-preview" id="categoryPreview">
              <i class="bi bi-code-slash me-1"></i>Category Name
            </span>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveCategoryBtn">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Model Assignment Modal -->
<div class="modal fade" id="assignmentModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Assign Categories</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted mb-3">Select categories for <strong id="assignmentModelName"></strong>:</p>
        <div id="assignmentCategoriesList">
          <!-- Populated by JS -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveAssignmentBtn">Save</button>
      </div>
    </div>
  </div>
</div>

<style>
/* Placeholder text styling */
#searchFilter::placeholder {
  color: var(--text-secondary);
  opacity: 0.6;
}

.dark-mode #searchFilter::placeholder {
  opacity: 0.5;
}

.provider-section, .category-section {
  margin-bottom: 1rem;
}

.provider-header, .category-header {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 8px;
  padding: 1rem 1.25rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  transition: all 0.2s ease;
}

.provider-header:hover, .category-header:hover {
  border-color: var(--primary-color);
  background: rgba(99, 102, 241, 0.05);
}

.provider-header .chevron, .category-header .chevron {
  transition: transform 0.2s ease;
  transform: rotate(180deg);
}

.provider-header.collapsed .chevron, .category-header.collapsed .chevron {
  transform: rotate(0deg);
}

.provider-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.375rem 0.75rem;
  border-radius: 6px;
  font-size: 0.875rem;
  font-weight: 500;
}

.provider-badge.cloud {
  background: #3b82f6;
  color: #ffffff;
}

.dark-mode .provider-badge.cloud {
  background: #2563eb;
  color: #ffffff;
}

.provider-badge.local {
  background: #16a34a;
  color: #ffffff;
}

.dark-mode .provider-badge.local {
  background: #059669;
  color: #ffffff;
}

.models-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  margin-top: 1rem;
  overflow: hidden;
  transition: max-height 0.3s ease, opacity 0.3s ease, margin-top 0.3s ease;
  opacity: 1;
}

.models-list.collapsed {
  max-height: 0 !important;
  opacity: 0;
  margin-top: 0;
}

.model-item {
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  padding: 0.875rem 1rem;
  transition: all 0.15s ease;
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
}

.model-item:hover {
  border-color: var(--primary-color);
  background: rgba(99, 102, 241, 0.05);
}

.model-info {
  display: flex;
  align-items: center;
  gap: 1rem;
  flex: 1;
}

.model-name {
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--text-color);
  font-family: 'SF Mono', 'Monaco', 'Inconsolata', 'Fira Code', monospace;
  min-width: 200px;
}

.model-meta {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  align-items: center;
}

.model-tag {
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  font-size: 0.75rem;
  font-weight: 500;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
}

.model-tag.category {
  background: #7c3aed;
  color: #ffffff;
}

.dark-mode .model-tag.category {
  background: #6d28d9;
  color: #ffffff;
}

.model-tag.price {
  background: #d97706;
  color: #ffffff;
}

.dark-mode .model-tag.price {
  background: #b45309;
  color: #ffffff;
}

.provider-info, .category-info {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.api-key-status {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.25rem 0.5rem;
  border-radius: 4px;
  font-size: 0.75rem;
}

.api-key-status.configured {
  background: #16a34a;
  color: #ffffff;
}

.dark-mode .api-key-status.configured {
  background: #059669;
  color: #ffffff;
}

.api-key-status.missing {
  background: #dc2626;
  color: #ffffff;
}

.dark-mode .api-key-status.missing {
  background: #b91c1c;
  color: #ffffff;
}

/* Category Management Styles */
.categories-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.75rem 1rem;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 6px;
}

.category-item.default {
  background: rgba(99, 102, 241, 0.05);
}

.category-item-info {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}

.category-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 0.75rem;
  border-radius: 6px;
  font-size: 0.875rem;
  font-weight: 500;
  color: #ffffff;
}

.category-item-actions {
  display: flex;
  gap: 0.5rem;
}

.color-picker-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 0.5rem;
}

.color-option {
  width: 32px;
  height: 32px;
  border-radius: 6px;
  cursor: pointer;
  border: 2px solid transparent;
  transition: all 0.15s ease;
}

.color-option:hover {
  transform: scale(1.1);
}

.color-option.selected {
  border-color: var(--primary-color);
  box-shadow: 0 0 0 2px var(--primary-color);
}

.icon-picker-grid {
  display: grid;
  grid-template-columns: repeat(8, 1fr);
  gap: 0.5rem;
}

.icon-option {
  width: 40px;
  height: 40px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 6px;
  cursor: pointer;
  border: 2px solid var(--border-color);
  background: var(--card-bg);
  transition: all 0.15s ease;
}

.icon-option:hover {
  border-color: var(--primary-color);
  background: rgba(99, 102, 241, 0.1);
}

.icon-option.selected {
  border-color: var(--primary-color);
  background: var(--primary-color);
  color: #ffffff;
}

.category-preview {
  padding: 1rem;
  background: var(--card-bg);
  border: 1px solid var(--border-color);
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.category-badge-preview {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.5rem 1rem;
  border-radius: 6px;
  font-size: 1rem;
  font-weight: 500;
  color: #ffffff;
}

/* Assignment Modal */
.assignment-category-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  border: 1px solid var(--border-color);
  border-radius: 6px;
  margin-bottom: 0.5rem;
  cursor: pointer;
  transition: all 0.15s ease;
}

.assignment-category-item:hover {
  border-color: var(--primary-color);
  background: rgba(99, 102, 241, 0.05);
}

.assignment-category-item.selected {
  border-color: var(--primary-color);
  background: rgba(99, 102, 241, 0.1);
}

/* Category Badge in Section Header */
.category-header-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.375rem;
  padding: 0.375rem 0.75rem;
  border-radius: 6px;
  font-size: 0.875rem;
  font-weight: 500;
  color: #ffffff;
}
</style>

<script>
let allProviders = [];
let allCategories = [];
let modelAssignments = {};
let viewPreference = 'provider';
let predefinedColors = [];
let predefinedIcons = [];
let maxCategories = 20;
let editingCategoryId = null;
let selectedColor = '#3b82f6';
let selectedIcon = 'code-slash';
let currentModelId = null;

// Load models and categories on page load
document.addEventListener('DOMContentLoaded', function() {
  loadData();

  // Set up event listeners
  document.getElementById('refreshModelsBtn').addEventListener('click', loadData);
  document.getElementById('manageCategoriesBtn').addEventListener('click', openCategoryModal);
  document.getElementById('providerFilter').addEventListener('change', applyFilters);
  document.getElementById('categoryFilter').addEventListener('change', applyFilters);
  document.getElementById('searchFilter').addEventListener('input', applyFilters);
  document.getElementById('addCategoryBtn').addEventListener('click', openCategoryEditor);
  document.getElementById('saveCategoryBtn').addEventListener('click', saveCategory);
  document.getElementById('saveAssignmentBtn').addEventListener('click', saveAssignment);
  document.getElementById('customColor').addEventListener('input', updateCustomColor);
  document.getElementById('categoryName').addEventListener('input', updatePreview);

  // View toggle
  document.querySelectorAll('input[name="viewToggle"]').forEach(input => {
    input.addEventListener('change', (e) => {
      viewPreference = e.target.value;
      saveViewPreference();
      applyFilters();
    });
  });
});

async function loadData() {
  const loadingState = document.getElementById('loadingState');
  const errorState = document.getElementById('errorState');
  const modelsContent = document.getElementById('modelsContent');

  loadingState.classList.remove('d-none');
  errorState.classList.add('d-none');
  modelsContent.classList.add('d-none');

  try {
    // Load providers and categories in parallel
    const [providersRes, categoriesRes] = await Promise.all([
      fetch('/api/providers'),
      fetch('/api/model-categories')
    ]);

    if (!providersRes.ok) throw new Error('Failed to fetch providers');

    const providersData = await providersRes.json();
    allProviders = providersData.providers || [];

    if (categoriesRes.ok) {
      const categoriesData = await categoriesRes.json();
      allCategories = categoriesData.categories || [];
      modelAssignments = categoriesData.model_assignments || {};
      viewPreference = categoriesData.view_preference || 'provider';
      predefinedColors = categoriesData.predefined_colors || [];
      predefinedIcons = categoriesData.predefined_icons || [];
      maxCategories = categoriesData.max_categories || 20;
    }

    // Set view toggle
    document.getElementById(viewPreference === 'category' ? 'viewCategory' : 'viewProvider').checked = true;

    populateProviderFilter();
    populateCategoryFilter();
    applyFilters();

    loadingState.classList.add('d-none');
    modelsContent.classList.remove('d-none');

  } catch (error) {
    console.error('Error loading data:', error);
    document.getElementById('errorMessage').textContent = error.message;
    loadingState.classList.add('d-none');
    errorState.classList.remove('d-none');
  }
}

function populateProviderFilter() {
  const select = document.getElementById('providerFilter');
  while (select.options.length > 1) select.remove(1);

  allProviders.forEach(provider => {
    const option = document.createElement('option');
    option.value = provider.name;
    option.textContent = provider.display_name;
    select.appendChild(option);
  });
}

function populateCategoryFilter() {
  const select = document.getElementById('categoryFilter');
  while (select.options.length > 1) select.remove(1);

  allCategories.filter(c => !c.is_hidden).forEach(category => {
    const option = document.createElement('option');
    option.value = category.id;
    option.textContent = category.name;
    select.appendChild(option);
  });
}

function applyFilters() {
  const providerFilter = document.getElementById('providerFilter').value;
  const categoryFilter = document.getElementById('categoryFilter').value;
  const searchFilter = document.getElementById('searchFilter').value.toLowerCase();
  const container = document.getElementById('providersContainer');
  const noResults = document.getElementById('noResults');

  container.innerHTML = '';
  let hasResults = false;

  if (viewPreference === 'provider') {
    hasResults = renderByProvider(providerFilter, categoryFilter, searchFilter, container);
  } else {
    hasResults = renderByCategory(providerFilter, categoryFilter, searchFilter, container);
  }

  noResults.classList.toggle('d-none', hasResults);
}

function renderByProvider(providerFilter, categoryFilter, searchFilter, container) {
  let hasResults = false;

  allProviders.forEach(provider => {
    if (providerFilter !== 'all' && provider.name !== providerFilter) return;

    let models = getFilteredModels(provider.models || [], categoryFilter, searchFilter);
    if (models.length === 0) return;

    hasResults = true;
    container.appendChild(createProviderSection(provider, models));
  });

  return hasResults;
}

function renderByCategory(providerFilter, categoryFilter, searchFilter, container) {
  let hasResults = false;
  const visibleCategories = allCategories.filter(c => !c.is_hidden);

  // If filtering by specific category, only show that one
  const categoriesToShow = categoryFilter !== 'all'
    ? visibleCategories.filter(c => c.id === categoryFilter)
    : visibleCategories;

  categoriesToShow.forEach(category => {
    const modelsInCategory = getAllModelsInCategory(category.id, providerFilter, searchFilter);
    if (modelsInCategory.length === 0) return;

    hasResults = true;
    container.appendChild(createCategorySection(category, modelsInCategory));
  });

  // Uncategorized section
  if (categoryFilter === 'all') {
    const uncategorizedModels = getAllUncategorizedModels(providerFilter, searchFilter);
    if (uncategorizedModels.length > 0) {
      hasResults = true;
      container.appendChild(createCategorySection(
        { id: 'uncategorized', name: 'Uncategorized', color: '#6b7280', icon: 'question-circle' },
        uncategorizedModels
      ));
    }
  }

  return hasResults;
}

function getFilteredModels(models, categoryFilter, searchFilter) {
  return models.filter(m => {
    // Category filter
    if (categoryFilter !== 'all') {
      const modelCats = modelAssignments[m.value] || [];
      if (!modelCats.includes(categoryFilter)) return false;
    }
    // Search filter
    if (searchFilter && !m.value.toLowerCase().includes(searchFilter) && !m.label.toLowerCase().includes(searchFilter)) {
      return false;
    }
    return true;
  });
}

function getAllModelsInCategory(categoryId, providerFilter, searchFilter) {
  const models = [];
  allProviders.forEach(provider => {
    if (providerFilter !== 'all' && provider.name !== providerFilter) return;
    (provider.models || []).forEach(model => {
      const cats = modelAssignments[model.value] || [];
      if (!cats.includes(categoryId)) return;
      if (searchFilter && !model.value.toLowerCase().includes(searchFilter)) return;
      models.push({ ...model, providerName: provider.display_name });
    });
  });
  // Dedupe by model value
  const seen = new Set();
  return models.filter(m => {
    if (seen.has(m.value)) return false;
    seen.add(m.value);
    return true;
  });
}

function getAllUncategorizedModels(providerFilter, searchFilter) {
  const models = [];
  allProviders.forEach(provider => {
    if (providerFilter !== 'all' && provider.name !== providerFilter) return;
    (provider.models || []).forEach(model => {
      const cats = modelAssignments[model.value] || [];
      if (cats.length > 0) return;
      if (searchFilter && !model.value.toLowerCase().includes(searchFilter)) return;
      models.push({ ...model, providerName: provider.display_name });
    });
  });
  const seen = new Set();
  return models.filter(m => {
    if (seen.has(m.value)) return false;
    seen.add(m.value);
    return true;
  });
}

function createProviderSection(provider, models) {
  const section = document.createElement('div');
  section.className = 'provider-section';

  const uniqueModels = dedupeModels(models);

  const header = document.createElement('div');
  header.className = 'provider-header';
  header.innerHTML = `
    <div class="provider-info">
      <h2 class="h5 mb-0">${provider.display_name}</h2>
      <span class="provider-badge ${provider.type}">
        <i class="bi bi-${provider.type === 'cloud' ? 'cloud' : 'laptop'}"></i>
        ${provider.type}
      </span>
      ${provider.requires_key ? `
        <span class="api-key-status ${provider.available ? 'configured' : 'missing'}">
          <i class="bi bi-${provider.available ? 'check-circle' : 'exclamation-circle'}"></i>
          ${provider.available ? 'API Key Configured' : 'API Key Required'}
        </span>
      ` : ''}
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <div class="text-muted">${uniqueModels.size} model${uniqueModels.size !== 1 ? 's' : ''}</div>
      <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
        <path d="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"/>
      </svg>
    </div>
  `;
  section.appendChild(header);

  const list = createModelsList(uniqueModels, provider.name);
  section.appendChild(list);
  setupAccordion(header, list);

  return section;
}

function createCategorySection(category, models) {
  const section = document.createElement('div');
  section.className = 'category-section';

  const header = document.createElement('div');
  header.className = 'category-header';
  header.innerHTML = `
    <div class="category-info">
      <span class="category-header-badge" style="background: ${category.color}">
        <i class="bi bi-${category.icon}"></i>
        ${category.name}
      </span>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <div class="text-muted">${models.length} model${models.length !== 1 ? 's' : ''}</div>
      <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
        <path d="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"/>
      </svg>
    </div>
  `;
  section.appendChild(header);

  const list = document.createElement('div');
  list.className = 'models-list';
  models.forEach(model => {
    list.appendChild(createModelItemForCategory(model));
  });
  section.appendChild(list);
  setupAccordion(header, list);

  return section;
}

function dedupeModels(models) {
  const uniqueModels = new Map();
  models.forEach(model => {
    if (!uniqueModels.has(model.value)) {
      uniqueModels.set(model.value, { ...model, categories: [model.type] });
    } else {
      const existing = uniqueModels.get(model.value);
      if (!existing.categories.includes(model.type)) {
        existing.categories.push(model.type);
      }
    }
  });
  return uniqueModels;
}

function createModelsList(uniqueModels, providerName) {
  const list = document.createElement('div');
  list.className = 'models-list';
  uniqueModels.forEach(model => {
    list.appendChild(createModelItem(model, providerName));
  });
  return list;
}

function createModelItem(model, providerName) {
  const item = document.createElement('div');
  item.className = 'model-item';
  item.dataset.modelId = model.value;
  item.dataset.provider = providerName;

  const assignedCats = modelAssignments[model.value] || [];
  const categoryTags = assignedCats.map(catId => {
    const cat = allCategories.find(c => c.id === catId);
    if (!cat) return '';
    return `<span class="model-tag" style="background: ${cat.color}"><i class="bi bi-${cat.icon}"></i>${cat.name}</span>`;
  }).join('');

  item.innerHTML = `
    <div class="model-info">
      <div class="model-name">${model.label}</div>
      <div class="model-meta">${categoryTags || '<span class="text-muted small">Click to assign categories</span>'}</div>
    </div>
    <i class="bi bi-chevron-right text-muted"></i>
  `;

  item.addEventListener('click', () => openAssignmentModal(model.value, model.label));
  return item;
}

function createModelItemForCategory(model) {
  const item = document.createElement('div');
  item.className = 'model-item';
  item.dataset.modelId = model.value;

  item.innerHTML = `
    <div class="model-info">
      <div class="model-name">${model.label}</div>
      <div class="model-meta"><span class="text-muted small">${model.providerName || ''}</span></div>
    </div>
    <i class="bi bi-chevron-right text-muted"></i>
  `;

  item.addEventListener('click', () => openAssignmentModal(model.value, model.label));
  return item;
}

function setupAccordion(header, list) {
  header.addEventListener('click', function() {
    const isCollapsed = list.classList.contains('collapsed');
    if (isCollapsed) {
      list.classList.remove('collapsed');
      header.classList.remove('collapsed');
      list.style.maxHeight = list.scrollHeight + 'px';
    } else {
      list.classList.add('collapsed');
      header.classList.add('collapsed');
      list.style.maxHeight = '0';
    }
  });
  setTimeout(() => { list.style.maxHeight = list.scrollHeight + 'px'; }, 0);
}

// Category Management
function openCategoryModal() {
  renderCategoriesList();
  new bootstrap.Modal(document.getElementById('categoryModal')).show();
}

function renderCategoriesList() {
  const container = document.getElementById('categoriesList');
  const customCount = allCategories.filter(c => !c.is_default).length;
  document.getElementById('categoryCount').textContent = `${customCount} / ${maxCategories} custom categories`;

  container.innerHTML = allCategories.map(cat => `
    <div class="category-item ${cat.is_default ? 'default' : ''}" data-id="${cat.id}">
      <div class="category-item-info">
        <span class="category-badge" style="background: ${cat.color}">
          <i class="bi bi-${cat.icon}"></i>
          ${cat.name}
        </span>
        ${cat.is_default ? '<span class="badge bg-secondary">Default</span>' : ''}
        ${cat.is_hidden ? '<span class="badge bg-warning text-dark">Hidden</span>' : ''}
      </div>
      <div class="category-item-actions">
        ${cat.is_default ? `
          <button class="btn btn-sm btn-outline-secondary" onclick="toggleCategoryVisibility('${cat.id}', ${!cat.is_hidden})">
            <i class="bi bi-${cat.is_hidden ? 'eye' : 'eye-slash'}"></i>
          </button>
        ` : `
          <button class="btn btn-sm btn-outline-primary" onclick="editCategory('${cat.id}')">
            <i class="bi bi-pencil"></i>
          </button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory('${cat.id}')">
            <i class="bi bi-trash"></i>
          </button>
        `}
      </div>
    </div>
  `).join('');
}

function openCategoryEditor(categoryId = null) {
  editingCategoryId = categoryId;
  const category = categoryId ? allCategories.find(c => c.id === categoryId) : null;

  document.getElementById('categoryEditorTitle').textContent = category ? 'Edit Category' : 'Add Category';
  document.getElementById('categoryName').value = category ? category.name : '';
  selectedColor = category ? category.color : predefinedColors[0] || '#3b82f6';
  selectedIcon = category ? category.icon : predefinedIcons[0] || 'code-slash';

  renderColorPicker();
  renderIconPicker();
  updatePreview();

  bootstrap.Modal.getInstance(document.getElementById('categoryModal'))?.hide();
  new bootstrap.Modal(document.getElementById('categoryEditorModal')).show();
}

function renderColorPicker() {
  const container = document.getElementById('colorPicker');
  container.innerHTML = predefinedColors.map(color => `
    <div class="color-option ${color === selectedColor ? 'selected' : ''}"
         style="background: ${color}"
         data-color="${color}"
         onclick="selectColor('${color}')"></div>
  `).join('');
  document.getElementById('customColor').value = selectedColor;
}

function renderIconPicker() {
  const container = document.getElementById('iconPicker');
  container.innerHTML = predefinedIcons.map(icon => `
    <div class="icon-option ${icon === selectedIcon ? 'selected' : ''}"
         data-icon="${icon}"
         onclick="selectIcon('${icon}')">
      <i class="bi bi-${icon}"></i>
    </div>
  `).join('');
}

function selectColor(color) {
  selectedColor = color;
  document.querySelectorAll('.color-option').forEach(el => el.classList.remove('selected'));
  document.querySelector(`.color-option[data-color="${color}"]`)?.classList.add('selected');
  document.getElementById('customColor').value = color;
  updatePreview();
}

function selectIcon(icon) {
  selectedIcon = icon;
  document.querySelectorAll('.icon-option').forEach(el => el.classList.remove('selected'));
  document.querySelector(`.icon-option[data-icon="${icon}"]`)?.classList.add('selected');
  updatePreview();
}

function updateCustomColor(e) {
  selectedColor = e.target.value;
  document.querySelectorAll('.color-option').forEach(el => el.classList.remove('selected'));
  updatePreview();
}

function updatePreview() {
  const name = document.getElementById('categoryName').value || 'Category Name';
  const preview = document.getElementById('categoryPreview');
  preview.innerHTML = `<i class="bi bi-${selectedIcon} me-1"></i>${name}`;
  preview.style.background = selectedColor;
}

async function saveCategory() {
  const name = document.getElementById('categoryName').value.trim();
  if (!name) {
    document.getElementById('categoryName').classList.add('is-invalid');
    document.getElementById('categoryNameError').textContent = 'Name is required';
    return;
  }

  document.getElementById('categoryName').classList.remove('is-invalid');

  try {
    const url = editingCategoryId
      ? `/api/model-categories/${editingCategoryId}`
      : '/api/model-categories';
    const method = editingCategoryId ? 'PUT' : 'POST';

    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, color: selectedColor, icon: selectedIcon })
    });

    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.error || 'Failed to save category');
    }

    bootstrap.Modal.getInstance(document.getElementById('categoryEditorModal')).hide();
    await loadData();
    openCategoryModal();

  } catch (error) {
    document.getElementById('categoryName').classList.add('is-invalid');
    document.getElementById('categoryNameError').textContent = error.message;
  }
}

function editCategory(id) {
  openCategoryEditor(id);
}

async function deleteCategory(id) {
  if (!confirm('Are you sure you want to delete this category?')) return;

  try {
    const response = await fetch(`/api/model-categories/${id}`, { method: 'DELETE' });
    if (!response.ok) throw new Error('Failed to delete category');
    await loadData();
    renderCategoriesList();
  } catch (error) {
    alert(error.message);
  }
}

async function toggleCategoryVisibility(id, hidden) {
  try {
    const response = await fetch(`/api/model-categories/${id}/visibility`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ hidden })
    });
    if (!response.ok) throw new Error('Failed to update visibility');
    await loadData();
    renderCategoriesList();
  } catch (error) {
    alert(error.message);
  }
}

// Model Assignment
function openAssignmentModal(modelId, modelLabel) {
  currentModelId = modelId;
  document.getElementById('assignmentModelName').textContent = modelLabel;

  const container = document.getElementById('assignmentCategoriesList');
  const currentAssignments = modelAssignments[modelId] || [];

  container.innerHTML = allCategories.filter(c => !c.is_hidden).map(cat => `
    <div class="assignment-category-item ${currentAssignments.includes(cat.id) ? 'selected' : ''}"
         data-category-id="${cat.id}"
         onclick="toggleAssignment(this, '${cat.id}')">
      <input type="checkbox" class="form-check-input" ${currentAssignments.includes(cat.id) ? 'checked' : ''}>
      <span class="category-badge" style="background: ${cat.color}">
        <i class="bi bi-${cat.icon}"></i>
        ${cat.name}
      </span>
    </div>
  `).join('');

  new bootstrap.Modal(document.getElementById('assignmentModal')).show();
}

function toggleAssignment(element, categoryId) {
  element.classList.toggle('selected');
  const checkbox = element.querySelector('input[type="checkbox"]');
  checkbox.checked = !checkbox.checked;
}

async function saveAssignment() {
  const selectedCategories = Array.from(
    document.querySelectorAll('.assignment-category-item.selected')
  ).map(el => el.dataset.categoryId);

  try {
    const response = await fetch(`/api/models/${encodeURIComponent(currentModelId)}/categories`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category_ids: selectedCategories })
    });
    if (!response.ok) throw new Error('Failed to save assignments');

    modelAssignments[currentModelId] = selectedCategories;
    bootstrap.Modal.getInstance(document.getElementById('assignmentModal')).hide();
    applyFilters();
  } catch (error) {
    alert(error.message);
  }
}

async function saveViewPreference() {
  try {
    await fetch('/api/model-categories/view-preference', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ preference: viewPreference })
    });
  } catch (error) {
    console.error('Failed to save view preference:', error);
  }
}
