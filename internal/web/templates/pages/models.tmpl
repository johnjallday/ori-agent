}

function createCategorySection(category, models) {
  const section = document.createElement('div');
  section.className = 'category-section';

  const header = document.createElement('div');
  header.className = 'category-header';
  header.innerHTML = `
    <div class="category-info">
      <span class="category-header-badge" style="background: ${category.color}">
        <i class="bi bi-${category.icon}"></i>
        ${category.name}
      </span>
    </div>
    <div style="display: flex; align-items: center; gap: 1rem;">
      <div class="text-muted">${models.length} model${models.length !== 1 ? 's' : ''}</div>
      <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
        <path d="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"/>
      </svg>
    </div>
  `;
  section.appendChild(header);

  const list = document.createElement('div');
  list.className = 'models-list';
  models.forEach(model => {
    list.appendChild(createModelItemForCategory(model));
  });
  section.appendChild(list);
  setupAccordion(header, list);

  return section;
}

function dedupeModels(models) {
  const uniqueModels = new Map();
  models.forEach(model => {
    if (!uniqueModels.has(model.value)) {
      uniqueModels.set(model.value, { ...model, categories: [model.type] });
    } else {
      const existing = uniqueModels.get(model.value);
      if (!existing.categories.includes(model.type)) {
        existing.categories.push(model.type);
      }
    }
  });
  return uniqueModels;
}

function createModelsList(uniqueModels, providerName) {
  const list = document.createElement('div');
  list.className = 'models-list';
  uniqueModels.forEach(model => {
    list.appendChild(createModelItem(model, providerName));
  });
  return list;
}

function createModelItem(model, providerName) {
  const item = document.createElement('div');
  item.className = 'model-item';
  item.style.position = 'relative';
  item.dataset.modelId = model.value;
  item.dataset.provider = providerName;

  const assignedCats = modelAssignments[model.value] || [];
  const categoryTags = assignedCats.map(catId => {
    const cat = allCategories.find(c => c.id === catId);
    if (!cat) return '';
    return `<span class="model-tag" style="background: ${cat.color}"><i class="bi bi-${cat.icon}"></i>${cat.name}</span>`;
  }).join('');

  // Build use-case badges (limit to first 2 for inline display)
  const goodFor = model.good_for || [];
  const useCaseTags = goodFor.slice(0, 2).map(useCase =>
    `<span class="model-tag use-case"><i class="bi bi-check-circle me-1"></i>${useCase}</span>`
  ).join('');
  const moreCount = goodFor.length > 2 ? `<span class="model-tag use-case">+${goodFor.length - 2} more</span>` : '';

  // Pricing badge
  const pricingTag = model.pricing ? `<span class="model-tag pricing"><i class="bi bi-currency-dollar me-1"></i>${model.pricing}</span>` : '';

  // Legacy/Deprecation badge
  let statusTag = '';
  if (model.is_legacy) {
    statusTag = `<span class="model-tag legacy"><i class="bi bi-exclamation-triangle me-1"></i>Legacy</span>`;
  } else if (model.deprecation_date) {
    statusTag = `<span class="model-tag deprecating"><i class="bi bi-clock me-1"></i>Deprecates ${model.deprecation_date}</span>`;
  }

  // Auto-categorize button (only shown if available)
  const autoCatBtn = autoCategorizeAvailable
    ? `<button class="btn btn-outline-primary auto-categorize-btn" onclick="event.stopPropagation(); autoCategorizeModel('${model.value}')" title="Auto-categorize with AI">
         <i class="bi bi-magic"></i>
       </button>`
    : '';

  item.innerHTML = `
    <input type="checkbox" class="form-check-input model-select-checkbox" data-model-id="${model.value}" onclick="event.stopPropagation(); toggleModelSelection('${model.value}', this)">
    <div class="model-info">
      <div class="model-name">${model.label}</div>
      <div class="model-meta">
        ${statusTag}
        ${pricingTag}
        ${categoryTags || ''}
      </div>
      ${goodFor.length > 0 ? `<div class="model-use-cases">${useCaseTags}${moreCount}</div>` : ''}
    </div>
    <div class="d-flex align-items-center gap-2">
      ${autoCatBtn}
      <i class="bi bi-chevron-right text-muted"></i>
    </div>
  `;

  item.addEventListener('click', (e) => {
    if (selectionMode) {
      const checkbox = item.querySelector('.model-select-checkbox');
      checkbox.checked = !checkbox.checked;
      toggleModelSelection(model.value, checkbox);
    } else {
      openAssignmentModal(model.value, model.label);
    }
  });
  return item;
}

