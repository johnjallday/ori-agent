function setupAccordion(header, list) {
  header.addEventListener('click', function() {
    const isCollapsed = list.classList.contains('collapsed');
    if (isCollapsed) {
      list.classList.remove('collapsed');
      header.classList.remove('collapsed');
      list.style.maxHeight = list.scrollHeight + 'px';
    } else {
      list.classList.add('collapsed');
      header.classList.add('collapsed');
      list.style.maxHeight = '0';
    }
  });
  setTimeout(() => { list.style.maxHeight = list.scrollHeight + 'px'; }, 0);
}

// Category Management
function openCategoryModal() {
  renderCategoriesList();
  new bootstrap.Modal(document.getElementById('categoryModal')).show();
}

function renderCategoriesList() {
  const container = document.getElementById('categoriesList');
  const customCount = allCategories.filter(c => !c.is_default).length;
  document.getElementById('categoryCount').textContent = `${customCount} / ${maxCategories} custom categories`;

  container.innerHTML = allCategories.map(cat => `
    <div class="category-item ${cat.is_default ? 'default' : ''}" data-id="${cat.id}">
      <div class="category-item-info">
        <span class="category-badge" style="background: ${cat.color}">
          <i class="bi bi-${cat.icon}"></i>
          ${cat.name}
        </span>
        ${cat.is_default ? '<span class="badge bg-secondary">Default</span>' : ''}
        ${cat.is_hidden ? '<span class="badge bg-warning text-dark">Hidden</span>' : ''}
      </div>
      <div class="category-item-actions">
        ${cat.is_default ? `
          <button class="btn btn-sm btn-outline-secondary" onclick="toggleCategoryVisibility('${cat.id}', ${!cat.is_hidden})">
            <i class="bi bi-${cat.is_hidden ? 'eye' : 'eye-slash'}"></i>
          </button>
        ` : `
          <button class="btn btn-sm btn-outline-primary" onclick="editCategory('${cat.id}')">
            <i class="bi bi-pencil"></i>
          </button>
          <button class="btn btn-sm btn-outline-danger" onclick="deleteCategory('${cat.id}')">
            <i class="bi bi-trash"></i>
          </button>
        `}
      </div>
    </div>
  `).join('');
}

function openCategoryEditor(categoryId = null) {
  editingCategoryId = categoryId;
  const category = categoryId ? allCategories.find(c => c.id === categoryId) : null;

  document.getElementById('categoryEditorTitle').textContent = category ? 'Edit Category' : 'Add Category';
  document.getElementById('categoryName').value = category ? category.name : '';
  selectedColor = category ? category.color : predefinedColors[0] || '#3b82f6';
  selectedIcon = category ? category.icon : predefinedIcons[0] || 'code-slash';

  renderColorPicker();
  renderIconPicker();
  updatePreview();

  bootstrap.Modal.getInstance(document.getElementById('categoryModal'))?.hide();
  new bootstrap.Modal(document.getElementById('categoryEditorModal')).show();
}

function renderColorPicker() {
  const container = document.getElementById('colorPicker');
  container.innerHTML = predefinedColors.map(color => `
    <div class="color-option ${color === selectedColor ? 'selected' : ''}"
         style="background: ${color}"
         data-color="${color}"
         onclick="selectColor('${color}')"></div>
  `).join('');
  document.getElementById('customColor').value = selectedColor;
}

function renderIconPicker() {
  const container = document.getElementById('iconPicker');
  container.innerHTML = predefinedIcons.map(icon => `
    <div class="icon-option ${icon === selectedIcon ? 'selected' : ''}"
         data-icon="${icon}"
         onclick="selectIcon('${icon}')">
      <i class="bi bi-${icon}"></i>
    </div>
  `).join('');
}

function selectColor(color) {
  selectedColor = color;
  document.querySelectorAll('.color-option').forEach(el => el.classList.remove('selected'));
  document.querySelector(`.color-option[data-color="${color}"]`)?.classList.add('selected');
  document.getElementById('customColor').value = color;
  updatePreview();
}

function selectIcon(icon) {
  selectedIcon = icon;
  document.querySelectorAll('.icon-option').forEach(el => el.classList.remove('selected'));
  document.querySelector(`.icon-option[data-icon="${icon}"]`)?.classList.add('selected');
  updatePreview();
}

function updateCustomColor(e) {
  selectedColor = e.target.value;
  document.querySelectorAll('.color-option').forEach(el => el.classList.remove('selected'));
  updatePreview();
}

function updatePreview() {
  const name = document.getElementById('categoryName').value || 'Category Name';
  const preview = document.getElementById('categoryPreview');
  preview.innerHTML = `<i class="bi bi-${selectedIcon} me-1"></i>${name}`;
  preview.style.background = selectedColor;
}

async function saveCategory() {
  const name = document.getElementById('categoryName').value.trim();
  if (!name) {
    document.getElementById('categoryName').classList.add('is-invalid');
    document.getElementById('categoryNameError').textContent = 'Name is required';
    return;
  }

  document.getElementById('categoryName').classList.remove('is-invalid');

  try {
    const url = editingCategoryId
      ? `/api/model-categories/${editingCategoryId}`
      : '/api/model-categories';
    const method = editingCategoryId ? 'PUT' : 'POST';

    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, color: selectedColor, icon: selectedIcon })
    });

    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.error || 'Failed to save category');
    }

    bootstrap.Modal.getInstance(document.getElementById('categoryEditorModal')).hide();
    await loadData();
    openCategoryModal();

  } catch (error) {
    document.getElementById('categoryName').classList.add('is-invalid');
    document.getElementById('categoryNameError').textContent = error.message;
  }
}

function editCategory(id) {
  openCategoryEditor(id);
}

async function deleteCategory(id) {
  if (!confirm('Are you sure you want to delete this category?')) return;

  try {
    const response = await fetch(`/api/model-categories/${id}`, { method: 'DELETE' });
    if (!response.ok) throw new Error('Failed to delete category');
    await loadData();
    renderCategoriesList();
  } catch (error) {
    alert(error.message);
  }
}

async function toggleCategoryVisibility(id, hidden) {
  try {
    const response = await fetch(`/api/model-categories/${id}/visibility`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ hidden })
    });
    if (!response.ok) throw new Error('Failed to update visibility');
    await loadData();
    renderCategoriesList();
  } catch (error) {
    alert(error.message);
  }
}

// Model Assignment
function openAssignmentModal(modelId, modelLabel) {
  currentModelId = modelId;
  document.getElementById('assignmentModelName').textContent = modelLabel;

  const container = document.getElementById('assignmentCategoriesList');
  const currentAssignments = modelAssignments[modelId] || [];

  container.innerHTML = allCategories.filter(c => !c.is_hidden).map(cat => `
    <div class="assignment-category-item ${currentAssignments.includes(cat.id) ? 'selected' : ''}"
         data-category-id="${cat.id}"
         onclick="toggleAssignment(this, '${cat.id}')">
      <input type="checkbox" class="form-check-input" ${currentAssignments.includes(cat.id) ? 'checked' : ''}>
      <span class="category-badge" style="background: ${cat.color}">
        <i class="bi bi-${cat.icon}"></i>
        ${cat.name}
      </span>
    </div>
  `).join('');

  new bootstrap.Modal(document.getElementById('assignmentModal')).show();
}

function toggleAssignment(element, categoryId) {
  element.classList.toggle('selected');
  const checkbox = element.querySelector('input[type="checkbox"]');
  checkbox.checked = !checkbox.checked;
}

async function saveAssignment() {
  const selectedCategories = Array.from(
    document.querySelectorAll('.assignment-category-item.selected')
  ).map(el => el.dataset.categoryId);

  try {
    const response = await fetch(`/api/models/${encodeURIComponent(currentModelId)}/categories`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category_ids: selectedCategories })
    });
    if (!response.ok) throw new Error('Failed to save assignments');

    modelAssignments[currentModelId] = selectedCategories;
    bootstrap.Modal.getInstance(document.getElementById('assignmentModal')).hide();
    applyFilters();
  } catch (error) {
    alert(error.message);
  }
}

async function saveViewPreference() {
  try {
    await fetch('/api/model-categories/view-preference', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ preference: viewPreference })
    });
  } catch (error) {
    console.error('Failed to save view preference:', error);
  }
}

// ===== Auto-Categorize Functions =====

function toggleSelectionMode() {
  selectionMode = !selectionMode;
  const btn = document.getElementById('toggleSelectionBtn');
  const container = document.getElementById('providersContainer');

  if (selectionMode) {
    btn.innerHTML = '<i class="bi bi-x-lg me-2"></i>Cancel';
    btn.classList.remove('btn-outline-secondary');
    btn.classList.add('btn-secondary');
    container.classList.add('selection-mode');
  } else {
    btn.innerHTML = '<i class="bi bi-check2-square me-2"></i>Select';
    btn.classList.remove('btn-secondary');
    btn.classList.add('btn-outline-secondary');
    container.classList.remove('selection-mode');
    clearSelection();
  }
}

function cancelSelection() {
  selectionMode = false;
  const btn = document.getElementById('toggleSelectionBtn');
  btn.innerHTML = '<i class="bi bi-check2-square me-2"></i>Select';
  btn.classList.remove('btn-secondary');
  btn.classList.add('btn-outline-secondary');
  document.getElementById('providersContainer').classList.remove('selection-mode');
  clearSelection();
}

function clearSelection() {
  selectedModels.clear();
  document.querySelectorAll('.model-select-checkbox').forEach(cb => {
    cb.checked = false;
  });
  document.querySelectorAll('.model-item.selected').forEach(item => {
    item.classList.remove('selected');
  });
  updateFloatingBar();
}

function toggleModelSelection(modelId, checkbox) {
  if (checkbox.checked) {
    selectedModels.add(modelId);
    checkbox.closest('.model-item')?.classList.add('selected');
  } else {
    selectedModels.delete(modelId);
    checkbox.closest('.model-item')?.classList.remove('selected');
  }
  updateFloatingBar();
}

function updateFloatingBar() {
  const bar = document.getElementById('floatingActionBar');
  const count = document.getElementById('selectedCount');

  if (selectedModels.size > 0) {
    bar.classList.remove('d-none');
    count.textContent = `${selectedModels.size} model${selectedModels.size !== 1 ? 's' : ''} selected`;
  } else {
    bar.classList.add('d-none');
  }
}

async function autoCategorizeModel(modelId) {
  // Find the button and show loading state
  const btn = document.querySelector(`.model-item[data-model-id="${modelId}"] .auto-categorize-btn`);
  if (btn) {
    btn.classList.add('loading');
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
  }

  try {
    await openAutoCategorizeModal([modelId]);
  } finally {
    if (btn) {
      btn.classList.remove('loading');
      btn.innerHTML = '<i class="bi bi-magic"></i>';
    }
  }
}

async function autoCategorizeSelected() {
  if (selectedModels.size === 0) return;
  await openAutoCategorizeModal(Array.from(selectedModels));
}

async function autoCategorizeAll() {
  // Collect all visible model IDs (respecting current filters)
  const modelIds = [];
  const providerFilter = document.getElementById('providerFilter').value;
  const categoryFilter = document.getElementById('categoryFilter').value;
  const searchFilter = document.getElementById('searchFilter').value.toLowerCase();
  const showLegacy = document.getElementById('showLegacyFilter').checked;

  allProviders.forEach(provider => {
    if (providerFilter !== 'all' && provider.name !== providerFilter) return;
    (provider.models || []).forEach(model => {
      if (!showLegacy && model.is_legacy) return;
      // Apply filters
      if (categoryFilter !== 'all') {
        const modelCats = modelAssignments[model.value] || [];
        if (!modelCats.includes(categoryFilter)) return;
      }
      if (searchFilter && !model.value.toLowerCase().includes(searchFilter)) return;
      if (!modelIds.includes(model.value)) {
        modelIds.push(model.value);
      }
    });
  });

  if (modelIds.length === 0) {
    showToast('No models to categorize', 'warning');
    return;
  }

  // Limit to 50 models max
  const toProcess = modelIds.slice(0, 50);
  if (modelIds.length > 50) {
    showToast(`Processing first 50 of ${modelIds.length} models`, 'info');
  }

  await openAutoCategorizeModal(toProcess);
}

async function openAutoCategorizeModal(modelIds) {
  const modal = new bootstrap.Modal(document.getElementById('autoCategorizeModal'));

  // Reset modal state
  document.getElementById('suggestionsLoading').classList.remove('d-none');
  document.getElementById('suggestionsError').classList.add('d-none');
  document.getElementById('suggestionsList').classList.add('d-none');
  document.getElementById('applySuggestionsBtn').disabled = true;

  modal.show();

  try {
    const response = await fetch('/api/models/auto-categorize', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model_ids: modelIds })
    });

    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.error || 'Failed to generate suggestions');
    }

    const data = await response.json();
    pendingSuggestions = data.suggestions || [];

    renderSuggestions();

    document.getElementById('suggestionsLoading').classList.add('d-none');
    document.getElementById('suggestionsList').classList.remove('d-none');
    document.getElementById('applySuggestionsBtn').disabled = false;

  } catch (error) {
    console.error('Auto-categorize error:', error);
    document.getElementById('suggestionsLoading').classList.add('d-none');
    document.getElementById('suggestionsErrorMessage').textContent = error.message;
    document.getElementById('suggestionsError').classList.remove('d-none');
  }
}

function renderSuggestions() {
  const tbody = document.getElementById('suggestionsTableBody');
  const visibleCategories = allCategories.filter(c => !c.is_hidden);

  tbody.innerHTML = pendingSuggestions.map((suggestion, index) => {
    const confidenceClass = suggestion.confidence >= 0.7 ? 'high' : suggestion.confidence >= 0.4 ? 'medium' : 'low';
    const confidencePercent = Math.round(suggestion.confidence * 100);
    const isChecked = suggestion.confidence >= 0.7;

    // Build category dropdown options
    const categoryOptions = visibleCategories.map(cat =>
      `<option value="${cat.id}" ${cat.id === suggestion.category_id ? 'selected' : ''}>${cat.name}</option>`
    ).join('');

    return `
      <tr class="suggestion-row" data-index="${index}">
        <td>
          <input type="checkbox" class="form-check-input suggestion-checkbox" ${isChecked ? 'checked' : ''} onchange="updateApplyButton()">
        </td>
        <td>
          <code>${suggestion.model_id}</code>
          <div class="text-muted small">${suggestion.reasoning || ''}</div>
        </td>
        <td>
          <span class="text-muted">${suggestion.current_category || 'None'}</span>
        </td>
        <td>
          <select class="form-select form-select-sm suggestion-category" data-index="${index}">
            <option value="">Uncategorized</option>
            ${categoryOptions}
          </select>
        </td>
        <td>
          <span class="confidence-badge ${confidenceClass}">${confidencePercent}%</span>
        </td>
      </tr>
    `;
  }).join('');

  document.getElementById('selectAllSuggestions').checked = pendingSuggestions.some(s => s.confidence >= 0.7);
  updateApplyButton();
}

function toggleAllSuggestions(e) {
  const checked = e.target.checked;
  document.querySelectorAll('.suggestion-checkbox').forEach(cb => {
    cb.checked = checked;
  });
  updateApplyButton();
}

function updateApplyButton() {
  const anyChecked = document.querySelectorAll('.suggestion-checkbox:checked').length > 0;
  document.getElementById('applySuggestionsBtn').disabled = !anyChecked;
}

async function applySuggestions() {
  const btn = document.getElementById('applySuggestionsBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Applying...';

  const rows = document.querySelectorAll('.suggestion-row');
  const toApply = [];

  rows.forEach((row, index) => {
    const checkbox = row.querySelector('.suggestion-checkbox');
    if (!checkbox.checked) return;

    const categorySelect = row.querySelector('.suggestion-category');
    const categoryId = categorySelect.value;
    const modelId = pendingSuggestions[index].model_id;

    if (categoryId) {
      toApply.push({ modelId, categoryId });
    }
  });

  try {
    // Apply each assignment
    for (const { modelId, categoryId } of toApply) {
      const response = await fetch(`/api/models/${encodeURIComponent(modelId)}/categories`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category_ids: [categoryId] })
      });

      if (!response.ok) {
        throw new Error(`Failed to assign category for ${modelId}`);
      }

      // Update local state
      modelAssignments[modelId] = [categoryId];
    }

    // Close modal and refresh
    bootstrap.Modal.getInstance(document.getElementById('autoCategorizeModal')).hide();

    // Clear selection if in selection mode
    if (selectionMode) {
      cancelSelection();
    }

    // Refresh the view
    applyFilters();

    // Show success message
    showToast(`Successfully categorized ${toApply.length} model${toApply.length !== 1 ? 's' : ''}`, 'success');

  } catch (error) {
    console.error('Apply suggestions error:', error);
    showToast(error.message, 'danger');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Apply Selected';
  }
}

function showToast(message, type = 'info') {
  // Create toast container if it doesn't exist
  let container = document.getElementById('toastContainer');
  if (!container) {
    container = document.createElement('div');
    container.id = 'toastContainer';
    container.className = 'toast-container position-fixed bottom-0 end-0 p-3';
    container.style.zIndex = '1100';
    document.body.appendChild(container);
  }

  const toast = document.createElement('div');
  toast.className = `toast align-items-center text-bg-${type} border-0`;
  toast.setAttribute('role', 'alert');
  toast.innerHTML = `
    <div class="d-flex">
      <div class="toast-body">${message}</div>
      <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
    </div>
  `;
  container.appendChild(toast);

  const bsToast = new bootstrap.Toast(toast, { autohide: true, delay: 3000 });
  bsToast.show();

  toast.addEventListener('hidden.bs.toast', () => toast.remove());
}
</script>

