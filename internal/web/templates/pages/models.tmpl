{{define "models"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light models-page">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">
  <!-- Header -->
  <div class="ui-page-header">
    <div>
      <h1>Available Models</h1>
      <p class="text-muted mb-0">Browse all AI models available across different providers</p>
    </div>
    <div class="ui-actions">
      <button id="autoCategorizeAllBtn" class="btn btn-outline-primary d-none" title="Auto-categorize all models with AI">
        <i class="bi bi-magic me-2"></i>Auto-Categorize
      </button>
      <button id="manageCategoriesBtn" class="btn btn-outline-secondary">
        <i class="bi bi-tags me-2"></i>Manage Categories
      </button>
      <button id="refreshModelsBtn" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-clockwise me-2"></i>Refresh
      </button>
    </div>
  </div>

  <!-- Loading State -->
  <div id="loadingState" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
      <span class="visually-hidden">Loading models...</span>
    </div>
    <p class="text-muted mt-3">Loading available models...</p>
  </div>

  <!-- Error State -->
  <div id="errorState" class="alert alert-danger d-none" role="alert">
    <i class="bi bi-exclamation-triangle me-2"></i>
    <span id="errorMessage">Failed to load models. Please try again.</span>
  </div>

  <!-- Models Content -->
  <div id="modelsContent" class="d-none">
    <!-- Filter Bar -->
    <div class="card mb-4">
      <div class="card-body">
        <div class="row g-3 align-items-start">
          <div class="col-md-3">
            <label for="providerFilter" class="form-label" style="color: var(--text-secondary); font-weight: 500;">Provider</label>
            <select id="providerFilter" class="form-select">
              <option value="all">All Providers</option>
            </select>
          </div>
          <div class="col-md-3">
            <label for="categoryFilter" class="form-label" style="color: var(--text-secondary); font-weight: 500;">Category</label>
            <select id="categoryFilter" class="form-select">
              <option value="all">All Categories</option>
            </select>
          </div>
          <div class="col-md-3">
            <label for="searchFilter" class="form-label" style="color: var(--text-secondary); font-weight: 500;">Search</label>
            <input type="text" id="searchFilter" class="form-control" placeholder="Search models..." style="color: var(--text-color);">
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="showLegacyFilter">
              <label class="form-check-label" for="showLegacyFilter" style="color: var(--text-secondary); font-size: 0.875rem;">
                Show Legacy models
              </label>
            </div>
          </div>
          <div class="col-md-3">
            <div id="modelsViewLabel" class="form-label">View</div>
            <div class="btn-group w-100" role="group" aria-labelledby="modelsViewLabel">
              <input type="radio" class="btn-check" name="viewToggle" id="viewProvider" value="provider" checked>
              <label class="btn btn-outline-secondary" for="viewProvider">By Provider</label>
              <input type="radio" class="btn-check" name="viewToggle" id="viewCategory" value="category">
              <label class="btn btn-outline-secondary" for="viewCategory">By Category</label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Provider/Category Sections -->
    <div id="providersContainer">
      <!-- Dynamically populated -->
    </div>

    <!-- No Results -->
    <div id="noResults" class="text-center py-5 d-none">
      <i class="bi bi-search" style="font-size: 3rem; color: var(--muted-text);"></i>
      <p class="text-muted mt-3">No models found matching your filters</p>
    </div>
  </div>
</div>

<!-- Category Management Modal -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalTitle">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categoryModalTitle">Manage Categories</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <div class="ui-actions justify-content-between mb-3">
          <span class="text-muted" id="categoryCount">0 / 20 custom categories</span>
          <button id="addCategoryBtn" class="btn btn-primary btn-sm">
            <i class="bi bi-plus me-1"></i>Add Category
          </button>
        </div>
        <div id="categoriesList" class="categories-list">
          <!-- Dynamically populated -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Category Editor Modal -->
<div class="modal fade" id="categoryEditorModal" tabindex="-1" aria-labelledby="categoryEditorTitle">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="categoryEditorTitle">Add Category</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <form class="modal-body" id="categoryEditorForm" novalidate>
        <div class="mb-3">
          <label for="categoryName" class="form-label">Name</label>
          <input type="text" class="form-control" id="categoryName" required maxlength="50" aria-describedby="categoryNameError" placeholder="Enter category name">
          <div class="invalid-feedback" id="categoryNameError"></div>
        </div>
        <div class="mb-3">
          <div id="categoryColorLabel" class="form-label">Color</div>
          <div class="color-picker-grid" id="colorPicker" role="group" aria-labelledby="categoryColorLabel">
            <!-- Populated by JS -->
          </div>
          <div class="mt-2">
            <label for="customColor" class="form-label models-custom-color">
              <span>Custom Color</span>
              <input type="color" class="form-control form-control-color" id="customColor" value="#3b82f6">
            </label>
          </div>
        </div>
        <div class="mb-3">
          <div id="categoryIconLabel" class="form-label">Icon</div>
          <div class="icon-picker-grid" id="iconPicker" role="group" aria-labelledby="categoryIconLabel">
            <!-- Populated by JS -->
          </div>
        </div>
        <div class="mb-3">
          <div class="form-label">Preview</div>
          <div class="category-preview">
            <span class="badge category-badge-preview category-swatch-badge" id="categoryPreview">
              <i class="bi bi-code-slash me-1"></i>Category Name
            </span>
          </div>
        </div>
      </form>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" form="categoryEditorForm" class="btn btn-primary" id="saveCategoryBtn">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Shared Modals (Add Agent, Marketplace, etc.) -->
{{template "modals.tmpl" .}}

<!-- Model Assignment Modal -->
<div class="modal fade" id="assignmentModal" tabindex="-1" aria-labelledby="assignmentModalTitle">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="assignmentModalTitle">Assign Categories</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted mb-3">Select categories for <strong id="assignmentModelName"></strong>:</p>
        <div id="assignmentCategoriesList">
          <!-- Populated by JS -->
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="saveAssignmentBtn">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Floating Action Bar for Bulk Actions -->
<div id="floatingActionBar" class="floating-action-bar d-none">
  <div class="ui-actions">
    <span id="selectedCount">0 models selected</span>
    <button id="autoCategorizeSelectedBtn" class="btn btn-primary btn-sm">
      <i class="bi bi-magic me-1"></i>Auto-Categorize Selected
    </button>
    <button id="cancelSelectionBtn" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-x-lg me-1"></i>Cancel
    </button>
  </div>
</div>

<!-- Auto-Categorize Preview Modal -->
<div class="modal fade" id="autoCategorizeModal" tabindex="-1" aria-labelledby="autoCategorizeTitle">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="autoCategorizeTitle">
          <i class="bi bi-magic me-2"></i>Auto-Categorize Preview
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <p class="text-muted mb-3">Review AI suggestions before applying. You can modify or exclude any suggestion.</p>
        <div id="suggestionsLoading" class="text-center py-4">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Generating suggestions...</span>
          </div>
          <p class="text-muted mt-2">Analyzing models...</p>
        </div>
        <div id="suggestionsError" class="alert alert-danger d-none">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <span id="suggestionsErrorMessage">Failed to generate suggestions</span>
        </div>
        <div id="suggestionsList" class="d-none models-table-scroll" role="region" aria-label="Suggested model categories" tabindex="0">
          <table class="table table-hover">
            <thead>
              <tr>
                <th style="width: 40px;">
                  <label class="models-checkbox-target"><input type="checkbox" class="form-check-input" id="selectAllSuggestions" aria-label="Select all suggestions" checked></label>
                </th>
                <th>Model</th>
                <th>Current</th>
                <th>Suggested</th>
                <th>Confidence</th>
              </tr>
            </thead>
            <tbody id="suggestionsTableBody">
              <!-- Populated by JS -->
            </tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-primary" id="applySuggestionsBtn" disabled>
          <i class="bi bi-check2 me-1"></i>Apply Selected
        </button>
      </div>
    </div>
  </div>
</div>

<style>
/* Models owns collection geometry; shared components own field/control states. */
.models-page .main-content-wrapper { background: var(--bg-primary); }
.models-page .modal-title { overflow-wrap: anywhere; }
.models-table-scroll { max-width: 100%; overflow: auto; }
.models-table-scroll table { min-width: 38rem; }
.suggestion-row code { white-space: normal; overflow-wrap: anywhere; }
.models-checkbox-target { display: inline-flex; align-items: center; justify-content: center; min-width: var(--touch-target); min-height: var(--touch-target); }
.models-section-heading { margin: 0; }
.models-custom-color { display: inline-flex; align-items: center; gap: var(--space-2); min-height: var(--touch-target); }
.provider-title { font: 600 1rem var(--font-body); min-width: 0; max-width: 100%; overflow-wrap: anywhere; }

.provider-section, .category-section {
  margin-bottom: 1rem;
}

.provider-header, .category-header {
  flex-wrap: wrap;
  gap: 0.75rem;
  width: 100%;
  background: var(--surface-solid);
  color: var(--text-primary);
  border: 1px solid var(--control-border);
  border-radius: var(--radius-lg);
  padding: var(--space-4);
  display: flex;
  align-items: center;
  justify-content: space-between;
  text-align: left;
  font: 400 1rem var(--font-body);
  cursor: pointer;
}

.provider-header:hover, .category-header:hover {
  background: var(--bg-secondary);
}

.provider-header .chevron, .category-header .chevron {
  transition: transform 0.2s ease;
  transform: rotate(180deg);
}

.provider-header.collapsed .chevron, .category-header.collapsed .chevron {
  transform: rotate(0deg);
}

/* Shared .badge owns padding, weight, line height and pill geometry. */
.provider-badge, .model-tag, .api-key-status, .category-badge,
.category-badge-preview, .category-header-badge, .confidence-badge {
  display: inline-flex;
  align-items: center;
  gap: var(--space-1);
  max-width: 100%;
  white-space: normal;
  overflow-wrap: anywhere;
  border: 1px solid var(--border-color);
  font-size: 0.8125rem;
}
.provider-badge.cloud { color: var(--info-text); }
.provider-badge.local { color: var(--success-text); }

.models-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  margin-top: var(--space-3);
}

.model-item {
  position: relative;
  background: var(--surface-solid);
  border: 1px solid var(--border-color);
  border-radius: var(--radius-lg);
  padding: var(--space-3) var(--space-4);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  cursor: pointer;
}
.model-item:hover { border-color: var(--control-border); }
.model-info {
  min-width: 0;
  min-height: var(--control-height);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--space-2);
  flex: 1 1 12rem;
  padding: 0;
  border: 0;
  background: transparent;
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.model-name {
  font-size: 0.9375rem;
  font-weight: 500;
  color: var(--text-color);
  font-family: var(--font-mono);
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
}

.model-meta {
  min-width: 0;
  max-width: 100%;
  overflow-wrap: anywhere;
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  align-items: center;
}

.model-tag.category, .model-tag.pricing { color: var(--info-text); }
.model-tag.price { color: var(--warning-text); }
.model-tag.use-case { color: var(--success-text); }

.model-use-cases {
  display: flex;
  flex-wrap: wrap;
  gap: 0.25rem;
  margin-top: 0.25rem;
}

.model-tag.legacy { color: var(--danger-text); }
.model-tag.deprecating { color: var(--warning-text); }

.provider-info, .category-info {
  min-width: 0;
  overflow-wrap: anywhere;
  flex-wrap: wrap;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.api-key-status.configured { color: var(--success-text); }
.api-key-status.missing { color: var(--warning-text); }

/* Category Management Styles */
.categories-list {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.category-item {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
  padding-block: var(--space-3);
  border-bottom: 1px solid var(--border-color);
}

.category-item-info {
  display: flex;
  flex-wrap: wrap;
  min-width: 0;
  align-items: center;
  gap: var(--space-2);
}

.category-badge, .category-badge-preview, .category-header-badge {
  gap: var(--space-2);
  font-size: 0.875rem;
  color: var(--text-primary);
}
.category-swatch-badge::before {
  content: '';
  flex: 0 0 0.75rem;
  width: 0.75rem;
  height: 0.75rem;
  border: 1px solid var(--control-border);
  border-radius: 2px;
  background: var(--category-color);
}

.category-item-actions {
  display: flex;
  gap: 0.5rem;
}

.color-picker-grid, .icon-picker-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(var(--touch-target), 1fr));
  gap: var(--space-2);
}

.color-option, .icon-option {
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: var(--space-2);
  border-radius: var(--radius-sm);
  cursor: pointer;
  border: 1px solid var(--control-border);
  background: var(--bg-secondary);
  color: var(--text-primary);
}
.color-option::before {
  content: '';
  width: 1.25rem;
  height: 1.25rem;
  border: 1px solid var(--control-border);
  border-radius: 2px;
  background: var(--category-color);
}
.color-option.selected, .icon-option.selected {
  border-color: var(--focus-color);
  box-shadow: inset 0 0 0 1px var(--focus-color);
}
.color-option:hover, .icon-option:hover { border-color: var(--focus-color); }

.category-preview { display: flex; min-width: 0; }

/* Assignment Modal */
.assignment-category-item {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.75rem;
  border: 1px solid var(--control-border);
  border-radius: var(--radius-sm);
  margin-bottom: var(--space-2);
  cursor: pointer;
}

.assignment-category-item:hover { background: var(--bg-secondary); }
.assignment-category-item.selected { border-color: var(--focus-color); }
.assignment-category-item input { flex-shrink: 0; }

/* Floating Action Bar */
.floating-action-bar {
  position: fixed;
  bottom: var(--space-4);
  left: var(--space-4);
  right: var(--space-4);
  width: fit-content;
  max-width: calc(100% - 2rem);
  margin-inline: auto;
  background: var(--surface-solid);
  color: var(--text-primary);
  border: 1px solid var(--control-border);
  padding: var(--space-3) var(--space-4);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-md);
  z-index: 1050;
}

/* Auto-categorize button on model items */
.auto-categorize-btn { flex-shrink: 0; }

.auto-categorize-btn.loading {
  pointer-events: none;
}

/* Hidden selection controls must also leave the keyboard tab order. */
.model-select-label {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  min-width: var(--touch-target);
  min-height: var(--touch-target);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}
.selection-mode .model-item { padding-left: 3rem; }
.model-item.selected { border-color: var(--focus-color); }
@media (max-width: 768px), (pointer: coarse) {
  .model-info { min-height: var(--touch-target); }
}

/* Confidence indicator */
.confidence-badge.high { color: var(--success-text); }
.confidence-badge.medium { color: var(--warning-text); }
.confidence-badge.low { color: var(--text-secondary); }

/* Suggestion row highlight animation */
.suggestion-row.applied {
  animation: highlightApplied 1s ease;
}

@keyframes highlightApplied {
  0% { background: rgba(34, 197, 94, 0.3); }
  100% { background: transparent; }
}
</style>

<script>
let allProviders = [];
let allCategories = [];
let modelAssignments = {};
let viewPreference = 'provider';
let predefinedColors = [];
let predefinedIcons = [];
let maxCategories = 20;
let editingCategoryId = null;
let selectedColor = '#3b82f6';
let selectedIcon = 'code-slash';
let currentModelId = null;
let modelsAccordionSequence = 0;

// Auto-categorize state
let autoCategorizeAvailable = false;
let selectionMode = false;
let selectedModels = new Set();
let pendingSuggestions = [];

// Load models and categories on page load
document.addEventListener('DOMContentLoaded', function() {
  loadData();

  // Set up event listeners
  document.getElementById('refreshModelsBtn').addEventListener('click', loadData);
  document.getElementById('manageCategoriesBtn').addEventListener('click', openCategoryModal);
  document.getElementById('providerFilter').addEventListener('change', applyFilters);
  document.getElementById('categoryFilter').addEventListener('change', applyFilters);
  document.getElementById('searchFilter').addEventListener('input', applyFilters);
  document.getElementById('showLegacyFilter').addEventListener('change', applyFilters);
  document.getElementById('addCategoryBtn').addEventListener('click', event => openCategoryEditor(null, event.currentTarget));
  document.getElementById('categoryEditorForm').addEventListener('submit', event => {
    event.preventDefault();
    saveCategory();
  });
  document.getElementById('saveAssignmentBtn').addEventListener('click', saveAssignment);
  document.getElementById('customColor').addEventListener('input', updateCustomColor);
  document.getElementById('categoryName').addEventListener('input', updateCategoryName);

  // View toggle
  document.querySelectorAll('input[name="viewToggle"]').forEach(input => {
    input.addEventListener('change', async event => {
      const previous = viewPreference;
      viewPreference = event.target.value;
      const toggles = document.querySelectorAll('input[name="viewToggle"]');
      toggles.forEach(toggle => { toggle.disabled = true; });
      applyFilters();
      if (!await saveViewPreference()) {
        viewPreference = previous;
        document.getElementById(previous === 'category' ? 'viewCategory' : 'viewProvider').checked = true;
        applyFilters();
      }
      toggles.forEach(toggle => { toggle.disabled = false; });
    });
  });

  // Auto-categorize
  document.getElementById('autoCategorizeAllBtn').addEventListener('click', autoCategorizeAll);
  document.getElementById('cancelSelectionBtn').addEventListener('click', cancelSelection);
  document.getElementById('autoCategorizeSelectedBtn').addEventListener('click', autoCategorizeSelected);
  document.getElementById('selectAllSuggestions').addEventListener('change', toggleAllSuggestions);
  document.getElementById('applySuggestionsBtn').addEventListener('click', applySuggestions);
});

async function loadData() {
  const loadingState = document.getElementById('loadingState');
  const errorState = document.getElementById('errorState');
  const modelsContent = document.getElementById('modelsContent');

  loadingState.classList.remove('d-none');
  errorState.classList.add('d-none');
  modelsContent.classList.add('d-none');
  document.getElementById('manageCategoriesBtn').disabled = true;
  autoCategorizeAvailable = false;
  document.getElementById('autoCategorizeAllBtn').classList.add('d-none');

  try {
    // Load providers, categories, and auto-categorize availability in parallel
    const [providersRes, categoriesRes, autoCatRes] = await Promise.all([
      fetch('/api/providers'),
      fetch('/api/model-categories'),
      fetch('/api/models/auto-categorize/availability')
    ]);

    // Check auto-categorize availability
    if (autoCatRes.ok) {
      const autoCatData = await autoCatRes.json();
      autoCategorizeAvailable = autoCatData.available === true;
      // Show/hide auto-categorize button based on availability
      document.getElementById('autoCategorizeAllBtn').classList.toggle('d-none', !autoCategorizeAvailable);
    }

    if (!providersRes.ok) throw new Error('Failed to fetch providers');
    if (!categoriesRes.ok) throw new Error('Failed to fetch categories');

    const providersData = await providersRes.json();
    allProviders = providersData.providers || [];

    if (categoriesRes.ok) {
      const categoriesData = await categoriesRes.json();
      allCategories = categoriesData.categories || [];
      modelAssignments = categoriesData.model_assignments || {};
      viewPreference = categoriesData.view_preference || 'provider';
      predefinedColors = categoriesData.predefined_colors || [];
      predefinedIcons = categoriesData.predefined_icons || [];
      maxCategories = categoriesData.max_categories || 20;
    }

    // Set view toggle
    document.getElementById(viewPreference === 'category' ? 'viewCategory' : 'viewProvider').checked = true;

    populateProviderFilter();
    populateCategoryFilter();
    applyFilters();

    loadingState.classList.add('d-none');
    modelsContent.classList.remove('d-none');
    document.getElementById('manageCategoriesBtn').disabled = false;
    return true;

  } catch (error) {
    console.error('Error loading data:', error);
    document.getElementById('errorMessage').textContent = error.message;
    loadingState.classList.add('d-none');
    errorState.classList.remove('d-none');
    autoCategorizeAvailable = false;
    document.getElementById('autoCategorizeAllBtn').classList.add('d-none');
    return false;
  }
}

function populateProviderFilter() {
  const select = document.getElementById('providerFilter');
  while (select.options.length > 1) select.remove(1);

  allProviders.forEach(provider => {
    const option = document.createElement('option');
    option.value = provider.name;
    option.textContent = provider.display_name;
    select.appendChild(option);
  });
}

function populateCategoryFilter() {
  const select = document.getElementById('categoryFilter');
  while (select.options.length > 1) select.remove(1);

  allCategories.filter(c => !c.is_hidden).forEach(category => {
    const option = document.createElement('option');
    option.value = category.id;
    option.textContent = category.name;
    select.appendChild(option);
  });
}

function applyFilters() {
  const providerFilter = document.getElementById('providerFilter').value;
  const categoryFilter = document.getElementById('categoryFilter').value;
  const searchFilter = document.getElementById('searchFilter').value.toLowerCase();
  const showLegacy = document.getElementById('showLegacyFilter').checked;
  const container = document.getElementById('providersContainer');
  const noResults = document.getElementById('noResults');

  container.innerHTML = '';
  let hasResults = false;

  if (viewPreference === 'provider') {
    hasResults = renderByProvider(providerFilter, categoryFilter, searchFilter, showLegacy, container);
  } else {
    hasResults = renderByCategory(providerFilter, categoryFilter, searchFilter, showLegacy, container);
  }

  noResults.classList.toggle('d-none', hasResults);
}

function renderByProvider(providerFilter, categoryFilter, searchFilter, showLegacy, container) {
  let hasResults = false;

  allProviders.forEach(provider => {
    if (providerFilter !== 'all' && provider.name !== providerFilter) return;

    let models = getFilteredModels(provider.models || [], categoryFilter, searchFilter, showLegacy);
    if (models.length === 0) return;

    hasResults = true;
    container.appendChild(createProviderSection(provider, models));
  });

  return hasResults;
}

function renderByCategory(providerFilter, categoryFilter, searchFilter, showLegacy, container) {
  let hasResults = false;
  const visibleCategories = allCategories.filter(c => !c.is_hidden);

  // If filtering by specific category, only show that one
  const categoriesToShow = categoryFilter !== 'all'
    ? visibleCategories.filter(c => c.id === categoryFilter)
    : visibleCategories;

  categoriesToShow.forEach(category => {
    const modelsInCategory = getAllModelsInCategory(category.id, providerFilter, searchFilter, showLegacy);
    if (modelsInCategory.length === 0) return;

    hasResults = true;
    container.appendChild(createCategorySection(category, modelsInCategory));
  });

  // Uncategorized section
  if (categoryFilter === 'all') {
    const uncategorizedModels = getAllUncategorizedModels(providerFilter, searchFilter, showLegacy);
    if (uncategorizedModels.length > 0) {
      hasResults = true;
      container.appendChild(createCategorySection(
        { id: 'uncategorized', name: 'Uncategorized', color: '#6b7280', icon: 'question-circle' },
        uncategorizedModels
      ));
    }
  }

  return hasResults;
}

function getFilteredModels(models, categoryFilter, searchFilter, showLegacy) {
  return models.filter(m => {
    if (!showLegacy && m.is_legacy) return false;

    // Category filter
    if (categoryFilter !== 'all') {
      const modelCats = modelAssignments[m.value] || [];
      if (!modelCats.includes(categoryFilter)) return false;
    }
    // Search filter
    if (searchFilter && !m.value.toLowerCase().includes(searchFilter) && !m.label.toLowerCase().includes(searchFilter)) {
      return false;
    }
    return true;
  });
}

function getAllModelsInCategory(categoryId, providerFilter, searchFilter, showLegacy) {
  const models = [];
  allProviders.forEach(provider => {
    if (providerFilter !== 'all' && provider.name !== providerFilter) return;
    (provider.models || []).forEach(model => {
      if (!showLegacy && model.is_legacy) return;
      const cats = modelAssignments[model.value] || [];
      if (!cats.includes(categoryId)) return;
      if (searchFilter && !model.value.toLowerCase().includes(searchFilter)) return;
      models.push({ ...model, providerName: provider.display_name });
    });
  });
  // Dedupe by model value
  const seen = new Set();
  return models.filter(m => {
    if (seen.has(m.value)) return false;
    seen.add(m.value);
    return true;
  });
}

function getAllUncategorizedModels(providerFilter, searchFilter, showLegacy) {
  const models = [];
  allProviders.forEach(provider => {
    if (providerFilter !== 'all' && provider.name !== providerFilter) return;
    (provider.models || []).forEach(model => {
      if (!showLegacy && model.is_legacy) return;
      const cats = modelAssignments[model.value] || [];
      if (cats.length > 0) return;
      if (searchFilter && !model.value.toLowerCase().includes(searchFilter)) return;
      models.push({ ...model, providerName: provider.display_name });
    });
  });
  const seen = new Set();
  return models.filter(m => {
    if (seen.has(m.value)) return false;
    seen.add(m.value);
    return true;
  });
}

function modelsEscapeHTML(value) {
  return String(value ?? '').replace(/[&<>"']/g, char => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]);
}

function modelsColor(color) {
  return /^#[0-9a-f]{6}$/i.test(color) ? color : '#3b82f6';
}

function modelsIcon(icon) {
  return /^[a-z0-9-]{1,50}$/i.test(icon) ? icon : 'tag';
}

function categoryBadgeMarkup(category, className = 'category-badge') {
  return `<span class="badge ${className} category-swatch-badge" style="--category-color: ${modelsColor(category.color)}"><i class="bi bi-${modelsIcon(category.icon)}" aria-hidden="true"></i>${modelsEscapeHTML(category.name)}</span>`;
}

function modelsSectionHeader(section, className, content, count) {
  const heading = document.createElement('h2');
  heading.className = 'models-section-heading';
  const header = document.createElement('button');
  header.type = 'button';
  header.className = className;
  header.innerHTML = `${content}<span class="ui-actions"><span class="text-muted">${count} model${count !== 1 ? 's' : ''}</span><i class="bi bi-chevron-down chevron" aria-hidden="true"></i></span>`;
  heading.appendChild(header);
  section.appendChild(heading);
  return header;
}

function createProviderSection(provider, models) {
  const section = document.createElement('section');
  section.className = 'provider-section';
  const uniqueModels = dedupeModels(models);
  const header = modelsSectionHeader(section, 'provider-header', `
    <span class="provider-info">
      <span class="provider-title">${modelsEscapeHTML(provider.display_name)}</span>
      <span class="badge provider-badge ${provider.type === 'cloud' ? 'cloud' : provider.type === 'local' ? 'local' : ''}">
        <i class="bi bi-${provider.type === 'cloud' ? 'cloud' : 'laptop'}" aria-hidden="true"></i>${modelsEscapeHTML(provider.type)}
      </span>
      ${provider.requires_key ? `<span class="badge api-key-status ${provider.available ? 'configured' : 'missing'}"><i class="bi bi-${provider.available ? 'check-circle' : 'exclamation-circle'}" aria-hidden="true"></i>${provider.available ? 'API Key Configured' : 'API Key Required'}</span>` : ''}
    </span>`, uniqueModels.size);
  const list = createModelsList(uniqueModels, provider.name);
  section.appendChild(list);
  setupAccordion(header, list);
  return section;
}

function createCategorySection(category, models) {
  const section = document.createElement('section');
  section.className = 'category-section';
  const header = modelsSectionHeader(section, 'category-header', `<span class="category-info">${categoryBadgeMarkup(category, 'category-header-badge')}</span>`, models.length);
  const list = document.createElement('div');
  list.className = 'models-list';
  models.forEach(model => list.appendChild(createModelItemForCategory(model)));
  section.appendChild(list);
  setupAccordion(header, list);
  return section;
}

function dedupeModels(models) {
  const uniqueModels = new Map();
  models.forEach(model => {
    if (!uniqueModels.has(model.value)) {
      uniqueModels.set(model.value, model);
    }
  });
  return uniqueModels;
}

function createModelsList(uniqueModels, providerName) {
  const list = document.createElement('div');
  list.className = 'models-list';
  uniqueModels.forEach(model => {
    list.appendChild(createModelItem(model, providerName));
  });
  return list;
}

function createModelItem(model, providerName, categoryView = false) {
  const item = document.createElement('div');
  item.className = 'model-item';
  item.dataset.modelId = model.value;
  if (providerName) item.dataset.provider = providerName;
  const selected = selectedModels.has(model.value);
  item.classList.toggle('selected', selected);
  const categoryTags = (modelAssignments[model.value] || []).map(catId => {
    const cat = allCategories.find(c => c.id === catId);
    return cat ? categoryBadgeMarkup(cat, 'model-tag') : '';
  }).join('');
  const goodFor = model.good_for || [];
  const useCaseTags = goodFor.slice(0, 2).map(useCase => `<span class="badge model-tag use-case"><i class="bi bi-check-circle" aria-hidden="true"></i>${modelsEscapeHTML(useCase)}</span>`).join('');
  const moreCount = goodFor.length > 2 ? `<span class="badge model-tag use-case">+${goodFor.length - 2} more</span>` : '';
  const pricingTag = model.pricing ? `<span class="badge model-tag pricing"><i class="bi bi-currency-dollar" aria-hidden="true"></i>${modelsEscapeHTML(model.pricing)}</span>` : '';
  const statusTag = model.is_legacy ? '<span class="badge model-tag legacy">Legacy</span>' : (model.deprecation_date ? `<span class="badge model-tag deprecating">Deprecates ${modelsEscapeHTML(model.deprecation_date)}</span>` : '');
  item.innerHTML = `
    <label class="model-select-label" ${selectionMode ? '' : 'hidden'}><input type="checkbox" class="form-check-input model-select-checkbox" data-model-id="${modelsEscapeHTML(model.value)}" aria-label="Select ${modelsEscapeHTML(model.label)}" ${selected ? 'checked' : ''}></label>
    <button type="button" class="model-info" title="Assign categories">
      <span class="model-name">${modelsEscapeHTML(model.label)}</span>
      <span class="model-meta">${statusTag}${pricingTag}${categoryView ? `<span class="text-muted">${modelsEscapeHTML(model.providerName)}</span>` : categoryTags}</span>
      ${goodFor.length > 0 ? `<span class="model-use-cases">${useCaseTags}${moreCount}</span>` : ''}
    </button>
    <span class="ui-actions">
      ${autoCategorizeAvailable ? '<button type="button" class="btn btn-outline-secondary btn-sm auto-categorize-btn" aria-label="Auto-categorize with AI"><i class="bi bi-magic" aria-hidden="true"></i></button>' : ''}
      <i class="bi bi-chevron-right text-muted" aria-hidden="true"></i>
    </span>`;
  const checkbox = item.querySelector('.model-select-checkbox');
  checkbox.addEventListener('change', () => toggleModelSelection(model.value, checkbox));
  item.querySelector('.auto-categorize-btn')?.addEventListener('click', event => {
    event.stopPropagation();
    autoCategorizeModel(model.value, event.currentTarget);
  });
  item.addEventListener('click', event => {
    if (event.target.closest('.model-select-label')) return;
    if (selectionMode) {
      checkbox.checked = !checkbox.checked;
      toggleModelSelection(model.value, checkbox);
    } else {
      openAssignmentModal(model.value, model.label, item.querySelector('.model-info'));
    }
  });
  return item;
}

function createModelItemForCategory(model) {
  return createModelItem(model, undefined, true);
}

function setupAccordion(header, list) {
  list.id = `models-list-${++modelsAccordionSequence}`;
  header.setAttribute('aria-controls', list.id);
  header.setAttribute('aria-expanded', 'true');
  header.addEventListener('click', () => {
    const expanded = header.getAttribute('aria-expanded') === 'true';
    if (expanded && list.contains(document.activeElement)) header.focus();
    list.hidden = expanded;
    list.classList.toggle('collapsed', expanded);
    header.classList.toggle('collapsed', expanded);
    header.setAttribute('aria-expanded', String(!expanded));
  });
}

// Category Management
function modelsReturnControl(trigger) {
  if (trigger?.isConnected && trigger.getClientRects().length) return trigger;
  const row = trigger?.closest?.('.model-item');
  if (row) {
    const current = Array.from(document.querySelectorAll('.model-item')).find(item => item.dataset.modelId === row.dataset.modelId && item.dataset.provider === row.dataset.provider);
    if (current) return current.querySelector('.model-info');
  }
  return document.getElementById('manageCategoriesBtn');
}

function showModelsModal(id, trigger = document.activeElement, initialFocus) {
  const element = document.getElementById(id);
  const show = () => {
    element.addEventListener('shown.bs.modal', () => (element.querySelector(initialFocus || '.btn-close') || element).focus(), { once: true });
    element.addEventListener('hidden.bs.modal', () => {
      if (!document.querySelector('.modal.show')) modelsReturnControl(trigger)?.focus({ preventScroll: true });
    }, { once: true });
    bootstrap.Modal.getOrCreateInstance(element).show();
  };
  const previous = document.querySelector('#categoryModal.show, #categoryEditorModal.show, #assignmentModal.show, #autoCategorizeModal.show');
  if (previous && previous !== element) {
    previous.addEventListener('hidden.bs.modal', show, { once: true });
    bootstrap.Modal.getInstance(previous).hide();
  } else {
    show();
  }
}

function hideModelsModal(id) {
  const element = document.getElementById(id);
  if (!element.classList.contains('show')) return Promise.resolve();
  return new Promise(resolve => {
    element.addEventListener('hidden.bs.modal', resolve, { once: true });
    bootstrap.Modal.getInstance(element).hide();
  });
}

function openCategoryModal(trigger = document.activeElement) {
  renderCategoriesList();
  showModelsModal('categoryModal', trigger?.currentTarget || trigger, '#addCategoryBtn');
}

function renderCategoriesList(preferredControl = document.activeElement) {
  const container = document.getElementById('categoriesList');
  const customCount = allCategories.filter(c => !c.is_default).length;
  document.getElementById('categoryCount').textContent = `${customCount} / ${maxCategories} custom categories`;

  const focused = preferredControl?.closest('[data-models-action]');
  const focusedId = focused?.closest('.category-item')?.dataset.id;
  container.innerHTML = allCategories.map(cat => `
    <div class="category-item ${cat.is_default ? 'default' : ''}" data-id="${modelsEscapeHTML(cat.id)}">
      <div class="category-item-info">
        ${categoryBadgeMarkup(cat)}
        ${cat.is_default ? '<span class="badge bg-secondary">Default</span>' : ''}
        ${cat.is_hidden ? '<span class="badge bg-warning text-dark">Hidden</span>' : ''}
      </div>
      <div class="category-item-actions">
        ${cat.is_default ? `<button type="button" class="btn btn-sm btn-outline-secondary" data-models-action="visibility" aria-label="${cat.is_hidden ? 'Show' : 'Hide'} ${modelsEscapeHTML(cat.name)}"><i class="bi bi-${cat.is_hidden ? 'eye' : 'eye-slash'}" aria-hidden="true"></i></button>` : `<button type="button" class="btn btn-sm btn-outline-secondary" data-models-action="edit" aria-label="Edit ${modelsEscapeHTML(cat.name)}"><i class="bi bi-pencil" aria-hidden="true"></i></button><button type="button" class="btn btn-sm btn-outline-danger" data-models-action="delete" aria-label="Delete ${modelsEscapeHTML(cat.name)}"><i class="bi bi-trash" aria-hidden="true"></i></button>`}
      </div>
    </div>`).join('');
  container.querySelectorAll('.category-item').forEach(row => {
    const cat = allCategories.find(category => category.id === row.dataset.id);
    row.querySelector('[data-models-action="visibility"]')?.addEventListener('click', event => toggleCategoryVisibility(cat.id, !cat.is_hidden, event.currentTarget));
    row.querySelector('[data-models-action="edit"]')?.addEventListener('click', event => editCategory(cat.id, event.currentTarget));
    row.querySelector('[data-models-action="delete"]')?.addEventListener('click', event => deleteCategory(cat.id, event.currentTarget));
  });
  if (focused) {
    const row = Array.from(container.children).find(item => item.dataset.id === focusedId);
    (row?.querySelector(`[data-models-action="${focused.dataset.modelsAction}"]`) || document.getElementById('addCategoryBtn')).focus();
  }
}

function openCategoryEditor(categoryId = null, trigger = document.activeElement) {
  editingCategoryId = categoryId;
  const category = categoryId ? allCategories.find(c => c.id === categoryId) : null;
  // Native reset clears :user-invalid too; removing our classes alone does not.
  document.getElementById('categoryEditorForm').reset();

  document.getElementById('categoryEditorTitle').textContent = category ? 'Edit Category' : 'Add Category';
  document.getElementById('categoryName').value = category ? category.name : '';
  document.getElementById('categoryName').classList.remove('is-invalid');
  document.getElementById('categoryName').removeAttribute('aria-invalid');
  document.getElementById('categoryNameError').textContent = '';
  selectedColor = category ? category.color : predefinedColors[0] || '#3b82f6';
  selectedIcon = category ? category.icon : predefinedIcons[0] || 'code-slash';

  renderColorPicker();
  renderIconPicker();
  updatePreview();

  showModelsModal('categoryEditorModal', trigger, '#categoryName');
}

function renderColorPicker() {
  const container = document.getElementById('colorPicker');
  container.innerHTML = predefinedColors.map(color => `
    <button type="button" class="color-option ${color === selectedColor ? 'selected' : ''}"
         style="--category-color: ${modelsColor(color)}" data-color="${modelsEscapeHTML(color)}"
         aria-label="Choose color ${modelsEscapeHTML(color)}" aria-pressed="${color === selectedColor}"></button>
  `).join('');
  container.querySelectorAll('.color-option').forEach(button => button.addEventListener('click', () => selectColor(button.dataset.color)));
  document.getElementById('customColor').value = selectedColor;
}

function renderIconPicker() {
  const container = document.getElementById('iconPicker');
  container.innerHTML = predefinedIcons.map(icon => `
    <button type="button" class="icon-option ${icon === selectedIcon ? 'selected' : ''}"
         data-icon="${modelsEscapeHTML(icon)}" aria-label="Choose icon ${modelsEscapeHTML(icon)}" aria-pressed="${icon === selectedIcon}">
      <i class="bi bi-${modelsIcon(icon)}" aria-hidden="true"></i>
    </button>
  `).join('');
  container.querySelectorAll('.icon-option').forEach(button => button.addEventListener('click', () => selectIcon(button.dataset.icon)));
}

function selectColor(color) {
  selectedColor = color;
  document.querySelectorAll('.color-option').forEach(el => {
    const selected = el.dataset.color === color;
    el.classList.toggle('selected', selected);
    el.setAttribute('aria-pressed', String(selected));
  });
  document.getElementById('customColor').value = color;
  updatePreview();
}

function selectIcon(icon) {
  selectedIcon = icon;
  document.querySelectorAll('.icon-option').forEach(el => {
    const selected = el.dataset.icon === icon;
    el.classList.toggle('selected', selected);
    el.setAttribute('aria-pressed', String(selected));
  });
  updatePreview();
}

function updateCustomColor(e) {
  selectColor(e.target.value);
}

function updateCategoryName() {
  const input = document.getElementById('categoryName');
  if (input.value.trim()) {
    input.classList.remove('is-invalid');
    input.removeAttribute('aria-invalid');
    document.getElementById('categoryNameError').textContent = '';
  }
  updatePreview();
}

function updatePreview() {
  const name = document.getElementById('categoryName').value || 'Category Name';
  const preview = document.getElementById('categoryPreview');
  preview.innerHTML = `<i class="bi bi-${modelsIcon(selectedIcon)}" aria-hidden="true"></i>${modelsEscapeHTML(name)}`;
  preview.style.setProperty('--category-color', modelsColor(selectedColor));
}

async function saveCategory() {
  const name = document.getElementById('categoryName').value.trim();
  if (!name) {
    document.getElementById('categoryName').classList.add('is-invalid');
    document.getElementById('categoryNameError').textContent = 'Name is required';
    document.getElementById('categoryName').setAttribute('aria-invalid', 'true');
    document.getElementById('categoryName').focus();
    return;
  }

  document.getElementById('categoryName').classList.remove('is-invalid');
  document.getElementById('categoryName').removeAttribute('aria-invalid');

  try {
    const url = editingCategoryId
      ? `/api/model-categories/${editingCategoryId}`
      : '/api/model-categories';
    const method = editingCategoryId ? 'PUT' : 'POST';

    const response = await fetch(url, {
      method,
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ name, color: selectedColor, icon: selectedIcon })
    });

    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.error || 'Failed to save category');
    }

    await hideModelsModal('categoryEditorModal');
    if (await loadData()) openCategoryModal();

  } catch (error) {
    document.getElementById('categoryName').classList.add('is-invalid');
    document.getElementById('categoryNameError').textContent = error.message;
    document.getElementById('categoryName').setAttribute('aria-invalid', 'true');
    document.getElementById('categoryName').focus();
  }
}

function editCategory(id, trigger) {
  openCategoryEditor(id, trigger);
}

async function deleteCategory(id, trigger = document.activeElement) {
  if (!confirm('Are you sure you want to delete this category?')) {
    trigger?.focus({ preventScroll: true });
    return;
  }

  try {
    const response = await fetch(`/api/model-categories/${id}`, { method: 'DELETE' });
    if (!response.ok) throw new Error('Failed to delete category');
    if (await loadData()) renderCategoriesList(trigger);
    else await hideModelsModal('categoryModal');
  } catch (error) {
    alert(error.message);
  }
}

async function toggleCategoryVisibility(id, hidden, trigger = document.activeElement) {
  try {
    const response = await fetch(`/api/model-categories/${id}/visibility`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ hidden })
    });
    if (!response.ok) throw new Error('Failed to update visibility');
    if (await loadData()) renderCategoriesList(trigger);
    else await hideModelsModal('categoryModal');
  } catch (error) {
    alert(error.message);
  }
}

// Model Assignment
function openAssignmentModal(modelId, modelLabel, trigger = document.activeElement) {
  currentModelId = modelId;
  document.getElementById('assignmentModelName').textContent = modelLabel;

  const container = document.getElementById('assignmentCategoriesList');
  const currentAssignments = modelAssignments[modelId] || [];

  container.innerHTML = allCategories.filter(c => !c.is_hidden).map(cat => `
    <label class="assignment-category-item ${currentAssignments.includes(cat.id) ? 'selected' : ''}"
         data-category-id="${modelsEscapeHTML(cat.id)}">
      <input type="checkbox" class="form-check-input" ${currentAssignments.includes(cat.id) ? 'checked' : ''}>
      ${categoryBadgeMarkup(cat)}
    </label>
  `).join('');
  container.querySelectorAll('.assignment-category-item').forEach(label => label.querySelector('input').addEventListener('change', () => toggleAssignment(label)));
  showModelsModal('assignmentModal', trigger, 'input[type="checkbox"]');
}

function toggleAssignment(element) {
  element.classList.toggle('selected', element.querySelector('input[type="checkbox"]').checked);
}

async function saveAssignment() {
  const selectedCategories = Array.from(
    document.querySelectorAll('.assignment-category-item.selected')
  ).map(el => el.dataset.categoryId);

  try {
    const response = await fetch(`/api/models/${encodeURIComponent(currentModelId)}/categories`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ category_ids: selectedCategories })
    });
    if (!response.ok) throw new Error('Failed to save assignments');

    modelAssignments[currentModelId] = selectedCategories;
    await hideModelsModal('assignmentModal');
    const previous = document.activeElement;
    applyFilters();
    modelsReturnControl(previous)?.focus({ preventScroll: true });
  } catch (error) {
    alert(error.message);
  }
}

async function saveViewPreference() {
  try {
    const response = await fetch('/api/model-categories/view-preference', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ preference: viewPreference })
    });
    if (!response.ok) throw new Error('Failed to save view preference');
    return true;
  } catch (error) {
    showToast(error.message, 'danger');
    return false;
  }
}

// ===== Auto-Categorize Functions =====

function syncSelectionMode() {
  const btn = document.getElementById('toggleSelectionBtn');
  if (btn) {
    btn.innerHTML = selectionMode ? '<i class="bi bi-x-lg me-2"></i>Cancel' : '<i class="bi bi-check2-square me-2"></i>Select';
    btn.classList.toggle('btn-secondary', selectionMode);
    btn.classList.toggle('btn-outline-secondary', !selectionMode);
  }
  document.getElementById('providersContainer').classList.toggle('selection-mode', selectionMode);
  document.querySelectorAll('.model-select-label').forEach(label => { label.hidden = !selectionMode; });
}

function toggleSelectionMode() {
  selectionMode = !selectionMode;
  syncSelectionMode();
  if (!selectionMode) clearSelection();
}

function cancelSelection() {
  selectionMode = false;
  syncSelectionMode();
  clearSelection();
}

function clearSelection() {
  selectedModels.clear();
  document.querySelectorAll('.model-select-checkbox').forEach(cb => {
    cb.checked = false;
  });
  document.querySelectorAll('.model-item.selected').forEach(item => {
    item.classList.remove('selected');
  });
  updateFloatingBar();
}

function toggleModelSelection(modelId, checkbox) {
  if (checkbox.checked) {
    selectedModels.add(modelId);
    checkbox.closest('.model-item')?.classList.add('selected');
  } else {
    selectedModels.delete(modelId);
    checkbox.closest('.model-item')?.classList.remove('selected');
  }
  updateFloatingBar();
}

function updateFloatingBar() {
  const bar = document.getElementById('floatingActionBar');
  const count = document.getElementById('selectedCount');

  if (selectedModels.size > 0) {
    bar.classList.remove('d-none');
    count.textContent = `${selectedModels.size} model${selectedModels.size !== 1 ? 's' : ''} selected`;
  } else {
    bar.classList.add('d-none');
  }
}

async function autoCategorizeModel(modelId, trigger) {
  const row = Array.from(document.querySelectorAll('.model-item')).find(item => item.dataset.modelId === modelId);
  const btn = trigger || row?.querySelector('.auto-categorize-btn');
  if (btn) {
    btn.classList.add('loading');
    btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
  }

  try {
    await openAutoCategorizeModal([modelId], btn);
  } finally {
    if (btn) {
      btn.classList.remove('loading');
      btn.innerHTML = '<i class="bi bi-magic"></i>';
    }
  }
}

async function autoCategorizeSelected(event) {
  if (selectedModels.size === 0) return;
  await openAutoCategorizeModal(Array.from(selectedModels), event?.currentTarget || document.activeElement);
}

async function autoCategorizeAll(event) {
  // Collect all visible model IDs (respecting current filters)
  const modelIds = [];
  const providerFilter = document.getElementById('providerFilter').value;
  const categoryFilter = document.getElementById('categoryFilter').value;
  const searchFilter = document.getElementById('searchFilter').value.toLowerCase();
  const showLegacy = document.getElementById('showLegacyFilter').checked;

  allProviders.forEach(provider => {
    if (providerFilter !== 'all' && provider.name !== providerFilter) return;
    (provider.models || []).forEach(model => {
      if (!showLegacy && model.is_legacy) return;
      // Apply filters
      if (categoryFilter !== 'all') {
        const modelCats = modelAssignments[model.value] || [];
        if (!modelCats.includes(categoryFilter)) return;
      }
      if (searchFilter && !model.value.toLowerCase().includes(searchFilter)) return;
      if (!modelIds.includes(model.value)) {
        modelIds.push(model.value);
      }
    });
  });

  if (modelIds.length === 0) {
    showToast('No models to categorize', 'warning');
    return;
  }

  // Limit to 50 models max
  const toProcess = modelIds.slice(0, 50);
  if (modelIds.length > 50) {
    showToast(`Processing first 50 of ${modelIds.length} models`, 'info');
  }

  await openAutoCategorizeModal(toProcess, event?.currentTarget || document.activeElement);
}

async function openAutoCategorizeModal(modelIds, trigger = document.activeElement) {
  // Reset modal state
  document.getElementById('suggestionsLoading').classList.remove('d-none');
  document.getElementById('suggestionsError').classList.add('d-none');
  document.getElementById('suggestionsList').classList.add('d-none');
  document.getElementById('applySuggestionsBtn').disabled = true;

  showModelsModal('autoCategorizeModal', trigger);

  try {
    const response = await fetch('/api/models/auto-categorize', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ model_ids: modelIds })
    });

    if (!response.ok) {
      const error = await response.json();
      throw new Error(error.error || 'Failed to generate suggestions');
    }

    const data = await response.json();
    pendingSuggestions = data.suggestions || [];

    renderSuggestions();

    document.getElementById('suggestionsLoading').classList.add('d-none');
    document.getElementById('suggestionsList').classList.remove('d-none');
    document.getElementById('applySuggestionsBtn').disabled = false;

  } catch (error) {
    console.error('Auto-categorize error:', error);
    document.getElementById('suggestionsLoading').classList.add('d-none');
    document.getElementById('suggestionsErrorMessage').textContent = error.message;
    document.getElementById('suggestionsError').classList.remove('d-none');
  }
}

function renderSuggestions() {
  const tbody = document.getElementById('suggestionsTableBody');
  const visibleCategories = allCategories.filter(c => !c.is_hidden);

  tbody.innerHTML = pendingSuggestions.map((suggestion, index) => {
    const confidenceClass = suggestion.confidence >= 0.7 ? 'high' : suggestion.confidence >= 0.4 ? 'medium' : 'low';
    const confidencePercent = Math.round(suggestion.confidence * 100);
    const isChecked = suggestion.confidence >= 0.7;

    // Build category dropdown options
    const categoryOptions = visibleCategories.map(cat =>
      `<option value="${modelsEscapeHTML(cat.id)}" ${cat.id === suggestion.category_id ? 'selected' : ''}>${modelsEscapeHTML(cat.name)}</option>`
    ).join('');

    return `
      <tr class="suggestion-row" data-index="${index}">
        <td>
          <label class="models-checkbox-target"><input type="checkbox" class="form-check-input suggestion-checkbox" aria-label="Apply suggestion for ${modelsEscapeHTML(suggestion.model_id)}" ${isChecked ? 'checked' : ''} onchange="updateApplyButton()"></label>
        </td>
        <td>
          <code>${modelsEscapeHTML(suggestion.model_id)}</code>
          <div class="text-muted small">${modelsEscapeHTML(suggestion.reasoning)}</div>
        </td>
        <td>
          <span class="text-muted">${modelsEscapeHTML(suggestion.current_category || 'None')}</span>
        </td>
        <td>
          <select class="form-select form-select-sm suggestion-category" data-index="${index}" aria-label="Suggested category for ${modelsEscapeHTML(suggestion.model_id)}">
            <option value="">Uncategorized</option>
            ${categoryOptions}
          </select>
        </td>
        <td>
          <span class="badge confidence-badge ${confidenceClass}">${confidencePercent}%</span>
        </td>
      </tr>
    `;
  }).join('');

  document.getElementById('selectAllSuggestions').checked = pendingSuggestions.some(s => s.confidence >= 0.7);
  updateApplyButton();
}

function toggleAllSuggestions(e) {
  const checked = e.target.checked;
  document.querySelectorAll('.suggestion-checkbox').forEach(cb => {
    cb.checked = checked;
  });
  updateApplyButton();
}

function updateApplyButton() {
  const anyChecked = document.querySelectorAll('.suggestion-checkbox:checked').length > 0;
  document.getElementById('applySuggestionsBtn').disabled = !anyChecked;
}

async function applySuggestions() {
  const btn = document.getElementById('applySuggestionsBtn');
  btn.disabled = true;
  btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Applying...';

  const rows = document.querySelectorAll('.suggestion-row');
  const toApply = [];

  rows.forEach((row, index) => {
    const checkbox = row.querySelector('.suggestion-checkbox');
    if (!checkbox.checked) return;

    const categorySelect = row.querySelector('.suggestion-category');
    const categoryId = categorySelect.value;
    const modelId = pendingSuggestions[index].model_id;

    if (categoryId) {
      toApply.push({ modelId, categoryId });
    }
  });

  try {
    // Apply each assignment
    for (const { modelId, categoryId } of toApply) {
      const response = await fetch(`/api/models/${encodeURIComponent(modelId)}/categories`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ category_ids: [categoryId] })
      });

      if (!response.ok) {
        throw new Error(`Failed to assign category for ${modelId}`);
      }

      // Update local state
      modelAssignments[modelId] = [categoryId];
    }

    // Complete the focus-trap handoff before rebuilding the model rows.
    await hideModelsModal('autoCategorizeModal');
    const previous = document.activeElement;

    // Clear selection if in selection mode
    if (selectionMode) {
      cancelSelection();
    }

    // Refresh the view
    applyFilters();
    modelsReturnControl(previous)?.focus({ preventScroll: true });

    // Show success message
    showToast(`Successfully categorized ${toApply.length} model${toApply.length !== 1 ? 's' : ''}`, 'success');

  } catch (error) {
    console.error('Apply suggestions error:', error);
    showToast(error.message, 'danger');
  } finally {
    btn.disabled = false;
    btn.innerHTML = '<i class="bi bi-check2 me-1"></i>Apply Selected';
  }
}

function showToast(message, type = 'info') {
  window.Toast?.show(message, type === 'danger' ? 'error' : type);
}
</script>

