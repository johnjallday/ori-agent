{{define "workspace-notes"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

  {{template "navbar.tmpl" .}}

  <main class="workspace-notes-hub" role="main" aria-label="Workspace notes hub">
    <header class="workspace-notes-hub-header">
      <nav aria-label="breadcrumb" class="note-page-breadcrumb">
        <a href="/workspaces" class="breadcrumb-link">Workspaces</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <a id="hubWorkspaceLink" class="breadcrumb-link" href="#">Workspace</a>
        <span class="breadcrumb-sep" aria-hidden="true">/</span>
        <span class="breadcrumb-current">Notes</span>
      </nav>

      <div class="workspace-notes-hub-toolbar">
        <h1 class="workspace-notes-hub-title">Notes</h1>
        <span class="workspace-notes-hub-count" id="hubCount" aria-live="polite"></span>

        <div class="workspace-notes-hub-actions">
          <div class="workspace-notes-hub-search">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.7,14H15.5L20.5,19L19,20.5L14,15.5V14.7L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5A4.5,4.5 0 0,0 5,9.5A4.5,4.5 0 0,0 9.5,14A4.5,4.5 0 0,0 14,9.5A4.5,4.5 0 0,0 9.5,5Z"/>
            </svg>
            <input type="search" id="hubSearchInput" class="modern-input" placeholder="Filter by title or snippet…" aria-label="Filter notes">
          </div>

          <button type="button" id="hubBulkDeleteBtn" class="modern-btn modern-btn-secondary btn-sm" hidden>
            Delete selected
          </button>

          <button type="button" id="hubNewNoteBtn" class="modern-btn modern-btn-primary btn-sm">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/></svg>
            New note
          </button>
        </div>
      </div>
    </header>

    <section class="workspace-notes-hub-body" aria-label="Notes table">
      <div id="hubLoading" class="workspace-notes-hub-loading">Loading notes…</div>
      <div id="hubEmpty" class="workspace-notes-hub-empty" hidden>
        No notes in this workspace yet. Click <strong>New note</strong> to create one.
      </div>
      <div id="hubNoResults" class="workspace-notes-hub-empty" hidden>
        No notes match the current filter.
      </div>

      <table id="hubTable" class="workspace-notes-hub-table" hidden>
        <thead>
          <tr>
            <th class="workspace-notes-hub-th-checkbox">
              <input type="checkbox" id="hubSelectAll" aria-label="Select all notes">
            </th>
            <th class="sortable" data-sort-key="name" aria-sort="none">
              <button type="button" class="hub-sort-btn">
                Title <span class="hub-sort-arrow" aria-hidden="true"></span>
              </button>
            </th>
            <th class="sortable" data-sort-key="updated_at" aria-sort="descending">
              <button type="button" class="hub-sort-btn">
                Last updated <span class="hub-sort-arrow" aria-hidden="true">▼</span>
              </button>
            </th>
            <th class="sortable" data-sort-key="created_at" aria-sort="none">
              <button type="button" class="hub-sort-btn">
                Created <span class="hub-sort-arrow" aria-hidden="true"></span>
              </button>
            </th>
            <th class="workspace-notes-hub-th-actions" aria-label="Row actions"></th>
          </tr>
        </thead>
        <tbody id="hubTableBody"></tbody>
      </table>
    </section>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/modules/themeManager.js"></script>
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/utils/dom-utils.js"></script>
  <script src="/js/modules/toast.js"></script>
  <script type="module" src="/js/modules/workspace-notes-hub.js"></script>
</body>
</html>
{{end}}
