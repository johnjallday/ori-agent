{{define "review"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}
<body class="bg-light review-page">
  {{template "navbar.tmpl" .}}
  <style>
    .review-page .main-content-wrapper { background: var(--bg-primary); }
    #reviewPage { color: var(--text-primary); }
    .review-section { margin-bottom: var(--space-6); }
    .review-section h2 { font-family: var(--font-body); font-size: 1.125rem; font-weight: 600; margin: 0 0 var(--space-4); }
    .review-summary-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); margin-top: var(--space-2); font-size: 0.875rem; }
    .review-summary-row > :first-child { color: var(--text-secondary); }
    .review-summary-row time { max-width: 100%; overflow-wrap: anywhere; }
    .review-warning { color: var(--warning-text); }
    .review-danger { color: var(--danger-text); }
    .review-success { color: var(--success-text); }
    .review-info { color: var(--info-text); }
    .review-filters { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: var(--space-4); }
    .review-filters .ui-actions { flex: 1 1 24rem; align-items: end; }
    .review-filter { flex: 1 1 12rem; min-width: 0; }
    .review-export summary { list-style-position: inside; }
    .review-export[open] .ui-actions { margin-top: var(--space-2); }
    #reviewPage .ui-data-table table { min-width: 54rem; table-layout: fixed; }
    #issuesTable th:nth-child(5) { width: 28%; }
    #runsTable th:last-child { width: 26%; }
    .review-context summary { color: var(--text-primary); cursor: pointer; }
    .review-context p { margin: var(--space-2) 0 0; white-space: pre-wrap; color: var(--text-secondary); }
    .review-empty { padding-block: var(--space-4); color: var(--text-muted); }
    .review-progress-meta { display: flex; flex-wrap: wrap; gap: var(--space-4); color: var(--text-secondary); font-size: 0.875rem; }
    .review-progress-meta code { overflow-wrap: anywhere; }
    #reviewProgress { transition: none; }
  </style>
  <div class="main-content-wrapper">
    <main class="main-content">
      <div class="container-fluid py-4" id="reviewPage">
        <header class="ui-page-header">
          <div><h1>Conversation Review</h1><p>Find conversation patterns that need attention.</p></div>
          <div class="ui-page-actions">
            <button type="button" class="modern-btn modern-btn-secondary" onclick="refreshData()">Refresh</button>
            <button type="button" class="modern-btn modern-btn-primary" onclick="showTriggerModal()" id="triggerBtn">Run Review</button>
          </div>
        </header>
        <section id="activeReviewCard" class="ui-section p-3 mb-4" style="display: none;" aria-label="Current review" role="status">
          <div id="reviewProgressSection">
            <h2 class="h6">Review in progress</h2>
            <div class="progress mb-3" style="height: 8px;"><div id="reviewProgress" class="progress-bar" role="progressbar" aria-label="Review in progress" style="width: 0%"></div></div>
            <div class="review-progress-meta"><span>Job ID: <code id="activeJobId">-</code></span><span>Sessions: <span id="activeSessionsReviewed">0</span></span><span>Issues found: <span id="activeIssuesFound">0</span></span></div>
          </div>
          <div id="reviewResult" hidden></div>
        </section>
        <div class="ui-metric-grid">
          <section class="ui-section ui-metric"><h2>Total issues</h2><div id="totalIssuesCard">Loading…</div></section>
          <section class="ui-section ui-metric"><h2>Last review</h2><div id="lastReviewCard">Loading…</div></section>
          <section class="ui-section ui-metric"><h2>Review runs</h2><div id="reviewRunsCard">Loading…</div></section>
        </div>
        <section class="review-section" aria-labelledby="reviewIssuesTitle">
          <h2 id="reviewIssuesTitle">Detected issues</h2>
          <div class="ui-toolbar review-filters">
            <div class="ui-actions">
              <div class="review-filter"><label class="form-label" for="filterAgent">Agent</label><select aria-label="Filter by agent" id="filterAgent" class="form-select" aria-describedby="reviewAgentFeedback" onchange="loadIssues()"><option value="">All Agents</option></select><div id="reviewAgentFeedback" class="ui-field-help" role="status" hidden></div></div>
              <div class="review-filter"><label class="form-label" for="filterType">Issue type</label><select aria-label="Filter by issue type" id="filterType" class="form-select" onchange="loadIssues()"><option value="">All Types</option><option value="user_retry">User Retry</option><option value="tool_retry_loop">Tool Retry Loop</option><option value="ignored_error">Ignored Error</option></select></div>
            </div>
            <details class="review-export" id="reviewExportMenu"><summary class="btn btn-secondary">Export</summary><div class="ui-actions"><a class="btn btn-secondary" id="reviewExportJSON" href="/api/review/export?format=json">Export JSON</a><a class="btn btn-secondary" id="reviewExportJSONL" href="/api/review/export?format=jsonl">Export JSONL</a></div></details>
          </div>
          <div id="issuesTable" role="status">Loading…</div>
        </section>
        <section class="review-section" id="reviewRunsSection" aria-labelledby="reviewRunsTitle"><h2 id="reviewRunsTitle">Recent review runs</h2><div id="runsTable" role="status">Loading…</div></section>
      </div>
    </main>
  </div>
  <div class="modal fade" id="triggerModal" tabindex="-1" aria-labelledby="triggerModalTitle" aria-hidden="true">
    <div class="modal-dialog"><div class="modal-content">
      <div class="modal-header"><h2 class="modal-title" id="triggerModalTitle">Run Conversation Review</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
      <div class="modal-body">
        <div class="mb-3"><label class="form-label" for="triggerSensitivity">Sensitivity</label><select id="triggerSensitivity" class="form-select" aria-describedby="triggerSensitivityHelp"><option value="medium" selected>Medium (default)</option><option value="low">Low (more lenient)</option><option value="high">High (more strict)</option></select><div class="form-helper" id="triggerSensitivityHelp">Higher sensitivity detects more issues with lower thresholds.</div></div>
        <div class="mb-3"><label class="form-label" for="triggerAgent">Filter by agent (optional)</label><select id="triggerAgent" class="form-select" aria-describedby="triggerAgentHelp"><option value="">All Agents</option></select><div id="triggerAgentHelp" class="ui-field-help" role="status" hidden></div></div>
      </div>
      <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" class="btn btn-primary" id="reviewStartBtn" onclick="triggerReview()">Start Review</button></div>
    </div></div>
  </div>
  {{template "modals.tmpl" .}}
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/modules/toast.js"></script>
  <script defer src="/js/app.js"></script>
  <script defer src="/js/modules/agents.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  <script>
    let issues = [];
    let runs = [];
    let activeJobId = null;
    let pollInterval = null;
    let triggerModal = null;
    let issueGeneration = 0;
    let runGeneration = 0;
    let reviewStarting = false;
    const reviewCount = value => (Number.isFinite(Number(value)) ? Number(value) : 0).toLocaleString();
    const reviewDate = value => escapeHtml(new Date(value).toLocaleString());
    const reviewBadge = (value, intent = '') => `<span class="badge ${intent}">${escapeHtml(String(value || 'Unknown'))}</span>`;
    const reviewStatusIntent = status => ({ running: 'review-info', completed: 'review-success', failed: 'review-danger' })[status] || '';
    function reviewContext(value) {
      const text = String(value || '-');
      if (text.length <= 100) return escapeHtml(text);
      return `<details class="review-context"><summary>${escapeHtml(text.slice(0, 96))}…</summary><p>${escapeHtml(text)}</p></details>`;
    }
    document.addEventListener('DOMContentLoaded', function() {
      const modal = document.getElementById('triggerModal');
      triggerModal = new bootstrap.Modal(modal);
      modal.addEventListener('shown.bs.modal', () => document.getElementById('triggerSensitivity').focus());
      modal.addEventListener('hidden.bs.modal', () => document.getElementById('triggerBtn').focus({ preventScroll: true }));
      document.getElementById('reviewExportMenu').addEventListener('keydown', event => {
        if (event.key !== 'Escape') return;
        const menu = event.currentTarget;
        menu.querySelector('summary').focus();
        menu.open = false;
        event.preventDefault();
      });
      loadAgents(); loadIssues(); loadRuns(); themeManager.initialize();
    });
    async function loadAgents() {
      try {
        const response = await fetch('/api/agents');
        if (!response.ok) throw new Error('Agent filters unavailable');
        const data = await response.json();
        if (!Array.isArray(data.agents)) throw new Error('Agent filters unavailable');
        for (const id of ['reviewAgentFeedback', 'triggerAgentHelp']) document.getElementById(id).hidden = true;
        for (const id of ['filterAgent', 'triggerAgent']) {
          const select = document.getElementById(id);
          const current = select.value;
          select.innerHTML = '<option value="">All Agents</option>' + (data.agents || []).map(name => `<option value="${escapeAttr(String(name))}">${escapeHtml(String(name))}</option>`).join('');
          select.value = current;
        }
      } catch (error) {
        for (const id of ['reviewAgentFeedback', 'triggerAgentHelp']) {
          const feedback = document.getElementById(id);
          feedback.textContent = 'Agent list unavailable. All Agents remains selectable; use Refresh to retry.';
          feedback.hidden = false;
        }
      }
    }
    function reviewReadError(id, message) {
      const container = document.getElementById(id);
      container.innerHTML = `<div class="ui-field-error" role="alert">${escapeHtml(message)} Use Refresh to try again.</div>`;
    }
    async function loadIssues() {
      const generation = ++issueGeneration;
      syncReviewExports();
      try {
        const agent = document.getElementById('filterAgent').value;
        const type = document.getElementById('filterType').value;
        let url = '/api/review/issues?limit=100';
        if (agent) url += `&agent_name=${encodeURIComponent(agent)}`;
        if (type) url += `&issue_type=${encodeURIComponent(type)}`;
        const response = await fetch(url);
        if (!response.ok) throw new Error('Failed to load issues.');
        const data = await response.json();
        if (!Array.isArray(data.issues)) throw new Error('Issue results are unavailable.');
        if (generation !== issueGeneration) return;
        issues = data.issues;
        renderIssues(); renderTotalIssuesCard();
      } catch (error) {
        if (generation !== issueGeneration) return;
        reviewReadError('issuesTable', error.message);
        document.getElementById('totalIssuesCard').textContent = 'Unavailable';
      }
    }
    function renderIssues() {
      const container = document.getElementById('issuesTable');
      if (!issues.length) { container.innerHTML = '<p class="review-empty">No issues match these filters. Run a review to analyze conversations.</p>'; return; }
      const types = { user_retry: ['User Retry', 'review-warning'], tool_retry_loop: ['Tool Retry', 'review-warning'], ignored_error: ['Ignored Error', 'review-danger'] };
      container.innerHTML = `<div class="ui-data-table" role="region" aria-label="Detected conversation issues" tabindex="0"><table class="table"><caption class="visually-hidden">Detected issues matching the selected filters</caption><thead><tr><th scope="col">Type</th><th scope="col">Agent</th><th scope="col">Tool</th><th scope="col" class="text-end">Count</th><th scope="col">Context</th><th scope="col">Date</th></tr></thead><tbody>${issues.map(issue => {
        const type = types[issue.issue_type] || [issue.issue_type, ''];
        return `<tr><td>${reviewBadge(type[0], type[1])}</td><td>${escapeHtml(String(issue.agent_name || '-'))}</td><td>${escapeHtml(String(issue.tool_name || '-'))}</td><td class="ui-number text-end">${reviewCount(issue.occurrence_count)}</td><td>${reviewContext(issue.context_summary)}</td><td>${reviewDate(issue.created_at)}</td></tr>`;
      }).join('')}</tbody></table></div>`;
    }
    function renderTotalIssuesCard() {
      document.getElementById('totalIssuesCard').innerHTML = `<div class="ui-metric-value ui-number">${reviewCount(issues.length)}</div>${[['user_retry', 'User retries', 'review-warning'], ['tool_retry_loop', 'Tool retry loops', 'review-warning'], ['ignored_error', 'Ignored errors', 'review-danger']].map(([type, label, intent]) => `<div class="review-summary-row"><span>${label}</span><span class="ui-number ${intent}">${reviewCount(issues.filter(issue => issue.issue_type === type).length)}</span></div>`).join('')}`;
    }
    async function loadRuns() {
      const generation = ++runGeneration;
      try {
        const response = await fetch('/api/review/runs?limit=10');
        if (!response.ok) throw new Error('Failed to load review runs.');
        const data = await response.json();
        if (!Array.isArray(data.runs)) throw new Error('Review run results are unavailable.');
        if (generation !== runGeneration) return;
        runs = data.runs;
        renderRuns(); renderLastReviewCard(); renderReviewRunsCard();
      } catch (error) {
        if (generation !== runGeneration) return;
        reviewReadError('runsTable', error.message);
        for (const id of ['lastReviewCard', 'reviewRunsCard']) document.getElementById(id).textContent = 'Unavailable';
      }
    }
    function renderRuns() {
      const container = document.getElementById('runsTable');
      if (!runs.length) { container.innerHTML = '<p class="review-empty">No review runs yet.</p>'; return; }
      container.innerHTML = `<div class="ui-data-table" role="region" aria-label="Recent review runs" tabindex="0"><table class="table"><caption class="visually-hidden">Recent stored review runs</caption><thead><tr><th scope="col">Status</th><th scope="col">Started</th><th scope="col">Completed</th><th scope="col" class="text-end">Sessions</th><th scope="col" class="text-end">Issues</th><th scope="col">Error</th></tr></thead><tbody>${runs.map(run => `<tr><td>${reviewBadge(run.status, reviewStatusIntent(run.status))}</td><td>${reviewDate(run.started_at)}</td><td>${run.completed_at && !run.completed_at.startsWith('0001') ? reviewDate(run.completed_at) : '-'}</td><td class="ui-number text-end">${reviewCount(run.sessions_reviewed)}</td><td class="ui-number text-end">${reviewCount(run.issues_found)}</td><td class="review-danger">${reviewContext(run.error_message)}</td></tr>`).join('')}</tbody></table></div>`;
    }
    function renderLastReviewCard() {
      const container = document.getElementById('lastReviewCard');
      if (!runs.length) { container.innerHTML = '<p class="text-muted mb-0">No reviews run yet</p>'; return; }
      const run = runs[0];
      container.innerHTML = `<div class="review-summary-row"><span>Status</span>${reviewBadge(run.status, reviewStatusIntent(run.status))}</div><div class="review-summary-row"><span>Sessions</span><span class="ui-number">${reviewCount(run.sessions_reviewed)}</span></div><div class="review-summary-row"><span>Date</span><time>${reviewDate(run.started_at)}</time></div>`;
    }
    function renderReviewRunsCard() {
      document.getElementById('reviewRunsCard').innerHTML = `<div class="ui-metric-value ui-number">${reviewCount(runs.length)}</div><div class="review-summary-row"><span>Completed</span><span class="ui-number review-success">${reviewCount(runs.filter(run => run.status === 'completed').length)}</span></div><div class="review-summary-row"><span>Total issues found</span><span class="ui-number review-warning">${reviewCount(runs.reduce((sum, run) => sum + (Number(run.issues_found) || 0), 0))}</span></div>`;
    }
    function showTriggerModal() { triggerModal.show(); }
    async function triggerReview() {
      if (reviewStarting) return;
      reviewStarting = true;
      const button = document.getElementById('reviewStartBtn');
      button.disabled = true; button.setAttribute('aria-busy', 'true');
      try {
        const sensitivity = document.getElementById('triggerSensitivity').value;
        const agent = document.getElementById('triggerAgent').value;
        const body = { sensitivity };
        if (agent) body.agent_name = agent;
        const response = await fetch('/api/review/trigger', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body) });
        if (!response.ok) throw new Error('Failed to start review');
        const data = await response.json();
        triggerModal.hide(); activeJobId = data.job_id; startPolling();
      } catch (error) { window.Toast.show('Failed to start review: ' + error.message, 'error'); }
      finally { reviewStarting = false; button.disabled = false; button.removeAttribute('aria-busy'); }
    }
    function startPolling() {
      if (!activeJobId) return;
      if (pollInterval) clearInterval(pollInterval);
      document.getElementById('activeReviewCard').style.display = 'block';
      document.getElementById('reviewProgressSection').hidden = false;
      document.getElementById('reviewResult').hidden = true;
      document.getElementById('activeJobId').textContent = activeJobId;
      document.getElementById('activeSessionsReviewed').textContent = '0';
      document.getElementById('activeIssuesFound').textContent = '0';
      document.getElementById('reviewProgress').style.width = '0%';
      document.getElementById('triggerBtn').disabled = true;
      pollInterval = setInterval(pollJobStatus, 1000); pollJobStatus();
    }
    async function pollJobStatus() {
      if (!activeJobId) return;
      const job = activeJobId;
      try {
        const response = await fetch(`/api/review/status/${encodeURIComponent(job)}`);
        if (!response.ok) throw new Error('Failed to get status');
        const data = await response.json();
        if (job !== activeJobId) return;
        document.getElementById('activeSessionsReviewed').textContent = data.sessions_reviewed;
        document.getElementById('activeIssuesFound').textContent = data.issues_found;
        document.getElementById('reviewProgress').style.width = '100%';
        if (data.status === 'completed' || data.status === 'failed') {
          stopPolling();
          document.getElementById('reviewProgressSection').hidden = true;
          const result = document.getElementById('reviewResult');
          result.hidden = false;
          result.innerHTML = `<h2 class="h6 ${reviewStatusIntent(data.status)}">Review ${data.status === 'completed' ? 'complete' : 'failed'}</h2><p class="mb-0">${data.status === 'completed' ? `Reviewed ${reviewCount(data.sessions_reviewed)} sessions, found ${reviewCount(data.issues_found)} issues.` : escapeHtml(String(data.error_message || 'Unknown error'))}</p>`;
          setTimeout(() => { loadIssues(); loadRuns(); if (!activeJobId) document.getElementById('activeReviewCard').style.display = 'none'; }, 3000);
        }
      } catch (error) { console.error('Error polling status:', error); }
    }
    function stopPolling() {
      if (pollInterval) { clearInterval(pollInterval); pollInterval = null; }
      activeJobId = null; document.getElementById('triggerBtn').disabled = false;
    }
    function reviewExportURL(format) {
      const agent = document.getElementById('filterAgent').value;
      const type = document.getElementById('filterType').value;
      let url = `/api/review/export?format=${format}`;
      if (agent) url += `&agent_name=${encodeURIComponent(agent)}`;
      if (type) url += `&issue_type=${encodeURIComponent(type)}`;
      return url;
    }
    function syncReviewExports() {
      document.getElementById('reviewExportJSON').href = reviewExportURL('json');
      document.getElementById('reviewExportJSONL').href = reviewExportURL('jsonl');
    }
    function exportIssues(format) { window.location.href = reviewExportURL(format); }
    function refreshData() { loadAgents(); loadIssues(); loadRuns(); }
  </script>
</body>
</html>
{{end}}
