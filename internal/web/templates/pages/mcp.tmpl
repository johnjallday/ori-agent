{{define "mcp"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">

        <!-- Page Header -->
        <div class="modern-card p-4 mb-4">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <h5 class="mb-1" style="color: var(--text-primary);">MCP Servers</h5>
              <p class="mb-0 text-muted small">Manage and browse Model Context Protocol servers</p>
            </div>
          </div>
        </div>

        <!-- Top-level Tabs -->
        <ul class="nav nav-tabs mb-4" id="mcpPageTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="my-servers-tab" data-bs-toggle="tab" data-bs-target="#my-servers-pane" type="button" role="tab">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z"/>
              </svg>
              My Servers
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="browse-tab" data-bs-toggle="tab" data-bs-target="#browse-pane" type="button" role="tab" onclick="onBrowseTabActivated()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z"/>
              </svg>
              Browse
            </button>
          </li>
        </ul>

        <div class="tab-content" id="mcpPageTabContent">

          <!-- ════════════ MY SERVERS TAB ════════════ -->
          <div class="tab-pane fade show active" id="my-servers-pane" role="tabpanel">

            <div class="modern-card p-4 mb-4">
              <div class="d-flex align-items-center justify-content-between">
                <h6 class="mb-0" style="color: var(--text-primary);">Configured Servers</h6>
                <button id="addServerBtn" class="modern-btn modern-btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                  </svg>
                  Add MCP Server
                </button>
              </div>
            </div>

            <div class="modern-card p-4">
              <div id="mcpServersList">
                <div class="text-center py-5">
                  <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                </div>
              </div>

              <!-- Empty State -->
              <div id="emptyState" class="text-center py-5" style="display: none;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="currentColor" style="opacity: 0.3; color: var(--text-secondary);" class="mb-3">
                  <path d="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z"/>
                </svg>
                <p style="color: var(--text-secondary);">No MCP servers configured</p>
                <button class="modern-btn modern-btn-primary mt-2" onclick="document.getElementById('addServerBtn').click()">
                  Add Your First Server
                </button>
              </div>
            </div>

          </div><!-- /my-servers-pane -->

          <!-- ════════════ BROWSE TAB ════════════ -->
          <div class="tab-pane fade" id="browse-pane" role="tabpanel">

            <!-- Search & Filter Bar -->
            <div class="modern-card p-4 mb-4">
              <div class="row g-3 align-items-end">
                <div class="col-12 col-md-5">
                  <label class="form-label small fw-semibold mb-1" style="color: var(--text-secondary);">Search</label>
                  <div class="input-group">
                    <span class="input-group-text" style="background: var(--bg-tertiary); border-color: var(--border-color);">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
                        <path d="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z"/>
                      </svg>
                    </span>
                    <input type="text" id="browseSearch" class="form-control" placeholder="Search servers..." style="background: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-primary);" oninput="filterSearch()">
                  </div>
                </div>
                <div class="col-12 col-md-4">
                  <label class="form-label small fw-semibold mb-1" style="color: var(--text-secondary);">Source</label>
                  <select id="browseSource" class="form-select" style="background: var(--bg-tertiary); border-color: var(--border-color); color: var(--text-primary);" onchange="filterSearch()">
                    <option value="all">All Sources</option>
                  </select>
                </div>
                <div class="col-12 col-md-3 d-flex gap-2 justify-content-md-end">
                  <button class="modern-btn modern-btn-secondary" onclick="refreshRegistry()" id="refreshBtn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </svg>
                    Refresh
                  </button>
                  <button class="modern-btn modern-btn-primary" onclick="showAddSourceModal()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                    Add Source
                  </button>
                </div>
              </div>

              <!-- Category Filter Pills -->
              <div class="d-flex flex-wrap gap-2 mt-3" id="categoryFilters">
                <button class="btn btn-sm category-pill active" data-category="all" onclick="setCategoryFilter(this)">All</button>
                <button class="btn btn-sm category-pill" data-category="file-system" onclick="setCategoryFilter(this)">File System</button>
                <button class="btn btn-sm category-pill" data-category="database" onclick="setCategoryFilter(this)">Database</button>
                <button class="btn btn-sm category-pill" data-category="search" onclick="setCategoryFilter(this)">Search</button>
                <button class="btn btn-sm category-pill" data-category="development" onclick="setCategoryFilter(this)">Development</button>
                <button class="btn btn-sm category-pill" data-category="storage" onclick="setCategoryFilter(this)">Storage</button>
                <button class="btn btn-sm category-pill" data-category="automation" onclick="setCategoryFilter(this)">Automation</button>
                <button class="btn btn-sm category-pill" data-category="communication" onclick="setCategoryFilter(this)">Communication</button>
                <button class="btn btn-sm category-pill" data-category="productivity" onclick="setCategoryFilter(this)">Productivity</button>
                <button class="btn btn-sm category-pill" data-category="ai" onclick="setCategoryFilter(this)">AI</button>
                <button class="btn btn-sm category-pill" data-category="cloud" onclick="setCategoryFilter(this)">Cloud</button>
                <button class="btn btn-sm category-pill" data-category="devops" onclick="setCategoryFilter(this)">DevOps</button>
              </div>
            </div>

            <!-- Server Cards Grid -->
            <div id="browseResults">
              <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
            </div>

            <!-- Registry Sources Management (collapsible) -->
            <div class="modern-card p-4 mt-4">
              <div class="d-flex align-items-center justify-content-between" style="cursor: pointer;" onclick="toggleSourcesPanel()">
                <h6 class="mb-0" style="color: var(--text-primary);">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                    <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6Z"/>
                  </svg>
                  Registry Sources
                </h6>
                <svg id="sourcesChevron" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary); transition: transform 0.2s;">
                  <path d="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"/>
                </svg>
              </div>
              <div id="sourcesPanel" style="display: none; margin-top: 1rem;">
                <div id="sourcesList">
                  <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                  </div>
                </div>
              </div>
            </div>

          </div><!-- /browse-pane -->

        </div><!-- /tab-content -->

      </div>
    </div>
  </div>

  <!-- Add Server Modal -->
  <div class="modal fade" id="addServerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
      <div class="modal-content" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" style="color: var(--text-primary);">Add MCP Server</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <!-- Tabs -->
          <ul class="nav nav-tabs mb-4" id="addServerTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="marketplace-tab" data-bs-toggle="tab" data-bs-target="#marketplace" type="button" role="tab">Marketplace</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="manual-tab" data-bs-toggle="tab" data-bs-target="#manual" type="button" role="tab">Manual Configuration</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="import-tab" data-bs-toggle="tab" data-bs-target="#import" type="button" role="tab">Import File</button>
            </li>
          </ul>

          <!-- Tab Content -->
          <div class="tab-content" id="addServerTabContent">
            <!-- Marketplace Tab -->
            <div class="tab-pane fade show active" id="marketplace" role="tabpanel">
              <div class="mb-3">
                <input type="text" id="marketplaceSearch" class="form-control" placeholder="Search servers..." style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);">
              </div>
              <div id="marketplaceList" class="list-group" style="max-height: 400px; overflow-y: auto;">
                <div class="text-center py-3">
                  <div class="spinner-border text-primary" role="status"></div>
                </div>
              </div>
            </div>

            <!-- Manual Configuration Tab -->
            <div class="tab-pane fade" id="manual" role="tabpanel">
              <form id="manualConfigForm">
                <div class="mb-3">
                  <label class="form-label fw-semibold" style="color: var(--text-primary);">Server Name *</label>
                  <input type="text" id="manualName" class="form-control" required placeholder="e.g., filesystem" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);">
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold" style="color: var(--text-primary);">Command *</label>
                  <input type="text" id="manualCommand" class="form-control" required placeholder="e.g., npx" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);">
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold" style="color: var(--text-primary);">Arguments (JSON array)</label>
                  <textarea id="manualArgs" class="form-control" rows="3" placeholder='["-y", "@modelcontextprotocol/server-filesystem", "/path"]' style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);"></textarea>
                  <small class="form-text" style="color: var(--text-secondary);">Enter as JSON array, e.g., ["-y", "package-name"]</small>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold" style="color: var(--text-primary);">Environment Variables (JSON object)</label>
                  <textarea id="manualEnv" class="form-control" rows="3" placeholder='{"API_KEY": "value"}' style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);"></textarea>
                  <small class="form-text" style="color: var(--text-secondary);">Enter as JSON object, e.g., {"KEY": "value"}</small>
                </div>
                <div class="mb-3">
                  <label class="form-label fw-semibold" style="color: var(--text-primary);">Transport</label>
                  <select id="manualTransport" class="form-select" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);">
                    <option value="stdio" selected>stdio</option>
                    <option value="sse">sse</option>
                  </select>
                </div>
                <button type="submit" class="modern-btn modern-btn-primary w-100">Add Server</button>
              </form>
            </div>

            <!-- Import File Tab -->
            <div class="tab-pane fade" id="import" role="tabpanel">
              <div class="mb-3">
                <label class="form-label fw-semibold" style="color: var(--text-primary);">Upload Configuration File</label>
                <input type="file" id="importFileInput" class="form-control" accept=".json,.yaml,.yml" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);">
                <small class="form-text" style="color: var(--text-secondary);">Upload a JSON or YAML file containing MCP server configurations</small>
              </div>
              <div id="importPreview" class="mt-3" style="display: none;">
                <h6 style="color: var(--text-primary);">Preview:</h6>
                <pre id="importPreviewContent" style="background: var(--bg-tertiary); padding: 1rem; border-radius: 4px; color: var(--text-primary); max-height: 300px; overflow-y: auto;"></pre>
              </div>
              <button id="importBtn" class="modern-btn modern-btn-primary w-100" style="display: none;">Import Servers</button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Remove Confirmation Modal -->
  <div class="modal fade" id="removeServerModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" style="color: var(--text-primary);">Confirm Removal</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" style="color: var(--text-primary);">
          <p>Are you sure you want to remove <strong id="removeServerName"></strong>?</p>
          <p class="text-muted">This action cannot be undone.</p>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="confirmRemoveBtn" class="modern-btn modern-btn-danger">Remove</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Registry Source Modal -->
  <div class="modal fade" id="addSourceModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" style="color: var(--text-primary);">Add Registry Source</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label fw-semibold" style="color: var(--text-primary);">Source Name *</label>
            <input type="text" id="sourceNameInput" class="form-control" placeholder="My Custom Registry" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);">
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold" style="color: var(--text-primary);">URL or GitHub shorthand *</label>
            <input type="text" id="sourceUrlInput" class="form-control" placeholder="https://example.com/registry.json  or  user/repo" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary);">
            <small class="form-text" style="color: var(--text-secondary);">Provide a URL to a JSON registry file, or a GitHub "user/repo" shorthand (expects main/registry.json).</small>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="modern-btn modern-btn-primary" onclick="submitAddSource()">Add Source</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Server Details Modal -->
  <div class="modal fade" id="serverDetailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" id="serverDetailsTitle" style="color: var(--text-primary);">Server Details</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" id="serverDetailsBody" style="color: var(--text-primary);"></div>
      </div>
    </div>
  </div>

  {{template "modals.tmpl" .}}

  <style>
    /* Better text contrast for light mode */
    [data-bs-theme="light"] .form-label,
    [data-bs-theme="light"] .modal-title,
    [data-bs-theme="light"] .modal-body {
      color: #1e293b !important;
    }

    [data-bs-theme="light"] .form-text,
    [data-bs-theme="light"] .text-muted {
      color: #64748b !important;
    }

    [data-bs-theme="light"] .form-control::placeholder,
    [data-bs-theme="light"] .form-select::placeholder {
      color: #94a3b8 !important;
    }

    /* Category filter pills */
    .category-pill {
      background: var(--bg-tertiary);
      border: 1px solid var(--border-color);
      color: var(--text-secondary);
      border-radius: 20px;
      padding: 0.25rem 0.75rem;
      font-size: 0.8rem;
      transition: all 0.15s;
    }
    .category-pill:hover {
      border-color: var(--primary-color, #6366f1);
      color: var(--primary-color, #6366f1);
    }
    .category-pill.active {
      background: var(--primary-color, #6366f1);
      border-color: var(--primary-color, #6366f1);
      color: #fff;
    }

    /* Browse server cards */
    .browse-server-card {
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      border-radius: 8px;
      padding: 1rem;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .browse-server-card:hover {
      border-color: var(--primary-color, #6366f1);
      box-shadow: 0 2px 8px rgba(99,102,241,0.12);
    }

    /* Rendered README / instructions markdown inside the details modal */
    .mcp-markdown {
      color: var(--text-primary);
      overflow-wrap: anywhere;
    }
    .mcp-markdown img { max-width: 100%; height: auto; }
    .mcp-markdown pre {
      background: var(--bg-tertiary);
      border: 1px solid var(--border-color);
      border-radius: 6px;
      padding: 0.75rem;
      overflow-x: auto;
    }
    .mcp-markdown code {
      background: var(--bg-tertiary);
      padding: 0.1rem 0.3rem;
      border-radius: 4px;
    }
    .mcp-markdown pre code { background: transparent; padding: 0; }
    .mcp-markdown table { width: 100%; border-collapse: collapse; }
    .mcp-markdown th, .mcp-markdown td {
      border: 1px solid var(--border-color);
      padding: 0.35rem 0.5rem;
    }
    .mcp-markdown a { color: var(--primary-color, #6366f1); }
    .mcp-markdown h1, .mcp-markdown h2, .mcp-markdown h3 { color: var(--text-primary); }
  </style>

  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Markdown rendering for MCP README / instructions -->
  <script defer src="/js/vendor/marked-14.1.4.min.js" integrity="sha384-lqPzN0kmFw9t2syAMwVPM4VbAyqsz/lPyYWbb2Xt6nSPM0WPNrpSWCUBgdcAdgnC"></script>
  <script defer src="/js/vendor/dompurify-3.1.6.min.js" integrity="sha384-+VfUPEb0PdtChMwmBcBmykRMDd+v6D/oFmB3rZM/puCMDYcIvF968OimRh4KQY9a"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/app.js?v=1694538177"></script>
  <script defer src="/js/modules/agents.js"></script>
  <script defer src="/js/modules/sidebar.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "theme-init.tmpl" .}}
  <script defer src="/js/mcp.js"></script>
</body>
</html>
{{end}}
