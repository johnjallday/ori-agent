{{define "mcp"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light mcp-page">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">

        <!-- Page Header -->
        <header class="ui-page-header">
          <div>
            <h1>MCP Servers</h1>
            <p>Manage and browse Model Context Protocol servers.</p>
          </div>
        </header>

        <!-- Top-level Tabs -->
        <ul class="nav nav-tabs mb-4" id="mcpPageTabs" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="my-servers-tab" data-bs-toggle="tab" data-bs-target="#my-servers-pane" type="button" role="tab" aria-controls="my-servers-pane" aria-selected="true">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z"/>
              </svg>
              My Servers
            </button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="browse-tab" data-bs-toggle="tab" data-bs-target="#browse-pane" type="button" role="tab" aria-controls="browse-pane" aria-selected="false" onclick="onBrowseTabActivated()">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z"/>
              </svg>
              Browse
            </button>
          </li>
        </ul>

        <div class="tab-content" id="mcpPageTabContent">

          <!-- ════════════ MY SERVERS TAB ════════════ -->
          <div class="tab-pane fade show active" id="my-servers-pane" role="tabpanel" aria-labelledby="my-servers-tab">

            <div class="mb-4">
              <div class="ui-toolbar justify-content-between">
                <h2 class="mcp-section-title">Configured Servers</h2>
                <button id="addServerBtn" class="modern-btn modern-btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                  </svg>
                  Add MCP Server
                </button>
              </div>
            </div>

            <div class="ui-section ui-section--quiet">
              <div id="mcpServersList">
                <div class="text-center py-5">
                  <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                </div>
              </div>

              <!-- Empty State -->
              <div id="emptyState" class="text-center py-5" style="display: none;">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="currentColor" style="opacity: 0.3; color: var(--text-secondary);" class="mb-3">
                  <path d="M4,6H20V16H4M20,18A2,2 0 0,0 22,16V6C22,4.89 21.1,4 20,4H4C2.89,4 2,4.89 2,6V16A2,2 0 0,0 4,18H0V20H24V18H20Z"/>
                </svg>
                <p style="color: var(--text-secondary);">No MCP servers configured</p>
                <p class="small text-muted">Use Add MCP Server to configure your first server.</p>
              </div>
            </div>

          </div><!-- /my-servers-pane -->

          <!-- ════════════ BROWSE TAB ════════════ -->
          <div class="tab-pane fade" id="browse-pane" role="tabpanel" aria-labelledby="browse-tab">

            <!-- Search & Filter Bar -->
            <div class="ui-section p-3 mb-4">
              <div class="row g-3 align-items-end">
                <div class="col-12 col-md-5">
                  <label for="browseSearch" class="form-label">Search</label>
                  <div class="input-group">
                    <span class="input-group-text" style="background: var(--bg-tertiary); border-color: var(--border-color);">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
                        <path d="M15.5,14H14.71L14.43,13.73C15.41,12.59 16,11.11 16,9.5A6.5,6.5 0 0,0 9.5,3A6.5,6.5 0 0,0 3,9.5A6.5,6.5 0 0,0 9.5,16C11.11,16 12.59,15.41 13.73,14.43L14,14.71V15.5L19,20.5L20.5,19L15.5,14M9.5,14C7,14 5,12 5,9.5C5,7 7,5 9.5,5C12,5 14,7 14,9.5C14,12 12,14 9.5,14Z"/>
                      </svg>
                    </span>
                    <input type="search" id="browseSearch" class="form-control" placeholder="Search servers..." oninput="filterSearch()">
                  </div>
                </div>
                <div class="col-12 col-md-4">
                  <label for="browseSource" class="form-label">Source</label>
                  <select id="browseSource" class="form-select" onchange="filterSearch()">
                    <option value="all">All Sources</option>
                  </select>
                </div>
                <div class="col-12 col-md-3 ui-actions justify-content-md-end">
                  <button class="modern-btn modern-btn-secondary" onclick="refreshRegistry()" id="refreshBtn">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </svg>
                    Refresh
                  </button>
                  <button id="addSourceBtn" class="modern-btn modern-btn-secondary" onclick="showAddSourceModal(this)">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                    Add Source
                  </button>
                </div>
              </div>

              <!-- Category Filter Pills -->
              <div class="d-flex flex-wrap gap-2 mt-3" id="categoryFilters">
                <button class="btn btn-sm category-pill active" data-category="all" onclick="setCategoryFilter(this)">All</button>
                <button class="btn btn-sm category-pill" data-category="file-system" onclick="setCategoryFilter(this)">File System</button>
                <button class="btn btn-sm category-pill" data-category="database" onclick="setCategoryFilter(this)">Database</button>
                <button class="btn btn-sm category-pill" data-category="search" onclick="setCategoryFilter(this)">Search</button>
                <button class="btn btn-sm category-pill" data-category="development" onclick="setCategoryFilter(this)">Development</button>
                <button class="btn btn-sm category-pill" data-category="storage" onclick="setCategoryFilter(this)">Storage</button>
                <button class="btn btn-sm category-pill" data-category="automation" onclick="setCategoryFilter(this)">Automation</button>
                <button class="btn btn-sm category-pill" data-category="communication" onclick="setCategoryFilter(this)">Communication</button>
                <button class="btn btn-sm category-pill" data-category="productivity" onclick="setCategoryFilter(this)">Productivity</button>
                <button class="btn btn-sm category-pill" data-category="ai" onclick="setCategoryFilter(this)">AI</button>
                <button class="btn btn-sm category-pill" data-category="cloud" onclick="setCategoryFilter(this)">Cloud</button>
                <button class="btn btn-sm category-pill" data-category="devops" onclick="setCategoryFilter(this)">DevOps</button>
              </div>
            </div>

            <!-- Server Cards Grid -->
            <div id="browseResults">
              <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
            </div>

            <!-- Registry Sources Management (collapsible) -->
            <section class="ui-section ui-section--quiet mt-4" aria-labelledby="mcpSourcesToggle">
              <button id="mcpSourcesToggle" type="button" class="modern-btn modern-btn-secondary mcp-sources-toggle" aria-expanded="false" aria-controls="sourcesPanel" onclick="toggleSourcesPanel()">
                Registry Sources
                <svg id="sourcesChevron" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z"/>
                </svg>
              </button>
              <div id="sourcesPanel" class="mt-3" role="region" aria-labelledby="mcpSourcesToggle" hidden>
                <div id="sourcesList">
                  <div class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                  </div>
                </div>
              </div>
            </section>

          </div><!-- /browse-pane -->

        </div><!-- /tab-content -->

      </div>
    </div>
  </div>

  <!-- Add Server Modal -->
  <div class="modal fade" id="addServerModal" tabindex="-1" aria-labelledby="addServerTitle">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addServerTitle">Add MCP Server</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <!-- Tabs -->
          <ul class="nav nav-tabs mb-4" id="addServerTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="marketplace-tab" data-bs-toggle="tab" data-bs-target="#marketplace" type="button" role="tab">Marketplace</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="manual-tab" data-bs-toggle="tab" data-bs-target="#manual" type="button" role="tab">Manual Configuration</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="import-tab" data-bs-toggle="tab" data-bs-target="#import" type="button" role="tab">Import File</button>
            </li>
          </ul>

          <!-- Tab Content -->
          <div class="tab-content" id="addServerTabContent">
            <!-- Marketplace Tab -->
            <div class="tab-pane fade show active" id="marketplace" role="tabpanel">
              <div class="mb-3">
                <input type="search" id="marketplaceSearch" class="form-control" placeholder="Search servers..." aria-label="Search marketplace servers">
              </div>
              <div id="marketplaceList" class="list-group" style="max-height: 400px; overflow-y: auto;">
                <div class="text-center py-3">
                  <div class="spinner-border text-primary" role="status"></div>
                </div>
              </div>
            </div>

            <!-- Manual Configuration Tab -->
            <div class="tab-pane fade" id="manual" role="tabpanel">
              <form id="manualConfigForm">
                <div class="mb-3">
                  <label for="manualName" class="form-label">Server Name *</label>
                  <input type="text" id="manualName" class="form-control" required placeholder="e.g., filesystem">
                </div>
                <div class="mb-3">
                  <label for="manualCommand" class="form-label">Command *</label>
                  <input type="text" id="manualCommand" class="form-control" required placeholder="e.g., npx">
                </div>
                <div class="mb-3">
                  <label for="manualArgs" class="form-label">Arguments (JSON array)</label>
                  <textarea id="manualArgs" class="form-control" rows="3" placeholder='["-y", "@modelcontextprotocol/server-filesystem", "/path"]'></textarea>
                  <small class="form-text" style="color: var(--text-secondary);">Enter as JSON array, e.g., ["-y", "package-name"]</small>
                </div>
                <div class="mb-3">
                  <label for="manualEnv" class="form-label">Environment Variables (JSON object)</label>
                  <textarea id="manualEnv" class="form-control" rows="3" placeholder='{"KEY": "value"}'></textarea>
                  <small class="form-text" style="color: var(--text-secondary);">Enter as JSON object, e.g., {"KEY": "value"}</small>
                </div>
                <div class="mb-3">
                  <label for="manualTransport" class="form-label">Transport</label>
                  <select id="manualTransport" class="form-select">
                    <option value="stdio" selected>stdio</option>
                    <option value="sse">sse</option>
                  </select>
                </div>
                <button type="submit" class="modern-btn modern-btn-primary w-100">Add Server</button>
              </form>
            </div>

            <!-- Import File Tab -->
            <div class="tab-pane fade" id="import" role="tabpanel">
              <div class="mb-3">
                <label for="importFileInput" class="form-label">Upload Configuration File</label>
                <input type="file" id="importFileInput" class="form-control" accept=".json,.yaml,.yml">
                <small class="form-text" style="color: var(--text-secondary);">Upload a JSON or YAML file containing MCP server configurations</small>
              </div>
              <div id="importPreview" class="mt-3" style="display: none;">
                <h6 style="color: var(--text-primary);">Preview:</h6>
                <pre id="importPreviewContent" class="mcp-code-preview" tabindex="0" aria-label="Configuration preview"></pre>
              </div>
              <button id="importBtn" class="modern-btn modern-btn-primary w-100" style="display: none;">Import Servers</button>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Remove Confirmation Modal -->
  <div class="modal fade" id="removeServerModal" tabindex="-1" aria-labelledby="removeServerTitle">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="removeServerTitle">Confirm Removal</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="color: var(--text-primary);">
          <p>Are you sure you want to remove <strong id="removeServerName"></strong>?</p>
          <p class="text-muted">This action cannot be undone.</p>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="confirmRemoveBtn" class="modern-btn modern-btn-danger">Remove</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Registry Source Modal -->
  <div class="modal fade" id="addSourceModal" tabindex="-1" aria-labelledby="addSourceTitle">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="addSourceTitle">Add Registry Source</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label for="sourceNameInput" class="form-label">Source Name *</label>
            <input type="text" id="sourceNameInput" class="form-control" placeholder="My Custom Registry">
          </div>
          <div class="mb-3">
            <label for="sourceUrlInput" class="form-label">URL or GitHub shorthand *</label>
            <input type="text" id="sourceUrlInput" class="form-control" placeholder="https://example.com/registry.json  or  user/repo">
            <small class="form-text" style="color: var(--text-secondary);">Provide a URL to a JSON registry file, or a GitHub "user/repo" shorthand (expects main/registry.json).</small>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="modern-btn modern-btn-primary" onclick="submitAddSource()">Add Source</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Server Details Modal -->
  <div class="modal fade" id="serverDetailsModal" tabindex="-1" aria-labelledby="serverDetailsTitle">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="serverDetailsTitle">Server Details</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="serverDetailsBody" style="color: var(--text-primary);"></div>
      </div>
    </div>
  </div>

  {{template "modals.tmpl" .}}

  <style>
    .mcp-page .main-content-wrapper { background: var(--bg-primary); }
    .mcp-section-title { margin: 0; font: 600 1rem var(--font-body); }
    .mcp-wrap-row { display: flex; flex-wrap: wrap; align-items: flex-start; gap: var(--space-3); justify-content: space-between; }
    .mcp-server-copy { flex: 1 1 18rem; min-width: 0; overflow-wrap: anywhere; }
    .mcp-page :is(.badge, .modal-title) { white-space: normal; overflow-wrap: anywhere; }
    .mcp-metadata { color: var(--text-secondary); font-size: 0.875rem; overflow-wrap: anywhere; }
    .mcp-sources-toggle { width: 100%; justify-content: space-between; }
    .mcp-sources-toggle[aria-expanded="true"] #sourcesChevron { transform: rotate(180deg); }
    .mcp-page .category-pill { border-radius: 999px; }
    .mcp-page .category-pill.active {
      background: var(--bg-secondary);
      color: var(--text-primary);
      border-color: var(--focus-color);
      box-shadow: inset 0 0 0 1px var(--focus-color);
    }
    .mcp-code-preview { background: var(--bg-secondary); color: var(--text-primary); border-radius: var(--radius-sm); padding: var(--space-4); max-height: 300px; overflow: auto; white-space: pre-wrap; overflow-wrap: anywhere; }
    .mcp-info-list { margin: 0; }
    .mcp-info-list > div { display: grid; grid-template-columns: minmax(7rem, 30%) minmax(0, 1fr); gap: var(--space-2); padding-block: var(--space-3); border-bottom: 1px solid var(--border-color); }
    .mcp-info-list dt { font-weight: 600; color: var(--text-secondary); }
    .mcp-info-list dd { margin: 0; min-width: 0; overflow-wrap: anywhere; color: var(--text-primary); }
    @media (max-width: 480px) {
      .mcp-info-list > div { grid-template-columns: minmax(0, 1fr); }
    }
    .mcp-source-row { padding-block: var(--space-3); border-bottom: 1px solid var(--border-color); }
    .mcp-page .marketplace-item { gap: var(--space-3); flex-wrap: wrap; cursor: default; }

    /* Rendered README / instructions markdown inside the details modal */
    .mcp-markdown {
      color: var(--text-primary);
      overflow-wrap: anywhere;
    }
    .mcp-markdown img { max-width: 100%; height: auto; }
    .mcp-markdown pre {
      background: var(--bg-tertiary);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: var(--space-3);
      overflow-x: auto;
    }
    .mcp-markdown code {
      background: var(--bg-tertiary);
      padding: 0.1rem 0.3rem;
      border-radius: var(--radius-sm);
      color: var(--text-primary);
    }
    .mcp-markdown pre code { background: transparent; padding: 0; }
    .mcp-markdown table { width: 100%; border-collapse: collapse; }
    .mcp-markdown th, .mcp-markdown td {
      border: 1px solid var(--border-color);
      padding: 0.35rem 0.5rem;
    }
    .mcp-markdown a { color: var(--accent-text); }
    .mcp-markdown h1, .mcp-markdown h2, .mcp-markdown h3 { color: var(--text-primary); }
  </style>

  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Markdown rendering for MCP README / instructions -->
  <script defer src="/js/vendor/marked-14.1.4.min.js" integrity="sha384-lqPzN0kmFw9t2syAMwVPM4VbAyqsz/lPyYWbb2Xt6nSPM0WPNrpSWCUBgdcAdgnC"></script>
  <script defer src="/js/vendor/dompurify-3.1.6.min.js" integrity="sha384-+VfUPEb0PdtChMwmBcBmykRMDd+v6D/oFmB3rZM/puCMDYcIvF968OimRh4KQY9a"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/app.js?v=1694538177"></script>
  <script defer src="/js/modules/agents.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "theme-init.tmpl" .}}
  <script defer src="/js/modules/toast.js"></script>
  <script defer src="/js/mcp.js"></script>
</body>
</html>
{{end}}
