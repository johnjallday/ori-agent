              <button type="button" id="hubFileSourceVaultBtn" class="hub-file-source-btn" data-source="vault" aria-pressed="false">From Vault</button>
            </div>

            <div id="hubFileDevicePane">
              <div id="hubFileDropZone" class="hub-file-drop-zone mb-3">
