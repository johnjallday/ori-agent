  <!-- Workspace MCP Modal -->
  <div class="modal fade" id="workspace-detail-mcp-modal" tabindex="-1" aria-labelledby="workspace-detail-mcp-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content workspace-detail-mcp-modal-content">
        <div class="modal-header">
          <div class="workspace-detail-mcp-modal-heading">
            <div class="workspace-detail-mcp-modal-kicker">Workspace-scoped connector</div>
            <h5 class="modal-title" id="workspace-detail-mcp-modal-title">Add Workspace MCP</h5>
            <p id="workspace-detail-mcp-modal-subtitle" class="workspace-detail-mcp-modal-subtitle mb-0">
              Bind a globally available MCP connector to this workspace, then decide which agent instances can use it here.
            </p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form id="workspace-detail-mcp-form">
          <div class="modal-body">
            <div id="workspace-detail-mcp-modal-banner" class="workspace-detail-mcp-modal-banner">
              Workspace bindings control scope and access. Global MCP settings still define how each connector starts.
            </div>
            <div class="row g-3">
              <div class="col-md-6">
                <label for="workspace-detail-mcp-server" class="form-label">Connector</label>
                <select id="workspace-detail-mcp-server" class="form-select">
                  <option value="">Select a connector</option>
                </select>
                <div id="workspace-detail-mcp-server-help" class="workspace-detail-mcp-field-help">
                  Only globally enabled connectors can be added here.
                </div>
              </div>
              <div class="col-md-6">
                <label for="workspace-detail-mcp-alias" class="form-label">Alias</label>
                <input id="workspace-detail-mcp-alias" type="text" class="form-control" maxlength="120" placeholder="docs_fs or repo_browser">
                <div class="workspace-detail-mcp-field-help">
                  Optional human-friendly label for this binding inside the workspace.
                </div>
              </div>
              <div class="col-12">
                <div class="form-check form-switch workspace-detail-mcp-toggle">
                  <input class="form-check-input" type="checkbox" role="switch" id="workspace-detail-mcp-enabled" checked>
                  <label class="form-check-label" for="workspace-detail-mcp-enabled">Enabled in this workspace</label>
                </div>
              </div>
              <div class="col-12">
                <label for="workspace-detail-mcp-scope" class="form-label">Scope JSON</label>
                <textarea id="workspace-detail-mcp-scope" class="form-control workspace-detail-mcp-scope-input" rows="7" spellcheck="false" placeholder="{&#10;  &quot;roots&quot;: [&quot;/repo/app&quot;]&#10;}"></textarea>
                <div class="workspace-detail-mcp-field-help">
                  Optional JSON object for workspace-specific scope like <code>roots</code>, <code>repos</code>, or <code>channels</code>.
                </div>
              </div>
              <div class="col-12">
                <label for="workspace-detail-mcp-config" class="form-label">Config JSON</label>
                <textarea id="workspace-detail-mcp-config" class="form-control workspace-detail-mcp-scope-input" rows="7" spellcheck="false" placeholder="{&#10;  &quot;args&quot;: [&quot;playwright-mcp&quot;, &quot;--headless&quot;],&#10;  &quot;env&quot;: { &quot;BROWSER_CONTEXT&quot;: &quot;workspace&quot; }&#10;}"></textarea>
                <div class="workspace-detail-mcp-field-help">
                  Optional runtime overrides for this workspace binding. Supported keys today are <code>command</code>, <code>args</code>, <code>env</code>, and <code>transport</code>.
                </div>
              </div>
              <div class="col-12">
                <div class="workspace-detail-mcp-agent-access-card">
                  <div class="workspace-detail-mcp-agent-access-header">
                    <div>
                      <div class="workspace-detail-mcp-agent-access-title">Agent access</div>
                      <div class="workspace-detail-mcp-agent-access-subtitle">Choose which agent instances can use this binding in this workspace.</div>
                    </div>
                    <div id="workspace-detail-mcp-agent-access-summary" class="workspace-detail-mcp-agent-access-summary">0 selected</div>
                  </div>
                  <div id="workspace-detail-mcp-agent-options" class="workspace-detail-mcp-agent-options">
                    <div class="workspace-detail-mcp-agent-empty">No agent instances in this workspace yet.</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="submit" class="btn btn-primary" id="workspace-detail-mcp-submit">Save Binding</button>
          </div>
        </form>
      </div>
    </div>
  </div>

