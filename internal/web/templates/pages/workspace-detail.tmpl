              <label for="hubFileNotes" class="form-label" style="color: var(--text-primary); font-weight: 500;">Notes (optional)</label>
              <textarea class="form-control" id="hubFileNotes" rows="2" placeholder="Add notes or description..."></textarea>
            </div>
          </form>
          <div id="hubFileUploadProgress" class="hub-file-upload-progress" style="display: none;">
            <div class="d-flex justify-content-between align-items-center mb-2">
