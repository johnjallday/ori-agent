    }

    .workspace-detail-board-add-input {
      width: 100%;
      border: 1px solid var(--border-color);
      background: var(--bg-tertiary);
      border-radius: 4px;
      padding: 0.3rem 0.4rem;
      font-size: 0.65rem;
      color: var(--text-primary);
