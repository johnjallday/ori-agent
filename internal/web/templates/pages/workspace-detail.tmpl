                    <select id="hubVaultSelect" class="form-select">
                      <option value="">Loading vaults...</option>
                    </select>
                  </div>
                  <button type="button" id="hubVaultRefreshBtn" class="modern-btn modern-btn-secondary modern-btn-sm">Refresh</button>
                </div>

                <div class="hub-file-vault-search-wrap">
