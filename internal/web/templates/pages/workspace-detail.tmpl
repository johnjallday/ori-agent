    }

    .workspace-detail-board-card-meta-secondary {
      margin-top: 0.2rem;
      font-size: 0.55rem;
    }

    .workspace-detail-board-card-assignee.is-muted {
      color: var(--text-secondary);
    }

    .workspace-detail-board-card-due {
      color: var(--text-secondary);
    }

    .workspace-detail-board-card-edit {
      display: none;
      flex-direction: column;
      gap: 0.35rem;
    }

    .workspace-detail-board-card-edit-label {
      font-size: 0.6rem;
      color: var(--text-secondary);
      margin-bottom: -0.1rem;
    }

    .workspace-detail-board-card-edit-input {
      width: 100%;
      border: 1px solid var(--border-color);
      background: var(--bg-tertiary);
      border-radius: 4px;
      padding: 0.3rem 0.4rem;
      font-size: 0.65rem;
      color: var(--text-primary);
    }

    .workspace-detail-board-card-edit-input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb, 99, 102, 241), 0.15);
    }

    .workspace-detail-board-card-edit-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.35rem;
      margin-top: 0.2rem;
    }

    .workspace-detail-board-card-edit-actions .modern-btn {
      font-size: 0.55rem;
      padding: 0.2rem 0.35rem;
    }

    .workspace-detail-board-card.is-editing {
      cursor: default;
    }

    .workspace-detail-board-card.is-editing .workspace-detail-board-card-view {
      display: none;
    }

    .workspace-detail-board-card.is-editing .workspace-detail-board-card-edit {
      display: flex;
    }

    .workspace-detail-board-card.is-saving {
      opacity: 0.75;
      pointer-events: none;
    }

    .workspace-detail-board-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      color: var(--text-secondary);
      text-align: center;
    }

    .workspace-detail-board-empty p {
      margin: 0.5rem 0;
      font-size: 0.8rem;
    }

    /* =============================================================================
       Panel Pop-out Styles
       ============================================================================= */

    /* Backdrop for expanded panels */
    .workspace-detail-panel-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(0px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                  backdrop-filter 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 10000;
    }

    .workspace-detail-panel-backdrop.is-active {
      opacity: 1;
      backdrop-filter: blur(4px);
      pointer-events: auto;
    }

    /* Expandable panel styling - NO transitions here to avoid conflicts */
    .workspace-detail-panel.is-expandable {
      cursor: pointer;
    }

    .workspace-detail-panel.is-expandable:hover:not(.is-expanded):not(.is-expanding):not(.is-collapsing) {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
      border-color: var(--primary-color);
    }

    /* Animation states - position/size controlled entirely by JS inline styles */
    .workspace-detail-panel.is-expanding,
    .workspace-detail-panel.is-expanded,
    .workspace-detail-panel.is-collapsing {
      z-index: 10001;
      cursor: default;
    }

    /* Expanded/expanding panel body gets more space */
    .workspace-detail-panel.is-expanded .workspace-detail-panel-body,
    .workspace-detail-panel.is-expanding .workspace-detail-panel-body {
      max-height: none;
      flex: 1;
      overflow-y: auto;
    }

    /* Adjust header for expanding state too */
    .workspace-detail-panel.is-expanding .workspace-detail-panel-header {
      padding-right: 2.5rem;
    }

    /* Close button for expanded panels */
    .workspace-detail-panel-close {
      display: none;
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      padding: 0.35rem;
      border: none;
      background: rgba(255, 255, 255, 0.1);
      color: var(--text-secondary);
      border-radius: var(--radius-sm, 4px);
      cursor: pointer;
      transition: background-color 0.2s ease,
                  color 0.2s ease,
                  transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 10;
    }

    .workspace-detail-panel-close:hover {
      background: rgba(239, 68, 68, 0.2);
      color: #ef4444;
      transform: scale(1.1);
    }

    .workspace-detail-panel.is-expanding .workspace-detail-panel-close {
      display: flex;
      align-items: center;
      justify-content: center;
      animation: closeButtonFadeIn 0.3s ease 0.3s forwards;
      opacity: 0;
    }

    .workspace-detail-panel.is-expanded .workspace-detail-panel-close {
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 1;
    }

    @keyframes closeButtonFadeIn {
      from {
        opacity: 0;
        transform: scale(0.8);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .workspace-detail-panel.is-collapsing .workspace-detail-panel-close {
      display: flex;
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    /* Adjust header for expanded state */
    .workspace-detail-panel.is-expanded .workspace-detail-panel-header {
      padding-right: 2.5rem;
    }

    /* Expanded panel title enlargement with transition */
    .workspace-detail-panel .workspace-detail-panel-title {
      transition: font-size 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .workspace-detail-panel.is-expanded .workspace-detail-panel-title {
      font-size: 1rem;
    }

    /* Smooth content fade in when expanding */
    .workspace-detail-panel.is-expanding .workspace-detail-panel-body {
      animation: contentFadeIn 0.35s ease 0.25s forwards;
      opacity: 0;
    }

    /* Already expanded - no animation, just show */
    .workspace-detail-panel.is-expanded .workspace-detail-panel-body {
      opacity: 1;
    }

    .workspace-detail-panel.is-collapsing .workspace-detail-panel-body {
      opacity: 1;
      animation: none;
    }

    @keyframes contentFadeIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Board view reorganizes the grid */
    .workspace-detail-bento:has(.board-view) {
      grid-template-columns: repeat(7, 1fr);
      grid-template-rows: 1fr auto;
      height: auto;
      min-height: 500px;
    }

    .workspace-detail-panel-agents.board-view {
      grid-column: 1 / -1;
      grid-row: 1;
      min-height: 350px;
      max-height: 400px;
    }

    /* Rearrange other panels to bottom row when board view is active */
    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-sessions {
      grid-column: 1;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-notes {
      grid-column: 2;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-files {
      grid-column: 3;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-directories {
      grid-column: 4;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-mcp {
      grid-column: 5;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-skills {
      grid-column: 6;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-schedules {
      grid-column: 7;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel:not(.board-view) {
      max-height: 200px;
      animation: slideInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .workspace-detail-panel-agents.board-view {
      animation: expandBoard 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @keyframes expandBoard {
      0% {
        opacity: 0.8;
        transform: scale(0.98);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes slideInUp {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Stagger animation for bottom panels */
    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-sessions {
      animation-delay: 0.05s;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-notes {
      animation-delay: 0.1s;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-files {
