{{define "workspace-detail"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <div class="main-content">
      <div class="container-fluid py-4">
        <!-- Workspace Detail View -->
        <div id="workspace-detail-view">
          <!-- Header Card -->
          <div class="modern-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-3">
                <!-- Back to Hub -->
                <a href="/" class="modern-btn modern-btn-secondary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                  </svg>
                  Hub
                </a>

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb mb-0" style="font-size: 0.875rem;">
                    <li class="breadcrumb-item"><a href="/" style="color: var(--text-secondary); text-decoration: none;">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page" id="workspace-breadcrumb-name">Loading...</li>
                  </ol>
                </nav>
              </div>

              <div class="d-flex align-items-center gap-2">
                <!-- Open Canvas Button -->
                <a id="open-canvas-btn" href="#" class="modern-btn modern-btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
                  </svg>
                  Open Canvas
                </a>

                <!-- Live Updates Indicator -->
                <span class="d-inline-flex align-items-center gap-1 px-2 py-1" style="background: rgba(40,167,69,0.1); border-radius: 4px; font-size: 0.75rem;">
                  <span class="status-indicator status-online"></span>
                  <span style="color: var(--success-color); font-weight: 500;">Live Updates</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Workspace Info Card -->
          <div class="modern-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <h1 id="workspace-name" class="mb-2" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">Loading...</h1>
                <p id="workspace-description" class="mb-0" style="color: var(--text-secondary); font-size: 0.875rem;">Loading workspace details...</p>
              </div>
              <div class="d-flex align-items-center gap-3">
                <div class="text-center">
                  <div id="workspace-agent-count" class="fw-bold" style="font-size: 1.25rem; color: var(--primary-color);">0</div>
                  <div style="font-size: 0.75rem; color: var(--text-secondary);">Agents</div>
                </div>
                <div class="text-center">
                  <div id="workspace-task-count" class="fw-bold" style="font-size: 1.25rem; color: var(--primary-color);">0</div>
                  <div style="font-size: 0.75rem; color: var(--text-secondary);">Tasks</div>
                </div>
                <div class="text-center">
                  <div id="workspace-session-count" class="fw-bold" style="font-size: 1.25rem; color: var(--primary-color);">0</div>
                  <div style="font-size: 0.75rem; color: var(--text-secondary);">Sessions</div>
                </div>
              </div>
            </div>

            <!-- Children Workspaces (inside info card, only shown if has children) -->
            <div id="workspace-detail-children-panel" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
              <div class="d-flex align-items-center gap-2 mb-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
                  <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                </svg>
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-secondary);">Child Workspaces</span>
                <span id="workspace-detail-children-count" class="badge bg-secondary" style="font-size: 0.7rem;">0</span>
              </div>
              <div id="workspace-detail-children-list" class="workspace-detail-children-grid">
                <!-- Children will be rendered here -->
              </div>
            </div>
          </div>

          <!-- Quick Add Input -->
          <div class="modern-card p-3 mb-4" id="workspace-detail-smart-input">
            <div class="d-flex align-items-center gap-2">
              <input id="workspace-detail-input" class="modern-input flex-grow-1" type="text" placeholder="Type a task or message... (use /task, /chat, /note)" autocomplete="off">
              <button id="workspace-detail-submit" class="modern-btn modern-btn-primary" type="button">Send</button>
            </div>
          </div>

          <!-- Panels Grid -->
          <div class="workspace-detail-grid">
            <!-- Tasks Panel -->
            <div class="modern-card workspace-detail-panel" id="workspace-detail-tasks-panel">
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                    <path d="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M19,19H5V5H19V19M17,8.4L15.6,7L10,12.6L7.4,10L6,11.4L10,15.4L17,8.4Z"/>
                  </svg>
                  Tasks
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-refresh-tasks" class="modern-btn modern-btn-secondary modern-btn-sm" type="button" title="Refresh">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </svg>
                  </button>
                  <button id="workspace-detail-add-task" class="modern-btn modern-btn-primary modern-btn-sm" type="button" title="Add task">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                    Add
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body">
                <div id="workspace-detail-tasks-list" class="workspace-detail-list">
                  <div class="workspace-detail-loading">Loading tasks...</div>
                </div>
              </div>
            </div>

            <!-- Sessions Panel -->
            <div class="modern-card workspace-detail-panel" id="workspace-detail-sessions-panel">
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                    <path d="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M20,16H6L4,18V4H20"/>
                  </svg>
                  Chat Sessions
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-new-session" class="modern-btn modern-btn-primary modern-btn-sm" type="button" title="New chat">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                    New Chat
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body">
                <div id="workspace-detail-sessions-list" class="workspace-detail-list">
                  <div class="workspace-detail-empty">No chat sessions yet.</div>
                </div>
              </div>
            </div>

            <!-- Files Panel -->
            <div class="modern-card workspace-detail-panel" id="workspace-detail-files-panel">
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                    <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                  </svg>
                  Files
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-add-file" class="modern-btn modern-btn-primary modern-btn-sm" type="button" title="Upload file">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"/>
                    </svg>
                    Upload
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body">
                <div id="workspace-detail-files-list" class="workspace-detail-list">
                  <div class="workspace-detail-empty">No files yet.</div>
                </div>
              </div>
            </div>

            <!-- Notes Panel -->
            <div class="modern-card workspace-detail-panel" id="workspace-detail-notes-panel">
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                    <path d="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M5,19V5H19V19H5M7,7H17V9H7V7M7,11H17V13H7V11M7,15H14V17H7V15Z"/>
                  </svg>
                  Notes
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-add-note" class="modern-btn modern-btn-primary modern-btn-sm" type="button" title="Add note">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                    Add
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body">
                <div id="workspace-detail-notes-list" class="workspace-detail-list">
                  <div class="workspace-detail-empty">No notes yet.</div>
                </div>
              </div>
            </div>

            <!-- Directories Panel -->
            <div class="modern-card workspace-detail-panel" id="workspace-detail-directories-panel">
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                    <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                  </svg>
                  Directories
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-add-directory" class="modern-btn modern-btn-primary modern-btn-sm" type="button" title="Add directory">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                    Add
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body">
                <div id="workspace-detail-directories-list" class="workspace-detail-list">
                  <div class="workspace-detail-empty">No directories yet.</div>
                </div>
              </div>
            </div>

            <!-- Schedules Panel -->
            <div class="modern-card workspace-detail-panel" id="workspace-detail-schedules-panel">
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                    <path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
                  </svg>
                  Schedules
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-view-schedules" class="modern-btn modern-btn-secondary modern-btn-sm" type="button" title="View schedules">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body">
                <div id="workspace-detail-schedules-list" class="workspace-detail-list">
                  <div class="workspace-detail-empty">No scheduled tasks yet.</div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Include session sidebar for modals (noteEditorModal, createChatModal, etc.) -->
  {{template "session-sidebar.tmpl" .}}

  <!-- Include chat area for additional modals (scheduledTasksModal, etc.) -->
  {{template "chat-area.tmpl" .}}

  <!-- Add File Modal (from workspace-hub) -->
  <div class="modal fade" id="hubAddFileModal" tabindex="-1" aria-labelledby="hubAddFileModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="hubAddFileModalTitle">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
            </svg>
            Add File
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="hubAddFileForm">
            <div id="hubFileDropZone" class="hub-file-drop-zone mb-3">
              <div class="hub-file-drop-zone-content">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" class="mb-2" style="color: var(--text-secondary); opacity: 0.6;">
                  <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13.5,16V19H10.5V16H8L12,12L16,16H13.5M13,9V3.5L18.5,9H13Z"/>
                </svg>
                <p style="color: var(--text-primary); margin-bottom: 4px;">Drag & drop files here</p>
                <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 12px;">or click to browse</p>
                <input type="file" id="hubFileInput" multiple style="display: none;">
              </div>
            </div>
            <div id="hubSelectedFilesPreview" class="hub-selected-files-preview" style="display: none;">
              <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Selected Files</label>
              <div id="hubSelectedFilesList" class="hub-selected-files-list"></div>
            </div>
            <div class="mb-3">
              <label for="hubFileTitle" class="form-label" style="color: var(--text-primary); font-weight: 500;">Title (optional)</label>
              <input type="text" class="form-control" id="hubFileTitle" placeholder="Enter a title for the file(s)...">
              <small class="text-muted">If left blank, the filename will be used</small>
            </div>
            <div class="mb-3">
              <label for="hubFileNotes" class="form-label" style="color: var(--text-primary); font-weight: 500;">Notes (optional)</label>
              <textarea class="form-control" id="hubFileNotes" rows="2" placeholder="Add notes or description..."></textarea>
            </div>
          </form>
          <div id="hubFileUploadProgress" class="hub-file-upload-progress" style="display: none;">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span style="color: var(--text-primary);">Uploading...</span>
              <span id="hubFileUploadPercent" style="color: var(--text-secondary);">0%</span>
            </div>
            <div class="progress">
              <div id="hubFileUploadProgressBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="hubAddFileSubmitBtn" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"/>
            </svg>
            Upload
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Styles for workspace detail page -->
  <style>
    .workspace-detail-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    @media (max-width: 992px) {
      .workspace-detail-grid {
        grid-template-columns: 1fr;
      }
    }

    .workspace-detail-panel {
      display: flex;
      flex-direction: column;
      min-height: 350px;
      max-height: 450px;
    }

    .workspace-detail-panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem;
      border-bottom: 1px solid var(--border-color);
    }

    .workspace-detail-panel-title {
      margin: 0;
      font-size: 1rem;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
    }

    .workspace-detail-panel-actions {
      display: flex;
      gap: 0.5rem;
    }

    .workspace-detail-panel-body {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
    }

    .workspace-detail-list {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .workspace-detail-loading,
    .workspace-detail-empty {
      text-align: center;
      color: var(--text-secondary);
      padding: 2rem;
      font-size: 0.875rem;
    }

    .workspace-detail-item {
      padding: 0.75rem;
      border-radius: 6px;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .workspace-detail-item:hover {
      background: var(--bg-tertiary);
      border-color: var(--primary-color);
    }

    .workspace-detail-item-title {
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 0.25rem;
    }

    .workspace-detail-item-meta {
      font-size: 0.75rem;
      color: var(--text-secondary);
    }

    .workspace-detail-task-status {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.125rem 0.5rem;
      border-radius: 4px;
      font-size: 0.7rem;
      font-weight: 500;
    }

    .workspace-detail-task-status.pending {
      background: rgba(108, 117, 125, 0.1);
      color: #6c757d;
    }

    .workspace-detail-task-status.in_progress {
      background: rgba(0, 123, 255, 0.1);
      color: #007bff;
    }

    .workspace-detail-task-status.completed {
      background: rgba(40, 167, 69, 0.1);
      color: #28a745;
    }

    .workspace-detail-task-status.failed {
      background: rgba(220, 53, 69, 0.1);
      color: #dc3545;
    }

    /* Children workspaces grid */
    .workspace-detail-children-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.75rem;
    }

    .workspace-detail-child-card {
      padding: 0.75rem 1rem;
      border-radius: 8px;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .workspace-detail-child-card:hover {
      background: var(--bg-tertiary);
      border-color: var(--primary-color);
      transform: translateY(-1px);
    }

    .workspace-detail-child-card .child-name {
      font-weight: 500;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .workspace-detail-child-card .child-desc {
      font-size: 0.75rem;
      color: var(--text-secondary);
      margin-top: 0.25rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .workspace-detail-child-card .child-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
      font-size: 0.7rem;
      color: var(--text-secondary);
    }
  </style>

  <!-- Core Libraries -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>

  <!-- Theme Manager (load early) -->
  <script src="/js/modules/themeManager.js"></script>

  <!-- Utils -->
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/utils/dom-utils.js"></script>

  <!-- Core Modules -->
  <script src="/js/modules/resizer.js"></script>
  <script src="/js/modules/settings.js"></script>
  <script src="/js/modules/agents.js"></script>
  <script src="/js/modules/plugins.js"></script>
  <script src="/js/modules/plugin-config.js"></script>
  <script src="/js/modules/plugin-store.js"></script>
  <script src="/js/modules/apikey.js"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/modules/plugin-health.js"></script>
  <script src="/js/modules/file-upload.js"></script>
  <script src="/js/modules/location.js"></script>
  <script src="/js/modules/task-modal-controller.js"></script>
