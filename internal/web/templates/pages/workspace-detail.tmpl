{{define "workspace-detail"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <div class="main-content">
      <div class="container-fluid py-4">
        <!-- Workspace Detail View -->
        <div id="workspace-detail-view">
          <!-- Header Card -->
          <div class="modern-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-3">
                <!-- Back to Workspaces -->
                <a href="/workspaces" class="modern-btn modern-btn-secondary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                  </svg>
                  Workspaces
                </a>

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb mb-0" style="font-size: 0.875rem;">
                    <li class="breadcrumb-item"><a href="/workspaces" style="color: var(--text-secondary); text-decoration: none;">Workspaces</a></li>
                    <li class="breadcrumb-item active" aria-current="page" id="workspace-breadcrumb-name">Loading...</li>
                  </ol>
                </nav>
              </div>

              <div class="d-flex align-items-center gap-2">
                <a id="open-workflows-btn" href="/workflows" class="modern-btn modern-btn-secondary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M7,5A2,2 0 0,0 5,7V10A2,2 0 0,0 7,12H10A2,2 0 0,0 12,10V7A2,2 0 0,0 10,5H7M14,5A2,2 0 0,0 12,7V10A2,2 0 0,0 14,12H17A2,2 0 0,0 19,10V7A2,2 0 0,0 17,5H14M7,12A2,2 0 0,0 5,14V17A2,2 0 0,0 7,19H10A2,2 0 0,0 12,17V14A2,2 0 0,0 10,12H7M13,13H19V15H13V13M13,17H19V19H13V17Z"/>
                  </svg>
                  Orchestration Skills
                </a>

                <a id="open-diagnostics-btn" href="#" class="modern-btn modern-btn-secondary" title="Workspace diagnostics and health">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M9,2V8H5V14H1V20H7V18H17V20H23V14H19V8H15V2H9M11,4H13V12H11V4M7,10H17V12H7V10M3,16H5V18H3V16M19,16H21V18H19V16Z"/>
                  </svg>
                  Diagnostics
                </a>

                <!-- Open Canvas Button -->
                <a id="open-canvas-btn" href="#" class="modern-btn modern-btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
                  </svg>
                  Open Canvas
                </a>

                <!-- Live Updates Indicator -->
                <span class="d-inline-flex align-items-center gap-1 px-2 py-1" style="background: rgba(40,167,69,0.1); border-radius: 4px; font-size: 0.75rem;">
                  <span class="status-indicator status-online"></span>
                  <span style="color: var(--success-color); font-weight: 500;">Live Updates</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Workspace Entry Prompt Bar -->
          <div id="homeAssistantCard" class="modern-card p-2 mb-3">
            <form id="homeAssistantForm" class="home-assistant-workspace-form d-flex align-items-center gap-2">
              <div class="d-none d-md-flex align-items-center gap-2 px-2" style="color: var(--text-secondary); font-size: 0.82rem; white-space: nowrap;">
                <span id="homeAssistantIdentityName" style="font-weight: 600; color: var(--text-primary); display: inline-block; max-width: 180px; overflow: hidden; text-overflow: ellipsis;" title="Workspace Manager">Workspace Manager</span>
                <span style="opacity: 0.6;">Workspace</span>
              </div>
              <div id="homeAssistantWorkspaceModeSwitch" class="home-assistant-workspace-mode-switch" role="group" aria-label="Workspace prompt mode">
                <button type="button" class="home-assistant-workspace-mode-btn is-active" data-home-workspace-mode="task" aria-pressed="true">Task</button>
                <button type="button" class="home-assistant-workspace-mode-btn" data-home-workspace-mode="ask" aria-pressed="false">Ask</button>
                <button type="button" class="home-assistant-workspace-mode-btn" data-home-workspace-mode="note" aria-pressed="false">Note</button>
              </div>
              <input id="homeAssistantInput" type="text" class="modern-input flex-grow-1" maxlength="800"
                     placeholder="Create a task for Workspace Manager... (/chat asks, /note saves a note)"
                     aria-label="Workspace manager prompt"
                     style="min-height: 42px;">
              <button id="homeAssistantSendBtn" type="submit" class="modern-btn modern-btn-primary home-assistant-send-btn">Create Task</button>
              <button id="homeAssistantConfigureTaskBtn" type="button" class="modern-btn modern-btn-secondary"
                      title="Open task editor (review details, agent, schedule before saving)"
                      aria-label="Open task editor"
                      style="padding: 6px 10px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M3 17v2h6v-2H3M3 5v2h10V5H3M13 21v-2h8v-2h-8v-2h-2v6h2M7 9v2H3v2h4v2h2V9H7M21 13v-2H11v2h10M15 9h2V7h4V5h-4V3h-2v6Z"/>
                </svg>
              </button>
            </form>
            <div id="homeAssistantQuickPrompts" class="d-flex flex-wrap align-items-center gap-2 px-2 pt-2">
              <span class="home-assistant-quick-label mb-0">Quick Actions</span>
              <button id="homeAssistantQuickPlan" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                      data-home-prompt="Analyze this workspace and propose the next 3 highest-impact tasks with acceptance criteria.">
                Plan Next
              </button>
              <button id="homeAssistantQuickTasks" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                      data-home-prompt="Review current tasks in this workspace, identify blockers, and suggest the next 3 tasks.">
                Unblock Tasks
              </button>
              <button id="homeAssistantQuickNotes" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                      data-home-prompt="">
                Create Description
              </button>
              <button id="homeAssistantQuickReview" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                      data-home-prompt="Run a risk review for this workspace and recommend mitigation steps.">
                Risk Review
              </button>
            </div>
          </div>

          <!-- Workspace Info Card -->
          <div class="modern-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="workspace-editable-field" id="workspace-name-container">
                  <h1 id="workspace-name" class="mb-2" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">Loading...</h1>
                  <button class="workspace-edit-btn" data-field="name" type="button" title="Edit name">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                    </svg>
                  </button>
                </div>
                <div class="workspace-editable-field" id="workspace-description-container">
                  <p id="workspace-description" class="mb-0" style="color: var(--text-secondary); font-size: 0.875rem;">Loading workspace details...</p>
                  <button class="workspace-edit-btn" data-field="description" type="button" title="Edit description">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="d-flex align-items-center gap-3">
                <div class="text-center">
                  <div id="workspace-agent-count" class="fw-bold" style="font-size: 1.25rem; color: var(--primary-color);" aria-busy="true" aria-label="Agents (loading)">—</div>
                  <div style="font-size: 0.75rem; color: var(--text-secondary);">Agents</div>
                </div>
                <div class="text-center">
                  <div id="workspace-task-count" class="fw-bold" style="font-size: 1.25rem; color: var(--primary-color);" aria-busy="true" aria-label="Tasks (loading)">—</div>
                  <div style="font-size: 0.75rem; color: var(--text-secondary);">Tasks</div>
                </div>
                <div class="text-center">
                  <div id="workspace-session-count" class="fw-bold" style="font-size: 1.25rem; color: var(--primary-color);" aria-busy="true" aria-label="Sessions (loading)">—</div>
                  <div style="font-size: 0.75rem; color: var(--text-secondary);">Sessions</div>
                </div>
              </div>
            </div>

            <!-- Children Workspaces (inside info card, only shown if has children) -->
            <div id="workspace-detail-children-panel" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
              <div class="d-flex align-items-center gap-2 mb-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
                  <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                </svg>
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-secondary);">Child Workspaces</span>
                <span id="workspace-detail-children-count" class="badge bg-secondary" style="font-size: 0.7rem;">0</span>
              </div>
              <div id="workspace-detail-children-list" class="workspace-detail-children-grid">
                <!-- Children will be rendered here -->
              </div>
            </div>

            <div id="workspace-detail-workflow-links-panel" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
              <div class="d-flex align-items-center gap-2 mb-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
                  <path d="M7,5A2,2 0 0,0 5,7V10A2,2 0 0,0 7,12H10A2,2 0 0,0 12,10V7A2,2 0 0,0 10,5H7M14,5A2,2 0 0,0 12,7V10A2,2 0 0,0 14,12H17A2,2 0 0,0 19,10V7A2,2 0 0,0 17,5H14M7,12A2,2 0 0,0 5,14V17A2,2 0 0,0 7,19H10A2,2 0 0,0 12,17V14A2,2 0 0,0 10,12H7M13,13H19V15H13V13M13,17H19V19H13V17Z"/>
                </svg>
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-secondary);">Orchestration Skills</span>
                <span id="workspace-detail-workflow-links-count" class="badge bg-secondary" style="font-size: 0.7rem;">0</span>
              </div>
              <div id="workspace-detail-workflow-links-list" class="workspace-detail-workflow-chip-row">
                <!-- Workflow template links will be rendered here -->
              </div>
            </div>
          </div>

          <!-- Workspace Health moved to /workspaces/{id}/diagnostics -->

          <!-- Workspace Goal -->
          <section class="modern-card workspace-detail-goal-card mb-4" id="workspace-detail-goal-card" aria-labelledby="workspace-detail-goal-title">
            <div class="workspace-detail-goal-main">
              <div class="workspace-detail-goal-label-row">
                <div class="workspace-detail-goal-kicker">Workspace Goal</div>
                <span class="workspace-detail-goal-status is-loading" id="workspace-detail-goal-status">Loading</span>
              </div>
              <h2 class="workspace-detail-goal-title" id="workspace-detail-goal-title">Goal</h2>
              <p class="workspace-detail-goal-text" id="workspace-detail-goal-text">Loading workspace goal...</p>
              <div class="workspace-detail-goal-meta" aria-label="Goal automation timing">
                <span id="workspace-detail-goal-cadence">Cadence: loading</span>
                <span id="workspace-detail-goal-next-run">Next run: loading</span>
                <span id="workspace-detail-goal-last-run">Last run: loading</span>
              </div>
              <div class="workspace-detail-goal-action-status" id="workspace-detail-goal-action-status" aria-live="polite"></div>
            </div>
            <div class="workspace-detail-goal-actions">
              <button type="button" class="modern-btn modern-btn-secondary modern-btn-sm" id="workspace-detail-goal-edit">Edit goal</button>
              <button type="button" class="modern-btn modern-btn-primary modern-btn-sm" id="workspace-detail-goal-run">Run now</button>
              <a href="/action-center" class="modern-btn modern-btn-secondary modern-btn-sm" id="workspace-detail-goal-findings">Findings</a>
            </div>
          </section>

          <div class="modal fade" id="workspace-detail-goal-modal" tabindex="-1" aria-labelledby="workspace-detail-goal-modal-title" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
              <form class="modal-content workspace-detail-goal-modal-content" id="workspace-detail-goal-modal-form">
                <div class="modal-header workspace-detail-goal-modal-header">
                  <div>
                    <div class="workspace-detail-goal-kicker">Workspace Goal</div>
                    <h2 class="modal-title workspace-detail-goal-modal-title" id="workspace-detail-goal-modal-title">Set goal</h2>
                  </div>
                  <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body workspace-detail-goal-modal-body">
                  <div class="workspace-detail-goal-modal-warning" id="workspace-detail-goal-modal-bindings-warning" style="display: none;" role="status">
                    <strong>Classify workspace bindings before this goal can run.</strong>
                    <div class="workspace-detail-goal-modal-warning-list" id="workspace-detail-goal-modal-unclassified-list"></div>
                    <div class="workspace-detail-goal-modal-warning-hint">Open <em>Advanced settings</em> → MCP or Workspace Skills to set each binding's side effect (read / write / external).</div>
                  </div>

                  <div class="workspace-detail-goal-modal-field">
                    <label for="workspace-detail-goal-modal-text" class="form-label">Goal</label>
                    <textarea id="workspace-detail-goal-modal-text" class="form-control" rows="4" placeholder="e.g. Keep brand voice and visuals consistent across all channels."></textarea>
                  </div>

                  <div class="workspace-detail-goal-modal-grid">
                    <div class="workspace-detail-goal-modal-field">
                      <label for="workspace-detail-goal-modal-cadence-type" class="form-label">Cadence</label>
                      <select id="workspace-detail-goal-modal-cadence-type" class="form-select">
                        <option value="">Manual only</option>
                        <option value="daily">Daily</option>
                        <option value="weekly">Weekly</option>
                        <option value="monthly">Monthly</option>
                        <option value="interval">Custom interval</option>
                      </select>
                    </div>

                    <div class="workspace-detail-goal-modal-field" id="workspace-detail-goal-modal-cadence-time-wrap" style="display: none;">
                      <label for="workspace-detail-goal-modal-cadence-time" class="form-label">Time of day</label>
                      <input id="workspace-detail-goal-modal-cadence-time" type="time" class="form-control" value="09:00">
                    </div>
                    <div class="workspace-detail-goal-modal-field" id="workspace-detail-goal-modal-cadence-dow-wrap" style="display: none;">
                      <label for="workspace-detail-goal-modal-cadence-dow" class="form-label">Day of week</label>
                      <select id="workspace-detail-goal-modal-cadence-dow" class="form-select">
                        <option value="1">Monday</option>
                        <option value="2">Tuesday</option>
                        <option value="3">Wednesday</option>
                        <option value="4">Thursday</option>
                        <option value="5">Friday</option>
                        <option value="6">Saturday</option>
                        <option value="0">Sunday</option>
                      </select>
                    </div>
                    <div class="workspace-detail-goal-modal-field" id="workspace-detail-goal-modal-cadence-dom-wrap" style="display: none;">
                      <label for="workspace-detail-goal-modal-cadence-dom" class="form-label">Day of month</label>
                      <input id="workspace-detail-goal-modal-cadence-dom" type="number" class="form-control" min="1" max="31" value="1">
                    </div>
                    <div class="workspace-detail-goal-modal-field" id="workspace-detail-goal-modal-cadence-interval-wrap" style="display: none;">
                      <label for="workspace-detail-goal-modal-cadence-interval" class="form-label">Interval (hours)</label>
                      <input id="workspace-detail-goal-modal-cadence-interval" type="number" class="form-control" min="1" value="24">
                    </div>
                  </div>

                  <div class="form-check form-switch workspace-detail-goal-modal-switch">
                    <input class="form-check-input" type="checkbox" id="workspace-detail-goal-modal-enabled">
                    <label class="form-check-label" for="workspace-detail-goal-modal-enabled">
                      Enable goal automation
                    </label>
                  </div>
                  <div class="workspace-detail-goal-modal-enabled-hint" id="workspace-detail-goal-modal-enabled-hint" style="display: none;">Pick a cadence above to enable automatic runs.</div>
                  <div class="workspace-detail-goal-modal-autonomy" id="workspace-detail-goal-modal-autonomy"></div>
                  <div class="workspace-detail-goal-modal-status" id="workspace-detail-goal-modal-status" aria-live="polite"></div>
                </div>
                <div class="modal-footer workspace-detail-goal-modal-footer">
                  <button type="button" class="btn btn-link" id="workspace-detail-goal-modal-advanced">Advanced settings</button>
                  <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                  <button type="submit" class="btn btn-primary" id="workspace-detail-goal-modal-save">Save goal</button>
                </div>
              </form>
            </div>
          </div>

          <!-- Workspace Configuration -->
          <div class="modern-card workspace-detail-config-card is-collapsed mb-4" id="workspace-detail-settings-panel">
            <div class="workspace-detail-config-header">
              <div>
                <div class="workspace-detail-config-kicker">Workspace Configuration</div>
                <h2 class="workspace-detail-config-title">Goal automation, manager behavior, MCP, and skills</h2>
                <div class="workspace-detail-config-summary" id="workspace-detail-config-summary">
                  <span class="workspace-detail-config-chip" id="workspace-detail-config-preset-chip">Workspace: General · Guided</span>
                  <span class="workspace-detail-config-chip" id="workspace-detail-config-connections-chip">MCP: 0</span>
                  <span class="workspace-detail-config-chip" id="workspace-detail-config-skills-chip">Skills: 0</span>
                </div>
              </div>
              <button
                class="workspace-detail-config-toggle"
                id="workspace-detail-config-toggle"
                type="button"
                aria-expanded="false"
                aria-controls="workspace-detail-config-content">
                <span id="workspace-detail-config-toggle-label">Show Configuration</span>
                <svg class="workspace-detail-config-toggle-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M7.41,8.59L12,13.17L16.59,8.59L18,10L12,16L6,10L7.41,8.59Z"/>
                </svg>
              </button>
            </div>
            <div class="workspace-detail-config-content" id="workspace-detail-config-content" hidden>
              <div class="nav nav-tabs workspace-detail-config-nav" role="tablist" aria-label="Workspace configuration sections">
                <button
                  class="nav-link workspace-detail-config-tab active"
                  id="workspace-detail-config-intent-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#workspace-detail-config-intent-pane"
                  type="button"
                  role="tab"
                  aria-controls="workspace-detail-config-intent-pane"
                  aria-selected="true">
                  Intent &amp; Setup
                </button>
                <button
                  class="nav-link workspace-detail-config-tab"
                  id="workspace-detail-config-settings-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#workspace-detail-config-settings-pane"
                  type="button"
                  role="tab"
                  aria-controls="workspace-detail-config-settings-pane"
                  aria-selected="false">
                  Manager Settings
                </button>
                <button
                  class="nav-link workspace-detail-config-tab"
                  id="workspace-detail-config-mcp-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#workspace-detail-config-mcp-pane"
                  type="button"
                  role="tab"
                  aria-controls="workspace-detail-config-mcp-pane"
                  aria-selected="false">
                  MCP
                </button>
                <button
                  class="nav-link workspace-detail-config-tab"
                  id="workspace-detail-config-skills-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#workspace-detail-config-skills-pane"
                  type="button"
                  role="tab"
                  aria-controls="workspace-detail-config-skills-pane"
                  aria-selected="false">
                  Workspace Skills
                </button>
                <button
                  class="nav-link workspace-detail-config-tab"
                  id="workspace-detail-config-mission-tab"
                  data-bs-toggle="tab"
                  data-bs-target="#workspace-detail-config-mission-pane"
                  type="button"
                  role="tab"
                  aria-controls="workspace-detail-config-mission-pane"
                  aria-selected="false">
                  Goal Settings
                </button>
              </div>
              <div class="tab-content workspace-detail-config-body">
                <div
                  class="tab-pane fade show active workspace-detail-config-pane"
                  id="workspace-detail-config-intent-pane"
                  role="tabpanel"
                  aria-labelledby="workspace-detail-config-intent-tab"
                  tabindex="0">
                  <div class="workspace-detail-config-pane-header">
                    <div>
                      <div class="workspace-detail-config-pane-title">Workspace Intent</div>
                      <div class="workspace-detail-config-pane-copy">
                        Keep the workspace description, systems, key context, and setup intent aligned so Ori can reuse the same source of truth across notes, planning, and setup review.
                      </div>
                    </div>
                    <div class="workspace-detail-config-pane-actions">
                      <button id="workspace-detail-intent-review" class="workspace-detail-panel-btn" type="button" title="Re-run setup review">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                          <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                        </svg>
                        Re-run Setup Review
                      </button>
                    </div>
                  </div>
                  <form id="workspace-detail-intent-form" class="workspace-detail-settings-form">
                    <div class="workspace-detail-settings-intro">
                      Editing this intent keeps the workspace header, canonical note, and setup-review inputs aligned. Use setup review to refresh recommended agents, connectors, and skills for the workspace.
                    </div>
