{{define "workspace-detail"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <div class="main-content">
      <div class="container-fluid py-4">
        <!-- Workspace Detail View -->
        <div id="workspace-detail-view">
          <!-- Header Card -->
          <div class="modern-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-3">
                <!-- Back to Workspaces -->
                <a href="/workspaces" class="modern-btn modern-btn-secondary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                  </svg>
                  Workspaces
                </a>

                <!-- Breadcrumb -->
                <nav aria-label="breadcrumb">
                  <ol class="breadcrumb mb-0" style="font-size: 0.875rem;">
                    <li class="breadcrumb-item"><a href="/workspaces" style="color: var(--text-secondary); text-decoration: none;">Workspaces</a></li>
                    <li class="breadcrumb-item active" aria-current="page" id="workspace-breadcrumb-name">Loading...</li>
                  </ol>
                </nav>
              </div>

              <div class="d-flex align-items-center gap-2">
                <!-- Open Canvas Button -->
                <a id="open-canvas-btn" href="#" class="modern-btn modern-btn-primary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
                  </svg>
                  Open Canvas
                </a>

                <!-- Live Updates Indicator -->
                <span class="d-inline-flex align-items-center gap-1 px-2 py-1" style="background: rgba(40,167,69,0.1); border-radius: 4px; font-size: 0.75rem;">
                  <span class="status-indicator status-online"></span>
                  <span style="color: var(--success-color); font-weight: 500;">Live Updates</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Workspace Entry Prompt Bar -->
          <div id="homeAssistantCard" class="modern-card p-2 mb-3">
            <form id="homeAssistantForm" class="d-flex align-items-center gap-2">
              <div class="d-none d-md-flex align-items-center gap-2 px-2" style="color: var(--text-secondary); font-size: 0.82rem; white-space: nowrap;">
                <span id="homeAssistantIdentityName" style="font-weight: 600; color: var(--text-primary); display: inline-block; max-width: 180px; overflow: hidden; text-overflow: ellipsis;" title="Workspace Manager">Workspace Manager</span>
                <span style="opacity: 0.6;">Workspace</span>
              </div>
              <input id="homeAssistantInput" type="text" class="modern-input flex-grow-1" maxlength="800"
                     placeholder="Ask Workspace Manager about this workspace... (or use /task, /note, /directory, /file, /chat)"
                     aria-label="Workspace manager prompt"
                     style="min-height: 42px;">
              <button id="homeAssistantSendBtn" type="submit" class="modern-btn modern-btn-primary home-assistant-send-btn">Send</button>
            </form>
            <div id="homeAssistantQuickPrompts" class="d-flex flex-wrap align-items-center gap-2 px-2 pt-2">
              <span class="home-assistant-quick-label mb-0">Quick Actions</span>
              <button id="homeAssistantQuickPlan" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                      data-home-prompt="Analyze this workspace and propose the next 3 highest-impact tasks with acceptance criteria.">
                Plan Next
              </button>
              <button id="homeAssistantQuickTasks" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                      data-home-prompt="Review current tasks in this workspace, identify blockers, and suggest the next 3 tasks.">
                Unblock Tasks
              </button>
              <button id="homeAssistantQuickNotes" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                      data-home-prompt="/note # Workspace Brief\n## Goal\n- \n## Constraints\n- \n## Open Questions\n- ">
                Create Brief
              </button>
              <button id="homeAssistantQuickReview" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                      data-home-prompt="Run a risk review for this workspace and recommend mitigation steps.">
                Risk Review
              </button>
            </div>
          </div>

          <!-- Workspace Info Card -->
          <div class="modern-card p-4 mb-4">
            <div class="d-flex justify-content-between align-items-start">
              <div>
                <div class="workspace-editable-field" id="workspace-name-container">
                  <h1 id="workspace-name" class="mb-2" style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary);">Loading...</h1>
                  <button class="workspace-edit-btn" data-field="name" type="button" title="Edit name">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                    </svg>
                  </button>
                </div>
                <div class="workspace-editable-field" id="workspace-description-container">
                  <p id="workspace-description" class="mb-0" style="color: var(--text-secondary); font-size: 0.875rem;">Loading workspace details...</p>
                  <button class="workspace-edit-btn" data-field="description" type="button" title="Edit description">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="d-flex align-items-center gap-3">
                <div class="text-center">
                  <div id="workspace-agent-count" class="fw-bold" style="font-size: 1.25rem; color: var(--primary-color);">0</div>
                  <div style="font-size: 0.75rem; color: var(--text-secondary);">Agents</div>
                </div>
                <div class="text-center">
                  <div id="workspace-task-count" class="fw-bold" style="font-size: 1.25rem; color: var(--primary-color);">0</div>
                  <div style="font-size: 0.75rem; color: var(--text-secondary);">Tasks</div>
                </div>
                <div class="text-center">
                  <div id="workspace-session-count" class="fw-bold" style="font-size: 1.25rem; color: var(--primary-color);">0</div>
                  <div style="font-size: 0.75rem; color: var(--text-secondary);">Sessions</div>
                </div>
              </div>
            </div>

            <!-- Children Workspaces (inside info card, only shown if has children) -->
            <div id="workspace-detail-children-panel" style="display: none; margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
              <div class="d-flex align-items-center gap-2 mb-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
                  <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                </svg>
                <span style="font-size: 0.875rem; font-weight: 500; color: var(--text-secondary);">Child Workspaces</span>
                <span id="workspace-detail-children-count" class="badge bg-secondary" style="font-size: 0.7rem;">0</span>
              </div>
              <div id="workspace-detail-children-list" class="workspace-detail-children-grid">
                <!-- Children will be rendered here -->
              </div>
            </div>
          </div>

          <!-- Bento Grid Panels -->
          <div class="workspace-detail-bento">
            <!-- Agents Panel - Left column (rows 1-4) -->
            <div class="modern-card workspace-detail-panel workspace-detail-panel-agents is-expandable" id="workspace-detail-agents-panel">
              <button class="workspace-detail-panel-close" type="button" title="Close" aria-label="Close expanded panel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                </svg>
              </button>
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M16,4A2,2 0 0,1 18,6V8A2,2 0 0,1 16,10H13A2,2 0 0,1 11,8V6A2,2 0 0,1 13,4H16M11,14A2,2 0 0,1 13,16V18A2,2 0 0,1 11,20H8A2,2 0 0,1 6,18V16A2,2 0 0,1 8,14H11M21,14A2,2 0 0,1 23,16V18A2,2 0 0,1 21,20H18A2,2 0 0,1 16,18V16A2,2 0 0,1 18,14H21M10.5,8H7A2,2 0 0,0 5,10V11H2V13H5V14A2,2 0 0,0 7,16H8V14H7V10H10.5V8Z"/>
                  </svg>
                  Agents
                </h2>
                <div class="workspace-detail-panel-actions">
                  <div class="workspace-detail-view-toggle" role="tablist">
                    <button id="workspace-detail-view-list" class="workspace-detail-view-btn is-active" type="button" role="tab" aria-selected="true" title="List View">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M3,4H21V8H3V4M3,10H21V14H3V10M3,16H21V20H3V16Z"/>
                      </svg>
                    </button>
                    <button id="workspace-detail-view-board" class="workspace-detail-view-btn" type="button" role="tab" aria-selected="false" title="Board View">
                      <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M4,3H10V5H4V3M14,3H20V5H14V3M4,7H10V9H4V7M14,7H20V9H14V7M4,11H10V13H4V11M14,11H20V13H14V11M4,15H10V17H4V15M14,15H20V17H14V15M4,19H10V21H4V19M14,19H20V21H14V19Z"/>
                      </svg>
                    </button>
                  </div>
                  <button id="workspace-detail-refresh-tasks" class="workspace-detail-panel-btn" type="button" title="Refresh">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </svg>
                  </button>
                  <button id="workspace-detail-add-agent-btn" class="workspace-detail-panel-btn" type="button" title="Add agent to workspace">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M6,10V7H4V10H1V12H4V15H6V12H9V10M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body" role="region" tabindex="0" aria-label="Agents panel content">
                <div id="workspace-detail-agents-list" class="workspace-detail-agent-grid">
                  <div class="workspace-detail-loading">Loading agents...</div>
                </div>
                <div id="workspace-detail-tasks-board" class="workspace-detail-board" style="display: none;">
                  <div class="workspace-detail-board-columns" id="workspace-detail-board-columns"></div>
                  <div class="workspace-detail-board-empty" id="workspace-detail-board-empty">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" style="opacity: 0.3;">
                      <path d="M4,3H10V5H4V3M14,3H20V5H14V3M4,7H10V9H4V7M14,7H20V9H14V7M4,11H10V13H4V11M14,11H20V13H14V11M4,15H10V17H4V15M14,15H20V17H14V15M4,19H10V21H4V19M14,19H20V21H14V19Z"/>
                    </svg>
                    <p>No board configured.</p>
                    <button id="workspace-detail-board-setup" class="modern-btn modern-btn-primary modern-btn-sm" type="button">Set Up Board</button>
                  </div>
                </div>
              </div>
            </div>

            <!-- Sessions Panel - Left column (bottom) -->
            <div class="modern-card workspace-detail-panel workspace-detail-panel-sessions is-expandable" id="workspace-detail-sessions-panel">
              <button class="workspace-detail-panel-close" type="button" title="Close" aria-label="Close expanded panel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                </svg>
              </button>
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M20,16H6L4,18V4H20"/>
                  </svg>
                  Sessions
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-refresh-sessions" class="workspace-detail-panel-btn" type="button" title="Refresh sessions">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </svg>
                  </button>
                  <button id="workspace-detail-new-session" class="workspace-detail-panel-btn workspace-detail-panel-btn-primary" type="button" title="New session">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body" role="region" tabindex="0" aria-label="Sessions panel content">
                <div id="workspace-detail-sessions-list" class="workspace-detail-list">
                  <div class="workspace-detail-loading">Loading sessions...</div>
                </div>
              </div>
            </div>

            <!-- Notes Panel - Right column row 1 -->
            <div class="modern-card workspace-detail-panel workspace-detail-panel-notes is-expandable" id="workspace-detail-notes-panel">
              <button class="workspace-detail-panel-close" type="button" title="Close" aria-label="Close expanded panel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                </svg>
              </button>
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M19,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M5,19V5H19V19H5M7,7H17V9H7V7M7,11H17V13H7V11M7,15H14V17H7V15Z"/>
                  </svg>
                  Notes
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-copy-notes" class="workspace-detail-panel-btn" type="button" title="Copy all note contents" disabled>
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"/>
                    </svg>
                  </button>
                  <button id="workspace-detail-add-note" class="workspace-detail-panel-btn workspace-detail-panel-btn-primary" type="button" title="Add note">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body" role="region" tabindex="0" aria-label="Notes panel content">
                <div id="workspace-detail-notes-list" class="workspace-detail-list">
                  <div class="workspace-detail-empty">No notes yet.</div>
                </div>
              </div>
            </div>

            <!-- Files Panel - Right column row 2 -->
            <div class="modern-card workspace-detail-panel workspace-detail-panel-files is-expandable" id="workspace-detail-files-panel">
              <button class="workspace-detail-panel-close" type="button" title="Close" aria-label="Close expanded panel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                </svg>
              </button>
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
                  </svg>
                  Files
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-add-file" class="workspace-detail-panel-btn workspace-detail-panel-btn-primary" type="button" title="Upload file">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body" role="region" tabindex="0" aria-label="Files panel content">
                <div id="workspace-detail-files-list" class="workspace-detail-list">
                  <div class="workspace-detail-empty">No files yet.</div>
                </div>
              </div>
            </div>

            <!-- Directories Panel - Right column row 3 -->
            <div class="modern-card workspace-detail-panel workspace-detail-panel-directories is-expandable" id="workspace-detail-directories-panel">
              <button class="workspace-detail-panel-close" type="button" title="Close" aria-label="Close expanded panel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                </svg>
              </button>
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                  </svg>
                  Directories
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-add-directory" class="workspace-detail-panel-btn workspace-detail-panel-btn-primary" type="button" title="Add directory">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="workspace-detail-panel-body" role="region" tabindex="0" aria-label="Directories panel content">
                <div id="workspace-detail-directories-list" class="workspace-detail-list">
                  <div class="workspace-detail-empty">No directories yet.</div>
                </div>
              </div>
            </div>

            <!-- Workspace MCP Panel - Right column row 4 -->
            <div class="modern-card workspace-detail-panel workspace-detail-panel-mcp is-expandable" id="workspace-detail-mcp-panel">
              <button class="workspace-detail-panel-close" type="button" title="Close" aria-label="Close expanded panel">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                </svg>
              </button>
              <div class="workspace-detail-panel-header">
                <h2 class="workspace-detail-panel-title">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M4,6A2,2 0 0,1 6,4H10A2,2 0 0,1 12,6V8A2,2 0 0,1 10,10H6A2,2 0 0,1 4,8V6M14,6A2,2 0 0,1 16,4H18A2,2 0 0,1 20,6V8A2,2 0 0,1 18,10H16A2,2 0 0,1 14,8V6M4,16A2,2 0 0,1 6,14H8A2,2 0 0,1 10,16V18A2,2 0 0,1 8,20H6A2,2 0 0,1 4,18V16M12,17H14V15H12V17M10,7H14V9H10V7M8,17H12V15H8V17M16,17H18V15H16V17Z"/>
                  </svg>
                  Workspace MCP
                </h2>
                <div class="workspace-detail-panel-actions">
                  <button id="workspace-detail-refresh-mcp" class="workspace-detail-panel-btn" type="button" title="Refresh MCP bindings">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
