  <!-- Styles for workspace detail page -->
  <style>
    /* Drop-anywhere file upload overlay */
    .workspace-detail-drop-overlay {
      position: fixed;
      inset: 0;
      z-index: 2000;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 2rem;
      background: rgba(13, 22, 38, 0.55);
      backdrop-filter: blur(2px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.15s ease, visibility 0.15s ease;
    }

    .workspace-detail-drop-overlay.is-active {
      opacity: 1;
      visibility: visible;
    }

    .workspace-detail-drop-overlay-card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      padding: 2.5rem 3rem;
      border-radius: 1rem;
      border: 2px dashed var(--primary-color, #ff7a44);
      background: var(--bg-primary, #0f1626);
      color: var(--text-primary, #f4f6fb);
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.45);
      text-align: center;
      max-width: 28rem;
    }

    .workspace-detail-drop-overlay-card svg {
      color: var(--primary-color, #ff7a44);
    }

    .workspace-detail-drop-overlay-title {
      font-size: 1.05rem;
      font-weight: 600;
