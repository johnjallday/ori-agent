  <!-- Workspace Entry Thinking Modal -->
  <div class="modal fade" id="homeAssistantThinkingModal" tabindex="-1"
       aria-labelledby="homeAssistantThinkingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content home-thinking-modal-content">
        <div class="modal-header home-thinking-modal-header">
          <div>
            <h5 id="homeAssistantThinkingModalLabel" class="modal-title">Workspace Manager is working</h5>
            <div id="homeAssistantThinkingStatus" class="home-thinking-modal-status" role="status" aria-live="polite">
              <span id="homeAssistantThinkingSpinner" class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
              <span>Analyzing your request...</span>
            </div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div id="homeAssistantRoutingSummary" class="home-assistant-routing-summary d-none"></div>
          <div id="homeAssistantPlanning" class="home-assistant-planning d-none mt-3"></div>
          <div id="homeAssistantInlineReply" class="home-assistant-inline-reply d-none mt-3"></div>
          <div id="homeAssistantActions" class="d-flex flex-wrap gap-2 mt-3 d-none"></div>
          <section id="homeAssistantConversationSection" class="home-assistant-conversation-section mt-3">
            <div class="home-assistant-conversation-section-header">
              <div>
                <div class="home-assistant-conversation-section-eyebrow">Conversation History</div>
                <div id="homeAssistantConversationSummary" class="home-assistant-conversation-section-copy">
                  Progress updates and manager notes will appear here after you send a message.
                </div>
              </div>
              <button id="homeAssistantConversationToggleBtn" type="button" class="modern-btn modern-btn-secondary modern-btn-sm" hidden>
                Hide Conversation
              </button>
            </div>
            <div id="homeAssistantConversation" class="home-assistant-conversation home-assistant-conversation-modal p-3">
              <div class="home-assistant-thinking-placeholder">
                Progress updates will appear here after you send a message.
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>

