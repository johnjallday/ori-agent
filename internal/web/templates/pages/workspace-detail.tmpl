                  <div class="hub-file-vault-unlock-row">
                    <input type="password" id="hubVaultUnlockPassword" class="form-control" placeholder="Enter vault password">
                    <button type="button" id="hubVaultUnlockBtn" class="modern-btn modern-btn-primary modern-btn-sm">Unlock</button>
                  </div>
                </div>

                <div id="hubVaultAttachmentList" class="hub-file-vault-list">
                  <div class="hub-file-vault-empty">Choose an unlocked vault to browse its attached files.</div>
                </div>

                <div class="hub-file-vault-help">Vault files are copied into this workspace as regular workspace files. The encrypted originals stay in the vault.</div>
              </div>
            </div>
            <div id="hubSelectedFilesPreview" class="hub-selected-files-preview" style="display: none;">
              <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Selected Files</label>
              <div id="hubSelectedFilesList" class="hub-selected-files-list"></div>
            </div>
            <div class="mb-3">
              <label for="hubFileTitle" class="form-label" style="color: var(--text-primary); font-weight: 500;">Title (optional)</label>
              <input type="text" class="form-control" id="hubFileTitle" placeholder="Enter a title for the file(s)...">
              <small class="text-muted">If left blank, the filename will be used</small>
