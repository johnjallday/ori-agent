  <!-- Styles for workspace detail page -->
  <style>
    .hub-file-source-switch {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.25rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(13, 22, 38, 0.62);
    }

    .hub-file-source-btn {
      border: none;
      background: transparent;
      color: var(--text-secondary);
      border-radius: 999px;
      padding: 0.48rem 0.85rem;
      font-size: 0.78rem;
      font-weight: 600;
      transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
    }

    .hub-file-source-btn:hover {
      color: var(--text-primary);
    }

    .hub-file-source-btn.is-active {
      background: rgba(255, 166, 110, 0.18);
      color: var(--text-primary);
      box-shadow: inset 0 0 0 1px rgba(255, 166, 110, 0.26);
    }

    .hub-file-vault-shell {
      display: grid;
      gap: 0.85rem;
      padding: 0.95rem;
      border-radius: 18px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: linear-gradient(180deg, rgba(17, 26, 42, 0.92), rgba(12, 20, 34, 0.9));
    }

    .hub-file-vault-toolbar {
      display: flex;
      align-items: end;
      gap: 0.65rem;
    }

    .hub-file-vault-field {
      flex: 1;
      min-width: 0;
    }

    .hub-file-vault-label {
      color: var(--text-primary);
      font-weight: 600;
      margin-bottom: 0.35rem;
    }

    .hub-file-vault-search-wrap input,
    .hub-file-vault-field select,
    .hub-file-vault-unlock-row input {
      background: rgba(8, 14, 24, 0.72);
      border-color: rgba(255, 255, 255, 0.12);
      color: var(--text-primary);
    }

    .hub-file-vault-search-wrap input::placeholder,
    .hub-file-vault-unlock-row input::placeholder {
      color: var(--text-secondary);
    }

    .hub-file-vault-locked {
      display: grid;
      gap: 0.55rem;
      padding: 0.95rem;
      border-radius: 14px;
      border: 1px dashed rgba(255, 166, 110, 0.24);
      background: rgba(255, 166, 110, 0.08);
    }

    .hub-file-vault-locked-title {
      color: var(--text-primary);
      font-weight: 700;
    }

    .hub-file-vault-locked-copy,
    .hub-file-vault-help {
      margin: 0;
      color: var(--text-secondary);
      font-size: 0.8rem;
      line-height: 1.55;
    }

    .hub-file-vault-unlock-row {
      display: flex;
      gap: 0.55rem;
    }

    .hub-file-vault-list {
      display: grid;
      gap: 0.55rem;
      max-height: 280px;
      overflow: auto;
      padding-right: 0.2rem;
    }

    .hub-file-vault-empty {
      padding: 1rem;
      border-radius: 14px;
      border: 1px dashed rgba(255, 255, 255, 0.12);
      color: var(--text-secondary);
      text-align: center;
      background: rgba(9, 17, 28, 0.5);
      font-size: 0.84rem;
    }

    .hub-file-vault-item {
      display: flex;
      align-items: flex-start;
      gap: 0.7rem;
      width: 100%;
      padding: 0.85rem 0.95rem;
      border-radius: 14px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(8, 14, 24, 0.76);
      color: inherit;
      text-align: left;
      transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
    }

    .hub-file-vault-item:hover {
      border-color: rgba(255, 166, 110, 0.36);
      background: rgba(20, 31, 51, 0.88);
      transform: translateY(-1px);
    }

    .hub-file-vault-item.is-selected {
      border-color: rgba(255, 166, 110, 0.5);
      background: rgba(255, 166, 110, 0.12);
    }

    .hub-file-vault-item-icon {
      flex: 0 0 auto;
      width: 34px;
      height: 34px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 10px;
      background: rgba(255, 166, 110, 0.12);
      color: rgb(255, 190, 142);
    }

    .hub-file-vault-item-main {
      flex: 1;
      min-width: 0;
    }

    .hub-file-vault-item-name {
      color: var(--text-primary);
      font-weight: 600;
      font-size: 0.9rem;
      line-height: 1.35;
      word-break: break-word;
    }

    .hub-file-vault-item-meta,
    .hub-file-vault-item-detail {
      color: var(--text-secondary);
      font-size: 0.78rem;
      line-height: 1.45;
      margin-top: 0.18rem;
    }

    .hub-file-vault-item-check {
      flex: 0 0 auto;
      width: 20px;
      height: 20px;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.2);
      background: rgba(255, 255, 255, 0.02);
      margin-top: 0.15rem;
      position: relative;
    }

    .hub-file-vault-item.is-selected .hub-file-vault-item-check {
      border-color: rgba(255, 166, 110, 0.8);
      background: rgba(255, 166, 110, 0.22);
    }

    .hub-file-vault-item.is-selected .hub-file-vault-item-check::after {
      content: "";
      position: absolute;
      inset: 4px;
      border-radius: 999px;
      background: rgb(255, 190, 142);
    }

    .hub-selected-files-source {
      display: inline-flex;
      align-items: center;
      margin-left: 0.4rem;
      padding: 0.12rem 0.42rem;
      border-radius: 999px;
      background: rgba(255, 166, 110, 0.14);
      color: var(--text-secondary);
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.02em;
      text-transform: uppercase;
    }

    @media (max-width: 640px) {
      .hub-file-vault-toolbar,
      .hub-file-vault-unlock-row {
        flex-direction: column;
        align-items: stretch;
      }

      .hub-file-source-switch {
        width: 100%;
      }

      .hub-file-source-btn {
        flex: 1;
      }
    }

    /* Bento Grid Layout */
    .workspace-detail-bento {
      display: grid;
      grid-template-columns: 3fr 1fr 1fr;
      grid-template-rows: repeat(6, 1fr);
      gap: 0.5rem;
      height: calc(100vh - 280px);
      min-height: 400px;
      max-height: calc(100vh - 240px);
      transition: grid-template-columns 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  min-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Panel positioning */
    .workspace-detail-panel-agents {
      grid-column: 1;
      grid-row: 1 / 5;
    }

    .workspace-detail-panel-sessions {
      grid-column: 1;
      grid-row: 5 / 7;
    }

    .workspace-detail-panel-notes {
      grid-column: 2;
      grid-row: 1 / 3;
    }

    .workspace-detail-panel-files {
      grid-column: 2;
      grid-row: 3 / 5;
    }

    .workspace-detail-panel-directories {
      grid-column: 2;
      grid-row: 5 / 7;
    }

    .workspace-detail-panel-mcp {
      grid-column: 3;
      grid-row: 1 / 3;
    }

    .workspace-detail-panel-skills {
      grid-column: 3;
      grid-row: 3 / 5;
    }

    .workspace-detail-panel-schedules {
      grid-column: 3;
      grid-row: 5 / 7;
    }

    /* Responsive layout */
    @media (max-width: 1200px) {
      .workspace-detail-bento {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto auto auto auto auto auto;
        height: auto;
        min-height: auto;
        max-height: none;
      }

      .workspace-detail-panel-agents {
        grid-column: 1 / -1;
        grid-row: 1;
      }

      .workspace-detail-panel-sessions {
        grid-column: 1 / -1;
        grid-row: 2;
      }

      .workspace-detail-panel-notes {
        grid-column: 1 / -1;
        grid-row: 3;
      }

      .workspace-detail-panel-files {
        grid-column: 1 / -1;
        grid-row: 4;
      }

      .workspace-detail-panel-directories {
        grid-column: 1 / -1;
        grid-row: 5;
      }

      .workspace-detail-panel-mcp {
        grid-column: 1 / -1;
        grid-row: 6;
      }

      .workspace-detail-panel-skills {
        grid-column: 1 / -1;
        grid-row: 7;
      }

      .workspace-detail-panel-schedules {
        grid-column: 1 / -1;
        grid-row: 8;
      }

      .workspace-detail-bento .workspace-detail-panel-body {
        max-height: 200px;
      }
    }

    /* Base Panel Styles */
    .workspace-detail-panel {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 0;
      min-width: 0;
      overflow: hidden;
      padding: 0;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.3s ease,
                  max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  min-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
