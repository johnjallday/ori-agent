      gap: 0.85rem;
    }

    .workspace-detail-task-assist-form-question {
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
    }

    .workspace-detail-task-assist-form-number {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 1.75rem;
      height: 1.75rem;
      padding: 0 0.45rem;
      border-radius: 999px;
      background: rgba(191, 219, 254, 0.12);
      border: 1px solid rgba(191, 219, 254, 0.2);
      color: #dbeafe;
      font-size: 0.82rem;
      font-weight: 700;
      line-height: 1;
      flex-shrink: 0;
    }

    .workspace-detail-task-assist-form-question-copy {
      display: grid;
      gap: 0.3rem;
      min-width: 0;
    }

    .workspace-detail-task-assist-form-prompt {
      font-size: 1rem;
      font-weight: 600;
      line-height: 1.45;
      color: var(--text-primary);
    }

    .workspace-detail-task-assist-form-field .form-label {
      margin-bottom: 0;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .workspace-detail-task-assist-form-hint {
      color: var(--text-secondary);
      font-size: 0.84rem;
    }

    .workspace-detail-task-assist-form-evidence {
      display: inline-flex;
      align-items: flex-start;
      gap: 0.45rem;
      width: fit-content;
      max-width: 100%;
      padding: 0.45rem 0.65rem;
      border-radius: 999px;
      border: 1px solid rgba(251, 191, 36, 0.22);
      background: rgba(251, 191, 36, 0.09);
      color: #fde68a;
      font-size: 0.8rem;
      line-height: 1.45;
    }

    .workspace-detail-task-assist-form-evidence::before {
      content: "Evidence";
      flex-shrink: 0;
      font-size: 0.66rem;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: rgba(254, 243, 199, 0.92);
    }

    .workspace-detail-task-assist-option-group {
      display: grid;
      gap: 0.55rem;
    }

    .workspace-detail-task-assist-option {
      display: block;
      cursor: pointer;
    }

    .workspace-detail-task-assist-option-input {
      position: absolute;
      opacity: 0;
      pointer-events: none;
    }

    .workspace-detail-task-assist-option-card {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      padding: 0.8rem 0.9rem;
      border-radius: 12px;
      background: rgba(30, 41, 59, 0.36);
      border: 1px solid rgba(138, 138, 138, 0.18);
      transition: border-color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
    }

    .workspace-detail-task-assist-option:hover .workspace-detail-task-assist-option-card {
      border-color: rgba(251, 191, 36, 0.34);
      background: rgba(30, 41, 59, 0.5);
      transform: translateY(-1px);
    }

    .workspace-detail-task-assist-option-input:focus-visible + .workspace-detail-task-assist-option-card {
      outline: 2px solid rgba(59, 130, 246, 0.7);
      outline-offset: 2px;
    }

    .workspace-detail-task-assist-option-input:checked + .workspace-detail-task-assist-option-card {
      border-color: rgba(59, 130, 246, 0.6);
      background: rgba(37, 99, 235, 0.18);
      box-shadow: 0 0 0 1px rgba(59, 130, 246, 0.22);
    }

    .workspace-detail-task-assist-option-key {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 1.85rem;
      height: 1.85rem;
      border-radius: 999px;
      background: rgba(248, 250, 252, 0.08);
      border: 1px solid rgba(248, 250, 252, 0.14);
      color: var(--text-primary);
      font-size: 0.82rem;
      font-weight: 700;
      line-height: 1;
      flex-shrink: 0;
    }

    .workspace-detail-task-assist-option-input:checked + .workspace-detail-task-assist-option-card .workspace-detail-task-assist-option-key {
      background: rgba(248, 250, 252, 0.16);
      border-color: rgba(248, 250, 252, 0.22);
    }

    .workspace-detail-task-assist-option-copy {
      display: grid;
      gap: 0.2rem;
      min-width: 0;
    }

    .workspace-detail-task-assist-option-label {
      color: var(--text-primary);
      font-size: 0.95rem;
      line-height: 1.45;
    }

    .workspace-detail-task-assist-option-description {
      color: var(--text-secondary);
      font-size: 0.82rem;
      line-height: 1.4;
    }

    .workspace-detail-task-assist-action.is-recommended {
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.55);
      filter: saturate(1.15);
    }

    .workspace-detail-task-assist-action-dock {
      display: grid;
      gap: 0.85rem;
      padding: 0.95rem 1rem 1rem;
      border-top: 1px solid rgba(138, 138, 138, 0.12);
      background:
        linear-gradient(180deg, rgba(10, 10, 10, 0.2), rgba(10, 10, 10, 0.86) 28%);
      box-shadow: 0 -18px 30px rgba(0, 0, 0, 0.22);
    }

    .workspace-detail-task-assist-fail-row {
      display: flex;
      justify-content: flex-start;
    }

    .workspace-detail-task-assist-primary-actions {
      display: flex;
      gap: 0.75rem;
      flex-wrap: wrap;
    }

    .workspace-detail-task-assist-primary-actions .btn,
    .workspace-detail-task-assist-fail-row .btn {
      min-height: 2.75rem;
      border-radius: 12px;
      padding-inline: 1rem;
    }

    @media (max-width: 991.98px) {
      .workspace-detail-task-assist-page {
        min-height: auto;
      }

      .workspace-detail-task-assist-page-header {
        padding: 1rem;
      }

      .workspace-detail-task-assist-content {
        min-height: auto;
        max-height: calc(100vh - 1.5rem);
      }

      .workspace-detail-task-assist-body {
        display: block;
        overflow: auto;
      }

      .workspace-detail-task-assist-layout {
        grid-template-columns: minmax(0, 1fr);
        height: auto;
      }

      .workspace-detail-task-assist-summary-grid {
        grid-template-columns: minmax(0, 1fr);
      }

      .workspace-detail-task-assist-pane {
        min-height: 0;
      }

      .workspace-detail-task-assist-pane-scroll {
        max-height: none;
        overflow: visible;
      }
    }

    /* View Toggle */
    .workspace-detail-view-toggle {
      display: flex;
      gap: 1px;
      background: var(--bg-tertiary);
      border-radius: 5px;
      padding: 2px;
    }

    .workspace-detail-view-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 22px;
      height: 20px;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      border-radius: 3px;
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      transform: scale(1);
    }

    .workspace-detail-view-btn:hover {
      color: var(--text-primary);
      transform: scale(1.1);
    }

    .workspace-detail-view-btn:active {
      transform: scale(0.95);
    }

    .workspace-detail-view-btn.is-active {
      background: var(--primary-color);
      color: white;
      box-shadow: 0 2px 8px rgba(var(--primary-color-rgb, 99, 102, 241), 0.3);
    }

    /* Board View */
    .workspace-detail-board {
      height: 100%;
      overflow-x: auto;
      padding-top: 0.5rem;
    }

    .workspace-detail-board-columns {
      display: flex;
      gap: 0.5rem;
      min-height: 150px;
      padding-bottom: 0.5rem;
    }

    .workspace-detail-board-column {
      flex: 0 0 180px;
      background: var(--bg-secondary);
      border-radius: 6px;
      border: 1px solid transparent;
      display: flex;
      flex-direction: column;
      max-height: 100%;
      animation: columnSlideIn 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
      opacity: 0;
    }

    .workspace-detail-board-column:nth-child(1) { animation-delay: 0.1s; }
    .workspace-detail-board-column:nth-child(2) { animation-delay: 0.15s; }
    .workspace-detail-board-column:nth-child(3) { animation-delay: 0.2s; }
    .workspace-detail-board-column:nth-child(4) { animation-delay: 0.25s; }
    .workspace-detail-board-column:nth-child(5) { animation-delay: 0.3s; }
    .workspace-detail-board-column:nth-child(6) { animation-delay: 0.35s; }

    @keyframes columnSlideIn {
      0% {
        opacity: 0;
        transform: translateY(20px) scale(0.95);
      }
      100% {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    .workspace-detail-board-column-header {
      padding: 0.5rem;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .workspace-detail-board-column-title-wrap {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      min-width: 0;
    }

    .workspace-detail-board-column-title {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text-primary);
      border-radius: 4px;
      padding: 2px 4px;
      margin: -2px -4px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .workspace-detail-board-column-title:hover {
      background: var(--bg-tertiary);
    }

    .workspace-detail-board-column-edit-btn {
      border: none;
      background: var(--bg-tertiary);
      color: var(--text-secondary);
      border-radius: 4px;
      padding: 0.15rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
    }

    .workspace-detail-board-column:hover .workspace-detail-board-column-edit-btn,
    .workspace-detail-board-column-edit-btn:focus-visible {
      opacity: 1;
      pointer-events: auto;
    }

    .workspace-detail-board-column-edit-btn:hover {
      color: var(--text-primary);
    }

    .workspace-detail-board-column-edit-btn:focus-visible {
      outline: 2px solid rgba(var(--primary-color-rgb, 99, 102, 241), 0.25);
      outline-offset: 2px;
    }

    .workspace-detail-board-column-rename-input {
      font-size: 0.7rem;
      font-weight: 600;
      color: var(--text-primary);
      background: var(--bg-primary);
      border: 1px solid var(--primary-color);
      border-radius: 4px;
      padding: 2px 6px;
      width: 100%;
    }

    .workspace-detail-board-column-rename-input:focus {
      outline: none;
      box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb, 99, 102, 241), 0.2);
    }

    .workspace-detail-board-column-count {
      font-size: 0.65rem;
      color: var(--text-secondary);
      background: var(--bg-tertiary);
      padding: 0.1rem 0.3rem;
      border-radius: 3px;
    }

    .workspace-detail-board-add-column {
      flex: 0 0 180px;
      border: 1px dashed var(--border-color);
      border-radius: 6px;
      padding: 0.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      color: var(--text-secondary);
      align-self: flex-start;
    }

    .workspace-detail-board-add-column-btn {
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-size: 0.7rem;
      text-align: left;
      cursor: pointer;
      padding: 0;
    }

    .workspace-detail-board-add-column-btn:hover {
      color: var(--text-primary);
    }

    .workspace-detail-board-add-column-form {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .workspace-detail-board-add-column-form[hidden] {
      display: none;
    }

    .workspace-detail-board-add-column-input {
      width: 100%;
      border: 1px solid var(--border-color);
      background: var(--bg-tertiary);
      border-radius: 4px;
      padding: 0.3rem 0.4rem;
      font-size: 0.65rem;
      color: var(--text-primary);
    }

    .workspace-detail-board-add-column-input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb, 99, 102, 241), 0.15);
    }

    .workspace-detail-board-add-column-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.35rem;
    }

    .workspace-detail-board-add-column-actions .modern-btn {
      font-size: 0.55rem;
      padding: 0.2rem 0.35rem;
    }

    .workspace-detail-board-column-body {
      flex: 1;
      overflow-y: auto;
      padding: 0.35rem;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .workspace-detail-board-card {
      padding: 0.4rem 0.5rem;
      background: var(--bg-primary);
      border: 1px solid var(--border-color);
      border-radius: 4px;
      cursor: grab;
      transition: all 0.15s ease;
    }

    .workspace-detail-board-card:hover {
      border-color: var(--primary-color);
    }

    .workspace-detail-board-card.is-dragging {
      opacity: 0.6;
      cursor: grabbing;
    }

    .workspace-detail-board-column.is-drag-over {
      border: 1px solid var(--primary-color);
      box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb, 99, 102, 241), 0.2);
    }

    .workspace-detail-board-card-title {
      font-size: 0.7rem;
      font-weight: 500;
      color: var(--text-primary);
      margin-bottom: 0.15rem;
    }

    .workspace-detail-board-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.4rem;
    }

    .workspace-detail-board-card-edit-btn {
      border: none;
      background: var(--bg-tertiary);
      color: var(--text-secondary);
      border-radius: 4px;
      padding: 0.15rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      transition: opacity 0.15s ease, background-color 0.15s ease, color 0.15s ease;
    }

    .workspace-detail-board-card:hover .workspace-detail-board-card-edit-btn,
    .workspace-detail-board-card.is-editing .workspace-detail-board-card-edit-btn {
      opacity: 1;
    }

    .workspace-detail-board-card-edit-btn:hover {
      background: var(--primary-color);
      color: #fff;
    }

    .workspace-detail-board-card-labels {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem;
      margin-bottom: 0.25rem;
    }

    .workspace-detail-board-card-label {
      font-size: 0.6rem;
      color: var(--text-secondary);
      background: var(--bg-tertiary);
      padding: 0.1rem 0.3rem;
      border-radius: 999px;
    }

    .workspace-detail-board-card-meta {
      font-size: 0.6rem;
      color: var(--text-secondary);
      display: flex;
      justify-content: space-between;
      gap: 0.4rem;
    }

    .workspace-detail-board-add {
      margin-top: 0.4rem;
    }

    .workspace-detail-board-add-btn {
      width: 100%;
      border: 1px dashed var(--border-color);
      background: transparent;
      color: var(--text-secondary);
      border-radius: 4px;
      padding: 0.3rem 0.4rem;
      font-size: 0.65rem;
      text-align: left;
      cursor: pointer;
    }

    .workspace-detail-board-add-btn:hover {
      border-color: var(--primary-color);
      color: var(--text-primary);
    }

    .workspace-detail-board-add-form {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .workspace-detail-board-add-form[hidden] {
      display: none;
    }

    .workspace-detail-board-add-input {
      width: 100%;
      border: 1px solid var(--border-color);
      background: var(--bg-tertiary);
      border-radius: 4px;
      padding: 0.3rem 0.4rem;
      font-size: 0.65rem;
      color: var(--text-primary);
    }

    .workspace-detail-board-add-input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb, 99, 102, 241), 0.15);
    }

    .workspace-detail-board-add-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.35rem;
    }

    .workspace-detail-board-add-actions .modern-btn {
      font-size: 0.55rem;
      padding: 0.2rem 0.35rem;
    }

    .workspace-detail-board-card-meta-secondary {
      margin-top: 0.2rem;
      font-size: 0.55rem;
    }

    .workspace-detail-board-card-assignee.is-muted {
      color: var(--text-secondary);
    }

    .workspace-detail-board-card-due {
      color: var(--text-secondary);
    }

    .workspace-detail-board-card-edit {
      display: none;
      flex-direction: column;
      gap: 0.35rem;
    }

    .workspace-detail-board-card-edit-label {
      font-size: 0.6rem;
      color: var(--text-secondary);
      margin-bottom: -0.1rem;
    }

    .workspace-detail-board-card-edit-input {
      width: 100%;
      border: 1px solid var(--border-color);
      background: var(--bg-tertiary);
      border-radius: 4px;
      padding: 0.3rem 0.4rem;
      font-size: 0.65rem;
      color: var(--text-primary);
    }

    .workspace-detail-board-card-edit-input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb, 99, 102, 241), 0.15);
    }

    .workspace-detail-board-card-edit-actions {
      display: flex;
      justify-content: flex-end;
      gap: 0.35rem;
      margin-top: 0.2rem;
    }

    .workspace-detail-board-card-edit-actions .modern-btn {
      font-size: 0.55rem;
      padding: 0.2rem 0.35rem;
    }

    .workspace-detail-board-card.is-editing {
      cursor: default;
    }

    .workspace-detail-board-card.is-editing .workspace-detail-board-card-view {
      display: none;
    }

    .workspace-detail-board-card.is-editing .workspace-detail-board-card-edit {
      display: flex;
    }

    .workspace-detail-board-card.is-saving {
      opacity: 0.75;
      pointer-events: none;
    }

    .workspace-detail-board-empty {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 1.5rem;
      color: var(--text-secondary);
      text-align: center;
    }

    .workspace-detail-board-empty p {
      margin: 0.5rem 0;
      font-size: 0.8rem;
    }

    /* =============================================================================
       Panel Pop-out Styles
       ============================================================================= */

    /* Backdrop for expanded panels */
    .workspace-detail-panel-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(10, 10, 10, 0.6);
      backdrop-filter: blur(0px);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.35s cubic-bezier(0.4, 0, 0.2, 1),
                  backdrop-filter 0.35s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 10000;
    }

    .workspace-detail-panel-backdrop.is-active {
      opacity: 1;
      backdrop-filter: blur(4px);
      pointer-events: auto;
    }

    /* Expandable panel styling - NO transitions here to avoid conflicts */
    .workspace-detail-panel.is-expandable {
      cursor: pointer;
    }

    .workspace-detail-panel.is-expandable:hover:not(.is-expanded):not(.is-expanding):not(.is-collapsing) {
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
      border-color: var(--primary-color);
    }

    /* Animation states - position/size controlled entirely by JS inline styles */
    .workspace-detail-panel.is-expanding,
    .workspace-detail-panel.is-expanded,
    .workspace-detail-panel.is-collapsing {
      z-index: 10001;
      cursor: default;
    }

    /* Expanded/expanding panel body gets more space */
    .workspace-detail-panel.is-expanded .workspace-detail-panel-body,
    .workspace-detail-panel.is-expanding .workspace-detail-panel-body {
      max-height: none;
      flex: 1;
      overflow-y: auto;
    }

    /* Adjust header for expanding state too */
    .workspace-detail-panel.is-expanding .workspace-detail-panel-header {
      padding-right: 2.5rem;
    }

    /* Close button for expanded panels */
    .workspace-detail-panel-close {
      display: none;
      position: absolute;
      top: 0.5rem;
      right: 0.5rem;
      padding: 0.35rem;
      border: none;
      background: rgba(255, 255, 255, 0.1);
      color: var(--text-secondary);
      border-radius: var(--radius-sm, 4px);
      cursor: pointer;
      transition: background-color 0.2s ease,
                  color 0.2s ease,
                  transform 0.2s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 10;
    }

    .workspace-detail-panel-close:hover {
      background: rgba(239, 68, 68, 0.2);
      color: #ef4444;
      transform: scale(1.1);
    }

    .workspace-detail-panel.is-expanding .workspace-detail-panel-close {
      display: flex;
      align-items: center;
      justify-content: center;
      animation: closeButtonFadeIn 0.3s ease 0.3s forwards;
      opacity: 0;
    }

    .workspace-detail-panel.is-expanded .workspace-detail-panel-close {
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 1;
    }

    @keyframes closeButtonFadeIn {
      from {
        opacity: 0;
        transform: scale(0.8);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }

    .workspace-detail-panel.is-collapsing .workspace-detail-panel-close {
      display: flex;
      opacity: 0;
      transition: opacity 0.15s ease;
    }

    /* Adjust header for expanded state */
    .workspace-detail-panel.is-expanded .workspace-detail-panel-header {
      padding-right: 2.5rem;
    }

    /* Expanded panel title enlargement with transition */
    .workspace-detail-panel .workspace-detail-panel-title {
      transition: font-size 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .workspace-detail-panel.is-expanded .workspace-detail-panel-title {
      font-size: 1rem;
    }

    /* Smooth content fade in when expanding */
    .workspace-detail-panel.is-expanding .workspace-detail-panel-body {
      animation: contentFadeIn 0.35s ease 0.25s forwards;
      opacity: 0;
    }

    /* Already expanded - no animation, just show */
    .workspace-detail-panel.is-expanded .workspace-detail-panel-body {
      opacity: 1;
    }

    .workspace-detail-panel.is-collapsing .workspace-detail-panel-body {
      opacity: 1;
      animation: none;
    }

    @keyframes contentFadeIn {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Board view reorganizes the grid */
    .workspace-detail-bento:has(.board-view) {
      grid-template-columns: repeat(7, 1fr);
      grid-template-rows: 1fr auto;
      height: auto;
      min-height: 500px;
    }

    .workspace-detail-panel-agents.board-view {
      grid-column: 1 / -1;
      grid-row: 1;
      min-height: 350px;
      max-height: 400px;
    }

    /* Rearrange other panels to bottom row when board view is active */
    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-sessions {
      grid-column: 1;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-notes {
      grid-column: 2;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-files {
      grid-column: 3;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-directories {
      grid-column: 4;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-mcp {
      grid-column: 5;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-skills {
      grid-column: 6;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-schedules {
      grid-column: 7;
      grid-row: 2;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel:not(.board-view) {
      max-height: 200px;
      animation: slideInUp 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    .workspace-detail-panel-agents.board-view {
      animation: expandBoard 0.4s cubic-bezier(0.4, 0, 0.2, 1) forwards;
    }

    @keyframes expandBoard {
      0% {
        opacity: 0.8;
        transform: scale(0.98);
      }
      100% {
        opacity: 1;
        transform: scale(1);
      }
    }

    @keyframes slideInUp {
      0% {
        opacity: 0;
        transform: translateY(20px);
      }
      100% {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* Stagger animation for bottom panels */
    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-sessions {
      animation-delay: 0.05s;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-notes {
      animation-delay: 0.1s;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-files {
      animation-delay: 0.15s;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-directories {
      animation-delay: 0.2s;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-mcp {
      animation-delay: 0.25s;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-skills {
      animation-delay: 0.3s;
    }

    .workspace-detail-bento:has(.board-view) .workspace-detail-panel-schedules {
      animation-delay: 0.35s;
    }

    /* Children workspaces grid */
    .workspace-detail-children-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 0.75rem;
    }

    .workspace-detail-child-card {
      padding: 0.75rem 1rem;
      border-radius: 8px;
      background: var(--bg-secondary);
      border: 1px solid var(--border-color);
      cursor: pointer;
      transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

    .workspace-detail-child-card:hover {
      background: var(--bg-tertiary);
      border-color: var(--primary-color);
      transform: translateY(-1px);
    }

    .workspace-detail-child-card[role="button"]:focus-visible {
      outline: 2px solid var(--primary-color);
      outline-offset: 2px;
    }

    .workspace-detail-child-card .child-name {
      font-weight: 500;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .workspace-detail-child-card .child-desc {
      font-size: 0.75rem;
      color: var(--text-secondary);
      margin-top: 0.25rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .workspace-detail-child-card .child-meta {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-top: 0.5rem;
      font-size: 0.7rem;
      color: var(--text-secondary);
    }

    /* Directory Explorer Modal */
    .workspace-directory-explorer-dialog {
      max-width: min(1320px, 94vw);
      margin: 1.1rem auto;
    }

    .workspace-directory-explorer-modal-content {
      border-radius: 16px;
      border: 1px solid rgba(255, 166, 110, 0.24);
      overflow: hidden;
      background:
        radial-gradient(circle at 2% 2%, rgba(255, 166, 110, 0.16), transparent 36%),
        radial-gradient(circle at 98% 100%, rgba(56, 189, 248, 0.12), transparent 40%),
        var(--bg-primary);
      box-shadow: 0 18px 46px rgba(7, 13, 24, 0.45);
    }

    .workspace-directory-explorer-modal-header {
      padding: 0.9rem 1rem;
      border-bottom: 1px solid rgba(255, 166, 110, 0.2);
      align-items: center;
      gap: 0.75rem;
      background: linear-gradient(120deg, rgba(255, 166, 110, 0.16), rgba(56, 189, 248, 0.08));
    }

    .workspace-directory-explorer-heading {
      min-width: 0;
    }

    .workspace-directory-explorer-heading .modal-title {
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--text-primary);
      margin: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .workspace-directory-explorer-subtitle {
      font-size: 0.72rem;
      color: var(--text-secondary);
      margin-top: 0.12rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .workspace-directory-explorer-actions {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      margin-left: auto;
      flex-shrink: 0;
    }

    .workspace-directory-action-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.38rem;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      background: rgba(11, 20, 36, 0.5);
      color: var(--text-primary);
      height: 30px;
      padding: 0 0.72rem;
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.015em;
      transition: transform 0.15s ease, background-color 0.15s ease, border-color 0.15s ease;
    }

    .workspace-directory-action-btn:hover {
      border-color: rgba(255, 166, 110, 0.55);
      background: rgba(255, 166, 110, 0.2);
      transform: translateY(-1px);
    }

    .workspace-directory-action-btn:focus-visible {
      outline: 2px solid rgba(255, 166, 110, 0.65);
      outline-offset: 1px;
    }

    .workspace-directory-close-btn {
      margin-left: 0.15rem;
    }

    .workspace-directory-explorer-modal-body {
      padding: 0.78rem 0.92rem 0.92rem;
      min-height: min(80vh, 760px);
      max-height: calc(100vh - 140px);
      display: flex;
      flex-direction: column;
      gap: 0.58rem;
      background:
        linear-gradient(180deg, rgba(11, 21, 36, 0.12), transparent 40%),
        var(--bg-primary);
    }

    .workspace-directory-explorer-topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.65rem;
      flex-wrap: wrap;
    }

    .workspace-directory-explorer-summary {
      display: flex;
      align-items: center;
      gap: 0.38rem;
      flex-wrap: wrap;
      min-height: 30px;
    }

    .workspace-directory-pill {
      display: inline-flex;
      align-items: center;
      padding: 0.2rem 0.58rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(11, 20, 36, 0.55);
      color: var(--text-primary);
      font-size: 0.66rem;
      font-weight: 600;
      letter-spacing: 0.01em;
    }

    .workspace-directory-pill.is-muted {
      color: var(--text-secondary);
      border-style: dashed;
    }

    .workspace-directory-explorer-search-wrap {
      display: flex;
      align-items: center;
      gap: 0.45rem;
      min-width: min(360px, 100%);
      width: 360px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      background: rgba(10, 18, 30, 0.7);
      color: var(--text-secondary);
      height: 34px;
      padding: 0 0.72rem;
    }

    .workspace-directory-explorer-search-wrap:focus-within {
      border-color: rgba(255, 166, 110, 0.55);
      box-shadow: 0 0 0 2px rgba(255, 166, 110, 0.2);
    }

    .workspace-directory-explorer-search-wrap input {
      flex: 1;
      min-width: 0;
      border: none;
      background: transparent;
      color: var(--text-primary);
      outline: none;
      font-size: 0.76rem;
    }

    .workspace-directory-explorer-search-wrap input::placeholder {
      color: var(--text-secondary);
    }

    .workspace-directory-explorer-breadcrumb {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.24rem;
      min-height: 24px;
      padding: 0.18rem 0.18rem;
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.1);
      background: rgba(9, 17, 28, 0.46);
    }

    .workspace-directory-crumb {
      display: inline-flex;
      align-items: center;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      font-size: 0.68rem;
      padding: 0.14rem 0.34rem;
      border-radius: 6px;
      max-width: min(26vw, 240px);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      text-decoration: none;
    }

    .workspace-directory-crumb:hover {
      color: var(--text-primary);
      background: rgba(255, 166, 110, 0.14);
    }

    .workspace-directory-crumb.is-active {
      color: var(--text-primary);
      background: rgba(56, 189, 248, 0.16);
    }

    .workspace-directory-crumb-separator {
      color: var(--text-muted);
      font-size: 0.62rem;
      margin: 0 0.04rem;
    }

    .workspace-directory-explorer-grid {
      flex: 1;
      min-height: 0;
      display: grid;
      grid-template-columns: minmax(280px, 34%) minmax(0, 66%);
      gap: 0.68rem;
    }

    .workspace-directory-explorer-tree,
    .workspace-directory-explorer-preview {
      min-height: 0;
      border-radius: 12px;
      border: 1px solid rgba(255, 255, 255, 0.12);
      background: rgba(8, 14, 24, 0.62);
      overflow: hidden;
    }

    .workspace-directory-tree-scroll,
    .workspace-directory-explorer-preview {
      height: 100%;
      overflow: auto;
    }

    .workspace-directory-tree-scroll::-webkit-scrollbar,
    .workspace-directory-explorer-preview::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }

    .workspace-directory-tree-scroll::-webkit-scrollbar-thumb,
    .workspace-directory-explorer-preview::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.18);
      border-radius: 999px;
    }

    .workspace-directory-tree-empty,
    .workspace-directory-preview-empty {
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: var(--text-secondary);
      font-size: 0.76rem;
      padding: 1rem;
    }

    .workspace-directory-tree-node {
      border-bottom: 1px solid rgba(255, 255, 255, 0.03);
    }

    .workspace-directory-tree-row {
      display: grid;
      grid-template-columns: 18px minmax(0, 1fr);
      align-items: center;
      gap: 0.1rem;
      padding-left: calc(var(--tree-depth, 0) * 16px + 0.25rem);
      min-height: 30px;
    }

    .workspace-directory-tree-toggle,
    .workspace-directory-tree-spacer {
      width: 18px;
      height: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      border-radius: 5px;
    }

    .workspace-directory-tree-toggle svg {
      transition: transform 0.16s ease;
    }

    .workspace-directory-tree-toggle.is-expanded svg {
      transform: rotate(90deg);
    }

    .workspace-directory-tree-toggle:hover {
      color: var(--text-primary);
      background: rgba(255, 166, 110, 0.14);
    }

    .workspace-directory-tree-main {
      display: flex;
      align-items: center;
      min-width: 0;
      width: 100%;
      border: none;
      background: transparent;
      color: var(--text-primary);
      text-align: left;
      gap: 0.45rem;
      border-radius: 6px;
      padding: 0.24rem 0.42rem;
      user-select: none;
    }

    .workspace-directory-tree-main:hover {
      background: rgba(56, 189, 248, 0.12);
    }

    .workspace-directory-tree-main:focus-visible {
      outline: 2px solid rgba(56, 189, 248, 0.48);
      outline-offset: 0;
    }

    .workspace-directory-tree-icon {
      color: rgba(255, 191, 122, 0.95);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .workspace-directory-tree-label {
      flex: 1;
      min-width: 0;
      font-size: 0.76rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .workspace-directory-tree-meta {
      color: var(--text-secondary);
      font-size: 0.62rem;
      flex-shrink: 0;
      max-width: 36%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      text-align: right;
    }

    .workspace-directory-tree-node.is-selected > .workspace-directory-tree-row .workspace-directory-tree-main {
      background: linear-gradient(90deg, rgba(255, 166, 110, 0.24), rgba(56, 189, 248, 0.16));
      border: 1px solid rgba(255, 166, 110, 0.45);
    }

    .workspace-directory-tree-main[draggable="true"] {
      cursor: grab;
    }

    .workspace-directory-tree-main.is-dragging {
      opacity: 0.45;
    }

    .workspace-directory-tree-node.is-drop-target > .workspace-directory-tree-row {
      background: rgba(56, 189, 248, 0.18);
      outline: 1px dashed rgba(56, 189, 248, 0.7);
      outline-offset: -1px;
      border-radius: 6px;
    }

    .workspace-directory-crumb.is-drop-target {
      background: rgba(56, 189, 248, 0.22);
      outline: 1px dashed rgba(56, 189, 248, 0.7);
      outline-offset: 1px;
    }

    .workspace-directory-tree-node.is-missing > .workspace-directory-tree-row .workspace-directory-tree-label {
      color: rgba(248, 180, 120, 0.85);
      text-decoration: line-through;
      text-decoration-color: rgba(248, 113, 113, 0.55);
    }

    .workspace-directory-tree-node.is-missing > .workspace-directory-tree-row .workspace-directory-tree-icon {
      color: rgba(248, 113, 113, 0.85);
    }

    .workspace-directory-tree-node.is-missing > .workspace-directory-tree-row .workspace-directory-tree-meta {
      color: rgba(248, 113, 113, 0.85);
    }

    .workspace-directory-pill.is-missing {
      background: rgba(248, 113, 113, 0.16);
      color: rgba(248, 160, 160, 0.95);
      border-color: rgba(248, 113, 113, 0.4);
    }

    .workspace-directory-tree-children {
      position: relative;
    }

    .workspace-directory-preview-header {
      display: flex;
      flex-direction: column;
      gap: 0.14rem;
      padding: 0.82rem 0.9rem 0.45rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      background: linear-gradient(120deg, rgba(56, 189, 248, 0.08), rgba(255, 166, 110, 0.11));
    }

    .workspace-directory-preview-title {
      font-size: 0.82rem;
      font-weight: 600;
      color: var(--text-primary);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .workspace-directory-preview-subtitle {
      font-size: 0.66rem;
      color: var(--text-secondary);
      word-break: break-all;
    }

    .workspace-directory-preview-stats {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.38rem;
      padding: 0.58rem 0.9rem 0.38rem;
    }

    .workspace-directory-preview-open-link {
      display: inline-flex;
      align-items: center;
      padding: 0.18rem 0.58rem;
      border-radius: 999px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: var(--text-primary);
      text-decoration: none;
      font-size: 0.67rem;
      transition: background-color 0.14s ease, border-color 0.14s ease;
    }

    .workspace-directory-preview-open-link:hover {
      background: rgba(255, 166, 110, 0.2);
      border-color: rgba(255, 166, 110, 0.6);
      color: var(--text-primary);
    }

    .workspace-directory-preview-open-link.is-danger {
      border-color: rgba(248, 113, 113, 0.45);
      color: #fca5a5;
    }

    .workspace-directory-preview-open-link.is-danger:hover {
      background: rgba(248, 113, 113, 0.18);
      border-color: rgba(248, 113, 113, 0.7);
      color: #fecaca;
    }

    .workspace-directory-bulk-list {
      list-style: none;
      margin: 0.75rem 0 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      max-height: 60vh;
      overflow-y: auto;
    }

    .workspace-directory-bulk-item {
      padding: 0.3rem 0.55rem;
      border-radius: 0.4rem;
      background: rgba(255, 255, 255, 0.04);
      color: var(--text-secondary);
      font-size: 0.74rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .workspace-directory-preview-loading,
    .workspace-directory-preview-empty-inline {
      color: var(--text-secondary);
      font-size: 0.75rem;
      padding: 1rem 0.9rem;
    }

    .workspace-directory-preview-code {
      margin: 0;
      padding: 0.82rem 0.9rem 1rem;
      border: none;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
      background: transparent;
      color: #dbe7ff;
      white-space: pre-wrap;
      word-break: break-word;
      font-size: 0.74rem;
      line-height: 1.48;
      max-height: 100%;
      overflow: auto;
    }

    .workspace-directory-preview-note {
      color: var(--text-secondary);
      font-size: 0.67rem;
      padding: 0 0.9rem 0.9rem;
    }

    .workspace-directory-preview-directory-list {
      display: flex;
      flex-direction: column;
      gap: 0.24rem;
      padding: 0 0.9rem 0.85rem;
    }

    .workspace-directory-preview-entry {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 8px;
      background: rgba(9, 18, 30, 0.7);
      color: var(--text-primary);
      font-size: 0.72rem;
      padding: 0.42rem 0.58rem;
      text-align: left;
      transition: background-color 0.14s ease, border-color 0.14s ease;
    }

    .workspace-directory-preview-entry:hover {
      background: rgba(56, 189, 248, 0.14);
      border-color: rgba(56, 189, 248, 0.45);
    }

    @media (max-width: 992px) {
      .workspace-directory-explorer-grid {
        grid-template-columns: 1fr;
        grid-template-rows: minmax(240px, 38vh) minmax(260px, 45vh);
      }

      .workspace-directory-explorer-search-wrap {
        width: 100%;
        min-width: 0;
      }

      .workspace-directory-action-btn {
        padding: 0 0.6rem;
        font-size: 0.64rem;
      }
    }

    /* Editable field container with hover edit button */
    .workspace-editable-field {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      position: relative;
    }

    .workspace-editable-field h1,
    .workspace-editable-field p {
      flex: 1;
      min-width: 0;
    }

    .workspace-edit-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 24px;
      height: 24px;
      padding: 0;
      border: none;
      background: transparent;
      color: var(--text-secondary);
      border-radius: var(--radius-sm, 4px);
      cursor: pointer;
      opacity: 0.5;
      transition: opacity 0.15s ease, background-color 0.15s ease, color 0.15s ease;
      flex-shrink: 0;
    }

    .workspace-editable-field:hover .workspace-edit-btn,
    .workspace-edit-btn:hover,
    .workspace-edit-btn:focus,
    .workspace-edit-btn:focus-visible {
      opacity: 1;
    }

    .workspace-edit-btn:hover {
      background-color: rgba(255, 255, 255, 0.1);
      color: var(--primary-color);
    }

    .workspace-edit-btn:focus-visible {
      outline: none;
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.3);
    }

    @media (hover: none) {
      .workspace-edit-btn {
        opacity: 1;
      }
    }

    /* Inline editable elements */
    #workspace-name.is-editable,
    #workspace-description.is-editable {
      border-radius: var(--radius-sm, 4px);
      padding: 0.15rem 0.35rem;
      margin-left: -0.35rem;
      transition: background-color 0.15s ease;
    }

    .workspace-detail-inline-edit {
      font-family: inherit;
      color: var(--text-primary);
      background: var(--bg-primary, #fff);
      border: 1px solid var(--primary-color, #3b82f6);
      border-radius: var(--radius-sm, 4px);
      padding: 0.15rem 0.35rem;
      outline: none;
      width: 100%;
      box-sizing: border-box;
    }

    .workspace-detail-inline-edit:focus {
      box-shadow: 0 0 0 2px rgba(59, 130, 246, 0.2);
    }

    /* Name input - match header title style */
    input.workspace-detail-inline-edit {
      font-size: 1.5rem;
      font-weight: 600;
    }

