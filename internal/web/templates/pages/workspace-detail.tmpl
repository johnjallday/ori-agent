  <!-- Workspace Detail Page -->
  <script type="module">
    import { WorkspaceDetailPage } from '/js/modules/workspace-detail.js';

    function initializeWorkspaceDetailPage() {
      themeManager.initialize();

      // Extract workspace ID from URL
      const pathParts = window.location.pathname.split('/');
      const workspaceId = pathParts[2]; // /workspaces/{id}

      if (workspaceId) {
        // Make workspace ID available globally for hub modules
        window.currentWorkspaceId = workspaceId;

        const detailPage = new WorkspaceDetailPage(workspaceId);
        window.workspaceDetail = detailPage;
        detailPage.init();
      } else {
        console.error('No workspace ID found in URL');
        window.location.href = '/';
      }

      // Initialize panel expansion functionality
      initPanelExpansion();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initializeWorkspaceDetailPage, { once: true });
    } else {
      initializeWorkspaceDetailPage();
    }

    /**
     * Initialize panel expansion functionality for bento panels
     */
    function initPanelExpansion() {
      let expandedPanel = null;
      const backdrop = document.getElementById('workspaceDetailPanelBackdrop');
      if (!backdrop) return;

      const expandablePanels = document.querySelectorAll('.workspace-detail-panel.is-expandable');

      expandablePanels.forEach((panel) => {
        // Click on panel to expand
        panel.addEventListener('click', (event) => {
          // Don't expand if clicking on interactive elements
          if (event.target.closest('button, a, input, select, textarea, .workspace-detail-item, .workspace-detail-agent-card, .workspace-detail-board')) {
            return;
          }

          // Don't expand if already expanded
          if (panel.classList.contains('is-expanded')) {
            return;
          }

          expandPanel(panel);
        });

        panel.addEventListener('keydown', (event) => {
          if (event.target.closest('button, a, input, select, textarea, .workspace-detail-item, .workspace-detail-agent-card, .workspace-detail-board')) {
            return;
          }

          if (event.key !== 'Enter' && event.key !== ' ') {
            return;
          }

          event.preventDefault();

          if (panel.classList.contains('is-expanded')) {
            return;
          }

          expandPanel(panel);
        });

        // Close button
        const closeBtn = panel.querySelector('.workspace-detail-panel-close');
        if (closeBtn) {
          closeBtn.addEventListener('click', (event) => {
            event.stopPropagation();
            collapsePanel();
          });
        }
      });

      // Click backdrop to close
      backdrop.addEventListener('click', collapsePanel);

      // Escape key to close
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && expandedPanel) {
          collapsePanel();
        }
      });

      // Store original positions for collapse animation
      const panelOriginalRects = new Map();
      let isAnimating = false;
      const EXPAND_DURATION = 450; // ms - match CSS transition
      const COLLAPSE_DURATION = 350; // ms - match CSS transition

      function expandPanel(panel) {
        if (isAnimating) return;

        if (expandedPanel) {
          collapsePanel(true); // immediate collapse if switching panels
        }

        isAnimating = true;

        // Capture original position before any changes
        const rect = panel.getBoundingClientRect();
        panelOriginalRects.set(panel, {
          top: rect.top,
          left: rect.left,
          width: rect.width,
          height: rect.height
        });

        expandedPanel = panel;
        panel.setAttribute('aria-expanded', 'true');
        backdrop.classList.add('is-active');
        document.body.style.overflow = 'hidden';

        // Calculate final center position
        const finalWidth = Math.min(window.innerWidth * 0.9, 600);
        const finalHeight = Math.min(window.innerHeight * 0.8, 600);
        const finalTop = (window.innerHeight - finalHeight) / 2;
        const finalLeft = (window.innerWidth - finalWidth) / 2;

        // Set initial position (where the panel currently is) WITHOUT transition
        panel.style.transition = 'none';
        panel.style.position = 'fixed';
        panel.style.top = rect.top + 'px';
        panel.style.left = rect.left + 'px';
        panel.style.width = rect.width + 'px';
        panel.style.height = rect.height + 'px';
        panel.style.transform = 'none';
        panel.style.zIndex = '10001';

        // Force reflow
        panel.offsetHeight;

        // Now enable transition and animate to center
        panel.style.transition = 'top 0.45s cubic-bezier(0.4, 0, 0.2, 1), left 0.45s cubic-bezier(0.4, 0, 0.2, 1), width 0.45s cubic-bezier(0.4, 0, 0.2, 1), height 0.45s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.45s cubic-bezier(0.4, 0, 0.2, 1)';
        panel.classList.add('is-expanding');

        // Use requestAnimationFrame to ensure styles are applied before animating
        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            panel.style.top = finalTop + 'px';
            panel.style.left = finalLeft + 'px';
            panel.style.width = finalWidth + 'px';
            panel.style.height = finalHeight + 'px';
            panel.style.boxShadow = '0 25px 50px -12px rgba(0, 0, 0, 0.4)';
          });
        });

        // Use setTimeout for reliable completion
        setTimeout(() => {
          panel.classList.remove('is-expanding');
          panel.classList.add('is-expanded');
          // Keep final position - don't clear styles!
          panel.style.transition = 'none';
          isAnimating = false;
        }, EXPAND_DURATION);
      }

      function collapsePanel(immediate = false) {
        if (!expandedPanel) return;
        if (isAnimating && !immediate) return;

        const panel = expandedPanel;
        const originalRect = panelOriginalRects.get(panel);

        backdrop.classList.remove('is-active');

        if (immediate || !originalRect) {
          // Immediate collapse (no animation)
          panel.setAttribute('aria-expanded', 'false');
          panel.classList.remove('is-expanded', 'is-expanding', 'is-collapsing');
          panel.style.cssText = '';
          document.body.style.overflow = '';
          expandedPanel = null;
          isAnimating = false;
        } else {
          isAnimating = true;
          panel.setAttribute('aria-expanded', 'false');

          // Get current expanded position
          const currentRect = panel.getBoundingClientRect();

          // Set current position WITHOUT transition
          panel.classList.remove('is-expanded');
          panel.style.transition = 'none';
          panel.style.position = 'fixed';
          panel.style.top = currentRect.top + 'px';
          panel.style.left = currentRect.left + 'px';
          panel.style.width = currentRect.width + 'px';
          panel.style.height = currentRect.height + 'px';
          panel.style.transform = 'none';
          panel.style.zIndex = '10001';

          // Force reflow
          panel.offsetHeight;

          // Enable transition and animate back
          panel.style.transition = 'top 0.35s cubic-bezier(0.4, 0, 0.2, 1), left 0.35s cubic-bezier(0.4, 0, 0.2, 1), width 0.35s cubic-bezier(0.4, 0, 0.2, 1), height 0.35s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.35s cubic-bezier(0.4, 0, 0.2, 1)';
          panel.classList.add('is-collapsing');

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              panel.style.top = originalRect.top + 'px';
              panel.style.left = originalRect.left + 'px';
              panel.style.width = originalRect.width + 'px';
              panel.style.height = originalRect.height + 'px';
              panel.style.boxShadow = 'none';
            });
          });

          // Use setTimeout for reliable completion
          setTimeout(() => {
            panel.classList.remove('is-collapsing');
            panel.style.cssText = '';
            document.body.style.overflow = '';
            expandedPanel = null;
            isAnimating = false;
          }, COLLAPSE_DURATION);
        }
      }

      // Expose globally for other scripts
      window.WorkspaceDetailPanels = {
        expandPanel,
        collapsePanel,
        isExpanded: () => expandedPanel !== null,
        getExpandedPanel: () => expandedPanel
      };
    }
  </script>
