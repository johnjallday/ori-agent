  <script src="/js/modules/workspace-hub-files.js"></script>

  <!-- Workspace Detail Page -->
  <script type="module">
    import { WorkspaceDetailPage } from '/js/modules/workspace-detail.js';

    document.addEventListener('DOMContentLoaded', () => {
      // Extract workspace ID from URL
      const pathParts = window.location.pathname.split('/');
      const workspaceId = pathParts[2]; // /workspaces/{id}

      if (workspaceId) {
        // Make workspace ID available globally for hub modules
        window.currentWorkspaceId = workspaceId;

        const detailPage = new WorkspaceDetailPage(workspaceId);
        window.workspaceDetail = detailPage;
        detailPage.init();
      } else {
        console.error('No workspace ID found in URL');
        window.location.href = '/';
      }
    });
  </script>
