    }

    .workspace-detail-goal-modal-content {
      background:
        linear-gradient(145deg, color-mix(in srgb, var(--primary-color) 7%, transparent), transparent 42%),
        var(--bg-secondary);
      border: 1px solid color-mix(in srgb, var(--primary-color) 24%, var(--border-color));
      color: var(--text-primary);
    }

    .workspace-detail-goal-modal-header {
      align-items: flex-start;
      border-bottom-color: var(--border-color);
    }

    .workspace-detail-goal-modal-title {
      margin-top: 0.2rem;
      color: var(--text-primary);
      font-size: 1.12rem;
      font-weight: 650;
      letter-spacing: 0;
    }

    .workspace-detail-goal-modal-body {
      display: flex;
      flex-direction: column;
      gap: 0.9rem;
    }

    .workspace-detail-goal-modal-field {
      min-width: 0;
    }

    .workspace-detail-goal-modal-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 0.85rem;
    }

    .workspace-detail-goal-modal-warning {
      border-left: 3px solid var(--warning-color, #f5a623);
      background: var(--warning-bg, rgba(245, 166, 35, 0.08));
      border-radius: 6px;
      padding: 0.7rem 0.85rem;
      font-size: 0.85rem;
      color: var(--text-primary);
    }

    .workspace-detail-goal-modal-warning-list {
      margin-top: 0.35rem;
      color: var(--text-secondary);
    }

    .workspace-detail-goal-modal-warning-hint {
      margin-top: 0.35rem;
      color: var(--text-secondary);
    }

    .workspace-detail-goal-modal-switch {
      margin-top: 0.1rem;
    }

    .workspace-detail-goal-modal-enabled-hint {
      margin-top: 0.1rem;
      color: var(--warning-color, #f5a623);
      font-size: 0.76rem;
    }

    .workspace-detail-goal-modal-autonomy {
      color: var(--text-secondary);
      font-size: 0.78rem;
    }

    .workspace-detail-goal-modal-autonomy strong {
      color: var(--text-primary);
    }

    .workspace-detail-goal-modal-status {
      min-height: 1.1rem;
      color: var(--text-secondary);
      font-size: 0.8rem;
    }

    .workspace-detail-goal-modal-status.is-error {
      color: var(--danger-color, #c0392b);
    }

    .workspace-detail-goal-modal-footer {
      border-top-color: var(--border-color);
      gap: 0.4rem;
    }

    .workspace-detail-goal-modal-footer .btn-link {
      margin-right: auto;
      color: var(--primary-color);
      text-decoration: none;
    }

    .workspace-detail-goal-modal-footer .btn-link:hover {
      text-decoration: underline;
    }

    @media (max-width: 900px) {
      .workspace-detail-goal-card {
        flex-direction: column;
      }

      .workspace-detail-goal-actions {
        justify-content: flex-start;
      }
    }

    @media (max-width: 640px) {
      .workspace-detail-goal-modal-grid {
        grid-template-columns: 1fr;
      }
    }

    .workspace-detail-config-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      gap: 1rem;
      padding: 1rem 1.25rem 0.8rem;
    }

    .workspace-detail-config-kicker {
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--primary-color);
    }

    .workspace-detail-config-title {
      margin: 0.2rem 0 0;
      font-size: 1.02rem;
      font-weight: 600;
      color: var(--text-primary);
    }

    .workspace-detail-config-summary {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
      margin-top: 0.75rem;
    }

    .workspace-detail-config-chip {
      display: inline-flex;
      align-items: center;
      padding: 0.36rem 0.62rem;
      border-radius: 999px;
      border: 1px solid var(--border-color);
      background: var(--bg-secondary);
      color: var(--text-secondary);
      font-size: 0.74rem;
      line-height: 1;
      white-space: nowrap;
    }

    .workspace-detail-config-toggle {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      align-self: center;
      border: 1px solid rgba(255,255,255,0.1);
      border-radius: 999px;
      background: rgba(255,255,255,0.04);
      color: var(--text-primary);
      font-size: 0.78rem;
      font-weight: 600;
      padding: 0.58rem 0.82rem;
      transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    }

    .workspace-detail-config-toggle:hover {
      background: rgba(255,255,255,0.08);
      border-color: rgba(255,255,255,0.16);
    }

    .workspace-detail-config-toggle-icon {
      transition: transform 0.18s ease;
    }

    .workspace-detail-config-card:not(.is-collapsed) .workspace-detail-config-toggle-icon {
      transform: rotate(180deg);
    }

    .workspace-detail-config-content[hidden] {
      display: none !important;
    }

    .workspace-detail-config-nav {
      gap: 0.35rem;
      padding: 0 1rem;
      border-bottom: 1px solid var(--border-color);
    }

    .workspace-detail-config-tab {
      margin-bottom: -1px;
      border: 1px solid transparent !important;
      border-bottom: none !important;
      border-radius: 12px 12px 0 0 !important;
      background: transparent !important;
      color: var(--text-secondary) !important;
      font-size: 0.82rem;
      font-weight: 600;
      padding: 0.72rem 0.95rem;
    }

    .workspace-detail-config-tab:hover {
      color: var(--text-primary) !important;
    }

    .workspace-detail-config-tab.active {
      background: var(--bg-secondary) !important;
      border-color: var(--border-color) !important;
      color: var(--text-primary) !important;
    }

    .workspace-detail-config-body {
      padding: 1rem 1.25rem 1.25rem;
    }

    .workspace-detail-config-pane {
      outline: none;
    }

    .workspace-detail-config-pane-header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: 1rem;
    }

    .workspace-detail-config-pane-title {
      font-size: 0.9rem;
      font-weight: 600;
      color: var(--text-primary);
    }

    .workspace-detail-config-pane-copy {
      max-width: 64ch;
      font-size: 0.82rem;
      line-height: 1.5;
      color: var(--text-secondary);
    }

    .workspace-detail-config-pane-actions {
      display: flex;
      gap: 0.35rem;
      flex-shrink: 0;
    }

    /* Bento Grid Layout */
    .workspace-detail-bento {
      display: grid;
      grid-template-columns: 3fr 1fr 1fr;
      grid-template-rows: repeat(6, 1fr);
      gap: 0.5rem;
      height: calc(100vh - 280px);
      min-height: 400px;
      max-height: calc(100vh - 240px);
      transition: grid-template-columns 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  min-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Panel positioning */
    .workspace-detail-panel-agents {
      grid-column: 1;
      grid-row: 1 / 5;
    }

    .workspace-detail-panel-sessions {
      grid-column: 1;
      grid-row: 5 / 7;
    }

    .workspace-detail-panel-notes {
      grid-column: 2;
      grid-row: 1 / 3;
    }

    .workspace-detail-panel-files {
      grid-column: 2;
      grid-row: 3 / 5;
    }

    .workspace-detail-panel-directories {
      grid-column: 2;
      grid-row: 5 / 7;
    }

    .workspace-detail-panel-schedules {
      grid-column: 3;
      grid-row: 1 / 7;
    }

    /* Responsive layout */
    @media (max-width: 1200px) {
      .workspace-detail-config-header,
      .workspace-detail-config-pane-header {
        flex-direction: column;
        align-items: stretch;
      }

      .workspace-detail-config-toggle {
        align-self: flex-start;
      }

      .workspace-detail-config-pane-actions {
        justify-content: flex-start;
      }

      .workspace-detail-bento {
        grid-template-columns: 1fr;
        grid-template-rows: auto auto auto auto auto auto;
        height: auto;
        min-height: auto;
        max-height: none;
      }

      .workspace-detail-panel-agents {
        grid-column: 1 / -1;
        grid-row: 1;
      }

      .workspace-detail-panel-sessions {
        grid-column: 1 / -1;
        grid-row: 2;
      }

      .workspace-detail-panel-notes {
        grid-column: 1 / -1;
        grid-row: 3;
      }

      .workspace-detail-panel-files {
        grid-column: 1 / -1;
        grid-row: 4;
      }

      .workspace-detail-panel-directories {
        grid-column: 1 / -1;
        grid-row: 5;
      }

      .workspace-detail-panel-schedules {
        grid-column: 1 / -1;
        grid-row: 6;
      }

      .workspace-detail-bento .workspace-detail-panel-body {
        max-height: 200px;
      }
    }

    /* Base Panel Styles */
    .workspace-detail-panel {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 0;
      min-width: 0;
      overflow: hidden;
      padding: 0;
      transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  opacity 0.3s ease,
                  max-height 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                  min-height 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .workspace-detail-panel-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.5rem 0.75rem;
      flex-shrink: 0;
      border-bottom: 1px solid var(--border-color);
    }

    .workspace-detail-panel-title {
      margin: 0;
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text-primary);
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .workspace-detail-panel-actions {
      display: flex;
      gap: 0.35rem;
    }

    .workspace-detail-panel-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 26px;
      height: 26px;
      padding: 0;
      border: none;
      background: var(--bg-secondary);
      color: var(--text-secondary);
      border-radius: 6px;
      cursor: pointer;
      transition: all 0.15s ease;
    }

    .workspace-detail-panel-btn:hover {
      background: var(--bg-tertiary);
      color: var(--text-primary);
    }

    .workspace-detail-panel-btn-primary {
      background: var(--primary-color);
      color: white;
    }

    .workspace-detail-panel-btn-primary:hover {
      background: var(--primary-hover);
      color: white;
    }

    .workspace-detail-panel-body {
      flex: 1;
      min-height: 0;
      overflow-y: auto;
      padding: 0 0.75rem 0.5rem;
      scroll-behavior: smooth;
    }

    /* Custom scrollbar */
    .workspace-detail-panel-body::-webkit-scrollbar {
      width: 6px;
    }

    .workspace-detail-panel-body::-webkit-scrollbar-track {
      background: transparent;
    }

    .workspace-detail-panel-body::-webkit-scrollbar-thumb {
      background: var(--border-color);
      border-radius: 3px;
    }

    .workspace-detail-panel-body::-webkit-scrollbar-thumb:hover {
      background: var(--text-muted);
    }

    .workspace-detail-list {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
      padding-top: 0.5rem;
    }

    .workspace-detail-agent-grid {
      display: flex;
      flex-direction: column;
      gap: 0.65rem;
      padding-top: 0.5rem;
    }

    .workspace-detail-agent-card {
      perspective: 1200px;
      position: relative;
    }

    .workspace-detail-agent-card-flipper {
      display: grid;
      transform-style: preserve-3d;
      transform: translateZ(0);
      will-change: transform;
      transition: transform 0.45s cubic-bezier(0.22, 0.61, 0.36, 1);
    }

    .workspace-detail-agent-card.is-flipped .workspace-detail-agent-card-flipper {
      transform: rotateX(180deg);
    }

    .workspace-detail-agent-card-face {
      grid-area: 1 / 1;
      -webkit-backface-visibility: hidden;
      backface-visibility: hidden;
      border: 1px solid var(--border-color);
      background: var(--bg-secondary);
      border-radius: 10px;
      padding: 0.6rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .workspace-detail-agent-card-face-front {
      transform: rotateX(0deg);
    }

    .workspace-detail-agent-card-face-back {
      transform: rotateX(180deg);
      background:
        radial-gradient(circle at top right, rgba(56, 189, 248, 0.08), transparent 58%),
        var(--bg-secondary);
    }

    .workspace-detail-agent-card-face-front .workspace-detail-agent-sections {
      transition: opacity 0.18s ease;
    }

    .workspace-detail-agent-card-face-back .workspace-detail-agent-info-grid {
      opacity: 0.8;
      transform: translateY(4px);
      transition: opacity 0.2s ease, transform 0.2s ease;
    }

    .workspace-detail-agent-card.is-flipped .workspace-detail-agent-card-face-back .workspace-detail-agent-info-grid {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.12s;
    }

    .workspace-detail-agent-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 0.75rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      padding-bottom: 0.45rem;
