    .workspace-detail-board-add-input:focus {
      outline: none;
      border-color: var(--primary-color);
      box-shadow: 0 0 0 2px rgba(var(--primary-color-rgb, 99, 102, 241), 0.15);
    }

    .workspace-detail-board-add-actions {
      display: flex;
