{{define "personalize"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">

        <!-- Header Card -->
        <div class="modern-card p-4 mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h2 class="mb-2" style="color: var(--text-primary);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                </svg>
                Personalize Your Experience
              </h2>
              <p class="mb-0" style="color: var(--text-secondary);">Tell us about your interests, tools, and work style to get a tailored experience.</p>
            </div>
            <a href="/settings" class="modern-btn modern-btn-secondary" style="font-size: 0.85rem;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
              </svg>
              Back to Settings
            </a>
          </div>
        </div>

        <!-- Existing Profile Summary (read-only) -->
        <div id="personalizeProfileSummary" class="modern-card p-4 mb-4 d-none">
          <h5 class="mb-3" style="color: var(--text-primary);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--primary-color);">
              <path d="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8V5H4M4,19H8V15H4M4,14H8V10H4V14Z"/>
            </svg>
            Detected Profile
          </h5>
          <div class="d-flex align-items-center gap-3">
            <div id="personalizeProfileBadge" class="px-3 py-2" style="background: var(--primary-color); color: white; border-radius: var(--radius-md); font-weight: 600;">
            </div>
            <p id="personalizeProfileText" class="mb-0" style="color: var(--text-secondary);"></p>
          </div>
        </div>

        <!-- Interests Section -->
        <div class="modern-card p-4 mb-4">
          <h5 class="mb-2" style="color: var(--text-primary);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--primary-color);">
              <path d="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.45,13.97L5.82,21L12,17.27Z"/>
            </svg>
            Interests
          </h5>
          <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">Select topics you're interested in. This helps us recommend relevant tools and content.</p>
          <div id="interestsGrid" class="d-flex flex-wrap gap-2">
          </div>
        </div>

        <!-- Preferred Tools Section -->
        <div class="modern-card p-4 mb-4">
          <h5 class="mb-2" style="color: var(--text-primary);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--primary-color);">
              <path d="M22.7,19L13.6,9.9C14.5,7.6 14,4.9 12.1,3C10.1,1 7.1,0.6 4.7,1.7L9,6L6,9L1.6,4.7C0.4,7.1 0.9,10.1 2.9,12.1C4.8,14 7.5,14.5 9.8,13.6L18.9,22.7C19.3,23.1 19.9,23.1 20.3,22.7L22.6,20.4C23.1,20 23.1,19.3 22.7,19Z"/>
            </svg>
            Preferred Tools
          </h5>
          <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">Select your favorite tools and technologies.</p>
          <div id="toolsGrid" class="d-flex flex-wrap gap-2 mb-3">
          </div>
          <div class="d-flex gap-2 align-items-center">
            <input type="text" id="customToolInput" class="form-control form-control-sm" placeholder="Add custom tool..." style="max-width: 200px; background: var(--bg-secondary); border-color: var(--border-color); color: var(--text-primary);">
            <button id="addCustomToolBtn" class="modern-btn modern-btn-secondary" style="font-size: 0.85rem; padding: 0.35rem 0.75rem;">Add</button>
          </div>
        </div>

        <!-- Work Style Section -->
        <div class="modern-card p-4 mb-4">
          <h5 class="mb-2" style="color: var(--text-primary);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--primary-color);">
              <path d="M12,3C17.5,3 22,6.58 22,11C22,15.42 17.5,19 12,19C10.76,19 9.57,18.82 8.47,18.5C5.55,21 2,21 2,21C4.33,18.67 4.7,17.1 4.75,16.5C3.05,15.07 2,13.13 2,11C2,6.58 6.5,3 12,3Z"/>
            </svg>
            Work Style
          </h5>
          <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">How do you prefer your AI assistant to communicate?</p>
          <div id="workStyleGrid" class="row g-3">
          </div>
        </div>

        <!-- Self Description Section -->
        <div class="modern-card p-4 mb-4">
          <h5 class="mb-2" style="color: var(--text-primary);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--primary-color);">
              <path d="M14,17H7V15H14M17,13H7V11H17M17,9H7V7H17M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z"/>
            </svg>
            About You (Optional)
          </h5>
          <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">Briefly describe what you do or what you'd like help with.</p>
          <textarea id="personalizeDescription" class="form-control" rows="3" placeholder="e.g., I'm a backend developer working mostly in Go and Python, focused on building APIs and microservices..." style="background: var(--bg-secondary); border-color: var(--border-color); color: var(--text-primary);"></textarea>
        </div>

        <!-- App Detection Section -->
        <div class="modern-card p-4 mb-4">
          <h5 class="mb-2" style="color: var(--text-primary);">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--primary-color);">
              <path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
            </svg>
            App Detection
          </h5>
          <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">Scan your system for installed development tools to enhance your profile.</p>
          <button id="detectAppsBtn" class="modern-btn modern-btn-secondary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
            </svg>
            Detect Installed Apps
          </button>
          <div id="detectedAppsList" class="mt-3 d-none">
            <label class="mb-2" style="color: var(--text-secondary); font-size: 0.85rem;">Detected apps:</label>
            <div id="detectedAppsContainer" class="d-flex flex-wrap gap-1"></div>
          </div>
        </div>

        <!-- Save Button -->
        <div class="modern-card p-4">
          <div class="d-flex justify-content-between align-items-center">
            <div id="saveStatusText" style="color: var(--text-secondary); font-size: 0.9rem;"></div>
            <button id="savePersonalizeBtn" class="modern-btn modern-btn-primary">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
              </svg>
              <span id="saveBtnText">Save &amp; Earn 25 XP</span>
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>

  <!-- Toast Container -->
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="personalizeToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="toast-header" style="background: var(--bg-secondary); color: var(--text-primary);">
        <strong class="me-auto">Personalization</strong>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
      <div id="personalizeToastBody" class="toast-body" style="background: var(--bg-primary); color: var(--text-primary);"></div>
    </div>
  </div>

  <script src="/js/modules/api.js"></script>
  <script src="/js/modules/personalize.js"></script>
</body>
</html>
{{end}}
