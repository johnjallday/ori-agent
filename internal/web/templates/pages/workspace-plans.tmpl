{{define "workspace-plans"}}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
{{template "head.tmpl" .}}
<link rel="stylesheet" href="/css/workspace-plans.css">

<body class="ui-page" data-workspace-id="{{.Extra.WorkspaceID}}" data-workspace-slug="{{.Extra.WorkspaceSlug}}">
  <script>
    window.currentWorkspaceId = document.body.dataset.workspaceId || '';
    window.currentWorkspaceSlug = document.body.dataset.workspaceSlug || '';
  </script>
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    <div class="main-content">
      <div
        id="workspacePlansPageRoot"
        class="plans-page-shell"
        data-workspace-id="{{.Extra.WorkspaceID}}"
        data-workspace-slug="{{.Extra.WorkspaceSlug}}"
      >
        <section class="plans-hero ui-page-header">
          <div class="plans-hero-copy">
            <div class="plans-breadcrumbs">
              <a href="/" class="plans-breadcrumb-link">Home</a>
              <span aria-hidden="true">/</span>
              <a href="/workspaces/{{.Extra.WorkspaceSlug}}" class="plans-breadcrumb-link">Workspace</a>
              <span aria-hidden="true">/</span>
              <span>Plans</span>
            </div>
            <h1 class="plans-title">Plans</h1>
            <p class="plans-subtitle">
              A plan is proposed work you review and approve before anything is created or run.
              Creating a ticket directly skips that review and starts from an already-decided unit of work.
            </p>
          </div>
          <div class="plans-hero-actions">
            <button type="button" id="plan-refresh" class="plans-icon-btn modern-btn modern-btn-secondary modern-btn-icon" title="Refresh plans">
              <span aria-hidden="true">↻</span>
              <span class="visually-hidden">Refresh plans</span>
            </button>
          </div>
        </section>

        <!-- Announced politely so a screen-reader user hears load, creation,
             and failure outcomes without the focus being stolen (FR-161). -->
        <p id="plan-status" class="plans-status" role="status" aria-live="polite" hidden></p>

        <!-- Planning off: history stays readable and Settings is one link away.
             Nothing here turns planning on (FR-159). -->
        <section id="plan-disabled-banner" class="plans-disabled-banner ui-section" hidden>
          <h2 class="plans-disabled-title">Structured planning is off for this workspace</h2>
          <p>
            Existing plans below stay readable. To draft new ones, turn on structured planning in
            Workspace Settings.
          </p>
          <a class="plans-settings-link modern-btn modern-btn-secondary modern-btn-sm" href="/workspaces/{{.Extra.WorkspaceSlug}}?panel=settings">
            Open Workspace Settings
          </a>
        </section>

        <section id="plan-create-panel" class="plans-create-panel ui-section" hidden>
          <h2 class="plans-section-title">Start a plan</h2>
          <form id="plan-create-form" class="plans-create-form">
            <label class="plans-create-label" for="plan-create-request">
              What would you like planned?
            </label>
            <textarea
              id="plan-create-request"
              class="plans-create-input form-control"
              rows="3"
              placeholder="Describe the outcome you want. Ori will draft a plan for you to review."
            ></textarea>
            <p class="plans-create-hint">
              Creating a plan does not create tickets or start work. You approve an exact version first.
            </p>
            <button type="submit" class="plans-create-btn modern-btn modern-btn-primary">Create plan</button>
          </form>
        </section>

        <section class="plans-section" aria-labelledby="plan-active-heading">
          <h2 id="plan-active-heading" class="plans-section-title">Active</h2>
          <ul id="plan-active-list" class="plans-list"></ul>
          <p id="plan-active-empty" class="plans-empty" hidden>
            No active plans. A plan is for work worth reviewing before it starts —
            for anything already decided, create a ticket directly from the workspace.
          </p>
        </section>

        <section id="plan-history-section" class="plans-section" aria-labelledby="plan-history-heading" hidden>
          <h2 id="plan-history-heading" class="plans-section-title">History</h2>
          <ul id="plan-history-list" class="plans-list"></ul>
          <p id="plan-history-empty" class="plans-empty" hidden>Nothing in history yet.</p>
        </section>
      </div>
    </div>
  </div>

  <style>
    .plans-page-shell {
      padding-bottom: calc(var(--ori-launcher-clearance-y, 88px) + var(--space-6));
      max-width: 960px;
      min-width: 0;
      overflow-wrap: anywhere;
      margin: 0 auto;
    }

    .plans-hero {
      display: flex;
      gap: 1rem;
      align-items: flex-start;
      justify-content: space-between;
      margin-bottom: 1.25rem;
    }

    .plans-hero .plans-hero-copy {
      flex-basis: auto;
      min-width: 0;
    }

    .plans-breadcrumbs {
      display: flex;
      gap: 0.4rem;
      align-items: center;
      font-size: 0.85rem;
      flex-wrap: wrap;
      color: var(--text-secondary);
      margin-bottom: 0.5rem;
    }

    .plans-breadcrumb-link {
      color: inherit;
      text-decoration: none;
    }

    .plans-breadcrumb-link:hover,
    .plans-breadcrumb-link:focus-visible {
      text-decoration: underline;
    }

    .plans-title {
      margin: 0 0 var(--space-2);
    }

    .plans-subtitle {
      margin: 0;
      max-width: 60ch;
      color: var(--text-secondary);
    }

    .plans-status {
      margin: 0 0 1rem;
      padding: 0.6rem 0.85rem;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-color);
      background: var(--surface-solid);
    }

    .plans-status[data-tone='error'] {
      border-color: var(--danger-text);
      color: var(--danger-text);
    }

    .plans-disabled-banner,
    .plans-create-panel {
      padding: var(--space-4);
      margin-bottom: 1.5rem;
    }

    .plans-disabled-title,
    .plans-section-title {
      font-size: 1.05rem;
      margin: 0 0 0.5rem;
    }

    .plans-settings-link {
      display: inline-block;
      margin-top: 0.35rem;
    }

    .plans-create-form {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    .plans-create-hint {
      margin: 0;
      font-size: 0.85rem;
      color: var(--text-secondary);
    }

    .plans-create-btn {
      align-self: flex-start;
    }

    .plans-section {
      margin-bottom: 2rem;
    }

    .plans-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.75rem;
    }

    .plans-empty {
      margin: 0;
      color: var(--text-secondary);
      max-width: 60ch;
    }

    .plan-card {
      padding: 0;
      min-width: 0;
    }

    .plan-card-link {
      display: block;
      padding: 0.9rem 1.1rem;
      color: inherit;
      text-decoration: none;
    }

    .plan-card-head {
      display: flex;
      gap: 0.75rem;
      align-items: baseline;
      justify-content: space-between;
    }

    .plan-card-title {
      font-size: 1rem;
      margin: 0;
    }

    .plan-card-version,
    .plan-card-progress {
      margin: 0.35rem 0 0;
      font-size: 0.9rem;
      color: var(--text-secondary);
    }

    .plan-card-foot {
      display: flex;
      gap: 0.75rem;
      justify-content: space-between;
      margin-top: 0.6rem;
      font-size: 0.85rem;
    }

    .plan-card-next {
      font-weight: 600;
    }

    @media (max-width: 720px) {
      .plans-hero { flex-direction: column; }
      .plan-card-head { flex-direction: column; align-items: flex-start; }
      .plan-card-foot { flex-direction: column; gap: 0.25rem; }
    }
  </style>

  <script type="module">
    import { WorkspacePlansPage } from '/js/modules/workspace-plan.js';

    document.addEventListener('DOMContentLoaded', async () => {
      const workspaceId = "{{.Extra.WorkspaceID}}";
      const workspaceSlug = "{{.Extra.WorkspaceSlug}}";
      if (!workspaceId || !workspaceSlug) {
        return;
      }
      const page = new WorkspacePlansPage(workspaceId, { workspaceSlug });
      try {
        await page.init();
      } catch (error) {
        console.error('Failed to initialize workspace plans page:', error);
      }
    });
  </script>
</body>
</html>
{{end}}
