  <script type="module" src="/js/modules/agent-canvas.js?v=1733603000"></script>
  <!-- Studios workspace management -->
  <link rel="stylesheet" href="/css/studio.css">
  <script src="/js/modules/studios-canvas-helpers.js?v=1733602000"></script>
  <script src="/js/modules/workflow-panel.js"></script>

  <script>
    // Workspace-specific canvas initialization
    const workspaceId = '{{.Extra.WorkspaceID}}';
    // Set global studio id for helper scripts that rely on currentStudioId
    if (typeof currentStudioId !== 'undefined') {
      currentStudioId = workspaceId;
    }
    window.currentStudioId = workspaceId;

    // Initialize canvas directly with this workspace
    document.addEventListener('DOMContentLoaded', async function() {
      console.log('🎨 Initializing workspace canvas for:', workspaceId);

      // Load workspace info and display in header
      try {
        const response = await fetch(`/api/orchestration/workspace?id=${workspaceId}`);
        if (response.ok) {
          const workspace = await response.json();
          document.getElementById('canvas-studio-name').textContent = workspace.name || 'Unnamed Workspace';
        }
      } catch (error) {
        console.error('Failed to load workspace info:', error);
      }

      // Wait for AgentCanvas module to load (it sets window.AgentCanvas)
      await import('/js/modules/agent-canvas.js');

      // Create canvas instance for this specific workspace
      window.agentCanvas = new window.AgentCanvas('agent-canvas', workspaceId);
      await window.agentCanvas.init();

      console.log('✅ Workspace canvas initialized');

      // Initialize workflow selector dropdown
      const { AgentCanvasWorkflowSelector } = await import('/js/modules/agent-canvas-workflow-selector.js');
      window.workflowSelector = new AgentCanvasWorkflowSelector(
        window.agentCanvas.state,
        window.agentCanvas,
        'workflow-selector-container'
      );
      window.workflowSelector.init();
      console.log('✅ Workflow selector initialized');

      // Check for workflow view mode (legacy banner - hidden since selector handles this now)
      const workflowViewParam = new URLSearchParams(window.location.search).get('workflow');
      if (workflowViewParam) {
        const banner = document.getElementById('workflow-view-banner');
        if (banner) {
          // Hide the banner since workflow selector dropdown shows the current selection
          banner.style.display = 'none';
        }
      }

      // Initialize workflow panel
      window.workflowPanel = new WorkflowPanel('workflow-panel-container', workspaceId);
      await window.workflowPanel.init();
      console.log('✅ Workflow panel initialized');

      // Check for add_workflow URL parameter (redirect from Workflows page)
      const urlParams = new URLSearchParams(window.location.search);
      const addWorkflowId = urlParams.get('add_workflow');
      const saveWorkflowAll = urlParams.get('save_workflow') === 'all';
      const saveWorkflowTaskId = urlParams.get('save_workflow_task');

      if (addWorkflowId) {
        console.log('📋 Auto-adding workflow from URL:', addWorkflowId);
        // Remove the parameter from URL to prevent re-adding on refresh
        const newUrl = window.location.pathname;
        window.history.replaceState({}, document.title, newUrl);
        // Instantiate the workflow
        setTimeout(() => {
          window.workflowPanel.instantiateWorkflow(addWorkflowId);
        }, 500);
      }

      // If requested, select all nodes and open the "Save as Workflow" modal
      if (saveWorkflowAll) {
        setTimeout(() => {
          try {
            autoSaveAllNodesAsWorkflow();
          } catch (err) {
            console.error('Failed to auto-open Save Workflow:', err);
          }
        }, 600);
      }

      if (saveWorkflowTaskId) {
        setTimeout(() => {
          try {
            autoSaveTaskAsWorkflow(saveWorkflowTaskId);
          } catch (err) {
            console.error('Failed to auto-open Save Workflow for task:', err);
          }
        }, 600);
      }
    });

    // Select every node on the canvas and open the Save Workflow modal (used when coming from dashboard)
    function autoSaveAllNodesAsWorkflow() {
      if (!window.agentCanvas || !window.agentCanvas.state || typeof window.agentCanvas.state.selectNode !== 'function') {
        console.warn('Canvas not ready for workflow export');
        return;
      }

      const state = window.agentCanvas.state;
      state.clearSelection();

      const selectSafe = (id, type, node) => {
        if (!id || !type) return;
        state.selectNode(id, type, node);
      };

      (state.tasks || []).forEach(task => selectSafe(task.id, 'task', task));
      (state.agents || []).forEach(agent => selectSafe(agent.nodeId || agent.id || agent.name, 'agent', agent));
      (state.schedulerNodes || []).forEach(scheduler => selectSafe(scheduler.canvas_node_id || scheduler.id, 'scheduler', scheduler));
      (state.storeNodes || []).forEach(store => selectSafe(store.canvas_node_id || store.id, 'store', store));
      (state.attachments || []).forEach(att => selectSafe(att.id, 'attachment', att));

      const selection = collectWorkflowSelectionData();
      if (!selection) {
        alert('Could not collect nodes for workflow. Please try again from the canvas.');
        return;
      }

      showSaveWorkflowModal(selection);
    }

    // Select a task and its connected nodes, then open the Save Workflow modal
    function autoSaveTaskAsWorkflow(taskId) {
      if (!taskId) return;
      if (!window.agentCanvas || !window.agentCanvas.state || typeof window.agentCanvas.state.selectNode !== 'function') {
        console.warn('Canvas not ready for workflow export');
        return;
      }

      const state = window.agentCanvas.state;
      state.clearSelection();

      const selectSafe = (id, type, node) => {
        if (!id || !type) return;
        state.selectNode(id, type, node);
      };

      const task = (state.tasks || []).find(t => t.id === taskId);
      if (!task) {
        alert(`Task not found on canvas: ${taskId}`);
        return;
      }

      // Always include the selected task
      selectSafe(task.id, 'task', task);

      // Include upstream dependency tasks if present
      (task.input_task_ids || []).forEach(depId => {
        const depTask = (state.tasks || []).find(t => t.id === depId);
        if (depTask) selectSafe(depTask.id, 'task', depTask);
      });

      // Include the assigned agent (instance) when available
      if (task.assigned_node_id) {
        const agent = (state.agents || []).find(a => a.nodeId === task.assigned_node_id);
        if (agent) {
          selectSafe(agent.nodeId || agent.id || agent.name, 'agent', agent);
        }

        // Include any store node attached to that agent instance
        const store = (state.storeNodes || []).find(s => s.agent_node_id === task.assigned_node_id);
        if (store) {
          selectSafe(store.canvas_node_id || store.id, 'store', store);
        }
      }

      // Include any scheduler that targets this task
      const scheduler = (state.schedulerNodes || []).find(s => s.target_task_id === task.id);
      if (scheduler) {
        selectSafe(scheduler.canvas_node_id || scheduler.id, 'scheduler', scheduler);
      }

      const selection = collectWorkflowSelectionData();
      if (!selection) {
        alert('Could not collect nodes for workflow. Please try again from the canvas.');
        return;
      }

      showSaveWorkflowModal(selection);
    }

    // Exit workflow view mode and show all tasks
    function exitWorkflowView() {
      // Use the workflow selector to switch to "All Tasks" view
      if (window.workflowSelector) {
        window.workflowSelector.selectWorkflow(null);
      } else {
        // Fallback: remove workflow parameter and reload page
        const url = new URL(window.location.href);
        url.searchParams.delete('workflow');
        window.location.href = url.toString();
      }
    }

    // State for selected agent in the add modal
    let selectedAgentToAdd = null;

    // Show add agent modal (for adding existing agents to canvas)
    async function showAddAgentModal() {
      const modal = new bootstrap.Modal(document.getElementById('addAgentNodeModal'));
      const agentListContainer = document.getElementById('canvasAgentList');
      const addBtn = document.getElementById('canvasAddAgentBtn');

      // Reset state
      selectedAgentToAdd = null;
      if (addBtn) addBtn.disabled = true;

      // Show loading state
      agentListContainer.innerHTML = `
        <div class="text-center py-3">
          <div class="spinner-border spinner-border-sm" role="status"></div>
          <span class="ms-2" style="color: var(--text-secondary);">Loading agents...</span>
        </div>
      `;

      modal.show();

      // Load available agents
      try {
        const response = await fetch('/api/agents');
        const data = await response.json();
        const agents = data.agents || data || [];

        if (agents.length === 0) {
          agentListContainer.innerHTML = `
            <div class="text-center py-4">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary); opacity: 0.5;" class="mb-2">
                <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
              </svg>
              <p style="color: var(--text-secondary);">No agents available</p>
              <p class="small" style="color: var(--text-muted);">Create a new agent to get started</p>
            </div>
          `;
          return;
        }

        // Render agent list
        agentListContainer.innerHTML = agents.map(agent => `
          <div class="agent-select-item p-3 mb-2"
               style="border: 1px solid var(--border-color); border-radius: 8px; cursor: pointer; transition: all 0.2s;"
               data-agent-name="${escapeHtml(agent.name)}"
               onclick="selectAgentToAdd('${escapeHtml(agent.name)}', this)">
            <div class="d-flex align-items-center gap-3">
              <div style="width: 36px; height: 36px; border-radius: 50%; background: var(--primary-color); display: flex; align-items: center; justify-content: center;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
                  <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                </svg>
              </div>
              <div class="flex-grow-1">
                <div style="color: var(--text-primary); font-weight: 500;">${escapeHtml(agent.name)}</div>
                <div style="color: var(--text-secondary); font-size: 0.8rem;">${escapeHtml(agent.type || 'tool-calling')} ${agent.model ? '• ' + escapeHtml(agent.model) : ''}</div>
              </div>
              <div class="agent-check-icon" style="display: none;">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="var(--primary-color)">
                  <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                </svg>
              </div>
            </div>
          </div>
        `).join('');

      } catch (error) {
        console.error('Failed to load agents:', error);
        agentListContainer.innerHTML = `
          <div class="alert alert-danger">Failed to load agents: ${escapeHtml(error.message)}</div>
        `;
      }
    }

    // escapeHtml is provided by dom-utils.js

    // Select an agent from the list
    function selectAgentToAdd(agentName, element) {
      selectedAgentToAdd = agentName;

      // Update UI - remove selection from all items
      document.querySelectorAll('.agent-select-item').forEach(item => {
        item.style.borderColor = 'var(--border-color)';
        item.style.background = '';
        item.querySelector('.agent-check-icon').style.display = 'none';
      });

      // Highlight selected item
      element.style.borderColor = 'var(--primary-color)';
      element.style.background = 'rgba(59, 130, 246, 0.1)';
      element.querySelector('.agent-check-icon').style.display = 'block';

      // Enable add button
      document.getElementById('canvasAddAgentBtn').disabled = false;
    }

    // Add selected agent to canvas
    async function addSelectedAgentToCanvas() {
      if (!selectedAgentToAdd) {
        alert('Please select an agent to add');
        return;
      }

      const addBtn = document.getElementById('canvasAddAgentBtn');
      const originalText = addBtn.innerHTML;
      addBtn.disabled = true;
      addBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Adding...';

      try {
        const response = await fetch(`/api/workspaces/${workspaceId}/agents`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ agent_name: selectedAgentToAdd })
        });

        if (!response.ok) {
          const error = await response.text();
          throw new Error(error || 'Failed to add agent');
        }

        console.log('Agent added to canvas:', selectedAgentToAdd);

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('addAgentNodeModal'));
        if (modal) modal.hide();

        // Reload canvas to show new agent
        if (window.agentCanvas) {
          await window.agentCanvas.init();
        }

      } catch (error) {
        console.error('Error adding agent to canvas:', error);
        alert(`Failed to add agent: ${error.message}`);
      } finally {
        addBtn.disabled = false;
        addBtn.innerHTML = originalText;
      }
    }

    // Submit attachment node from modal
    async function submitAttachmentNode() {
      const titleInput = document.getElementById('attachmentTitle');
      const bodyInput = document.getElementById('attachmentBody');
      const linkInput = document.getElementById('attachmentLink');
      const filePathInput = document.getElementById('attachmentFilePath');
      const addBtn = document.getElementById('addAttachmentNodeBtn');

      const title = titleInput?.value?.trim();
      if (!title) {
        alert('Please enter an attachment title');
        titleInput?.focus();
        return;
      }

      const originalText = addBtn.innerHTML;
      addBtn.disabled = true;
      addBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Adding...';

      const body = bodyInput?.value || '';
      const link = linkInput?.value || '';
      const filePath = filePathInput?.value || '';

      const fileMeta = filePath ? {
        name: filePath.split('/').pop() || filePath,
        url: filePath
      } : null;

      // Guess attachment type
      let type = 'note';
      const lowerLink = link.toLowerCase();
      const lowerName = (fileMeta?.name || '').toLowerCase();
      if (lowerLink.includes('github.com')) type = 'github';
      else if (lowerLink.includes('notion.so')) type = 'notion';
      else if (lowerLink.includes('figma.com')) type = 'figma';
      else if (lowerLink) type = 'link';
      else if (lowerName.endsWith('.pdf')) type = 'pdf';
      else if (/\.(png|jpg|jpeg|gif|webp|svg)$/i.test(lowerName)) type = 'image';
      else if (/\.(doc|docx|txt|md)$/i.test(lowerName)) type = 'document';
      else if (fileMeta) type = 'file';

      const attachment = {
        title: title,
        body: body,
        type: type,
        color: '',
        link_url: link,
        file_meta: fileMeta,
        x: 140,
        y: 140
      };

      try {
        const response = await fetch(`/api/workspaces/${workspaceId}/attachments`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(attachment)
        });

        if (!response.ok) {
          const error = await response.text();
          throw new Error(error || 'Failed to create attachment');
        }

        console.log('Attachment created successfully');

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('addAttachmentNodeModal'));
        if (modal) modal.hide();

        // Reload canvas to show new attachment
        if (window.agentCanvas) {
          await window.agentCanvas.init();
        }

      } catch (error) {
        console.error('Error creating attachment:', error);
        alert(`Failed to create attachment: ${error.message}`);
      } finally {
        addBtn.disabled = false;
        addBtn.innerHTML = originalText;
      }
    }

    // Switch to create agent modal
    function switchToCreateAgentModal() {
      // Hide add agent modal
      const addModal = bootstrap.Modal.getInstance(document.getElementById('addAgentNodeModal'));
      if (addModal) addModal.hide();

      // Show create agent modal
      setTimeout(() => {
        showCreateAgentModal();
      }, 300);
    }

    // Show create agent modal (for creating new agents)
    async function showCreateAgentModal() {
      const modal = new bootstrap.Modal(document.getElementById('createAgentModal'));
      const agentNameInput = document.getElementById('canvasAgentName');
      const agentTypeInput = document.getElementById('canvasAgentType');
      const agentModelInput = document.getElementById('canvasAgentModel');
      const agentTemperatureInput = document.getElementById('canvasAgentTemperature');
      const temperatureValueSpan = document.getElementById('canvasTemperatureValue');
      const agentSystemPromptInput = document.getElementById('canvasAgentSystemPrompt');

      // Clear previous inputs
      if (agentNameInput) agentNameInput.value = '';
      if (agentTypeInput) agentTypeInput.value = 'tool-calling';
      if (agentSystemPromptInput) agentSystemPromptInput.value = '';
      if (agentTemperatureInput) {
        agentTemperatureInput.value = '1.0';
        if (temperatureValueSpan) temperatureValueSpan.textContent = '1.0';
      }

      // Load available models
      if (agentModelInput) {
        try {
          const response = await fetch('/api/providers');
          const data = await response.json();
          const providers = data.providers || [];

          agentModelInput.innerHTML = '';
          providers.forEach(provider => {
            const providerGroup = document.createElement('optgroup');
            providerGroup.label = provider.display_name;

            provider.models.forEach(model => {
              const option = document.createElement('option');
              option.value = model.value;
              option.textContent = model.label;
              option.setAttribute('data-type', model.type);
              // Only show tool-calling models by default
              if (model.type !== 'tool-calling') {
                option.style.display = 'none';
                option.disabled = true;
              }
              providerGroup.appendChild(option);
            });
            agentModelInput.appendChild(providerGroup);
          });

          // Select first available option
          for (let i = 0; i < agentModelInput.options.length; i++) {
            if (!agentModelInput.options[i].disabled) {
              agentModelInput.selectedIndex = i;
              break;
            }
          }
        } catch (error) {
          console.error('Failed to load models:', error);
        }
      }

      // Setup temperature slider
      if (agentTemperatureInput && temperatureValueSpan) {
        agentTemperatureInput.oninput = (e) => {
          temperatureValueSpan.textContent = e.target.value;
        };
      }

      // Setup agent type change to filter models
      if (agentTypeInput && agentModelInput) {
        agentTypeInput.onchange = (e) => {
          const selectedType = e.target.value;
          const options = agentModelInput.querySelectorAll('option');
          options.forEach(option => {
            if (option.getAttribute('data-type') === selectedType) {
              option.style.display = '';
              option.disabled = false;
            } else {
              option.style.display = 'none';
              option.disabled = true;
            }
          });
          // Select first visible option
          for (let i = 0; i < agentModelInput.options.length; i++) {
            if (!agentModelInput.options[i].disabled) {
              agentModelInput.selectedIndex = i;
              break;
            }
          }
        };
      }

      modal.show();

      // Focus on input after modal is shown
      setTimeout(() => {
        if (agentNameInput) agentNameInput.focus();
      }, 500);
    }

    // Create new agent from canvas modal
    async function createNewAgentFromCanvas() {
      const agentNameInput = document.getElementById('canvasAgentName');
      const agentTypeInput = document.getElementById('canvasAgentType');
      const agentModelInput = document.getElementById('canvasAgentModel');
      const agentTemperatureInput = document.getElementById('canvasAgentTemperature');
      const agentSystemPromptInput = document.getElementById('canvasAgentSystemPrompt');
      const allowWebSearchInput = document.getElementById('canvasAllowWebSearch');
      const createBtn = document.getElementById('canvasCreateAgentBtn');

      if (!agentNameInput) return;

      const agentName = agentNameInput.value.trim();
      if (!agentName) {
        alert('Please enter an agent name');
        agentNameInput.focus();
        return;
      }

      // Set loading state
      const originalText = createBtn.innerHTML;
      createBtn.disabled = true;
      createBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Creating...';

      try {
        const requestBody = { name: agentName };
        requestBody.allow_web_search = allowWebSearchInput ? Boolean(allowWebSearchInput.checked) : true;
        if (agentTypeInput && agentTypeInput.value) requestBody.type = agentTypeInput.value;
        if (agentModelInput && agentModelInput.value) requestBody.model = agentModelInput.value;
        if (agentTemperatureInput && agentTemperatureInput.value) requestBody.temperature = parseFloat(agentTemperatureInput.value);
        if (agentSystemPromptInput && agentSystemPromptInput.value.trim()) requestBody.system_prompt = agentSystemPromptInput.value.trim();

        const createResponse = await fetch('/api/agents', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(requestBody)
        });

        if (!createResponse.ok) {
          const errorText = await createResponse.text();
          throw new Error(errorText || `HTTP ${createResponse.status}`);
        }

        console.log('Agent created successfully:', agentName);

        // Also add the new agent to the canvas
        const addResponse = await fetch(`/api/workspaces/${workspaceId}/agents`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ agent_name: agentName })
        });

        if (!addResponse.ok) {
          console.warn('Agent created but failed to add to canvas:', await addResponse.text());
        }

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('createAgentModal'));
        if (modal) modal.hide();

        // Refresh sidebar agents list
        if (typeof loadAgentsForSidebar === 'function') {
          await loadAgentsForSidebar();
        }

        // Reload canvas to show new agent
        if (window.agentCanvas) {
          await window.agentCanvas.init();
        }

      } catch (error) {
        console.error('Error creating agent:', error);
        alert(`Failed to create agent: ${error.message}`);
      } finally {
        createBtn.disabled = false;
        createBtn.innerHTML = originalText;
      }
    }

    // Add agent to workspace (for existing agents)
    async function addAgentToWorkspace(agentName) {
      try {
        const response = await fetch('/api/orchestration/workspace/agents', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            studio_id: workspaceId,
            agent_name: agentName
          })
        });

        if (!response.ok) {
          const error = await response.text();
          throw new Error(error);
        }

        // Reload canvas to show new agent
        window.location.reload();

      } catch (error) {
        console.error('Error adding agent:', error);
        alert(`Failed to add agent: ${error.message}`);
      }
    }
  </script>
  <script src="/js/modules/themeManager.js"></script>
  <script src="/js/modules/task-modal-controller.js"></script>
  <script>
    // Initialize theme on page load
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>

  <!-- Shared Task Modal -->
  {{template "task-modal" .}}
</body>
</html>
{{end}}
