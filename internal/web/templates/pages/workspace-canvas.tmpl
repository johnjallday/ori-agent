{{define "workspace-canvas"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">
        <!-- Canvas View -->
        <div id="canvas-view">
          <div class="modern-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-3">
                <a href="/workspaces/{{.Extra.WorkspaceID}}" class="modern-btn modern-btn-secondary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                  </svg>
                  Workspace
                </a>
                <div id="canvas-studio-info" class="d-flex align-items-center gap-2">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
                    <path d="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25M0,20V18.5C0,17.11 1.89,15.94 4.45,15.6C3.86,16.28 3.5,17.22 3.5,18.25V20H0M24,20H20.5V18.25C20.5,17.22 20.14,16.28 19.55,15.6C22.11,15.94 24,17.11 24,18.5V20Z"/>
                  </svg>
                  <span id="canvas-studio-name" style="color: var(--text-primary); font-weight: 500;">Loading...</span>
                  <span id="canvas-workflow-title" style="color: var(--primary-color); font-weight: 600; display: none;">
                    <span style="color: var(--text-muted); margin: 0 8px;">/</span>
                    <span id="canvas-workflow-name"></span>
                  </span>
                </div>
                <!-- Workflow Selector Dropdown -->
                <div id="workflow-selector-container" class="ms-3"></div>
              </div>
              <div class="d-flex align-items-center gap-2">
                <button class="modern-btn modern-btn-primary modern-btn-toolbar" onclick="showAddAgentModal()" title="Add Agent">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12M5,8V10H3V12H5V14H7V12H9V10H7V8H5Z"/>
                  </svg>
                  Agent
                </button>
                <button class="modern-btn modern-btn-primary modern-btn-toolbar" onclick="showAddAttachmentModal()" title="Add Attachment">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M16.5,6.5V17.5A4.5,4.5 0 0,1 12,22A4.5,4.5 0 0,1 7.5,17.5V8A3.5,3.5 0 0,1 11,4.5A3.5,3.5 0 0,1 14.5,8V16.5A2.5,2.5 0 0,1 12,19A2.5,2.5 0 0,1 9.5,16.5V7.5H11V16.5A1,1 0 0,0 12,17.5A1,1 0 0,0 13,16.5V8A2,2 0 0,0 11,6A2,2 0 0,0 9,8V17.5A3.5,3.5 0 0,0 12.5,21A3.5,3.5 0 0,0 16,17.5V6.5H16.5Z" />
                  </svg>
                  Attachment
                </button>
                <button class="modern-btn modern-btn-primary modern-btn-toolbar" onclick="showAddTaskModal()" title="Add Task">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                  </svg>
                  Task
                </button>
                <button class="modern-btn modern-btn-primary modern-btn-toolbar" onclick="showAddStoreNodeModal()" title="Add Store Node">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M6,2H18A2,2 0 0,1 20,4V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V4A2,2 0 0,1 6,2M12,4A6,6 0 0,0 6,10C6,13.31 8.69,16 12.1,16L11.22,13.77C10.95,13.29 11.11,12.68 11.59,12.4L12.45,11.9C12.93,11.63 13.54,11.79 13.82,12.27L15.74,14.69C17.12,13.59 18,11.9 18,10A6,6 0 0,0 12,4M12,9A1,1 0 0,1 13,10A1,1 0 0,1 12,11A1,1 0 0,1 11,10A1,1 0 0,1 12,9M7,18A1,1 0 0,0 6,19A1,1 0 0,0 7,20A1,1 0 0,0 8,19A1,1 0 0,0 7,18M12.09,13.27L14.58,19.58L19.99,18.5L14.89,13.41L12.09,13.27Z"/>
                  </svg>
                  Store
                </button>
                <button class="modern-btn modern-btn-primary modern-btn-toolbar" onclick="showAddDirectoryModal()" title="Add Directory Reference">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                  </svg>
                  Directory
                </button>
                <button class="modern-btn modern-btn-secondary" onclick="exportCanvas()" title="Export as Image">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                  </svg>
                </button>
                <span class="d-inline-flex align-items-center gap-1 px-2 py-1" style="background: rgba(40,167,69,0.1); border-radius: 4px; font-size: 0.75rem;">
                  <span class="status-indicator status-online"></span>
                  <span style="color: var(--success-color); font-weight: 500;">Live Updates</span>
                </span>
              </div>
            </div>
          </div>

          <!-- Workspace Entry Prompt Bar -->
          <div id="homeAssistantCard" class="modern-card p-2 mb-3">
            <form id="homeAssistantForm" class="d-flex align-items-center gap-2">
              <div class="d-none d-md-flex align-items-center gap-2 px-2" style="color: var(--text-secondary); font-size: 0.82rem; white-space: nowrap;">
                <span id="homeAssistantIdentityName" style="font-weight: 600; color: var(--text-primary); display: inline-block; max-width: 180px; overflow: hidden; text-overflow: ellipsis;" title="Workspace Manager">Workspace Manager</span>
                <span style="opacity: 0.6;">Canvas</span>
              </div>
              <input id="homeAssistantInput" type="text" class="modern-input flex-grow-1" maxlength="800"
                     placeholder="Message Workspace Manager about this workspace canvas..."
                     aria-label="Workspace manager prompt"
                     style="min-height: 42px;">
              <button id="homeAssistantSendBtn" type="submit" class="modern-btn modern-btn-primary home-assistant-send-btn">Send</button>
            </form>
          </div>

          <div class="row g-3">
            <!-- Canvas Area -->
            <div id="canvas-main-area" class="col-lg-9">
              <div class="modern-card" style="height: calc(100vh - 250px); position: relative; overflow: hidden;">
                <canvas id="agent-canvas" style="width: 100%; height: 100%; cursor: grab;"></canvas>
                <div id="canvas-info" style="position: absolute; top: 10px; left: 10px; background: rgba(0,0,0,0.7); color: white; padding: 8px 12px; border-radius: 4px; font-size: 0.75rem; font-family: monospace;">
                  Loading workspace...
                </div>
                <!-- Workflow View Mode Banner (legacy - hidden when workflow selector is present) -->
                <div id="workflow-view-banner" style="display: none; position: absolute; top: 10px; left: 50%; transform: translateX(-50%); background: var(--primary-color); color: white; padding: 8px 16px; border-radius: 6px; font-size: 0.85rem; z-index: 100; align-items: center; gap: 12px;">
                  <span>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: text-bottom; margin-right: 4px;">
                      <path d="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12C10.34,12 9,13.34 9,15C9,16.66 10.34,18 12,18C13.66,18 15,16.66 15,15C15,13.34 13.66,12 12,12M6,6H15V10H6V6Z"/>
                    </svg>
                    Workflow View: <strong id="workflow-view-name"></strong>
                  </span>
                  <button onclick="exitWorkflowView()" class="btn btn-sm" style="background: rgba(255,255,255,0.2); color: white; border: none; padding: 4px 10px; border-radius: 4px;">
                    View All Tasks
                  </button>
                </div>

                <!-- Controls overlay -->
                <div style="position: absolute; bottom: 10px; left: 10px; display: flex; gap: 8px; align-items: center;">
                  <button class="modern-btn modern-btn-secondary" onclick="zoomToFitCanvas()" title="Zoom to Fit (R)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
                    </svg>
                  </button>
                  <div class="d-flex align-items-center gap-2" style="background: rgba(0,0,0,0.7); padding: 4px 8px; border-radius: 4px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="white" title="Background Color">
                      <path d="M12.433 10.07C14.133 10.585 16 11.15 16 8a8 8 0 1 0-8 8c1.996 0 1.826-1.504 1.649-3.08-.124-1.101-.252-2.237.351-2.92.465-.527 1.42-.237 2.433.07zM8 5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm4.5 3a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zM5 6.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm.5 6.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
                    </svg>
                    <input type="color" id="canvas-bg-color" value="#f1f5f9" onchange="changeCanvasBackground(this.value)" title="Choose background color" style="width: 32px; height: 28px; border: 2px solid rgba(255,255,255,0.3); border-radius: 4px; cursor: pointer; background: transparent;">
                  </div>
                </div>
              </div>
            </div>

            <!-- Sidebar (visible by default) -->
            <div id="canvas-sidebar" class="col-lg-3">
              <!-- Workflow Panel -->
              <div id="workflow-panel-container"></div>

              <!-- Agent Details -->
              <div class="modern-card p-3 mb-3" id="agent-details-panel" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="mb-0" style="color: var(--text-primary); font-weight: 600;">Agent Details</h6>
                  <button class="btn btn-sm btn-link p-0" onclick="hideAgentDetails()" style="color: var(--text-secondary);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                    </svg>
                  </button>
                </div>
                <div id="agent-details-content" style="font-size: 0.875rem;">
                  Click an agent to see details
                </div>
              </div>

              <!-- Attachment Details -->
              <div class="modern-card p-3 mb-3" id="attachment-details-panel" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="mb-0" style="color: var(--text-primary); font-weight: 600;">Attachment</h6>
                  <button class="btn btn-sm btn-link p-0" onclick="hideAttachmentDetails()" style="color: var(--text-secondary);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                    </svg>
                  </button>
                </div>
                <div id="attachment-details-content" style="font-size: 0.875rem;">
                  Click an attachment to see details
                </div>
              </div>

              <!-- Task Details -->
              <div class="modern-card p-3 mb-3" id="task-details-panel" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="mb-0" style="color: var(--text-primary); font-weight: 600;">Task Details</h6>
                  <button class="btn btn-sm btn-link p-0" onclick="hideTaskDetails()" style="color: var(--text-secondary);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                    </svg>
                  </button>
                </div>
                <div id="task-details-content" style="font-size: 0.875rem;">
                  Click a task to see details
                </div>
                <div id="task-actions" class="mt-3" style="display: none;">
                  <button id="execute-task-btn" class="btn btn-sm btn-primary w-100 mb-2" onclick="executeCurrentTask()" style="display: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                    </svg>
                    Execute Task
                  </button>
                  <div class="d-flex gap-2 mb-2">
                    <button class="btn btn-sm btn-secondary flex-fill" onclick="editCurrentTask()">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                        <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                      </svg>
                      Edit
                    </button>
                    <button class="btn btn-sm btn-danger flex-fill" onclick="deleteCurrentTask()">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                        <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                      </svg>
                      Delete
                    </button>
                  </div>
                  <button id="unassign-task-btn" class="btn btn-sm btn-warning w-100" onclick="unassignCurrentTask()" style="display: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
                    </svg>
                    Unassign from Agent
                  </button>
                </div>
              </div>

              <!-- Task Timeline -->
              <div class="modern-card p-3">
                <h6 class="mb-3" style="color: var(--text-primary); font-weight: 600;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
                    <path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
                  </svg>
                  Timeline
                </h6>
                <div id="timeline-content" style="max-height: 300px; overflow-y: auto; font-size: 0.75rem;">
                  <div class="text-muted text-center py-3">No events yet</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Agent Node Modal -->
  <div class="modal fade" id="addAgentNodeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="margin-top: 80px;">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12M5,8V10H3V12H5V14H7V12H9V10H7V8H5Z"/>
            </svg>
            Add Agent to Canvas
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter: invert(1);"></button>
        </div>
        <div class="modal-body">
          <p style="color: var(--text-secondary); margin-bottom: 1rem;">Select an existing agent to add to this workspace:</p>
          <div id="canvasAgentList" style="max-height: 300px; overflow-y: auto;">
            <div class="text-center py-3">
              <div class="spinner-border spinner-border-sm" role="status"></div>
              <span class="ms-2" style="color: var(--text-secondary);">Loading agents...</span>
            </div>
          </div>
          <hr style="border-color: var(--border-color); margin: 1rem 0;">
          <div class="text-center">
            <small style="color: var(--text-secondary);">Don't see the agent you need?</small>
            <button type="button" class="btn btn-link btn-sm p-0 ms-1" onclick="switchToCreateAgentModal()">
              Create a new agent
            </button>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="canvasAddAgentBtn" class="modern-btn modern-btn-primary" onclick="addSelectedAgentToCanvas()" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </svg>
            Add Agent
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Create New Agent Modal -->
  <div class="modal fade" id="createAgentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="margin-top: 120px;">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1L13.5 2.5L16.17 5.17L11.83 9.51C11.25 9.19 10.61 9 10 9C8.61 9 7.22 9.39 6 10.17L3 7.17L1.59 8.59L4.17 11.17C3.39 12.39 3 13.78 3 15.17C3 16.56 3.39 17.94 4.17 19.17L1.59 21.75L3 23.16L6 20.16C7.22 20.94 8.61 21.33 10 21.33C10.61 21.33 11.25 21.13 11.83 20.82L16.17 16.48L13.5 19.15L15 20.65L21 14.65V12.65L17.83 15.82L12.41 10.41C12.61 10.25 12.8 10.08 13 9.83L17.83 5L21 8.17V9Z"/>
            </svg>
            Create New Agent
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" style="filter: invert(1);"></button>
        </div>
        <div class="modal-body">
          <form id="canvasCreateAgentForm">
            <div class="mb-3">
              <label for="canvasAgentName" class="form-label" style="color: var(--text-primary);">Agent Name</label>
              <input type="text" id="canvasAgentName" class="modern-input w-100" placeholder="Enter agent name..." required>
            </div>
            <div class="mb-3">
              <label for="canvasAgentType" class="form-label" style="color: var(--text-primary);">Agent Type</label>
              <select id="canvasAgentType" class="modern-input w-100">
                <option value="tool-calling">Tool Calling (Cheapest - Optimized for tool use)</option>
                <option value="general">General Purpose (Mid-tier - Balanced capability)</option>
                <option value="workspace-manager">Workspace Manager (Coordinates workspace agents)</option>
                <option value="orchestration">Orchestration (Advanced - Multi-agent coordination)</option>
                <option value="research">Research (Expensive - Complex thinking)</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="canvasAgentModel" class="form-label" style="color: var(--text-primary);">Model</label>
              <select id="canvasAgentModel" class="modern-input w-100">
                <option value="">Loading models...</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="canvasAgentTemperature" class="form-label" style="color: var(--text-primary);">
                Temperature: <span id="canvasTemperatureValue">1.0</span>
              </label>
              <input type="range" id="canvasAgentTemperature" class="form-range" min="0" max="2" step="0.1" value="1.0"
                     style="cursor: pointer;">
              <div class="d-flex justify-content-between" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 500;">
                <span>Focused (0)</span>
                <span>Balanced (1)</span>
                <span>Creative (2)</span>
              </div>
            </div>
            <div class="mb-3">
              <label for="canvasAgentSystemPrompt" class="form-label" style="color: var(--text-primary);">System Prompt</label>
              <textarea id="canvasAgentSystemPrompt" class="form-control" rows="4"
                        style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
