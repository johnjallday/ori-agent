{{define "workspace-canvas"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">
        <!-- Canvas View -->
        <div id="canvas-view">
          <div class="modern-card p-3 mb-3">
            <div class="d-flex justify-content-between align-items-center">
              <div class="d-flex align-items-center gap-3">
                <a href="/studios/{{.Extra.WorkspaceID}}" class="modern-btn modern-btn-secondary">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                  </svg>
                  Back to Dashboard
                </a>
                <div id="canvas-studio-info" class="d-flex align-items-center gap-2">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
                    <path d="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25M0,20V18.5C0,17.11 1.89,15.94 4.45,15.6C3.86,16.28 3.5,17.22 3.5,18.25V20H0M24,20H20.5V18.25C20.5,17.22 20.14,16.28 19.55,15.6C22.11,15.94 24,17.11 24,18.5V20Z"/>
                  </svg>
                  <span id="canvas-studio-name" style="color: var(--text-primary); font-weight: 500;">Loading...</span>
                </div>
              </div>
              <div class="d-flex align-items-center gap-2">
                <button class="modern-btn modern-btn-primary" onclick="showAddAgentModal()" title="Add Agent">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M1,10V12H9V10M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z"/>
                  </svg>
                  Add Agent
                </button>
                <button class="modern-btn modern-btn-primary" onclick="showAddAttachmentModal()" title="Add Attachment">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M16.5,6.5V17.5A4.5,4.5 0 0,1 12,22A4.5,4.5 0 0,1 7.5,17.5V8A3.5,3.5 0 0,1 11,4.5A3.5,3.5 0 0,1 14.5,8V16.5A2.5,2.5 0 0,1 12,19A2.5,2.5 0 0,1 9.5,16.5V7.5H11V16.5A1,1 0 0,0 12,17.5A1,1 0 0,0 13,16.5V8A2,2 0 0,0 11,6A2,2 0 0,0 9,8V17.5A3.5,3.5 0 0,0 12.5,21A3.5,3.5 0 0,0 16,17.5V6.5H16.5Z" />
                  </svg>
                  Add Attachment
                </button>
                <button class="modern-btn modern-btn-primary" onclick="showAddTaskModal()" title="Add Task">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                  </svg>
                  Add Task
                </button>
                <button class="modern-btn modern-btn-primary" onclick="showAddSchedulerNodeModal()" title="Add Scheduler Node">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
                  </svg>
                  Add Scheduler
                </button>
                <button class="modern-btn modern-btn-secondary" onclick="toggleCanvasSidebar()" title="Toggle Sidebar">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M3,9H17V7H3V9M3,13H17V11H3V13M3,17H17V15H3V17M19,17H21V15H19V17M19,7V9H21V7H19M19,13H21V11H19V13Z"/>
                  </svg>
                </button>
                <button class="modern-btn modern-btn-secondary" onclick="exportCanvas()" title="Export as Image">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                  </svg>
                </button>
                <span class="d-inline-flex align-items-center gap-1 px-2 py-1" style="background: rgba(40,167,69,0.1); border-radius: 4px; font-size: 0.75rem;">
                  <span class="status-indicator status-online"></span>
                  <span style="color: var(--success-color); font-weight: 500;">Live Updates</span>
                </span>
              </div>
            </div>
          </div>

          <div class="row g-3">
            <!-- Canvas Area -->
            <div id="canvas-main-area" class="col-lg-9">
              <div class="modern-card" style="height: calc(100vh - 250px); position: relative; overflow: hidden;">
                <canvas id="agent-canvas" style="width: 100%; height: 100%; cursor: grab;"></canvas>
                <div id="canvas-info" style="position: absolute; top: 10px; left: 10px; background: rgba(0,0,0,0.7); color: white; padding: 8px 12px; border-radius: 4px; font-size: 0.75rem; font-family: monospace;">
                  Loading workspace...
                </div>

                <!-- Controls overlay -->
                <div style="position: absolute; bottom: 10px; left: 10px; display: flex; gap: 8px; align-items: center;">
                  <button class="modern-btn modern-btn-secondary" onclick="zoomToFitCanvas()" title="Zoom to Fit (R)">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
                    </svg>
                  </button>
                  <button class="modern-btn modern-btn-secondary" onclick="resetCanvasView()" title="Reset View">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12,4V1L8,5L12,9V6A6,6 0 0,1 18,12A6,6 0 0,1 12,18A6,6 0 0,1 6,12H4A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4Z"/>
                    </svg>
                  </button>
                  <button class="modern-btn modern-btn-secondary" onclick="toggleCanvasAnimation()" id="animation-toggle" title="Toggle Animation">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                    </svg>
                  </button>
                  <div class="d-flex align-items-center gap-2" style="background: rgba(0,0,0,0.7); padding: 4px 8px; border-radius: 4px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="white" title="Background Color">
                      <path d="M12.433 10.07C14.133 10.585 16 11.15 16 8a8 8 0 1 0-8 8c1.996 0 1.826-1.504 1.649-3.08-.124-1.101-.252-2.237.351-2.92.465-.527 1.42-.237 2.433.07zM8 5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm4.5 3a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zM5 6.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0zm.5 6.5a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/>
                    </svg>
                    <input type="color" id="canvas-bg-color" value="#f1f5f9" onchange="changeCanvasBackground(this.value)" title="Choose background color" style="width: 32px; height: 28px; border: 2px solid rgba(255,255,255,0.3); border-radius: 4px; cursor: pointer; background: transparent;">
                  </div>
                </div>
              </div>
            </div>

            <!-- Sidebar (visible by default) -->
            <div id="canvas-sidebar" class="col-lg-3">
              <!-- Agent Details -->
              <div class="modern-card p-3 mb-3" id="agent-details-panel" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="mb-0" style="color: var(--text-primary); font-weight: 600;">Agent Details</h6>
                  <button class="btn btn-sm btn-link p-0" onclick="hideAgentDetails()" style="color: var(--text-secondary);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                    </svg>
                  </button>
                </div>
                <div id="agent-details-content" style="font-size: 0.875rem;">
                  Click an agent to see details
                </div>
              </div>

              <!-- Attachment Details -->
              <div class="modern-card p-3 mb-3" id="attachment-details-panel" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="mb-0" style="color: var(--text-primary); font-weight: 600;">Attachment</h6>
                  <button class="btn btn-sm btn-link p-0" onclick="hideAttachmentDetails()" style="color: var(--text-secondary);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                    </svg>
                  </button>
                </div>
                <div id="attachment-details-content" style="font-size: 0.875rem;">
                  Click an attachment to see details
                </div>
              </div>

              <!-- Task Details -->
              <div class="modern-card p-3 mb-3" id="task-details-panel" style="display: none;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                  <h6 class="mb-0" style="color: var(--text-primary); font-weight: 600;">Task Details</h6>
                  <button class="btn btn-sm btn-link p-0" onclick="hideTaskDetails()" style="color: var(--text-secondary);">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
                    </svg>
                  </button>
                </div>
                <div id="task-details-content" style="font-size: 0.875rem;">
                  Click a task to see details
                </div>
                <div id="task-actions" class="mt-3" style="display: none;">
                  <button id="execute-task-btn" class="btn btn-sm btn-primary w-100 mb-2" onclick="executeCurrentTask()" style="display: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M8,5.14V19.14L19,12.14L8,5.14Z"/>
                    </svg>
                    Execute Task
                  </button>
                  <div class="d-flex gap-2 mb-2">
                    <button class="btn btn-sm btn-secondary flex-fill" onclick="editCurrentTask()">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                        <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                      </svg>
                      Edit
                    </button>
                    <button class="btn btn-sm btn-danger flex-fill" onclick="deleteCurrentTask()">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                        <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                      </svg>
                      Delete
                    </button>
                  </div>
                  <button id="unassign-task-btn" class="btn btn-sm btn-warning w-100" onclick="unassignCurrentTask()" style="display: none;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
                    </svg>
                    Unassign from Agent
                  </button>
                </div>
              </div>

              <!-- Task Timeline -->
              <div class="modern-card p-3">
                <h6 class="mb-3" style="color: var(--text-primary); font-weight: 600;">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
                    <path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
                  </svg>
                  Timeline
                </h6>
                <div id="timeline-content" style="max-height: 300px; overflow-y: auto; font-size: 0.75rem;">
                  <div class="text-muted text-center py-3">No events yet</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Agent Modal -->
  <div class="modal fade" id="addAgentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M15,14C12.33,14 7,15.33 7,18V20H23V18C23,15.33 17.67,14 15,14M1,10V12H9V10M15,12A4,4 0 0,0 19,8A4,4 0 0,0 15,4A4,4 0 0,0 11,8A4,4 0 0,0 15,12Z"/>
            </svg>
            Add Agent to Workspace
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p style="color: var(--text-secondary); margin-bottom: 1rem;">Select an agent to add to this workspace:</p>
          <div id="available-agents-list" style="max-height: 400px; overflow-y: auto;">
            <div class="text-center py-3">
              <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Color Picker Modal -->
  <div class="modal fade" id="colorPickerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <circle cx="12" cy="12" r="10"></circle>
              <path d="M12 2v20"></path>
              <path d="M2 12h20"></path>
            </svg>
            Choose Attachment Color
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p style="color: var(--text-secondary); margin-bottom: 1rem;">Select a color for your attachment node:</p>
          <div id="color-palette-grid" class="color-palette-grid">
            <!-- Colors will be dynamically populated -->
          </div>
          <div class="mt-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Or enter custom color:</label>
            <div class="d-flex gap-2">
              <input type="text" id="custom-color-input" class="form-control" placeholder="#3b82f6" pattern="^#[0-9A-Fa-f]{6}$">
              <button class="modern-btn modern-btn-secondary" onclick="applyCustomColor()">Apply</button>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Add Scheduler Node Modal -->
  <div class="modal fade" id="addSchedulerNodeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
            </svg>
            Add Scheduler Node
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <form id="schedulerNodeForm">
            <!-- Name -->
            <div class="mb-3">
              <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Name</label>
              <input type="text" class="form-control" id="scheduler-name" placeholder="e.g., Daily Data Sync" required>
            </div>

            <!-- Schedule Type -->
            <div class="mb-3">
              <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Schedule Type</label>
              <select class="form-select" id="scheduler-type" onchange="updateScheduleInputs()">
                <option value="interval">Simple Interval</option>
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
                <option value="cron">Cron Expression</option>
                <option value="relative_delay">Relative Delay</option>
              </select>
            </div>

            <!-- Schedule Configuration (Dynamic based on type) -->
            <div id="schedule-config">
              <!-- Interval -->
              <div id="interval-config" class="schedule-type-config">
                <div class="mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Interval (minutes)</label>
                  <input type="number" class="form-control" id="interval-minutes" min="1" value="60">
                </div>
              </div>

              <!-- Daily -->
              <div id="daily-config" class="schedule-type-config" style="display: none;">
                <div class="mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Time</label>
                  <input type="time" class="form-control" id="daily-time" value="09:00">
                </div>
              </div>

              <!-- Weekly -->
              <div id="weekly-config" class="schedule-type-config" style="display: none;">
                <div class="mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Day of Week</label>
                  <select class="form-select" id="weekly-day">
                    <option value="0">Sunday</option>
                    <option value="1" selected>Monday</option>
                    <option value="2">Tuesday</option>
                    <option value="3">Wednesday</option>
                    <option value="4">Thursday</option>
                    <option value="5">Friday</option>
                    <option value="6">Saturday</option>
                  </select>
                </div>
                <div class="mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Time</label>
                  <input type="time" class="form-control" id="weekly-time" value="09:00">
                </div>
              </div>

              <!-- Cron -->
              <div id="cron-config" class="schedule-type-config" style="display: none;">
                <div class="mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Cron Expression</label>
                  <input type="text" class="form-control" id="cron-expr" placeholder="0 9 * * *">
                  <small class="text-muted">Format: minute hour day-of-month month day-of-week</small>
                </div>
              </div>

              <!-- Relative Delay -->
              <div id="relative-delay-config" class="schedule-type-config" style="display: none;">
                <div class="mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Delay (minutes)</label>
                  <input type="number" class="form-control" id="delay-minutes" min="1" value="5">
                </div>
                <div class="form-check mb-3">
                  <input class="form-check-input" type="checkbox" id="delay-trigger-once">
                  <label class="form-check-label" for="delay-trigger-once">
                    Trigger only once (don't repeat)
                  </label>
                </div>
              </div>
            </div>

            <!-- Optional: End Date -->
            <div class="mb-3">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="has-end-date" onchange="toggleEndDate()">
                <label class="form-check-label" for="has-end-date">
                  Set expiration date
                </label>
              </div>
              <input type="datetime-local" class="form-control mt-2" id="end-date" style="display: none;">
            </div>

            <!-- Initial State -->
            <div class="mb-3">
              <div class="form-check">
                <input class="form-check-input" type="checkbox" id="scheduler-enabled" checked>
                <label class="form-check-label" for="scheduler-enabled">
                  Enable scheduler immediately
                </label>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="modern-btn modern-btn-primary" onclick="submitSchedulerNode()">Create Scheduler</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="/js/modules/resizer.js"></script>
  <script src="/js/modules/settings.js"></script>
  <script src="/js/modules/agents.js"></script>
  <script src="/js/modules/plugins.js"></script>
  <script src="/js/modules/plugin-config.js"></script>
  <script src="/js/modules/plugin-store.js"></script>
  <script src="/js/modules/apikey.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/modules/update-checker.js"></script>
  <script src="/js/modules/plugin-update-checker.js"></script>
  <script src="/js/modules/plugin-health.js"></script>
  <script src="/js/modules/file-upload.js"></script>
  <!-- Real-time studio modules -->
  <script src="/js/modules/studio-realtime.js"></script>
  <script src="/js/modules/message-timeline.js"></script>
  <script type="module" src="/js/modules/agent-canvas.js?v=1764218000"></script>
  <!-- Studios workspace management -->
  <link rel="stylesheet" href="/css/studio.css">
  <script src="/js/modules/studios-canvas-helpers.js?v=1732838800"></script>

  <script>
    // Workspace-specific canvas initialization
    const workspaceId = '{{.Extra.WorkspaceID}}';
    // Set global studio id for helper scripts that rely on currentStudioId
    if (typeof currentStudioId !== 'undefined') {
      currentStudioId = workspaceId;
    }
    window.currentStudioId = workspaceId;

    // Initialize canvas directly with this workspace
    document.addEventListener('DOMContentLoaded', async function() {
      console.log('🎨 Initializing workspace canvas for:', workspaceId);

      // Load workspace info and display in header
      try {
        const response = await fetch(`/api/orchestration/workspace?id=${workspaceId}`);
        if (response.ok) {
          const workspace = await response.json();
          document.getElementById('canvas-studio-name').textContent = workspace.name || 'Unnamed Workspace';
        }
      } catch (error) {
        console.error('Failed to load workspace info:', error);
      }

      // Wait for AgentCanvas module to load (it sets window.AgentCanvas)
      await import('/js/modules/agent-canvas.js');

      // Create canvas instance for this specific workspace
      window.agentCanvas = new window.AgentCanvas('agent-canvas', workspaceId);
      await window.agentCanvas.init();

      console.log('✅ Workspace canvas initialized');
    });

    // Show add agent modal with available agents
    async function showAddAgentModal() {
      const modal = new bootstrap.Modal(document.getElementById('addAgentModal'));
      const agentsList = document.getElementById('available-agents-list');

      // Show modal
      modal.show();
      agentsList.innerHTML = `
        <div class="text-center py-3">
          <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      `;

      // Load available agents
      try {
        const parseJson = async (resp) => {
          const text = await resp.text();
          try {
            return JSON.parse(text);
          } catch (err) {
            throw new Error(text || err.message || 'Invalid response');
          }
        };

        // Get all system agents
        const agentsResponse = await fetch('/api/agents');
        if (!agentsResponse.ok) {
          const msg = await agentsResponse.text();
          throw new Error(msg || 'Failed to load agents');
        }
        const agentsData = await parseJson(agentsResponse);
        const allAgents = agentsData.agents || []; // Array of {name, type} objects

        // Get workspace to see which agents are already added
        const workspaceResponse = await fetch(`/api/orchestration/workspace?id=${workspaceId}`);
        if (!workspaceResponse.ok) {
          const msg = await workspaceResponse.text();
          throw new Error(msg || 'Failed to load workspace');
        }
        const workspace = await parseJson(workspaceResponse);
        const workspaceAgents = workspace.agents || [];

        // Track how many instances of each agent are already on the canvas
        const agentCounts = workspaceAgents.reduce((acc, name) => {
          acc[name] = (acc[name] || 0) + 1;
          return acc;
        }, {});

        if (allAgents.length === 0) {
          agentsList.innerHTML = `
            <div class="text-center py-4">
              <p style="color: var(--text-muted);">No agents available. Create one to get started.</p>
              <a href="/agents" class="modern-btn modern-btn-primary mt-2">Create New Agent</a>
            </div>
          `;
          return;
        }

        // Display all agents as clickable cards so users can add additional instances
        agentsList.innerHTML = allAgents.map(agent => {
          const count = agentCounts[agent.name] || 0;
          const badgeText = count > 0 ? `${count} in workspace` : 'Not in workspace yet';
          const badgeColor = count > 0 ? 'rgba(46, 204, 113, 0.15)' : 'rgba(52, 152, 219, 0.15)';

          return `
            <div class="modern-card p-3 mb-2" style="cursor: pointer; border-left: 3px solid var(--primary-color);"
                 onclick="addAgentToWorkspace('${agent.name}')">
              <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: var(--primary-color);">
                    <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                  </svg>
                  <div>
                    <strong style="color: var(--text-primary);">${agent.name}</strong>
                    ${count > 0 ? '<div class="text-muted small">Add another instance to the canvas</div>' : ''}
                  </div>
                </div>
                <div class="text-end">
                  <span class="badge rounded-pill" style="background:${badgeColor}; color: var(--text-primary);">
                    ${badgeText}
                  </span>
                  <div style="color: var(--success-color);">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          `;
        }).join('');

      } catch (error) {
        console.error('Error loading agents:', error);
        agentsList.innerHTML = `
          <div class="alert alert-danger">Failed to load agents: ${error.message || error}</div>
        `;
      }
    }

    // Add agent to workspace
    async function addAgentToWorkspace(agentName) {
      try {
        const response = await fetch('/api/orchestration/workspace/agents', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            studio_id: workspaceId,
            agent_name: agentName
          })
        });

        if (!response.ok) {
          const error = await response.text();
          throw new Error(error);
        }

        // Close modal
        const modal = bootstrap.Modal.getInstance(document.getElementById('addAgentModal'));
        modal.hide();

        // Reload canvas to show new agent
        window.location.reload();

      } catch (error) {
        console.error('Error adding agent:', error);
        alert(`Failed to add agent: ${error.message}`);
      }
    }
  </script>
  <script src="/js/modules/themeManager.js"></script>
  <script>
    // Initialize theme on page load
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>
</body>
</html>
{{end}}
