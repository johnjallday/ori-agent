{{define "skills"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper" id="skillsPage" data-current-agent="{{index .Extra "DefaultAgentName"}}">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">
        <div class="modern-card p-4 mb-4">
          <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
              <h2 class="mb-2" style="color: var(--text-primary);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M7,2V13H10V22L17,10H13L17,2H7Z"/>
                </svg>
                Skills
              </h2>
              <p class="mb-0" style="color: var(--text-secondary);">Browse skills available to your agents</p>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
              <button id="skillsCreateBtn" class="modern-btn modern-btn-primary btn-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                </svg>
                New Skill
              </button>
              <button id="skillsDiscoverBtn" class="modern-btn modern-btn-secondary btn-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
                </svg>
                Discover Skills
              </button>
              <select id="skillsAgentSelect" class="form-select form-select-sm" style="min-width: 200px; background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-primary);">
                <option value="">Assistant Default</option>
              </select>
              <input id="skillsSearch" type="text" class="form-control form-control-sm" placeholder="Search skills..." style="min-width: 200px; background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-primary);">
              <button id="skillsRefreshBtn" class="modern-btn modern-btn-secondary btn-sm">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                </svg>
                Refresh
              </button>
            </div>
          </div>
        </div>

        <div class="modern-card p-4">
          <div id="skillsError" class="alert alert-danger d-none" style="font-size: 0.875rem;"></div>
          <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="mb-0" style="color: var(--text-primary);">Available Skills</h5>
            <span id="skillsCount" class="badge bg-secondary" style="font-size: 12px;">0</span>
          </div>
          <div id="skillsSourceFilters" class="d-flex gap-2 flex-wrap mb-3 d-none"></div>
          <div id="skillsList" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px;">
            <div class="text-center py-3" style="color: var(--text-secondary);">Loading skills...</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Shared Modals (Add Agent, Marketplace, etc.) -->
  {{template "modals.tmpl" .}}

  <!-- Skills Modals -->
  <div class="modal fade" id="skillsEditorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" id="skillsEditorTitle" style="color: var(--text-primary);">Create Skill</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="color: var(--text-primary);">
          <div id="skillsEditorError" class="alert alert-danger d-none" style="font-size: 0.875rem;"></div>
          <form id="skillsEditorForm">
            <div class="mb-3">
              <label for="skillNameInput" class="form-label required">Skill Name</label>
              <input type="text" id="skillNameInput" class="modern-input w-100" placeholder="e.g. summarize-session" required maxlength="64">
              <small class="form-helper">Lowercase letters, numbers, and hyphens only.</small>
            </div>
            <div class="mb-3">
              <label for="skillDescriptionInput" class="form-label required">Description</label>
              <textarea id="skillDescriptionInput" class="form-control" rows="2" required
                        style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                        placeholder="What does this skill do?"></textarea>
            </div>
            <div class="mb-3">
              <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-1">
                <label for="skillPromptInput" class="form-label required mb-0">Prompt</label>
                <button type="button" id="skillsGeneratePromptBtn" class="modern-btn modern-btn-secondary btn-sm">Generate Prompt</button>
              </div>
              <textarea id="skillPromptInput" class="form-control" rows="8" required
                        style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                        placeholder="Skill instructions go here..."></textarea>
            </div>
            <div class="mb-1 d-flex justify-content-between align-items-center gap-2 flex-wrap">
              <label for="skillOpenAIYamlInput" class="form-label mb-0">OpenAI Configuration (optional)</label>
              <button type="button" id="skillsGenerateConfigBtn" class="modern-btn modern-btn-secondary btn-sm">Generate Configuration</button>
            </div>
            <div class="mb-3">
              <textarea id="skillOpenAIYamlInput" class="form-control" rows="8"
                        style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.85em; resize: vertical; font-family: 'SF Mono', Monaco, Inconsolata, 'Roboto Mono', monospace;"
                        placeholder="agents/openai.yaml content (optional)"></textarea>
              <small class="form-helper">Saved to <code>agents/openai.yaml</code>. Leave empty to skip on create or keep existing config on edit.</small>
            </div>
          </form>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="skillsSaveBtn" class="modern-btn modern-btn-primary">Save Skill</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="skillsDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header align-items-start" style="border-bottom: 1px solid var(--border-color);">
          <div style="min-width: 0; flex: 1;">
            <h5 class="modal-title" id="skillsDetailsTitle" style="color: var(--text-primary); word-break: break-word;">Skill</h5>
            <div id="skillsDetailsBadges" class="d-flex gap-2 flex-wrap mt-2"></div>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="color: var(--text-primary);">
          <div id="skillsDetailsErrors" class="alert alert-danger d-none" style="font-size: 0.875rem;"></div>
          <div class="mb-3">
            <div class="form-label" style="color: var(--text-secondary); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Description</div>
            <div id="skillsDetailsDescription" style="white-space: pre-wrap; word-break: break-word; font-size: 0.9em; line-height: 1.5;"></div>
          </div>
          <div class="mb-3" id="skillsDetailsPathRow">
            <div class="form-label" style="color: var(--text-secondary); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Path</div>
            <div id="skillsDetailsPath" style="font-size: 12px; word-break: break-all; color: var(--text-secondary); font-family: 'SF Mono', Monaco, Inconsolata, 'Roboto Mono', monospace;"></div>
          </div>
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1">
              <div class="form-label mb-0" style="color: var(--text-secondary); font-size: 11px; text-transform: uppercase; letter-spacing: 0.5px;">Prompt</div>
              <small id="skillsDetailsPromptStatus" style="color: var(--text-secondary);"></small>
            </div>
            <pre id="skillsDetailsPrompt" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 6px; padding: 12px; font-size: 0.85em; max-height: 360px; overflow: auto; white-space: pre-wrap; word-break: break-word; color: var(--text-primary); margin: 0;"></pre>
          </div>
        </div>
        <div class="modal-footer justify-content-between" style="border-top: 1px solid var(--border-color);">
          <div id="skillsDetailsActions" class="d-flex gap-2 flex-wrap"></div>
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="skillsRunModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" id="skillsRunTitle" style="color: var(--text-primary);">Run Skill</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="color: var(--text-primary);">
          <div id="skillsRunOutput" style="white-space: pre-wrap; font-size: 0.9em;"></div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <div class="modal fade" id="skillsMarketplaceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" style="color: var(--text-primary);">Install Skills from skills.sh</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="color: var(--text-primary);">
          <div id="skillsMarketplaceStatus" class="alert d-none" style="font-size: 0.875rem;"></div>
          <ul class="nav nav-tabs mb-3" id="skillsMarketplaceTabs" role="tablist">
            <li class="nav-item" role="presentation">
              <button class="nav-link active" id="skillsMarketplaceSearchTab" data-bs-toggle="tab" data-bs-target="#skillsMarketplaceSearchPane" type="button" role="tab" aria-controls="skillsMarketplaceSearchPane" aria-selected="true">Search</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="skillsMarketplaceInstallTab" data-bs-toggle="tab" data-bs-target="#skillsMarketplaceInstallPane" type="button" role="tab" aria-controls="skillsMarketplaceInstallPane" aria-selected="false">Install Package</button>
            </li>
            <li class="nav-item" role="presentation">
              <button class="nav-link" id="skillsMarketplaceManageTab" data-bs-toggle="tab" data-bs-target="#skillsMarketplaceManagePane" type="button" role="tab" aria-controls="skillsMarketplaceManagePane" aria-selected="false">Manage Installed</button>
            </li>
          </ul>

          <div class="tab-content">
            <div class="tab-pane fade show active" id="skillsMarketplaceSearchPane" role="tabpanel" aria-labelledby="skillsMarketplaceSearchTab">
              <div class="d-flex gap-2 flex-wrap mb-3">
                <input id="skillsMarketplaceSearchQuery" type="text" class="form-control form-control-sm" placeholder="e.g. find-skills, playwright, react" style="flex: 1; min-width: 240px; background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-primary);">
                <button id="skillsMarketplaceSearchBtn" class="modern-btn modern-btn-primary btn-sm">Search skills.sh</button>
              </div>
              <div class="d-flex justify-content-between align-items-center mb-2">
                <small style="color: var(--text-secondary);">Searches public skills packages and shows install-ready package IDs.</small>
                <a href="https://skills.sh/" target="_blank" rel="noopener noreferrer" style="font-size: 12px;">Open skills.sh</a>
              </div>
              <div id="skillsMarketplaceResults" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px;">
                <div class="text-center py-3" style="color: var(--text-secondary);">Search to discover installable skills.</div>
              </div>
            </div>

            <div class="tab-pane fade" id="skillsMarketplaceInstallPane" role="tabpanel" aria-labelledby="skillsMarketplaceInstallTab">
              <div class="mb-3">
                <label for="skillsMarketplacePackageInput" class="form-label">Package</label>
                <input id="skillsMarketplacePackageInput" type="text" class="modern-input w-100" placeholder="owner/repo@skill (e.g. vercel-labs/skills@find-skills)">
                <small class="form-helper">Installs globally for Ori via `npx skills add ... -g --agent universal`.</small>
              </div>
              <div class="d-flex gap-2 flex-wrap">
                <button id="skillsMarketplaceInstallBtn" class="modern-btn modern-btn-primary btn-sm">Install Package</button>
                <button id="skillsMarketplaceQuickFindSkillsBtn" class="modern-btn modern-btn-secondary btn-sm">Install find-skills</button>
              </div>
            </div>

            <div class="tab-pane fade" id="skillsMarketplaceManagePane" role="tabpanel" aria-labelledby="skillsMarketplaceManageTab">
              <div class="d-flex gap-2 flex-wrap mb-3">
                <button id="skillsMarketplaceManageRefreshBtn" class="modern-btn modern-btn-secondary btn-sm">Refresh Installed</button>
                <button id="skillsMarketplaceCheckUpdatesBtn" class="modern-btn modern-btn-secondary btn-sm">Check Updates</button>
                <button id="skillsMarketplaceUpdateAllBtn" class="modern-btn modern-btn-primary btn-sm">Update All</button>
              </div>
              <div class="d-flex gap-2 flex-wrap mb-2">
                <input id="skillsMarketplaceRemoveSkillInput" type="text" class="form-control form-control-sm" placeholder="Skill name to remove (e.g. find-skills)" style="flex: 1; min-width: 240px; background: var(--bg-secondary); border: 1px solid var(--border-color); color: var(--text-primary);">
                <button id="skillsMarketplaceRemoveBtn" class="modern-btn modern-btn-secondary btn-sm">Remove Skill</button>
              </div>
              <small style="color: var(--text-secondary);">Uses `npx skills list/check/update/remove` in global scope.</small>
              <div id="skillsMarketplaceInstalledList" class="mt-3" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px;">
                <div class="text-center py-3" style="color: var(--text-secondary);">Loading installed skills...</div>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <!-- Theme Manager - must load before other modules -->
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/modules/toast.js"></script>
  <script defer src="/js/modules/resizer.js"></script>
  <script defer src="/js/modules/agents.js"></script>
  <script defer src="/js/modules/sidebar.js"></script>
  <script defer src="/js/skills.js"></script>
  {{template "theme-init.tmpl" .}}
</body>
</html>
{{end}}
