      const nodeWrapper = (schedulerNodes || []).find(n => (n.node_id === sched.canvas_node_id) || (n.scheduled_task && n.scheduled_task.canvas_node_id === sched.canvas_node_id));
      const scheduledTask = nodeWrapper?.scheduled_task || null;
