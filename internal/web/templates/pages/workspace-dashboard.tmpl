          <input type="hidden" id="edit-storage-node-id" />

          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Name</label>
            <input type="text" class="form-control" id="edit-storage-name">
          </div>
          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Directory</label>
            <input type="text" class="form-control" id="edit-storage-base-dir" placeholder="outputs/my-run">
          </div>
          <div class="row g-3">
            <div class="col-md-6">
              <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Format</label>
              <select class="form-select" id="edit-storage-format">
                <option value="json">json</option>
                <option value="text">text</option>
                <option value="markdown">markdown</option>
                <option value="binary">binary</option>
              </select>
            </div>
            <div class="col-md-6">
              <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Write mode</label>
              <select class="form-select" id="edit-storage-write-mode">
                <option value="overwrite">overwrite</option>
                <option value="append">append</option>
              </select>
            </div>
          </div>
          <div class="form-check mt-3">
            <input class="form-check-input" type="checkbox" id="edit-storage-auto-create-dir" checked>
            <label class="form-check-label" for="edit-storage-auto-create-dir">Auto-create directories</label>
          </div>
          <div class="form-check mt-2">
            <input class="form-check-input" type="checkbox" id="edit-storage-auto-store" checked>
            <label class="form-check-label" for="edit-storage-auto-store">Auto-store task results</label>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="modern-btn modern-btn-primary" id="edit-storage-save-btn" onclick="submitEditStorage()">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Attachment Modal -->
  <div class="modal fade" id="editAttachmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="margin-top: 80px;">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M16.5,6V17.5A4.5,4.5 0 0,1 12,22A4.5,4.5 0 0,1 7.5,17.5V5A3.5,3.5 0 0,1 11,1.5A3.5,3.5 0 0,1 14.5,5V15.5A2.5,2.5 0 0,1 12,18A2.5,2.5 0 0,1 9.5,15.5V6H11V15.5A1,1 0 0,0 12,16.5A1,1 0 0,0 13,15.5V5A2,2 0 0,0 11,3A2,2 0 0,0 9,5V17.5A3,3 0 0,0 12,20.5A3,3 0 0,0 15,17.5V6H16.5Z"/>
            </svg>
            Edit Attachment
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="edit-attachment-id" />

          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Title</label>
            <input type="text" class="form-control" id="edit-attachment-title">
          </div>
          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Type</label>
            <select class="form-select" id="edit-attachment-type">
              <option value="doc">doc</option>
              <option value="image">image</option>
              <option value="other">other</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Link URL</label>
            <input type="text" class="form-control" id="edit-attachment-link-url" placeholder="https://...">
          </div>
          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Body</label>
            <textarea class="form-control" id="edit-attachment-body" rows="5"></textarea>
          </div>
          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">File</label>
            <input type="text" class="form-control" id="edit-attachment-file-url" readonly>
            <div class="form-text">File edits are managed on the canvas; this is read-only here.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="modern-btn modern-btn-primary" id="edit-attachment-save-btn" onclick="submitEditAttachment()">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Save to File Modal -->
  <div class="modal fade" id="saveToFileModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog" style="margin-top: 80px;">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
            </svg>
            Save Task Result
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">File Path</label>
            <input type="text" class="form-control" id="save-file-path" placeholder="result.txt">
            <div class="form-text">Enter a file path. Relative paths will be saved to the current directory.</div>
          </div>
          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Format</label>
            <select class="form-select" id="save-file-format">
              <option value="text">Plain Text (.txt)</option>
              <option value="json">JSON (.json)</option>
              <option value="markdown">Markdown (.md)</option>
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="modern-btn modern-btn-primary" onclick="saveTaskResultToFile()">Save</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <!-- DX Utilities -->
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/modules/resizer.js"></script>
  <script src="/js/modules/settings.js"></script>
  <script src="/js/modules/agents.js"></script>
  <script src="/js/modules/plugins.js"></script>
  <script src="/js/modules/plugin-config.js"></script>
  <script src="/js/modules/plugin-store.js"></script>
  <script src="/js/modules/apikey.js"></script>
  <script src="/js/app.js?v=1694538177"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/modules/plugin-health.js"></script>
  <script src="/js/modules/file-upload.js"></script>
  <script src="/js/modules/task-modal-controller.js"></script>
  <link rel="stylesheet" href="/css/workspace-dashboard.css">

  <script src="/js/modules/workspace-dashboard.js"></script>
  <script src="/js/modules/workspace-dashboard-modals.js"></script>
  <script src="/js/modules/workspace-dashboard-agents.js"></script>
  <script src="/js/modules/themeManager.js"></script>
  <script>
    // Initialize theme on page load
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>

  {{template "task-modal" .}}
</body>
</html>
{{end}}
