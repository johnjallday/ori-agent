{{define "workspace-dashboard"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">
        <!-- Header -->
        <div class="modern-card p-4 mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="d-flex align-items-center gap-2 mb-2">
                <a href="/studios" class="modern-btn modern-btn-secondary btn-sm">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                  </svg>
                  Back to Studios
                </a>
              </div>
              <h2 class="mb-2" style="color: var(--text-primary);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25M0,20V18.5C0,17.11 1.89,15.94 4.45,15.6C3.86,16.28 3.5,17.22 3.5,18.25V20H0M24,20H20.5V18.25C20.5,17.22 20.14,16.28 19.55,15.6C22.11,15.94 24,17.11 24,18.5V20Z"/>
                </svg>
                <span id="workspace-name">Loading...</span>
              </h2>
              <p class="mb-0" style="color: var(--text-secondary);">
                <span class="me-3">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: text-bottom;">
                    <path d="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"/>
                  </svg>
                  <span id="workspace-created">Created: --</span>
                </span>
                <span class="me-3">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: text-bottom;">
                    <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2M12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20M13 12L16.28 14.54L15.5 15.67L12 13.1V7H13V12Z"/>
                  </svg>
                  <span id="workspace-updated">Updated: --</span>
                </span>
                <span id="workspace-status-badge"></span>
              </p>
            </div>
            <div class="d-flex gap-2">
              <button class="modern-btn modern-btn-secondary" onclick="openManageAgentsModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8Z"/>
                </svg>
                Manage Agents
              </button>
              <button class="modern-btn modern-btn-primary" id="view-canvas-btn" onclick="viewCanvas()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
                </svg>
                View Canvas
              </button>
            </div>
          </div>
        </div>

        <!-- Dashboard Content -->
        <div class="row g-4">
          <!-- Left Column: Overview & Stats -->
          <div class="col-lg-8">
            <!-- Overview Card -->
            <div class="modern-card p-4 mb-4">
              <h4 class="mb-3" style="color: var(--text-primary);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M7,20H9V14H7V20M11,20H13V12H11V20M15,20H17V16H15V20Z"/>
                </svg>
                Workspace Overview
              </h4>
              <div class="row g-3">
                <div class="col-md-4">
                  <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(40,167,69,0.1); color: var(--success-color);">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value" id="tasks-completed">0</div>
                      <div class="stat-label">Tasks Completed</div>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(0,123,255,0.1); color: var(--primary-color);">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12.5,7V13L16.25,15.15L15.55,16.5L11,13.75V7H12.5Z"/>
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value" id="tasks-in-progress">0</div>
                      <div class="stat-label">In Progress</div>
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(220,53,69,0.1); color: var(--danger-color);">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"/>
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value" id="tasks-failed">0</div>
                      <div class="stat-label">Failed</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Participating Agents -->
            <div class="modern-card p-4 mb-4">
              <h4 class="mb-3" style="color: var(--text-primary);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M16,13C15.71,13 15.38,13 15.03,13.05C16.19,13.89 17,15 17,16.5V19H23V16.5C23,14.17 18.33,13 16,13M8,13C5.67,13 1,14.17 1,16.5V19H15V16.5C15,14.17 10.33,13 8,13M8,11A3,3 0 0,0 11,8A3,3 0 0,0 8,5A3,3 0 0,0 5,8A3,3 0 0,0 8,11M16,11A3,3 0 0,0 19,8A3,3 0 0,0 16,5A3,3 0 0,0 13,8A3,3 0 0,0 16,11Z"/>
                </svg>
                Participating Agents
              </h4>
              <div id="agents-list" class="d-flex flex-wrap gap-2">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
              </div>
            </div>

            <!-- Tasks List -->
            <div class="modern-card p-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 style="color: var(--text-primary); margin: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                    <path d="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M16,10V12H8V10H16M13,14V16H8V14H13Z"/>
                  </svg>
                  Tasks
                </h4>
                <div class="d-flex gap-2">
                  <button class="modern-btn modern-btn-secondary btn-sm" onclick="refreshTasks()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </svg>
                    Refresh
                  </button>
                </div>
              </div>
              <div id="tasks-list">
                <div class="text-center py-3">
                  <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                  <p class="mt-2" style="color: var(--text-muted);">Loading tasks...</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Details & Actions -->
          <div class="col-lg-4">
            <!-- Workspace Details -->
            <div class="modern-card p-4 mb-4">
              <h4 class="mb-3" style="color: var(--text-primary);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M15,18V16H6V18H15M18,14V12H6V14H18Z"/>
                </svg>
                Details
              </h4>
              <div class="detail-row">
                <span class="detail-label">Workspace ID</span>
                <code id="workspace-id-display" class="detail-value">{{.Extra.WorkspaceID}}</code>
              </div>
              <div class="detail-row">
                <span class="detail-label">Description</span>
                <span id="workspace-description" class="detail-value">--</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{template "modals.tmpl" .}}

  <!-- Manage Agents Modal -->
  <div class="modal fade" id="manageAgentsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8Z"/>
            </svg>
            Manage Agents
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
          <!-- Create Agent Section -->
          <div class="mb-4">
            <h6 style="color: var(--text-primary);">Create New Agent</h6>
            <form id="createAgentForm" class="modern-card p-3">
              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Agent Name</label>
                  <input type="text" id="new-agent-name" class="modern-input w-100" placeholder="Enter agent name..." required>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Agent Type</label>
                  <select id="new-agent-type" class="modern-input w-100">
                    <option value="tool-calling">Tool Calling (Cheapest - Optimized for tool use)</option>
                    <option value="general">General Purpose (Mid-tier - Balanced capability)</option>
                    <option value="orchestration">Orchestration (Advanced - Multi-agent coordination)</option>
                    <option value="research">Research (Expensive - Complex thinking)</option>
                  </select>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label" style="color: var(--text-primary);">Model</label>
                <select id="new-agent-model" class="modern-input w-100">
                  <option value="">Loading models...</option>
                </select>
              </div>
              <div class="mb-3">
                <label class="form-label" style="color: var(--text-primary);">
                  Temperature: <span id="new-agent-temperature-value">1.0</span>
                </label>
                <input type="range" id="new-agent-temperature" class="form-range" min="0" max="2" step="0.1" value="1.0"
                       style="cursor: pointer;">
                <div class="d-flex justify-content-between" style="font-size: 0.75rem; color: var(--text-secondary); font-weight: 500;">
                  <span>Focused (0)</span>
                  <span>Balanced (1)</span>
                  <span>Creative (2)</span>
                </div>
              </div>
              <div class="mb-3">
                <label class="form-label" style="color: var(--text-primary);">System Prompt</label>
                <textarea id="new-agent-prompt" class="form-control" rows="4"
                          style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                          placeholder="You are a helpful assistant with access to various tools. When a user request can be fulfilled by using an available tool, use the tool instead of providing general information. Be concise and direct in your responses."></textarea>
              </div>
              <button type="submit" class="modern-btn modern-btn-primary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                </svg>
                Create Agent
              </button>
            </form>
          </div>

          <!-- Existing Agents Section -->
          <div>
            <h6 style="color: var(--text-primary);">Existing Agents</h6>
            <div id="agents-list-modal" class="modern-card p-3">
              <div class="text-center py-3">
                <div class="spinner-border text-primary" role="status">
                  <span class="visually-hidden">Loading...</span>
                </div>
                <p class="mt-2" style="color: var(--text-muted);">Loading agents...</p>
              </div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Task Modal -->
  <div class="modal fade" id="editTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z"/>
            </svg>
            Edit Task
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="edit-task-id-hidden" />

          <div class="mb-3">
            <div class="detail-row" style="margin-bottom: 0;">
              <span class="detail-label">Task ID</span>
              <code id="edit-task-id" class="detail-value"></code>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Assignment</label>
            <select class="form-select" id="edit-task-assignment"></select>
            <div class="form-text">Choose an agent instance, or unassign.</div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">From</label>
            <input type="text" class="form-control" id="edit-task-from" placeholder="user" />
          </div>

          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Description</label>
            <textarea class="form-control" id="edit-task-description" rows="4" placeholder="Task description..."></textarea>
          </div>

        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="modern-btn modern-btn-primary" id="edit-task-save-btn" onclick="submitEditTask()">Save Changes</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Schedule Modal -->
  <div class="modal fade" id="editScheduleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"/>
            </svg>
            Edit Schedule
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <input type="hidden" id="edit-schedule-node-id" />
          <input type="hidden" id="edit-schedule-task-id" />

          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Enabled</label>
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="edit-schedule-enabled" checked>
              <label class="form-check-label" for="edit-schedule-enabled">Scheduler is enabled</label>
            </div>
          </div>

          <div class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Type</label>
            <select class="form-select" id="edit-schedule-type" onchange="updateEditScheduleInputs()">
              <option value="interval">Interval</option>
              <option value="once">Once</option>
              <option value="daily">Daily</option>
              <option value="weekly">Weekly</option>
              <option value="cron">Cron</option>
            </select>
          </div>

          <div id="edit-schedule-interval-fields" class="mb-3">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Every (minutes)</label>
            <input type="number" min="1" class="form-control" id="edit-schedule-interval-minutes" value="60">
            <div class="form-check mt-2">
              <input class="form-check-input" type="checkbox" id="edit-schedule-interval-run-once">
              <label class="form-check-label" for="edit-schedule-interval-run-once">Run once after delay</label>
            </div>
          </div>

          <div id="edit-schedule-once-fields" class="mb-3" style="display:none;">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Run at</label>
            <input type="datetime-local" class="form-control" id="edit-schedule-execute-at">
          </div>

          <div id="edit-schedule-daily-fields" class="mb-3" style="display:none;">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Time of day</label>
            <input type="time" class="form-control" id="edit-schedule-daily-time" value="09:00">
          </div>

          <div id="edit-schedule-weekly-fields" class="mb-3" style="display:none;">
            <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Day of week</label>
            <select class="form-select" id="edit-schedule-weekly-day">
              <option value="0">Sunday</option>
              <option value="1">Monday</option>
              <option value="2">Tuesday</option>
              <option value="3">Wednesday</option>
              <option value="4">Thursday</option>
              <option value="5">Friday</option>
              <option value="6">Saturday</option>
            </select>
            <label class="form-label mt-2" style="color: var(--text-primary); font-weight: 500;">Time</label>
            <input type="time" class="form-control" id="edit-schedule-weekly-time" value="09:00">
          </div>

          <div id="edit-schedule-cron-fields" class="mb-3" style="display:none;">
