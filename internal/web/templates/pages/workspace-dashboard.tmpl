{{define "workspace-dashboard"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light" data-workspace-id="{{.Extra.WorkspaceID}}">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">
        <!-- Header -->
        <div class="modern-card p-4 mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <div class="d-flex align-items-center gap-2 mb-2">
                <a href="/workspaces" class="modern-btn modern-btn-secondary btn-sm">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                  </svg>
                  Back to Workspaces
                </a>
              </div>
              <h2 class="mb-2" style="color: var(--text-primary);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8M5.5,18.25C5.5,16.18 8.41,14.5 12,14.5C15.59,14.5 18.5,16.18 18.5,18.25V20H5.5V18.25M0,20V18.5C0,17.11 1.89,15.94 4.45,15.6C3.86,16.28 3.5,17.22 3.5,18.25V20H0M24,20H20.5V18.25C20.5,17.22 20.14,16.28 19.55,15.6C22.11,15.94 24,17.11 24,18.5V20Z"/>
                </svg>
                <span id="workspace-name">Loading...</span>
              </h2>
              <p class="mb-0" style="color: var(--text-secondary);">
                <span class="me-3">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: text-bottom;">
                    <path d="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z"/>
                  </svg>
                  <span id="workspace-created">Created: --</span>
                </span>
                <span class="me-3">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: text-bottom;">
                    <path d="M12 2C6.48 2 2 6.48 2 12C2 17.52 6.48 22 12 22C17.52 22 22 17.52 22 12C22 6.48 17.52 2 12 2M12 20C7.59 20 4 16.41 4 12C4 7.59 7.59 4 12 4C16.41 4 20 7.59 20 12C20 16.41 16.41 20 12 20M13 12L16.28 14.54L15.5 15.67L12 13.1V7H13V12Z"/>
                  </svg>
                  <span id="workspace-updated">Updated: --</span>
                </span>
                <span id="workspace-status-badge"></span>
              </p>
            </div>
            <div class="d-flex gap-2">
              <button class="modern-btn modern-btn-secondary" onclick="openManageAgentsModal()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8Z"/>
                </svg>
                Manage Agents
              </button>
              <button class="modern-btn modern-btn-primary" id="view-canvas-btn" onclick="viewCanvas()">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
                </svg>
                View Canvas
              </button>
            </div>
          </div>
        </div>

        <!-- Dashboard Content -->
        <div class="row g-4">
          <!-- Left Column: Overview & Stats -->
          <div class="col-lg-8">
            <!-- Overview Card -->
            <div class="modern-card p-4 mb-4">
              <h4 class="mb-3" style="color: var(--text-primary);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M7,20H9V14H7V20M11,20H13V12H11V20M15,20H17V16H15V20Z"/>
                </svg>
                Workspace Overview
              </h4>
              <div class="row g-3">
                <div class="col-md-3">
                  <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(40,167,69,0.1); color: var(--success-color);">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value" id="tasks-completed">0</div>
                      <div class="stat-label">Completed</div>
                    </div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(0,123,255,0.1); color: var(--primary-color);">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12.5,7V13L16.25,15.15L15.55,16.5L11,13.75V7H12.5Z"/>
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value" id="tasks-in-progress">0</div>
                      <div class="stat-label">In Progress</div>
                    </div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(245,158,11,0.1); color: #f59e0b;">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value" id="tasks-scheduled">0</div>
                      <div class="stat-label">Scheduled</div>
                    </div>
                  </div>
                </div>
                <div class="col-md-3">
                  <div class="stat-card">
                    <div class="stat-icon" style="background: rgba(220,53,69,0.1); color: var(--danger-color);">
                      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M12,2C17.53,2 22,6.47 22,12C22,17.53 17.53,22 12,22C6.47,22 2,17.53 2,12C2,6.47 6.47,2 12,2M15.59,7L12,10.59L8.41,7L7,8.41L10.59,12L7,15.59L8.41,17L12,13.41L15.59,17L17,15.59L13.41,12L17,8.41L15.59,7Z"/>
                      </svg>
                    </div>
                    <div class="stat-info">
                      <div class="stat-value" id="tasks-failed">0</div>
                      <div class="stat-label">Failed</div>
                    </div>
                  </div>
                </div>
              </div>
            </div>

            <!-- Tasks List -->
            <div class="modern-card p-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 style="color: var(--text-primary); margin: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                    <path d="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M16,10V12H8V10H16M13,14V16H8V14H13Z"/>
                  </svg>
                  Tasks
                </h4>
                <div class="d-flex gap-2">
                  <button class="modern-btn modern-btn-primary btn-sm" onclick="openCreateTaskModal()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                    </svg>
                    New Task
                  </button>
                  <button class="modern-btn modern-btn-secondary btn-sm" onclick="refreshTasks()">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
                    </svg>
                    Refresh
                  </button>
                </div>
              </div>
              <div id="tasks-list">
                <div class="text-center py-3">
                  <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                  </div>
                  <p class="mt-2" style="color: var(--text-muted);">Loading tasks...</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Details & Actions -->
          <div class="col-lg-4">
            <!-- Workspace Details -->
            <div class="modern-card p-4 mb-4">
              <h4 class="mb-3" style="color: var(--text-primary);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M15,18V16H6V18H15M18,14V12H6V14H18Z"/>
                </svg>
                Details
              </h4>
              <div class="detail-row">
                <span class="detail-label">Workspace ID</span>
                <code id="workspace-id-display" class="detail-value">{{.Extra.WorkspaceID}}</code>
              </div>
              <div class="detail-row">
                <span class="detail-label">Description</span>
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <span id="workspace-description" class="detail-value" style="flex: 1;">--</span>
                  <button class="btn btn-sm p-1" onclick="openEditDescriptionModal()" title="Edit description" style="color: var(--text-muted); background: transparent; border: none;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M14.06,9L15,9.94L5.92,19H5V18.08L14.06,9M17.66,3C17.41,3 17.15,3.1 16.96,3.29L15.13,5.12L18.88,8.87L20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18.17,3.09 17.92,3 17.66,3M14.06,6.19L3,17.25V21H6.75L17.81,9.94L14.06,6.19Z"/>
                    </svg>
                  </button>
                </div>
              </div>
            </div>

            <!-- Sessions Card -->
            <div class="modern-card p-4 mb-4">
              <h4 class="mb-3" style="color: var(--text-primary);">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M12,3C17.5,3 22,6.58 22,11C22,15.42 17.5,19 12,19C10.76,19 9.57,18.82 8.47,18.5C5.55,21 2,21 2,21C4.33,18.67 4.7,17.1 4.75,16.5C3.05,15.07 2,13.13 2,11C2,6.58 6.5,3 12,3Z"/>
                </svg>
                Sessions
              </h4>
              <div id="sessions-list" style="max-height: 300px; overflow-y: auto;">
                <p style="color: var(--text-muted); font-size: 0.875rem;">Loading sessions...</p>
              </div>
            </div>

            <!-- Notes Card -->
            <div class="modern-card p-4 mb-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 style="color: var(--text-primary); margin: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                    <path d="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7M12,9H7V11H12V9M17,13H7V15H17V13M15,17H7V19H15V17Z"/>
                  </svg>
                  Notes
                </h4>
                <button class="modern-btn modern-btn-primary btn-sm" onclick="openCreateNoteModal()">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                  </svg>
                  New Note
                </button>
              </div>
              <div id="notes-list" style="max-height: 300px; overflow-y: auto;">
                <p style="color: var(--text-muted); font-size: 0.875rem;">Loading notes...</p>
              </div>
            </div>

            <!-- Attachments Card -->
            <div class="modern-card p-4 mb-4">
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 style="color: var(--text-primary); margin: 0;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                    <path d="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z"/>
                  </svg>
                  Attachments
                </h4>
                <button class="modern-btn modern-btn-primary btn-sm" onclick="openCreateAttachmentModal()">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                  </svg>
                  New
                </button>
              </div>
              <div id="attachments-list" style="max-height: 300px; overflow-y: auto;">
                <p style="color: var(--text-muted); font-size: 0.875rem;">Loading attachments...</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{template "modals.tmpl" .}}

  <!-- Manage Agents Modal -->
  <div class="modal fade" id="manageAgentsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg" style="margin-top: 80px;">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </svg>
            Create Agent
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">
          <!-- Create Agent Section -->
          <div class="mb-4">
            <h6 style="color: var(--text-primary);">Create New Agent</h6>
            <form id="createAgentForm" class="modern-card p-3">
              <!-- Config Mode Toggle -->
              <div class="mb-3">
                <div class="d-flex align-items-center gap-3">
                  <label class="form-label mb-0" style="color: var(--text-primary);">Configuration Mode</label>
                  <div class="btn-group" role="group" aria-label="Configuration mode toggle">
                    <input type="radio" class="btn-check" name="wsDashConfigMode" id="wsDashConfigModeManual" value="manual" checked>
                    <label class="btn btn-outline-secondary btn-sm" for="wsDashConfigModeManual">Manual</label>
                    <input type="radio" class="btn-check" name="wsDashConfigMode" id="wsDashConfigModeAuto" value="auto">
                    <label class="btn btn-outline-secondary btn-sm" for="wsDashConfigModeAuto">
                      <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                        <path d="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"/>
                      </svg>
                      Auto
                    </label>
                  </div>
                  <span id="wsDashAutoConfigStatus" class="badge bg-secondary d-none" style="font-size: 0.7rem;"></span>
                </div>
                <small id="wsDashConfigModeHelp" class="text-muted d-none mt-1">Describe what you want this agent to do, and we'll configure it automatically.</small>
              </div>

              <!-- Auto-config Description (shown when Auto mode selected) -->
              <div id="wsDashAutoConfigSection" class="mb-3 d-none">
                <label class="form-label" style="color: var(--text-primary);">Describe Your Agent</label>
                <textarea id="wsDashAutoConfigDescription" class="form-control" rows="3"
                          style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                          placeholder="Example: An agent that helps with file management tasks like organizing documents, searching for files, and creating backups..."></textarea>
                <div class="d-flex justify-content-between align-items-center mt-2">
                  <small class="text-muted">Tip: Be specific about the tasks and tools this agent should use.</small>
                  <button type="button" id="wsDashGenerateAutoConfigBtn" class="btn btn-sm btn-outline-primary">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M12,3L2,12H5V20H19V12H22L12,3M12,8.75A2.25,2.25 0 0,1 14.25,11A2.25,2.25 0 0,1 12,13.25A2.25,2.25 0 0,1 9.75,11A2.25,2.25 0 0,1 12,8.75Z"/>
                    </svg>
                    Generate Config
                  </button>
                </div>
              </div>

              <!-- LLM Not Available Warning -->
              <div id="wsDashLlmNotAvailableWarning" class="alert alert-warning d-none mb-3" style="font-size: 0.875rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
                  <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
                </svg>
                <span id="wsDashLlmWarningMessage">Auto-config requires an LLM provider. Please set up an API key or install Ollama in Settings.</span>
                <a href="/settings" class="alert-link ms-1">Go to Settings</a>
              </div>

              <!-- Auto-selected Indicator -->
              <div id="wsDashAutoSelectedIndicator" class="alert alert-info d-none mb-3" style="font-size: 0.875rem; padding: 0.5rem 1rem;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
                  <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
                </svg>
                <strong>Auto-configured</strong> - Settings below were selected based on your description. You can still adjust them manually.
              </div>

              <div class="row">
                <div class="col-md-6 mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Agent Name</label>
                  <input type="text" id="new-agent-name" class="modern-input w-100" placeholder="Enter agent name..." required>
                </div>
                <div class="col-md-6 mb-3">
                  <label class="form-label" style="color: var(--text-primary);">Agent Type</label>
                  <select id="new-agent-type" class="modern-input w-100">
