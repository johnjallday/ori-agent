{{define "workspaces"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light home-hub workspace-page">
  <!-- Toast Notification Container -->
  <div id="toastContainer" class="toast-container" aria-live="polite" aria-atomic="true"></div>

  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <main class="main-content" role="main" aria-label="Workspace hub">
      {{template "workspace-hub.tmpl" .}}
    </main>
  </div>

  {{template "session-modals.tmpl" .}}
  {{template "chat-area.tmpl" .}}

  <!-- Add Agent Modal -->
  <div class="modal fade" id="addAgentModal" tabindex="-1" aria-labelledby="addAgentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" id="addAgentModalLabel" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1L13.5 2.5L16.17 5.17L11.83 9.51C11.25 9.19 10.61 9 10 9C8.61 9 7.22 9.39 6 10.17L3 7.17L1.59 8.59L4.17 11.17C3.39 12.39 3 13.78 3 15.17C3 16.56 3.39 17.94 4.17 19.17L1.59 21.75L3 23.16L6 20.16C7.22 20.94 8.61 21.33 10 21.33C10.61 21.33 11.25 21.13 11.83 20.82L16.17 16.48L13.5 19.15L15 20.65L21 14.65V12.65L17.83 15.82L12.41 10.41C12.61 10.25 12.8 10.08 13 9.83L17.83 5L21 8.17V9Z"/>
            </svg>
            Create New Agent
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
        </div>
        <div class="modal-body">
          <form id="addAgentForm">
            <div class="mb-3">
              <div class="d-flex align-items-center gap-3">
                <label class="form-label mb-0" style="color: var(--text-primary);">Configuration Mode</label>
                <div class="btn-group" role="group" aria-label="Configuration mode toggle">
                  <input type="radio" class="btn-check" name="baseConfigMode" id="baseConfigModeManual" value="manual" checked>
                  <label class="btn btn-outline-secondary btn-sm" for="baseConfigModeManual">Manual</label>
                  <input type="radio" class="btn-check" name="baseConfigMode" id="baseConfigModeAuto" value="auto">
                  <label class="btn btn-outline-secondary btn-sm" for="baseConfigModeAuto">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"/>
                    </svg>
                    Auto
                  </label>
                </div>
                <span id="baseAutoConfigStatus" class="badge bg-secondary d-none" style="font-size: 0.7rem;"></span>
              </div>
              <small id="baseConfigModeHelp" class="text-muted d-none mt-1">Describe what you want this agent to do, and we'll configure it automatically.</small>
            </div>
            <div id="baseAutoConfigSection" class="mb-3 d-none">
              <label class="form-label" style="color: var(--text-primary);">Describe Your Agent</label>
              <textarea id="baseAutoConfigDescription" class="form-control" rows="3"
                        style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                        placeholder="Example: An agent that helps with file management tasks like organizing documents, searching for files, and creating backups..."></textarea>
              <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">Tip: Be specific about the tasks and tools this agent should use.</small>
                <button type="button" id="baseGenerateAutoConfigBtn" class="btn btn-sm btn-outline-primary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M12,3L2,12H5V20H19V12H22L12,3M12,8.75A2.25,2.25 0 0,1 14.25,11A2.25,2.25 0 0,1 12,13.25A2.25,2.25 0 0,1 9.75,11A2.25,2.25 0 0,1 12,8.75Z"/>
                  </svg>
                  Generate Config
                </button>
              </div>
            </div>
            <div id="baseLlmNotAvailableWarning" class="alert alert-warning d-none mb-3" style="font-size: 0.875rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
                <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
              </svg>
              <span id="baseLlmWarningMessage">Auto-config requires an LLM provider. Please set up an API key or install Ollama in Settings.</span>
              <a href="/settings" class="alert-link ms-1">Go to Settings</a>
            </div>
            <div id="baseAutoSelectedIndicator" class="alert alert-info d-none mb-3" style="font-size: 0.875rem; padding: 0.5rem 1rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
                <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
              </svg>
              <strong>Auto-configured</strong> - Settings below were selected based on your description. You can still adjust them manually.
            </div>
            <div class="mb-3">
              <label for="agentName" class="form-label required" style="color: var(--text-primary);">Agent Name</label>
              <input type="text" id="agentName" class="modern-input w-100" placeholder="Enter agent name..." required minlength="2" maxlength="50" aria-describedby="agentNameHelp">
              <small id="agentNameHelp" class="form-helper">Use letters, numbers, and hyphens. 2-50 characters.</small>
            </div>
            <div class="mb-3">
              <label for="agentType" class="form-label" style="color: var(--text-primary);">Agent Type</label>
              <select id="agentType" class="modern-input w-100">
                <option value="tool-calling">Tool Calling (Cheapest - Optimized for tool use)</option>
                <option value="general">General Purpose (Mid-tier - Balanced capability)</option>
                <option value="orchestration">Orchestration (Advanced - Multi-agent coordination)</option>
                <option value="research">Research (Expensive - Complex thinking)</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="agentModel" class="form-label" style="color: var(--text-primary);">Model</label>
              <select id="agentModel" class="modern-input w-100">
                <option value="">Loading models...</option>
              </select>
            </div>
            <div class="mb-3">
              <label for="agentTemperature" class="form-label" style="color: var(--text-primary);">
                Temperature: <span id="temperatureValue">1.0</span>
              </label>
              <input type="range" id="agentTemperature" class="form-range" min="0" max="2" step="0.1" value="1.0"
                     style="cursor: pointer;" aria-describedby="temperatureHelp" aria-valuemin="0" aria-valuemax="2" aria-valuenow="1.0">
              <div id="temperatureHelp" class="d-flex justify-content-between" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 500;">
                <span>Focused (0)</span>
                <span>Balanced (1)</span>
                <span>Creative (2)</span>
              </div>
            </div>
            <div class="mb-3">
              <label for="agentSystemPrompt" class="form-label" style="color: var(--text-primary);">System Prompt</label>
              <textarea id="agentSystemPrompt" class="form-control" rows="4" maxlength="4000"
                        style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                        placeholder="Example: You are a helpful assistant with access to various tools..."
                        data-char-counter="true"></textarea>
              <small class="form-helper">Define the agent's behavior, personality, and instructions. Max 4000 characters.</small>
            </div>
          </form>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="createAgentBtn" class="modern-btn modern-btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </svg>
            Create Agent
          </button>
        </div>
      </div>
    </div>
  </div>

  {{template "modals.tmpl" .}}

  <!-- File Manager Modals -->
  {{template "file_preview_dialog"}}
  {{template "file_delete_dialog"}}
  {{template "file_relink_dialog"}}

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/ethers@6/dist/ethers.umd.min.js"></script>
  <!-- Theme Manager - must load before other modules -->
  <script src="/js/modules/themeManager.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>
  <!-- DX Utilities -->
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/utils/dom-utils.js"></script>
  <!-- Sidebar modules -->
  <script src="/js/modules/resizer.js"></script>
  <script src="/js/modules/settings.js"></script>
  <script src="/js/modules/agents.js"></script>
  <script src="/js/modules/plugins.js"></script>
  <script src="/js/modules/plugin-config.js"></script>
  <script src="/js/modules/plugin-store.js"></script>
  <script src="/js/modules/apikey.js"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/modules/plugin-health.js"></script>
  <script src="/js/modules/file-upload.js"></script>
  <script src="/js/modules/location.js"></script>
  <script src="/js/modules/task-modal-controller.js"></script>
  <script src="/js/modules/sessions.js"></script>
  <script src="/js/modules/toast.js"></script>
  <script src="/js/modules/voice-input.js"></script>
  <script src="/js/modules/form-validation.js"></script>
  <script src="/js/file-manager.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/modules/studio-realtime.js"></script>
  <!-- Workspace Hub modules -->
  <script src="/js/modules/workspace-hub-utils.js"></script>
  <script src="/js/modules/workspace-hub-state.js"></script>
  <script src="/js/modules/workspace-hub-modals.js"></script>
  <script src="/js/modules/workspace-hub-selection.js"></script>
  <script src="/js/modules/workspace-hub-tasks.js"></script>
  <script src="/js/modules/workspace-hub-sessions.js"></script>
  <script src="/js/modules/workspace-hub-notes.js"></script>
  <script src="/js/modules/workspace-hub-files.js"></script>
  <script src="/js/modules/workspace-hub-smart-input.js"></script>
  <script src="/js/modules/workspace-hub-panels.js"></script>
  <script src="/js/modules/workspace-hub.js"></script>
  <script src="/js/modules/workspace-hub-board.js"></script>
</body>
</html>
{{end}}
