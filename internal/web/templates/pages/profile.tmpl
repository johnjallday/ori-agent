{{define "profile"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light settings-page profile-page">
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <div class="main-content">
      <div class="container-fluid profile-page-shell py-4">
        <header class="profile-page-header">
          <div>
            <div class="profile-page-kicker">Profile</div>
            <h1 class="profile-page-title">About You</h1>
          </div>
          <a href="/settings#user-profile" class="modern-btn modern-btn-secondary profile-page-settings-link">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
            </svg>
            Settings
          </a>
        </header>

        <div class="profile-page-grid">
          <section class="settings-section modern-card p-4 profile-page-editor" aria-labelledby="profileEditorTitle">
            <div class="settings-section-header">
              <span class="settings-section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"/>
                </svg>
              </span>
              <h2 id="profileEditorTitle" class="settings-section-title">Profile Details</h2>
            </div>

            {{template "user-profile-form.tmpl" .}}
          </section>

          <aside class="profile-page-aside" aria-label="Profile context">
            <section class="settings-section modern-card p-4 profile-page-context">
              <div class="settings-section-header">
                <span class="settings-section-icon">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M9,5V9H21V5M9,19H21V15H9M9,14H21V10H9M4,9H8V5H4M4,19H8V15H4M4,14H8V10H4V14Z"/>
                  </svg>
                </span>
                <h2 class="settings-section-title">Context</h2>
              </div>
              <div class="profile-context-list">
                <div class="profile-context-row">
                  <span class="profile-context-label">Identity</span>
                  <span class="profile-context-value">User managed</span>
                </div>
                <div class="profile-context-row">
                  <span class="profile-context-label">About You</span>
                  <span class="profile-context-value">Included in workspace context</span>
                </div>
                <div class="profile-context-row">
                  <span class="profile-context-label">Sensitive data</span>
                  <span class="profile-context-value">Use Vaults</span>
                </div>
              </div>
            </section>
          </aside>
        </div>

        <!-- Personalization: interests, tools, work style. Folded in from the
             retired /personalize page so all "about you" data lives here.
             Saved via /api/onboarding/personalize (personalize.js), which sets
             the profile's PersonalizedAt and completes the onboarding quest. -->
        <div class="profile-personalize" id="personalization">
          <header class="profile-personalize-header">
            <div class="profile-page-kicker">Personalization</div>
            <h2 class="profile-page-title">How you work</h2>
            <p class="profile-personalize-subtitle">Tell Ori your interests, tools, and work style so it tailors its help to you.</p>
          </header>

          <!-- Existing Profile Summary (read-only) -->
          <div id="personalizeProfileSummary" class="modern-card p-4 mb-4 d-none">
            <h5 class="mb-3" style="color: var(--text-primary);">Detected Profile</h5>
            <div class="d-flex align-items-center gap-3">
              <div id="personalizeProfileBadge" class="px-3 py-2" style="background: var(--primary-color); color: white; border-radius: var(--radius-md); font-weight: 600;"></div>
              <p id="personalizeProfileText" class="mb-0" style="color: var(--text-secondary);"></p>
            </div>
          </div>

          <!-- Interests -->
          <div class="modern-card p-4 mb-4">
            <h5 class="mb-2" style="color: var(--text-primary);">Interests</h5>
            <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">Select topics you're interested in. This helps Ori recommend relevant tools and content.</p>
            <div id="interestsGrid" class="d-flex flex-wrap gap-2"></div>
          </div>

          <!-- Preferred Tools -->
          <div class="modern-card p-4 mb-4">
            <h5 class="mb-2" style="color: var(--text-primary);">Preferred Tools</h5>
            <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">Select your favorite tools and technologies.</p>
            <div id="toolsGrid" class="d-flex flex-wrap gap-2 mb-3"></div>
            <div class="d-flex gap-2 align-items-center">
              <input type="text" id="customToolInput" class="form-control form-control-sm" placeholder="Add custom tool..." style="max-width: 200px; background: var(--bg-secondary); border-color: var(--border-color); color: var(--text-primary);">
              <button id="addCustomToolBtn" class="modern-btn modern-btn-secondary" style="font-size: 0.85rem; padding: 0.35rem 0.75rem;">Add</button>
            </div>
          </div>

          <!-- Work Style -->
          <div class="modern-card p-4 mb-4">
            <h5 class="mb-2" style="color: var(--text-primary);">Work Style</h5>
            <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">How do you prefer Ori to communicate?</p>
            <div id="workStyleGrid" class="row g-3"></div>
          </div>

          <!-- Self Description -->
          <div class="modern-card p-4 mb-4">
            <h5 class="mb-2" style="color: var(--text-primary);">About You (Optional)</h5>
            <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">Briefly describe what you do or what you'd like help with.</p>
            <textarea id="personalizeDescription" class="form-control" rows="3" placeholder="e.g., I'm a backend developer working mostly in Go and Python, focused on building APIs and microservices..." style="background: var(--bg-secondary); border-color: var(--border-color); color: var(--text-primary);"></textarea>
          </div>

          <!-- App Detection -->
          <div class="modern-card p-4 mb-4">
            <h5 class="mb-2" style="color: var(--text-primary);">App Detection</h5>
            <p class="mb-3" style="color: var(--text-secondary); font-size: 0.9rem;">Scan your system for installed development tools to enhance your profile.</p>
            <button id="detectAppsBtn" class="modern-btn modern-btn-secondary">Detect Installed Apps</button>
            <div id="detectedAppsList" class="mt-3 d-none">
              <label class="mb-2" style="color: var(--text-secondary); font-size: 0.85rem;">Detected apps:</label>
              <div id="detectedAppsContainer" class="d-flex flex-wrap gap-1"></div>
            </div>
          </div>

          <!-- Save -->
          <div class="modern-card p-4">
            <div class="d-flex justify-content-between align-items-center">
              <div id="saveStatusText" style="color: var(--text-secondary); font-size: 0.9rem;"></div>
              <button id="savePersonalizeBtn" class="modern-btn modern-btn-primary">
                <span id="saveBtnText">Save personalization</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Personalization toast -->
  <div class="position-fixed bottom-0 end-0 p-3" style="z-index: 11">
    <div id="personalizeToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
      <div class="toast-header" style="background: var(--bg-secondary); color: var(--text-primary);">
        <strong class="me-auto">Personalization</strong>
        <button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
      <div id="personalizeToastBody" class="toast-body" style="background: var(--bg-primary); color: var(--text-primary);"></div>
    </div>
  </div>

  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/app.js?v=1694538177"></script>
  <script defer src="/js/modules/sidebar.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  <script defer src="/js/modules/toast.js"></script>
  {{template "theme-init.tmpl" .}}
  <script defer src="/js/modules/user-profile.js"></script>
  <script defer src="/js/modules/personalize.js"></script>
</body>
</html>
{{end}}
