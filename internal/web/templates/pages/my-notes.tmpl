<div class="my-notes" data-my-notes>
  <header class="my-notes-heading">
    <a href="/" class="my-notes-home"><i class="bi bi-arrow-left" aria-hidden="true"></i> Home</a>
    <p class="my-notes-kicker">PERSONAL NOTEBOOK</p>
    <h1 id="my-notes-title" tabindex="-1">My Notes</h1>
    <p>Your notes folder, separate from the documents in each workspace.</p>
  </header>
  <section class="my-notes-sheet" aria-label="Notebook">
    <div data-my-notes-status aria-busy="true"><p role="status">Checking your notes connection…</p></div>
    <div data-my-notes-tools hidden></div>
  </section>
</div>
