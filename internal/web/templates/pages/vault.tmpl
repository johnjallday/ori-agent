{{define "vault"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light vault-page-body">
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <div class="main-content">
      <div class="container-fluid vault-page-container">
        <section class="vault-page-hero modern-card">
          <div class="vault-page-hero-copy">
            <div class="vault-page-hero-kicker">Encrypted local storage</div>
            <h1 class="vault-page-hero-title">Private Vault</h1>
            <p class="vault-page-hero-subtitle">
              Manage named vaults, passwords, saved records, grants, and encrypted transfers in one dedicated workspace. The quick vault modal stays focused on browsing, while this page handles the heavier administrative flow.
            </p>
            <div class="vault-page-hero-chips" aria-label="Vault properties">
              <span class="vault-page-hero-chip">Local-only encryption</span>
              <span class="vault-page-hero-chip">Named vault isolation</span>
              <span class="vault-page-hero-chip">Grant-based workspace access</span>
            </div>
          </div>

          <div class="vault-page-hero-actions">
            <a href="/settings" class="modern-btn modern-btn-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true">
                  <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                </svg>
                Back To Settings
            </a>
            <button id="vaultHeroCreateDialogBtn" type="button" class="modern-btn modern-btn-secondary">
              Create New Vault
            </button>
            <button type="button" class="modern-btn modern-btn-primary" data-bs-toggle="modal" data-bs-target="#vaultModal" aria-controls="vaultModal">
              Open Quick Vault
            </button>
          </div>
        </section>

        {{template "vault-settings-section.tmpl" .}}
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/utils/dom-utils.js"></script>
  <script src="/js/app.js?v=1694538177"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/modules/themeManager.js"></script>
  <script src="/js/modules/toast.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>
  <script src="/js/modules/vault-page.js"></script>
</body>
</html>
{{end}}
