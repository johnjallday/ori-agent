{{define "vault"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <div class="main-content">
      <div class="container-fluid py-4">
        <div class="modern-card p-4 mb-4" style="border: 1px solid rgba(173, 129, 84, 0.24); background: radial-gradient(circle at top right, rgba(255, 220, 182, 0.16), transparent 32%), linear-gradient(180deg, rgba(255, 251, 244, 0.94), rgba(245, 236, 222, 0.96));">
          <div class="d-flex flex-wrap justify-content-between align-items-start gap-3">
            <div style="max-width: 52rem;">
              <div class="vault-modal-section-kicker">Encrypted local storage</div>
              <h1 class="mb-2" style="color: var(--text-primary); font-size: clamp(2rem, 3vw, 2.65rem);">Vault Settings</h1>
              <p class="mb-0" style="color: var(--text-secondary); font-size: 1rem; line-height: 1.65;">
                Manage named vaults, passwords, saved records, grants, and exports in one dedicated workspace. The quick vault modal stays focused on browsing, while this page handles the heavier administrative flow.
              </p>
            </div>

            <div class="d-flex flex-wrap gap-2">
              <a href="/settings" class="modern-btn modern-btn-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true">
                  <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                </svg>
                Back To Settings
              </a>
              <button type="button" class="modern-btn modern-btn-primary" data-bs-toggle="modal" data-bs-target="#vaultModal" aria-controls="vaultModal">
                Open Quick Vault
              </button>
            </div>
          </div>
        </div>

        {{template "vault-settings-section.tmpl" .}}
      </div>
    </div>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/utils/logger.js"></script>
  <script src="/js/utils/event-bus.js"></script>
  <script src="/js/utils/api-client.js"></script>
  <script src="/js/utils/dom-utils.js"></script>
  <script src="/js/app.js?v=1694538177"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/modules/themeManager.js"></script>
  <script src="/js/modules/toast.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      themeManager.initialize();
    });
  </script>
  <script src="/js/modules/settings-page.js"></script>
</body>
</html>
{{end}}
