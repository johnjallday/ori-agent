{{define "usage"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}
<body class="bg-light usage-page">
  {{template "navbar.tmpl" .}}
  <style>
    .usage-page .main-content-wrapper { background: var(--bg-primary); }
    #usagePage { color: var(--text-primary); }
    .usage-details-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-6); }
    .usage-details-grid > section { min-width: 0; }
    .usage-section { margin-bottom: var(--space-6); }
    .usage-section h2 { font-family: var(--font-body); font-size: 1.125rem; font-weight: 600; margin-bottom: var(--space-4); }
    .usage-summary dl { margin: 0; }
    .usage-summary dt { color: var(--text-secondary); font-size: 0.875rem; font-weight: 400; }
    .usage-summary dd { margin: 0; }
    .usage-summary .usage-cost { margin-bottom: var(--space-4); }
    .usage-stat-row, .usage-breakdown-row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2); }
    .usage-stat-row { margin-top: var(--space-2); }
    .usage-breakdown-row { padding-block: var(--space-3); border-bottom: 1px solid var(--border-color); }
    .usage-breakdown-row > div { min-width: 0; max-width: 100%; overflow-wrap: anywhere; }
    .usage-breakdown-row:last-child { border-bottom: 0; }
    .usage-breakdown-row small { display: block; color: var(--text-secondary); }
    .usage-breakdown-row .usage-cost { color: var(--success-text); }
    #usagePage .ui-data-table table { min-width: 42rem; table-layout: fixed; }
    #usagePage .ui-data-table th:first-child { width: 30%; }
    #usageFeedback { margin-bottom: var(--space-4); }
    @media (max-width: 767px) { .usage-details-grid { grid-template-columns: 1fr; } }
  </style>
  <div class="main-content-wrapper">
    <main class="main-content">
      <div class="container-fluid py-4" id="usagePage">
        <header class="ui-page-header">
          <div><h1>Usage &amp; Costs</h1><p>Monitor API usage and costs across providers.</p></div>
          <div class="ui-page-actions"><button type="button" class="modern-btn modern-btn-secondary" id="usageRefreshBtn" onclick="refreshUsageData()">Refresh</button></div>
        </header>
        <div id="usageFeedback" class="ui-field-error" role="alert" hidden></div>
        <div class="ui-metric-grid usage-summary">
          <section class="ui-section ui-metric" aria-labelledby="usageTodayTitle"><h2 id="usageTodayTitle">Today</h2><div id="todayStats" role="status">Loading…</div></section>
          <section class="ui-section ui-metric" aria-labelledby="usageMonthTitle"><h2 id="usageMonthTitle">This month</h2><div id="monthStats" role="status">Loading…</div></section>
          <section class="ui-section ui-metric" aria-labelledby="usageAllTimeTitle"><h2 id="usageAllTimeTitle">All time</h2><div id="allTimeStats" role="status">Loading…</div></section>
        </div>
        <p id="usageEmpty" class="text-muted" hidden>No usage data available. Provider, agent and model breakdowns appear after recorded API usage.</p>
        <div id="usageDetails">
          <div class="usage-details-grid">
            <section class="usage-section" aria-labelledby="usageProviderTitle"><h2 id="usageProviderTitle">By provider</h2><div id="providerStats">Loading…</div></section>
            <section class="usage-section" aria-labelledby="usageAgentTitle"><h2 id="usageAgentTitle">By agent</h2><div id="agentStats">Loading…</div></section>
          </div>
          <section class="usage-section" aria-labelledby="usageModelTitle"><h2 id="usageModelTitle">By model</h2><div id="modelStats">Loading…</div></section>
        </div>
      </div>
    </main>
  </div>
  {{template "modals.tmpl" .}}
  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/app.js"></script>
  <script defer src="/js/modules/agents.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  <script>
    let usageData = null;
    let usageLoading = false;
    const usageNumber = value => Number.isFinite(Number(value)) ? Number(value) : 0;
    const usageCount = value => usageNumber(value).toLocaleString();
    const usageCost = value => '$' + usageNumber(value).toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });

    async function loadUsageData() {
      try {
        const response = await fetch('/api/usage/summary');
        if (!response.ok) throw new Error('Failed to load usage summary.');
        usageData = await response.json();
        if (!usageData.today || !usageData.this_month || !usageData.all_time) throw new Error('Usage summary is unavailable.');
        renderUsageData();
      } catch (error) {
        usageData = null;
        for (const id of ['todayStats', 'monthStats', 'allTimeStats']) document.getElementById(id).textContent = 'Unavailable';
        throw error;
      }
    }
    function renderUsageData() {
      if (!usageData) return;
      renderSummaryCard('todayStats', usageData.today);
      renderSummaryCard('monthStats', usageData.this_month);
      renderSummaryCard('allTimeStats', usageData.all_time);
    }
    function renderSummaryCard(elementId, data) {
      const element = document.getElementById(elementId);
      if (!element || !data) return;
      element.innerHTML = `<dl>
        <div class="usage-cost"><dt>Cost</dt><dd class="ui-metric-value ui-number">${usageCost(data.cost)}</dd></div>
        <div class="usage-stat-row"><dt>Requests</dt><dd class="ui-number">${usageCount(data.requests)}</dd></div>
        <div class="usage-stat-row"><dt>Tokens</dt><dd class="ui-number">${usageCount(data.tokens)}</dd></div>
      </dl>`;
    }
    async function loadDetailedStats() {
      try {
        const response = await fetch('/api/usage/stats/all');
        if (!response.ok) throw new Error('Failed to load usage breakdowns.');
        const data = await response.json();
        const providers = data.by_provider || {};
        const agents = data.by_agent || {};
        const models = data.by_model || {};
        if ([providers, agents, models].some(group => typeof group !== 'object' || Array.isArray(group))) throw new Error('Usage breakdowns are unavailable.');
        renderProviderStats(providers);
        renderAgentStats(agents);
        renderModelStats(models);
        const empty = [providers, agents, models].every(group => Object.keys(group).length === 0);
        document.getElementById('usageEmpty').hidden = !empty;
        document.getElementById('usageDetails').hidden = empty;
      } catch (error) {
        document.getElementById('usageEmpty').hidden = true;
        document.getElementById('usageDetails').hidden = false;
        for (const id of ['providerStats', 'agentStats', 'modelStats']) document.getElementById(id).textContent = 'Unavailable';
        throw error;
      }
    }
    function renderUsageBreakdown(elementId, entries, nameField, fallback) {
      const element = document.getElementById(elementId);
      if (!element) return;
      const values = Object.values(entries);
      if (!values.length) { element.innerHTML = '<p class="text-muted">No usage data available</p>'; return; }
      element.innerHTML = values.map(stats => `<div class="usage-breakdown-row">
        <div><strong>${escapeHtml(String(stats[nameField] || fallback))}</strong><small class="ui-number">${usageCount(stats.requests)} requests</small></div>
        <div class="text-end"><div class="ui-number">${usageCount(stats.total_tokens)} tokens</div><small class="ui-number usage-cost">${usageCost(stats.total_cost)}</small></div>
      </div>`).join('');
    }
    function renderProviderStats(providers) { renderUsageBreakdown('providerStats', providers, 'provider', 'Unknown'); }
    function renderAgentStats(agents) { renderUsageBreakdown('agentStats', agents, 'agent_name', 'Unknown'); }
    function renderModelStats(models) {
      const element = document.getElementById('modelStats');
      if (!element) return;
      const values = Object.values(models).sort((a, b) => usageNumber(b.total_cost) - usageNumber(a.total_cost));
      if (!values.length) { element.innerHTML = '<p class="text-muted">No usage data available</p>'; return; }
      element.innerHTML = `<div class="ui-data-table" role="region" aria-label="Usage by model" tabindex="0"><table class="table">
        <caption class="visually-hidden">All-time model usage, highest cost first</caption>
        <thead><tr><th scope="col">Model</th><th scope="col">Provider</th><th scope="col" class="text-end">Requests</th><th scope="col" class="text-end">Tokens</th><th scope="col" class="text-end">Cost</th></tr></thead>
        <tbody>${values.map(stats => `<tr><th scope="row">${escapeHtml(String(stats.model || 'Unknown'))}</th><td><span class="badge">${escapeHtml(String(stats.provider || 'Unknown'))}</span></td><td class="ui-number text-end">${usageCount(stats.requests)}</td><td class="ui-number text-end">${usageCount(stats.total_tokens)}</td><td class="ui-number text-end">${usageCost(stats.total_cost)}</td></tr>`).join('')}</tbody>
      </table></div>`;
    }
    async function refreshUsageData() {
      if (usageLoading) return;
      usageLoading = true;
      const refresh = document.getElementById('usageRefreshBtn');
      refresh.disabled = true;
      refresh.setAttribute('aria-busy', 'true');
      document.getElementById('usageFeedback').hidden = true;
      try {
        const results = await Promise.allSettled([loadUsageData(), loadDetailedStats()]);
        const errors = results.filter(result => result.status === 'rejected').map(result => result.reason.message);
        if (errors.length) showError(errors.join(' ') + ' Use Refresh to try again.');
      } finally {
        usageLoading = false;
        refresh.disabled = false;
        refresh.removeAttribute('aria-busy');
      }
    }
    function showError(message) {
      const feedback = document.getElementById('usageFeedback');
      feedback.textContent = message;
      feedback.hidden = false;
    }
    document.addEventListener('DOMContentLoaded', function() {
      refreshUsageData();
      themeManager.initialize();
    });
  </script>
</body>
</html>
{{end}}
