{{define "workflows"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light">
  <!-- Navigation -->
  {{template "navbar.tmpl" .}}

  <div class="main-content-wrapper">
    {{template "sidebar.tmpl" .}}

    <!-- Main Content -->
    <div class="main-content">
      <div class="container-fluid py-4">
        <div class="modern-card p-4 mb-4">
          <div class="d-flex justify-content-between align-items-center">
            <div>
              <h2 class="mb-2" style="color: var(--text-primary);">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="vertical-align: text-bottom;">
                  <path d="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12C10.34,12 9,13.34 9,15C9,16.66 10.34,18 12,18C13.66,18 15,16.66 15,15C15,13.34 13.66,12 12,12M6,6H15V10H6V6Z"/>
                </svg>
                My Workflows
              </h2>
              <p class="mb-0" style="color: var(--text-secondary);">Custom workflow templates saved from studio canvas selections.</p>
            </div>
            <div class="d-flex gap-2">
              <select id="category-filter" class="form-select form-select-sm" style="width: auto;" onchange="filterWorkflows()">
                <option value="">All Categories</option>
              </select>
              <input type="text" id="search-input" class="form-control form-control-sm" placeholder="Search workflows..." style="width: 200px;" oninput="filterWorkflows()">
              <a href="/studios" class="modern-btn modern-btn-primary">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M20.71,4.63L19.37,3.29C19,2.9 18.35,2.9 17.96,3.29L9,12.25L11.75,15L20.71,6.04C21.1,5.65 21.1,5 20.71,4.63M7,14A3,3 0 0,0 4,17C4,18.31 2.84,19 2,19C2.92,20.22 4.5,21 6,21A4,4 0 0,0 10,17A3,3 0 0,0 7,14Z"/>
                </svg>
                Design Workflow
              </a>
            </div>
          </div>
        </div>

        <!-- Workflows Grid -->
        <div id="workflows-grid" class="row g-4">
          <div class="col-12 text-center py-5">
            <div class="spinner-border text-primary" role="status">
              <span class="visually-hidden">Loading...</span>
            </div>
            <p class="mt-3" style="color: var(--text-muted);">Loading workflows...</p>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Studio Selector Modal -->
  <div class="modal fade" id="studioSelectorModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </svg>
            Add Workflow to Studio
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p style="color: var(--text-secondary);">Select a studio to add this workflow to:</p>
          <div id="studio-list" style="max-height: 300px; overflow-y: auto;">
            <div class="text-center py-3">
              <div class="spinner-border spinner-border-sm text-primary" role="status">
                <span class="visually-hidden">Loading...</span>
              </div>
            </div>
          </div>
          <div id="missing-agents-warning" class="alert alert-warning mt-3" style="display: none;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M12,2L1,21H23M12,6L19.53,19H4.47M11,10V14H13V10M11,16V18H13V16"/>
            </svg>
            <span id="missing-agents-text"></span>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="addToStudioBtn" class="modern-btn modern-btn-primary" disabled>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </svg>
            Add to Studio
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Workflow Details Modal -->
  <div class="modal fade" id="workflowDetailsModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12C10.34,12 9,13.34 9,15C9,16.66 10.34,18 12,18C13.66,18 15,16.66 15,15C15,13.34 13.66,12 12,12M6,6H15V10H6V6Z"/>
            </svg>
            <span id="details-workflow-name">Workflow Details</span>
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div id="workflow-details-content"></div>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Close</button>
          <button type="button" id="detailsAddToStudioBtn" class="modern-btn modern-btn-primary">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </svg>
            Add to Studio
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Confirmation Modal -->
  <div class="modal fade" id="deleteWorkflowModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2" style="color: var(--danger-color);">
              <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
            </svg>
            Delete Workflow
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p style="color: var(--text-secondary);">Are you sure you want to delete this workflow?</p>
          <div class="modern-card p-3" style="background: var(--bg-secondary);">
            <strong id="delete-workflow-name" style="color: var(--text-primary);"></strong>
            <p id="delete-workflow-desc" class="mb-0 mt-1 small" style="color: var(--text-muted);"></p>
          </div>
          <p class="mt-3 mb-0 text-danger small">This action cannot be undone.</p>
        </div>
        <div class="modal-footer">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="confirmDeleteBtn" class="modern-btn" style="background: var(--danger-color); color: white;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
            </svg>
            Delete
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Scripts -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/js/app.js"></script>
  <script src="/js/modules/sidebar.js"></script>
  <script src="/js/modules/themeManager.js"></script>

  <script>
    let allWorkflows = [];
    let selectedStudioId = null;
    let selectedWorkflow = null;
    let workflowToDelete = null;

    // Load workflows on page load
    document.addEventListener('DOMContentLoaded', function() {
      loadWorkflows();
      themeManager.initialize();
    });

    async function loadWorkflows() {
      try {
        const response = await fetch('/api/workflows');
        const data = await response.json();

        // Filter to only custom workflows
        allWorkflows = (data.workflows || []).filter(w => w.source === 'custom');

        // Update category filter
        updateCategoryFilter();

        // Render workflows
        renderWorkflows(allWorkflows);

      } catch (error) {
        console.error('Error loading workflows:', error);
        showError('Failed to load workflows');
      }
    }

    function updateCategoryFilter() {
      const categories = new Set();
      allWorkflows.forEach(w => w.category && categories.add(w.category));

      const select = document.getElementById('category-filter');
      const currentValue = select.value;
      select.innerHTML = '<option value="">All Categories</option>' +
        Array.from(categories).sort().map(cat =>
          `<option value="${escapeHtml(cat)}" ${cat === currentValue ? 'selected' : ''}>${escapeHtml(cat)}</option>`
        ).join('');
    }

    function filterWorkflows() {
      const searchQuery = document.getElementById('search-input').value.toLowerCase();
      const categoryFilter = document.getElementById('category-filter').value;

      const filteredWorkflows = allWorkflows.filter(w => {
        const matchesSearch = !searchQuery ||
          w.name.toLowerCase().includes(searchQuery) ||
          (w.description && w.description.toLowerCase().includes(searchQuery));
        const matchesCategory = !categoryFilter || w.category === categoryFilter;
        return matchesSearch && matchesCategory;
      });

      renderWorkflows(filteredWorkflows);
    }

    function renderWorkflows(workflows) {
      const grid = document.getElementById('workflows-grid');

      if (workflows.length === 0) {
        grid.innerHTML = `
          <div class="col-12 text-center py-5">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-muted); opacity: 0.5;" class="mb-3">
              <path d="M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3M19,19H5V5H16.17L19,7.83V19M12,12C10.34,12 9,13.34 9,15C9,16.66 10.34,18 12,18C13.66,18 15,16.66 15,15C15,13.34 13.66,12 12,12M6,6H15V10H6V6Z"/>
            </svg>
            <p style="color: var(--text-muted);">No workflows yet</p>
            <p class="small" style="color: var(--text-muted);">
              Create workflows by selecting nodes on a studio canvas and choosing "Save as Workflow" from the context menu.
            </p>
          </div>
        `;
        return;
      }

      grid.innerHTML = workflows.map(workflow => renderWorkflowCard(workflow)).join('');
    }

    function renderWorkflowCard(workflow) {
      const nodeCount = workflow.nodes ? workflow.nodes.length : 0;

      return `
        <div class="col-md-6 col-lg-4">
          <div class="modern-card p-4 h-100 d-flex flex-column workflow-card" style="cursor: pointer; transition: all 0.15s ease;"
               onclick="openWorkflowDetails('${workflow.id}')"
               onmouseenter="this.style.borderColor='var(--primary-color)'"
               onmouseleave="this.style.borderColor='transparent'">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <h5 class="mb-0" style="color: var(--text-primary);">
                ${escapeHtml(workflow.name)}
              </h5>
              <button class="btn btn-link btn-sm p-1" onclick="event.stopPropagation(); openDeleteModal('${workflow.id}')" title="Delete workflow" style="color: var(--danger-color);">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
                </svg>
              </button>
            </div>

            <p class="text-muted small mb-3">${escapeHtml(workflow.description || 'No description')}</p>

            <div class="mb-3 d-flex flex-wrap gap-1">
              ${workflow.category ? `<span class="modern-badge badge-primary">${escapeHtml(workflow.category)}</span>` : ''}
              ${nodeCount > 0 ? `<span class="modern-badge badge-secondary">${nodeCount} node${nodeCount !== 1 ? 's' : ''}</span>` : ''}
            </div>

            <div class="mt-auto">
              <button class="modern-btn modern-btn-primary w-100" onclick="event.stopPropagation(); openStudioSelector('${workflow.id}')">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
                </svg>
                Add to Studio
              </button>
            </div>
          </div>
        </div>
      `;
    }

    // Workflow details
    let detailsWorkflow = null;

    function openWorkflowDetails(workflowId) {
      detailsWorkflow = allWorkflows.find(w => w.id === workflowId);
      if (!detailsWorkflow) {
        showError('Workflow not found');
        return;
      }

      document.getElementById('details-workflow-name').textContent = detailsWorkflow.name;
      document.getElementById('workflow-details-content').innerHTML = renderWorkflowDetails(detailsWorkflow);

      const modal = new bootstrap.Modal(document.getElementById('workflowDetailsModal'));
      modal.show();
    }

    function renderWorkflowDetails(workflow) {
      const nodeCount = workflow.nodes ? workflow.nodes.length : 0;
      const createdAt = workflow.created_at ? new Date(workflow.created_at).toLocaleString() : 'Unknown';

      let html = `
        <div class="mb-4">
          <p style="color: var(--text-secondary);">${escapeHtml(workflow.description || 'No description')}</p>
          <div class="d-flex flex-wrap gap-2 mb-3">
            ${workflow.category ? `<span class="modern-badge badge-primary">${escapeHtml(workflow.category)}</span>` : ''}
            <span class="modern-badge badge-secondary">${nodeCount} node${nodeCount !== 1 ? 's' : ''}</span>
          </div>
          <small style="color: var(--text-muted);">Created: ${escapeHtml(createdAt)}</small>
        </div>
      `;

      // Nodes section
      if (workflow.nodes && workflow.nodes.length > 0) {
        html += `
          <h6 style="color: var(--text-primary);" class="mb-3">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2M7.5,13A2.5,2.5 0 0,0 5,15.5A2.5,2.5 0 0,0 7.5,18A2.5,2.5 0 0,0 10,15.5A2.5,2.5 0 0,0 7.5,13M16.5,13A2.5,2.5 0 0,0 14,15.5A2.5,2.5 0 0,0 16.5,18A2.5,2.5 0 0,0 19,15.5A2.5,2.5 0 0,0 16.5,13Z"/>
            </svg>
            Nodes
          </h6>
          <div class="row g-2">
        `;

        workflow.nodes.forEach(node => {
          const nodeIcon = getNodeIcon(node.type);
          const nodeColor = getNodeColor(node.type);
          html += `
            <div class="col-md-6">
              <div class="p-3" style="background: var(--bg-secondary); border-radius: 8px; border-left: 3px solid ${nodeColor};">
                <div class="d-flex align-items-center gap-2 mb-1">
                  ${nodeIcon}
                  <strong style="color: var(--text-primary);">${escapeHtml(node.config?.name || node.type)}</strong>
                </div>
                <small style="color: var(--text-muted);">${escapeHtml(node.type)}</small>
                ${node.config?.agent_id ? `<br><small style="color: var(--text-secondary);">Agent: ${escapeHtml(node.config.agent_id)}</small>` : ''}
              </div>
            </div>
          `;
        });

        html += '</div>';
      }

      // Layout info
      if (workflow.layout) {
        html += `
          <div class="mt-4">
            <small style="color: var(--text-muted);">
              Layout: ${workflow.layout.width || 0}px x ${workflow.layout.height || 0}px
            </small>
          </div>
        `;
      }

      return html;
    }

    function getNodeIcon(type) {
      const icons = {
        'task': '<svg width="16" height="16" viewBox="0 0 24 24" fill="#6366f1"><path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/></svg>',
        'agent': '<svg width="16" height="16" viewBox="0 0 24 24" fill="#8b5cf6"><path d="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2Z"/></svg>',
        'scheduler': '<svg width="16" height="16" viewBox="0 0 24 24" fill="#f59e0b"><path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/></svg>',
        'store': '<svg width="16" height="16" viewBox="0 0 24 24" fill="#10b981"><path d="M12,3C7.58,3 4,4.79 4,7C4,9.21 7.58,11 12,11C16.42,11 20,9.21 20,7C20,4.79 16.42,3 12,3M4,9V12C4,14.21 7.58,16 12,16C16.42,16 20,14.21 20,12V9C20,11.21 16.42,13 12,13C7.58,13 4,11.21 4,9M4,14V17C4,19.21 7.58,21 12,21C16.42,21 20,19.21 20,17V14C20,16.21 16.42,18 12,18C7.58,18 4,16.21 4,14Z"/></svg>',
        'attachment': '<svg width="16" height="16" viewBox="0 0 24 24" fill="#ec4899"><path d="M16.5,6V17.5A4,4 0 0,1 12.5,21.5A4,4 0 0,1 8.5,17.5V5A2.5,2.5 0 0,1 11,2.5A2.5,2.5 0 0,1 13.5,5V15.5A1,1 0 0,1 12.5,16.5A1,1 0 0,1 11.5,15.5V6H10V15.5A2.5,2.5 0 0,0 12.5,18A2.5,2.5 0 0,0 15,15.5V5A4,4 0 0,0 11,1A4,4 0 0,0 7,5V17.5A5.5,5.5 0 0,0 12.5,23A5.5,5.5 0 0,0 18,17.5V6H16.5Z"/></svg>'
      };
      return icons[type] || '<svg width="16" height="16" viewBox="0 0 24 24" fill="#6b7280"><circle cx="12" cy="12" r="10"/></svg>';
    }

    function getNodeColor(type) {
      const colors = {
        'task': '#6366f1',
        'agent': '#8b5cf6',
        'scheduler': '#f59e0b',
        'store': '#10b981',
        'attachment': '#ec4899'
      };
      return colors[type] || '#6b7280';
    }

    document.getElementById('detailsAddToStudioBtn').addEventListener('click', function() {
      if (!detailsWorkflow) return;
      bootstrap.Modal.getInstance(document.getElementById('workflowDetailsModal')).hide();
      openStudioSelector(detailsWorkflow.id);
    });

    // Studio selector
    async function openStudioSelector(workflowId) {
      selectedWorkflow = allWorkflows.find(w => w.id === workflowId);

      if (!selectedWorkflow) {
        showError('Workflow not found');
        return;
      }

      const modal = new bootstrap.Modal(document.getElementById('studioSelectorModal'));
      const studioList = document.getElementById('studio-list');
      const addBtn = document.getElementById('addToStudioBtn');

      addBtn.disabled = true;
      selectedStudioId = null;

      // Show loading
      studioList.innerHTML = `
        <div class="text-center py-3">
          <div class="spinner-border spinner-border-sm text-primary" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
        </div>
      `;

      modal.show();

      // Load studios
      try {
        const response = await fetch('/api/studios');
        const data = await response.json();
        const studios = data.studios || [];

        if (studios.length === 0) {
          studioList.innerHTML = `
            <div class="text-center py-3">
              <p style="color: var(--text-muted);">No studios available.</p>
              <a href="/studios" class="modern-btn modern-btn-primary mt-2">Create Studio</a>
            </div>
          `;
          return;
        }

        studioList.innerHTML = studios.map(studio => `
          <div class="studio-option p-3 mb-2" style="background: var(--bg-secondary); border-radius: 6px; border: 2px solid transparent; cursor: pointer;"
               onclick="selectStudio('${studio.id}', this)"
               data-studio-id="${studio.id}">
            <div class="d-flex align-items-center gap-2">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: var(--primary-color);">
                <path d="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8Z"/>
              </svg>
              <div>
                <strong style="color: var(--text-primary);">${escapeHtml(studio.name)}</strong>
                <div class="small" style="color: var(--text-muted);">${studio.agents?.length || 0} agents</div>
              </div>
            </div>
          </div>
        `).join('');

      } catch (error) {
        console.error('Error loading studios:', error);
        studioList.innerHTML = `<div class="alert alert-danger">Failed to load studios</div>`;
      }
    }

    function selectStudio(studioId, element) {
      // Remove selection from all
      document.querySelectorAll('.studio-option').forEach(el => {
        el.style.borderColor = 'transparent';
      });

      // Select this one
      element.style.borderColor = 'var(--primary-color)';
      selectedStudioId = studioId;

      // Enable add button
      document.getElementById('addToStudioBtn').disabled = false;

      // Check for missing agents
      checkMissingAgents(studioId);
    }

    async function checkMissingAgents(studioId) {
      if (!selectedWorkflow || !selectedWorkflow.id) return;

      const warningEl = document.getElementById('missing-agents-warning');
      const textEl = document.getElementById('missing-agents-text');

      try {
        const response = await fetch(`/api/workflows/${selectedWorkflow.id}/check-agents`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ studio_id: studioId })
        });

        if (response.ok) {
          const result = await response.json();
          if (result.missing_agents && result.missing_agents.length > 0) {
            textEl.textContent = `Missing agents: ${result.missing_agents.join(', ')}`;
            warningEl.style.display = 'block';
          } else {
            warningEl.style.display = 'none';
          }
        }
      } catch (error) {
        console.error('Error checking agents:', error);
      }
    }

    document.getElementById('addToStudioBtn').addEventListener('click', async function() {
      if (!selectedStudioId || !selectedWorkflow) return;

      this.disabled = true;
      this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Adding...';

      // Redirect to the studio canvas page where the workflow panel can instantiate it
      window.location.href = `/studios/${selectedStudioId}/canvas?add_workflow=${selectedWorkflow.id}`;
    });

    // Delete workflow
    function openDeleteModal(workflowId) {
      workflowToDelete = allWorkflows.find(w => w.id === workflowId);
      if (!workflowToDelete) return;

      document.getElementById('delete-workflow-name').textContent = workflowToDelete.name;
      document.getElementById('delete-workflow-desc').textContent = workflowToDelete.description || 'No description';

      const modal = new bootstrap.Modal(document.getElementById('deleteWorkflowModal'));
      modal.show();
    }

    document.getElementById('confirmDeleteBtn').addEventListener('click', async function() {
      if (!workflowToDelete) return;

      this.disabled = true;
      this.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Deleting...';

      try {
        const response = await fetch(`/api/workflows/${workflowToDelete.id}`, {
          method: 'DELETE'
        });

        if (!response.ok) {
          throw new Error(await response.text());
        }

        // Close modal and reload
        bootstrap.Modal.getInstance(document.getElementById('deleteWorkflowModal')).hide();
        loadWorkflows();

      } catch (error) {
        console.error('Error deleting workflow:', error);
        showError('Failed to delete workflow: ' + error.message);
      } finally {
        this.disabled = false;
        this.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1"><path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/></svg> Delete';
      }
    });

    function showError(message) {
      alert(message);
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }
  </script>
  {{template "modals.tmpl" .}}
</body>
</html>
{{end}}
