{{define "workflows"}}
<!DOCTYPE html>
<html data-bs-theme="light">
{{template "head.tmpl" .}}

<body class="bg-light workflows-page">
  {{template "navbar.tmpl" .}}

  <style>
    /* Page geometry only: controls, badges and dialogs use the shared kit. */
    .workflows-page .main-content-wrapper { background: var(--bg-primary); }
    #behaviorStudioPage {
      --behavior-line: var(--border-color);
      --behavior-ink: var(--text-primary);
      --behavior-ink-soft: var(--text-secondary);
      --behavior-title: var(--text-primary);
      padding: var(--space-6) var(--space-3);
      color: var(--text-primary);
      background: var(--bg-primary);
    }
    .behavior-page__masthead { margin-bottom: var(--space-4); }
    .behavior-page__stats {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-4);
      margin: 0 0 var(--space-6);
      color: var(--text-muted);
      font-size: 0.875rem;
    }
    .behavior-page__stat { display: flex; gap: var(--space-2); }
    .behavior-page__stat strong { color: var(--text-primary); }
    .behavior-page__layout {
      display: grid;
      grid-template-columns: minmax(16rem, 19rem) minmax(0, 1fr);
      gap: var(--space-6);
      align-items: start;
    }
    .behavior-page__layout > *, .behavior-field { min-width: 0; }
    .behavior-page__sidebar {
      position: sticky;
      top: calc(var(--navbar-height, 64px) + var(--space-4));
    }
    .behavior-library-summary { margin: 0; padding: var(--space-4); }
    .behavior-sidebar__top { padding: 0 var(--space-4) var(--space-4); }
    .behavior-filter-grid, .behavior-form-grid {
      display: grid;
      gap: var(--space-4);
    }
    .behavior-filter-grid { margin-top: var(--space-3); }
    .behavior-sidebar__list {
      display: grid;
      gap: var(--space-3);
      padding: var(--space-4);
      border-top: 1px solid var(--border-color);
      max-height: min(32rem, 60vh);
      overflow: auto;
    }
    .behavior-card {
      min-width: 0;
      padding-bottom: var(--space-3);
      border-bottom: 1px solid var(--border-color);
    }
    .behavior-card:last-child { border-bottom: 0; padding-bottom: 0; }
    .behavior-card__select {
      display: block;
      width: 100%;
      padding: var(--space-2);
      border: 1px solid transparent;
      border-radius: var(--radius-md);
      text-align: left;
      color: var(--text-primary);
      background: transparent;
      font: inherit;
    }
    .behavior-card__select[aria-pressed="true"] {
      border-color: var(--focus-color);
      background: var(--bg-secondary);
    }
    .behavior-card__title { display: block; font-weight: 600; }
    .behavior-card__meta, .behavior-card__actions,
    .behavior-step-card__actions, .behavior-preview-card__actions,
    .behavior-subsection__actions, .behavior-dependency-grid,
    .behavior-output-summary {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: var(--space-2);
    }
    .behavior-card__meta { margin-top: var(--space-2); font-size: 0.8125rem; color: var(--text-secondary); }
    .behavior-card__actions { margin-top: var(--space-2); }
    .behavior-card__summary { display: block; margin-top: var(--space-2); font-size: 0.875rem; color: var(--text-secondary); }
    .behavior-badge--builtin { color: var(--warning-text); }
    .behavior-badge--custom, .behavior-readonly-pill--active { color: var(--success-text); }
    .behavior-preview-card__status.is-dirty { color: var(--warning-text); }
    .behavior-section, .behavior-preview-card { padding: var(--space-4); }
    .behavior-section__head, .behavior-subsection__head,
    .behavior-step-card__head, .behavior-preview-panel__head,
    .behavior-preview-card__hero {
      display: flex;
      flex-wrap: wrap;
      align-items: start;
      justify-content: space-between;
      gap: var(--space-3);
    }
    .behavior-section__head > div, .behavior-subsection__head > div,
    .behavior-step-card__head > div, .behavior-preview-card__hero > div { min-width: 0; }
    .behavior-section__eyebrow, .behavior-preview-card__eyebrow,
    .behavior-step-card__eyebrow { margin-bottom: var(--space-1); font-size: 0.8125rem; color: var(--text-muted); }
    .behavior-section__title, .behavior-preview-card__title {
      margin: 0;
      font-family: var(--font-body);
      font-size: 1.25rem;
      line-height: 1.4;
      font-weight: 600;
    }
    .behavior-step-card__title, .behavior-preview-panel__head h3 {
      margin: 0;
      font-family: var(--font-body);
      font-size: 1rem;
      font-weight: 600;
    }
    .behavior-editor-fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
    .behavior-editor-actions { margin-top: var(--space-4); gap: var(--space-2); }
    [data-editor-heading], #behaviorStudioEditor [data-field="name"] { scroll-margin-top: calc(var(--navbar-height, 64px) + var(--space-4)); }
    .behavior-editor-actions details { position: relative; }
    .behavior-editor-actions details[open] .ui-actions { margin-top: var(--space-2); }
    .behavior-editor-feedback { grid-column: 1 / -1; margin-top: var(--space-2); }
    .behavior-stack, .behavior-step-list, .behavior-schema-field-list {
      display: grid;
      gap: var(--space-4);
      margin-top: var(--space-4);
    }
    .behavior-subsection, .behavior-preview-panel, .behavior-json-inspector {
      margin-top: var(--space-6);
      padding-top: var(--space-4);
      border-top: 1px solid var(--border-color);
    }
    .behavior-subsection__title { font-weight: 600; }
    .behavior-subsection__copy, .behavior-preview-card__copy,
    .behavior-field__hint, .behavior-empty-state__copy,
    .behavior-output-chip__meta, .behavior-preview-panel__head span { color: var(--text-secondary); font-size: 0.875rem; }
    .behavior-field__optional { color: var(--text-muted); font-weight: 400; }
    .behavior-form-grid { margin-top: var(--space-4); }
    .behavior-form-grid--meta, .behavior-form-grid--rules,
    .behavior-form-grid--schema, .behavior-parameter-row__grid,
    .behavior-form-grid--step, .behavior-form-grid--schema-row,
    .behavior-form-grid--launch-steps, .behavior-launch-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .behavior-field { display: grid; gap: var(--space-2); margin-top: var(--space-3); }
    .behavior-form-grid > .behavior-field, .behavior-parameter-row__grid > .behavior-field { margin-top: 0; }
    .behavior-field--toggle { align-content: start; justify-items: start; }
    .behavior-field__label { margin: 0; font-size: 0.875rem; font-weight: 600; color: var(--text-secondary); }
    .behavior-input--mono, .behavior-textarea--code, .behavior-json-inspector pre { font-family: var(--font-mono); }
    .behavior-textarea { resize: vertical; min-height: 5rem; }
    .behavior-textarea--code { min-height: 8rem; }
    .behavior-parameter-row, .behavior-schema-field-row, .behavior-launch-panel { min-width: 0; }
    .behavior-parameter-row + .behavior-parameter-row,
    .behavior-schema-field-row + .behavior-schema-field-row {
      padding-top: var(--space-4);
      border-top: 1px solid var(--border-color);
    }
    .behavior-parameter-row__grid { display: grid; gap: var(--space-4); align-items: start; }
    .behavior-parameter-row__footer { margin-top: var(--space-3); }
    .behavior-step-card { padding: var(--space-4); border: 1px solid var(--border-color); border-radius: var(--radius-lg); }
    .behavior-dependency-pill {
      display: inline-flex;
      align-items: center;
      gap: var(--space-2);
      padding: var(--space-2);
      border: 1px solid var(--control-border);
      border-radius: var(--radius-md);
    }
    .behavior-preview-stats { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-4); margin-top: var(--space-4); }
    .behavior-preview-stat strong { display: block; font-size: 0.875rem; }
    .behavior-preview-stat__label { color: var(--text-muted); font-size: 0.8125rem; }
    .behavior-graph-frame {
      margin-top: var(--space-3);
      overflow: auto;
      border: 1px solid var(--control-border);
      border-radius: var(--radius-lg);
      background: var(--bg-secondary);
    }
    .behavior-graph-svg { display: block; width: 100%; min-width: 720px; height: auto; }
    .behavior-graph-edge { stroke: var(--control-border); stroke-width: 2.4px; }
    .behavior-graph-label, .behavior-graph-sublabel { fill: var(--text-primary); font-family: var(--font-body); }
    .behavior-graph-label { font-size: 12px; font-weight: 600; }
    .behavior-graph-sublabel { font-size: 10px; }
    .behavior-graph-empty, .behavior-empty-state, .behavior-output-summary--empty { padding: var(--space-4); }
    .behavior-empty-state__title { font-weight: 600; }
    .behavior-output-summary { margin-top: var(--space-3); }
    .behavior-output-chip { max-width: 100%; padding: var(--space-2); border: 1px solid var(--border-color); border-radius: var(--radius-md); }
    .behavior-output-chip__name, .behavior-output-chip__meta { display: block; }
    .behavior-json-inspector summary { color: var(--text-primary); font-weight: 600; }
    .behavior-json-inspector pre { margin-top: var(--space-3); padding: var(--space-3); overflow: auto; background: var(--bg-secondary); color: var(--text-primary); border-radius: var(--radius-md); font-size: 0.875rem; }
    .behavior-launch-grid { display: grid; gap: var(--space-6); }
    .behavior-launch-panel + .behavior-launch-panel { margin-top: var(--space-4); }
    .behavior-launch-grid > .behavior-launch-panel { margin-top: 0; }
    .behavior-launch-note { margin-top: var(--space-3); color: var(--text-secondary); font-size: 0.875rem; }
    #behaviorStudioPage :is(h2, h3, p, strong, .behavior-card__select),
    #behaviorLaunchModal :is(.behavior-field__label, .behavior-launch-note) { overflow-wrap: anywhere; }
    @media (max-width: 991px) {
      #behaviorStudioPage { padding-block: var(--space-4); }
      .behavior-page__stats { margin-bottom: var(--space-4); }
      .behavior-page__layout { grid-template-columns: 1fr; gap: var(--space-4); }
      .behavior-page__sidebar { position: static; }
      .behavior-sidebar__list { max-height: 24rem; }
    }
    @media (max-width: 720px) {
      .behavior-form-grid--meta, .behavior-form-grid--rules,
      .behavior-form-grid--schema, .behavior-form-grid--step,
      .behavior-parameter-row__grid, .behavior-form-grid--schema-row,
      .behavior-form-grid--launch-steps, .behavior-launch-grid { grid-template-columns: 1fr; }
      .behavior-preview-stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
  </style>

  <div class="main-content-wrapper">
    <div class="main-content">
      <div id="behaviorStudioPage" class="behavior-page">
        <header class="ui-page-header behavior-page__masthead">
          <div class="ui-page-heading">
            <h1 class="behavior-page__title">Workflows</h1>
            <p class="ui-page-description behavior-page__copy">Reusable orchestration skills with graphs and structured outputs.</p>
          </div>
          <div class="ui-page-actions behavior-sidebar__actions">
            <button id="behaviorStudioNewBtn" class="btn btn-primary behavior-btn behavior-btn--primary" type="button">New skill</button>
            <button id="behaviorStudioImportBtn" class="btn btn-secondary behavior-btn behavior-btn--secondary" type="button">Import JSON</button>
          </div>
        </header>
        <div class="behavior-page__stats" aria-label="Library totals">
          <div class="behavior-page__stat"><strong id="behaviorStudioCount">0</strong><span>Total skills</span></div>
          <div class="behavior-page__stat"><strong id="behaviorStudioCustomCount">0</strong><span>Custom skills</span></div>
        </div>

        <div class="behavior-page__layout">
          <aside class="behavior-page__sidebar" aria-label="Orchestration skills library">
            <details class="behavior-panel ui-section" id="behaviorStudioLibrary" open>
              <summary class="ui-disclosure-title behavior-library-summary">Skills library</summary>
              <div class="behavior-sidebar__top">
                <div class="behavior-filter-grid">
                  <label for="behaviorStudioSearch" class="form-label mb-0">Search skills</label>
                  <input id="behaviorStudioSearch" class="form-control behavior-input" type="search" placeholder="Search skills…">
                  <label for="behaviorStudioSourceFilter" class="form-label mb-0">Source</label>
                  <select id="behaviorStudioSourceFilter" class="form-select behavior-input">
                    <option value="all">All sources</option><option value="custom">Custom only</option><option value="builtin">Built-in only</option>
                  </select>
                  <label for="behaviorStudioCategoryFilter" class="form-label mb-0">Category</label>
                  <select id="behaviorStudioCategoryFilter" class="form-select behavior-input"><option value="all">All categories</option></select>
                </div>
              </div>
              <div class="behavior-sidebar__list" id="behaviorStudioList" aria-label="Available skills">
                <div class="behavior-empty-state" role="status">
                  <div class="behavior-empty-state__title">Loading orchestration skills…</div>
                  <div class="behavior-empty-state__copy">The reusable orchestration library is being loaded.</div>
                </div>
              </div>
            </details>
          </aside>

          <main class="behavior-page__editor" aria-label="Orchestration skill editor">
            <div id="behaviorStudioEditor" class="behavior-panel ui-section">
              <section class="behavior-section">
                <h2 class="behavior-section__title">Loading orchestration skill editor</h2>
              </section>
            </div>
            <div id="behaviorStudioPreview" class="behavior-panel ui-section mt-4">
              <section class="behavior-preview-card">
                <h2 class="behavior-preview-card__title" id="behaviorStudioSelectedLabel">Loading</h2>
                <p class="behavior-preview-card__copy">The graph preview and orchestration skill launch controls will appear here.</p>
              </section>
            </div>
          </main>
        </div>
        <input id="behaviorStudioImportInput" type="file" accept=".json,application/json" hidden>
      </div>
    </div>
  </div>

  <div class="modal fade" id="behaviorLaunchModal" tabindex="-1" aria-labelledby="behaviorLaunchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title" id="behaviorLaunchModalLabel">Add orchestration skill to workspace</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" id="behaviorLaunchModalBody">
          <div class="behavior-empty-state" role="status">
            <div class="behavior-empty-state__title">Preparing launch form…</div>
            <div class="behavior-empty-state__copy">Workspace selection and parameter controls will load here.</div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary behavior-btn behavior-btn--secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary behavior-btn behavior-btn--primary" id="behaviorLaunchSubmit">Add to Workspace</button>
        </div>
      </div>
    </div>
  </div>

  <script defer src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
  <script defer src="/js/modules/themeManager.js"></script>
  {{template "scripts-dx-utils.tmpl" .}}
  <script defer src="/js/modules/toast.js"></script>
  <script defer src="/js/app.js"></script>
  <script defer src="/js/modules/behavior-studio.js"></script>
  {{template "theme-init.tmpl" .}}
</body>
</html>
{{end}}
