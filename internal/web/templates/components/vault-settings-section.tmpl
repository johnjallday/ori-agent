<section id="private-vault" class="settings-section modern-card p-4">
  <div class="settings-section-header">
    <span class="settings-section-icon">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12,1A5,5 0 0,1 17,6V8H18A2,2 0 0,1 20,10V21A2,2 0 0,1 18,23H6A2,2 0 0,1 4,21V10A2,2 0 0,1 6,8H7V6A5,5 0 0,1 12,1M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3M12,12A2,2 0 0,0 10,14A2,2 0 0,0 11,15.73V18H13V15.73A2,2 0 0,0 14,14A2,2 0 0,0 12,12Z"/>
      </svg>
    </span>
    <h2 class="settings-section-title">Private Vault</h2>
    <span class="settings-section-subtitle">(Encrypted local storage)</span>
  </div>

  <p class="settings-section-description">
    Store private records outside normal session history. Vault entries stay encrypted at rest, tags are excluded from standard search, and workspace agents need explicit persistent grants before they can read saved data.
  </p>

  <div id="vaultAlerts" class="mb-3"></div>

  <div id="vaultStatus" class="settings-status mb-4">
    <div id="vaultStatusIndicator">
      <span class="spinner-border spinner-border-sm" role="status" aria-label="Loading"></span>
    </div>
    <div class="settings-status-content">
      <div id="vaultStatusText" class="settings-status-text">Loading vault status...</div>
      <div id="vaultStatusDetails" class="settings-status-details"></div>
    </div>
  </div>

  <div class="settings-grid mb-4">
    <div class="settings-info-box">
      <div class="settings-info-row">
        <span class="settings-info-label">Backend</span>
        <span id="vaultBackendLabel" class="settings-info-value">-</span>
      </div>
      <div class="settings-info-row">
        <span class="settings-info-label">Records</span>
        <span id="vaultRecordCount" class="settings-info-value">-</span>
      </div>
      <div class="settings-info-row">
        <span class="settings-info-label">Write Access</span>
        <span id="vaultWritableLabel" class="settings-info-value">-</span>
      </div>
    </div>
    <div class="settings-info-box">
      <div class="settings-info-row">
        <span class="settings-info-label">Current Mode</span>
        <span id="vaultModeLabel" class="badge" style="background: var(--bg-tertiary); color: var(--text-primary);">-</span>
      </div>
      <div class="settings-info-row">
        <span class="settings-info-label">Search Indexing</span>
        <span class="settings-info-value">Excluded</span>
      </div>
      <div class="settings-info-row">
        <span class="settings-info-label">Prompt Access</span>
        <span class="settings-info-value">Grant Required</span>
      </div>
    </div>
  </div>

  <div class="settings-info-box mb-4">
    <div class="settings-info-row" style="align-items: flex-start;">
      <div>
        <span class="settings-info-label">Vault Spaces</span>
        <span class="settings-info-value">Choose or create a named vault</span>
      </div>
    </div>

    <div class="settings-grid mt-3">
      <div>
        <div class="settings-field">
          <label class="settings-label" for="vaultActiveVaultId">Active vault</label>
          <select id="vaultActiveVaultId" class="form-select settings-input">
            <option value="">Loading vaults...</option>
          </select>
        </div>
        <div id="vaultActiveVaultMeta" class="settings-help">Checking available vaults...</div>
      </div>

      <div>
        <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1rem;">Manage Active Vault</h3>
        <div class="settings-field">
          <label class="settings-label" for="vaultEditVaultName">Vault name</label>
          <input id="vaultEditVaultName" type="text" class="form-control settings-input" placeholder="Private Vault">
        </div>
        <div class="settings-field">
          <label class="settings-label" for="vaultEditVaultDescription">Description</label>
          <input id="vaultEditVaultDescription" type="text" class="form-control settings-input" placeholder="What belongs in this vault">
        </div>
        <div class="settings-actions">
          <button id="vaultRenameVaultBtn" class="modern-btn modern-btn-secondary" type="button">Save Vault Details</button>
          <button id="vaultDeleteVaultBtn" class="btn btn-outline-danger" type="button">Delete Vault</button>
        </div>
        <span class="settings-help">Deleting a vault permanently removes its encrypted records, grants, and explorer view.</span>

        <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-primary); margin: 1.5rem 0 1rem;">Create A New Vault</h3>
        <div class="settings-field">
          <label class="settings-label" for="vaultNewVaultName">New vault name</label>
          <input id="vaultNewVaultName" type="text" class="form-control settings-input" placeholder="Finance Vault, Travel Vault, Family Vault">
        </div>
        <div class="settings-field">
          <label class="settings-label" for="vaultNewVaultDescription">Description</label>
          <input id="vaultNewVaultDescription" type="text" class="form-control settings-input" placeholder="Optional note about what belongs in this vault">
        </div>
        <div class="settings-field">
          <label class="settings-label" for="vaultNewVaultPassword">Vault password</label>
          <input id="vaultNewVaultPassword" type="password" class="form-control settings-input" placeholder="Required for this vault">
        </div>
        <div class="settings-field">
          <label class="settings-label" for="vaultConfirmVaultPassword">Confirm vault password</label>
          <input id="vaultConfirmVaultPassword" type="password" class="form-control settings-input" placeholder="Re-enter the vault password">
        </div>
        <div class="settings-actions">
          <button id="vaultCreateVaultSpaceBtn" class="modern-btn modern-btn-secondary" type="button">Create Vault</button>
        </div>
        <span class="settings-help">Each vault has its own password. Keep it somewhere safe because Ori cannot recover it later.</span>
      </div>
    </div>
  </div>

  <div class="settings-field">
    <label class="settings-label" for="vaultUnlockPassword">Vault password</label>
    <div class="input-group">
      <input id="vaultUnlockPassword"
             type="password"
             class="form-control settings-input"
             placeholder="Enter the selected vault password">
      <button class="btn btn-outline-secondary" type="button" id="toggleVaultUnlockPassword" aria-label="Toggle password visibility">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/>
        </svg>
      </button>
      <button id="vaultUnlockBtn" class="btn btn-primary modern-btn-primary" type="button">Unlock Vault</button>
      <button id="vaultLockBtn" class="btn btn-outline-secondary" type="button">Lock Vault</button>
      <button id="vaultRefreshBtn" class="btn btn-outline-secondary" type="button">Refresh</button>
    </div>
    <span id="vaultUnlockPasswordHelp" class="settings-help">Per-vault passwords are required for new vaults. Legacy vaults may still unlock through secure system storage or the older fallback passphrase flow.</span>
  </div>

  <div class="settings-grid mb-4">
    <div>
      <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1rem;">Save To Vault</h3>
      <div class="settings-field">
        <label class="settings-label" for="vaultEntryType">Entry type</label>
        <select id="vaultEntryType" class="form-select settings-input">
          <option value="personal_note">Personal Note</option>
          <option value="email_snippet">Email Snippet</option>
          <option value="secret">Secret</option>
        </select>
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultEntryWorkspaceId">Workspace ID</label>
        <input id="vaultEntryWorkspaceId" type="text" class="form-control settings-input" placeholder="Optional workspace scope">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultEntryLabel">Label</label>
        <input id="vaultEntryLabel" type="text" class="form-control settings-input" placeholder="Passport copy, accountant email, family contacts">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultEntryTags">Sensitive tags</label>
        <input id="vaultEntryTags" type="text" class="form-control settings-input" placeholder="Comma-separated tags">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultEntrySource">Source</label>
        <input id="vaultEntrySource" type="text" class="form-control settings-input" placeholder="manual, connector, import">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultEntryRetention">Retention policy</label>
        <input id="vaultEntryRetention" type="text" class="form-control settings-input" placeholder="keep_until_revoked">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultEntryPayload">Payload JSON</label>
        <textarea id="vaultEntryPayload" class="form-control settings-input" rows="8" spellcheck="false" placeholder='{"note":"private"}'></textarea>
      </div>
      <div class="settings-actions">
        <button id="vaultSaveEntryBtn" class="modern-btn modern-btn-primary" type="button">Save To Vault</button>
        <button id="vaultResetEntryBtn" class="modern-btn modern-btn-secondary" type="button">New Entry</button>
        <button id="vaultRevealPayloadBtn" class="modern-btn modern-btn-secondary" type="button">Reveal Payload</button>
        <button id="vaultDeleteEntryBtn" class="btn btn-outline-danger" type="button">Delete Entry</button>
      </div>
      <span class="settings-help">Payloads stay hidden by default when you open an existing entry. Use Reveal Payload to inspect or edit the sensitive JSON body.</span>
    </div>

    <div>
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-primary); margin: 0;">Saved Entries</h3>
        <span id="vaultSelectionBadge" class="badge" style="background: var(--bg-tertiary); color: var(--text-primary);">No selection</span>
      </div>
      <div id="vaultRecordsList" class="d-flex flex-column gap-2">
        <div class="settings-help">Vault entries will appear here once the vault is unlocked.</div>
      </div>
    </div>
  </div>

  <div class="settings-grid mb-4">
    <div>
      <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1rem;">Workspace Grants</h3>
      <div class="settings-field">
        <label class="settings-label" for="vaultGrantWorkspaceId">Workspace ID</label>
        <input id="vaultGrantWorkspaceId" type="text" class="form-control settings-input" placeholder="workspace-123">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultGrantActorType">Actor type</label>
        <select id="vaultGrantActorType" class="form-select settings-input">
          <option value="agent">Agent</option>
          <option value="plugin">Plugin</option>
        </select>
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultGrantActorId">Actor ID</label>
        <input id="vaultGrantActorId" type="text" class="form-control settings-input" placeholder="finance-agent">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultGrantCapability">Capability</label>
        <select id="vaultGrantCapability" class="form-select settings-input">
          <option value="vault.personal.read">vault.personal.read</option>
          <option value="vault.personal.write">vault.personal.write</option>
          <option value="vault.email.read_saved">vault.email.read_saved</option>
          <option value="vault.email.write_saved">vault.email.write_saved</option>
          <option value="vault.secrets.read">vault.secrets.read</option>
          <option value="vault.secrets.write">vault.secrets.write</option>
        </select>
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultGrantRecordType">Record type</label>
        <input id="vaultGrantRecordType" type="text" class="form-control settings-input" placeholder="email_snippet or *">
      </div>
      <div class="settings-actions">
        <button id="vaultCreateGrantBtn" class="modern-btn modern-btn-primary" type="button">Add Persistent Grant</button>
      </div>
      <span class="settings-help">Persistent grants stay limited to one workspace. Leave record type blank to cover all entry types within that capability.</span>
    </div>

    <div>
      <h3 style="font-size: 1rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1rem;">Grant Review</h3>
      <div id="vaultGrantsList" class="d-flex flex-column gap-2">
        <div class="settings-help">No persistent grants loaded yet.</div>
      </div>
    </div>
  </div>

  <div class="settings-info-box">
    <div class="settings-info-row">
      <span class="settings-info-label">Encrypted Export</span>
      <span class="settings-info-value">Password required</span>
    </div>
    <div class="settings-field mt-3">
      <label class="settings-label" for="vaultExportWorkspaceId">Workspace filter</label>
      <input id="vaultExportWorkspaceId" type="text" class="form-control settings-input" placeholder="Optional workspace scope">
    </div>
    <div class="form-check mb-3">
      <input class="form-check-input" type="checkbox" id="vaultExportConfirm">
      <label class="form-check-label" for="vaultExportConfirm" style="color: var(--text-primary);">
        I understand this export contains encrypted private data and should be handled carefully.
      </label>
    </div>
    <div class="settings-field">
      <label class="settings-label" for="vaultExportPassword">Export password</label>
      <input id="vaultExportPassword" type="password" class="form-control settings-input" placeholder="Used to encrypt the export bundle">
    </div>
    <div class="settings-actions">
      <button id="vaultExportBtn" class="modern-btn modern-btn-primary" type="button">Export Vault</button>
    </div>
  </div>

  <div class="settings-info-box mt-4">
    <div class="settings-info-row">
      <span class="settings-info-label">Portable Import</span>
      <span class="settings-info-value">Bundle password required</span>
    </div>
    <div class="settings-field mt-3">
      <label class="settings-label" for="vaultImportFile">Export bundle</label>
      <div class="settings-actions" style="justify-content: flex-start; margin-bottom: 0.65rem;">
        <button id="vaultImportChooseFileBtn" class="modern-btn modern-btn-secondary" type="button">Choose File</button>
      </div>
      <input id="vaultImportFile" type="file" accept=".json,application/json" hidden>
      <div id="vaultImportFileName" class="settings-help">No import file selected yet.</div>
    </div>
    <div class="settings-field">
      <label class="settings-label" for="vaultImportPassword">Import password</label>
      <input id="vaultImportPassword" type="password" class="form-control settings-input" placeholder="Used to decrypt the export bundle">
    </div>
    <div class="settings-field">
      <label class="settings-label" for="vaultImportMode">Import target</label>
      <select id="vaultImportMode" class="form-select settings-input">
        <option value="new">Create a new vault</option>
        <option id="vaultImportModeCurrentOption" value="current">Import into the selected vault</option>
      </select>
    </div>
    <div id="vaultImportCurrentHint" class="settings-help mb-3">The selected vault must already be unlocked before Ori can import records into it.</div>
    <div id="vaultImportCreateFields">
      <div class="settings-field">
        <label class="settings-label" for="vaultImportVaultName">New vault name</label>
        <input id="vaultImportVaultName" type="text" class="form-control settings-input" placeholder="Leave blank to use the bundle vault name">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultImportVaultDescription">Description</label>
        <input id="vaultImportVaultDescription" type="text" class="form-control settings-input" placeholder="Optional note for the imported vault">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultImportVaultPassword">New vault password</label>
        <input id="vaultImportVaultPassword" type="password" class="form-control settings-input" placeholder="Required for the imported vault">
      </div>
      <div class="settings-field">
        <label class="settings-label" for="vaultImportConfirmVaultPassword">Confirm vault password</label>
        <input id="vaultImportConfirmVaultPassword" type="password" class="form-control settings-input" placeholder="Re-enter the vault password">
      </div>
    </div>
    <div class="form-check mb-3">
      <input class="form-check-input" type="checkbox" id="vaultImportRestoreGrants" checked>
      <label class="form-check-label" for="vaultImportRestoreGrants" style="color: var(--text-primary);">
        Restore workspace access grants from the bundle when they are available.
      </label>
    </div>
    <div class="settings-actions">
      <button id="vaultImportBtn" class="modern-btn modern-btn-primary" type="button">Import Vault</button>
    </div>
  </div>
</section>
