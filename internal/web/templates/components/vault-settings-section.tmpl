<section id="private-vault" class="vault-page-shell">
  <div id="vaultAlerts" class="vault-page-alerts" aria-live="polite"></div>

  <section class="vault-page-status modern-card">
    <div class="vault-page-status-bar">
      <div class="vault-page-status-main">
        <div id="vaultStatusIndicator" class="vault-page-status-indicator">
          <span class="spinner-border spinner-border-sm" role="status" aria-label="Loading"></span>
        </div>
        <div class="vault-page-status-copy">
          <div class="vault-page-eyebrow">Vault Health</div>
          <h2 id="vaultStatusText" class="vault-page-section-title">Loading vault status...</h2>
          <p id="vaultStatusDetails" class="vault-page-status-summary">Checking encrypted storage status and active vault availability.</p>
        </div>
      </div>
      <p class="vault-page-status-note">
        Use this page for the full administrative workflow: choose vaults, unlock storage, review grants, and move encrypted bundles safely.
      </p>
    </div>

    <div class="vault-page-metrics" aria-label="Vault metrics">
      <div class="vault-page-metric">
        <span class="vault-page-metric-label">Backend</span>
        <strong id="vaultBackendLabel" class="vault-page-metric-value">-</strong>
      </div>
      <div class="vault-page-metric">
        <span class="vault-page-metric-label">Records</span>
        <strong id="vaultRecordCount" class="vault-page-metric-value">-</strong>
      </div>
      <div class="vault-page-metric">
        <span class="vault-page-metric-label">Write Access</span>
        <strong id="vaultWritableLabel" class="vault-page-metric-value">-</strong>
      </div>
      <div class="vault-page-metric">
        <span class="vault-page-metric-label">Current Mode</span>
        <span id="vaultModeLabel" class="vault-page-mode-badge">-</span>
      </div>
    </div>
  </section>

  <div class="vault-page-grid">
    <aside class="vault-page-sidebar">
      <section class="vault-page-card">
        <div class="vault-page-card-head">
          <div>
            <div class="vault-page-eyebrow">Administration</div>
            <h3 class="vault-page-card-title">Manage vault details</h3>
          </div>
        </div>

        <div class="vault-page-stack">
          <div class="vault-page-subsection">
            <h4 class="vault-page-subtitle">Selected vault</h4>
            <div class="vault-page-field">
              <label class="vault-page-label" for="vaultEditVaultName">Vault name</label>
              <input id="vaultEditVaultName" type="text" class="form-control settings-input vault-page-input" placeholder="Private Vault">
            </div>
            <div class="vault-page-field">
              <label class="vault-page-label" for="vaultEditVaultDescription">Description</label>
              <input id="vaultEditVaultDescription" type="text" class="form-control settings-input vault-page-input" placeholder="What belongs in this vault">
            </div>
            <div class="vault-page-button-row">
              <button id="vaultRenameVaultBtn" class="modern-btn modern-btn-secondary" type="button">Save Vault Details</button>
              <button id="vaultDeleteVaultBtn" class="btn btn-outline-danger vault-page-danger-btn" type="button">Delete Vault</button>
            </div>
            <p class="vault-page-help">Deleting a vault permanently removes its encrypted records, grants, and explorer state.</p>
          </div>

          <div class="vault-page-divider"></div>

          <div class="vault-page-subsection">
            <h4 class="vault-page-subtitle">Create a new vault</h4>
            <p class="vault-page-help">Create a separately encrypted vault with its own password, then return to this page once it is ready.</p>
            <div class="vault-page-button-row vault-page-button-row-tight">
              <button id="vaultOpenCreateDialogBtn" class="modern-btn modern-btn-primary" type="button">Open Create Vault Dialog</button>
            </div>
          </div>
        </div>
      </section>

      <section class="vault-page-card">
        <div class="vault-page-card-head">
          <div>
            <div class="vault-page-eyebrow">Access Control</div>
            <h3 class="vault-page-card-title">Unlock or seal the selected vault</h3>
          </div>
        </div>

        <div class="vault-page-button-row vault-page-button-row-stacked vault-page-button-row-tight">
          <button id="vaultOpenUnlockBtn" class="modern-btn modern-btn-primary" type="button">Unlock Vault</button>
          <button id="vaultLockBtn" class="btn btn-outline-secondary" type="button">Lock Vault</button>
          <button id="vaultRefreshBtn" class="btn btn-outline-secondary" type="button">Refresh</button>
        </div>
      </section>

      <div id="vaultUnlockOverlay" class="vault-modal-unlock-overlay vault-page-unlock-overlay" hidden>
        <button type="button" class="vault-modal-unlock-backdrop" data-action="dismiss-page-unlock-dialog" aria-label="Close vault unlock dialog"></button>
        <div class="vault-modal-unlock-dialog vault-page-unlock-dialog" role="dialog" aria-modal="true" aria-labelledby="vaultUnlockDialogTitle">
          <div class="vault-modal-section-head">
            <span class="vault-modal-section-kicker">Unlock Vault</span>
            <h6 id="vaultUnlockDialogTitle" class="vault-modal-section-title">Unlock <span id="vaultUnlockDialogVaultName">Selected Vault</span></h6>
            <p id="vaultUnlockDialogDescription" class="vault-modal-section-description">Enter the password for the selected vault to load it inside Ori.</p>
          </div>

          <div class="vault-modal-field">
            <label class="vault-modal-label" for="vaultUnlockPassword">Vault password</label>
            <div class="input-group vault-modal-input-group">
              <input
                id="vaultUnlockPassword"
                type="password"
                class="form-control vault-modal-input"
                placeholder="Enter the selected vault password">
              <button class="btn btn-outline-secondary" type="button" id="toggleVaultUnlockPassword" aria-label="Toggle vault password visibility">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/>
                </svg>
              </button>
            </div>
            <div id="vaultUnlockPasswordHelp" class="vault-modal-help">
              Enter the password for the selected vault to unlock it.
            </div>
          </div>

          <div class="vault-modal-actions">
            <button id="vaultUnlockBtn" class="modern-btn modern-btn-primary" type="button">Unlock Vault</button>
            <button id="vaultUnlockCancelBtn" class="modern-btn modern-btn-secondary" type="button">Cancel</button>
          </div>
        </div>
      </div>

      <div id="vaultCreateOverlay" class="vault-modal-unlock-overlay vault-page-unlock-overlay" hidden>
        <button type="button" class="vault-modal-unlock-backdrop" data-action="dismiss-page-create-dialog" aria-label="Close create vault dialog"></button>
        <div class="vault-modal-unlock-dialog vault-modal-create-dialog vault-page-unlock-dialog" role="dialog" aria-modal="true" aria-labelledby="vaultCreateDialogTitle">
          <div class="vault-modal-section-head">
            <span class="vault-modal-section-kicker">New Vault</span>
            <h6 id="vaultCreateDialogTitle" class="vault-modal-section-title">Create New Vault</h6>
            <p id="vaultCreateDialogDescription" class="vault-modal-section-description">Create a separately encrypted vault with its own password.</p>
          </div>

          <div class="vault-modal-field">
            <label class="vault-modal-label" for="vaultNewVaultName">New vault name</label>
            <input id="vaultNewVaultName" type="text" class="form-control vault-modal-input" placeholder="Finance Vault, Travel Vault, Family Vault">
          </div>
          <div class="vault-modal-field">
            <label class="vault-modal-label" for="vaultNewVaultDescription">Description</label>
            <input id="vaultNewVaultDescription" type="text" class="form-control vault-modal-input" placeholder="Optional note about what belongs in this vault">
          </div>
          <div class="vault-modal-field">
            <label class="vault-modal-label" for="vaultNewVaultPassword">Vault password</label>
            <input id="vaultNewVaultPassword" type="password" class="form-control vault-modal-input" placeholder="Required for this vault">
          </div>
          <div class="vault-modal-field">
            <label class="vault-modal-label" for="vaultConfirmVaultPassword">Confirm vault password</label>
            <input id="vaultConfirmVaultPassword" type="password" class="form-control vault-modal-input" placeholder="Re-enter the vault password">
          </div>
          <div class="vault-modal-actions">
            <button id="vaultCreateVaultSpaceBtn" class="modern-btn modern-btn-primary" type="button">Create Vault</button>
            <button id="vaultCreateCancelBtn" class="modern-btn modern-btn-secondary" type="button">Cancel</button>
          </div>
          <div class="vault-modal-help">Each vault has its own password. Ori cannot recover it later.</div>
        </div>
      </div>
    </aside>

    <div class="vault-page-main">
      <section class="vault-page-card vault-page-card-primary">
        <div class="vault-page-card-head vault-page-card-head-wide">
          <div>
            <div class="vault-page-eyebrow">Entries Workspace</div>
            <h3 class="vault-page-card-title">Browse and edit encrypted entries</h3>
            <p class="vault-page-card-copy">Browse the selected vault as a protected folder tree, then load a record into the editor when you need to modify it. Payloads stay concealed until you explicitly reveal them.</p>
          </div>
          <span id="vaultSelectionBadge" class="vault-page-selection-badge">No selection</span>
        </div>

        <div class="vault-page-explorer">
          <div class="vault-page-explorer-head">
            <div class="vault-page-panel-copy">
              <h4 class="vault-page-subtitle">Folder explorer</h4>
              <p class="vault-page-help">Switch the active vault here, then browse its protected folder tree by type and workspace scope.</p>
            </div>

            <div class="vault-page-explorer-vault">
              <div class="vault-page-field">
                <label class="vault-page-label" for="vaultActiveVaultId">Active vault</label>
                <select id="vaultActiveVaultId" class="form-select settings-input vault-page-input">
                  <option value="">Loading vaults...</option>
                </select>
              </div>
              <div id="vaultActiveVaultMeta" class="vault-page-meta vault-page-explorer-meta">Checking available vaults...</div>
            </div>
          </div>

          <div class="vault-modal-records-toolbar vault-page-explorer-toolbar">
            <input id="vaultPageSearchInput" type="search" class="form-control settings-input vault-page-input vault-modal-search" placeholder="Search label, type, workspace, or tag">
            <span id="vaultPageRecordsSummary" class="vault-modal-records-summary">Waiting for vault status...</span>
          </div>

          <div id="vaultPageFolderVaultTabs" class="vault-modal-folder-vault-tabs" role="tablist" aria-label="Vault folders"></div>

          <div id="vaultPageFolderBreadcrumb" class="vault-modal-folder-breadcrumb" aria-label="Vault folder path" hidden></div>

          <div class="vault-modal-explorer-grid vault-page-explorer-grid">
            <div id="vaultPageFolderTree" class="vault-modal-folder-tree">
              <div class="vault-modal-empty">Unlock the vault to browse the encrypted folder tree.</div>
            </div>

            <div id="vaultPageExplorerPreview" class="vault-modal-explorer-preview">
              <div class="vault-modal-empty">Select a folder to inspect its encrypted contents.</div>
            </div>
          </div>
        </div>

        <div class="vault-page-divider"></div>

        <div class="vault-page-entry-grid">
          <div class="vault-page-list-panel">
            <div class="vault-page-panel-copy">
              <h4 class="vault-page-subtitle">Saved entries</h4>
              <p class="vault-page-help">Flat list of unlocked records for quick selection, regardless of the active folder view.</p>
            </div>
            <div id="vaultRecordsList" class="vault-page-records-list">
              <div class="vault-page-empty">Vault entries will appear here once the vault is unlocked.</div>
            </div>
          </div>

          <div class="vault-page-editor-panel">
            <div class="vault-page-panel-copy">
              <h4 class="vault-page-subtitle">Entry editor</h4>
              <p class="vault-page-help">Save sensitive notes, snippets, and secrets with structured metadata and a protected JSON payload.</p>
            </div>

            <div class="vault-page-field-grid">
              <div class="vault-page-field">
                <label class="vault-page-label" for="vaultEntryType">Entry type</label>
                <select id="vaultEntryType" class="form-select settings-input vault-page-input">
                  <option value="personal_note">Personal Note</option>
                  <option value="email_snippet">Email Snippet</option>
                  <option value="secret">Secret</option>
                </select>
              </div>

              <div class="vault-page-field">
                <label class="vault-page-label" for="vaultEntryWorkspaceId">Workspace ID</label>
                <input id="vaultEntryWorkspaceId" type="text" class="form-control settings-input vault-page-input" placeholder="Optional workspace scope">
              </div>
            </div>

            <div class="vault-page-field">
              <label class="vault-page-label" for="vaultEntryLabel">Label</label>
              <input id="vaultEntryLabel" type="text" class="form-control settings-input vault-page-input" placeholder="Passport copy, accountant email, family contacts">
            </div>

            <div class="vault-page-field-grid">
              <div class="vault-page-field">
                <label class="vault-page-label" for="vaultEntryTags">Sensitive tags</label>
                <input id="vaultEntryTags" type="text" class="form-control settings-input vault-page-input" placeholder="Comma-separated tags">
              </div>

              <div class="vault-page-field">
                <label class="vault-page-label" for="vaultEntrySource">Source</label>
                <input id="vaultEntrySource" type="text" class="form-control settings-input vault-page-input" placeholder="manual, connector, import">
              </div>
            </div>

            <div class="vault-page-field">
              <label class="vault-page-label" for="vaultEntryRetention">Retention policy</label>
              <input id="vaultEntryRetention" type="text" class="form-control settings-input vault-page-input" placeholder="keep_until_revoked">
            </div>

            <div class="vault-page-field">
              <label class="vault-page-label" for="vaultEntryPayload">Payload JSON</label>
              <textarea id="vaultEntryPayload" class="form-control settings-input vault-page-input vault-page-textarea" rows="10" spellcheck="false" placeholder='{"note":"private"}'></textarea>
            </div>

            <div class="vault-page-button-row">
              <button id="vaultSaveEntryBtn" class="modern-btn modern-btn-primary" type="button">Save To Vault</button>
              <button id="vaultResetEntryBtn" class="modern-btn modern-btn-secondary" type="button">New Entry</button>
              <button id="vaultRevealPayloadBtn" class="modern-btn modern-btn-secondary d-none" type="button">Reveal Payload</button>
              <button id="vaultDeleteEntryBtn" class="btn btn-outline-danger vault-page-danger-btn d-none" type="button">Delete Entry</button>
            </div>

            <p class="vault-page-help">Payloads stay hidden by default when you open an existing entry. Reveal the payload before editing its sensitive JSON body.</p>
          </div>
        </div>
      </section>

      <div class="vault-page-secondary-grid">
        <section class="vault-page-card">
          <div class="vault-page-card-head">
            <div>
              <div class="vault-page-eyebrow">Workspace Grants</div>
              <h3 class="vault-page-card-title">Grant or revoke persistent access</h3>
            </div>
          </div>

          <div class="vault-page-split-grid">
            <div>
              <div class="vault-page-field">
                <label class="vault-page-label" for="vaultGrantWorkspaceId">Workspace ID</label>
                <input id="vaultGrantWorkspaceId" type="text" class="form-control settings-input vault-page-input" placeholder="workspace-123">
              </div>
              <div class="vault-page-field-grid">
                <div class="vault-page-field">
                  <label class="vault-page-label" for="vaultGrantActorType">Actor type</label>
                  <select id="vaultGrantActorType" class="form-select settings-input vault-page-input">
                    <option value="agent">Agent</option>
                    <option value="plugin">Plugin</option>
                  </select>
                </div>
                <div class="vault-page-field">
                  <label class="vault-page-label" for="vaultGrantActorId">Actor ID</label>
                  <input id="vaultGrantActorId" type="text" class="form-control settings-input vault-page-input" placeholder="finance-agent">
                </div>
              </div>
              <div class="vault-page-field">
                <label class="vault-page-label" for="vaultGrantCapability">Capability</label>
                <select id="vaultGrantCapability" class="form-select settings-input vault-page-input">
                  <option value="vault.personal.read">vault.personal.read</option>
                  <option value="vault.personal.write">vault.personal.write</option>
                  <option value="vault.email.read_saved">vault.email.read_saved</option>
                  <option value="vault.email.write_saved">vault.email.write_saved</option>
                  <option value="vault.secrets.read">vault.secrets.read</option>
                  <option value="vault.secrets.write">vault.secrets.write</option>
                </select>
              </div>
              <div class="vault-page-field">
                <label class="vault-page-label" for="vaultGrantRecordType">Record type</label>
                <input id="vaultGrantRecordType" type="text" class="form-control settings-input vault-page-input" placeholder="email_snippet or *">
              </div>
              <div class="vault-page-button-row">
                <button id="vaultCreateGrantBtn" class="modern-btn modern-btn-primary" type="button">Add Persistent Grant</button>
              </div>
              <p class="vault-page-help">Persistent grants stay limited to one workspace. Leave record type blank to cover all entry types within that capability.</p>
            </div>

            <div>
              <div class="vault-page-panel-copy">
                <h4 class="vault-page-subtitle">Grant review</h4>
                <p class="vault-page-help">Audit the actors that can read or write into the currently selected vault.</p>
              </div>
              <div id="vaultGrantsList" class="vault-page-grants-list">
                <div class="vault-page-empty">No persistent grants loaded yet.</div>
              </div>
            </div>
          </div>
        </section>

        <section class="vault-page-card">
          <div class="vault-page-card-head">
            <div>
              <div class="vault-page-eyebrow">Portable Transfer</div>
              <h3 class="vault-page-card-title">Export or restore encrypted bundles</h3>
            </div>
          </div>

          <div class="vault-page-transfer-grid">
            <div class="vault-page-transfer-block">
              <h4 class="vault-page-subtitle">Encrypted export</h4>
              <p class="vault-page-help">Create a password-protected export bundle for the selected vault or a single workspace scope.</p>
              <div class="vault-page-button-row vault-page-button-row-tight">
                <button id="vaultOpenExportDialogBtn" class="modern-btn modern-btn-primary" type="button">Open Export Dialog</button>
              </div>
            </div>

            <div class="vault-page-transfer-block">
              <h4 class="vault-page-subtitle">Portable import</h4>
              <p class="vault-page-help">Bring an exported vault bundle back into Ori by creating a new vault or restoring into the current unlocked vault.</p>
              <div class="vault-page-button-row vault-page-button-row-tight">
                <button id="vaultOpenImportDialogBtn" class="modern-btn modern-btn-secondary" type="button">Open Import Dialog</button>
              </div>
            </div>
          </div>
        </section>
      </div>
    </div>
  </div>

  <div id="vaultExportOverlay" class="vault-modal-unlock-overlay vault-page-unlock-overlay" hidden>
    <button type="button" class="vault-modal-unlock-backdrop" data-action="dismiss-page-export-dialog" aria-label="Close vault export dialog"></button>
    <div class="vault-modal-unlock-dialog vault-modal-export-dialog vault-page-unlock-dialog" role="dialog" aria-modal="true" aria-labelledby="vaultExportDialogTitle">
      <div class="vault-modal-section-head">
        <span class="vault-modal-section-kicker">Portable Export</span>
        <h6 id="vaultExportDialogTitle" class="vault-modal-section-title">Export <span id="vaultExportDialogVaultName">Selected Vault</span></h6>
        <p id="vaultExportDialogDescription" class="vault-modal-section-description">Create an encrypted bundle you can move or archive outside this device.</p>
      </div>

      <div class="vault-modal-field">
        <label class="vault-modal-label" for="vaultExportWorkspaceId">Workspace filter</label>
        <input id="vaultExportWorkspaceId" type="text" class="form-control vault-modal-input" placeholder="Optional workspace scope">
        <div class="vault-modal-help">Leave blank to export the full selected vault.</div>
      </div>

      <div class="vault-modal-field">
        <label class="vault-modal-label" for="vaultExportPassword">Export password</label>
        <input id="vaultExportPassword" type="password" class="form-control vault-modal-input" placeholder="Used to encrypt the export bundle">
      </div>

      <label class="vault-modal-checkbox">
        <input type="checkbox" id="vaultExportConfirm">
        <span>I understand this export contains encrypted private data and should be handled carefully.</span>
      </label>

      <div class="vault-modal-actions">
        <button id="vaultExportBtn" class="modern-btn modern-btn-primary" type="button">Export Vault</button>
        <button id="vaultExportCancelBtn" class="modern-btn modern-btn-secondary" type="button">Cancel</button>
      </div>

      <div class="vault-modal-help">The downloaded file stays encrypted with the export password you set here.</div>
    </div>
  </div>

  <div id="vaultImportOverlay" class="vault-modal-unlock-overlay vault-page-unlock-overlay" hidden>
    <button type="button" class="vault-modal-unlock-backdrop" data-action="dismiss-page-import-dialog" aria-label="Close vault import dialog"></button>
    <div class="vault-modal-unlock-dialog vault-modal-import-dialog vault-page-unlock-dialog" role="dialog" aria-modal="true" aria-labelledby="vaultImportDialogTitle">
      <div class="vault-modal-section-head">
        <span class="vault-modal-section-kicker">Portable Import</span>
        <h6 id="vaultImportDialogTitle" class="vault-modal-section-title">Import Vault Bundle</h6>
        <p id="vaultImportDialogDescription" class="vault-modal-section-description">Bring an exported vault bundle back into Ori by creating a new vault or loading it into the current unlocked vault.</p>
      </div>

      <div class="vault-modal-field">
        <div class="vault-modal-field-head">
          <label class="vault-modal-label" for="vaultImportFile">Export bundle</label>
          <button id="vaultImportChooseFileBtn" class="modern-btn modern-btn-secondary" type="button">Choose File</button>
        </div>
        <input id="vaultImportFile" type="file" accept=".json,application/json" hidden>
        <div id="vaultImportFileName" class="vault-modal-file-name">No import file selected yet.</div>
      </div>

      <div class="vault-modal-field">
        <label class="vault-modal-label" for="vaultImportPassword">Import password</label>
        <input id="vaultImportPassword" type="password" class="form-control vault-modal-input" placeholder="Used to decrypt the export bundle">
        <div class="vault-modal-help">This is the password that encrypts the portable bundle, not the vault password inside Ori.</div>
      </div>

      <div class="vault-modal-field">
        <label class="vault-modal-label" for="vaultImportMode">Import target</label>
        <select id="vaultImportMode" class="form-select vault-modal-select">
          <option value="new">Create a new vault</option>
          <option id="vaultImportModeCurrentOption" value="current">Import into the selected vault</option>
        </select>
      </div>

      <div id="vaultImportCurrentHint" class="vault-modal-help">The selected vault must already be unlocked before Ori can import records into it.</div>

      <div id="vaultImportCreateFields" class="vault-modal-stack">
        <div class="vault-modal-field">
          <label class="vault-modal-label" for="vaultImportVaultName">New vault name</label>
          <input id="vaultImportVaultName" type="text" class="form-control vault-modal-input" placeholder="Leave blank to use the bundle vault name">
        </div>
        <div class="vault-modal-field">
          <label class="vault-modal-label" for="vaultImportVaultDescription">Description</label>
          <input id="vaultImportVaultDescription" type="text" class="form-control vault-modal-input" placeholder="Optional note for the imported vault">
        </div>
        <div class="vault-modal-field">
          <label class="vault-modal-label" for="vaultImportVaultPassword">New vault password</label>
          <input id="vaultImportVaultPassword" type="password" class="form-control vault-modal-input" placeholder="Required for the imported vault">
        </div>
        <div class="vault-modal-field">
          <label class="vault-modal-label" for="vaultImportConfirmVaultPassword">Confirm vault password</label>
          <input id="vaultImportConfirmVaultPassword" type="password" class="form-control vault-modal-input" placeholder="Re-enter the vault password">
        </div>
      </div>

      <label class="vault-modal-checkbox">
        <input type="checkbox" id="vaultImportRestoreGrants" checked>
        <span>Restore workspace access grants from the bundle when they are available.</span>
      </label>

      <div class="vault-modal-actions">
        <button id="vaultImportBtn" class="modern-btn modern-btn-primary" type="button">Import Vault</button>
        <button id="vaultImportCancelBtn" class="modern-btn modern-btn-secondary" type="button">Cancel</button>
      </div>
    </div>
  </div>
</section>
