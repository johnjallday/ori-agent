{{define "ori-guide.tmpl"}}
<!-- Help explains the app. The Personal Assistant owns conversations and work.
     Mounted once through the navbar, including standalone authenticated shells. -->
<div class="ori-guide" id="oriGuideRoot">

  <section
    class="ori-guide__panel"
    id="oriGuidePanel"
    role="dialog"
    aria-labelledby="oriGuideTitle"
    data-state="ready"
    hidden>
    <header class="ori-guide__header">
      <!-- Ori's character belongs to fixed walkthroughs, not ordinary Help. -->
      <img
        id="oriGuideQuestPortrait"
        class="ori-guide__portrait"
        hidden
        src="/characters/ori-guide/static.svg"
        alt=""
        width="40"
        height="40"
        decoding="async">
      <div class="ori-guide__ident">
        <h2 class="ori-guide__title" id="oriGuideTitle">Help</h2>
        <p class="ori-guide__context" id="oriGuideContext">This screen</p>
      </div>
      <button
        type="button"
        class="ori-guide__close"
        id="oriGuideClose"
        aria-label="Close Help">&times;</button>
    </header>

    <div id="oriGuideOverview" class="ori-guide__overview">
      <section aria-labelledby="oriGuideAboutTitle">
        <h3 id="oriGuideAboutTitle" class="ori-guide__section-title">About this screen</h3>
        <p id="oriGuideAbout">Loading screen guidance…</p>
      </section>
      <section aria-labelledby="oriGuideCommonTitle">
        <h3 id="oriGuideCommonTitle" class="ori-guide__section-title">Common questions</h3>
        <div id="oriGuideTopics" class="ori-guide__topics"></div>
      </section>
      <section aria-labelledby="oriGuideWalkthroughTitle">
        <h3 id="oriGuideWalkthroughTitle" class="ori-guide__section-title">Walkthroughs</h3>
        <div id="oriGuideWalkthroughs">Checking available walkthroughs…</div>
      </section>
    </div>

    <form class="ori-guide__form" id="oriGuideForm" method="post">
      <label class="ori-guide__search-label" for="oriGuideInput">Search help</label>
      <input
        type="text"
        class="ori-guide__input"
        id="oriGuideInput"
        name="question"
        maxlength="400"
        autocomplete="off"
        aria-describedby="oriGuideSearchHint"
        placeholder="Search app topics…">
      <button type="submit" class="ori-guide__send" id="oriGuideSend">Search</button>
    </form>

    <p id="oriGuideSearchHint" class="ori-guide__hint">Reviewed topics, not full-text documentation search.</p>

    <!-- aria-live so an answer arriving without a focus change is still
         announced (FR70). -->
    <div
      class="ori-guide__reply"
      id="oriGuideReply"
      role="status"
      aria-label="Help result"
      aria-live="polite"
      aria-atomic="true"></div>

  </section>

  <!-- The Personal Assistant owns the primary work composer and the single
       activity host from initial render, even before relationship status loads.
       Routing, planning, and confirmation logic are reused rather than copied.

       The drawer is ONE view, on every page: header, then a region that
       scrolls (what needs you, then the conversation), then the composer, which
       is always visible at the bottom. There are no tabs. Home adds the Today
       projection at the top of the scrolling region; every other page shows the
       conversation alone. -->
  <button type="button" class="personal-assistant-launcher" id="personalAssistantLauncher"
          aria-expanded="false" aria-controls="personalAssistantPanel" hidden>
    <span id="personalAssistantLauncherAvatar" class="personal-assistant-launcher__avatar" aria-hidden="true"></span>
    <span class="personal-assistant-launcher__copy">
      <span id="personalAssistantLauncherName" class="personal-assistant-launcher__name">Personal assistant</span>
      <span class="personal-assistant-launcher__role">Personal Assistant</span>
      <span id="personalAssistantLauncherStatus" class="personal-assistant-launcher__status" hidden></span>
      <span id="personalAssistantWorkStatus" class="personal-assistant-launcher__status" hidden></span>
    </span>
  </button>
  <section id="personalAssistantPanel" class="personal-assistant-panel" role="dialog"
           aria-labelledby="personalAssistantPanelTitle" hidden>
    <header class="personal-assistant-panel__header">
      <span id="personalAssistantPanelAvatar" class="personal-assistant-panel__avatar" aria-hidden="true"></span>
      <div class="personal-assistant-panel__ident">
        <h2 id="personalAssistantPanelTitle" class="personal-assistant-panel__title">Personal assistant</h2>
        <!-- When the next check-in is. "Personal Assistant" until that is known. -->
        <p id="personalAssistantCheckIn" class="personal-assistant-panel__checkin">Personal Assistant</p>
      </div>
      <details id="personalAssistantMore" class="personal-assistant-panel__more">
        <summary class="personal-assistant-panel__icon" aria-label="More assistant options">
          <i class="bi bi-three-dots" aria-hidden="true"></i>
        </summary>
        <nav class="personal-assistant-panel__links" aria-label="Personal assistant details">
          <a id="personalAssistantTodayHQ" href="/" hidden>Personal HQ</a>
          <a id="personalAssistantTodayAgreement" href="/" hidden>Working agreement</a>
          <a id="personalAssistantTodayMemory" href="/" hidden>Workspace memory</a>
          <a href="/profile#personalHQKnowledge">Review remembered facts</a>
          <a id="personalAssistantTodayInterview" href="/profile#personalHQInterview" hidden>Optional interview</a>
          <a id="personalAssistantTodayAdvanced" href="/agents">Manage agents</a>
          <button type="button" id="personalAssistantCreateWorkspace">Open workspace form manually</button>
          <p class="personal-assistant-panel__history-note">Conversations are kept in Personal HQ until you delete them. History is not memory; remembering a fact requires your review.</p>
        </nav>
      </details>
      <button type="button" id="personalAssistantClose" class="personal-assistant-panel__icon"
              aria-label="Close personal assistant">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </header>

    <div id="personalAssistantExplorerToolbar" class="personal-assistant-explorer__toolbar" hidden>
      <button type="button" id="personalAssistantExplorerBack" class="personal-assistant-conversation__button">← Back to chat</button>
      <div class="personal-assistant-explorer__tabs" role="group" aria-label="Folder exploration view">
        <button type="button" id="personalAssistantExplorerTreeTab" aria-pressed="true" aria-controls="personalAssistantFolderExplorer">Tree</button>
        <button type="button" id="personalAssistantExplorerChatTab" aria-pressed="false" aria-controls="personalAssistantScroll">Chat</button>
      </div>
    </div>
    <div class="personal-assistant-explorer__workbench">
      <aside id="personalAssistantFolderExplorer" class="personal-assistant-explorer__pane" aria-labelledby="personalAssistantFolderExplorerName" hidden>
        <div id="personalAssistantFolderExplorerHeader" class="personal-assistant-explorer__header">
          <div class="personal-assistant-explorer__heading">
            <h3 id="personalAssistantFolderExplorerName"></h3>
            <label id="personalAssistantFolderSelection" class="personal-assistant-folder-tree__select-all">
              <input type="checkbox" id="personalAssistantFolderSelectAll" aria-controls="personalAssistantFolderTree" aria-describedby="personalAssistantFolderSelectionStatus" disabled>
              <span>Select all</span>
            </label>
          </div>
          <p id="personalAssistantFolderSelectionStatus" class="personal-assistant-explorer__hint" role="status" aria-live="polite"></p>
        </div>
        <div class="personal-assistant-explorer__body">
          <p id="personalAssistantFolderExplorerStatus" class="personal-assistant-explorer__eyebrow"></p>
          <p class="personal-assistant-explorer__hint">Contents not read. Send shares metadata with your model. Checks set topics—not access, a privacy filter or descendants.</p>
          <details class="personal-assistant-explorer__coverage">
            <summary id="personalAssistantFolderExplorerCoverageSummary">Bounded snapshot</summary>
            <p id="personalAssistantFolderExplorerCoverage" class="personal-assistant-explorer__hint"></p>
          </details>
          <p id="personalAssistantExplorerNotice" class="personal-assistant-explorer__hint" role="status" aria-live="polite"></p>
          <ul id="personalAssistantFolderTree" class="personal-assistant-folder-tree" aria-label="Recorded folder and file discussion topics"></ul>
        </div>
      </aside>
    <!-- The existing conversation scrolls here; no second transcript/composer. -->
    <div id="personalAssistantScroll" class="personal-assistant-panel__scroll">
      {{if eq .CurrentPage "index"}}
      {{template "personal-assistant-today.tmpl" .}}
      {{else}}
      <!-- What needs the user is listed on Home. Every other page says only how
           much there is, in one line that goes there. Hidden when nothing does;
           when the number cannot be read it still points at Home. -->
      <a id="personalAssistantNeedsLine" class="personal-assistant-panel__needs"
         href="/?panel=today" hidden>
        <span id="personalAssistantNeedsLineText"></span>
        <i class="bi bi-chevron-right" aria-hidden="true"></i>
      </a>
      {{end}}

      <!-- The conversation this tab is in. The status note is reserved for
           unsaved history, truncation and recovery, not routine idle copy. -->
      <div id="personalAssistantConversationBar" class="personal-assistant-conversation" hidden>
        <div class="personal-assistant-conversation__head">
          <p class="personal-assistant-conversation__current">
            <span id="personalAssistantConversationTitle" class="personal-assistant-conversation__title">New conversation</span>
          </p>
          <div class="personal-assistant-conversation__actions">
            <button type="button" id="personalAssistantConversationNew"
                    class="personal-assistant-conversation__button" aria-label="New conversation">New</button>
            <button type="button" id="personalAssistantConversationContinue"
                    class="personal-assistant-conversation__button"
                    aria-expanded="false" aria-controls="personalAssistantConversationList">Continue…</button>
          </div>
        </div>
        <ul id="personalAssistantConversationList" class="personal-assistant-conversation__list"
            aria-label="Earlier conversations" hidden></ul>
        <p id="personalAssistantConversationNote" class="personal-assistant-conversation__note"
           role="status" aria-live="polite"></p>
        <!-- The saved draft this conversation is working on, read from Personal
             HQ. Replies are not part of it until Update saved draft is chosen. -->
        <div id="personalAssistantSavedDraft" class="personal-assistant-conversation__saved" hidden>
          <p id="personalAssistantSavedDraftText" class="personal-assistant-conversation__note"></p>
          <div class="personal-assistant-conversation__actions">
            <a id="personalAssistantSavedDraftOpen" class="personal-assistant-conversation__button" href="#" hidden>Open in Personal HQ</a>
            <button type="button" id="personalAssistantSavedDraftStart"
                    class="personal-assistant-conversation__button" hidden>Start a new conversation about it</button>
          </div>
        </div>
      </div>
      <!-- Save to HQ backlog: the review of one reply before it is saved. It is
           its own form, so Enter here can never send the composer. Opening it
           writes nothing; only Save to backlog does. -->
      <form id="personalAssistantDraftReview" class="personal-assistant-review"
            aria-labelledby="personalAssistantDraftReviewHeading" hidden novalidate>
        <h3 id="personalAssistantDraftReviewHeading" class="personal-assistant-review__heading">Save to HQ backlog</h3>
        <p id="personalAssistantDraftTarget" class="personal-assistant-review__target"></p>
        <div data-draft-view="edit" class="personal-assistant-review__fields">
          <!-- Update saved draft only: the text that is saved now, to compare
               with the proposal below. -->
          <details id="personalAssistantDraftCurrent" class="personal-assistant-review__current" hidden>
            <summary id="personalAssistantDraftCurrentLabel">Currently saved</summary>
            <pre id="personalAssistantDraftCurrentText" class="personal-assistant-review__current-text"></pre>
          </details>
          <label class="personal-assistant-review__label" for="personalAssistantDraftTitle">Title</label>
          <input type="text" id="personalAssistantDraftTitle" class="personal-assistant-review__input"
                 autocomplete="off" aria-describedby="personalAssistantDraftTitleHint">
          <p id="personalAssistantDraftTitleHint" class="personal-assistant-review__hint"></p>
          <label id="personalAssistantDraftBodyLabel" class="personal-assistant-review__label" for="personalAssistantDraftBody">Draft</label>
          <textarea id="personalAssistantDraftBody" class="personal-assistant-review__input personal-assistant-review__body"
                    rows="7" aria-describedby="personalAssistantDraftBodyHint"></textarea>
          <p id="personalAssistantDraftBodyHint" class="personal-assistant-review__hint"></p>
          <ul id="personalAssistantDraftNotes" class="personal-assistant-review__notes" hidden></ul>
          <div class="personal-assistant-review__actions">
            <button type="submit" id="personalAssistantDraftSave" class="personal-assistant-review__primary">Save to backlog</button>
            <button type="button" id="personalAssistantDraftCancel" class="personal-assistant-review__secondary">Cancel</button>
          </div>
        </div>
        <div data-draft-view="receipt" class="personal-assistant-review__fields" hidden>
          <p id="personalAssistantDraftReceipt" class="personal-assistant-review__receipt"></p>
          <div class="personal-assistant-review__actions">
            <a id="personalAssistantDraftOpen" class="personal-assistant-review__primary" href="#">Open in Personal HQ</a>
            <button type="button" id="personalAssistantDraftDone" class="personal-assistant-review__secondary">Done</button>
          </div>
        </div>
        <p id="personalAssistantDraftStatus" class="personal-assistant-review__status" role="status" aria-live="polite"></p>
      </form>
      <!-- Remember…: the review of one personal fact. It is a different action
           from saving a draft: one line the assistant may use again, kept in
           Personal HQ memory. Opening it writes nothing. -->
      <form id="personalAssistantMemoryReview" class="personal-assistant-review"
            aria-labelledby="personalAssistantMemoryReviewHeading" hidden novalidate>
        <h3 id="personalAssistantMemoryReviewHeading" class="personal-assistant-review__heading">Remember a fact</h3>
        <p class="personal-assistant-review__target">Kept in Personal HQ memory, where you can edit or forget it. This does not save a draft or add anything to your backlog.</p>
        <div data-memory-view="edit" class="personal-assistant-review__fields">
          <p id="personalAssistantMemorySource" class="personal-assistant-review__hint" hidden></p>
          <label class="personal-assistant-review__label" for="personalAssistantMemoryText">Fact to remember</label>
          <input type="text" id="personalAssistantMemoryText" class="personal-assistant-review__input"
                 autocomplete="off" placeholder="One fact, in your own words"
                 aria-describedby="personalAssistantMemoryLimit personalAssistantMemoryProblem personalAssistantMemoryHint">
          <p id="personalAssistantMemoryLimit" class="personal-assistant-review__hint">0 / 500 UTF-8 bytes</p>
          <p id="personalAssistantMemoryProblem" class="personal-assistant-review__hint personal-assistant-review__problem" role="status" aria-live="polite"></p>
          <p id="personalAssistantMemoryHint" class="personal-assistant-review__hint" hidden></p>
          <label class="personal-assistant-review__label" for="personalAssistantMemoryCategory">Kind of fact</label>
          <select id="personalAssistantMemoryCategory" class="personal-assistant-review__input"></select>
          <div class="personal-assistant-review__actions">
            <button type="submit" id="personalAssistantMemorySave" class="personal-assistant-review__primary">Remember this fact</button>
            <button type="button" id="personalAssistantMemoryCancel" class="personal-assistant-review__secondary">Cancel</button>
          </div>
        </div>
        <div data-memory-view="receipt" class="personal-assistant-review__fields" hidden>
          <p id="personalAssistantMemoryReceipt" class="personal-assistant-review__receipt"></p>
          <div class="personal-assistant-review__actions">
            <a id="personalAssistantMemoryFacts" class="personal-assistant-review__primary" href="/profile#personalHQKnowledge">Review, edit, or forget it</a>
            <button type="button" id="personalAssistantMemoryDone" class="personal-assistant-review__secondary">Done</button>
          </div>
        </div>
        <p id="personalAssistantMemoryStatus" class="personal-assistant-review__status" role="status" aria-live="polite"></p>
      </form>
      <section id="personalAssistantRecoveredHandoff" class="personal-assistant-folder-context"
               aria-labelledby="personalAssistantRecoveredHandoffTitle" hidden>
        <h3 id="personalAssistantRecoveredHandoffTitle">Unsent request from an earlier visit</h3>
        <p id="personalAssistantRecoveredHandoffText"></p>
        <p>Review it in an empty composer, then Send when ready. Nothing has been sent.</p>
        <button type="button" id="personalAssistantRecoverHandoff" class="personal-assistant-conversation__button">Review request</button>
        <button type="button" id="personalAssistantDismissHandoff" class="personal-assistant-conversation__button">Dismiss request</button>
      </section>
      {{if ne .CurrentPage "index"}}
      {{template "assistant-led-setup.tmpl" .}}
      {{end}}
      <!-- The conversation: routing, planning, confirmations and replies land
           here once a request is sent, and on Home the folder flow runs here
           as a turn of its own. Nothing is shown while it is idle. Whichever
           of the two was used last is kept nearest the composer. -->
      <div id="personalAssistantThread" class="personal-assistant-panel__thread">
        <div id="personalAssistantActivityMount" class="personal-assistant-panel__activity">
          {{template "ask-ori-activity.tmpl" .}}
        </div>
        {{template "personal-assistant-folder.tmpl" .}}
      </div>
      <section id="personalAssistantContextChooser" class="personal-assistant-folder-context" aria-labelledby="personalAssistantFolderChooserTitle" hidden>
        <h3 id="personalAssistantFolderChooserTitle">Add folder context</h3>
        <p>Ori locally records bounded file/folder names, relationships, kinds, counts, project markers, scan time and coverage. File contents are not read. Send shares this metadata with your configured model; selecting stays local.</p>
        <div id="personalAssistantFolderChoices" class="personal-assistant-panel__chips"></div>
        <button type="button" id="personalAssistantFolderChooserCancel" class="personal-assistant-conversation__button">Cancel</button>
      </section>
      <div id="personalAssistantContextProgress"></div>
      <section id="personalAssistantFolderPreview" class="personal-assistant-folder-context" aria-label="Local folder preview" hidden>
        <div id="personalAssistantFolderSummary"></div>
        <p>Send your question, or send “Explore this folder” to discuss this snapshot. No workspace is created.</p>
      </section>
      <section id="personalAssistantFolderDiscussionChooser" class="personal-assistant-folder-context" aria-labelledby="personalAssistantFolderDiscussionLabel" hidden>
        <label id="personalAssistantFolderDiscussionLabel" for="personalAssistantFolderDiscussionCandidate">Which observed folder would you like to discuss?</label>
        <select id="personalAssistantFolderDiscussionCandidate" class="form-select" required></select>
        <p class="personal-assistant-folder-context__note">Only prepares an editable question. Does not change the attachment, choose setup or read files. Identical names and markers cannot identify a distinct folder here.</p>
        <button type="button" id="personalAssistantFolderDiscussionDraft" class="personal-assistant-conversation__button">Draft question</button>
        <button type="button" id="personalAssistantFolderDiscussionCancel" class="personal-assistant-conversation__button">Cancel</button>
      </section>
      <section id="personalAssistantFolderSetupChoices" class="personal-assistant-folder-context" aria-label="Choose what to set up" hidden>
        <h3 class="personal-assistant-setup-heading">Setting up</h3>
        <label for="personalAssistantFolderSetupCandidate">Choose one observed folder for this setup review</label>
        <p class="personal-assistant-folder-context__note">Discussion topics do not select this scope. Whole folder and one observed child are different choices; no descendants or batch of workspaces are selected.</p>
        <select id="personalAssistantFolderSetupCandidate" class="form-select form-select-sm" required></select>
        <p class="personal-assistant-folder-context__note">This saves a setup review in this conversation. It sends nothing to a model and creates nothing until you confirm.</p>
        <button type="button" id="personalAssistantFolderSetupReview" class="btn btn-sm btn-outline-secondary">Review selection</button>
        <button type="button" id="personalAssistantFolderSetupCancel" class="btn btn-sm btn-link">Keep chatting</button>
      </section>
      <p id="personalAssistantFolderHistorical" class="personal-assistant-folder-context__note" hidden></p>
      <p id="personalAssistantFolderReviewStatus" class="personal-assistant-folder-context__note" role="status" aria-live="polite" hidden></p>
      <p id="personalAssistantContextStatus" class="personal-assistant-folder-context__note" role="status" aria-live="polite"></p>
    </div>

    </div><!-- explorer workbench -->
    <!-- The composer stays pinned and shared by Tree/Chat on every page. -->
    <div id="personalAssistantFolderFocus" class="personal-assistant-folder-focus" hidden>
      <span id="personalAssistantFolderFocusText" role="status" aria-live="polite"></span>
      <button type="button" id="personalAssistantFolderFocusClear" class="personal-assistant-conversation__button" hidden>Clear checks</button>
    </div>
    <button type="button" id="personalAssistantNewReply" class="personal-assistant-transcript__jump"
            aria-controls="homeAssistantConversation" hidden>New reply</button>
    <span id="personalAssistantReplyAnnouncement" class="visually-hidden" role="status" aria-live="polite"></span>
    <p id="personalAssistantWorkspaceContext" class="personal-assistant-panel__context" role="status" aria-live="polite" aria-atomic="true">Checking workspace context…</p>
    <p id="personalAssistantPanelStatus" class="personal-assistant-panel__status" role="status" aria-live="polite"></p>
    <a id="personalAssistantModelSetup" class="personal-assistant-conversation__button" href="/settings#system-model" hidden>Configure a model for conversational replies</a>
    <form id="personalAssistantForm" class="personal-assistant-panel__form">
      <div id="personalAssistantChips" class="personal-assistant-panel__chips personal-assistant-panel__attachments" hidden>
        <button type="button" id="personalAssistantFolderChip" class="personal-assistant-panel__chip" aria-expanded="false" aria-controls="personalAssistantContextChooser">
          <i class="bi bi-folder2-open" aria-hidden="true"></i>
          <span>Add folder</span>
        </button>
        <span id="personalAssistantActiveFolder" class="personal-assistant-folder-context__chip" hidden>
          <span id="personalAssistantActiveFolderName"></span>
          <button type="button" id="personalAssistantRemoveFolder" aria-label="Remove folder context">×</button>
        </span>
        <button type="button" id="personalAssistantExploreAttachedFolder" class="personal-assistant-panel__chip" aria-expanded="false" aria-controls="personalAssistantFolderExplorer" hidden>Tree + Chat</button>
        <button type="button" id="personalAssistantReviewFolderSetup" class="btn btn-sm btn-link" aria-label="Review workspace setup" aria-controls="personalAssistantFolderSetupChoices" aria-expanded="false" hidden>Review setup</button>
        <span id="personalAssistantFolderSendHint" class="personal-assistant-folder-context__note" hidden>Empty Send: “Explore this folder”</span>
      </div>
      <label class="visually-hidden" for="personalAssistantInput">Ask your personal assistant a question or describe work</label>
      <textarea id="personalAssistantInput" class="personal-assistant-panel__input" rows="2"
                maxlength="2000" autocomplete="off"
                placeholder="Ask a question or describe what you want help with"></textarea>
      <button type="submit" id="personalAssistantSend" class="personal-assistant-panel__send">Send</button>
    </form>
  </section>
</div>
{{end}}
