{{define "ori-guide.tmpl"}}
<!--
  Ask Ori — the one assistance surface, mounted once for every authenticated page.

  It used to be deliberately separate from the Home command box, which was a
  second assistant called Workspace Manager. That split made users learn an
  internal product distinction before they could decide where to type, so
  Issue #350 merged them: one launcher, one panel, one composer, and automatic
  routing behind it.

  Automatic routing is not automatic authorization. Navigation still goes
  through the structurally read-only guide contract, and work still goes through
  the existing planning, confirmation, and agent paths (FR27/FR36).

  The panel is non-modal on wide layouts so the destination Ori is describing
  stays visible behind it (FR66).
-->
<div class="ori-guide" id="oriGuideRoot">
  <button
    type="button"
    class="ori-guide__launcher"
    id="oriGuideLauncher"
    aria-expanded="false"
    aria-controls="oriGuidePanel"
    aria-label="Ask Ori">
    <img
      class="ori-guide__sprite"
      src="/characters/ori-guide/sprite.svg"
      alt=""
      width="32"
      height="32"
      decoding="async">
    <span class="ori-guide__launcher-text">
      <span class="ori-guide__launcher-name">Ask Ori</span>
      <!-- Busy/attention state lives on the launcher so running work is visible
           without creating a second prompt entry point (FR14). -->
      <span class="ori-guide__launcher-status" id="oriGuideLauncherStatus" hidden></span>
    </span>
  </button>

  <section
    class="ori-guide__panel"
    id="oriGuidePanel"
    role="dialog"
    aria-labelledby="oriGuideTitle"
    data-state="ready"
    hidden>
    <header class="ori-guide__header">
      <img
        class="ori-guide__portrait"
        src="/characters/ori-guide/static.svg"
        alt=""
        width="40"
        height="40"
        decoding="async">
      <div class="ori-guide__ident">
        <h2 class="ori-guide__title" id="oriGuideTitle">Ask Ori</h2>
        <p class="ori-guide__role" id="oriGuideRole" hidden>App Guide</p>
        <!-- Context, not a competing role name. Conveyed as text so it does not
             depend on color alone (FR64). Filled in by the controller from the
             current page, workspace, or task. -->
        <p class="ori-guide__context" id="oriGuideContext">All workspaces</p>
      </div>
      <button
        type="button"
        class="ori-guide__close"
        id="oriGuideClose"
        aria-label="Close Ask Ori">&times;</button>
    </header>

    <!-- The ordered record of this conversation: prompts, routing summaries,
         confirmations, and outcomes in the order they happened (FR40). It is not
         a live region — the bounded status line below is what gets announced, so
         a screen reader is never read the whole transcript again (FR73). -->
    <ol class="ori-guide__activity" id="oriGuideActivity" hidden></ol>

    <form class="ori-guide__form" id="oriGuideForm">
      <label class="visually-hidden" for="oriGuideInput">Ask a question or describe what you want done</label>
      <input
        type="text"
        class="ori-guide__input"
        id="oriGuideInput"
        maxlength="400"
        autocomplete="off"
        placeholder="Ask Ori about the app">
      <button type="submit" class="ori-guide__send" id="oriGuideSend">Send</button>
    </form>

    <!-- aria-live so an answer arriving without a focus change is still
         announced (FR70). -->
    <div
      class="ori-guide__reply"
      id="oriGuideReply"
      role="status"
      aria-live="polite"></div>

    <!-- The work-path render targets. Real planning, confirmations, and the
         workspace conversation land here through the existing controller, in
         the same panel as the question that started them (FR39). -->
    {{template "ask-ori-activity.tmpl" .}}
  </section>

  <!-- The personal assistant gets one separate primary work composer. The
       existing work activity node above is moved into this host after the
       authoritative relationship read, so routing, planning, and confirmation
       logic are reused rather than copied. -->
  <button type="button" class="personal-assistant-launcher" id="personalAssistantLauncher"
          aria-expanded="false" aria-controls="personalAssistantPanel" hidden>
    <span id="personalAssistantLauncherAvatar" class="personal-assistant-launcher__avatar" aria-hidden="true"></span>
    <span class="personal-assistant-launcher__copy">
      <span id="personalAssistantLauncherName" class="personal-assistant-launcher__name">Personal assistant</span>
      <span class="personal-assistant-launcher__role">Personal Assistant</span>
      <span id="personalAssistantLauncherStatus" class="personal-assistant-launcher__status" hidden></span>
    </span>
  </button>
  <section id="personalAssistantPanel" class="personal-assistant-panel" role="dialog"
           aria-labelledby="personalAssistantPanelTitle" hidden>
    <header class="personal-assistant-panel__header">
      <span id="personalAssistantPanelAvatar" class="personal-assistant-panel__avatar" aria-hidden="true"></span>
      <div>
        <h2 id="personalAssistantPanelTitle" class="personal-assistant-panel__title">Personal assistant</h2>
        <p class="personal-assistant-panel__role">Personal Assistant</p>
      </div>
      <button type="button" id="personalAssistantClose" class="personal-assistant-panel__close"
              aria-label="Close personal assistant">&times;</button>
    </header>

    {{if eq .CurrentPage "index"}}
    <div id="personalAssistantTabs" class="personal-assistant-panel__tabs" role="tablist"
         aria-label="Personal assistant views">
      <button type="button" id="personalAssistantTodayTab" class="personal-assistant-panel__tab"
              role="tab" aria-selected="true" aria-controls="personalAssistantTodayPanel">Today</button>
      <button type="button" id="personalAssistantAskTab" class="personal-assistant-panel__tab"
              role="tab" aria-selected="false" aria-controls="personalAssistantAskPanel" tabindex="-1">Ask</button>
    </div>
    <div id="personalAssistantTodayPanel" class="personal-assistant-panel__view personal-assistant-panel__view--today"
         role="tabpanel" aria-labelledby="personalAssistantTodayTab">
      {{template "personal-assistant-today.tmpl" .}}
    </div>
    {{end}}

    <div id="personalAssistantAskPanel" class="personal-assistant-panel__view personal-assistant-panel__view--ask"
         {{if eq .CurrentPage "index"}}role="tabpanel" aria-labelledby="personalAssistantAskTab" hidden{{end}}>
      <form id="personalAssistantForm" class="personal-assistant-panel__form">
        <label class="visually-hidden" for="personalAssistantInput">Ask your personal assistant a question or describe work</label>
        <textarea id="personalAssistantInput" class="personal-assistant-panel__input" rows="3"
                  maxlength="2000" autocomplete="off"
                  placeholder="Ask a question or describe what you want help with"></textarea>
        <button type="submit" id="personalAssistantSend" class="personal-assistant-panel__send">Send</button>
      </form>
      <p id="personalAssistantPanelStatus" class="personal-assistant-panel__status" role="status" aria-live="polite"></p>
      <!-- The conversation this tab is in. A conversation is a session in
           Personal HQ; this bar only starts a new one or continues an earlier
           one. Its note keeps history and long-term memory apart. -->
      <div id="personalAssistantConversationBar" class="personal-assistant-conversation" hidden>
        <div class="personal-assistant-conversation__head">
          <p class="personal-assistant-conversation__current">
            <span class="personal-assistant-conversation__eyebrow">Conversation</span>
            <span id="personalAssistantConversationTitle" class="personal-assistant-conversation__title">New conversation</span>
          </p>
          <div class="personal-assistant-conversation__actions">
            <button type="button" id="personalAssistantConversationNew"
                    class="personal-assistant-conversation__button">New conversation</button>
            <button type="button" id="personalAssistantConversationContinue"
                    class="personal-assistant-conversation__button"
                    aria-expanded="false" aria-controls="personalAssistantConversationList">Continue…</button>
          </div>
        </div>
        <ul id="personalAssistantConversationList" class="personal-assistant-conversation__list"
            aria-label="Earlier conversations" hidden></ul>
        <p id="personalAssistantConversationNote" class="personal-assistant-conversation__note"
           role="status" aria-live="polite"></p>
      </div>
      <!-- Save to HQ backlog: the review of one reply before it is saved. It is
           its own form, so Enter here can never send the composer above. Opening
           it writes nothing; only Save to backlog does. -->
      <form id="personalAssistantDraftReview" class="personal-assistant-review"
            aria-labelledby="personalAssistantDraftReviewHeading" hidden novalidate>
        <h3 id="personalAssistantDraftReviewHeading" class="personal-assistant-review__heading">Save to HQ backlog</h3>
        <p id="personalAssistantDraftTarget" class="personal-assistant-review__target"></p>
        <div data-draft-view="edit" class="personal-assistant-review__fields">
          <label class="personal-assistant-review__label" for="personalAssistantDraftTitle">Title</label>
          <input type="text" id="personalAssistantDraftTitle" class="personal-assistant-review__input"
                 autocomplete="off" aria-describedby="personalAssistantDraftTitleHint">
          <p id="personalAssistantDraftTitleHint" class="personal-assistant-review__hint"></p>
          <label class="personal-assistant-review__label" for="personalAssistantDraftBody">Draft</label>
          <textarea id="personalAssistantDraftBody" class="personal-assistant-review__input personal-assistant-review__body"
                    rows="7" aria-describedby="personalAssistantDraftBodyHint"></textarea>
          <p id="personalAssistantDraftBodyHint" class="personal-assistant-review__hint"></p>
          <ul id="personalAssistantDraftNotes" class="personal-assistant-review__notes" hidden></ul>
          <div class="personal-assistant-review__actions">
            <button type="submit" id="personalAssistantDraftSave" class="personal-assistant-review__primary">Save to backlog</button>
            <button type="button" id="personalAssistantDraftCancel" class="personal-assistant-review__secondary">Cancel</button>
          </div>
        </div>
        <div data-draft-view="receipt" class="personal-assistant-review__fields" hidden>
          <p id="personalAssistantDraftReceipt" class="personal-assistant-review__receipt"></p>
          <div class="personal-assistant-review__actions">
            <a id="personalAssistantDraftOpen" class="personal-assistant-review__primary" href="#">Open in Personal HQ</a>
            <button type="button" id="personalAssistantDraftDone" class="personal-assistant-review__secondary">Done</button>
          </div>
        </div>
        <p id="personalAssistantDraftStatus" class="personal-assistant-review__status" role="status" aria-live="polite"></p>
      </form>
      {{if ne .CurrentPage "index"}}
      {{template "assistant-led-setup.tmpl" .}}
      {{end}}
      <div id="personalAssistantActivityMount" class="personal-assistant-panel__activity"></div>
    </div>
  </section>
</div>
{{end}}
