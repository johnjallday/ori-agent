{{define "components/workspaces/manage-agents-modal.tmpl"}}
<!-- Manage Agents Modal -->
<div class="modal fade" id="manageAgentsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" style="color: var(--text-primary);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
            <path d="M12,5.5A3.5,3.5 0 0,1 15.5,9A3.5,3.5 0 0,1 12,12.5A3.5,3.5 0 0,1 8.5,9A3.5,3.5 0 0,1 12,5.5M5,8C5.56,8 6.08,8.15 6.53,8.42C6.38,9.85 6.8,11.27 7.66,12.38C7.16,13.34 6.16,14 5,14A3,3 0 0,1 2,11A3,3 0 0,1 5,8M19,8A3,3 0 0,1 22,11A3,3 0 0,1 19,14C17.84,14 16.84,13.34 16.34,12.38C17.2,11.27 17.62,9.85 17.47,8.42C17.92,8.15 18.44,8 19,8Z"/>
          </svg>
          Manage Agents
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body" style="max-height: 70vh; overflow-y: auto;">

        <!-- Create Agent Section -->
        <div class="mb-4">
          <h6 style="color: var(--text-primary);">Create New Agent</h6>
          <form id="workspaceCreateAgentForm" class="modern-card p-3">
            <!-- Config Mode Toggle -->
            <div class="mb-3">
              <div class="d-flex align-items-center gap-3">
                <label class="form-label mb-0" style="color: var(--text-primary);">Configuration Mode</label>
                <div class="btn-group" role="group" aria-label="Configuration mode toggle">
                  <input type="radio" class="btn-check" name="configMode" id="configModeManual" value="manual" checked>
                  <label class="btn btn-outline-secondary btn-sm" for="configModeManual">Manual</label>
                  <input type="radio" class="btn-check" name="configMode" id="configModeAuto" value="auto">
                  <label class="btn btn-outline-secondary btn-sm" for="configModeAuto">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                      <path d="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"/>
                    </svg>
                    Auto
                  </label>
                </div>
                <span id="autoConfigStatus" class="badge bg-secondary d-none" style="font-size: 0.7rem;"></span>
              </div>
              <small id="configModeHelp" class="text-muted d-none mt-1">Describe what you want this agent to do, and we'll configure it automatically.</small>
            </div>

            <!-- Auto-config Description (shown when Auto mode selected) -->
            <div id="autoConfigSection" class="mb-3 d-none">
              <label class="form-label" style="color: var(--text-primary);">Describe Your Agent</label>
              <textarea id="workspace-auto-config-description" class="form-control" rows="3"
                        style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                        placeholder="Example: An agent that helps with file management tasks like organizing documents, searching for files, and creating backups..."></textarea>
              <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">Tip: Be specific about the tasks and tools this agent should use.</small>
                <button type="button" id="generateAutoConfigBtn" class="btn btn-sm btn-outline-primary">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M12,3L2,12H5V20H19V12H22L12,3M12,8.75A2.25,2.25 0 0,1 14.25,11A2.25,2.25 0 0,1 12,13.25A2.25,2.25 0 0,1 9.75,11A2.25,2.25 0 0,1 12,8.75Z"/>
                  </svg>
                  Generate Config
                </button>
              </div>
            </div>

            <!-- LLM Not Available Warning -->
            <div id="llmNotAvailableWarning" class="alert alert-warning d-none mb-3" style="font-size: 0.875rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
                <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
              </svg>
              <span id="llmWarningMessage">Auto-config requires an LLM provider. Please set up an API key or install Ollama in Settings.</span>
              <a href="/settings" class="alert-link ms-1">Go to Settings</a>
            </div>

            <!-- Auto-selected Indicator -->
            <div id="autoSelectedIndicator" class="alert alert-info d-none mb-3" style="font-size: 0.875rem; padding: 0.5rem 1rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
                <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
              </svg>
              <strong>Auto-configured</strong> - Settings below were selected based on your description. You can still adjust them manually.
            </div>

            <div class="row">
              <div class="col-md-6 mb-3">
                <label class="form-label" style="color: var(--text-primary);">Agent Name</label>
                <input type="text" id="workspace-new-agent-name" class="modern-input w-100" placeholder="Enter agent name..." required>
              </div>
              <div class="col-md-6 mb-3">
                <label class="form-label" style="color: var(--text-primary);">Agent Type</label>
                <select id="workspace-new-agent-type" class="modern-input w-100">
                  <option value="tool-calling">Tool Calling (Cheapest - Optimized for tool use)</option>
                  <option value="general">General Purpose (Mid-tier - Balanced capability)</option>
                  <!-- The value is a persisted agent *type*, not the system
                       assistant, so it keeps its key; only the label changes
                       (Issue #350 FR61/FR62). -->
                  <option value="workspace-manager">Workspace Coordinator (Coordinates workspace agents)</option>
                  <option value="orchestration">Orchestration (Advanced - Multi-agent coordination)</option>
                  <option value="research">Research (Expensive - Complex thinking)</option>
                </select>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label" style="color: var(--text-primary);">Model</label>
              <select id="workspace-new-agent-model" class="modern-input w-100">
                <option value="">Loading models...</option>
              </select>
            </div>
            <div class="mb-3">
              <label class="form-label" style="color: var(--text-primary);">
                Temperature: <span id="workspace-new-agent-temperature-value">1.0</span>
              </label>
              <input type="range" id="workspace-new-agent-temperature" class="form-range" min="0" max="2" step="0.1" value="1.0"
                     style="cursor: pointer;">
              <div class="d-flex justify-content-between" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 500;">
                <span>Focused (0)</span>
                <span>Balanced (1)</span>
                <span>Creative (2)</span>
              </div>
            </div>
            <div class="mb-3">
              <label class="form-label" style="color: var(--text-primary);">System Prompt</label>
              <textarea id="workspace-new-agent-prompt" class="form-control" rows="4"
                        style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                        placeholder="You are a helpful assistant with access to various tools. When a user request can be fulfilled by using an available tool, use the tool instead of providing general information. Be concise and direct in your responses."></textarea>
            </div>
            <div class="mb-3 form-check">
              <input class="form-check-input" type="checkbox" id="workspace-new-agent-allow-web-search" checked>
              <label class="form-check-label" for="workspace-new-agent-allow-web-search" style="color: var(--text-primary);">Allow Web Tools</label>
              <div class="form-helper mt-1">If enabled, this agent can use <code>web_search</code>, <code>web_fetch</code>, and <code>browser</code>.</div>
            </div>
            <button type="submit" class="modern-btn modern-btn-primary">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
              </svg>
              Create Agent
            </button>
          </form>
        </div>

        <!-- Add to Workspace Section -->
        <div class="mb-4">
          <h6 style="color: var(--text-primary);">Add Agents to Workspace</h6>
          <div class="modern-card p-3">
            <div class="mb-3">
              <label class="form-label" style="color: var(--text-primary);">Select Workspace</label>
              <select id="workspace-agent-workspace-select" class="modern-input w-100">
                <option value="">Loading workspaces...</option>
              </select>
            </div>
            <div class="alert alert-info mb-0" style="font-size: 0.875rem;">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
                <path d="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
              </svg>
              Select a workspace above, then click "Add to Workspace" next to any agent below to add them to the selected workspace.
            </div>
          </div>
        </div>

        <!-- Existing Agents Section -->
        <div>
          <h6 style="color: var(--text-primary);">Existing Agents</h6>
          <div id="workspace-agents-list-modal" class="modern-card p-3">
            <div class="text-center py-3">
              <div class="spinner-border text-primary" role="status"></div>
              <p class="mt-2" style="color: var(--text-muted);">Loading agents...</p>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>
{{end}}
