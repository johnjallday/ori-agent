<div class="workspace-hub" id="workspaceHub" data-state="loading">
  <header class="workspace-hub-header modern-card">
    <div class="hub-header-main">
      <div class="hub-title">
        <span class="hub-title-eyebrow">Workspace Hub</span>
        <h1 class="hub-title-text">Get work done without the chat-first drag.</h1>
        <p class="hub-title-subtext">Pick a workspace, track tasks, and open chat only when you need it.</p>
      </div>
      <div class="hub-header-controls">
        <div class="hub-workspace-select">
          <label for="hubWorkspaceSelect">Workspace</label>
          <div class="hub-workspace-select-row">
            <select id="hubWorkspaceSelect" class="modern-input" aria-label="Select workspace"></select>
            <button id="hubWorkspaceBrowseBtn" class="modern-btn modern-btn-secondary" type="button">Browse</button>
          </div>
          <div id="hubWorkspaceMeta" class="hub-workspace-meta">Select a workspace to see tasks and schedules.</div>
        </div>
        <div class="hub-action-row">
          <button id="hubNewTaskBtn" class="modern-btn modern-btn-primary" type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </svg>
            New Task
          </button>
          <button id="hubSchedulesBtn" class="modern-btn modern-btn-secondary" type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
            </svg>
            Schedules
          </button>
          <button id="hubOpenChatBtn" class="modern-btn modern-btn-secondary" type="button">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M6,9H18V11H6M14,14H6V12H14M18,8H6V6H18"/>
            </svg>
            Open Chat
          </button>
        </div>
        <div class="hub-action-row hub-action-row-secondary">
          <a id="hubOpenWorkspaceBtn" class="modern-btn modern-btn-secondary" href="#">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M3,3H11V11H3V3M13,3H21V11H13V3M3,13H11V21H3V13M13,13H21V21H13V13M5,5V9H9V5H5M15,5V9H19V5H15M5,15V19H9V15H5M15,15V19H19V15H15Z"/>
            </svg>
            Workspace Dashboard
          </a>
          <a id="hubOpenCanvasBtn" class="modern-btn modern-btn-secondary" href="#">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
            </svg>
            Canvas
          </a>
        </div>
      </div>
    </div>
  </header>

  <div class="workspace-hub-body" id="workspaceHubBody" aria-live="polite">
    <section class="hub-main">
      <div class="hub-stats" id="hubStats">
        <div class="hub-stat">
          <span class="hub-stat-label">Completed</span>
          <span class="hub-stat-value" id="hubStatCompleted">0</span>
        </div>
        <div class="hub-stat">
          <span class="hub-stat-label">In Progress</span>
          <span class="hub-stat-value" id="hubStatInProgress">0</span>
        </div>
        <div class="hub-stat">
          <span class="hub-stat-label">Scheduled</span>
          <span class="hub-stat-value" id="hubStatScheduled">0</span>
        </div>
        <div class="hub-stat">
          <span class="hub-stat-label">Failed</span>
          <span class="hub-stat-value" id="hubStatFailed">0</span>
        </div>
      </div>

      <div class="hub-panel modern-card" id="hubTasksPanel">
        <div class="hub-panel-header">
          <div>
            <h2 class="hub-panel-title">Tasks</h2>
            <p class="hub-panel-subtitle" id="hubTasksSubtitle">Loading workspace tasks...</p>
          </div>
          <div class="hub-panel-actions">
            <button id="hubRefreshTasksBtn" class="modern-btn modern-btn-secondary" type="button">Refresh</button>
            <button id="hubAddTaskBtn" class="modern-btn modern-btn-primary" type="button">New Task</button>
          </div>
        </div>
        <div class="hub-panel-body">
          <div id="hubTasksList" class="hub-task-list">
            <div class="hub-loading">Loading tasks...</div>
          </div>
        </div>
      </div>
    </section>

    <aside class="hub-side">
      <div class="hub-panel modern-card" id="hubSchedulesPanel">
        <div class="hub-panel-header">
          <div>
            <h2 class="hub-panel-title">Schedules</h2>
            <p class="hub-panel-subtitle">Upcoming scheduled work.</p>
          </div>
          <button id="hubViewSchedulesBtn" class="modern-btn modern-btn-secondary" type="button">View All</button>
        </div>
        <div class="hub-panel-body">
          <div id="hubSchedulesList" class="hub-schedule-list">
            <div class="hub-empty">No schedules yet.</div>
          </div>
        </div>
      </div>

      <div class="hub-panel modern-card" id="hubWorkspacePanel">
        <div class="hub-panel-header">
          <div>
            <h2 class="hub-panel-title">Workspace Snapshot</h2>
            <p class="hub-panel-subtitle">Quick context for this workspace.</p>
          </div>
        </div>
        <div class="hub-panel-body">
          <div class="hub-summary-row">
            <span>Status</span>
            <span id="hubWorkspaceStatus">--</span>
          </div>
          <div class="hub-summary-row">
            <span>Updated</span>
            <span id="hubWorkspaceUpdated">--</span>
          </div>
          <div class="hub-summary-row">
            <span>Agents</span>
            <span id="hubWorkspaceAgents">--</span>
          </div>
          <div class="hub-summary-row">
            <span>Description</span>
            <span id="hubWorkspaceDescription">--</span>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <section class="workspace-launcher" id="workspaceLauncher" aria-live="polite">
    <div class="launcher-card modern-card">
      <div class="launcher-header">
        <div>
          <h2 class="launcher-title">Choose a workspace</h2>
          <p class="launcher-subtitle">Start with tasks and schedules, then open chat when needed.</p>
        </div>
        <div class="launcher-actions">
          <button id="launcherCreateWorkspaceBtn" class="modern-btn modern-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addFolderModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </svg>
            Create Workspace
          </button>
          <button id="launcherRefreshBtn" class="modern-btn modern-btn-secondary" type="button">Refresh</button>
        </div>
      </div>
      <div id="launcherGrid" class="launcher-grid"></div>
      <div id="launcherEmptyState" class="launcher-empty" style="display: none;">No workspaces yet. Create one to get started.</div>
    </div>
  </section>

  <div class="workspace-hub-loading" id="workspaceHubLoading">
    <div class="hub-loading-spinner"></div>
    <span>Loading workspace data...</span>
  </div>
</div>
