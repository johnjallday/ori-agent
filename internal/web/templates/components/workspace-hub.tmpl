              <span id="hubFileUploadPercent" style="color: var(--text-secondary);">0%</span>
            </div>
            <div class="progress">
              <div id="hubFileUploadProgressBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="hubAddFileSubmitBtn" disabled>
