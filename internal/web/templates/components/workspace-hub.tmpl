            <div class="hub-execution-confirm-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
                <path d="M8,5.14V19.14L19,12.14L8,5.14M4,4H6V20H4V4Z"/>
              </svg>
            </div>
            <div class="hub-execution-confirm-copy">
              <div id="hubExecutionConfirmEyebrow" class="hub-execution-confirm-eyebrow">Execution Check</div>
              <h5 id="hubExecutionConfirmTitle" class="hub-execution-confirm-title">Confirm this action</h5>
              <p id="hubExecutionConfirmMessage" class="hub-execution-confirm-message"></p>
            </div>
          </div>
          <div id="hubExecutionConfirmMeta" class="hub-execution-confirm-meta"></div>
          <div id="hubExecutionConfirmDetails" class="hub-execution-confirm-details d-none"></div>
          <div class="hub-execution-confirm-actions">
            <button type="button" id="hubExecutionConfirmCancelBtn" class="modern-btn modern-btn-secondary">Cancel</button>
            <button type="button" id="hubExecutionConfirmConfirmBtn" class="modern-btn modern-btn-primary">Continue</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Add File Modal -->
  <div class="modal fade" id="hubAddFileModal" tabindex="-1" aria-labelledby="hubAddFileModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="hubAddFileModalTitle">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z"/>
            </svg>
            Add File
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="hubAddFileForm">
            <!-- Drag and Drop Zone -->
            <div id="hubFileDropZone" class="hub-file-drop-zone mb-3">
              <div class="hub-file-drop-zone-content">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor" class="mb-2" style="color: var(--text-secondary); opacity: 0.6;">
                  <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13.5,16V19H10.5V16H8L12,12L16,16H13.5M13,9V3.5L18.5,9H13Z"/>
                </svg>
                <p style="color: var(--text-primary); margin-bottom: 4px;">Drag & drop files here</p>
                <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 12px;">or click to browse</p>
                <input type="file" id="hubFileInput" multiple style="display: none;">
              </div>
            </div>
            <!-- Selected Files Preview -->
            <div id="hubSelectedFilesPreview" class="hub-selected-files-preview" style="display: none;">
              <label class="form-label" style="color: var(--text-primary); font-weight: 500;">Selected Files</label>
              <div id="hubSelectedFilesList" class="hub-selected-files-list"></div>
            </div>
            <div class="mb-3">
              <label for="hubFileFolderSelect" class="form-label" style="color: var(--text-primary); font-weight: 500;">Destination folder</label>
              <div class="d-flex gap-2">
                <select id="hubFileFolderSelect" class="form-select">
                  <option value="">Workspace files</option>
                </select>
                <button type="button" id="hubCreateUploadFolderBtn" class="btn btn-outline-secondary">New Folder</button>
              </div>
              <small class="text-muted">Choose where the uploaded file will be stored.</small>
            </div>
            <!-- Title -->
            <div class="mb-3">
              <label for="hubFileTitle" class="form-label" style="color: var(--text-primary); font-weight: 500;">Title (optional)</label>
              <input type="text" class="form-control" id="hubFileTitle" placeholder="Enter a title for the file(s)...">
              <small class="text-muted">If left blank, the filename will be used</small>
            </div>
            <!-- Notes -->
            <div class="mb-3">
              <label for="hubFileNotes" class="form-label" style="color: var(--text-primary); font-weight: 500;">Notes (optional)</label>
              <textarea class="form-control" id="hubFileNotes" rows="2" placeholder="Add notes or description..."></textarea>
            </div>
            <input type="hidden" id="hubFileFolderPath" value="">
          </form>
          <!-- Upload Progress -->
          <div id="hubFileUploadProgress" class="hub-file-upload-progress" style="display: none;">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span style="color: var(--text-primary);">Uploading…</span>
              <span id="hubFileUploadPercent" style="color: var(--text-secondary);">0%</span>
            </div>
            <div class="progress">
              <div id="hubFileUploadProgressBar" class="progress-bar" role="progressbar" style="width: 0%"></div>
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" class="btn btn-primary" id="hubAddFileSubmitBtn" disabled>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z"/>
            </svg>
            Upload
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Edit Board Columns Modal -->
  <div class="modal fade" id="hubBoardColumnsModal" tabindex="-1" aria-labelledby="hubBoardColumnsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h5 class="modal-title" id="hubBoardColumnsModalTitle" style="color: var(--text-primary);">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
              <path d="M3,17V19H9V17H3M3,5V7H13V5H3M13,21V19H21V17H13V15H11V21H13M7,9V11H3V13H7V15H9V9H7M21,13V11H11V13H21M15,9H17V7H21V5H17V3H15V9Z"/>
            </svg>
            Edit Board Columns
          </h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: var(--close-btn-filter, none);"></button>
        </div>
        <div class="modal-body">
          <p style="color: var(--text-secondary); font-size: 0.875rem; margin-bottom: 1rem;">
            Drag to reorder columns. Each column represents a task status or workflow stage.
          </p>
          <div class="hub-columns-editor" id="hubColumnsEditor">
            <div class="hub-columns-list" id="hubColumnsList"></div>
            <button id="hubAddColumnBtn" class="modern-btn modern-btn-secondary hub-add-column-btn" type="button">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
              </svg>
              Add Column
            </button>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="hubSaveColumnsBtn" class="modern-btn modern-btn-primary">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
            </svg>
            Save Columns
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Task Details Modal (Read-Only) -->
  <div class="modal fade" id="hubTaskDetailsModal" tabindex="-1" aria-labelledby="hubTaskDetailsModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <div class="d-flex align-items-center gap-2">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
              <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20M9,13V19H7V13H9M15,15V19H13V15H15M11,11V19H9V11H11M13,13V19H11V13H13"/>
            </svg>
            <h5 class="modal-title" id="hubTaskDetailsModalTitle" style="color: var(--text-primary); margin: 0;">Task Details</h5>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body" style="padding: 0;">
          <div class="task-details-header">
            <div class="task-details-title-row">
              <h4 id="hubTaskDetailsTitle" class="task-details-title">--</h4>
              <span id="hubTaskDetailsStatus" class="hub-task-status">pending</span>
            </div>
            <div class="task-details-header-id-row">
              <span class="task-details-header-id-label">Task ID</span>
              <code id="hubTaskDetailsHeaderId" class="task-details-header-id-value task-details-id">--</code>
            </div>
            <p id="hubTaskDetailsDescription" class="task-details-description">--</p>
          </div>

          <div class="task-details-meta-grid">
            <div class="task-details-meta-item">
              <span class="task-details-meta-label">Task ID</span>
              <code id="hubTaskDetailsId" class="task-details-meta-value task-details-id">--</code>
            </div>
            <div class="task-details-meta-item">
              <span class="task-details-meta-label">Assigned To</span>
              <span id="hubTaskDetailsAssignedTo" class="task-details-meta-value">--</span>
            </div>
            <div class="task-details-meta-item">
              <span class="task-details-meta-label">Created</span>
              <span id="hubTaskDetailsCreated" class="task-details-meta-value">--</span>
            </div>
            <div class="task-details-meta-item">
              <span class="task-details-meta-label">Updated</span>
              <span id="hubTaskDetailsUpdated" class="task-details-meta-value">--</span>
            </div>
          </div>

          <div class="task-details-section">
            <h6 class="task-details-section-title">Details</h6>
            <div id="hubTaskDetailsText" class="task-details-content">--</div>
          </div>

          <div id="hubTaskDetailsResultSection" class="task-details-section" style="display: none;">
            <details class="task-details-collapsible" id="hubTaskDetailsResultCollapsible">
              <summary class="task-details-collapsible-summary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="task-details-chevron">
                  <path d="M7,10L12,15L17,10H7Z"/>
                </svg>
                <span>Result</span>
                <span id="hubTaskDetailsResultBadge" class="task-details-result-badge">Success</span>
              </summary>
              <pre id="hubTaskDetailsResult" class="task-details-result-content">--</pre>
            </details>
          </div>

          <div id="hubTaskDetailsErrorSection" class="task-details-section" style="display: none;">
            <details class="task-details-collapsible task-details-collapsible-error" id="hubTaskDetailsErrorCollapsible">
              <summary class="task-details-collapsible-summary task-details-collapsible-summary-error">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="task-details-chevron">
                  <path d="M7,10L12,15L17,10H7Z"/>
                </svg>
                <span>Error</span>
              </summary>
              <pre id="hubTaskDetailsError" class="task-details-error-content">--</pre>
            </details>
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color); justify-content: space-between;">
          <div>
            <button type="button" class="modern-btn modern-btn-secondary" id="hubTaskDetailsCopyIdBtn" title="Copy task ID to clipboard">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M19,21H8V7H19M19,5H8A2,2 0 0,0 6,7V21A2,2 0 0,0 8,23H19A2,2 0 0,0 21,21V7A2,2 0 0,0 19,5M16,1H4A2,2 0 0,0 2,3V17H4V3H16V1Z"/>
              </svg>
              Copy ID
            </button>
          </div>
          <div class="d-flex gap-2">
            <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Close</button>
            <button type="button" class="modern-btn modern-btn-primary" id="hubTaskDetailsRunBtn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M8,5.14V19.14L19,12.14L8,5.14Z"/>
              </svg>
              Run
            </button>
            <button type="button" class="modern-btn modern-btn-primary" id="hubTaskDetailsEditBtn">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
              </svg>
              Edit
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>

  {{template "support-chat.tmpl" .}}

  <!-- Workspace Group Modal -->
  <div class="modal fade" id="hubWorkspaceMoveModal" tabindex="-1" aria-labelledby="hubWorkspaceMoveModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h6 class="modal-title" id="hubWorkspaceMoveModalTitle" style="color: var(--text-primary);">Move Workspace</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <label for="hubWorkspaceParentSelect" style="font-size: 12px; color: var(--text-secondary);">Group (optional)</label>
          <select id="hubWorkspaceParentSelect" class="modern-input w-100" aria-label="Select parent workspace">
            <option value="">No group</option>
          </select>
          <div style="margin-top: 6px; font-size: 12px; color: var(--text-secondary);">
            Choose a group for this workspace.
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="hubWorkspaceMoveSaveBtn" class="modern-btn modern-btn-primary">Save</button>
        </div>
      </div>
    </div>
  </div>

