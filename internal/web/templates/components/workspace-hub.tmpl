<div class="workspace-hub" id="workspaceHub" data-state="loading">
  <section class="workspace-launcher" id="workspaceLauncher" aria-live="polite">
    <div class="launcher-card modern-card">
      <div class="launcher-header">
        <div>
          <h2 class="launcher-title">Choose a workspace</h2>
          <p class="launcher-subtitle">Start with tasks and schedules, then open chat when needed.</p>
        </div>
        <div class="launcher-actions">
          <button id="launcherCreateWorkspaceBtn" class="modern-btn modern-btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#addFolderModal">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
            </svg>
            Create
          </button>
          <button id="launcherRefreshBtn" class="modern-btn modern-btn-secondary modern-btn-icon" type="button" title="Refresh">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
            </svg>
          </button>
          <button id="launcherSelectModeBtn" class="modern-btn modern-btn-secondary modern-btn-icon" type="button" title="Select workspaces to group">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z"/>
            </svg>
          </button>
        </div>
      </div>
      <!-- Selection Bar (shows only in selection mode) -->
      <div id="launcherSelectionBar" class="launcher-selection-bar" hidden>
        <span id="launcherSelectionCount" class="launcher-selection-count">0 selected</span>
        <div class="launcher-selection-actions">
          <button id="launcherGroupSelectedBtn" class="modern-btn modern-btn-primary modern-btn-sm" type="button" disabled>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true">
              <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
            </svg>
            Group
          </button>
          <button id="launcherDeleteSelectedBtn" class="modern-btn modern-btn-danger modern-btn-sm" type="button" disabled>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true">
              <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
            </svg>
            Delete
          </button>
          <button id="launcherCancelSelectionBtn" class="modern-btn modern-btn-secondary modern-btn-sm" type="button">Cancel</button>
        </div>
      </div>
      <div id="launcherRootDropZone" class="launcher-root-drop" hidden>
        Drop here to move to top level
      </div>
      <div id="launcherGrid" class="launcher-grid"></div>
      <div id="launcherEmptyState" class="launcher-empty" style="display: none;">No workspaces yet. Create one to get started.</div>
    </div>
  </section>

  <!-- Create Group Modal (Launcher) -->
  <div class="modal fade" id="launcherGroupModal" tabindex="-1" aria-labelledby="launcherGroupModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h6 class="modal-title" id="launcherGroupModalTitle" style="color: var(--text-primary);">Create Group</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <input id="launcherGroupNameInput" type="text" class="modern-input w-100 mb-2" placeholder="Group name" autocomplete="off">
          <textarea id="launcherGroupDescriptionInput" class="modern-input w-100" placeholder="Description (optional)" rows="2" style="resize: vertical;"></textarea>
          <div style="margin-top: 8px; font-size: 12px; color: var(--text-secondary);">
            Selected workspaces will be moved under this group.
          </div>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="launcherCreateGroupBtn" class="modern-btn modern-btn-primary">Create Group</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Delete Group Modal (Launcher) -->
  <div class="modal fade" id="launcherDeleteGroupModal" tabindex="-1" aria-labelledby="launcherDeleteGroupModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
      <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
        <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
          <h6 class="modal-title" id="launcherDeleteGroupModalTitle" style="color: var(--text-primary);">Delete Group</h6>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <p style="margin-bottom: 0.5rem; color: var(--text-primary);">
            Delete "<span id="launcherDeleteGroupName">Group</span>"?
          </p>
          <p style="margin-bottom: 0.5rem; font-size: 12px; color: var(--text-secondary);">
            This group contains <span id="launcherDeleteGroupCount">0</span> workspace(s).
          </p>
          <p style="font-size: 12px; color: var(--text-secondary);">
            Choose whether to delete just the group (children move to root) or delete everything inside.
          </p>
        </div>
        <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
          <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="button" id="launcherDeleteGroupOnlyBtn" class="modern-btn modern-btn-secondary">Delete Group Only</button>
          <button type="button" id="launcherDeleteGroupAllBtn" class="modern-btn modern-btn-danger">Delete Group + Contents</button>
        </div>
      </div>
    </div>
  </div>

  <header class="workspace-hub-header modern-card">
    <div class="hub-header-main">
      <div class="hub-title">
        <span class="hub-title-eyebrow">Workspace Hub</span>
        <h1 class="hub-title-text"></h1>
        <div id="hubWorkspaceDescription" class="hub-workspace-description" style="display: none;"></div>
      </div>
      <div class="hub-header-controls">
        <div class="hub-workspace-select">
          <div class="hub-workspace-select-row">
            <button id="hubWorkspaceBrowseBtn" class="modern-btn modern-btn-secondary hub-back-btn" type="button" title="Back to workspaces" aria-label="Back">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
              </svg>
              <span class="hub-back-btn-label">Back</span>
            </button>
          </div>
        </div>
        <div class="hub-action-row">
          <button id="hubWorkspaceMoveBtn" class="modern-btn modern-btn-secondary" type="button" title="Move workspace to a group">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true">
              <path d="M10,4H4V10H10V4M20,4H14V10H20V4M10,14H4V20H10V14M20,14H14V20H20V14M12,7H12.5C13.88,7 15,8.12 15,9.5V10H13.5V9.5C13.5,8.95 13.05,8.5 12.5,8.5H12V7M12,12.5H12.5C13.05,12.5 13.5,12.05 13.5,11.5V11H15V11.5C15,12.88 13.88,14 12.5,14H12V12.5M11,12V14H9.5C8.12,14 7,12.88 7,11.5V11H8.5V11.5C8.5,12.05 8.95,12.5 9.5,12.5H11V12M11,7V8.5H9.5C8.95,8.5 8.5,8.95 8.5,9.5V10H7V9.5C7,8.12 8.12,7 9.5,7H11Z"/>
            </svg>
            Group
          </button>
          <a id="hubOpenCanvasBtn" class="modern-btn modern-btn-secondary" href="#">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
              <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6M12,8A4,4 0 0,1 16,12A4,4 0 0,1 12,16A4,4 0 0,1 8,12A4,4 0 0,1 12,8Z"/>
            </svg>
            Canvas
          </a>

          <div class="hub-view-toggle" role="tablist" aria-label="View mode">
            <button id="hubViewList" class="modern-btn modern-btn-secondary hub-view-btn is-active" type="button" role="tab" aria-selected="true" aria-controls="workspaceHubBody" title="List View">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3,4H21V8H3V4M3,10H21V14H3V10M3,16H21V20H3V16Z"/>
              </svg>
              <span class="hub-view-btn-label">List</span>
            </button>
            <button id="hubViewBoard" class="modern-btn modern-btn-secondary hub-view-btn" type="button" role="tab" aria-selected="false" aria-controls="hubBoardContainer" title="Board View">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                <path d="M4,3H10V5H4V3M14,3H20V5H14V3M4,7H10V9H4V7M14,7H20V9H14V7M4,11H10V13H4V11M14,11H20V13H14V11M4,15H10V17H4V15M14,15H20V17H14V15M4,19H10V21H4V19M14,19H20V21H14V19Z"/>
              </svg>
              <span class="hub-view-btn-label">Board</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="workspace-hub-body" id="workspaceHubBody" aria-live="polite">
    <div class="hub-smart-input modern-card" id="hubSmartInput">
      <div class="hub-smart-input-header">
        <div>
          <span class="hub-smart-input-label">Quick add</span>
          <span class="hub-smart-input-helper">Auto-detects tasks vs chat.</span>
        </div>
      </div>
      <div class="hub-smart-input-main">
        <label for="hubSmartInputField" class="visually-hidden">Describe a task or question</label>
        <input id="hubSmartInputField" class="modern-input" type="text" placeholder="Type a message or use /task, /chat, /note, @file..." autocomplete="off">
        <button id="hubSmartInputAttachBtn" class="modern-btn modern-btn-secondary hub-smart-input-attach" type="button" title="Attach file">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M16.5,6.5V17.5A4.5,4.5 0 0,1 12,22A4.5,4.5 0 0,1 7.5,17.5V8A3.5,3.5 0 0,1 11,4.5A3.5,3.5 0 0,1 14.5,8V16.5A2.5,2.5 0 0,1 12,19A2.5,2.5 0 0,1 9.5,16.5V7.5H11V16.5A1,1 0 0,0 12,17.5A1,1 0 0,0 13,16.5V8A2,2 0 0,0 11,6A2,2 0 0,0 9,8V17.5A3.5,3.5 0 0,0 12.5,21A3.5,3.5 0 0,0 16,17.5V6.5H16.5Z"/>
          </svg>
        </button>
        <button id="hubSmartInputSubmit" class="modern-btn modern-btn-primary" type="button">Send</button>
      </div>
      <div class="hub-smart-input-status" id="hubSmartInputStatus" role="status" aria-live="polite"></div>
      <div class="hub-smart-input-prompt" id="hubSmartInputPrompt" hidden>
        <div>
          <div class="hub-smart-input-prompt-text">Not sure which flow you want. Choose one:</div>
          <div class="hub-smart-input-prompt-hint" id="hubSmartInputPromptHint"></div>
        </div>
        <div class="hub-smart-input-prompt-actions">
          <button id="hubSmartInputPromptTask" class="modern-btn modern-btn-primary" type="button">Create Task</button>
          <button id="hubSmartInputPromptChat" class="modern-btn modern-btn-secondary" type="button">Start Chat</button>
          <button id="hubSmartInputPromptCancel" class="modern-btn modern-btn-secondary hub-smart-input-prompt-cancel" type="button">Cancel</button>
        </div>
      </div>
    </div>

    <div class="hub-stats" id="hubStats">
      <div class="hub-stat">
        <span class="hub-stat-label">Completed</span>
        <span class="hub-stat-value" id="hubStatCompleted">0</span>
      </div>
      <div class="hub-stat">
        <span class="hub-stat-label">In Progress</span>
        <span class="hub-stat-value" id="hubStatInProgress">0</span>
      </div>
      <div class="hub-stat">
        <span class="hub-stat-label">Scheduled</span>
        <span class="hub-stat-value" id="hubStatScheduled">0</span>
      </div>
      <div class="hub-stat">
        <span class="hub-stat-label">Failed</span>
        <span class="hub-stat-value" id="hubStatFailed">0</span>
      </div>
    </div>

    <div class="hub-bento-grid">
      <div class="hub-panel modern-card hub-panel-tasks" id="hubTasksPanel">
        <div class="hub-panel-header">
          <div>
            <h2 class="hub-panel-title">Tasks</h2>
          </div>
          <div class="hub-panel-actions">
            <button id="hubSelectTasksBtn" class="modern-btn modern-btn-secondary hub-panel-btn" type="button" title="Select items">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z"/>
              </svg>
            </button>
            <button id="hubBulkDeleteTasksBtn" class="modern-btn modern-btn-danger hub-panel-btn" type="button" title="Delete selected" style="display:none;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
              </svg>
            </button>
            <button id="hubRefreshTasksBtn" class="modern-btn modern-btn-secondary hub-panel-btn" type="button" title="Refresh tasks">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
              </svg>
            </button>
            <button id="hubImportWorkflowBtn" class="modern-btn modern-btn-secondary hub-panel-btn" type="button" title="Import workflow">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13.5,16V19H10.5V16H8L12,12L16,16H13.5M13,9V3.5L18.5,9H13Z"/>
              </svg>
            </button>
            <button id="hubAddTaskBtn" class="modern-btn modern-btn-primary hub-panel-btn" type="button" title="Add task">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="hub-panel-body">
          <div id="hubTasksList" class="hub-task-list">
            <div class="hub-loading">Loading tasks...</div>
          </div>
        </div>
      </div>

      <div class="hub-panel modern-card hub-panel-sessions" id="hubSessionsPanel">
        <div class="hub-panel-header">
          <div>
            <h2 class="hub-panel-title">Chat Sessions</h2>
          </div>
          <div class="hub-panel-actions">
            <button id="hubSelectSessionsBtn" class="modern-btn modern-btn-secondary hub-panel-btn" type="button" title="Select items">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z"/>
              </svg>
            </button>
            <button id="hubBulkDeleteSessionsBtn" class="modern-btn modern-btn-danger hub-panel-btn" type="button" title="Delete selected" style="display:none;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
              </svg>
            </button>
            <button id="hubNewSessionBtn" class="modern-btn modern-btn-primary hub-panel-btn" type="button">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="hub-panel-body">
          <div id="hubSessionsList" class="hub-session-list">
            <div class="hub-empty">No chat sessions yet.</div>
          </div>
        </div>
      </div>

      <div class="hub-panel modern-card hub-panel-notes is-expandable" id="hubNotesPanel">
        <button class="hub-panel-close" type="button" title="Close" aria-label="Close expanded panel">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
          </svg>
        </button>
        <div class="hub-panel-header">
          <div>
            <h2 class="hub-panel-title">Notes</h2>
          </div>
          <div class="hub-panel-actions">
            <button id="hubSelectNotesBtn" class="modern-btn modern-btn-secondary hub-panel-btn" type="button" title="Select items">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z"/>
              </svg>
            </button>
            <button id="hubBulkDeleteNotesBtn" class="modern-btn modern-btn-danger hub-panel-btn" type="button" title="Delete selected" style="display:none;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
              </svg>
            </button>
            <button id="hubNewNoteBtn" class="modern-btn modern-btn-primary hub-panel-btn" type="button">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="hub-panel-body">
          <div id="hubNotesList" class="hub-note-list">
            <div class="hub-empty">No notes yet.</div>
          </div>
        </div>
      </div>

      <div class="hub-panel modern-card hub-panel-files is-expandable" id="hubFilesPanel">
        <button class="hub-panel-close" type="button" title="Close" aria-label="Close expanded panel">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
          </svg>
        </button>
        <div class="hub-panel-header">
          <div>
            <h2 class="hub-panel-title">Files</h2>
          </div>
          <div class="hub-panel-actions">
            <button id="hubSelectFilesBtn" class="modern-btn modern-btn-secondary hub-panel-btn" type="button" title="Select items">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,5V19H5V5H19Z"/>
              </svg>
            </button>
            <button id="hubBulkTrashFilesBtn" class="modern-btn modern-btn-danger hub-panel-btn" type="button" title="Move to trash" style="display:none;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
              </svg>
            </button>
            <button id="hubAddFileBtn" class="modern-btn modern-btn-primary hub-panel-btn" type="button">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="hub-panel-body">
          <div id="hubFilesList" class="hub-file-list">
            <div class="hub-empty">No files yet.</div>
          </div>
        </div>
      </div>

      <div class="hub-panel modern-card hub-panel-directories is-expandable" id="hubDirectoriesPanel">
        <button class="hub-panel-close" type="button" title="Close" aria-label="Close expanded panel">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
          </svg>
        </button>
        <div class="hub-panel-header">
          <div>
            <h2 class="hub-panel-title">Directories</h2>
          </div>
          <div class="hub-panel-actions">
