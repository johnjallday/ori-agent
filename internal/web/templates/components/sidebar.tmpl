<!-- Sidebar -->
<nav class="sidebar d-none" id="sidebar" role="navigation" aria-label="Main navigation">
  <div class="sidebar-content">
    <!-- Group 1: Agents -->
    <div class="sidebar-group sidebar-group-core">
      <!-- Agents Section -->
      <div class="sidebar-section">
        <div class="modern-card p-3">
          <div class="d-flex align-items-center justify-content-between mb-3">
            <h6 class="fw-semibold mb-0 d-flex align-items-center" style="color: var(--text-primary);">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1L13.5 2.5L16.17 5.17L11.83 9.51C11.25 9.19 10.61 9 10 9C8.61 9 7.22 9.39 6 10.17L3 7.17L1.59 8.59L4.17 11.17C3.39 12.39 3 13.78 3 15.17C3 16.56 3.39 17.94 4.17 19.17L1.59 21.75L3 23.16L6 20.16C7.22 20.94 8.61 21.33 10 21.33C10.61 21.33 11.25 21.13 11.83 20.82L16.17 16.48L13.5 19.15L15 20.65L21 14.65V12.65L17.83 15.82L12.41 10.41C12.61 10.25 12.8 10.08 13 9.83L17.83 5L21 8.17V9Z"/>
              </svg>
              Agents
            </h6>
            <button id="addAgentBtn" class="modern-btn modern-btn-secondary p-1" style="min-width: auto;" aria-label="Add new agent" title="Add new agent">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
              </svg>
            </button>
          </div>

          <div id="assistantProgressWidget" class="mb-3 d-none" aria-live="polite" style="background: var(--bg-tertiary); border: 1px solid var(--border-color); border-radius: 10px; padding: 10px;">
            <div class="d-flex align-items-center justify-content-between mb-1">
              <span style="color: var(--text-secondary); font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em;">Assistant</span>
              <span id="assistantRankBadge" class="badge" style="background: var(--primary-color-light); color: var(--primary-color); font-size: 0.68rem;">Novice</span>
            </div>
            <div class="d-flex align-items-baseline justify-content-between">
              <span id="assistantLevelValue" style="color: var(--text-primary); font-size: 0.9rem; font-weight: 600;">Assistant Level 0</span>
              <span id="assistantXpValue" style="color: var(--text-secondary); font-size: 0.72rem;">0 XP</span>
            </div>
            <div class="progress mt-2" style="height: 6px; background: var(--bg-primary);">
              <div id="assistantXpProgressBar" class="progress-bar" role="progressbar" style="width: 0%; background: var(--primary-color);" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
            </div>
          </div>

          <div id="agentsList" class="agents-list accordion">
            <!-- Agents will be loaded dynamically -->
          </div>

          <!-- Manage Agents Button -->
          <div class="mt-2">
            <a href="/agents-dashboard" class="modern-btn modern-btn-secondary w-100 d-flex align-items-center justify-content-center" style="text-decoration: none; font-size: 0.875rem;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-2">
                <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
              </svg>
              Manage Agents
            </a>
          </div>
        </div>
      </div>

    </div>

