<!-- Top Navbar - Flexible component for all pages -->
<nav class="navbar {{if .NavbarClass}}{{.NavbarClass}}{{else}}modern-card glassmorphism{{end}} {{if .NavbarFixed}}navbar-expand-lg position-fixed w-100 top-0{{end}}" style="position: {{if .NavbarFixed}}fixed{{else}}sticky{{end}}; top: 0; z-index: 10002; {{if .NavbarFixed}}backdrop-filter: blur(10px);{{else}}border-radius: 0; border: none; border-bottom: 1px solid var(--border-color); backdrop-filter: blur(20px);{{end}}">
  <div class="container-fluid {{if .NavbarPadding}}{{.NavbarPadding}}{{else}}{{if .NavbarFixed}}px-4{{end}}{{end}}">
    <div class="ori-navbar-shell">
      <div class="ori-navbar-left">
        <!-- Left: optional Back button, then the brand at the left edge -->
        {{if .ShowBackButton}}
        <a href="{{if .BackButtonURL}}{{.BackButtonURL}}{{else}}/{{end}}" class="modern-btn modern-btn-secondary" title="{{if .BackButtonTitle}}{{.BackButtonTitle}}{{else}}Back to Chat{{end}}" aria-label="{{if .BackButtonTitle}}{{.BackButtonTitle}}{{else}}Back to Chat{{end}}">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
          </svg>
        </a>
        {{end}}

        <!-- Brand -->
        <a class="navbar-brand ori-navbar-brand fw-bold {{if .BrandNoDecoration}}text-decoration-none{{else}}d-flex{{end}} align-items-center" href="{{if .BrandURL}}{{.BrandURL}}{{else}}/{{end}}" style="color: {{if .BrandColor}}{{.BrandColor}}{{else}}var(--primary-color){{end}};{{if not .NavbarFixed}} font-size: 1.25rem; cursor: pointer;{{end}}">
          {{if .BrandIcon}}
          {{.BrandIcon}}
          {{else if .UseLegacyIcon}}
          <span data-icon="cpu" data-icon-size="36" data-icon-class="me-2" style="color: var(--primary-color);"></span>
          {{else}}
          <svg width="36" height="36" viewBox="0 0 1024 1024" xmlns="http://www.w3.org/2000/svg" class="me-2">
            <path d="M 724 410 L 714 405 L 686 404 L 663 397 L 651 386 L 632 352 L 618 339 L 600 329 L 582 324 L 561 324 L 542 329 L 518 344
                 L 503 362 L 493 386 L 491 412 L 494 428 L 503 448 L 541 493 L 554 520 L 526 508 L 501 503 L 464 504 L 414 514 L 383 513
                 L 349 498 L 330 480 L 321 467 L 308 498 L 303 523 L 304 562 L 316 601 L 338 635 L 362 658 L 386 674 L 432 693 L 467 700
                 L 527 701 L 570 695 L 607 683 L 638 665 L 659 645 L 675 619 L 682 591 L 680 562 L 674 544 L 658 518 L 626 486 L 621 474
                 L 623 459 L 626 453 L 638 444 L 672 442 L 702 434 L 723 418 Z"
              fill="currentColor"/>
          </svg>
          {{end}}
          {{if .BrandText}}{{.BrandText}}{{else}}{{.Title}}{{end}}
        </a>
      </div>

      <!-- Center: Navigation Links (optional) -->
      {{if ne .ShowNavLinks false}}
      <div class="ori-navbar-links">
        <!-- Home and Agents are the only fixed links. Home is the single
             workspace overview and reaches Action Center from Needs attention;
             configuration lives behind the Settings gear (nav-collapse FR1). -->
        <a href="/" class="nav-link-item {{if eq .CurrentPage "index"}}active{{end}}"{{if eq .CurrentPage "index"}} aria-current="page"{{end}}>Home</a>
        <span class="ori-navbar-divider" aria-hidden="true">|</span>
        <a href="/agents" id="navAgentsLink" class="nav-link-item {{if eq .CurrentPage "agents"}}active{{end}}"{{if eq .CurrentPage "agents"}} aria-current="page"{{end}}>Agents</a>
        <!-- Vaults is on demand: hidden until vault-modal.js finds a record,
             and always shown on the vault page itself (FR6). -->
        <span id="vaultLauncherDivider" class="ori-navbar-divider" aria-hidden="true"{{if ne .CurrentPage "vault"}} hidden{{end}}>|</span>
        <a
          href="/vaults"
          id="vaultLauncherButton"
          class="nav-link-item ori-navbar-vault-launcher {{if eq .CurrentPage "vault"}}active{{end}}"
          {{if ne .CurrentPage "vault"}}hidden{{end}}
          {{if ne .CurrentPage "vault"}}data-bs-toggle="modal"{{end}}
          {{if ne .CurrentPage "vault"}}data-bs-target="#vaultModal"{{end}}
          {{if ne .CurrentPage "vault"}}aria-controls="vaultModal"{{end}}
          {{if ne .CurrentPage "vault"}}aria-haspopup="dialog"{{end}}
          aria-expanded="false"
          {{if eq .CurrentPage "vault"}}aria-current="page"{{end}}
          title="{{if eq .CurrentPage "vault"}}Open vaults page{{else}}Open private vaults{{end}}">
          <svg class="ori-navbar-vault-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M5 9.5V8.25C5 6.73 6.23 5.5 7.75 5.5H10L12 7.5L14 5.5H16.25C17.77 5.5 19 6.73 19 8.25V9.5" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M4 9.5H20V17.25C20 18.77 18.77 20 17.25 20H6.75C5.23 20 4 18.77 4 17.25V9.5Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.85" stroke-linejoin="round"/>
            <path d="M4 12.5H20" stroke="currentColor" stroke-width="1.85" stroke-linecap="round"/>
            <path d="M12 9.5V20" stroke="currentColor" stroke-width="1.85" stroke-linecap="round"/>
            <path d="M11.1 13.6H12.9V15.9H11.1V13.6Z" fill="currentColor"/>
          </svg>
          <span>Vaults</span>
          <span id="vaultNavCount" class="ori-navbar-vault-count is-hidden" aria-label="Vault entry count">0</span>
        </a>
      </div>
      {{end}}

      <div class="ori-navbar-utilities">
        <!-- Right: Help, Settings, Location, Actions, Theme. The system model
             is shown and changed at /settings#system-model (FR4). -->
        <div class="ori-navbar-actions">
          <button id="oriGuideLauncher" class="modern-btn modern-btn-secondary ori-help-trigger"
                  type="button" aria-label="Help" aria-expanded="false" aria-controls="oriGuidePanel">
            <span class="ori-help-trigger__icon" aria-hidden="true">?</span>
            <span>Help</span>
          </button>
          <!-- The gear is the bar's only way into Settings and is active on
               Settings and on every page its hub links to (FR2, FR3). -->
          <a href="/settings" id="navSettingsLink" class="modern-btn modern-btn-secondary{{if .InSettingsHub}} active{{end}}"
             aria-label="Settings" title="Settings"{{if .InSettingsHub}} aria-current="page"{{end}}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"/>
            </svg>
          </a>
          <!-- Location Indicator (optional) -->
          {{if .ShowLocationIndicator}}
          <span id="locationIndicator" class="modern-badge badge-secondary d-flex align-items-center gap-2" style="padding: 0.5rem 1rem; border-radius: var(--radius-lg);" title="Current location">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="color: var(--text-secondary);">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="fw-medium">Loading…</span>
          </span>
          {{end}}

          <!-- Update Notification Button (optional) -->
          <button id="updateNotificationBtn" class="modern-btn modern-btn-primary position-relative" style="display: none; align-items: center; gap: 0.5rem;" onclick="showUpdateModal()" title="Update available" aria-label="Update available - click to view details">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
            </svg>
            <span>{{if .UpdateButtonText}}{{.UpdateButtonText}}{{else}}Update Available{{end}}</span>
            <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
              <span class="visually-hidden">New update</span>
            </span>
          </button>

          <!-- Refresh Button (optional) -->
          {{if .ShowRefreshButton}}
          <button id="refreshAppBtn" class="modern-btn modern-btn-secondary" onclick="refreshApp(true)" style="display: flex; align-items: center; gap: 0.5rem;" title="Refresh all app data" aria-label="Refresh all application data">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C13.3256 3 14.5859 3.28125 15.7285 3.78906" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M17 8L21 4L17 4L17 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Refresh</span>
          </button>
          {{end}}

          <button
            id="homeAssistantReopenBtn"
            class="modern-btn modern-btn-secondary d-none"
            type="button"
            data-bs-toggle="modal"
            data-bs-target="#homeAssistantThinkingModal"
            aria-controls="homeAssistantThinkingModal"
            aria-pressed="false"
            title="Open work activity">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M4,4H20A2,2 0 0,1 22,6V18A2,2 0 0,1 20,20H4A2,2 0 0,1 2,18V6A2,2 0 0,1 4,4M4,6V8L12,13L20,8V6L12,11L4,6M4,18H20V10.5L12,15.5L4,10.5V18Z"/>
            </svg>
            <span data-home-assistant-launcher-label>Task Activity</span>
          </button>

          <button
            id="keyboardNavigationToggle"
            class="modern-btn modern-btn-secondary"
            type="button"
            aria-label="Open keyboard navigation"
            aria-pressed="false"
            title="Keyboard navigation">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20,5A2,2 0 0,1 22,7V17A2,2 0 0,1 20,19H4A2,2 0 0,1 2,17V7A2,2 0 0,1 4,5H20M4,7V17H20V7H4M6,9H8V11H6V9M9,9H11V11H9V9M12,9H14V11H12V9M15,9H18V11H15V9M6,12H9V14H6V12M10,12H12V14H10V12M13,12H18V14H13V12M6,15H18V17H6V15Z"/>
            </svg>
          </button>

          <!-- Dark Mode Toggle (always shown) -->
          <button id="darkModeToggle" class="modern-btn modern-btn-secondary" type="button" aria-label="Switch to dark mode" aria-pressed="false" title="Switch to dark mode">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</nav>

{{template "vault-modal.tmpl" .}}

<!--
  Help and the Personal Assistant mount here rather than in base.tmpl because the navbar is the one
  component every authenticated page includes — standalone pages such as
  /agents build their own shell and never render base.tmpl. Mounting here gives
  exactly one Help panel and one assistant/work host per page.
-->
{{template "ori-guide.tmpl" .}}
