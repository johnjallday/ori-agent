<!-- Modal placeholders - will be filled with actual modal content later -->

<!-- Add Agent Modal (shared across pages with sidebar) -->
<div class="modal fade" id="addAgentModal" tabindex="-1" aria-labelledby="addAgentModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-scrollable">
    <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
        <h5 class="modal-title" id="addAgentModalLabel" style="color: var(--text-primary);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
            <path d="M12 2C13.1 2 14 2.9 14 4C14 5.1 13.1 6 12 6C10.9 6 10 5.1 10 4C10 2.9 10.9 2 12 2ZM21 9V7L15 1L13.5 2.5L16.17 5.17L11.83 9.51C11.25 9.19 10.61 9 10 9C8.61 9 7.22 9.39 6 10.17L3 7.17L1.59 8.59L4.17 11.17C3.39 12.39 3 13.78 3 15.17C3 16.56 3.39 17.94 4.17 19.17L1.59 21.75L3 23.16L6 20.16C7.22 20.94 8.61 21.33 10 21.33C10.61 21.33 11.25 21.13 11.83 20.82L16.17 16.48L13.5 19.15L15 20.65L21 14.65V12.65L17.83 15.82L12.41 10.41C12.61 10.25 12.8 10.08 13 9.83L17.83 5L21 8.17V9Z"/>
          </svg>
          Create New Agent
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
      </div>
      <div class="modal-body">
        <form id="addAgentForm">
          <div class="mb-3">
            <div class="d-flex align-items-center gap-3">
              <label class="form-label mb-0" style="color: var(--text-primary);">Configuration Mode</label>
              <div class="btn-group" role="group" aria-label="Configuration mode toggle">
                <input type="radio" class="btn-check" name="baseConfigMode" id="baseConfigModeManual" value="manual" checked>
                <label class="btn btn-outline-secondary btn-sm" for="baseConfigModeManual">Manual</label>
                <input type="radio" class="btn-check" name="baseConfigMode" id="baseConfigModeAuto" value="auto">
                <label class="btn btn-outline-secondary btn-sm" for="baseConfigModeAuto">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                    <path d="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"/>
                  </svg>
                  Auto
                </label>
              </div>
              <span id="baseAutoConfigStatus" class="badge bg-secondary d-none" style="font-size: 0.7rem;"></span>
            </div>
            <small id="baseConfigModeHelp" class="text-muted d-none mt-1">Describe what you want this agent to do, and we'll configure it automatically.</small>
          </div>
          <div id="baseAutoConfigSection" class="mb-3 d-none">
            <label class="form-label" style="color: var(--text-primary);">Describe Your Agent</label>
            <textarea id="baseAutoConfigDescription" class="form-control" rows="3"
                      style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                      placeholder="Example: An agent that helps with file management tasks like organizing documents, searching for files, and creating backups..."></textarea>
            <div class="d-flex justify-content-between align-items-center mt-2">
              <small class="text-muted">Tip: Be specific about the tasks and tools this agent should use.</small>
              <button type="button" id="baseGenerateAutoConfigBtn" class="btn btn-sm btn-outline-primary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M12,3L2,12H5V20H19V12H22L12,3M12,8.75A2.25,2.25 0 0,1 14.25,11A2.25,2.25 0 0,1 12,13.25A2.25,2.25 0 0,1 9.75,11A2.25,2.25 0 0,1 12,8.75Z"/>
                </svg>
                Generate Config
              </button>
            </div>
          </div>
          <div id="baseLlmNotAvailableWarning" class="alert alert-warning d-none mb-3" style="font-size: 0.875rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
              <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
            </svg>
            <span id="baseLlmWarningMessage">Auto-config requires an LLM provider. Please set up an API key or install Ollama in Settings.</span>
            <a href="/settings" class="alert-link ms-1">Go to Settings</a>
          </div>
          <div id="baseAutoSelectedIndicator" class="alert alert-info d-none mb-3" style="font-size: 0.875rem; padding: 0.5rem 1rem;">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
              <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
            </svg>
            <strong>Auto-configured</strong> - Settings below were selected based on your description. You can still adjust them manually.
          </div>
          <div class="mb-3">
            <label for="agentName" class="form-label required" style="color: var(--text-primary);">Agent Name</label>
            <input type="text" id="agentName" class="modern-input w-100" placeholder="Enter agent name..." required minlength="2" maxlength="50" aria-describedby="agentNameHelp">
            <small id="agentNameHelp" class="form-helper">Use letters, numbers, and hyphens. 2-50 characters.</small>
          </div>
          <div class="mb-3">
            <label for="agentType" class="form-label" style="color: var(--text-primary);">Agent Type</label>
            <select id="agentType" class="modern-input w-100">
              <option value="tool-calling">Tool Calling (Cheapest - Optimized for tool use)</option>
              <option value="general">General Purpose (Mid-tier - Balanced capability)</option>
              <option value="orchestration">Orchestration (Advanced - Multi-agent coordination)</option>
              <option value="research">Research (Expensive - Complex thinking)</option>
            </select>
          </div>
          <div class="mb-3">
            <label for="agentModel" class="form-label" style="color: var(--text-primary);">Model</label>
            <select id="agentModel" class="modern-input w-100">
              <option value="">Loading models...</option>
            </select>
            <small id="agentModelRecommendation" class="form-helper d-none"></small>
          </div>
          <div class="mb-3 d-none" id="agentReasoningField">
            <label for="agentReasoning" class="form-label" style="color: var(--text-primary);">Reasoning Level</label>
            <select id="agentReasoning" class="modern-input w-100" aria-describedby="agentReasoningHelp">
              <option value="medium" selected>Medium (Recommended)</option>
              <option value="high">High</option>
              <option value="low">Low</option>
              <option value="xhigh">Extra High</option>
            </select>
            <small id="agentReasoningHelp" class="form-helper">Codex only. Higher levels improve difficult reasoning at the cost of speed.</small>
          </div>
          <div class="mb-3">
            <label for="agentTemperature" class="form-label" style="color: var(--text-primary);">
              Temperature: <span id="temperatureValue">1.0</span>
            </label>
            <input type="range" id="agentTemperature" class="form-range" min="0" max="2" step="0.1" value="1.0"
                   style="cursor: pointer;" aria-describedby="temperatureHelp" aria-valuemin="0" aria-valuemax="2" aria-valuenow="1.0">
            <div id="temperatureHelp" class="d-flex justify-content-between" style="font-size: 0.75rem; color: var(--text-muted); font-weight: 500;">
              <span>Focused (0)</span>
              <span>Balanced (1)</span>
              <span>Creative (2)</span>
            </div>
          </div>
          <div class="mb-3">
            <label for="agentSystemPrompt" class="form-label" style="color: var(--text-primary);">System Prompt</label>
            <textarea id="agentSystemPrompt" class="form-control" rows="4" maxlength="4000"
                      style="background: var(--bg-tertiary); border: 1px solid var(--border-color); color: var(--text-primary); font-size: 0.9em; resize: vertical;"
                      placeholder="Example: You are a helpful assistant with access to various tools. When a user request can be fulfilled by using an available tool, use the tool instead of providing general information. Be concise and direct in your responses."
                      data-char-counter="true"></textarea>
            <small class="form-helper">Define the agent's behavior, personality, and instructions. Max 4000 characters.</small>
          </div>
          <div class="mb-3 form-check">
            <input class="form-check-input" type="checkbox" id="agentAllowWebSearch" checked>
            <label class="form-check-label" for="agentAllowWebSearch" style="color: var(--text-primary);">Allow Web Tools</label>
            <div class="form-helper mt-1">If enabled, this agent can use <code>web_search</code>, <code>web_fetch</code>, and <code>browser</code>.</div>
          </div>
          <section id="agentCreateCapabilitiesSection" class="agent-create-capabilities" aria-labelledby="agentCreateCapabilitiesTitle">
            <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
              <div>
                <label id="agentCreateCapabilitiesTitle" class="form-label mb-1" style="color: var(--text-primary);">Review Skills</label>
                <div id="agentCreateCapabilitiesIntro" class="form-helper">Optional. Skills attach to the agent here. If a skill needs MCP connectors, you will bind them after adding the agent to a workspace.</div>
              </div>
              <span class="agent-create-capability-pill is-muted">Optional</span>
            </div>

            <div id="agentCreateCapabilitiesGrid" class="agent-create-capabilities-grid is-single-column">
              <div id="agentCreateMCPPanel" class="agent-create-capabilities-panel" hidden>
                <div class="agent-create-capabilities-panel-header">
                  <div>
                    <div class="agent-create-capabilities-panel-title">MCP Connectors</div>
                    <div id="agentCreateMCPSubtitle" class="agent-create-capabilities-panel-subtitle">Global connectors available before workspace binding</div>
                  </div>
                  <span id="agentCreateMCPCount" class="agent-create-capability-pill is-muted">0 available</span>
                </div>
                <div id="agentCreateMCPList" class="agent-create-capability-list" aria-live="polite">
                  <div class="agent-create-capability-empty">Loading MCP connectors...</div>
                </div>
              </div>

              <div class="agent-create-capabilities-panel">
                <div class="agent-create-capabilities-panel-header">
                  <div>
                    <div class="agent-create-capabilities-panel-title">Skills</div>
                    <div class="agent-create-capabilities-panel-subtitle">Enable reusable domain knowledge and flows</div>
                  </div>
                  <span id="agentCreateSkillCount" class="agent-create-capability-pill is-muted">0 selected</span>
                </div>
                <div id="agentCreateSkillsList" class="agent-create-capability-list" aria-live="polite">
                  <div class="agent-create-capability-empty">Loading skills...</div>
                </div>
              </div>
            </div>

            <div id="agentCreateCapabilitiesNote" class="agent-create-capability-note">
              Skills with scripts are trusted for this agent when selected. MCP connector access is configured later from the target workspace.
            </div>
          </section>
        </form>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
        <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="createAgentBtn" class="modern-btn modern-btn-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1">
            <path d="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
          </svg>
          Create Agent
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .agent-create-capabilities {
    margin-top: 1.1rem;
    padding: 1rem;
    border-radius: 18px;
    border: 1px solid rgba(221, 128, 82, 0.18);
    background:
      radial-gradient(circle at top right, rgba(221, 128, 82, 0.12), transparent 32%),
      linear-gradient(180deg, rgba(255,255,255,0.03), rgba(255,255,255,0.01));
  }

  .agent-create-capabilities-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }

  .agent-create-capabilities-grid.is-single-column {
    grid-template-columns: 1fr;
  }

  .agent-create-capabilities-panel {
    min-width: 0;
    padding: 0.9rem;
    border-radius: 16px;
    border: 1px solid rgba(255,255,255,0.06);
    background: rgba(8, 16, 34, 0.48);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .agent-create-capabilities-panel-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
  }

  .agent-create-capabilities-panel-title {
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.2;
  }

  .agent-create-capabilities-panel-subtitle {
    margin-top: 0.18rem;
    color: var(--text-secondary);
    font-size: 0.75rem;
  }

  .agent-create-capability-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    max-height: 240px;
    overflow-y: auto;
    padding-right: 0.1rem;
  }

  .agent-create-capability-card {
    display: flex;
    gap: 0.75rem;
    padding: 0.8rem;
    border-radius: 14px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(15, 24, 46, 0.72);
    cursor: pointer;
    transition: border-color 0.18s ease, transform 0.18s ease, box-shadow 0.18s ease, background 0.18s ease;
  }

  .agent-create-capability-card:hover {
    border-color: rgba(221, 128, 82, 0.34);
    transform: translateY(-1px);
  }

  .agent-create-capability-card.is-readonly {
    cursor: default;
  }

  .agent-create-capability-card.is-readonly:hover {
    border-color: rgba(255,255,255,0.08);
    transform: none;
  }

  .agent-create-capability-card.is-selected {
    border-color: rgba(221, 128, 82, 0.52);
    background: linear-gradient(180deg, rgba(221, 128, 82, 0.12), rgba(20, 30, 54, 0.82));
    box-shadow: 0 8px 24px rgba(8, 13, 27, 0.28);
  }

  .agent-create-capability-card.is-locked {
    border-style: solid;
  }

  .agent-create-capability-card input[type="checkbox"] {
    margin-top: 0.22rem;
    flex-shrink: 0;
  }

  .agent-create-capability-copy {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.38rem;
  }

  .agent-create-capability-title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .agent-create-capability-title {
    color: var(--text-primary);
    font-weight: 600;
    line-height: 1.2;
  }

  .agent-create-capability-description {
    color: var(--text-secondary);
    font-size: 0.79rem;
    line-height: 1.45;
  }

  .agent-create-capability-meta,
  .agent-create-capability-empty,
  .agent-create-capability-note {
    color: var(--text-secondary);
    font-size: 0.76rem;
  }

  .agent-create-capability-empty {
    padding: 0.8rem;
    border-radius: 12px;
    border: 1px dashed rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.02);
  }

  .agent-create-capability-empty.is-error {
    color: var(--danger-color);
    border-color: rgba(220, 53, 69, 0.35);
    background: rgba(220, 53, 69, 0.08);
  }

  .agent-create-capability-empty a,
  .agent-create-capability-note a {
    color: var(--primary-color);
    text-decoration: none;
  }

  .agent-create-capability-pills,
  .agent-create-capability-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .agent-create-capability-pill,
  .agent-create-capability-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.18rem 0.45rem;
    border-radius: 999px;
    font-size: 0.68rem;
    line-height: 1;
    letter-spacing: 0.02em;
    border: 1px solid transparent;
    white-space: nowrap;
  }

  .agent-create-capability-pill.is-muted,
  .agent-create-capability-tag.is-muted {
    color: var(--text-secondary);
    background: rgba(255,255,255,0.04);
    border-color: rgba(255,255,255,0.06);
  }

  .agent-create-capability-pill.is-source {
    color: #f7ddc9;
    background: rgba(221, 128, 82, 0.14);
    border-color: rgba(221, 128, 82, 0.26);
  }

  .agent-create-capability-pill.is-success {
    color: #b9f6cf;
    background: rgba(25, 135, 84, 0.18);
    border-color: rgba(25, 135, 84, 0.28);
  }

  .agent-create-capability-pill.is-warning {
    color: #ffe1a8;
    background: rgba(255, 193, 7, 0.16);
    border-color: rgba(255, 193, 7, 0.24);
  }

  .agent-create-capability-pill.is-danger,
  .agent-create-capability-tag.is-danger {
    color: #ffd0d6;
    background: rgba(220, 53, 69, 0.16);
    border-color: rgba(220, 53, 69, 0.24);
  }

  .agent-create-capability-tag.is-required {
    color: #d6ecff;
    background: rgba(13, 110, 253, 0.14);
    border-color: rgba(13, 110, 253, 0.22);
  }

  .agent-create-capability-pill.is-script {
    color: #edd8ff;
    background: rgba(111, 66, 193, 0.18);
    border-color: rgba(111, 66, 193, 0.24);
  }

  .agent-create-capability-note {
    margin-top: 0.75rem;
    line-height: 1.45;
  }

  @media (max-width: 768px) {
    .agent-create-capabilities-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<div class="modal fade" id="agentInfoModal" tabindex="-1" aria-labelledby="agentInfoModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
        <h1 class="modal-title fs-5" id="agentInfoModalLabel" style="color: var(--text-primary);">Agent Information</h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" style="color: var(--text-primary);">
        <!-- Modal content will be populated here -->
        <p>Agent information will be displayed here...</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
      </div>
    </div>
  </div>
</div>

<!-- Update Available Modal -->
<div class="modal fade" id="updateModal" tabindex="-1" aria-labelledby="updateModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
        <h1 class="modal-title fs-5" id="updateModalLabel" style="color: var(--text-primary);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="me-2">
            <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
          </svg>
          Update Available
        </h1>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body" id="updateModalBody" style="color: var(--text-primary);">
