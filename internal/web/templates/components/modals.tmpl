          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="me-1">
            <path d="M5,20H19V18H5M19,9H15V3H9V9H5L12,16L19,9Z"/>
          </svg>
          Download Update
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Onboarding Modal -->
<style>
  #onboardingModal .modal-dialog {
    animation: modalSlideIn 0.4s ease-out;
    max-width: 500px;
    margin-top: 80px;
  }

  #onboardingModal .modal-content {
    overscroll-behavior: contain;
  }

  @keyframes modalSlideIn {
    from {
      opacity: 0;
      transform: translateY(-50px) scale(0.95);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .onboarding-phase {
    animation: phaseFadeIn 0.3s ease-in-out;
  }

  .onboarding-phase.d-none {
    display: none !important;
  }

  @keyframes phaseFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .ori-avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ori-avatar svg {
    width: 44px;
    height: 44px;
  }

  .ori-speech {
    position: relative;
    background: var(--bg-secondary, #f0f4f8);
    border: 1px solid var(--border-color, #e2e8f0);
    border-radius: 12px;
    padding: 12px 16px;
    margin-left: 12px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--text-primary);
  }

  .ori-speech::before {
    content: '';
    position: absolute;
    left: -8px;
    top: 18px;
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-right: 8px solid var(--border-color, #e2e8f0);
  }

  .ori-speech::after {
    content: '';
    position: absolute;
    left: -7px;
    top: 18px;
    width: 0;
    height: 0;
    border-top: 6px solid transparent;
    border-bottom: 6px solid transparent;
    border-right: 8px solid var(--bg-secondary, #f0f4f8);
  }

  /* --- Egg hatch animation (Yoshi-style) --- */
  .ori-egg-container {
    position: relative;
    width: 64px;
    height: 80px;
    flex-shrink: 0;
  }

  .ori-egg {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 64px;
    height: 80px;
    transform-origin: center bottom;
  }

  .ori-egg-shell {
    fill: #ffffff;
    stroke: var(--primary-color);
    stroke-width: 2;
  }

  .ori-egg-spot {
    fill: var(--primary-color);
    opacity: 0.5;
  }

  /* Shell halves revealed after crack */
  .ori-shell-left,
  .ori-shell-right {
    position: absolute;
    bottom: 0;
    width: 32px;
    height: 80px;
    overflow: hidden;
    opacity: 0;
  }
  .ori-shell-left { left: 0; }
  .ori-shell-right { right: 0; }

  /* Hatched Ori avatar (hidden initially) */
  .ori-egg-container .ori-avatar-hatched {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--primary-color);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.3) translateY(20px);
  }

  .ori-egg-container .ori-avatar-hatched svg {
    width: 44px;
    height: 44px;
  }

  /* Crack line overlay */
  .ori-crack-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 64px;
    height: 80px;
    opacity: 0;
    pointer-events: none;
  }

  /* Phase 0 content (speech bubble + input) hidden until hatch */
  .ori-hatch-reveal {
    opacity: 0;
    transform: translateY(8px);
    transition: none;
  }

  /* === Animation states === */

  /* 1. Wobble the egg */
  .egg-animating .ori-egg {
    animation: eggWobble 0.6s ease-in-out;
  }

  @keyframes eggWobble {
    0%   { transform: rotate(0deg); }
    20%  { transform: rotate(8deg); }
    40%  { transform: rotate(-8deg); }
    60%  { transform: rotate(5deg); }
    80%  { transform: rotate(-3deg); }
    100% { transform: rotate(0deg); }
  }

  /* 2. Show crack */
  .egg-cracked .ori-crack-line {
    opacity: 1;
    animation: crackAppear 0.3s ease-out forwards;
  }

  @keyframes crackAppear {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  /* 3. Shell halves fly apart */
  .egg-hatching .ori-egg { opacity: 0; }
  .egg-hatching .ori-crack-line { opacity: 0; }

  .egg-hatching .ori-shell-left {
    opacity: 1;
    animation: shellFlyLeft 0.5s ease-in forwards;
  }

  .egg-hatching .ori-shell-right {
    opacity: 1;
    animation: shellFlyRight 0.5s ease-in forwards;
  }

  @keyframes shellFlyLeft {
    0%   { transform: translate(0, 0) rotate(0deg); opacity: 1; }
    100% { transform: translate(-40px, -30px) rotate(-35deg); opacity: 0; }
  }

  @keyframes shellFlyRight {
    0%   { transform: translate(0, 0) rotate(0deg); opacity: 1; }
    100% { transform: translate(40px, -30px) rotate(35deg); opacity: 0; }
  }

  /* 4. Ori pops up */
  .egg-hatching .ori-avatar-hatched {
    animation: oriPopUp 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 0.15s forwards;
  }

  @keyframes oriPopUp {
    0%   { opacity: 0; transform: scale(0.3) translateY(20px); }
    60%  { opacity: 1; transform: scale(1.1) translateY(-4px); }
    100% { opacity: 1; transform: scale(1) translateY(0); }
  }

  /* 5. Reveal speech bubble + input */
  .egg-hatched .ori-hatch-reveal {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 0.4s ease-out, transform 0.4s ease-out;
  }

  #onboardingModal .onboarding-next-btn {
    background-color: var(--primary-color);
    border-color: var(--primary-color);
    color: #fff;
    transition: background-color 0.2s ease-in-out, border-color 0.2s ease-in-out, color 0.2s ease-in-out, transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
  }

