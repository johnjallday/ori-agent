  #onboardingModal .onboarding-next-btn:focus,
  #onboardingModal .onboarding-next-btn:active {
    background-color: var(--primary-light);
    border-color: var(--primary-light);
    color: #fff;
    transform: translateY(-1px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }

  /* API key provider tabs */
  .api-key-tabs .nav-link {
    color: var(--text-secondary);
    border: 1px solid transparent;
    border-radius: 6px 6px 0 0;
    padding: 6px 14px;
    font-size: 0.85rem;
  }

  .api-key-tabs .nav-link.active {
    color: var(--text-primary);
    background: var(--bg-secondary);
    border-color: var(--border-color) var(--border-color) var(--bg-secondary);
  }

  .onboarding-progress-shell {
    margin-bottom: 1.5rem;
  }

  .onboarding-step-label {
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .onboarding-progress-track {
    height: 6px;
    background: color-mix(in srgb, var(--border-color) 72%, transparent);
  }

  .onboarding-progress-track .progress-bar {
    background: var(--primary-color);
    transition: width 0.2s ease-in-out;
  }

  .onboarding-secondary-action {
    appearance: none;
    border: 0;
    background: transparent;
    color: var(--text-secondary);
    font-size: 0.78rem;
    padding: 0.15rem 0.1rem;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--text-secondary) 35%, transparent);
    text-underline-offset: 3px;
  }

  .onboarding-secondary-action:hover,
  .onboarding-secondary-action:focus-visible {
    color: var(--text-primary);
    text-decoration-color: currentColor;
  }

  .onboarding-footnote {
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .onboarding-actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .onboarding-actions-end {
    justify-content: flex-end;
  }

  .onboarding-model-help {
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    #onboardingModal .modal-dialog,
    .onboarding-phase,
    .egg-animating .ori-egg,
    .egg-cracked .ori-crack-line,
    .egg-hatching .ori-shell-left,
    .egg-hatching .ori-shell-right,
    .egg-hatching .ori-avatar-hatched,
    .egg-hatched .ori-hatch-reveal {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

