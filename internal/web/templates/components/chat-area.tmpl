<div class="modern-card p-4 mb-3" style="height: 60vh; position: relative; display: flex; flex-direction: column;">
  <!-- Combined Session & Agent Info Bar -->
  <div id="chatInfoBar" class="chat-info-bar mb-3" style="display: none;">
    <div class="d-flex align-items-center justify-content-between">
      <div class="d-flex align-items-center gap-3">
        <!-- Session Info -->
        <div id="chatSessionInfo" class="d-flex align-items-center gap-2">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="chat-session-icon">
            <path d="M20,2H4A2,2 0 0,0 2,4V22L6,18H20A2,2 0 0,0 22,16V4A2,2 0 0,0 20,2M6,9H18V11H6M14,14H6V12H14M18,8H6V6H18"/>
          </svg>
          <span class="chat-session-title" id="chatSessionTitle">-</span>
        </div>
        <!-- Separator -->
        <span class="chat-info-separator">|</span>
        <!-- Agent Info -->
        <div id="chatAgentInfo" class="d-flex align-items-center gap-2">
          <span class="chat-agent-indicator"></span>
          <span class="chat-agent-name" id="chatAgentName">-</span>
        </div>
      </div>
      <div class="d-flex align-items-center gap-2">
        <a href="#" class="btn btn-sm btn-outline-primary chat-agent-edit-btn" id="chatEditAgentBtn" title="Edit agent settings">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
          </svg>
          Edit
        </a>
        <button type="button" class="btn btn-sm btn-outline-secondary chat-agent-change-btn" id="chatChangeAgentBtn" title="Change agent for this session">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12,2A2,2 0 0,1 14,4C14,4.74 13.6,5.39 13,5.73V7H14A7,7 0 0,1 21,14H22A1,1 0 0,1 23,15V18A1,1 0 0,1 22,19H21V20A2,2 0 0,1 19,22H5A2,2 0 0,1 3,20V19H2A1,1 0 0,1 1,18V15A1,1 0 0,1 2,14H3A7,7 0 0,1 10,7H11V5.73C10.4,5.39 10,4.74 10,4A2,2 0 0,1 12,2Z"/>
          </svg>
          Change
        </button>
      </div>
    </div>
  </div>
  <div id="chatArea" class="overflow-auto flex-grow-1" style="padding-right: 0.5rem;">
    <!-- Chat messages will be populated here -->
  </div>
</div>

<div class="modern-card p-3">
  <!-- File Upload Area -->
  <div id="uploadedFilesArea" class="mb-3" style="display: none;">
    <div class="d-flex align-items-center justify-content-between mb-2">
      <label class="chat-label" style="font-size: 12px; margin: 0;">Uploaded Files:</label>
      <button id="clearFilesBtn" class="btn btn-sm btn-link clear-files-btn" style="padding: 0; font-size: 12px;">
        Clear all
      </button>
    </div>
    <div id="uploadedFilesList" class="d-flex flex-wrap gap-2"></div>
  </div>

  <div class="d-flex gap-3 align-items-end">
    <div class="flex-grow-1">
      <textarea
        id="input"
        class="modern-input w-100"
        placeholder="Type your message here..."
        rows="3"
        style="resize: vertical; min-height: 80px; max-height: 200px; font-family: inherit;"
      ></textarea>
      <div class="d-flex justify-content-between align-items-center mt-2">
        <div class="d-flex gap-2 align-items-center">
          <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" id="enterToSend" checked>
            <label class="form-check-label chat-label" for="enterToSend" style="font-size: 12px;">
              Enter to send
            </label>
          </div>
          <label for="fileUpload" class="btn btn-sm attach-files-btn" style="margin: 0; padding: 4px 10px; background: var(--bg-secondary); color: var(--text-primary); border: 1px solid var(--border-color); cursor: pointer; font-size: 12px; border-radius: 6px; transition: all 0.2s ease;">
            📎 Attach Files
          </label>
          <input type="file" id="fileUpload" multiple accept=".txt,.md,.pdf,.doc,.docx,.csv,.json,.xml,.html,.mp3,.wav,.flac,.ogg,.zip,.pptx,.xlsx" style="display: none;">
          <button id="clearChatBtn" class="btn btn-sm clear-chat-btn" style="padding: 4px 10px; font-size: 12px; border-radius: 6px; transition: all 0.2s ease;" title="Clear chat history">
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: middle;">
              <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
            </svg>
            Clear
          </button>
        </div>
      </div>
    </div>
    <button
      id="sendBtn"
      class="modern-btn modern-btn-primary"
      style="height: fit-content; min-width: 48px; padding: 0.5rem 1rem;"
      title="Send message"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
        <path d="M2,21L23,12L2,3V10L17,12L2,14V21Z"/>
      </svg>
    </button>
  </div>
</div>
