{{define "personal-assistant-today.tmpl"}}
<!-- Home owns this Today projection, and the Personal Assistant drawer shows it
     at the top of its one view: a status banner, what needs you, a row that
     links to the Daily Brief, and a row that summarises work. It is rendered
     only on Home by ori-guide.tmpl, so every controller id has one stable
     mount.

     The Daily Brief itself is not here. It is read in the Daily Brief station
     in My HQ; the drawer keeps one row that links to it. The folder flow is
     not here either: it runs in the conversation (personal-assistant-
     folder.tmpl), and only an offer still waiting for an answer when the page
     loads is placed in Needs you. -->
<section id="personalAssistantToday" class="personal-assistant-today" data-state="loading"
         aria-labelledby="personalAssistantTodayTitle" hidden>
  <!-- Names the region for assistive technology. The drawer's own header
       already shows the assistant's name, so this is not repeated visually. -->
  <h3 id="personalAssistantTodayTitle" class="visually-hidden">Today</h3>
  <div id="personalAssistantTodayBanner" class="personal-assistant-today__banner" role="status" aria-live="polite"></div>

  <!-- The strip: one line, "Needs you · N" or "Today", that every opening of
       the drawer starts folded so the conversation is what shows. Show opens
       Needs you, the brief row and the progress row until the drawer closes;
       this tab's own new report opens it once by itself. Setup prerequisites
       stay expanded with no strip. Folding never discards a card or anything
       typed into it. -->
  <div id="personalAssistantTodayStrip" class="personal-assistant-summary" hidden>
    <span id="personalAssistantTodayStripText" class="personal-assistant-summary__text"></span>
    <button type="button" id="personalAssistantTodayStripToggle" class="personal-assistant-summary__toggle"
            aria-expanded="false" aria-controls="personalAssistantTodaySections">Show</button>
  </div>

  {{template "assistant-led-setup.tmpl" .}}

  <!-- The hired assistant proposes HQ before any folder work is available. -->
  <section id="personalAssistantHQCard" class="pa-specialist-offer pa-hq-card"
           aria-labelledby="personalAssistantHQHeadline" hidden>
    <span id="personalAssistantHQEyebrow" class="personal-assistant-today__eyebrow"></span>
    <p id="personalAssistantHQHeadline" class="pa-specialist-offer__headline"></p>
    <div id="personalAssistantHQPlan">
      <!-- The directory leads: it is the one thing the user must confirm. The
           brief time is the last field. -->
      <label for="personalAssistantHQRoot">Workspace directory</label>
      <div class="pa-hq-card__root">
        <input id="personalAssistantHQRoot" class="modern-input w-100" readonly>
        <button type="button" id="personalAssistantHQChange" class="btn btn-sm btn-outline-secondary">Change</button>
      </div>
      <small id="personalAssistantHQRootStatus" aria-live="polite"></small>
      <label for="personalAssistantHQName">HQ name</label>
      <input id="personalAssistantHQName" class="modern-input w-100" value="My HQ" maxlength="100">
      <label for="personalAssistantHQTime">Daily Brief time (weekdays)</label>
      <input id="personalAssistantHQTime" type="time" class="modern-input" value="08:00">
      <p id="personalAssistantHQScope">All workspaces, including future ones.</p>
      <!-- Notes are part of the HQ review (assistant-hq-onboarding 3.5). The
           review shows where they go and what Ori keeps up to date before
           anything is written; an existing folder is shown as it is and never
           replaced. personal-hq-notes-review.js decides what is shown. -->
      <section id="personalAssistantHQNotes" class="pa-hq-card__notes" aria-labelledby="personalAssistantHQNotesTitle" hidden>
        <h5 id="personalAssistantHQNotesTitle" class="pa-hq-card__notes-title">Notes, ready to use</h5>
        <p id="personalAssistantHQNotesMessage" class="pa-hq-card__notes-message"></p>
        <div id="personalAssistantHQNotesLocation" class="pa-hq-card__notes-location">
          <span>Notes location</span>
          <b id="personalAssistantHQNotesPath"></b>
        </div>
        <p id="personalAssistantHQNotesScope" class="pa-hq-card__notes-scope"></p>
        <details id="personalAssistantHQNotesOptions" class="pa-hq-card__notes-options">
          <summary>Notes options</summary>
          <label class="form-check pa-hq-card__notes-include">
            <input type="checkbox" class="form-check-input" id="personalAssistantHQNotesInclude" checked>
            <span class="form-check-label">Create a new notes folder with my HQ</span>
          </label>
          <button type="button" id="personalAssistantHQNotesChoose" class="btn btn-sm btn-outline-secondary">Choose another location…</button>
          <p class="pa-hq-card__notes-hint">Already have notes? Leave this unchecked and connect your folder from Notes later.</p>
        </details>
      </section>
    </div>
    <ul id="personalAssistantHQReceipt" hidden></ul>
    <div id="personalAssistantHQNotesResult" class="pa-hq-card__notes-result" hidden>
      <p id="personalAssistantHQNotesResultText" role="status" aria-live="polite" tabindex="-1"></p>
      <button type="button" id="personalAssistantHQNotesRetry" class="btn btn-sm btn-primary pa-hq-card__notes-retry" hidden>Retry notes setup</button>
    </div>
    <!-- The first step after a build (assistant-hq-onboarding 4.1–4.5). Every
         choice is optional; nothing here reads a folder or starts setup until
         it is pressed. hqFirstActionView decides which choices show. -->
    <div id="personalAssistantHQFirst" class="pa-hq-card__first" hidden>
      <p id="personalAssistantHQFirstLead" class="pa-hq-card__first-lead"></p>
      <div class="pa-hq-card__choices">
        <button type="button" id="personalAssistantHQFirstNote" class="pa-hq-card__choice" hidden>
          <strong>Save a quick note</strong><span>An idea, a reminder, anything.</span>
        </button>
        <a id="personalAssistantHQFirstOpenNotes" class="pa-hq-card__choice" href="#" hidden>
          <strong>Open Notes</strong><span>See your notes in your HQ.</span>
        </a>
        <button type="button" id="personalAssistantHQFirstSetupNotes" class="pa-hq-card__choice" hidden>
          <strong>Set up notes</strong><span>Choose where your notes live, whenever you like.</span>
        </button>
        <button type="button" id="personalAssistantHQFirstFolder" class="pa-hq-card__choice">
          <strong>Show me a project folder</strong><span>Start with something you already have.</span>
        </button>
      </div>
      <button type="button" id="personalAssistantHQFirstExplore" class="btn btn-sm btn-link pa-hq-card__explore">I’ll explore for now</button>
      <form id="personalAssistantHQNoteForm" class="pa-hq-card__note" hidden>
        <label for="personalAssistantHQNoteText">Anything worth keeping?</label>
        <textarea id="personalAssistantHQNoteText" class="modern-input w-100" rows="4" maxlength="4000"
                  placeholder="I had an idea…"></textarea>
        <small class="pa-hq-card__note-hint">Saves to your Notes inbox.</small>
        <p id="personalAssistantHQNoteError" class="pa-specialist-offer__error" role="alert" hidden></p>
        <div class="pa-specialist-offer__actions">
          <button type="submit" id="personalAssistantHQNoteSave" class="btn btn-sm btn-primary">Save note</button>
          <button type="button" id="personalAssistantHQNoteBack" class="btn btn-sm btn-outline-secondary">Back</button>
        </div>
      </form>
      <div id="personalAssistantHQNoteSaved" class="pa-hq-card__saved" hidden>
        <p id="personalAssistantHQNoteSavedTitle" class="pa-hq-card__saved-title" role="status" aria-live="polite" tabindex="-1"></p>
        <blockquote id="personalAssistantHQNoteSavedText" class="pa-hq-card__saved-text"></blockquote>
        <div class="pa-specialist-offer__actions">
          <button type="button" id="personalAssistantHQNoteAnother" class="btn btn-sm btn-primary">Add another note</button>
          <button type="button" id="personalAssistantHQNoteDone" class="btn btn-sm btn-outline-secondary">Done</button>
        </div>
      </div>
    </div>
    <div class="pa-specialist-offer__actions">
      <button type="button" id="personalAssistantHQBuild" class="btn btn-sm btn-primary" disabled>Build</button>
      <button type="button" id="personalAssistantHQAdjust" class="btn btn-sm btn-outline-secondary">Adjust…</button>
      <button type="button" id="personalAssistantHQNotNow" class="btn btn-sm btn-outline-secondary">Not now</button>
    </div>
    <p id="personalAssistantHQStatus" role="status" aria-live="polite"></p>
    <p id="personalAssistantHQError" class="pa-specialist-offer__error" role="alert" hidden></p>
  </section>

  <!-- Canonical setup/program/add-on reporting. Controls either navigate to a
       server-derived workspace route or open the reviewed setup shell; none is
       a Personal HQ cross-workspace action. -->
  <section id="personalAssistantSpecialistSetup" class="pa-specialist-setup"
           aria-labelledby="personalAssistantSpecialistSetupTitle" hidden>
    <div>
      <h4 id="personalAssistantSpecialistSetupTitle">Specialist setup</h4>
      <p id="personalAssistantSpecialistSetupStatus" role="status"></p>
      <p id="personalAssistantSpecialistSetupSamples" class="personal-assistant-today__meta" hidden></p>
    </div>
    <ul id="personalAssistantSpecialistSetupRuns" aria-label="Setup runs"></ul>
    <div id="personalAssistantSpecialistSetupActions" class="pa-specialist-setup__actions"></div>
  </section>

  <div id="personalAssistantTodaySections" class="personal-assistant-today__sections">
    <!-- What needs the user's decision comes first, and only when there is
         something: an empty section would read as an all-clear. -->
    <section id="personalAssistantNeedsYou" class="personal-assistant-today__needs"
             aria-labelledby="personalAssistantNeedsYouTitle" hidden>
      <div class="personal-assistant-today__needs-head">
        <h4 id="personalAssistantNeedsYouTitle">Needs you</h4>
        <p class="text-muted small">Requests from your assistant. Workspace tickets and findings have their own lists.</p>
        <span id="personalAssistantNeedsYouCount" class="personal-assistant-today__count">0</span>
      </div>
      <div id="personalAssistantNeedsYouCards"></div>
      <details id="personalAssistantNeedsYouQueue" class="personal-assistant-today__queue" hidden>
        <summary id="personalAssistantNeedsYouQueueTitle">Also needs you</summary>
        <div id="personalAssistantNeedsYouQueueCards"></div>
        <ul id="personalAssistantNeedsYouItems"></ul>
      </details>
    </section>

    <!-- Two rows: where the brief is, and how much work is under way. -->
    <div id="personalAssistantGlance" class="personal-assistant-glance" role="group"
         aria-label="Today at a glance" hidden>
      <a id="personalAssistantBriefRow" class="personal-assistant-glance__row" href="#" hidden>
        <i class="bi bi-file-earmark-text personal-assistant-glance__icon" aria-hidden="true"></i>
        <span class="personal-assistant-glance__text">
          <span class="personal-assistant-glance__label">Today's brief</span>
          <span id="personalAssistantBriefRowStatus" class="personal-assistant-glance__detail"></span>
        </span>
        <span class="personal-assistant-glance__action">Open in My HQ</span>
        <i class="bi bi-chevron-right personal-assistant-glance__chevron" aria-hidden="true"></i>
      </a>
      <button type="button" id="personalAssistantProgressRow" class="personal-assistant-glance__row"
              aria-expanded="false" aria-controls="personalAssistantProgressLists" hidden>
        <i class="bi bi-clock personal-assistant-glance__icon" aria-hidden="true"></i>
        <span class="personal-assistant-glance__text">
          <span id="personalAssistantProgressText" class="personal-assistant-glance__label"></span>
        </span>
        <span id="personalAssistantProgressAction" class="personal-assistant-glance__action">Show</span>
        <i class="bi bi-chevron-down personal-assistant-glance__chevron" aria-hidden="true"></i>
      </button>
    </div>

    <!-- What the progress row expands, in place. -->
    <div id="personalAssistantProgressLists" class="personal-assistant-today__progress" hidden>
      <section id="personalAssistantWorkingOn" aria-labelledby="personalAssistantWorkingOnTitle" hidden>
        <h4 id="personalAssistantWorkingOnTitle">Working on</h4>
        <div id="personalAssistantWorkingOnContent"></div>
        <section id="personalAssistantTodayMeetingsSection" class="personal-assistant-today__meetings"
                 aria-labelledby="personalAssistantTodayMeetingsTitle" hidden>
          <h5 id="personalAssistantTodayMeetingsTitle">Meetings</h5>
          <ul id="personalAssistantTodayMeetings"></ul>
          <p id="personalAssistantTodayMeetingsNote" class="personal-assistant-today__meta"></p>
        </section>
        <ul id="personalAssistantWorkingOnItems"></ul>
      </section>
      <section id="personalAssistantDone" aria-labelledby="personalAssistantDoneTitle" hidden>
        <h4 id="personalAssistantDoneTitle">Done</h4>
        <ul id="personalAssistantDoneItems"></ul>
      </section>
    </div>
    <footer id="personalAssistantTodayFooter" class="personal-assistant-today__meta" hidden>
      <span id="personalAssistantTodayUnavailable"></span>
      <button id="personalAssistantTodayRetry" type="button" class="btn btn-sm btn-link">Retry</button>
    </footer>
  </div>
</section>
{{end}}
