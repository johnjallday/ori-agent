{{define "personal-assistant-today.tmpl"}}
<!-- Home owns this Today projection, but the shared Personal Assistant drawer
     owns its presentation. It is rendered only on Home by ori-guide.tmpl so
     every controller ID has one stable mount and non-Home pages remain Ask-only. -->
<section id="personalAssistantToday" class="personal-assistant-today" data-state="loading"
         aria-labelledby="personalAssistantTodayTitle" hidden>
  <header class="personal-assistant-today__header">
    <div>
      <span id="personalAssistantTodayEyebrow" class="personal-assistant-today__eyebrow">Today from your assistant</span>
      <h3 id="personalAssistantTodayTitle" class="personal-assistant-today__title">Today</h3>
      <p id="personalAssistantTodayMeta" class="personal-assistant-today__meta"></p>
    </div>
    <nav class="personal-assistant-today__links" aria-label="Personal assistant details">
      <a id="personalAssistantTodayHQ" href="/" hidden>Personal HQ</a>
      <a id="personalAssistantTodayAgreement" href="/" hidden>Working agreement</a>
      <a id="personalAssistantTodayMemory" href="/" hidden>Memory</a>
      <a href="/profile#personalHQKnowledge">Review or change remembered facts</a>
      <a id="personalAssistantTodayInterview" href="/profile#personalHQInterview" hidden>Optional interview</a>
      <a id="personalAssistantTodayAdvanced" href="/agents">Advanced</a>
    </nav>
  </header>
  <div id="personalAssistantTodayBanner" class="personal-assistant-today__banner" role="status" aria-live="polite"></div>

  {{template "assistant-led-setup.tmpl" .}}

  <!-- The Daily Brief has one final, drawer-owned mount. Its existing module
       still owns loading, generation, refresh, history, and degraded states. -->
  <section id="homeDailyBrief" class="home-daily-brief" data-state="loading"
           aria-labelledby="homeDailyBriefTitle" hidden>
    <header class="home-daily-brief-header">
      <div class="home-daily-brief-heading">
        <span class="home-daily-brief-eyebrow">Daily Brief</span>
        <h4 id="homeDailyBriefTitle" class="home-daily-brief-title">Today</h4>
        <p id="homeDailyBriefMeta" class="home-daily-brief-meta"></p>
      </div>
      <div class="home-daily-brief-actions">
        <button type="button" id="homeDailyBriefRefreshBtn" class="modern-btn modern-btn-primary modern-btn-sm">Refresh</button>
        <details class="home-daily-brief-menu" id="homeDailyBriefMenu">
          <summary class="home-daily-brief-menu-toggle" aria-label="More Daily Brief actions" title="More actions">
            <span aria-hidden="true">&#8943;</span>
          </summary>
          <div class="home-daily-brief-menu-panel">
            <a id="homeDailyBriefOpenHQ" href="/" class="home-daily-brief-menu-item">Open My HQ</a>
            <button type="button" id="homeDailyBriefSettingsBtn" class="home-daily-brief-menu-item">Brief settings</button>
          </div>
        </details>
      </div>
    </header>
    <div id="homeDailyBriefBanner" class="home-daily-brief-banner" role="status" aria-live="polite" hidden></div>
    <div id="homeDailyBriefBody" class="home-daily-brief-body" aria-live="polite">
      <div class="home-daily-brief-placeholder">Loading your Daily Brief…</div>
    </div>
  </section>

  <!-- The hired assistant proposes HQ before any folder work is available. -->
  <section id="personalAssistantHQCard" class="pa-specialist-offer pa-hq-card"
           aria-labelledby="personalAssistantHQHeadline" hidden>
    <span id="personalAssistantHQEyebrow" class="personal-assistant-today__eyebrow"></span>
    <p id="personalAssistantHQHeadline" class="pa-specialist-offer__headline"></p>
    <div id="personalAssistantHQPlan">
      <label for="personalAssistantHQName">HQ name</label>
      <input id="personalAssistantHQName" class="modern-input w-100" value="My HQ" maxlength="100">
      <label for="personalAssistantHQRoot">Workspace directory</label>
      <div class="pa-hq-card__root">
        <input id="personalAssistantHQRoot" class="modern-input w-100" readonly>
        <button type="button" id="personalAssistantHQChange" class="btn btn-sm btn-outline-secondary">Change</button>
      </div>
      <small id="personalAssistantHQRootStatus" aria-live="polite"></small>
      <label for="personalAssistantHQTime">Daily Brief time (weekdays)</label>
      <input id="personalAssistantHQTime" type="time" class="modern-input" value="08:00">
      <p id="personalAssistantHQScope">All workspaces, including future ones.</p>
    </div>
    <ul id="personalAssistantHQReceipt" hidden></ul>
    <div class="pa-specialist-offer__actions">
      <button type="button" id="personalAssistantHQBuild" class="btn btn-sm btn-primary" disabled>Build</button>
      <button type="button" id="personalAssistantHQAdjust" class="btn btn-sm btn-outline-secondary">Adjust…</button>
      <button type="button" id="personalAssistantHQNotNow" class="btn btn-sm btn-outline-secondary">Not now</button>
    </div>
    <p id="personalAssistantHQStatus" role="status" aria-live="polite"></p>
    <p id="personalAssistantHQError" class="pa-specialist-offer__error" role="alert" hidden></p>
  </section>

  <!-- Show me a folder: the assistant's first proactive act. The chooser names
       folders by identifier and the server resolves them; the offer card is
       built from counts and names only. Shown for an active or paused
       assistant, never before the hire or while HQ is being built. -->
  <section id="personalAssistantFolder" class="pa-folder pa-folder__experience" data-state="idle"
           aria-labelledby="personalAssistantFolderTitle" hidden>
    <div id="personalAssistantFolderScene" class="pa-folder__scene" data-phase="choosing" hidden>
      <div class="pa-folder__scene-copy">
        <p class="pa-folder__scene-kicker">A little field trip</p>
        <p id="personalAssistantFolderSceneLabel" class="pa-folder__scene-label" role="status" aria-live="polite"></p>
        <div id="personalAssistantFolderSceneFinds" class="pa-folder__scene-finds"></div>
        <p class="pa-folder__scene-assurance">A read-only peek. Nothing moves.</p>
      </div>
      <div class="pa-folder__scene-art" aria-hidden="true">
        <span id="personalAssistantFolderSceneAvatar" class="pa-folder__scene-avatar"></span>
        <svg class="pa-folder__scene-folder" viewBox="0 0 52 45" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M3 8a4 4 0 0 1 4-4h13l5 5h20a4 4 0 0 1 4 4v25a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4V8Z" fill="currentColor" stroke="currentColor" stroke-width="3"/>
          <path d="M4 18h44v20a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4V18Z" fill="var(--hc-panel)" stroke="currentColor" stroke-width="3"/>
          <path d="M17 26h18M17 32h11" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
        <span class="pa-folder__scene-spark"></span>
      </div>
    </div>
    <div id="personalAssistantFolderChooser" class="pa-folder__chooser" hidden>
      <p id="personalAssistantFolderTitle" class="pa-folder__prompt">Which folder should I explore?</p>
      <div id="personalAssistantFolderChips" class="pa-folder__chips" role="group" aria-label="Folders"></div>
      <p id="personalAssistantFolderNote" class="pa-folder__note" hidden></p>
      <p id="personalAssistantFolderStatus" class="pa-folder__status" role="status" aria-live="polite" hidden></p>
    </div>
    <section id="personalAssistantFolderOffer" class="pa-specialist-offer pa-folder__offer"
             aria-labelledby="personalAssistantFolderOfferHeadline" hidden>
      <p id="personalAssistantFolderOfferHeadline" class="pa-specialist-offer__headline"></p>
      <p id="personalAssistantFolderOfferQuestion" class="pa-specialist-offer__question"></p>
      <details class="pa-folder__why"><summary>Why this suggestion?</summary>
        <p id="personalAssistantFolderOfferReason" class="pa-folder__reason"></p>
      </details>
      <ul id="personalAssistantFolderReceipt" class="pa-folder__receipt" hidden></ul>
      <div id="personalAssistantFolderOfferActions" class="pa-specialist-offer__actions"></div>
      <p id="personalAssistantFolderOfferNote" class="pa-folder__status" role="status" aria-live="polite" hidden></p>
      <p id="personalAssistantFolderOfferError" class="pa-specialist-offer__error" role="alert" hidden></p>
    </section>
  </section>

  <!-- The domain offer is server-authored and non-blocking. An empty or failed
       detection keeps this whole region absent. -->
  <section id="personalAssistantSpecialistOffer" class="pa-specialist-offer" data-decision="unanswered"
           aria-labelledby="personalAssistantSpecialistOfferHeadline" hidden>
    <p id="personalAssistantSpecialistOfferHeadline" class="pa-specialist-offer__headline"></p>
    <p id="personalAssistantSpecialistOfferQuestion" class="pa-specialist-offer__question"></p>
    <p id="personalAssistantSpecialistOfferAccepted" class="pa-specialist-offer__accepted" role="status" aria-live="polite" hidden></p>
    <div id="personalAssistantSpecialistOfferActions" class="pa-specialist-offer__actions">
      <button type="button" class="btn btn-sm btn-primary" id="personalAssistantSpecialistAcceptBtn">Yes</button>
      <button type="button" class="btn btn-sm btn-outline-secondary" id="personalAssistantSpecialistDeclineBtn">No thanks</button>
    </div>
    <p id="personalAssistantSpecialistOfferError" class="pa-specialist-offer__error" role="alert" hidden></p>
  </section>
  <p id="personalAssistantSpecialistManual" class="pa-specialist-manual" hidden></p>

  <!-- Canonical setup/program/add-on reporting. Controls either navigate to a
       server-derived workspace route or open the reviewed setup shell; none is
       a Personal HQ cross-workspace action. -->
  <section id="personalAssistantSpecialistSetup" class="pa-specialist-setup"
           aria-labelledby="personalAssistantSpecialistSetupTitle" hidden>
    <div>
      <h4 id="personalAssistantSpecialistSetupTitle">Specialist setup</h4>
      <p id="personalAssistantSpecialistSetupStatus" role="status"></p>
      <p id="personalAssistantSpecialistSetupSamples" class="personal-assistant-today__meta" hidden></p>
    </div>
    <ul id="personalAssistantSpecialistSetupRuns" aria-label="Setup runs"></ul>
    <div id="personalAssistantSpecialistSetupActions" class="pa-specialist-setup__actions"></div>
  </section>

  <div id="personalAssistantTodaySections" class="personal-assistant-today__sections">
    <section id="personalAssistantNeedsYou" aria-labelledby="personalAssistantNeedsYouTitle" hidden>
      <h4 id="personalAssistantNeedsYouTitle">Needs you</h4>
      <p id="personalAssistantTodayAllClear" hidden>Nothing needs you right now.</p>
      <div id="personalAssistantNeedsYouCards"></div>
      <details id="personalAssistantNeedsYouQueue" class="personal-assistant-today__queue" hidden>
        <summary id="personalAssistantNeedsYouQueueTitle">Also needs you</summary>
        <div id="personalAssistantNeedsYouQueueCards"></div>
        <ul id="personalAssistantNeedsYouItems"></ul>
      </details>
    </section>
    <section id="personalAssistantWorkingOn" aria-labelledby="personalAssistantWorkingOnTitle" hidden>
      <h4 id="personalAssistantWorkingOnTitle">Working on</h4>
      <div id="personalAssistantWorkingOnContent"></div>
      <section id="personalAssistantTodayMeetingsSection" class="personal-assistant-today__meetings"
               aria-labelledby="personalAssistantTodayMeetingsTitle" hidden>
        <h5 id="personalAssistantTodayMeetingsTitle">Meetings</h5>
        <ul id="personalAssistantTodayMeetings"></ul>
        <p id="personalAssistantTodayMeetingsNote" class="personal-assistant-today__meta"></p>
      </section>
      <ul id="personalAssistantWorkingOnItems"></ul>
    </section>
    <section id="personalAssistantDone" aria-labelledby="personalAssistantDoneTitle" hidden>
      <h4 id="personalAssistantDoneTitle">Done</h4>
      <ul id="personalAssistantDoneItems"></ul>
    </section>
  </div>
  <footer id="personalAssistantTodayFooter" class="personal-assistant-today__meta" hidden>
    <span id="personalAssistantTodayUnavailable"></span>
    <button id="personalAssistantTodayRetry" type="button" class="btn btn-sm btn-link">Retry</button>
  </footer>
</section>
{{end}}
