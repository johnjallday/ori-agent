{{define "support-chat.tmpl"}}
<!-- Floating Workspace Assistant -->
<div id="hubSupportChat" class="hub-support-chat hub-support-chat-workspace" data-state="closed">
  <div id="hubSupportChatPanel" class="hub-support-chat-panel" role="dialog" aria-labelledby="hubSupportChatTitle" aria-modal="false" aria-hidden="true" tabindex="-1">
    <header class="hub-support-chat-header">
      <div class="hub-support-chat-header-text">
        <span id="hubSupportChatTitle" class="hub-support-chat-title">Workspace Assistant</span>
        <span id="hubSupportChatSubtitle" class="hub-support-chat-subtitle">Ask about this workspace</span>
      </div>
      <button type="button" id="hubSupportChatCloseBtn" class="hub-support-chat-close" aria-label="Close chat">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </header>

    <div id="homeAssistantCard" class="hub-workspace-assistant">
      <form id="homeAssistantForm" class="hub-workspace-assistant-form" autocomplete="off">
        <div class="hub-workspace-assistant-meta">
          <span id="homeAssistantIdentityName" class="hub-workspace-assistant-identity" title="Workspace Manager">Workspace Manager</span>
          <span class="hub-workspace-assistant-scope">Workspace</span>
        </div>
        <div id="homeAssistantWorkspaceModeSwitch" class="home-assistant-workspace-mode-switch hub-workspace-mode-switch" role="group" aria-label="Workspace prompt mode">
          <button type="button" class="home-assistant-workspace-mode-btn is-active" data-home-workspace-mode="task" aria-pressed="true">Task</button>
          <button type="button" class="home-assistant-workspace-mode-btn" data-home-workspace-mode="ask" aria-pressed="false">Ask</button>
          <button type="button" class="home-assistant-workspace-mode-btn" data-home-workspace-mode="note" aria-pressed="false">Note</button>
        </div>
        <div class="hub-workspace-assistant-compose">
          <textarea id="homeAssistantInput" class="hub-support-chat-input modern-input" rows="1" maxlength="800"
                    placeholder="Create a task for Workspace Manager…"
                    aria-label="Workspace manager prompt"></textarea>
          <button id="homeAssistantSendBtn" type="submit" class="modern-btn modern-btn-primary home-assistant-send-btn hub-support-chat-send" aria-label="Send workspace assistant prompt">
            <span class="hub-support-chat-send-label">Create Task</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="22" y1="2" x2="11" y2="13"></line>
              <polygon points="22 2 15 22 11 13 2 9 22 2"></polygon>
            </svg>
          </button>
        </div>
      </form>

      <div id="homeAssistantQuickPrompts" class="hub-workspace-assistant-quick">
        <span class="home-assistant-quick-label mb-0">Quick Actions</span>
        <button id="homeAssistantQuickPlan" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                data-home-prompt="Analyze this workspace and propose the next 3 highest-impact tasks with acceptance criteria.">
          Plan Next
        </button>
        <button id="homeAssistantQuickTasks" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                data-home-prompt="Review current tasks in this workspace, identify blockers, and suggest the next 3 tasks.">
          Unblock Tasks
        </button>
        <button id="homeAssistantQuickNotes" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                data-home-prompt="Summarize the notes and current workspace context into a concise workspace description.">
          Summarize Notes
        </button>
        <button id="homeAssistantQuickReview" type="button" class="modern-btn modern-btn-secondary modern-btn-sm home-assistant-quick-btn"
                data-home-prompt="Run a risk review for this workspace and recommend mitigation steps.">
          Risk Review
        </button>
      </div>
    </div>

    <section id="homeAssistantThinkingModal" class="hub-support-chat-activity is-idle" data-home-assistant-surface="panel" aria-labelledby="homeAssistantThinkingModalLabel">
      <div class="hub-support-chat-status-row">
        <div>
          <div id="homeAssistantThinkingModalLabel" class="hub-support-chat-activity-title">Workspace Manager is ready</div>
          <div id="homeAssistantThinkingStatus" class="home-thinking-modal-status hub-support-chat-status" role="status" aria-live="polite">
            <span id="homeAssistantThinkingSpinner" class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true"></span>
            <span>Ready for your next task.</span>
          </div>
        </div>
      </div>

      <div id="homeAssistantRoutingSummary" class="home-assistant-routing-summary d-none"></div>
      <div id="homeAssistantPlanning" class="home-assistant-planning d-none mt-3"></div>
      <div id="homeAssistantInlineReply" class="home-assistant-inline-reply d-none mt-3"></div>
      <div id="homeAssistantActions" class="hub-support-chat-actions d-flex flex-wrap gap-2 mt-3 d-none"></div>

      <section id="homeAssistantConversationSection" class="home-assistant-conversation-section hub-support-chat-conversation-section mt-3 is-empty">
        <div class="home-assistant-conversation-section-header">
          <div>
            <div class="home-assistant-conversation-section-eyebrow">Conversation History</div>
            <div id="homeAssistantConversationSummary" class="home-assistant-conversation-section-copy">
              Progress updates and manager notes will appear here after you send a task.
            </div>
          </div>
          <button id="homeAssistantConversationToggleBtn" type="button" class="modern-btn modern-btn-secondary modern-btn-sm" hidden>
            Hide Conversation
          </button>
        </div>
        <div id="homeAssistantConversation" class="home-assistant-conversation home-assistant-conversation-modal hub-support-chat-conversation p-3" role="log" aria-live="polite">
          <div class="home-assistant-thinking-placeholder">
            Progress updates will appear here after you send a task.
          </div>
        </div>
      </section>
    </section>
  </div>
  <button type="button" id="hubSupportChatLauncher" class="hub-support-chat-launcher" aria-label="Open workspace assistant" aria-expanded="false">
    <svg class="hub-support-chat-launcher-icon hub-support-chat-launcher-icon-bubble" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <svg class="hub-support-chat-launcher-icon hub-support-chat-launcher-icon-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="18" y1="6" x2="6" y2="18"></line>
      <line x1="6" y1="6" x2="18" y2="18"></line>
    </svg>
    <span class="hub-support-chat-launcher-label">Workspace Assistant</span>
  </button>
</div>
{{end}}
