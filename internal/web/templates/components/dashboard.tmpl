<!-- Ori Dashboard — Command Bridge -->
<div class="home-command-bridge" data-first-run="{{if .Extra.IsFirstRun}}true{{else}}false{{end}}">
  <!-- Server-authoritative PAF Home region. Hidden until the status read proves
       eligibility, so legacy Home never flashes or inherits assistant copy. -->
  <section id="personalAssistantToday" class="personal-assistant-today" data-state="loading"
           aria-labelledby="personalAssistantTodayTitle" hidden>
    <header class="personal-assistant-today__header">
      <div>
        <span id="personalAssistantTodayEyebrow" class="personal-assistant-today__eyebrow">Today from your assistant</span>
        <h1 id="personalAssistantTodayTitle" class="personal-assistant-today__title">Today</h1>
        <p id="personalAssistantTodayMeta" class="personal-assistant-today__meta"></p>
      </div>
      <nav class="personal-assistant-today__links" aria-label="Personal assistant details">
        <a id="personalAssistantTodayHQ" href="/" hidden>Personal HQ</a>
        <a id="personalAssistantTodayAgreement" href="/" hidden>Working agreement</a>
        <a id="personalAssistantTodayMemory" href="/" hidden>Memory</a>
        <a id="personalAssistantTodayAdvanced" href="/agents">Advanced</a>
      </nav>
    </header>
    <div id="personalAssistantTodayBanner" class="personal-assistant-today__banner" role="status" aria-live="polite"></div>
    <div id="personalAssistantTodayBriefMount"></div>
    <div id="personalAssistantTodaySections" class="personal-assistant-today__sections">
      <section aria-labelledby="personalAssistantTodayDecisionsTitle">
        <h2 id="personalAssistantTodayDecisionsTitle">Decisions</h2>
        <ul id="personalAssistantTodayDecisions"></ul>
      </section>
      <section aria-labelledby="personalAssistantTodayPrioritiesTitle">
        <h2 id="personalAssistantTodayPrioritiesTitle">Priorities</h2>
        <ul id="personalAssistantTodayPriorities"></ul>
      </section>
      <section aria-labelledby="personalAssistantTodayFollowUpsTitle">
        <h2 id="personalAssistantTodayFollowUpsTitle">Follow-ups</h2>
        <ul id="personalAssistantTodayFollowUps"></ul>
      </section>
      <section aria-labelledby="personalAssistantTodayResultsTitle">
        <h2 id="personalAssistantTodayResultsTitle">Results to review</h2>
        <ul id="personalAssistantTodayResults"></ul>
      </section>
    </div>
  </section>

  <!--
    Home's command strip used to sit here: a second composer, labelled
    Workspace Manager, beside the global Ask Ori launcher. Issue #350 retired
    it — its composer, suggested prompts, and activity rail are all in the one
    universal Ask Ori panel now, which is mounted on every page rather than
    just this one (FR6/FR68). The layout space it reserved is reclaimed with it.
  -->
  <!-- The Map-first workspace cockpit: one primary workspace area (Map or Tree
       as mutually exclusive peer views). Issue #366 moved selected context to
       the on-demand modal after this grid, so the theatre always owns the full
       cockpit width. The Ask Ori command bridge stays visible in both views. -->
  <div class="home-cockpit" id="homeCockpit" data-view="map" data-state="loading">
    <section class="cockpit-workspace-area" id="cockpitWorkspaceArea" aria-labelledby="cockpitWorkspaceAreaTitle">
      <!--
        Wraps the header AND the two flyouts below so they share one
        positioning context (Issue #334). The wrapper — not the header alone
        — is what occupies the grid's header row; position: relative lives
        here rather than on the <header>, because the flyouts are the
        header's DOM SIBLINGS, not its descendants, and an absolutely
        positioned element's containing block must be an ancestor.
      -->
      <div class="cockpit-area-header-zone">
      <header class="cockpit-area-header">
        <div class="cockpit-area-heading">
          <span class="cockpit-area-eyebrow">Workspaces</span>
          <h2 id="cockpitWorkspaceAreaTitle" class="cockpit-area-title" data-cockpit-area-title>Workspace Map</h2>
        </div>
        <div class="cockpit-area-controls">
          <!--
            Ori in the cockpit (PRD FR-21). A second entry point to the *same*
            guide: it drives the one controller and the one panel, so the two
            can never disagree about open state. It is never used to represent
            a running workspace agent (FR-78).

            It sits in the header rather than floating over the map on purpose —
            an absolutely-positioned character there covers the map's own empty
            and error controls and silently eats their clicks.
          -->
          <button
            type="button"
            class="cockpit-map-ori"
            id="oriGuideMapTrigger"
            aria-label="Ask Ori — app guide">
            <img src="/characters/ori-guide/sprite.svg" alt="" width="26" height="26" decoding="async">
            <span class="cockpit-map-ori__label">Ask Ori</span>
            <!-- Home hides the floating launcher, which was the only place that
                 spelled out Ori's role. The boundary between the guide and
                 Workspace Manager has to be readable BEFORE anything is asked
                 (FR-22/FR-27), so the role moves onto the surviving entry
                 point rather than disappearing with the duplicate. -->
            <span class="cockpit-map-ori__role">App Guide</span>
          </button>
          <!--
            Updates: a manual, non-modal flyout for the day's non-Progression
            content — attention, scheduled work, Daily Brief, Calendar,
            Activity, and Personal HQ mounts (Issue #334). The id is kept from
            the retired "Today" rail toggle for compatibility, but its target
            and semantics now describe the Updates flyout, never the context
            rail. The badge carries the same aggregate attention count as
            before and is empty at zero — but it is informational only now: a
            positive count never opens this on its own.
          -->
          <button
            type="button"
            class="cockpit-flyout-toggle"
            id="cockpitRailToggle"
            aria-expanded="false"
            aria-controls="cockpitUpdatesFlyout"
            aria-label="Show Updates">
            <span class="cockpit-flyout-toggle__label">Updates</span>
            <span class="cockpit-flyout-toggle__count" data-cockpit-rail-toggle-count hidden></span>
          </button>
          <!--
            Quests: Progression's always-available compact entry point,
            immediately beside Updates (Issue #334). Starts hidden — there is
            nothing truthful to summarize before the first successful
            GET /api/progression — and progression-widget.js reveals it once
            valid tier/all-complete data loads. Progress, not attention: its
            summary is inline text in the signal color family, never the red
            count pill Updates uses (FR28), so the two are never confused.
          -->
          <button
            type="button"
            class="cockpit-flyout-toggle cockpit-flyout-toggle--quests"
            id="cockpitQuestsToggle"
            aria-expanded="false"
            aria-controls="cockpitQuestsFlyout"
            aria-label="Show Quests"
            hidden>
            <span class="cockpit-flyout-toggle__label">Quests</span>
            <span class="cockpit-flyout-toggle__summary" data-role="quests-summary"></span>
          </button>
          <!-- Mutually exclusive Map/Tree toggle. aria-pressed carries the
               active view; the visible labels carry it without color (FR24). -->
          <div class="cockpit-view-toggle" role="group" aria-label="Workspace view">
            <button type="button" id="cockpitViewMap" class="cockpit-view-btn is-active" data-cockpit-view="map" aria-pressed="true">Map</button>
            <button type="button" id="cockpitViewTree" class="cockpit-view-btn" data-cockpit-view="tree" aria-pressed="false">Tree</button>
          </div>
          <!-- Add to backlog and Summary stay in the stable header so they are
               reachable whether context is bare, selected, or dismissed. -->
          <button type="button" id="cockpitCaptureBtn" class="modern-btn modern-btn-secondary modern-btn-sm"
                  aria-expanded="false" aria-controls="cockpitCapturePanel">Add to backlog</button>
          <button type="button" id="cockpitSummaryBtn" class="modern-btn modern-btn-secondary modern-btn-sm"
                  aria-pressed="false" aria-expanded="false" aria-controls="cockpitContextModal">Summary</button>
          <button id="cockpitCreateWorkspaceBtn" class="modern-btn modern-btn-primary modern-btn-sm" type="button"
                  data-bs-toggle="modal" data-bs-target="#addFolderModal"
                  data-workspace-import-mode="false" data-workspace-entry-point="home_cockpit_create">
            New Workspace
          </button>
        </div>
      </header>

      <!--
        Updates: a bounded, non-modal overlay anchored to its header trigger
        (Issue #334). It is never a layout column — position lives entirely in
        CSS against the header above it, so opening or closing this never
        changes the measured width of the Map/Tree workspace area below.

        Its sections are independently mounted and independently degradable —
        one failing source never blocks the others or the workspace area.
      -->
      <div id="cockpitUpdatesFlyout" class="cockpit-flyout" data-cockpit-flyout="updates"
           role="region" aria-labelledby="cockpitUpdatesFlyoutTitle" hidden>
        <header class="cockpit-flyout-head">
          <h2 id="cockpitUpdatesFlyoutTitle" class="cockpit-flyout-title">Updates</h2>
          <button type="button" class="cockpit-flyout-close" data-cockpit-flyout-close
                  aria-label="Close Updates">
            <span aria-hidden="true">&times;</span>
          </button>
        </header>
        <div id="cockpitUpdatesFlyoutBody" class="cockpit-flyout-body">
          <!-- Immediate work first: what needs attention and what is scheduled
               today outrank recent activity (FR87). Rendered by
               home-workspace-cockpit.js from the SAME shared state Map, Tree,
               and Summary read — no extra fetch (FR111). -->
          <section id="cockpitTodayAttention" class="cockpit-today-section" aria-label="Needs attention"></section>
          <section id="cockpitTodayScheduled" class="cockpit-today-section" aria-label="Scheduled today"></section>

          <!-- Daily Brief: the primary Home orientation region once a valid
               Personal HQ is designated. Hidden entirely with no HQ — no
               hidden brief store is created and no workspace is silently
               selected. Populated/wired by home-daily-brief.js. -->
          <section id="homeDailyBrief" class="home-daily-brief" data-state="loading" aria-labelledby="homeDailyBriefTitle" hidden>
            <header class="home-daily-brief-header">
              <div class="home-daily-brief-heading">
                <span class="home-daily-brief-eyebrow">Daily Brief</span>
                <h2 id="homeDailyBriefTitle" class="home-daily-brief-title">Today</h2>
                <p id="homeDailyBriefMeta" class="home-daily-brief-meta"></p>
              </div>
              <!-- Refresh is the only action that earns permanent space in a
                   ~320px flyout; Open My HQ and Brief settings live one
                   disclosure away. A native <details> rather than a JS menu,
                   so it costs no script and stays keyboard- and
                   screen-reader-operable for free. -->
              <div class="home-daily-brief-actions">
                <button type="button" id="homeDailyBriefRefreshBtn" class="modern-btn modern-btn-primary modern-btn-sm">Refresh</button>
                <details class="home-daily-brief-menu" id="homeDailyBriefMenu">
                  <summary class="home-daily-brief-menu-toggle" aria-label="More Daily Brief actions" title="More actions">
                    <span aria-hidden="true">&#8943;</span>
                  </summary>
                  <div class="home-daily-brief-menu-panel">
                    <a id="homeDailyBriefOpenHQ" href="/" class="home-daily-brief-menu-item">Open My HQ</a>
                    <button type="button" id="homeDailyBriefSettingsBtn" class="home-daily-brief-menu-item">Brief settings</button>
                  </div>
                </details>
              </div>
            </header>
            <div id="homeDailyBriefBanner" class="home-daily-brief-banner" role="status" aria-live="polite" hidden></div>
            <div id="homeDailyBriefBody" class="home-daily-brief-body" aria-live="polite">
              <div class="home-daily-brief-placeholder">Loading your Daily Brief…</div>
            </div>
          </section>

          <!-- Calendar Ops portal: a second, independent Home orientation
               region — a bounded read of today's calendar, separate from
               Daily Brief in both data source and lifecycle. Populated/wired
               by home-calendar-ops-portal.js; a fetch failure hides the whole
               section rather than surfacing a broken widget. -->
          <section id="homeCalendarOpsPortal" class="home-daily-brief home-calendar-ops-portal" data-state="loading" aria-labelledby="homeCalendarOpsPortalTitle" hidden>
            <header class="home-daily-brief-header">
              <div class="home-daily-brief-heading">
                <span class="home-daily-brief-eyebrow">Calendar</span>
                <h2 id="homeCalendarOpsPortalTitle" class="home-daily-brief-title">Today</h2>
              </div>
              <div class="home-daily-brief-actions">
                <a id="homeCalendarOpsPortalOpen" href="/" class="modern-btn modern-btn-primary modern-btn-sm" hidden>Open Calendar Ops</a>
              </div>
            </header>
            <div id="homeCalendarOpsPortalBody" class="home-daily-brief-body" aria-live="polite">
              <div class="home-daily-brief-placeholder">Loading your calendar…</div>
            </div>
          </section>

          <!-- Recent activity keeps its existing endpoint and lifecycle. -->
          <section id="homeRecentActivity" class="home-section home-section-activity" aria-labelledby="homeRecentActivityTitle">
            <header class="home-section-header">
              <h2 id="homeRecentActivityTitle" class="home-section-title">Activity</h2>
            </header>
            <div class="home-section-body" data-role="content" aria-live="polite">
              <div class="home-section-placeholder" data-role="placeholder">Loading activity…</div>
            </div>
          </section>

          <!-- Optional Personal HQ mounts. Each is a separate mount so a
               failure in one is isolated from the others, from Map/Tree, and
               from creation. -->
          <div class="home-hq-mounts">
            <!-- Shown by personal-hq-onboarding.js only when a valid designated
                 HQ is behind the current provisioning version. -->
            <div id="hqUpgradeMount" class="hq-upgrade-mount" hidden></div>
            <!-- Email connect/grant/repair card for a valid designated HQ. -->
            <div id="hqEmailMount" class="hq-email-mount" hidden></div>
            <!-- Confirm-gated reply review: drafts the Inbox agent prepared. -->
            <div id="hqMailReviewMount" class="hq-reply-mount" hidden></div>
            <!-- Bounded due/stale follow-ups with quick actions. -->
            <div id="hqFollowUpMount" class="hq-followup-mount" hidden></div>
            <!-- End-of-day journal launcher + editor. -->
            <div id="hqJournalMount" class="hq-journal-mount" hidden></div>
          </div>
        </div>
      </div>

      <!--
        Quests: Progression's own flyout, anchored to #cockpitQuestsToggle
        above (Issue #334). Never placed inside #cockpitMap, whose
        workspace-map.js mount replaces its inner HTML on refresh.
      -->
      <div id="cockpitQuestsFlyout" class="cockpit-flyout cockpit-flyout--quests"
           data-cockpit-flyout="quests" role="region" aria-labelledby="cockpitQuestsFlyoutTitle" hidden>
        <header class="cockpit-flyout-head">
          <h2 id="cockpitQuestsFlyoutTitle" class="cockpit-flyout-title">Quests</h2>
          <button type="button" class="cockpit-flyout-close" data-cockpit-flyout-close
                  aria-label="Close Quests">
            <span aria-hidden="true">&times;</span>
          </button>
        </header>
        <div class="cockpit-flyout-body">
          <!-- Populated by progression-widget.js from GET /api/progression. -->
          <!-- Not aria-live: render() rewrites tier-name/progress-count/quest
               rows on every 20s poll even when nothing changed, and a live
               region announces a textContent rewrite regardless of whether
               the string actually differs — which would reannounce this
               whole panel every poll while it is open (FR54). Real
               completions still announce, through the existing toast. -->
          <div id="questLog" class="quest-log" hidden>
            <div class="quest-log-inner">
              <header class="quest-log-header">
                <span class="quest-log-insignia" data-role="tier-insignia" aria-hidden="true">01</span>
                <div class="quest-log-heading">
                  <span class="quest-log-eyebrow">Progression</span>
                  <h2 class="quest-log-tier" data-role="tier-name">Quest log</h2>
                </div>
                <div class="quest-log-progress">
                  <span class="quest-log-progress-label" data-role="progress-label"></span>
                  <span class="quest-log-progress-count" data-role="progress-count"></span>
                  <button type="button" class="quest-log-dismiss" data-role="dismiss" aria-label="Collapse quest log" title="Collapse quest log">Collapse</button>
                </div>
              </header>
              <div class="quest-log-meter" role="progressbar" aria-label="Current tier progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
                <span class="quest-log-meter-fill" data-role="progress-bar"></span>
              </div>
              <section class="quest-log-first-mission" data-role="first-mission" aria-labelledby="questFirstMissionTitle" hidden>
                <div class="quest-log-first-mission-meta">
                  <span class="quest-log-first-mission-kicker"><span class="quest-log-first-mission-signal" aria-hidden="true"></span>Mission 01</span>
                  <span class="quest-log-first-mission-status" data-role="first-mission-status">Ready</span>
                </div>
                <div class="quest-log-first-mission-body">
                  <div class="quest-log-first-mission-copy">
                    <h3 id="questFirstMissionTitle" class="quest-log-first-mission-title" data-role="first-mission-title">Build My HQ</h3>
                    <p class="quest-log-first-mission-why" data-role="first-mission-why"></p>
                  </div>
                  <a class="quest-log-first-mission-action" data-role="first-mission-action" href="/?focus=personal-hq">
                    <span data-role="first-mission-action-label">Build My HQ</span>
                    <span aria-hidden="true">&#8594;</span>
                  </a>
                </div>
              </section>
              <ul class="quest-log-list" data-role="quests"></ul>
              <p class="quest-log-why" data-role="why"></p>
            </div>
          </div>
          <div id="questLogRestore" class="quest-log-restore" hidden>
            <button type="button" class="quest-log-restore-btn" data-role="restore" aria-label="Expand quest log">
              <span class="quest-log-restore-insignia" data-role="restore-insignia" aria-hidden="true">01</span>
              <span class="quest-log-restore-copy"><span data-role="restore-tier">Tier 1</span><span data-role="restore-progress">0/0</span></span>
              <span class="quest-log-restore-meter" aria-hidden="true"><span data-role="restore-meter"></span></span>
            </button>
          </div>
        </div>
      </div>
      </div>

      <!-- Quick Capture. Writes to the designated Personal HQ's backlog through
           the existing backlog contract — never a second inbox (FR102). It is
           a header disclosure, separate from the blocking context modal. -->
      <div id="cockpitCapturePanel" class="cockpit-capture" hidden>
        <form id="cockpitCaptureForm" class="cockpit-capture-form">
          <label class="cockpit-capture-label" for="cockpitCaptureTitle">Capture to your HQ backlog</label>
          <input type="text" id="cockpitCaptureTitle" class="modern-input" maxlength="300" required
                 autocomplete="off" placeholder="What's on your mind?">
          <label class="visually-hidden" for="cockpitCaptureDetails">Optional details</label>
          <textarea id="cockpitCaptureDetails" class="modern-input cockpit-capture-details" rows="2"
                    maxlength="2000" placeholder="Optional details"></textarea>
          <div class="cockpit-capture-actions">
            <button type="submit" id="cockpitCaptureSave" class="modern-btn modern-btn-primary modern-btn-sm">Save</button>
            <button type="button" id="cockpitCaptureCancel" class="modern-btn modern-btn-secondary modern-btn-sm">Cancel</button>
          </div>
          <p id="cockpitCaptureStatus" class="cockpit-capture-status" role="status" aria-live="polite"></p>
        </form>
      </div>
      <!-- Map-only signal filters. Single-select and keyboard-operable; counts
           come from the same authoritative state Map and Summary read, and an
           unavailable count renders as an em dash rather than a fake 0
           (FR31-FR34). Populated by home-workspace-cockpit.js. -->
      <div id="cockpitSignalFilters" class="cockpit-signal-filters" role="group" aria-label="Filter workspaces by signal" hidden></div>

      <div class="cockpit-area-body">
        <!-- Map and Tree occupy the SAME layout slot; activating one hides the
             other, never a drawer or overlay (FR18). -->
        <div id="cockpitMap" class="ws-map cockpit-map" role="region" aria-label="Workspace map" tabindex="-1" hidden></div>
        <div id="cockpitTree" class="cockpit-tree" role="region" aria-label="Workspace tree" tabindex="-1" hidden></div>
        <div id="cockpitWorkspaceStatus" class="cockpit-area-status" role="status" aria-live="polite"></div>
      </div>
    </section>

  </div>
</div>

<!-- Workspace context modal (Issue #366). It is outside #homeCockpit and
       #cockpitMap so Map remounts and modal visibility never alter the theatre
       grid or destroy this stable host. Bootstrap owns focus containment,
       Escape, backdrop, and body-scroll cleanup. -->
  <div id="cockpitRailLive" class="visually-hidden" role="status" aria-live="polite" aria-atomic="true"></div>
  <div class="modal fade cockpit-context-modal" id="cockpitContextModal" tabindex="-1"
       aria-labelledby="cockpitContextModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
      <div class="modal-content cockpit-context-modal__content">
        <div class="modal-header cockpit-context-modal__header">
          <div class="cockpit-context-modal__heading">
            <span class="cockpit-area-eyebrow">Workspace context</span>
            <h2 class="modal-title cockpit-context-modal__title" id="cockpitContextModalLabel">Context</h2>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close context"></button>
        </div>
        <div id="cockpitRailContext" class="modal-body cockpit-rail-body" data-context-state="bare"></div>
      </div>
    </div>
  </div>

  <!-- Brief settings dialog: HQ-owned config + recent history, opened from
       Home's "Brief settings" action but scoped to the designated HQ
       workspace's own data (PRD FR99/task 7.7). Kept outside the scrolling
       rail so the dialog is never clipped by it. -->
  <div class="modal fade" id="homeDailyBriefSettingsModal" tabindex="-1" aria-labelledby="homeDailyBriefSettingsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 id="homeDailyBriefSettingsModalLabel" class="modal-title">Daily Brief settings</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form id="homeDailyBriefSettingsForm" class="home-daily-brief-settings-form">
            <div class="mb-3">
              <label class="form-label" for="homeDailyBriefTimezone">Timezone</label>
              <input type="text" class="modern-input" id="homeDailyBriefTimezone" name="timezone" autocomplete="off" placeholder="UTC">
            </div>
            <div class="mb-3">
              <label class="form-label" for="homeDailyBriefTime">Scheduled time</label>
              <input type="text" class="modern-input" id="homeDailyBriefTime" name="schedule_time" autocomplete="off" placeholder="08:00">
            </div>
            <fieldset class="mb-3">
              <legend class="form-label">Days</legend>
              <div class="home-daily-brief-days" role="group" aria-label="Scheduled days">
                <label><input type="checkbox" value="mon"> Mon</label>
                <label><input type="checkbox" value="tue"> Tue</label>
                <label><input type="checkbox" value="wed"> Wed</label>
                <label><input type="checkbox" value="thu"> Thu</label>
                <label><input type="checkbox" value="fri"> Fri</label>
                <label><input type="checkbox" value="sat"> Sat</label>
                <label><input type="checkbox" value="sun"> Sun</label>
              </div>
            </fieldset>
            <div class="mb-3 form-check">
              <input type="checkbox" class="form-check-input" id="homeDailyBriefScheduleEnabled" name="schedule_enabled">
              <label class="form-check-label" for="homeDailyBriefScheduleEnabled">Generate automatically on schedule</label>
            </div>
            <div class="mb-3 form-check">
              <input type="checkbox" class="form-check-input" id="homeDailyBriefNotify" name="notify_on_ready">
              <label class="form-check-label" for="homeDailyBriefNotify">Notify in Action Center when a scheduled brief is ready</label>
            </div>
            <button type="submit" class="modern-btn modern-btn-primary">Save settings</button>
          </form>
          <hr>
          <h6>Recent history</h6>
          <ul id="homeDailyBriefHistoryList" class="home-daily-brief-history-list"></ul>
        </div>
      </div>
    </div>
  </div>

