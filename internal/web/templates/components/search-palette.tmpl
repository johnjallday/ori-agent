<!-- Global search palette — opened via ⌘K / Ctrl+K. Mounted once in base.tmpl
     so it's available on every page. Logic lives in /js/modules/search-palette.js. -->
<div id="searchPalette" class="search-palette" hidden role="dialog" aria-modal="true" aria-label="Search notes">
  <div class="search-palette-overlay" data-role="overlay"></div>
  <div class="search-palette-dialog" role="document">
    <div class="search-palette-input-wrap">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"/>
      </svg>
      <input type="text" id="searchPaletteInput" class="search-palette-input"
             placeholder="Search notes and headings…"
             autocomplete="off" spellcheck="false"
             aria-label="Search query" />
      <kbd class="search-palette-kbd">Esc</kbd>
    </div>
    <div class="search-palette-status" data-role="status" hidden></div>
    <div class="search-palette-results" id="searchPaletteResults" data-role="results" role="listbox"></div>
  </div>
</div>
