  <div class="session-context-divider"></div>
  <button class="session-context-item session-context-danger" data-action="delete">
    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
      <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
    </svg>
    Delete Note
  </button>
</div>

<!-- Move to Workspace Modal -->
<div class="modal fade" id="moveToFolderModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
        <h6 class="modal-title" style="color: var(--text-primary);">Move to Workspace</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="moveToFolderList" class="move-folder-list">
          <!-- Folders will be populated dynamically -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Edit Tags Modal -->
<div class="modal fade" id="editTagsModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
        <h6 class="modal-title" style="color: var(--text-primary);">Edit Tags</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <input type="text" id="tagInput" class="modern-input w-100 mb-2" placeholder="Add tags (comma separated)">
        <div id="currentTags" class="session-tags-edit">
          <!-- Current tags will be shown here -->
        </div>
        <div id="suggestedTags" class="session-tags-suggested mt-2">
          <!-- Suggested tags will be shown here -->
        </div>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
        <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="saveTagsBtn" class="modern-btn modern-btn-primary">Save</button>
      </div>
    </div>
  </div>
</div>

{{template "components/workspaces/create-workspace-modal.tmpl" .}}

<!-- Session Info Modal -->
<div class="modal fade" id="sessionInfoModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
        <h6 class="modal-title" style="color: var(--text-primary);">Session Info</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div id="sessionInfoBody" class="session-info-list">
          <!-- Session info will be populated dynamically -->
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Note Editor Modal -->
<div class="modal fade" id="noteEditorModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-xl">
    <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
        <div class="d-flex flex-column gap-1 flex-grow-1">
          <div class="d-flex align-items-center gap-2">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
              <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,9V3.5L18.5,9H13M12,12H7V10H12V12M17,16H7V14H17V16M17,20H7V18H17V20Z"/>
            </svg>
            <input type="text" id="noteNameInput" class="note-title-input" placeholder="Note title">
          </div>
          <div style="display: flex; flex-wrap: wrap; gap: 6px; align-items: center;">
            <div id="noteWorkspaceBadge" style="display: none; font-size: 0.75rem; color: var(--text-secondary);">
              <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; background: var(--bg-tertiary); border-radius: 4px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
                </svg>
                <span id="noteWorkspaceName"></span>
                <button type="button" id="noteWorkspaceChange" style="background: none; border: none; padding: 0 4px; cursor: pointer; color: var(--text-secondary); font-size: 0.7rem;" title="Change workspace">
                  <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
                  </svg>
                </button>
              </span>
            </div>
            <div id="noteVaultReferenceBadge" style="display: none; font-size: 0.75rem;">
              <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; background: rgba(15, 118, 110, 0.12); border: 1px solid rgba(15, 118, 110, 0.28); color: #0f766e; border-radius: 4px;">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12,2L20,6V12C20,16.42 17.21,20.44 13.11,21.93L12,22.33L10.89,21.93C6.79,20.44 4,16.42 4,12V6L12,2M12,4.18L6,7V12C6,15.53 8.13,18.76 11.24,20.07L12,20.38L12.76,20.07C15.87,18.76 18,15.53 18,12V7L12,4.18Z"/>
                </svg>
                <span id="noteVaultReferenceName"></span>
              </span>
            </div>
          </div>
          <div id="noteWorkspaceSelector" style="display: none; font-size: 0.8rem;">
            <select id="noteWorkspaceSelect" class="modern-input w-100" style="padding: 4px 8px; font-size: 0.75rem; cursor: pointer;">
              <option value="">-- Select a workspace --</option>
            </select>
          </div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0">
        <div class="note-editor-toolbar">
          <button type="button" id="noteGenerateAIToggle" class="note-toolbar-btn" title="Generate with AI">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12,2L15.09,8.26L22,9.27L17,14.14L18.18,21.02L12,17.77L5.82,21.02L7,14.14L2,9.27L8.91,8.26L12,2Z"/>
            </svg>
            Generate with AI
          </button>
          <div class="note-toolbar-spacer"></div>
          <button type="button" id="noteTocToggle" class="note-toolbar-btn" title="Toggle outline" aria-pressed="false" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M3,9H17V7H3V9M3,13H17V11H3V13M3,17H17V15H3V17M19,17H21V15H19V17M19,7V9H21V7H19M19,13H21V11H19V13Z"/>
            </svg>
            Outline
          </button>
          <button type="button" id="noteAssistToggle" class="note-toolbar-btn" title="Toggle AI assist" aria-pressed="false" hidden>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12,3A9,9 0 0,0 3,12H0L4,16L8,12H5A7,7 0 0,1 12,5A7,7 0 0,1 19,12A7,7 0 0,1 12,19C10.5,19 9.09,18.5 7.94,17.7L6.5,19.14C8.04,20.3 9.94,21 12,21A9,9 0 0,0 21,12A9,9 0 0,0 12,3M11,7V13L15.25,15.5L16,14.25L12.5,12.25V7H11Z"/>
            </svg>
            Assist
          </button>
        </div>
        <div class="note-editor-grid" id="noteEditorGrid">
          <aside class="note-toc-rail" id="noteTocRail" hidden aria-label="Note outline">
            <div class="note-rail-empty" data-role="empty">Add a heading to build an outline</div>
            <div class="note-rail-content" data-role="content"></div>
          </aside>
          <div class="note-editor-center">
            <div class="note-editor-container">
              <textarea id="noteContentInput" class="note-content-input" placeholder="Write your note in markdown..."></textarea>
              <div id="notePreviewContent" class="note-preview-content note-live-editor" style="display: none;" role="textbox" aria-label="Markdown live preview editor" tabindex="0"></div>
            </div>
          </div>
          <aside class="note-assist-rail" id="noteAssistRail" hidden aria-label="AI assist">
            <div class="note-rail-empty" data-role="empty">Highlight text and choose an AI action to start.</div>
            <div class="note-rail-content" data-role="content"></div>
            <!-- Backlinks: notes that reference this one via [[wikilinks]]. The
                 section stays hidden until note-backlinks.js finds any. -->
            <section id="noteBacklinksSection" class="note-backlinks-section" hidden aria-label="Backlinks">
              <div class="note-backlinks-header">
                <span class="note-backlinks-title">Backlinks</span>
                <span id="noteBacklinksCount" class="note-backlinks-count"></span>
              </div>
              <div id="noteBacklinksList" class="note-backlinks-list"></div>
            </section>
            <!-- Whole-note Generate-with-AI form. Hidden by default; the toolbar
                 button toggles it. Lives inside the rail so AI controls are
                 unified in one column. -->
            <div id="noteAIGeneratePanel" class="note-ai-panel" style="display: none;">
              <div class="note-ai-panel-header">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-primary">
                  <path d="M12,2L15.09,8.26L22,9.27L17,14.14L18.18,21.02L12,17.77L5.82,21.02L7,14.14L2,9.27L8.91,8.26L12,2Z"/>
                </svg>
                <span>Generate with AI</span>
              </div>
              <div class="note-ai-panel-body">
                <div class="mb-2">
                  <label for="noteAIAgentSelect" class="form-label" style="font-size: 11px; color: var(--text-secondary);">Agent</label>
                  <select id="noteAIAgentSelect" class="modern-input w-100">
                    <option value="">Select an agent...</option>
                  </select>
                </div>
                <div class="mb-2">
                  <label for="noteAIPromptInput" class="form-label" style="font-size: 11px; color: var(--text-secondary);">Prompt</label>
                  <textarea id="noteAIPromptInput" class="modern-input w-100" rows="4" placeholder="Describe what you want the note to contain..."></textarea>
                </div>
                <div id="noteAIError" class="alert alert-danger mb-2" style="display: none; font-size: 11px; padding: 6px 8px;"></div>
                <div id="noteAIGenerating" class="text-center py-2" style="display: none;">
                  <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                  <span style="font-size: 11px; color: var(--text-secondary);">Generating…</span>
                </div>
              </div>
              <div class="note-ai-panel-footer">
                <button type="button" id="noteAICancelBtn" class="modern-btn modern-btn-secondary btn-sm">Cancel</button>
                <button type="button" id="noteAIGenerateBtn" class="modern-btn modern-btn-primary btn-sm">Generate</button>
              </div>
            </div>
          </aside>
        </div>
        <!-- Floating selection action bar — positioned via JS, fixed to viewport. -->
        <div id="noteAIActionBar" class="note-ai-action-bar" role="toolbar" aria-label="AI selection actions"></div>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
        <span class="me-auto d-flex align-items-center gap-2" style="font-size: 12px;">
          <span id="noteLastSaved" class="text-muted"></span>
          <span id="noteSaveStatus">
            <span class="note-status-saved text-success" style="display: none;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z"/>
              </svg>Saved
            </span>
            <span class="note-status-saving text-muted" style="display: none;">
              <span class="spinner-border spinner-border-sm me-1" style="width: 12px; height: 12px;"></span>Saving...
            </span>
            <span class="note-status-unsaved text-warning" style="display: none;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,17A1.5,1.5 0 0,1 10.5,15.5A1.5,1.5 0 0,1 12,14A1.5,1.5 0 0,1 13.5,15.5A1.5,1.5 0 0,1 12,17M12,12A1.5,1.5 0 0,1 10.5,10.5V7A1.5,1.5 0 0,1 12,5.5A1.5,1.5 0 0,1 13.5,7V10.5A1.5,1.5 0 0,1 12,12Z"/>
              </svg>Unsaved
            </span>
            <span class="note-status-error text-danger" style="display: none;">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                <path d="M13,13H11V7H13M13,17H11V15H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
              </svg>Error
            </span>
          </span>
        </span>
        <button type="button" id="noteOpenInPageBtn" class="modern-btn modern-btn-secondary" title="Open this note as a full page (bookmarkable URL)">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" aria-hidden="true">
            <path d="M14,3V5H17.59L7.76,14.83L9.17,16.24L19,6.41V10H21V3M19,19H5V5H12V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V12H19V19Z"/>
          </svg>
          Open in page
        </button>
        <button type="button" id="noteCopyBtn" class="modern-btn modern-btn-secondary">Copy</button>
        <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="saveNoteBtn" class="modern-btn modern-btn-primary">Save</button>
      </div>
    </div>
  </div>
</div>

<!-- Create Chat Modal -->
<div class="modal fade" id="createChatModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
        <h6 class="modal-title" style="color: var(--text-primary);">Start Conversation</h6>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <!-- Config Mode Toggle -->
        <div class="mb-3">
          <div class="d-flex align-items-center gap-3">
            <label class="form-label mb-0" style="font-size: 12px; color: var(--text-secondary);">Mode</label>
            <div class="btn-group" role="group" aria-label="Chat mode toggle">
              <input type="radio" class="btn-check" name="chatConfigMode" id="chatConfigModeManual" value="manual" checked>
              <label class="btn btn-outline-secondary btn-sm" for="chatConfigModeManual">Direct agent chat</label>
              <input type="radio" class="btn-check" name="chatConfigMode" id="chatConfigModeAuto" value="auto">
              <label class="btn btn-outline-secondary btn-sm" for="chatConfigModeAuto">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="me-1">
                  <path d="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"/>
                </svg>
                Assistant
              </label>
            </div>
          </div>
        </div>

        <!-- LLM Not Available Warning (for Assistant mode) -->
        <div id="chatLlmNotAvailableWarning" class="alert alert-warning d-none mb-3" style="font-size: 0.8rem; padding: 0.5rem 0.75rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
            <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
          </svg>
          <span id="chatLlmWarningMessage">Assistant mode requires a System Model to be configured.</span>
          <a href="/settings" class="alert-link ms-1">Go to Settings</a>
        </div>

        <!-- Direct Agent Chat Section -->
        <div id="chatManualSection">
          <div class="mb-3">
            <label class="form-label" style="font-size: 12px; color: var(--text-secondary);">Workspace</label>
            <select id="chatWorkspaceSelect" class="modern-input w-100">
              <option value="">No workspace (root)</option>
              <!-- Workspaces will be populated dynamically -->
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label" style="font-size: 12px; color: var(--text-secondary);">Agent profile</label>
            <select id="chatAgentSelect" class="modern-input w-100">
              <!-- Agents will be populated dynamically -->
            </select>
          </div>
          <div>
            <label class="form-label" style="font-size: 12px; color: var(--text-secondary);">Initial message (optional)</label>
            <textarea id="chatManualMessage" class="modern-input w-100" rows="3"
                      style="resize: vertical; min-height: 80px;"
                      placeholder="Start a direct conversation with the selected agent..."></textarea>
          </div>
        </div>

        <!-- Assistant Mode Section -->
        <div id="chatAutoSection" class="d-none">
          <div id="chatAutoModeInfo" class="alert alert-info mb-3" style="font-size: 0.8rem; padding: 0.5rem 0.75rem;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="me-1" style="vertical-align: text-bottom;">
              <path d="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
            </svg>
            <span id="chatAutoModeText">Assistant uses the system assistant with workspace context when a workspace is selected.</span>
          </div>
          <div>
            <label class="form-label" style="font-size: 12px; color: var(--text-secondary);">What do you want Assistant to help with?</label>
            <textarea id="chatAutoMessage" class="modern-input w-100" rows="3"
                      style="resize: vertical; min-height: 80px;"
                      placeholder="Describe the work, question, or outcome you want..."></textarea>
          </div>
        </div>

        <!-- File Attachment Section -->
        <div class="mt-3" id="chatFileAttachSection">
          <label class="form-label" style="font-size: 12px; color: var(--text-secondary);">Attachments (optional)</label>
          <div id="chatFileDropZone" class="chat-file-drop-zone">
            <div class="chat-file-drop-content">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary); opacity: 0.6;">
                <path d="M16.5,6.5V17.5A4.5,4.5 0 0,1 12,22A4.5,4.5 0 0,1 7.5,17.5V8A3.5,3.5 0 0,1 11,4.5A3.5,3.5 0 0,1 14.5,8V16.5A2.5,2.5 0 0,1 12,19A2.5,2.5 0 0,1 9.5,16.5V7.5H11V16.5A1,1 0 0,0 12,17.5A1,1 0 0,0 13,16.5V8A2,2 0 0,0 11,6A2,2 0 0,0 9,8V17.5A3.5,3.5 0 0,0 12.5,21A3.5,3.5 0 0,0 16,17.5V6.5H16.5Z"/>
              </svg>
              <span style="color: var(--text-secondary); font-size: 0.8rem;">Drop files or click to attach</span>
            </div>
            <input type="file" id="chatFileInput" multiple style="display: none;">
          </div>
          <div id="chatSelectedFiles" class="chat-selected-files" style="display: none;"></div>
        </div>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
        <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="createChatBtn" class="modern-btn modern-btn-primary">
          <span id="createChatBtnText">Start Assistant</span>
        </button>
      </div>
    </div>
  </div>
</div>
