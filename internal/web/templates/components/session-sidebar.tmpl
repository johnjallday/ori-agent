<!-- Note Editor Modal -->
<div class="modal fade" id="noteEditorModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="background: var(--bg-primary); border: 1px solid var(--border-color);">
      <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
        <div class="d-flex align-items-center gap-2 flex-grow-1">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary);">
            <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13,9V3.5L18.5,9H13M12,12H7V10H12V12M17,16H7V14H17V16M17,20H7V18H17V20Z"/>
          </svg>
          <input type="text" id="noteNameInput" class="note-title-input" placeholder="Note title">
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body p-0">
        <div class="note-editor-toolbar">
          <button type="button" id="notePreviewToggle" class="note-toolbar-btn" title="Toggle Preview">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12,9A3,3 0 0,0 9,12A3,3 0 0,0 12,15A3,3 0 0,0 15,12A3,3 0 0,0 12,9M12,17A5,5 0 0,1 7,12A5,5 0 0,1 12,7A5,5 0 0,1 17,12A5,5 0 0,1 12,17M12,4.5C7,4.5 2.73,7.61 1,12C2.73,16.39 7,19.5 12,19.5C17,19.5 21.27,16.39 23,12C21.27,7.61 17,4.5 12,4.5Z"/>
            </svg>
            Preview
          </button>
        </div>
        <div class="note-editor-container">
          <textarea id="noteContentInput" class="note-content-input" placeholder="Write your note in markdown..."></textarea>
          <div id="notePreviewContent" class="note-preview-content" style="display: none;"></div>
        </div>
      </div>
      <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
        <span id="noteLastSaved" class="text-muted me-auto" style="font-size: 12px;"></span>
        <button type="button" class="modern-btn modern-btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" id="saveNoteBtn" class="modern-btn modern-btn-primary">Save</button>
      </div>
    </div>
  </div>
</div>
