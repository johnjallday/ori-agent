<!-- Command Center - Task-focused interface -->
<div class="command-center" id="commandCenter">
  <!-- Command Bar - Hero Section -->
  <div class="command-bar-section">
    <div class="command-bar" id="commandBar">
      <div class="command-bar-inner">
        <div class="command-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M15.5,14L20.5,19L19,20.5L14,15.5V14.71L13.73,14.43C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.43,13.73L14.71,14H15.5M9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14Z"/>
          </svg>
        </div>
        <label for="commandInput" class="visually-hidden">Describe a task</label>
        <input type="text"
               id="commandInput"
               class="command-input"
               placeholder="What do you want done? (Ctrl+K to focus)"
               autocomplete="off"
               spellcheck="false">
        <div class="command-agent-selector">
          <label for="commandAgentSelect" class="visually-hidden">Assign task to agent</label>
          <select id="commandAgentSelect" class="agent-select">
            <option value="">Auto-assign</option>
            <!-- Agents populated by JS -->
          </select>
        </div>
        <button type="button" id="commandDispatchBtn" class="command-dispatch-btn" title="Dispatch task (Enter)" aria-label="Dispatch task">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M2,21L23,12L2,3V10L17,12L2,14V21Z"/>
          </svg>
        </button>
      </div>
      <div class="command-hints">
        <span class="hint"><kbd>Enter</kbd> to dispatch</span>
        <span class="hint"><kbd>/schedule</kbd> for recurring</span>
        <span class="hint"><kbd>/to:agent</kbd> to assign</span>
      </div>
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="command-grid">
    <!-- Task Queue Panel -->
    <div class="task-queue-panel" id="taskQueuePanel">
      <div class="panel-header">
        <h3 class="panel-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3,5H9V11H3V5M5,7V9H7V7H5M11,7H21V9H11V7M11,15H21V17H11V15M5,20L1.5,16.5L2.91,15.09L5,17.17L9.59,12.59L11,14L5,20M3,13H9V19H3V13M5,15V17H7V15H5Z"/>
          </svg>
          Task Queue
        </h3>
        <div class="panel-actions">
          <button type="button" class="panel-action-btn" id="refreshTasksBtn" title="Refresh tasks" aria-label="Refresh tasks">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.65,6.35C16.2,4.9 14.21,4 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18A6,6 0 0,1 6,12A6,6 0 0,1 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Task Filters -->
      <div class="task-filters" id="taskFilters">
        <button type="button" class="filter-btn active" data-filter="all">All</button>
        <button type="button" class="filter-btn" data-filter="pending">
          <span class="filter-dot pending"></span>Pending
        </button>
        <button type="button" class="filter-btn" data-filter="in_progress">
          <span class="filter-dot active"></span>Active
        </button>
        <button type="button" class="filter-btn" data-filter="completed">
          <span class="filter-dot completed"></span>Done
        </button>
        <button type="button" class="filter-btn" data-filter="failed">
          <span class="filter-dot failed"></span>Failed
        </button>
      </div>

      <!-- Task List -->
      <div class="task-list" id="taskList">
        <div class="task-list-loading">
          <div class="spinner-border spinner-border-sm" role="status">
            <span class="visually-hidden">Loading...</span>
          </div>
          <span>Loading tasks...</span>
        </div>
      </div>

      <!-- Empty State -->
      <div class="task-list-empty" id="taskListEmpty" style="display: none;">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19,3H14.82C14.4,1.84 13.3,1 12,1C10.7,1 9.6,1.84 9.18,3H5A2,2 0 0,0 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5A2,2 0 0,0 19,3M12,3A1,1 0 0,1 13,4A1,1 0 0,1 12,5A1,1 0 0,1 11,4A1,1 0 0,1 12,3M7,7H17V5H19V19H5V5H7V7Z"/>
        </svg>
        <p>No tasks yet</p>
        <span>Use the command bar above to dispatch tasks to agents</span>
      </div>
    </div>

    <!-- Activity Feed Panel -->
    <div class="activity-feed-panel" id="activityFeedPanel">
      <div class="panel-header">
        <h3 class="panel-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12,8A4,4 0 0,0 8,12A4,4 0 0,0 12,16A4,4 0 0,0 16,12A4,4 0 0,0 12,8M3.05,13H1V11H3.05C3.5,6.83 6.83,3.5 11,3.05V1H13V3.05C17.17,3.5 20.5,6.83 20.95,11H23V13H20.95C20.5,17.17 17.17,20.5 13,20.95V23H11V20.95C6.83,20.5 3.5,17.17 3.05,13M12,5A7,7 0 0,0 5,12A7,7 0 0,0 12,19A7,7 0 0,0 19,12A7,7 0 0,0 12,5Z"/>
          </svg>
          Live Activity
        </h3>
        <div class="panel-actions">
          <span class="connection-status" id="sseStatus">
            <span class="status-dot"></span>
            <span class="status-text">Connecting...</span>
          </span>
          <button type="button" class="panel-action-btn" id="clearActivityBtn" title="Clear activity" aria-label="Clear activity feed">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19,4H15.5L14.5,3H9.5L8.5,4H5V6H19M6,19A2,2 0 0,0 8,21H16A2,2 0 0,0 18,19V7H6V19Z"/>
            </svg>
          </button>
        </div>
      </div>

      <!-- Activity Stream -->
      <div class="activity-stream" id="activityStream">
        <div class="activity-empty">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A6,6 0 0,0 6,12A6,6 0 0,0 12,18A6,6 0 0,0 18,12A6,6 0 0,0 12,6Z"/>
          </svg>
          <p>Waiting for agent activity...</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Collapsible Chat Panel -->
  <div class="chat-panel-collapsed" id="chatPanelCollapsed">
    <button type="button" class="chat-toggle-btn" id="chatToggleBtn" title="Open chat (Ctrl+J)" aria-label="Open chat">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M12,3C17.5,3 22,6.58 22,11C22,15.42 17.5,19 12,19C10.76,19 9.57,18.82 8.47,18.5C5.55,21 2,21 2,21C4.33,18.67 4.7,17.1 4.75,16.5C3.05,15.07 2,13.13 2,11C2,6.58 6.5,3 12,3Z"/>
      </svg>
      <span>Open Chat</span>
      <span class="chat-badge" id="chatBadge" style="display: none;">0</span>
    </button>
  </div>

  <!-- Expanded Chat Panel -->
  <div class="chat-panel-expanded" id="chatPanelExpanded" style="display: none;">
    <div class="chat-panel-header">
      <div class="chat-panel-title">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12,3C17.5,3 22,6.58 22,11C22,15.42 17.5,19 12,19C10.76,19 9.57,18.82 8.47,18.5C5.55,21 2,21 2,21C4.33,18.67 4.7,17.1 4.75,16.5C3.05,15.07 2,13.13 2,11C2,6.58 6.5,3 12,3Z"/>
        </svg>
        <span>Chat</span>
        <span class="chat-agent-name" id="chatAgentName"></span>
      </div>
      <button type="button" class="chat-minimize-btn" id="chatMinimizeBtn" title="Minimize chat (Escape)" aria-label="Minimize chat">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19.5,3.09L15,7.59V4H13V11H20V9H16.41L20.91,4.5L19.5,3.09M4,13V15H7.59L3.09,19.5L4.5,20.91L9,16.41V20H11V13H4Z"/>
        </svg>
      </button>
    </div>
    <div class="chat-panel-messages" id="chatPanelMessages">
      <!-- Chat messages rendered here -->
    </div>
    <div class="chat-panel-input">
      <label for="chatPanelInput" class="visually-hidden">Chat message</label>
      <input type="text"
             id="chatPanelInput"
             class="chat-input"
             placeholder="Type a message..."
             autocomplete="off">
      <button type="button" id="chatPanelSendBtn" class="chat-send-btn" aria-label="Send chat message">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M2,21L23,12L2,3V10L17,12L2,14V21Z"/>
        </svg>
      </button>
    </div>
  </div>
</div>
