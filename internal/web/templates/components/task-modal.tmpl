{{define "task-modal"}}
<!-- Shared Task Modal (for creating/editing tasks) -->
<div id="taskModal" class="task-modal" style="display: none;" aria-hidden="true">
  <div class="task-modal-backdrop"></div>
  <div class="task-modal-content" role="dialog" aria-modal="true" aria-labelledby="taskModalTitle" aria-describedby="taskModalDescriptionText" tabindex="-1">
    <div class="task-modal-header">
      <div style="display: flex; flex-direction: column; gap: 4px;">
        <h6 class="task-modal-title" id="taskModalTitle">Add Task</h6>
        <p id="taskModalDescriptionText" class="visually-hidden">Create or update a task, configure workflow steps, scheduling, and attachments.</p>
        <!-- Workspace badge (shown when workspace is pre-selected) -->
        <div id="taskModalWorkspaceBadge" style="display: none; font-size: 0.75rem; color: var(--text-secondary);">
          <span style="display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; background: var(--bg-tertiary); border-radius: 4px;">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor">
              <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
            </svg>
            <span id="taskModalWorkspaceName"></span>
            <button type="button" id="taskModalChangeWorkspace" style="background: none; border: none; padding: 0 4px; cursor: pointer; color: var(--text-secondary); font-size: 0.7rem;" title="Change workspace" aria-label="Change workspace">
              <svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor">
                <path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z"/>
              </svg>
            </button>
          </span>
        </div>
        <!-- Workspace dropdown (shown when no workspace is pre-selected or when changing) -->
        <div id="taskModalWorkspaceSelector" style="display: none; font-size: 0.8rem;">
          <select id="taskModalWorkspaceSelect" class="task-modal-input" style="padding: 4px 8px; font-size: 0.75rem; cursor: pointer;">
            <option value="">-- Select a workspace --</option>
          </select>
        </div>
      </div>
      <button type="button" class="task-modal-close" id="taskModalClose" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
        </svg>
      </button>
    </div>
    <div class="task-modal-body">
      <div class="voice-status voice-status--compact" data-voice-status="task" aria-live="polite"></div>
      <div id="taskModalResultSection" class="task-modal-field" style="display: none; margin-bottom: 16px;">
        <div style="border: 1px solid var(--border-color); border-radius: 12px; background: color-mix(in srgb, var(--bg-secondary) 88%, transparent); padding: 14px;">
          <div style="display: flex; flex-direction: column; gap: 4px; margin-bottom: 10px;">
            <div style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary);">Task Output</div>
            <div id="taskModalResultMeta" style="font-size: 0.78rem; color: var(--text-secondary);"></div>
          </div>
          <div id="taskModalMCPRequirement" class="task-modal-remediation" style="display: none;" role="status" aria-live="polite">
            <div class="task-modal-remediation-icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10.59,13.41C10.21,13.79 10,14.3 10,14.83C10,15.36 10.21,15.87 10.59,16.24C11.36,17.02 12.64,17.02 13.41,16.24L16.95,12.71C17.73,11.93 17.73,10.66 16.95,9.88C16.17,9.1 14.91,9.1 14.12,9.88L13.41,10.59L12,9.17L12.71,8.46C14.27,6.9 16.8,6.9 18.36,8.46C19.92,10.02 19.92,12.55 18.36,14.12L14.83,17.66C13.27,19.22 10.74,19.22 9.17,17.66C7.61,16.1 7.61,13.57 9.17,12L9.88,11.29L11.29,12.71L10.59,13.41M13.41,10.59C13.79,10.21 14,9.7 14,9.17C14,8.64 13.79,8.13 13.41,7.76C12.64,6.98 11.36,6.98 10.59,7.76L7.05,11.29C6.27,12.07 6.27,13.34 7.05,14.12C7.83,14.9 9.09,14.9 9.88,14.12L10.59,13.41L12,14.83L11.29,15.54C9.73,17.1 7.2,17.1 5.64,15.54C4.08,13.98 4.08,11.45 5.64,9.88L9.17,6.34C10.73,4.78 13.26,4.78 14.83,6.34C16.39,7.9 16.39,10.43 14.83,12L14.12,12.71L12.71,11.29L13.41,10.59Z"/>
              </svg>
            </div>
            <div class="task-modal-remediation-copy">
              <div class="task-modal-remediation-kicker">Connector Required</div>
              <div class="task-modal-remediation-title">This task requires <code id="taskModalMCPRequirementServer">fetch</code>.</div>
              <div class="task-modal-remediation-body" id="taskModalMCPRequirementBody">Add the missing MCP connector to My Servers, then retry the task.</div>
              <div class="task-modal-remediation-status" id="taskModalMCPRequirementStatus"></div>
            </div>
            <div class="task-modal-remediation-actions">
              <button type="button" class="task-modal-btn task-modal-btn-save" id="taskModalMCPRequirementAdd">
                Add Connector
              </button>
            </div>
          </div>
          <div id="taskModalToolSummary" style="display: none; margin-bottom: 12px; border: 1px solid color-mix(in srgb, var(--border-color) 80%, var(--primary-color) 20%); border-radius: 10px; background: color-mix(in srgb, var(--bg-primary) 92%, rgba(var(--primary-color-rgb, 255, 138, 86), 0.04)); padding: 10px;"></div>
          <pre id="taskModalResultBody" style="white-space: pre-wrap; word-break: break-word; background: var(--bg-primary); border: 1px solid var(--border-color); border-radius: 10px; padding: 12px; margin: 0; max-height: 260px; overflow: auto; color: var(--text-primary); font-size: 0.8rem; line-height: 1.45;"></pre>
          <div id="taskModalResultNextSteps" style="display: none; margin-top: 14px; border: 1px solid color-mix(in srgb, var(--border-color) 72%, var(--primary-color) 28%); border-radius: 12px; background: color-mix(in srgb, var(--bg-primary) 90%, rgba(var(--primary-color-rgb, 255, 138, 86), 0.06)); padding: 12px;">
            <div style="font-size: 0.72rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-secondary);">Continue This Work</div>
            <div id="taskModalResultNextStepsCopy" style="margin-top: 4px; font-size: 0.8rem; color: var(--text-primary); line-height: 1.45;"></div>
            <div id="taskModalResultNextStepsActions" style="display: grid; gap: 10px; margin-top: 12px;"></div>
          </div>
        </div>
      </div>
      <!-- Config Mode Toggle -->
      <div class="task-modal-field" style="margin-bottom: 16px;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <label class="task-modal-label" style="margin: 0; font-size: 0.75rem; color: var(--text-secondary);">Mode</label>
          <div class="btn-group" role="group" aria-label="Task mode toggle">
            <input type="radio" class="btn-check" name="taskConfigMode" id="taskConfigModeManual" value="manual" checked>
            <label class="btn btn-outline-secondary btn-sm" for="taskConfigModeManual">Manual</label>
            <input type="radio" class="btn-check" name="taskConfigMode" id="taskConfigModeAuto" value="auto">
            <label class="btn btn-outline-secondary btn-sm" for="taskConfigModeAuto">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 4px;">
                <path d="M19,2L14,6.5V17.5L19,13V2M6.5,5C4.55,5 2.45,5.4 1,6.5V21.16C1,21.41 1.25,21.66 1.5,21.66C1.6,21.66 1.65,21.59 1.75,21.59C3.1,20.94 5.05,20.5 6.5,20.5C8.45,20.5 10.55,20.9 12,22C13.35,21.15 15.8,20.5 17.5,20.5C19.15,20.5 20.85,20.81 22.25,21.56C22.35,21.61 22.4,21.59 22.5,21.59C22.75,21.59 23,21.34 23,21.09V6.5C22.4,6.05 21.75,5.75 21,5.5V19C19.9,18.65 18.7,18.5 17.5,18.5C15.8,18.5 13.35,19.15 12,20V6.5C10.55,5.4 8.45,5 6.5,5Z"/>
              </svg>
              Auto
            </label>
          </div>
        </div>
      </div>

      <!-- LLM Not Available Warning (for Auto mode) -->
      <div id="taskLlmNotAvailableWarning" class="task-modal-field" style="display: none; margin-bottom: 16px;">
        <div style="background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); border-radius: 8px; padding: 10px 12px; font-size: 0.8rem; color: #f59e0b;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: text-bottom; margin-right: 4px;">
            <path d="M13,14H11V10H13M13,18H11V16H13M1,21H23L12,2L1,21Z"/>
          </svg>
          <span id="taskLlmWarningMessage">Auto mode requires a System Model to be configured.</span>
          <a href="/settings" style="color: #f59e0b; margin-left: 4px;">Go to Settings</a>
        </div>
      </div>

      <!-- Auto Mode Section -->
      <div id="taskAutoSection" style="display: none;">
        <!-- Auto Create Mode -->
        <div id="taskAutoCreateSection">
          <div class="task-modal-field" style="margin-bottom: 12px;">
            <div style="background: rgba(59, 130, 246, 0.1); border-radius: 8px; padding: 10px 12px; font-size: 0.8rem; color: var(--text-secondary);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: text-bottom; margin-right: 4px; color: #3b82f6;">
                <path d="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
              </svg>
              Describe your task in natural language. Include timing like "at 6pm", "every Monday", or "in 2 hours".
            </div>
          </div>
	          <div class="task-modal-field">
	            <div class="task-modal-label-row">
	              <label for="taskAutoDescription" class="task-modal-label">Describe your task</label>
              <button
                type="button"
                class="btn btn-sm voice-input-btn voice-input-btn--icon"
                data-voice-target="taskAutoDescription"
                data-voice-context="task"
                title="Hold to talk"
                aria-label="Hold to talk"
                aria-pressed="false"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14M17,11A1,1 0 0,0 15,11A3,3 0 0,1 9,11A1,1 0 0,0 7,11A5,5 0 0,0 11,15.9V19H9A1,1 0 0,0 9,21H15A1,1 0 0,0 15,19H13V15.9A5,5 0 0,0 17,11Z"/>
                </svg>
                <span class="visually-hidden">Hold to talk</span>
              </button>
	            </div>
	            <textarea id="taskAutoDescription" class="task-modal-textarea" rows="4" placeholder="Example: Research 3 things to do in NYC scheduled at 6pm tomorrow&#10;&#10;Or: Send a daily summary report every morning at 9am&#10;&#10;Or: Check server status every 30 minutes"></textarea>
	          </div>
	          <div id="taskAutoParseError" class="task-modal-auto-parse-error" role="alert" aria-live="assertive" hidden>
	            <div class="task-modal-auto-parse-error-icon" aria-hidden="true">
	              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
	                <path d="M11 7H13V13H11V7M11 15H13V17H11V15M12 2L1 21H23L12 2Z"/>
	              </svg>
	            </div>
	            <div class="task-modal-auto-parse-error-copy">
	              <div class="task-modal-auto-parse-error-title">Auto parsing did not work</div>
	              <div id="taskAutoParseErrorMessage" class="task-modal-auto-parse-error-message">No task was created. Try again or switch to Manual.</div>
	            </div>
	          </div>
	          <div class="task-modal-field">
	            <label for="taskAutoReferenceURL" class="task-modal-label">Reference URL <span class="task-modal-optional">(optional)</span></label>
	            <input type="url" id="taskAutoReferenceURL" class="task-modal-input" placeholder="https://example.com/spec" autocomplete="off">
	          </div>
        </div>
        <!-- Auto Edit Mode -->
        <div id="taskAutoEditSection" style="display: none;">
          <div class="task-modal-field" style="margin-bottom: 12px;">
            <div style="background: rgba(59, 130, 246, 0.1); border-radius: 8px; padding: 10px 12px; font-size: 0.8rem; color: var(--text-secondary);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="vertical-align: text-bottom; margin-right: 4px; color: #3b82f6;">
                <path d="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
              </svg>
              Describe how you want to modify this task. The AI will update it based on your instructions.
            </div>
          </div>
          <!-- Current Task Display -->
          <div class="task-modal-field" style="margin-bottom: 12px;">
            <label class="task-modal-label">Current Task</label>
            <div id="taskAutoEditCurrentTask" style="background: var(--bg-secondary); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px;">
              <div id="taskAutoEditCurrentTitle" style="font-weight: 600; color: var(--text-primary); margin-bottom: 4px;"></div>
              <div id="taskAutoEditCurrentDetails" style="font-size: 0.85rem; color: var(--text-secondary); white-space: pre-wrap;"></div>
              <div id="taskAutoEditCurrentMeta" style="margin-top: 8px; font-size: 0.75rem; color: var(--text-muted);"></div>
            </div>
          </div>
          <div class="task-modal-field">
            <div class="task-modal-label-row">
              <label for="taskAutoEditDescription" class="task-modal-label">How would you like to modify it?</label>
              <button
                type="button"
                class="btn btn-sm voice-input-btn voice-input-btn--icon"
                data-voice-target="taskAutoEditDescription"
                data-voice-context="task"
                title="Hold to talk"
                aria-label="Hold to talk"
                aria-pressed="false"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14M17,11A1,1 0 0,0 15,11A3,3 0 0,1 9,11A1,1 0 0,0 7,11A5,5 0 0,0 11,15.9V19H9A1,1 0 0,0 9,21H15A1,1 0 0,0 15,19H13V15.9A5,5 0 0,0 17,11Z"/>
                </svg>
                <span class="visually-hidden">Hold to talk</span>
              </button>
            </div>
            <textarea id="taskAutoEditDescription" class="task-modal-textarea" rows="3" placeholder="Example: Change the schedule to every weekday at 9am&#10;&#10;Or: Add more details about the expected output format&#10;&#10;Or: Assign this to a different agent"></textarea>
          </div>
        </div>
      </div>

      <!-- Manual Mode Section -->
      <div id="taskManualSection">
        <div class="task-modal-field">
          <div class="task-modal-label-row">
            <label for="taskModalDescription" class="task-modal-label">Title</label>
            <button
              type="button"
              class="btn btn-sm voice-input-btn voice-input-btn--icon"
              data-voice-target="taskModalDescription"
              data-voice-context="task"
              title="Hold to talk"
              aria-label="Hold to talk"
              aria-pressed="false"
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14M17,11A1,1 0 0,0 15,11A3,3 0 0,1 9,11A1,1 0 0,0 7,11A5,5 0 0,0 11,15.9V19H9A1,1 0 0,0 9,21H15A1,1 0 0,0 15,19H13V15.9A5,5 0 0,0 17,11Z"/>
              </svg>
              <span class="visually-hidden">Hold to talk</span>
            </button>
          </div>
          <input type="text" id="taskModalDescription" class="task-modal-input" placeholder="What needs to be done?" autocomplete="off">
        </div>
      <div class="task-modal-field">
        <div class="task-modal-label-row">
          <label for="taskModalDetails" class="task-modal-label">Details <span class="task-modal-optional">(optional)</span></label>
          <button
            type="button"
            class="btn btn-sm voice-input-btn voice-input-btn--icon"
            data-voice-target="taskModalDetails"
            data-voice-context="task"
            title="Hold to talk"
            aria-label="Hold to talk"
            aria-pressed="false"
          >
            <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M12,14A3,3 0 0,0 15,11V5A3,3 0 0,0 9,5V11A3,3 0 0,0 12,14M17,11A1,1 0 0,0 15,11A3,3 0 0,1 9,11A1,1 0 0,0 7,11A5,5 0 0,0 11,15.9V19H9A1,1 0 0,0 9,21H15A1,1 0 0,0 15,19H13V15.9A5,5 0 0,0 17,11Z"/>
            </svg>
            <span class="visually-hidden">Hold to talk</span>
          </button>
        </div>
        <textarea id="taskModalDetails" class="task-modal-textarea" placeholder="Add additional context, notes, or instructions..." rows="3"></textarea>
      </div>
      <div class="task-modal-field">
        <label for="taskModalReferenceURL" class="task-modal-label">Reference URL <span class="task-modal-optional">(optional)</span></label>
        <input type="url" id="taskModalReferenceURL" class="task-modal-input" placeholder="https://example.com/spec" autocomplete="off">
      </div>
      <div style="display: flex; gap: 12px;">
        <div class="task-modal-field" style="flex: 1;">
          <label for="taskModalPriority" class="task-modal-label">Priority</label>
          <select id="taskModalPriority" class="task-modal-input" style="cursor: pointer;">
            <option value="1">▲▲  1 — Highest</option>
            <option value="2">▲    2 — High</option>
            <option value="3" selected>●    3 — Medium</option>
            <option value="4">▼    4 — Low</option>
            <option value="5">▼▼  5 — Lowest</option>
          </select>
        </div>
        <div class="task-modal-field" style="flex: 2;">
          <label for="taskModalAssignment" class="task-modal-label">Assign to Agent <span class="task-modal-optional">(optional)</span></label>
          <select id="taskModalAssignment" class="task-modal-input" style="cursor: pointer;">
            <option value="">-- No agent (manual task) --</option>
          </select>
        </div>
      </div>
      <div class="task-modal-field" id="taskModalInputTasksField">
        <label class="task-modal-label">Input Tasks <span class="task-modal-optional">(optional)</span></label>
        <div id="taskModalInputTasks" class="task-modal-input-chips" data-selected-inputs="[]" role="group" aria-label="Input tasks"></div>
        <div id="taskModalInputTasksEmpty" class="task-modal-input-empty" style="display: none;">No other tasks available yet.</div>
        <div id="taskModalInputTasksNotice" class="task-modal-input-hint" style="display: none;">Inputs are set per subtask when this is a workflow.</div>
        <div class="task-modal-input-hint">Click a task to use its result as an input. Use <code>{previous}</code> or <code>{result}</code> in the title for the most recent input, or <code>{input1}</code>, <code>{input2}</code>, ... for specific inputs.</div>
      </div>
      <!-- Subtasks Section -->
      <div id="taskModalSubtaskSection" class="task-modal-subtask-section">
        <div class="task-modal-subtask-header">
          <div>
            <label class="task-modal-label">Subtasks <span class="task-modal-optional">(optional)</span></label>
            <div class="task-modal-subtask-hint" id="taskModalSubtaskHint">Add steps to turn this task into a workflow.</div>
          </div>
          <button type="button" class="task-modal-btn task-modal-btn-secondary" id="taskModalAddSubtask">
            Add Subtask
          </button>
        </div>
        <div id="taskModalSubtaskDisabled" class="task-modal-subtask-disabled" style="display: none;">
          This task is already part of a workflow. Subtasks can only be added to top-level tasks.
        </div>
        <div id="taskModalSubtaskList" class="task-modal-subtask-list"></div>
        <div id="taskModalSubtaskEmpty" class="task-modal-subtask-empty">No subtasks yet.</div>
      </div>
      <!-- Automation Section: Schedule + Auto-save Results -->
      <div class="task-modal-automation" style="margin-top: 18px;">
        <div class="task-modal-automation-header">
          <div class="task-modal-automation-title">Automation</div>
          <div class="task-modal-automation-subtitle">Run this task on a schedule and persist its output between runs.</div>
        </div>

      <!-- Schedule Section -->
      <div class="task-modal-field">
        <div style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="taskModalScheduleEnabled" style="width: 16px; height: 16px; cursor: pointer;">
          <label for="taskModalScheduleEnabled" class="task-modal-label" style="margin: 0; cursor: pointer; display: flex; align-items: center; gap: 6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b">
              <path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
            </svg>
            Enable Schedule
          </label>
        </div>
      </div>
      <div id="taskModalScheduleFields" style="display: none; background: rgba(245, 158, 11, 0.1); border-radius: 8px; padding: 12px; margin-top: 8px;">
        <div class="task-modal-field" style="margin-bottom: 12px;">
          <label for="taskModalScheduleName" class="task-modal-label" style="font-size: 0.8rem;">Schedule Name <span class="task-modal-optional">(optional)</span></label>
          <input type="text" id="taskModalScheduleName" class="task-modal-input" placeholder="e.g., Daily Report" autocomplete="off">
        </div>
        <div class="task-modal-field" style="margin-bottom: 12px;">
          <label for="taskModalScheduleType" class="task-modal-label" style="font-size: 0.8rem;">Schedule Type</label>
          <select id="taskModalScheduleType" class="task-modal-input" style="cursor: pointer;">
            <option value="daily">Daily</option>
            <option value="weekly">Weekly</option>
            <option value="interval">Interval (every X minutes/hours)</option>
            <option value="once">Once (at specific time)</option>
            <option value="cron">Advanced cron</option>
          </select>
        </div>
        <div id="taskModalScheduleTimeField" class="task-modal-field" style="margin-bottom: 12px;">
          <label for="taskModalScheduleTime" class="task-modal-label" style="font-size: 0.8rem;">Time of Day</label>
          <input type="time" id="taskModalScheduleTime" class="task-modal-input" value="09:00">
        </div>
        <div id="taskModalScheduleDayField" class="task-modal-field" style="margin-bottom: 12px; display: none;">
          <label class="task-modal-label" style="font-size: 0.8rem;">Days</label>
          <div id="taskModalScheduleDayRow" class="task-modal-day-row" role="group" aria-label="Days of week">
            <label class="task-modal-day-pill"><input type="checkbox" data-day-value="1"><span>Mon</span></label>
            <label class="task-modal-day-pill"><input type="checkbox" data-day-value="2"><span>Tue</span></label>
            <label class="task-modal-day-pill"><input type="checkbox" data-day-value="3"><span>Wed</span></label>
            <label class="task-modal-day-pill"><input type="checkbox" data-day-value="4"><span>Thu</span></label>
            <label class="task-modal-day-pill"><input type="checkbox" data-day-value="5"><span>Fri</span></label>
            <label class="task-modal-day-pill"><input type="checkbox" data-day-value="6"><span>Sat</span></label>
            <label class="task-modal-day-pill"><input type="checkbox" data-day-value="0"><span>Sun</span></label>
          </div>
          <div class="task-modal-day-presets">
            <button type="button" class="task-modal-day-preset" data-day-preset="weekdays">Weekdays</button>
            <button type="button" class="task-modal-day-preset" data-day-preset="weekend">Weekend</button>
            <button type="button" class="task-modal-day-preset" data-day-preset="all">Every day</button>
          </div>
        </div>
        <div id="taskModalScheduleIntervalField" class="task-modal-field" style="margin-bottom: 12px; display: none;">
          <label class="task-modal-label" style="font-size: 0.8rem;">Interval</label>
          <div style="display: flex; gap: 8px;">
            <input type="number" id="taskModalScheduleIntervalValue" class="task-modal-input" value="1" min="1" style="width: 80px;">
            <select id="taskModalScheduleIntervalUnit" class="task-modal-input" style="cursor: pointer;">
              <option value="minutes">Minutes</option>
              <option value="hours" selected>Hours</option>
              <option value="days">Days</option>
            </select>
          </div>
        </div>
        <div id="taskModalScheduleOnceField" class="task-modal-field" style="margin-bottom: 0; display: none;">
          <label for="taskModalScheduleDatetime" class="task-modal-label" style="font-size: 0.8rem;">Execute At</label>
          <input type="datetime-local" id="taskModalScheduleDatetime" class="task-modal-input">
        </div>
        <div id="taskModalScheduleCronField" class="task-modal-field" style="margin-bottom: 0; display: none;">
          <label for="taskModalScheduleCron" class="task-modal-label" style="font-size: 0.8rem;">Cron Expression</label>
          <input type="text" id="taskModalScheduleCron" class="task-modal-input" placeholder="0 9 * * *" autocomplete="off">
        </div>
        <div id="taskModalSchedulePreview" class="task-modal-schedule-preview" aria-live="polite"></div>
      </div>
      <!-- Auto-save Results Section -->
      <div class="task-modal-field" style="margin-top: 16px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="taskModalAutoSaveEnabled" style="width: 16px; height: 16px; cursor: pointer;">
          <label for="taskModalAutoSaveEnabled" class="task-modal-label" style="margin: 0; cursor: pointer; display: flex; align-items: center; gap: 6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#10b981">
              <path d="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
            </svg>
            Auto-save Results
          </label>
        </div>
      </div>
      <div id="taskModalAutoSaveFields" style="display: none; background: rgba(16, 185, 129, 0.1); border-radius: 8px; padding: 12px; margin-top: 8px;">
        <div class="task-modal-field" style="margin-bottom: 12px;">
          <label for="taskModalAutoSaveWriteMode" class="task-modal-label" style="font-size: 0.8rem;">Output Mode</label>
          <select id="taskModalAutoSaveWriteMode" class="task-modal-input" style="cursor: pointer;">
            <option value="new_file">Save each run as a new file</option>
            <option value="append">Append to CSV</option>
          </select>
        </div>
        <div class="task-modal-field" style="margin-bottom: 12px;">
          <label for="taskModalAutoSaveTarget" class="task-modal-label" style="font-size: 0.8rem;">Save To</label>
          <select id="taskModalAutoSaveTarget" class="task-modal-input" style="cursor: pointer;">
            <option value="default">Default Output Folder</option>
            <option value="custom">Custom Path...</option>
          </select>
        </div>
        <div id="taskModalAutoSaveDefaultPathDisplay" class="task-modal-field" style="margin-bottom: 12px;">
          <div style="display: flex; align-items: center; gap: 8px; padding: 8px 12px; background: rgba(16, 185, 129, 0.15); border-radius: 6px; font-size: 0.75rem; color: var(--text-secondary);">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="flex-shrink: 0;">
              <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
            </svg>
            <span id="taskModalDefaultOutputPath" style="word-break: break-all;">Loading...</span>
          </div>
        </div>
        <div id="taskModalAutoSaveStoreNodeField" class="task-modal-field" style="margin-bottom: 12px; display: none;">
          <label for="taskModalAutoSaveStoreNode" class="task-modal-label" style="font-size: 0.8rem;">Store Node</label>
          <select id="taskModalAutoSaveStoreNode" class="task-modal-input" style="cursor: pointer;">
            <!-- Populated dynamically -->
          </select>
        </div>
        <div id="taskModalAutoSavePathField" class="task-modal-field" style="margin-bottom: 12px; display: none;">
          <label for="taskModalAutoSavePath" class="task-modal-label" style="font-size: 0.8rem;">File Path <span class="task-modal-optional">(directory or file)</span></label>
          <div style="display: flex; gap: 8px;">
            <input type="text" id="taskModalAutoSavePath" class="task-modal-input" placeholder="outputs/my-results/" style="flex: 1;">
            <button type="button" id="taskModalBrowseBtn" class="task-modal-btn task-modal-btn-browse" title="Browse folder" aria-label="Browse folder">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
              </svg>
            </button>
          </div>
        </div>
        <div class="task-modal-field" style="margin-bottom: 0;">
          <label for="taskModalAutoSaveFormat" class="task-modal-label" style="font-size: 0.8rem;">Format</label>
          <select id="taskModalAutoSaveFormat" class="task-modal-input" style="cursor: pointer;">
            <option value="text">Plain Text</option>
            <option value="json">JSON</option>
            <option value="markdown">Markdown</option>
            <option value="csv">CSV</option>
          </select>
        </div>
        <div id="taskModalOutputContractSection" class="task-modal-field" style="display: none; margin-top: 12px; margin-bottom: 0; border-top: 1px solid color-mix(in srgb, var(--border-color) 85%, transparent); padding-top: 12px;">
          <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 10px;">
            <div>
              <label class="task-modal-label" style="font-size: 0.8rem; margin-bottom: 2px;">Output Contract</label>
              <div style="font-size: 0.72rem; color: var(--text-secondary); line-height: 1.35;">Append mode validates each run against these CSV columns before writing.</div>
            </div>
            <div style="display: flex; gap: 8px; flex-shrink: 0;">
              <button type="button" id="taskModalOutputContractSuggest" class="task-modal-btn task-modal-btn-secondary" style="padding: 6px 9px; font-size: 0.74rem;">Regenerate</button>
              <button type="button" id="taskModalOutputContractAddColumn" class="task-modal-btn task-modal-btn-secondary" style="padding: 6px 9px; font-size: 0.74rem;">Add Column</button>
            </div>
          </div>
          <div id="taskModalOutputContractRows" style="display: grid; gap: 8px;"></div>
          <div id="taskModalOutputContractEmpty" style="display: none; border: 1px dashed var(--border-color); border-radius: 8px; padding: 10px; color: var(--text-secondary); font-size: 0.78rem;">No output contract defined. Runs will save without validation.</div>
          <div id="taskModalOutputContractStatus" aria-live="polite" style="display: none; margin-top: 8px; color: var(--text-secondary); font-size: 0.76rem;"></div>
          <div id="taskModalOutputContractError" role="alert" style="display: none; margin-top: 8px; color: #f87171; font-size: 0.76rem;"></div>
        </div>
      </div>
      </div><!-- End task-modal-automation -->
      </div><!-- End taskManualSection -->

      <!-- File Attachments Section (visible in both Manual and Auto modes) -->
      <div class="task-modal-field" style="margin-top: 16px;">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#6366f1">
            <path d="M16.5,6.5V17.5A4.5,4.5 0 0,1 12,22A4.5,4.5 0 0,1 7.5,17.5V8A3.5,3.5 0 0,1 11,4.5A3.5,3.5 0 0,1 14.5,8V16.5A2.5,2.5 0 0,1 12,19A2.5,2.5 0 0,1 9.5,16.5V7.5H11V16.5A1,1 0 0,0 12,17.5A1,1 0 0,0 13,16.5V8A2,2 0 0,0 11,6A2,2 0 0,0 9,8V17.5A3.5,3.5 0 0,0 12.5,21A3.5,3.5 0 0,0 16,17.5V6.5H16.5Z"/>
          </svg>
          <label class="task-modal-label" style="margin: 0;">Attachments <span class="task-modal-optional">(optional)</span></label>
        </div>
        <div style="display: flex; gap: 8px; align-items: stretch;">
          <div id="taskModalFileDropZone" class="task-file-drop-zone" style="flex: 1;" role="button" tabindex="0" aria-controls="taskModalFileInput" aria-describedby="taskModalFileDropHint" aria-label="Attach files">
            <div class="task-file-drop-content">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" style="color: var(--text-secondary); opacity: 0.6;">
                <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M13.5,16V19H10.5V16H8L12,12L16,16H13.5M13,9V3.5L18.5,9H13Z"/>
              </svg>
              <span id="taskModalFileDropHint" style="color: var(--text-secondary); font-size: 0.8rem;">Drop files or click to attach (max 100MB)</span>
            </div>
            <input type="file" id="taskModalFileInput" multiple style="display: none;">
          </div>
          <button type="button" id="taskModalAddFilePathBtn" class="task-modal-btn task-modal-btn-directory" title="Add file path reference (no upload)">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M13,9H18.5L13,3.5V9M6,2H14L20,8V20A2,2 0 0,1 18,22H6C4.89,22 4,21.1 4,20V4C4,2.89 4.89,2 6,2M6,20H15L18,20V13L13,8H6V20Z"/>
            </svg>
            <span>Path</span>
          </button>
          <button type="button" id="taskModalAddDirectoryBtn" class="task-modal-btn task-modal-btn-directory" title="Add directory reference">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
              <path d="M10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6H12L10,4Z"/>
            </svg>
            <span>Directory</span>
          </button>
        </div>
        <!-- File path input (hidden by default) -->
        <div id="taskModalFilePathInput" style="display: none; margin-top: 8px;">
          <div style="display: flex; gap: 8px;">
            <input type="text" id="taskModalFilePathText" class="task-modal-input" placeholder="/path/to/file.wav" style="flex: 1;">
            <button type="button" id="taskModalAddFilePathConfirm" class="task-modal-btn task-modal-btn-save" style="padding: 6px 12px;">Add</button>
            <button type="button" id="taskModalAddFilePathCancel" class="task-modal-btn task-modal-btn-cancel" style="padding: 6px 12px;">Cancel</button>
          </div>
        </div>
        <div id="taskModalSelectedFiles" class="task-selected-files" style="display: none;"></div>
      </div>
    </div>
    <div class="task-modal-footer">
      <button type="button" class="task-modal-btn task-modal-btn-cancel" id="taskModalCancel">Cancel</button>
      <button type="button" class="task-modal-btn task-modal-btn-save" id="taskModalSave">
        <span class="task-modal-btn-spinner" aria-hidden="true"></span>
        <span id="taskModalSaveText">Save Task</span>
      </button>
    </div>
	    <div class="task-modal-progress" id="taskModalProgress" hidden>
	      <div class="task-modal-progress-card">
	        <div class="task-modal-progress-status">
          <div class="task-modal-progress-spinner" aria-hidden="true"></div>
          <div>
            <div class="task-modal-progress-title" id="taskModalProgressHeadline">Working...</div>
            <div class="task-modal-progress-message" id="taskModalProgressMessage">Analyzing your request.</div>
          </div>
        </div>
        <ul class="task-modal-progress-steps" id="taskModalProgressSteps">
          <li data-step="parse">Parse request</li>
          <li data-step="prepare">Prepare details</li>
          <li data-step="apply">Apply changes</li>
	        </ul>
	      </div>
	    </div>
	    <div class="task-modal-auto-confirm" id="taskAutoConfirm" role="dialog" aria-modal="true" aria-labelledby="taskAutoConfirmTitle" hidden>
	      <div class="task-modal-auto-confirm-card">
	        <div class="task-modal-auto-confirm-header">
	          <div class="task-modal-auto-confirm-eyebrow" id="taskAutoConfirmEyebrow">Auto Parsed Task</div>
	          <button type="button" class="task-modal-auto-confirm-close" id="taskAutoConfirmClose" aria-label="Cancel task creation">
	            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
	              <path d="M18.3 5.71L12 12L5.7 5.71L4.29 7.12L10.59 13.41L4.29 19.71L5.7 21.12L12 14.83L18.3 21.12L19.71 19.71L13.41 13.41L19.71 7.12L18.3 5.71Z"/>
	            </svg>
	          </button>
	        </div>
	        <div class="task-modal-auto-confirm-title" id="taskAutoConfirmTitle">Create this task?</div>
	        <div class="task-modal-auto-confirm-message" id="taskAutoConfirmMessage">Review the task parsed from your request before it is created.</div>
	        <div class="task-modal-auto-confirm-grid">
	          <div class="task-modal-auto-confirm-row">
	            <span>Title</span>
	            <strong id="taskAutoConfirmParsedTitle">New Task</strong>
	          </div>
	          <div class="task-modal-auto-confirm-row">
	            <span>Assigned Agent</span>
	            <strong id="taskAutoConfirmAssignment" data-state="unassigned">Unassigned</strong>
	          </div>
	          <div class="task-modal-auto-confirm-row" id="taskAutoConfirmDetailsRow" hidden>
	            <span>Details</span>
	            <strong id="taskAutoConfirmDetails">No details</strong>
	          </div>
	          <div class="task-modal-auto-confirm-row" id="taskAutoConfirmScheduleRow" hidden>
	            <span>Schedule</span>
	            <strong id="taskAutoConfirmSchedule">Not scheduled</strong>
	          </div>
	          <div class="task-modal-auto-confirm-row" id="taskAutoConfirmStorageRow" hidden>
	            <span>Storage</span>
	            <strong id="taskAutoConfirmStorage">None</strong>
	          </div>
	        </div>
	        <div class="task-modal-auto-confirm-steps" id="taskAutoConfirmSteps" hidden></div>
	        <div class="task-modal-auto-confirm-footer">
	          <button type="button" class="task-modal-btn task-modal-btn-cancel" id="taskAutoConfirmCancel">Cancel</button>
	          <button type="button" class="task-modal-btn task-modal-btn-save" id="taskAutoConfirmCreate">Create Task</button>
	        </div>
	      </div>
	    </div>
	  </div>
	</div>
	{{end}}
