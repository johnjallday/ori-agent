{{define "task-modal"}}
<!-- Shared Task Modal (for creating/editing tasks) -->
<div id="taskModal" class="task-modal" style="display: none;">
  <div class="task-modal-backdrop"></div>
  <div class="task-modal-content">
    <div class="task-modal-header">
      <h6 class="task-modal-title" id="taskModalTitle">Add Task</h6>
      <button type="button" class="task-modal-close" id="taskModalClose" aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
          <path d="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"/>
        </svg>
      </button>
    </div>
    <div class="task-modal-body">
      <div class="task-modal-field">
        <label for="taskModalDescription" class="task-modal-label">Title</label>
        <input type="text" id="taskModalDescription" class="task-modal-input" placeholder="What needs to be done?" autocomplete="off">
      </div>
      <div class="task-modal-field">
        <label for="taskModalDetails" class="task-modal-label">Details <span class="task-modal-optional">(optional)</span></label>
        <textarea id="taskModalDetails" class="task-modal-textarea" placeholder="Add additional context, notes, or instructions..." rows="3"></textarea>
      </div>
      <div style="display: flex; gap: 12px;">
        <div class="task-modal-field" style="flex: 1;">
          <label for="taskModalPriority" class="task-modal-label">Priority</label>
          <select id="taskModalPriority" class="task-modal-input" style="cursor: pointer;">
            <option value="1">1 - Highest</option>
            <option value="2">2 - High</option>
            <option value="3" selected>3 - Medium</option>
            <option value="4">4 - Low</option>
            <option value="5">5 - Lowest</option>
          </select>
        </div>
        <div class="task-modal-field" style="flex: 2;">
          <label for="taskModalAssignment" class="task-modal-label">Assign to Agent <span class="task-modal-optional">(optional)</span></label>
          <select id="taskModalAssignment" class="task-modal-input" style="cursor: pointer;">
            <option value="">-- No agent (manual task) --</option>
          </select>
        </div>
      </div>
      <!-- Schedule Section -->
      <div class="task-modal-field" style="margin-top: 16px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="taskModalScheduleEnabled" style="width: 16px; height: 16px; cursor: pointer;">
          <label for="taskModalScheduleEnabled" class="task-modal-label" style="margin: 0; cursor: pointer; display: flex; align-items: center; gap: 6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#f59e0b">
              <path d="M12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22C6.47,22 2,17.5 2,12A10,10 0 0,1 12,2M12.5,7V12.25L17,14.92L16.25,16.15L11,13V7H12.5Z"/>
            </svg>
            Enable Schedule
          </label>
        </div>
      </div>
      <div id="taskModalScheduleFields" style="display: none; background: rgba(245, 158, 11, 0.1); border-radius: 8px; padding: 12px; margin-top: 8px;">
        <div class="task-modal-field" style="margin-bottom: 12px;">
          <label for="taskModalScheduleName" class="task-modal-label" style="font-size: 0.8rem;">Schedule Name <span class="task-modal-optional">(optional)</span></label>
          <input type="text" id="taskModalScheduleName" class="task-modal-input" placeholder="e.g., Daily Report" autocomplete="off">
        </div>
        <div class="task-modal-field" style="margin-bottom: 12px;">
          <label for="taskModalScheduleType" class="task-modal-label" style="font-size: 0.8rem;">Schedule Type</label>
          <select id="taskModalScheduleType" class="task-modal-input" style="cursor: pointer;">
            <option value="daily">Daily</option>
            <option value="weekly">Weekly</option>
            <option value="interval">Interval (every X minutes/hours)</option>
            <option value="once">Once (at specific time)</option>
          </select>
        </div>
        <div id="taskModalScheduleTimeField" class="task-modal-field" style="margin-bottom: 12px;">
          <label for="taskModalScheduleTime" class="task-modal-label" style="font-size: 0.8rem;">Time of Day</label>
          <input type="time" id="taskModalScheduleTime" class="task-modal-input" value="09:00">
        </div>
        <div id="taskModalScheduleDayField" class="task-modal-field" style="margin-bottom: 12px; display: none;">
          <label for="taskModalScheduleDay" class="task-modal-label" style="font-size: 0.8rem;">Day of Week</label>
          <select id="taskModalScheduleDay" class="task-modal-input" style="cursor: pointer;">
            <option value="0">Sunday</option>
            <option value="1">Monday</option>
            <option value="2">Tuesday</option>
            <option value="3">Wednesday</option>
            <option value="4">Thursday</option>
            <option value="5">Friday</option>
            <option value="6">Saturday</option>
          </select>
        </div>
        <div id="taskModalScheduleIntervalField" class="task-modal-field" style="margin-bottom: 12px; display: none;">
          <label class="task-modal-label" style="font-size: 0.8rem;">Interval</label>
          <div style="display: flex; gap: 8px;">
            <input type="number" id="taskModalScheduleIntervalValue" class="task-modal-input" value="1" min="1" style="width: 80px;">
            <select id="taskModalScheduleIntervalUnit" class="task-modal-input" style="cursor: pointer;">
              <option value="minutes">Minutes</option>
              <option value="hours" selected>Hours</option>
              <option value="days">Days</option>
            </select>
          </div>
        </div>
        <div id="taskModalScheduleOnceField" class="task-modal-field" style="margin-bottom: 0; display: none;">
          <label for="taskModalScheduleDatetime" class="task-modal-label" style="font-size: 0.8rem;">Execute At</label>
          <input type="datetime-local" id="taskModalScheduleDatetime" class="task-modal-input">
        </div>
      </div>
      <!-- Auto-save Results Section -->
      <div class="task-modal-field" style="margin-top: 16px;">
        <div style="display: flex; align-items: center; gap: 8px;">
          <input type="checkbox" id="taskModalAutoSaveEnabled" style="width: 16px; height: 16px; cursor: pointer;">
          <label for="taskModalAutoSaveEnabled" class="task-modal-label" style="margin: 0; cursor: pointer; display: flex; align-items: center; gap: 6px;">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="#10b981">
              <path d="M15,9H5V5H15M12,19A3,3 0 0,1 9,16A3,3 0 0,1 12,13A3,3 0 0,1 15,16A3,3 0 0,1 12,19M17,3H5C3.89,3 3,3.9 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V7L17,3Z"/>
            </svg>
            Auto-save Results
          </label>
        </div>
      </div>
      <div id="taskModalAutoSaveFields" style="display: none; background: rgba(16, 185, 129, 0.1); border-radius: 8px; padding: 12px; margin-top: 8px;">
        <div class="task-modal-field" style="margin-bottom: 12px;">
          <label for="taskModalAutoSaveTarget" class="task-modal-label" style="font-size: 0.8rem;">Save To</label>
          <select id="taskModalAutoSaveTarget" class="task-modal-input" style="cursor: pointer;">
            <option value="default">Default Output Folder</option>
            <option value="custom">Custom Path...</option>
          </select>
        </div>
        <div id="taskModalAutoSaveStoreNodeField" class="task-modal-field" style="margin-bottom: 12px; display: none;">
          <label for="taskModalAutoSaveStoreNode" class="task-modal-label" style="font-size: 0.8rem;">Store Node</label>
          <select id="taskModalAutoSaveStoreNode" class="task-modal-input" style="cursor: pointer;">
            <!-- Populated dynamically -->
          </select>
        </div>
        <div id="taskModalAutoSavePathField" class="task-modal-field" style="margin-bottom: 12px; display: none;">
          <label for="taskModalAutoSavePath" class="task-modal-label" style="font-size: 0.8rem;">File Path <span class="task-modal-optional">(directory or file)</span></label>
          <input type="text" id="taskModalAutoSavePath" class="task-modal-input" placeholder="outputs/my-results/">
        </div>
        <div class="task-modal-field" style="margin-bottom: 0;">
          <label for="taskModalAutoSaveFormat" class="task-modal-label" style="font-size: 0.8rem;">Format</label>
          <select id="taskModalAutoSaveFormat" class="task-modal-input" style="cursor: pointer;">
            <option value="text">Plain Text</option>
            <option value="json">JSON</option>
            <option value="markdown">Markdown</option>
          </select>
        </div>
      </div>
    </div>
    <div class="task-modal-footer">
      <button type="button" class="task-modal-btn task-modal-btn-cancel" id="taskModalCancel">Cancel</button>
      <button type="button" class="task-modal-btn task-modal-btn-save" id="taskModalSave">Save Task</button>
    </div>
  </div>
</div>
{{end}}
