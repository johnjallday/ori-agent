{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ori.local/schemas/workspace-surface-v1.schema.json",
  "title": "Ori Workspace Surface contribution v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "protocol",
    "capabilities",
    "services",
    "blueprints"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "$ref": "#/$defs/id" },
    "version": { "type": "string", "minLength": 1, "maxLength": 120 },
    "protocol": { "$ref": "#/$defs/protocol" },
    "requires_host_features": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "assistant_program_v1",
          "specialist_setup_journey_v1",
          "setup_quests_v2",
          "template_group_requirements_v1",
          "blueprint_inputs_v1",
          "independent_program_homes_v1"
        ]
      }
    },
    "setup_quests": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "setup-quest-v2.schema.json" }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/capability" }
    },
    "services": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/service" }
    },
    "blueprints": {
      "type": "array",
      "maxItems": 16,
      "items": { "$ref": "#/$defs/blueprint" }
    },
    "assistant_program_homes": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/assistantProgramHome" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "text120": { "type": "string", "maxLength": 120 },
    "text500": { "type": "string", "maxLength": 500 },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*[%\\\\]).+$"
    },
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min"],
      "properties": {
        "min": { "type": "integer", "minimum": 1 },
        "max": { "type": "integer", "minimum": 1 }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/text120" },
        "description": { "$ref": "#/$defs/text500" }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "display", "surfaces", "runtime_provider", "agent_operations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "display": { "$ref": "#/$defs/display" },
        "service_id": { "$ref": "#/$defs/id" },
        "surfaces": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/surface" }
        },
        "runtime_provider": {
          "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/runtimeProvider" }]
        },
        "agent_operations": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "icon",
        "placement",
        "entry_asset",
        "modal",
        "status_operation",
        "operations",
        "polling",
        "host_intents"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text120" },
        "description": { "$ref": "#/$defs/text500" },
        "icon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "host" },
            "value": { "$ref": "#/$defs/id" }
          }
        },
        "placement": { "enum": ["map_modal", "project_entry"] },
        "entry_asset": { "$ref": "#/$defs/relativePath" },
        "modal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 320, "maximum": 1600 },
            "height": { "type": "integer", "minimum": 240, "maximum": 1200 }
          }
        },
        "status_operation": { "$ref": "#/$defs/id" },
        "operations": {
          "type": "array",
          "maxItems": 128,
          "items": { "$ref": "#/$defs/id" }
        },
        "polling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["map_seconds", "open_seconds"],
          "properties": {
            "map_seconds": { "type": "integer", "minimum": 5, "maximum": 60 },
            "open_seconds": { "type": "integer", "minimum": 1, "maximum": 60 }
          }
        },
        "host_intents": { "$ref": "#/$defs/hostIntents" },
        "task_templates": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/taskTemplate" }
        },
        "default_task_template": { "$ref": "#/$defs/id" }
      }
    },
    "taskTemplate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "description",
        "title",
        "instructions",
        "required_capabilities",
        "auto_start",
        "input_schema"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text120" },
        "description": { "$ref": "#/$defs/text500" },
        "title": { "type": "string", "minLength": 1, "maxLength": 300 },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 16384 },
        "required_capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/id" }
        },
        "auto_start": { "type": "boolean" },
        "input_schema": { "type": "object" }
      }
    },
    "hostIntents": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ask_ori", "open_setup", "confirmation", "state", "close"],
      "properties": {
        "ask_ori": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required_capabilities"],
          "properties": {
            "required_capabilities": {
              "type": "array",
              "maxItems": 16,
              "items": { "$ref": "#/$defs/id" }
            }
          }
        },
        "open_setup": {
          "type": "object",
          "additionalProperties": false,
          "properties": { "provider_id": { "type": "string", "maxLength": 64 } }
        },
        "confirmation": { "type": "boolean" },
        "state": { "type": "boolean" },
        "close": { "type": "boolean" }
      }
    },
    "runtimeProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requirement_key", "operations", "scopes"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "requirement_key": { "$ref": "#/$defs/id" },
        "operations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["prerequisites", "readiness", "live_status", "verify", "repair"],
          "properties": {
            "prerequisites": { "$ref": "#/$defs/id" },
            "readiness": { "$ref": "#/$defs/id" },
            "live_status": { "$ref": "#/$defs/id" },
            "verify": { "$ref": "#/$defs/id" },
            "repair": { "$ref": "#/$defs/id" }
          }
        },
        "scopes": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "transport", "protocol_version", "entrypoint", "artifacts", "operations"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "transport": { "const": "mcp_stdio" },
        "protocol_version": { "const": 1 },
        "entrypoint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_id", "args"],
          "properties": {
            "artifact_id": { "$ref": "#/$defs/id" },
            "args": {
              "type": "array",
              "maxItems": 32,
              "items": { "type": "string", "maxLength": 256 }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/artifact" }
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "os", "arch", "source", "sha256", "size"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "os": { "$ref": "#/$defs/id" },
        "arch": { "$ref": "#/$defs/id" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["bundled", "https"] },
            "path": { "$ref": "#/$defs/relativePath" },
            "url": { "type": "string", "pattern": "^https://", "maxLength": 2048 }
          }
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "size": { "type": "integer", "minimum": 1 }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "input_schema",
        "output_schema",
        "max_output_bytes",
        "timeout_class",
        "policy",
        "scopes"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "input_schema": { "type": "object" },
        "output_schema": { "type": "object" },
        "max_output_bytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
        "timeout_class": { "enum": ["fast", "normal", "long"] },
        "policy": { "enum": ["read_only", "reversible", "confirmation_required"] },
        "scopes": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "assistantProgramHomeRole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "required", "system_prompt"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text120" },
        "description": { "type": "string", "maxLength": 1000 },
        "required": { "type": "boolean" },
        "capability_id": { "$ref": "#/$defs/id" },
        "primary": { "type": "boolean" },
        "role": { "$ref": "#/$defs/id" },
        "type": { "$ref": "#/$defs/id" },
        "system_prompt": { "type": "string", "minLength": 1, "maxLength": 8192 },
        "skills": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "assistantProgramStage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "accepted_completion_threshold"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "$ref": "#/$defs/text120" },
        "description": { "type": "string", "maxLength": 1000 },
        "accepted_completion_threshold": { "type": "integer", "minimum": 0 }
      }
    },
    "assistantReflection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_projects", "cadence_hours", "max_projects", "max_events_per_project", "max_candidates", "max_evidence", "rubric"],
      "properties": {
        "minimum_projects": { "type": "integer", "minimum": 3, "maximum": 32 },
        "cadence_hours": { "type": "integer", "minimum": 24, "maximum": 744 },
        "max_projects": { "type": "integer", "minimum": 3, "maximum": 32 },
        "max_events_per_project": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_candidates": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_evidence": { "type": "integer", "minimum": 3, "maximum": 16 },
        "rubric": { "type": "string", "minLength": 1, "maxLength": 8192 }
      }
    },
    "allowedProjectAttachment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_plugin_id", "blueprint_id", "project_team_id", "project_team_schema_version", "min_project_team_version", "max_project_team_version"],
      "properties": {
        "provider_plugin_id": { "$ref": "#/$defs/id" },
        "blueprint_id": { "$ref": "#/$defs/id" },
        "project_team_id": { "$ref": "#/$defs/id" },
        "project_team_schema_version": { "const": 1 },
        "min_project_team_version": { "type": "integer", "minimum": 1 },
        "max_project_team_version": { "type": "integer", "minimum": 1 }
      }
    },
    "assistantProgramHome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "version", "id", "station_name", "default_primary_name", "hire_title", "roles", "stages", "reflection"],
      "properties": {
        "schema_version": { "const": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "id": { "$ref": "#/$defs/id" },
        "station_name": { "$ref": "#/$defs/text120" },
        "station_description": { "type": "string", "maxLength": 1000 },
        "default_primary_name": { "$ref": "#/$defs/text120" },
        "hire_title": { "type": "string", "minLength": 1, "maxLength": 160 },
        "hire_description": { "type": "string", "maxLength": 1000 },
        "disabled_message": { "type": "string", "maxLength": 1000 },
        "suggestion_required_capabilities": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/assistantProgramHomeRole" }
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/assistantProgramStage" }
        },
        "reflection": { "$ref": "#/$defs/assistantReflection" },
        "allowed_project_attachments": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/allowedProjectAttachment" }
        }
      }
    },
    "blueprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "manifest", "skeleton", "capabilities"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "integer", "minimum": 1 },
        "manifest": { "$ref": "#/$defs/relativePath" },
        "skeleton": { "$ref": "#/$defs/relativePath" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    }
  }
}
