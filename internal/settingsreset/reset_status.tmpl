<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} · Ori</title>
  <style>
    :root {
      color-scheme: light dark;
      --paper: #f6f5ef; --ink: #182b2a; --muted: #405552;
      --line: #bacdc6; --panel: #e7efeb; --accent: #1c594c; --button-ink: #fff;
      font: 1rem/1.55 system-ui, sans-serif;
      background: var(--paper); color: var(--ink);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #14211f; --ink: #edf4f0; --muted: #bdd0c8;
        --line: #506762; --panel: #1d302c; --accent: #a9e1ca; --button-ink: #132c24;
      }
    }
    body { margin: 0; border-block-start: .3rem solid var(--accent); }
    main { max-width: 39rem; margin: clamp(2rem, 8vh, 6rem) auto; padding: 0 1.25rem 2rem; }
    .eyebrow { color: var(--accent); font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    h1 { font: 500 clamp(2rem, 7vw, 3.5rem)/1.1 Georgia, serif; margin: .5rem 0 1rem; }
    h2 { font-size: 1.15rem; margin: 1.5rem 0 .5rem; }
    p { margin: .5rem 0 1rem; }
    li { margin-block: .55rem; }
    .status { padding: 1.2rem; background: var(--panel); border-inline-start: .25rem solid var(--accent); }
    .status p:last-child { margin-bottom: 0; }
    .id { font-size: .85rem; color: var(--muted); overflow-wrap: anywhere; }
    .blockers strong { display: block; }
    footer { margin-block-start: 1.5rem; padding-block-start: 1rem; border-block-start: 1px solid var(--line); }
    button, .action { display: inline-block; color: var(--button-ink); background: var(--accent); font: inherit; font-weight: 700; border: 0; border-radius: .35rem; padding: .65rem 1rem; cursor: pointer; }
    :focus-visible { outline: .2rem solid var(--accent); outline-offset: .25rem; }
  </style>
</head>
<body>
  <main>
    <header class="eyebrow">Ori / Reset &amp; Recovery</header>
    <div class="status" role="status" aria-live="polite" aria-atomic="true">
      <h1>{{.Title}}</h1>
      <p>{{.Message}}</p>
      {{if .ID}}<p class="id">Operation <code>{{.ID}}</code></p>{{end}}
    </div>
    {{if .Operation.Blockers}}
    <section aria-labelledby="blockers-heading">
      <h2 id="blockers-heading">What needs attention</h2>
      <ul class="blockers">{{range .Operation.Blockers}}<li><strong>{{.Message}}</strong>{{.Recovery}}</li>{{end}}</ul>
    </section>
    {{end}}
    {{if .ShowRestart}}
    <section aria-labelledby="restart-heading">
      <h2 id="restart-heading">How to restart Ori</h2>
      <ul>
        <li><strong>Terminal:</strong> Press Control+C in the terminal running Ori. Wait for it to exit, then rerun the same launch command with the same data folder and port.</li>
        <li><strong>macOS menubar:</strong> Choose <strong>Quit</strong> from the Ori menu, then reopen the same Ori app. If needed, choose <strong>Start Server</strong> after reopening. Stop Server followed by Start Server is not a full restart.</li>
      </ul>
      <p>Keep this tab open. Do not delete <code>.ori-reset</code> or start another Ori process against this data folder while the old one is running.</p>
    </section>
    {{end}}
    {{if .Operation.Results}}
    <details>
      <summary>Reviewed categories and checks</summary>
      <ul>
        {{range .Operation.Results}}
        <li><strong>{{categoryLabel .ID}}: {{.Outcome}}</strong>{{if .Message}} — {{.Message}}{{end}}
          {{if or .Checks .Items .Retained}}<ul>
            {{range .Items}}<li>{{.Name}}: {{.Outcome}}{{if .Message}} — {{.Message}}{{end}}</li>{{end}}
            {{range .Checks}}<li>{{.Name}}: {{.Outcome}}{{if .Message}} — {{.Message}}{{end}}</li>{{end}}
            {{range .Retained}}<li>Kept: {{.DisplayPath}} — {{.Reason}}</li>{{end}}
          </ul>{{end}}
        </li>
        {{end}}
      </ul>
    </details>
    {{end}}
    <footer>
      <form method="get" action="/reset/status">
        {{if .ID}}<input type="hidden" name="operation" value="{{.ID}}">{{end}}
        <button type="submit">Check status</button>
      </form>
    </footer>
  </main>
</body>
</html>
