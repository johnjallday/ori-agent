<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{.Title}} · Ori</title>
  {{if .ID}}
  <script defer src="/reset/assets/generation.js"></script>
  <script defer src="/reset/assets/status.js"></script>
  {{end}}
  <style>
    :root {
      color-scheme: light dark;
      --paper: #f6f5ef; --ink: #182b2a; --muted: #405552;
      --line: #bacdc6; --panel: #e7efeb; --accent: #1c594c; --button-ink: #fff;
      font: 1rem/1.55 system-ui, sans-serif;
      background: var(--paper); color: var(--ink);
    }
    @media (prefers-color-scheme: dark) {
      :root {
        --paper: #14211f; --ink: #edf4f0; --muted: #bdd0c8;
        --line: #506762; --panel: #1d302c; --accent: #a9e1ca; --button-ink: #132c24;
      }
    }
    body { margin: 0; border-block-start: .3rem solid var(--accent); }
    main { max-width: 39rem; margin: clamp(2rem, 8vh, 6rem) auto; padding: 0 1.25rem 2rem; }
    .eyebrow { color: var(--accent); font-size: .8rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
    h1 { font: 500 clamp(2rem, 7vw, 3.5rem)/1.1 Georgia, serif; margin: .5rem 0 1rem; }
    h2 { font-size: 1.15rem; margin: 1.5rem 0 .5rem; }
    p { margin: .5rem 0 1rem; }
    li { margin-block: .55rem; }
    .status { padding: 1.2rem; background: var(--panel); border-inline-start: .25rem solid var(--accent); }
    .status p:last-child { margin-bottom: 0; }
    .id { font-size: .85rem; color: var(--muted); overflow-wrap: anywhere; }
    .blockers strong { display: block; }
    footer { margin-block-start: 1.5rem; padding-block-start: 1rem; border-block-start: 1px solid var(--line); }
    .cancel { padding: 1rem 1.2rem; border: 1px solid var(--line); border-inline-start: .25rem solid var(--accent); }
    .cancel .warning { color: var(--muted); }
    .cancel [role="alert"] { font-weight: 700; }
    [hidden] { display: none !important; }
    button { display: inline-block; color: var(--button-ink); background: var(--accent); font: inherit; font-weight: 700; border: 0; border-radius: .35rem; padding: .65rem 1rem; cursor: pointer; }
    :focus-visible { outline: .2rem solid var(--accent); outline-offset: .25rem; }
    h1:focus { outline: none; }
  </style>
</head>
<body>
  <main>
    <header class="eyebrow">Ori / Reset &amp; Recovery</header>
    <div class="status" role="status" aria-live="polite" aria-atomic="true">
      <h1 id="reset-state-title" tabindex="-1">{{.Title}}</h1>
      <p id="reset-state-message">{{.Message}}</p>
      {{if .ID}}<p class="id">Operation <code>{{.ID}}</code></p>{{end}}
    </div>
    <p id="reset-connection" role="status" hidden></p>
    <section id="reset-blockers" aria-labelledby="blockers-heading" {{if not .Operation.Blockers}}hidden{{end}}>
      <h2 id="blockers-heading">What needs attention</h2>
      <ul class="blockers" id="reset-blocker-list">{{range .Operation.Blockers}}<li><strong>{{.Message}}</strong>{{.Recovery}}</li>{{end}}</ul>
    </section>
    <section id="reset-cancel" class="cancel" aria-labelledby="cancel-heading" {{if not .Cancel}}hidden{{end}}{{with .Cancel}} data-revision="{{.Revision}}" data-token="{{.Token}}"{{end}}>
      <h2 id="cancel-heading">Cancel this reset</h2>
      <p id="reset-cancel-headline">{{with .Cancel}}{{.Headline}}{{end}}</p>
      <p id="reset-cancel-detail">{{with .Cancel}}{{.Detail}}{{end}}</p>
      <p id="reset-cancel-warning" class="warning">{{with .Cancel}}{{.Warning}}{{end}}</p>
      <button id="reset-cancel-button" type="button">Cancel reset</button>
      <p id="reset-cancel-feedback" role="alert" hidden></p>
    </section>
    <section id="reset-hq-archive" aria-labelledby="archive-heading" {{if not .Operation.HQArchive}}hidden{{end}}>
      <h2 id="archive-heading">Personal HQ archive</h2>
      <p id="reset-hq-archive-message">{{with .Operation.HQArchive}}{{.Message}}{{end}}</p>
      <p class="id" id="reset-hq-archive-location" {{if not .Operation.HQArchive}}hidden{{end}}>
        <span id="reset-hq-archive-label">{{if .Operation.HQArchive}}{{if eq .Operation.HQArchive.Outcome "completed"}}Archived at:{{else}}Reviewed destination:{{end}}{{end}}</span>
        <code id="reset-hq-archive-path">{{with .Operation.HQArchive}}{{.Destination}}{{end}}</code>
      </p>
    </section>
    <section id="reset-restart-instructions" aria-labelledby="restart-heading" {{if not .ShowRestart}}hidden{{end}}>
      <h2 id="restart-heading">How to restart Ori</h2>
      <ul>
        <li><strong>Terminal:</strong> Press Control+C in the terminal running Ori. Wait for it to exit, then rerun the same launch command with the same data folder and port.</li>
        <li><strong>macOS menubar:</strong> Choose <strong>Quit</strong> from the Ori menu, then reopen the same Ori app. If needed, choose <strong>Start Server</strong> after reopening. Stop Server followed by Start Server is not a full restart.</li>
      </ul>
      <p>Keep this tab open. Do not delete <code>.ori-reset</code> or start another Ori process against this data folder while the old one is running.</p>
    </section>
    <details id="reset-results" {{if or (not .Operation.Results) (eq .Operation.State "canceled")}}hidden{{end}}>
      <summary>Reviewed categories and checks</summary>
      <ul id="reset-result-list">
        {{range .Operation.Results}}
        <li><strong>{{categoryLabel .ID}}: {{.Outcome}}</strong>{{if .Message}} — {{.Message}}{{end}}
          {{if or .Checks .Items .Retained}}<ul>
            {{range .Items}}<li>{{.Name}}: {{.Outcome}}{{if .Message}} — {{.Message}}{{end}}</li>{{end}}
            {{range .Checks}}<li>{{.Name}}: {{.Outcome}}{{if .Message}} — {{.Message}}{{end}}</li>{{end}}
            {{range .Retained}}<li>Kept: {{.DisplayPath}} — {{.Reason}}</li>{{end}}
          </ul>{{end}}
        </li>
        {{end}}
      </ul>
    </details>
    <footer>
      <form id="reset-check" method="get" action="/reset/status">
        {{if .ID}}<input id="reset-operation-id" type="hidden" name="operation" value="{{.ID}}" data-revision="{{.Operation.Revision}}">{{end}}
        <button type="submit">Check status</button>
        <button id="reset-enter" type="button" hidden></button>
      </form>
    </footer>
  </main>
</body>
</html>
