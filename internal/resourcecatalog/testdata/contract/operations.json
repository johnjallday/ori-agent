[
  {
    "id": "studio.sources.read",
    "input_schema": {
      "type": "object",
      "properties": { "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 } },
      "required": ["schema_version"],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
        "installation": {
          "type": "object",
          "properties": {
            "id": { "type": "string", "minLength": 8, "maxLength": 128 },
            "label": { "type": "string", "minLength": 1, "maxLength": 80 },
            "layout": { "type": "string", "enum": ["per_user", "portable"], "maxLength": 16 },
            "app_installed": { "type": "boolean" },
            "app_version": { "type": "string", "maxLength": 40 }
          },
          "required": ["id", "label", "layout", "app_installed"],
          "additionalProperties": false
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 40 },
              "category": { "type": "string", "minLength": 1, "maxLength": 40 },
              "label": { "type": "string", "minLength": 1, "maxLength": 60 },
              "location": { "type": "string", "minLength": 1, "maxLength": 512 },
              "access": { "type": "string", "enum": ["file", "live"], "maxLength": 8 },
              "state": {
                "type": "string",
                "enum": ["ready", "absent", "denied", "unsupported", "app_closed", "reader_missing", "reader_outdated", "web_remote_off"],
                "maxLength": 32
              },
              "detail": { "type": "string", "maxLength": 240 }
            },
            "required": ["id", "category", "label", "location", "access", "state"],
            "additionalProperties": false
          }
        }
      },
      "required": ["schema_version", "installation", "sources"],
      "additionalProperties": false
    },
    "max_output_bytes": 32768,
    "timeout_class": "fast",
    "policy": "read_only",
    "scopes": []
  },
  {
    "id": "studio.inventory.read",
    "input_schema": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
        "installation_id": { "type": "string", "minLength": 8, "maxLength": 128 },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 40 },
        "cursor": { "type": "string", "maxLength": 512 },
        "limit": { "type": "integer", "minimum": 1, "maximum": 256 }
      },
      "required": ["schema_version", "installation_id", "source_id", "cursor", "limit"],
      "additionalProperties": false
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "schema_version": { "type": "integer", "minimum": 1, "maximum": 1 },
        "installation_id": { "type": "string", "minLength": 8, "maxLength": 128 },
        "source_id": { "type": "string", "minLength": 1, "maxLength": 40 },
        "state": {
          "type": "string",
          "enum": ["ok", "absent", "denied", "unsupported", "app_closed", "reader_missing", "reader_outdated", "web_remote_off", "installation_changed", "cursor_reset"],
          "maxLength": 32
        },
        "entries": {
          "type": "array",
          "maxItems": 256,
          "items": {
            "type": "object",
            "properties": {
              "native_id": { "type": "string", "minLength": 1, "maxLength": 512 },
              "kind": { "type": "string", "minLength": 1, "maxLength": 40 },
              "name": { "type": "string", "minLength": 1, "maxLength": 160 },
              "modified_at": { "type": "string", "maxLength": 40 },
              "facts": {
                "type": "array",
                "maxItems": 8,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "minLength": 1, "maxLength": 40 },
                    "value": { "type": "string", "minLength": 1, "maxLength": 160 }
                  },
                  "required": ["id", "value"],
                  "additionalProperties": false
                }
              },
              "description": {
                "type": "object",
                "properties": {
                  "text": { "type": "string", "minLength": 1, "maxLength": 500 },
                  "source": { "type": "string", "minLength": 1, "maxLength": 60 }
                },
                "required": ["text", "source"],
                "additionalProperties": false
              }
            },
            "required": ["native_id", "kind", "name", "facts"],
            "additionalProperties": false
          }
        },
        "next_cursor": { "type": "string", "maxLength": 512 },
        "coverage": {
          "type": "object",
          "properties": {
            "visited": { "type": "integer", "minimum": 0, "maximum": 1000000 },
            "skipped": {
              "type": "array",
              "maxItems": 8,
              "items": {
                "type": "object",
                "properties": {
                  "reason": {
                    "type": "string",
                    "enum": ["symlink", "outside_source", "unreadable", "unsupported_name", "too_large", "hidden", "external_registration", "depth_limit"],
                    "maxLength": 32
                  },
                  "count": { "type": "integer", "minimum": 1, "maximum": 1000000 }
                },
                "required": ["reason", "count"],
                "additionalProperties": false
              }
            }
          },
          "required": ["visited", "skipped"],
          "additionalProperties": false
        }
      },
      "required": ["schema_version", "installation_id", "source_id", "state", "entries", "next_cursor", "coverage"],
      "additionalProperties": false
    },
    "max_output_bytes": 262144,
    "timeout_class": "normal",
    "policy": "read_only",
    "scopes": []
  }
]
