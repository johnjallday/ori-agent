{
  "name": "ori-agent-web",
  "version": "1.0.0",
  "description": "Web frontend linting and formatting tools for Ori Agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "eslint internal/web/static/js/",
    "lint:fix": "eslint internal/web/static/js/ --fix",
    "format": "prettier --write 'internal/web/static/**/*.{js,css,html}'",
    "format:check": "prettier --check 'internal/web/static/**/*.{js,css,html}'",
    "test:modules": "./scripts/run-test-command.sh node --test internal/web/static/js/modules/*.test.js",
    "test": "./scripts/run-test-command.sh playwright test",
    "test:smoke": "./scripts/run-test-command.sh playwright test tests/smoke.spec.ts",
    "readme:audit": "node scripts/readme/audit.mjs",
    "readme:check": "node scripts/readme/manifest.mjs",
    "readme:test": "./scripts/run-test-command.sh node --test scripts/readme/*.test.mjs",
    "test:headed": "./scripts/run-test-command.sh playwright test --headed",
    "test:ui": "./scripts/run-test-command.sh playwright test --ui",
    "test:debug": "./scripts/run-test-command.sh playwright test --debug",
    "validate": "npm run lint && npm run test:smoke"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@playwright/test": "^1.57.0",
    "bootstrap": "5.3.0",
    "bootstrap-icons": "1.11.3",
    "eslint": "^9.39.2",
    "globals": "^15.15.0",
    "prettier": "^3.0.0",
    "sharp": "0.35.3"
  }
}
