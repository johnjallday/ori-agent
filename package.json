{
  "name": "ori-agent-web",
  "version": "1.0.0",
  "description": "Web frontend linting and formatting tools for Ori Agent",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "lint": "eslint internal/web/static/js/",
    "lint:fix": "eslint internal/web/static/js/ --fix",
    "format": "prettier --write 'internal/web/static/**/*.{js,css,html}'",
    "format:check": "prettier --check 'internal/web/static/**/*.{js,css,html}'",
    "test": "playwright test",
    "test:smoke": "playwright test tests/smoke.spec.ts",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "validate": "npm run lint && npm run test:smoke"
  },
  "devDependencies": {
    "@eslint/css": "^0.14.1",
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.1",
    "@eslint/markdown": "^7.5.1",
    "@playwright/test": "^1.57.0",
    "eslint": "^9.39.2",
    "globals": "^15.15.0",
    "prettier": "^3.0.0"
  }
}
