{
  "id": "TEMPLATE_RELEASE_PIPELINE",
  "name": "Release Pipeline",
  "description": "Automated release pipeline for ori-agent using existing release scripts. Handles pre-release checks, version bumping, release creation, and announcements.",
  "template_version": "1.0.0",
  "agents": ["default", "default", "default", "default"],
  "agent_instances": [
    {
      "id": "agent-quality-checker",
      "name": "default",
      "instance_number": 1,
      "node_id": "quality-checker-node",
      "role": "Quality Checker",
      "description": "Runs pre-release checks: tests, linting, security scans"
    },
    {
      "id": "agent-version-manager",
      "name": "default",
      "instance_number": 2,
      "node_id": "version-manager-node",
      "role": "Version Manager",
      "description": "Manages version bumping and changelog generation"
    },
    {
      "id": "agent-release-builder",
      "name": "default",
      "instance_number": 3,
      "node_id": "release-builder-node",
      "role": "Release Builder",
      "description": "Creates releases, tags, and builds artifacts"
    },
    {
      "id": "agent-announcer",
      "name": "default",
      "instance_number": 4,
      "node_id": "announcer-node",
      "role": "Announcer",
      "description": "Generates release announcements and changelogs"
    }
  ],
  "shared_data": {
    "project_root": "/Users/jjdev/Projects/ori/ori-agent",
    "scripts_path": "/Users/jjdev/Projects/ori/ori-agent/scripts",
    "ci_scripts_path": "/Users/jjdev/Projects/ori/scripts/ci-cd",
    "default_components": "ori-agent"
  },
  "messages": [],
  "tasks": [
    {
      "id": "task-pre-release-check",
      "studio_id": "TEMPLATE_RELEASE_PIPELINE",
      "from": "user",
      "to": "default",
      "assigned_node_id": "quality-checker-node",
      "description": "Run pre-release checks (tests, lint, security, build verification). Execute: cd /Users/jjdev/Projects/ori/ori-agent && ./scripts/pre-release-check.sh ${VERSION}",
      "priority": 1,
      "context": {
        "script": "./scripts/pre-release-check.sh",
        "working_dir": "/Users/jjdev/Projects/ori/ori-agent",
        "required_input": "VERSION (e.g., v0.0.20)",
        "checks": ["format", "vet", "lint", "security", "tests", "build", "dependencies"]
      },
      "timeout": 600000000000,
      "status": "pending"
    },
    {
      "id": "task-prepare-release",
      "studio_id": "TEMPLATE_RELEASE_PIPELINE",
      "from": "user",
      "to": "default",
      "assigned_node_id": "version-manager-node",
      "description": "Prepare release by merging dev to main. Execute: cd /Users/jjdev/Projects/ori/ori-agent && ./scripts/prepare-release.sh",
      "priority": 2,
      "context": {
        "script": "./scripts/prepare-release.sh",
        "working_dir": "/Users/jjdev/Projects/ori/ori-agent",
        "actions": ["switch to dev", "pull latest", "merge to main", "push main"],
        "depends_on": ["task-pre-release-check"]
      },
      "timeout": 300000000000,
      "status": "pending",
      "input_task_ids": ["task-pre-release-check"]
    },
    {
      "id": "task-create-release",
      "studio_id": "TEMPLATE_RELEASE_PIPELINE",
      "from": "user",
      "to": "default",
      "assigned_node_id": "release-builder-node",
      "description": "Create release (branch or immediate). Execute: cd /Users/jjdev/Projects/ori/ori-agent && ./scripts/create-release.sh ${VERSION} [--immediate]",
      "priority": 3,
      "context": {
        "script": "./scripts/create-release.sh",
        "working_dir": "/Users/jjdev/Projects/ori/ori-agent",
        "required_input": "VERSION (e.g., v0.0.20)",
        "optional_flags": ["--immediate"],
        "actions": ["create release branch OR tag", "push to remote", "trigger GitHub Actions"],
        "depends_on": ["task-prepare-release"]
      },
      "timeout": 300000000000,
      "status": "pending",
      "input_task_ids": ["task-prepare-release"]
    },
    {
      "id": "task-orchestrate-multi-component",
      "studio_id": "TEMPLATE_RELEASE_PIPELINE",
      "from": "user",
      "to": "default",
      "assigned_node_id": "release-builder-node",
      "description": "Orchestrate multi-component release. Execute: /Users/jjdev/Projects/ori/scripts/ci-cd/release-orchestrator.sh --version ${VERSION} --components ${COMPONENTS} --generate-bundle",
      "priority": 3,
      "context": {
        "script": "/Users/jjdev/Projects/ori/scripts/ci-cd/release-orchestrator.sh",
        "required_input": "VERSION, COMPONENTS (comma-separated)",
        "optional_flags": ["--generate-bundle", "--update-registry", "--dry-run"],
        "actions": ["validate components", "run tests", "build all", "create tags", "generate bundle"]
      },
      "timeout": 900000000000,
      "status": "pending"
    },
    {
      "id": "task-generate-changelog",
      "studio_id": "TEMPLATE_RELEASE_PIPELINE",
      "from": "user",
      "to": "default",
      "assigned_node_id": "announcer-node",
      "description": "Generate aggregated changelog. Execute: /Users/jjdev/Projects/ori/scripts/ci-cd/aggregate-changelog.sh --components ${COMPONENTS} --from-version ${FROM_VERSION}",
      "priority": 4,
      "context": {
        "script": "/Users/jjdev/Projects/ori/scripts/ci-cd/aggregate-changelog.sh",
        "required_input": "COMPONENTS (comma-separated)",
        "optional_input": "FROM_VERSION, TO_VERSION",
        "output_format": "markdown",
        "depends_on": ["task-create-release"]
      },
      "timeout": 120000000000,
      "status": "pending",
      "input_task_ids": ["task-create-release"]
    },
    {
      "id": "task-generate-announcement",
      "studio_id": "TEMPLATE_RELEASE_PIPELINE",
      "from": "user",
      "to": "default",
      "assigned_node_id": "announcer-node",
      "description": "Generate release announcement. Execute: /Users/jjdev/Projects/ori/scripts/ci-cd/generate-release-announcement.sh --version ${VERSION} --components ${COMPONENTS} --format markdown",
      "priority": 5,
      "context": {
        "script": "/Users/jjdev/Projects/ori/scripts/ci-cd/generate-release-announcement.sh",
        "required_input": "VERSION, COMPONENTS",
        "formats": ["markdown", "discord", "twitter"],
        "depends_on": ["task-generate-changelog"]
      },
      "timeout": 60000000000,
      "status": "pending",
      "input_task_ids": ["task-generate-changelog"]
    }
  ],
  "attachments": [
    {
      "id": "attach-release-guide",
      "workspace_id": "TEMPLATE_RELEASE_PIPELINE",
      "title": "Release Guide",
      "body": "## Release Workflow\n\n1. **Pre-Release Check** - Run quality checks\n2. **Prepare Release** - Merge dev to main\n3. **Create Release** - Tag and push\n4. **Generate Changelog** - Document changes\n5. **Announce** - Share with community\n\n### Quick Commands\n\n```bash\n# Full release (immediate)\ncd /Users/jjdev/Projects/ori/ori-agent\n./scripts/pre-release-check.sh v0.0.20\n./scripts/create-release.sh v0.0.20 --immediate\n```",
      "type": "doc",
      "color": "#6366f1",
      "x": -400,
      "y": -200
    },
    {
      "id": "attach-version-input",
      "workspace_id": "TEMPLATE_RELEASE_PIPELINE",
      "title": "VERSION",
      "body": "v0.0.20",
      "type": "doc",
      "color": "#10b981",
      "x": -400,
      "y": 50
    }
  ],
  "scheduled_tasks": [
    {
      "id": "scheduled-weekly-release-check",
      "studio_id": "TEMPLATE_RELEASE_PIPELINE",
      "canvas_node_id": "scheduler-weekly-check",
      "target_task_id": "task-pre-release-check",
      "name": "Weekly Release Check",
      "description": "Run pre-release checks every Tuesday to prepare for releases",
      "from": "scheduler",
      "to": "",
      "prompt": "",
      "priority": 0,
      "schedule": {
        "type": "weekly",
        "day_of_week": 2,
        "time_of_day": "09:00"
      },
      "enabled": false,
      "execution_count": 0,
      "failure_count": 0
    }
  ],
  "store_nodes": [
    {
      "id": "store-release-logs",
      "canvas_node_id": "store-release-logs-node",
      "agent_node_id": "release-builder-node",
      "workspace_id": "TEMPLATE_RELEASE_PIPELINE",
      "name": "Release Logs",
      "base_dir": "/Users/jjdev/Projects/ori/releases/logs",
      "format": "json",
      "write_mode": "append",
      "auto_create_dir": true,
      "auto_store": true,
      "x": 600,
      "y": 0
    }
  ],
  "layout": {
    "task_positions": {
      "task-pre-release-check": {"x": 0, "y": -300},
      "task-prepare-release": {"x": 0, "y": -100},
      "task-create-release": {"x": 0, "y": 100},
      "task-orchestrate-multi-component": {"x": 300, "y": 100},
      "task-generate-changelog": {"x": 0, "y": 300},
      "task-generate-announcement": {"x": 0, "y": 500}
    },
    "agent_positions": {
      "quality-checker-node": {"x": 350, "y": -300},
      "version-manager-node": {"x": 350, "y": -100},
      "release-builder-node": {"x": 350, "y": 100},
      "announcer-node": {"x": 350, "y": 400}
    },
    "attachment_positions": {
      "attach-release-guide": {"x": -400, "y": -200},
      "attach-version-input": {"x": -400, "y": 50}
    },
    "scheduler_positions": {
      "scheduler-weekly-check": {"x": -200, "y": -300}
    },
    "store_positions": {
      "store-release-logs-node": {"x": 600, "y": 100}
    },
    "workflow_connections": [
      {
        "id": "conn-precheck-to-prepare",
        "from": "task-pre-release-check",
        "fromPort": "output",
        "to": "task-prepare-release",
        "toPort": "input",
        "color": "#10b981"
      },
      {
        "id": "conn-prepare-to-create",
        "from": "task-prepare-release",
        "fromPort": "output",
        "to": "task-create-release",
        "toPort": "input",
        "color": "#10b981"
      },
      {
        "id": "conn-create-to-changelog",
        "from": "task-create-release",
        "fromPort": "output",
        "to": "task-generate-changelog",
        "toPort": "input",
        "color": "#6366f1"
      },
      {
        "id": "conn-changelog-to-announce",
        "from": "task-generate-changelog",
        "fromPort": "output",
        "to": "task-generate-announcement",
        "toPort": "input",
        "color": "#6366f1"
      },
      {
        "id": "conn-version-to-precheck",
        "from": "attach-version-input",
        "fromPort": "output",
        "to": "task-pre-release-check",
        "toPort": "input-0",
        "color": "#f59e0b"
      },
      {
        "id": "conn-scheduler-to-precheck",
        "from": "scheduler-weekly-check",
        "fromPort": "out",
        "to": "task-pre-release-check",
        "toPort": "in",
        "color": "#8b5cf6"
      }
    ],
    "scale": 0.7,
    "offset_x": 500,
    "offset_y": 400
  },
  "status": "active"
}
