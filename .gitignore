# Binaries
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Compiled scenario-runner binary (source-backed: `cd tests/user/scenarios &&
# go run scenario_runner.go`, or `make test-scenarios`). Exact path only, so
# this never shadows scenario_runner.go or other files in the same directory.
tests/user/scenarios/scenario_runner

# Test binary, built with `go test -c`
*.test

# Playwright run artifacts
test-results/
playwright-report/

# Output of the go coverage tool
*.out
coverage/
coverage.html

# Secrets / credentials
*.pem
*.key
*.p12
credentials.json
service-account*.json

# Dependency directories
vendor/
# Web frontend vendor: pinned + SRI-hashed third-party libs we self-host
# instead of loading from a CDN. Tracked in git so we control the bytes
# the browser actually executes.
!internal/web/static/js/vendor/
!internal/web/static/js/vendor/**

# Go workspace file
go.work
go.work.sum

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Local configuration files
.claude/settings.local.json
.claude/agents/
# Local-only release tooling; cross-harness task-planning stays tracked
.agents/skills/release-manager/
.env
.env.*
!.env.example

# Runtime/cache directories
marketplace_cache_*.json
# Local installed-plugins store (installed.json + downloaded src); machine-local state
plugins/
# Local plugin registry + plugin fixtures/uploads written by running a server; machine-local state
local_plugin_registry.json
test_plugins/
uploaded_plugins/
cache/
tmp/
# Screenshot output from the scripts/demo-*.mjs browser demos (tmp-ticket-demo,
# tmp-map-demo, and friends). Evidence for a PR, never source.
tmp-*/
temp/
.gocache/
.gocache-build/
.gobuild/

# Agent data and configuration
agents/*
!agents/skills/
!agents/skills/**
agents.json


# Build artifacts
dist/
build/
!build/macos/
!build/linux/
!build/windows/
build-dmg/
release/
releases/

