{
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(npx eslint *)",
      "Bash(go vet *)",
      "Bash(npm run lint)",
      "Bash(go build *)",
      "Bash(gofmt -l *)",
      "Bash(git fetch *)",
      "Bash(golangci-lint run *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATHS\" | grep -qE '\\.(js|ts|html|css|tmpl)$'; then echo '[Hook] Frontend file changed - run npm run validate to test'; fi"
          }
        ]
      }
    ]
  }
}
