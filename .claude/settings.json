{
  "permissions": {
    "allow": [
      "Bash(go test *)",
      "Bash(node --test *)",
      "Bash(node --check *)",
      "Bash(npx eslint *)",
      "Bash(go vet *)",
      "Bash(npm run lint)",
      "Bash(go build *)",
      "Bash(gofmt -l *)",
      "Bash(git fetch *)",
      "Bash(golangci-lint run *)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\\n\" http://localhost:*)",
      "Bash(npm run test:modules)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_console_messages",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude-in-chrome__find",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__get_page_text"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_FILE_PATHS\" | grep -qE '\\.(js|ts|html|css|tmpl)$'; then echo '[Hook] Frontend file changed - run npm run validate to test'; fi"
          }
        ]
      }
    ]
  }
}
